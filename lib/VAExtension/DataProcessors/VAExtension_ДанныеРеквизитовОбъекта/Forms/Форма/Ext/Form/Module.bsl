#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	ОбработкаВыполнена = Ложь;
	ТекстИсключения = "";
	ЗначениеРезультат = "";
	
	Попытка

		Окна = ПолучитьОкна();
		ОкноБезФорм = "";
		Для Каждого ТекОкно Из Окна Цикл
			Если НРег(ТекОкно.Заголовок) <> НРег(ЗаголовокОкна) Тогда
				Продолжить;
			КонецЕсли;
			
			// Окно может не содержать форм (главное окно, рабочий стол) - такое пропускаем.
			// В клиенте тестирования у окна нет менеджерского НайтиОбъект: форму берём из Содержимого.
			Попытка
				КоличествоФорм = ТекОкно.Содержимое.Количество();
			Исключение
				КоличествоФорм = 0;
			КонецПопытки;
			Если КоличествоФорм = 0 Тогда
				ОкноБезФорм = ТекОкно.Заголовок;
				Продолжить;
			КонецЕсли;
			ТекФорма = ТекОкно.Содержимое[0];

			// Служебные формы расширения тоже имеют свойство Объект, но данные нужны не их.
			Попытка
				ЭтоСлужебнаяФорма = Найти(ВРег(ТекФорма.ИмяФормы), "VAEXTENSION") > 0;
			Исключение
				ЭтоСлужебнаяФорма = Ложь;
			КонецПопытки;
			Если ЭтоСлужебнаяФорма Тогда
				Продолжить;
			КонецЕсли;

			ДанныеОбъекта = ДанныеОбъекта(ТекФорма);
			Если ДанныеОбъекта = Неопределено Тогда
				ВызватьИсключение "У формы окна """ + ЗаголовокОкна + """ нет основного реквизита (это форма списка, отчёта или служебная форма). Данные элементов читайте через get_table_data или get_form_analysis.";
			КонецЕсли;

			ЗначениеРезультат = ЗаписатьОбъектJSON(ДанныеОбъекта);
			Прервать;
		КонецЦикла;	

		Если НЕ ЗначениеЗаполнено(ЗначениеРезультат) Тогда
			// Список окон — отдельной строкой: менеджер берёт первую строку ошибки как «Ошибка», остальное в «Детали».
			СписокОкон = "";
			ЧислоОконВДиагностике = 0;
			Попытка
				Для Каждого ДиагностическоеОкно Из Окна Цикл
					ЧислоФормВОкне = 0;
					Попытка
						ЧислоФормВОкне = ДиагностическоеОкно.Содержимое.Количество();
					Исключение
					КонецПопытки;
					СписокОкон = СписокОкон + ?(СписокОкон = "", "", Символы.ПС)
						+ """" + ДиагностическоеОкно.Заголовок + """ (форм: " + ЧислоФормВОкне + ")";
					ЧислоОконВДиагностике = ЧислоОконВДиагностике + 1;
					Если ЧислоОконВДиагностике >= 10 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			Исключение
				СписокОкон = "(список окон недоступен)";
			КонецПопытки;
			// Разделяем два случая: окно с таким заголовком не найдено или найдено, но без форм.
			Если ЗначениеЗаполнено(ОкноБезФорм) Тогда
				ВызватьИсключение "Окно с заголовком """ + ЗаголовокОкна + """ найдено, но в нём нет форм (например, это главное окно или рабочий стол). Откройте форму объекта и повторите вызов."
					+ Символы.ПС + "Открытые окна: " + СписокОкон;
			КонецЕсли;
			ВызватьИсключение "Среди открытых окон нет окна с заголовком """ + ЗаголовокОкна + """. Проверьте активное окно."
				+ Символы.ПС + "Открытые окна: " + СписокОкон;
		КонецЕсли;

	Исключение
		ТекстИсключения = ОписаниеОшибки();
		// Ошибка возвращается менеджеру в виде JSON-конверта {"ОшибкаВыполнения": "..."},
		// иначе менеджер получает пустую строку и падает на ПрочитатьJSON.
		ОбёрткаОшибки = Новый Структура;
		ОбёрткаОшибки.Вставить("ОшибкаВыполнения", ТекстИсключения);
		ЗначениеРезультат = ЗаписатьОбъектJSON(ОбёрткаОшибки);
	КонецПопытки;
	
	ОбработкаВыполнена = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПрочитатьОбъектJSON(ДанныеJSON, ПрочитатьВСоответствие = Ложь)
	
	ЧтениеJSON = New ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ДанныеJSON);
	Значение = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие);
	ЧтениеJSON.Закрыть();
	Возврат Значение;
	
КонецФункции	 

&НаКлиенте
Функция ЗаписатьОбъектJSON(ДанныеJSON) Экспорт
	#Если НЕ ВебКлиент Тогда

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	Возврат ЗаписьJSON.Закрыть();
	
	#КонецЕсли
КонецФункции

&НаСервере
Функция ДанныеОбъектаСервер(ТекОбъект)
	Возврат VAExtensionОбщегоНазначенияСервер.ДанныеОбъектаСервер(ТекОбъект);
КонецФункции

&НаКлиенте
Функция ДанныеОбъекта(ТекФорма)
	ТекОбъект = Неопределено;
	Попытка
		ТекОбъект = ТекФорма.Объект;
	Исключение
	КонецПопытки;
	
	Если ТекОбъект = Неопределено Тогда
		Попытка
			ТекОбъект = ТекФорма.Object;
		Исключение
		КонецПопытки;
	КонецЕсли;	
	
	Если ТекОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеОбъектаСервер(ТекОбъект);
	
КонецФункции	

#КонецОбласти