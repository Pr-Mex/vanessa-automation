#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	ОбработкаВыполнена = Ложь;
	ТекстИсключения = "";
	ЗначениеРезультат = "";
	
	Попытка
		ЗначениеРезультат = ДанныеЖурналаРегистрацииJSON(ДляУстановкиПараметров);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
		// Менеджер всегда ждёт JSON, поэтому ошибку тоже отдаём конвертом
		// {"ОшибкаВыполнения": "..."}, иначе на стороне менеджера будет пустой ответ.
		ОбёрткаОшибки = Новый Структура("ОшибкаВыполнения", ТекстИсключения);
		ЗначениеРезультат = ЗаписатьОбъектJSON(ОбёрткаОшибки);
	КонецПопытки;
	
	ОбработкаВыполнена = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗаписатьОбъектJSON(ДанныеJSON)
	
	#Если НЕ ВебКлиент Тогда
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	Возврат ЗаписьJSON.Закрыть();
	#КонецЕсли
	
КонецФункции

// Единая точка входа для менеджера тестирования: читает журнал регистрации базы клиента
// и возвращает готовый JSON. Параметры передаются одной JSON-строкой, чтобы число
// реквизитов формы не росло с каждым новым отбором.
&НаСервереБезКонтекста
Функция ДанныеЖурналаРегистрацииJSON(ПараметрыJSON)
	
	Попытка
		// Журнал регистрации читаем независимо от прав пользователя клиента тестирования:
		// инструмент диагностический, а права пользователя чтение ЖР не ограничивают.
		УстановитьПривилегированныйРежим(Истина);
		
		Параметры = ПараметрыЧтенияЖурналаРегистрации(ПараметрыJSON);
		Результат = ПрочитатьЖурналРегистрацииИзБазы(Параметры);
		
		Возврат ЗаписатьОбъектJSONСервер(Результат);
	Исключение
		ОбёрткаОшибки = Новый Структура;
		ОбёрткаОшибки.Вставить("ОшибкаВыполнения", ОписаниеОшибки());
		ОбёрткаОшибки.Вставить("ПодробностиОшибки", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ЗаписатьОбъектJSONСервер(ОбёрткаОшибки);
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьОбъектJSONСервер(ДанныеJSON)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыЧтенияЖурналаРегистрации(ПараметрыJSON)
	
	Если НЕ ЗначениеЗаполнено(ПараметрыJSON) Тогда
		ВызватьИсключение "Не переданы параметры чтения журнала регистрации.";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ПараметрыJSON);
	ИменаСвойствСоЗначениямиДата = Новый Массив;
	ИменаСвойствСоЗначениямиДата.Добавить("ДатаНачала");
	ИменаСвойствСоЗначениямиДата.Добавить("ДатаОкончания");
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь, ИменаСвойствСоЗначениямиДата);
	ЧтениеJSON.Закрыть();
	
	Параметры = Новый Структура;
	
	ДатаНачала = ТекущаяДата() - 3600;
	Если Данные.Свойство("ДатаНачала") И ЗначениеЗаполнено(Данные.ДатаНачала) Тогда
		ДатаНачала = Данные.ДатаНачала;
	КонецЕсли;
	Параметры.Вставить("ДатаНачала", ДатаНачала);
	
	ДатаОкончания = ТекущаяДата();
	Если Данные.Свойство("ДатаОкончания") И ЗначениеЗаполнено(Данные.ДатаОкончания) Тогда
		ДатаОкончания = Данные.ДатаОкончания;
	КонецЕсли;
	Параметры.Вставить("ДатаОкончания", ДатаОкончания);
	
	Параметры.Вставить("Событие", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Событие")));
	Параметры.Вставить("ВидСравненияСобытия", ВидСравненияПараметровЖР(СвойствоПараметровЖР(Данные, "ВидСравненияСобытия")));
	
	Комментарий = СвойствоПараметровЖР(Данные, "Комментарий");
	Параметры.Вставить("Комментарий", ?(Комментарий = Неопределено, "", СокрЛП(Строка(Комментарий))));
	Параметры.Вставить("ВидСравненияКомментария", ВидСравненияПараметровЖР(СвойствоПараметровЖР(Данные, "ВидСравненияКомментария")));
	
	Параметры.Вставить("Уровень", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Уровень")));
	Параметры.Вставить("Пользователь", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Пользователь")));
	Параметры.Вставить("Компьютер", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Компьютер")));
	Параметры.Вставить("ИмяПриложения", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "ИмяПриложения")));
	Параметры.Вставить("РабочийСервер", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "РабочийСервер")));
	Параметры.Вставить("Транзакция", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Транзакция")));
	Параметры.Вставить("СтатусТранзакции", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "СтатусТранзакции")));
	Параметры.Вставить("Метаданные", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Метаданные")));
	Параметры.Вставить("Сеанс", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Сеанс")));
	Параметры.Вставить("ОсновнойIPПорт", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "ОсновнойIPПорт")));
	Параметры.Вставить("ВспомогательныйIPПорт", МассивИзЗначенияЖР(СвойствоПараметровЖР(Данные, "ВспомогательныйIPПорт")));
	
	Параметры.Вставить("Данные", СтрокаИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Данные")));
	Параметры.Вставить("ПредставлениеДанных", СтрокаИзЗначенияЖР(СвойствоПараметровЖР(Данные, "ПредставлениеДанных")));
	
	Лимит = ЧислоИзЗначенияЖР(СвойствоПараметровЖР(Данные, "Лимит"), 100);
	Если Лимит < 1 Тогда
		Лимит = 1;
	КонецЕсли;
	Параметры.Вставить("Лимит", Лимит);
	
	БюджетСканирования = ЧислоИзЗначенияЖР(СвойствоПараметровЖР(Данные, "БюджетСканирования"), 1000);
	Если БюджетСканирования < 1 Тогда
		БюджетСканирования = 1;
	КонецЕсли;
	Параметры.Вставить("БюджетСканирования", БюджетСканирования);
	
	Параметры.Вставить("ПорядокВывода", ПорядокВыводаЖР(СвойствоПараметровЖР(Данные, "ПорядокВывода")));
	Параметры.Вставить("МаксимальнаяДлинаДанных", ЧислоИзЗначенияЖР(СвойствоПараметровЖР(Данные, "МаксимальнаяДлинаДанных"), 300));
	
	Колонки = СвойствоПараметровЖР(Данные, "Колонки");
	Если ТипЗнч(Колонки) = Тип("Массив") И Колонки.Количество() > 0 Тогда
		Параметры.Вставить("Колонки", НормализованныеКолонкиЖурналаРегистрации(Колонки));
	Иначе
		Параметры.Вставить("Колонки", КолонкиПоУмолчаниюЖурналаРегистрации());
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

&НаСервереБезКонтекста
Функция КолонкиПоУмолчаниюЖурналаРегистрации()
	
	Колонки = Новый Массив;
	Колонки.Добавить("date");
	Колонки.Добавить("level");
	Колонки.Добавить("event");
	Колонки.Добавить("comment");
	Колонки.Добавить("user");
	Колонки.Добавить("computer");
	Колонки.Добавить("session");
	Колонки.Добавить("metadata");
	Возврат Колонки;
	
КонецФункции

&НаСервереБезКонтекста
Функция СвойствоПараметровЖР(Данные, ИмяСвойства)
	
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство(ИмяСвойства, Значение);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

&НаСервереБезКонтекста
Функция МассивИзЗначенияЖР(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
	
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаИзЗначенияЖР(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

&НаСервереБезКонтекста
Функция ВидСравненияПараметровЖР(Значение, ВидПоУмолчанию = "exact")
	
	Вид = НРег(СокрЛП(СтрокаИзЗначенияЖР(Значение)));
	Если Вид = "partial" ИЛИ Вид = "starts_with" ИЛИ Вид = "exact" Тогда
		Возврат Вид;
	КонецЕсли;
	Возврат ВидПоУмолчанию;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПорядокВыводаЖР(Значение)
	
	Порядок = НРег(СокрЛП(СтрокаИзЗначенияЖР(Значение)));
	Если Порядок = "asc" ИЛИ Порядок = "desc" Тогда
		Возврат Порядок;
	КонецЕсли;
	Возврат "desc";
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзЗначенияЖР(Значение, ЗначениеПоУмолчанию)
	
	Если Значение = Неопределено ИЛИ СокрЛП(Строка(Значение)) = "" Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция НормализованныеКолонкиЖурналаРегистрации(Колонки)
	
	Допустимые = Новый Массив;
	Допустимые.Добавить("date");
	Допустимые.Добавить("level");
	Допустимые.Добавить("event");
	Допустимые.Добавить("event_presentation");
	Допустимые.Добавить("comment");
	Допустимые.Добавить("metadata");
	Допустимые.Добавить("metadata_presentation");
	Допустимые.Добавить("data");
	Допустимые.Добавить("data_presentation");
	Допустимые.Добавить("user");
	Допустимые.Добавить("user_name");
	Допустимые.Добавить("computer");
	Допустимые.Добавить("application");
	Допустимые.Добавить("application_presentation");
	Допустимые.Добавить("connection");
	Допустимые.Добавить("session");
	Допустимые.Добавить("server");
	Допустимые.Добавить("port");
	Допустимые.Добавить("sync_port");
	Допустимые.Добавить("transaction");
	Допустимые.Добавить("transaction_status");
	
	Результат = Новый Массив;
	Для Каждого ЛогическоеИмя Из Колонки Цикл
		Имя = НРег(СокрЛП(Строка(ЛогическоеИмя)));
		Если Допустимые.Найти(Имя) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Неизвестная колонка журнала регистрации: ""%1"". Допустимые колонки: %2.",
				Строка(ЛогическоеИмя), СтрСоединить(Допустимые, ", "));
		КонецЕсли;
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Читает журнал регистрации порциями и отдаёт только отобранные строки.
// Платформа возвращает последние события периода, поэтому более старые события
// добираются увеличением размера порции и сдвигом конца периода.
&НаСервереБезКонтекста
Функция ПрочитатьЖурналРегистрацииИзБазы(Параметры)
	
	ЭтоАнглийскийВариант = ЭтоАнглийскийВариантКонфигурацииЖР();
	ИменаКолонок = ИменаКолонокЖурналаРегистрации(ЭтоАнглийскийВариант);
	
	ПроверкиОтбора = Новый Структура;
	ПроверкиОтбора.Вставить("СистемныеИменаСобытий", Новый Массив);
	ПроверкиОтбора.Вставить("ЗначенияСобытий", Новый Массив);
	ПроверкиОтбора.Вставить("ВидСравненияСобытий", Параметры.ВидСравненияСобытия);
	ПроверкиОтбора.Вставить("ЗначениеКомментария", "");
	ПроверкиОтбора.Вставить("ВидСравненияКомментария", Параметры.ВидСравненияКомментария);
	
	Предупреждения = Новый Массив;
	Отбор = ОтборЖурналаРегистрации(Параметры, ПроверкиОтбора);
	КолонкиЧтения = КолонкиЧтенияЖурналаРегистрации(Параметры, ПроверкиОтбора, ИменаКолонок);
	СтрокаКолонокЧтения = СтрокаКолонокЧтенияЖурналаРегистрации(КолонкиЧтения);
	
	Счётчики = Новый Структура;
	Счётчики.Вставить("ПрочитаноПлатформой", 0);
	Счётчики.Вставить("ОбрезаноЗначенийДанных", 0);
	
	ТаблицаРезультата = НоваяТаблицаРезультатаЖурналаРегистрации(Параметры.Колонки);
	КешПользователей = Новый Соответствие;
	
	ЕстьПостфильтры = (ПроверкиОтбора.ЗначенияСобытий.Количество() > 0)
		ИЛИ (ПроверкиОтбора.ЗначениеКомментария <> "");
	
	Порция = ?(ЕстьПостфильтры, 500, Параметры.Лимит);
	Если Порция > Параметры.БюджетСканирования Тогда
		Порция = Параметры.БюджетСканирования;
	КонецЕсли;
	Если Порция < 1 Тогда
		Порция = 1;
	КонецЕсли;
	
	Курсор = Параметры.ДатаОкончания;
	ПериодИсчерпан = Ложь;
	БюджетОбрезалЧтение = Ложь;
	ЛимитДостигнут = Ложь;
	СекундаРазрыва = Неопределено;
	КурсорПредыдущейПорции = Неопределено;
	РазмерПредыдущейПорции = 0;
	
	Пока Счётчики.ПрочитаноПлатформой < Параметры.БюджетСканирования Цикл
		
		ОстатокБюджета = Параметры.БюджетСканирования - Счётчики.ПрочитаноПлатформой;
		Запрос = ?(Порция < ОстатокБюджета, Порция, ОстатокБюджета);
		Если Запрос < 1 Тогда
			Прервать;
		КонецЕсли;
		
		Отбор.ДатаОкончания = Курсор;
		ТаблицаПорции = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТаблицаПорции, Отбор, СтрокаКолонокЧтения, , Запрос);
		
		// Повторное чтение диапазона с большим окном возвращает прежние строки и добавляет более старые.
		// Уже обработанные строки пропускаем; с какой стороны они в таблице, определяем по датам краёв.
		ПропуститьСтрок = 0;
		ПропускВКонце = Ложь;
		Если КурсорПредыдущейПорции <> Неопределено И КурсорПредыдущейПорции = Курсор Тогда
			ПропуститьСтрок = ?(РазмерПредыдущейПорции < ТаблицаПорции.Количество(), РазмерПредыдущейПорции, ТаблицаПорции.Количество());
			ПропускВКонце = ПорядокПоВозрастаниюЖурналаРегистрации(ТаблицаПорции, ИменаКолонок);
		КонецЕсли;
		Счётчики.ПрочитаноПлатформой = Счётчики.ПрочитаноПлатформой + ТаблицаПорции.Количество() - ПропуститьСтрок;
		ДобавитьПодходящиеСтрокиЖурналаРегистрации(Параметры, ПроверкиОтбора, ИменаКолонок, КолонкиЧтения,
			ТаблицаПорции, ПропуститьСтрок, ПропускВКонце, ТаблицаРезультата, КешПользователей, Счётчики);
		КурсорПредыдущейПорции = Курсор;
		РазмерПредыдущейПорции = ТаблицаПорции.Количество();
		
		Если ТаблицаПорции.Количество() < Запрос Тогда
			// Прочитан весь диапазон [ДатаНачала, Курсор]: более старых событий с таким отбором нет.
			ПериодИсчерпан = Истина;
			Прервать;
		КонецЕсли;
		
		Если ТаблицаРезультата.Количество() >= Параметры.Лимит Тогда
			ЛимитДостигнут = Истина;
			Прервать;
		КонецЕсли;
		
		Если Порция < ОстатокБюджета Тогда
			// Окно чтения заполнено: расширяем его, чтобы заглянуть глубже в прошлое.
			Порция = Порция * 2;
			Если Порция > ОстатокБюджета Тогда
				Порция = ОстатокБюджета;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		// Расширять окно некуда: сдвигаем конец периода на секунду назад.
		// Часть событий самой старой секунды окна могла не попасть в выборку — сообщаем об этом.
		МинимальнаяДатаПорции = МинимальнаяДатаТаблицыЖурналаРегистрации(ТаблицаПорции, ИменаКолонок);
		Если МинимальнаяДатаПорции = Неопределено ИЛИ МинимальнаяДатаПорции <= Параметры.ДатаНачала Тогда
			ПериодИсчерпан = Истина;
			Прервать;
		КонецЕсли;
		БюджетОбрезалЧтение = Истина;
		СекундаРазрыва = МинимальнаяДатаПорции;
		Курсор = МинимальнаяДатаПорции - 1;
		
	КонецЦикла;
	
	Если ЛимитДостигнут ИЛИ ПериодИсчерпан Тогда
		БюджетОбрезалЧтение = Ложь;
	КонецЕсли;
	Если БюджетОбрезалЧтение Тогда
		Предупреждения.Добавить(СтрШаблон(
			"Бюджет сканирования (%1) израсходован, в периоде есть ещё события: более старые события не прочитаны. Увеличьте scan_limit или сузьте период и отбор.",
			Формат(Параметры.БюджетСканирования, "ЧГ=0")));
	КонецЕсли;
	Если СекундаРазрыва <> Неопределено Тогда
		Предупреждения.Добавить(СтрШаблон(
			"Часть событий секунды %1 могла не попасть в выборку: конец периода чтения сдвигался на секунду назад.",
			Формат(СекундаРазрыва, "ДЛФ=DT")));
	КонецЕсли;
	
	ТаблицаРезультата.Сортировать("ДатаСортировки Убыв");
	Показано = ТаблицаРезультата.Количество();
	Если Показано > Параметры.Лимит Тогда
		Показано = Параметры.Лимит;
	КонецЕсли;
	
	Строки = Новый Массив;
	Для Инд = 0 По Показано - 1 Цикл
		ИндексВТаблице = ?(Параметры.ПорядокВывода = "asc", Показано - 1 - Инд, Инд);
		СтрокаТаблицы = ТаблицаРезультата[ИндексВТаблице];
		СтрокаРезультата = Новый Структура;
		Для Каждого ЛогическоеИмя Из Параметры.Колонки Цикл
			СтрокаРезультата.Вставить(ЛогическоеИмя, СтрокаТаблицы[ЛогическоеИмя]);
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;
	
	МинимальнаяДатаСтроки = "";
	Если Показано > 0 Тогда
		МинимальнаяДатаСтроки = Формат(ТаблицаРезультата[Показано - 1].ДатаСортировки, "ДЛФ=DT");
	КонецЕсли;
	
	СчётчикиРезультата = Новый Структура;
	СчётчикиРезультата.Вставить("ПрочитаноПлатформой", Счётчики.ПрочитаноПлатформой);
	СчётчикиРезультата.Вставить("ОтобраноПослеФильтра", ТаблицаРезультата.Количество());
	СчётчикиРезультата.Вставить("Показано", Показано);
	СчётчикиРезультата.Вставить("ЛимитДостигнут", ТаблицаРезультата.Количество() > Показано ИЛИ ЛимитДостигнут);
	СчётчикиРезультата.Вставить("БюджетСканированияДостигнут", БюджетОбрезалЧтение);
	СчётчикиРезультата.Вставить("МинДатаСтроки", МинимальнаяДатаСтроки);
	СчётчикиРезультата.Вставить("ЯзыкЖурналаРегистрации", ?(ЭтоАнглийскийВариант, "en", "ru"));
	СчётчикиРезультата.Вставить("ОбрезаноЗначенийДанных", Счётчики.ОбрезаноЗначенийДанных);
	
	ПараметрыРезультата = Новый Структура;
	ПараметрыРезультата.Вставить("ДатаНачала", Формат(Параметры.ДатаНачала, "ДЛФ=DT"));
	ПараметрыРезультата.Вставить("ДатаОкончания", Формат(Параметры.ДатаОкончания, "ДЛФ=DT"));
	ПараметрыРезультата.Вставить("Колонки", Параметры.Колонки);
	ПараметрыРезультата.Вставить("Лимит", Параметры.Лимит);
	ПараметрыРезультата.Вставить("БюджетСканирования", Параметры.БюджетСканирования);
	ПараметрыРезультата.Вставить("ПорядокВывода", Параметры.ПорядокВывода);
	
	Результат = Новый Структура;
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("Счётчики", СчётчикиРезультата);
	Результат.Вставить("Предупреждения", Предупреждения);
	Результат.Вставить("Параметры", ПараметрыРезультата);
	
	Возврат Результат;
	
КонецФункции

// Имена колонок журнала регистрации зависят от варианта встроенного языка конфигурации.
