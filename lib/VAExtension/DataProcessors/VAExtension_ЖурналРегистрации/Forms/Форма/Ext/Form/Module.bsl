// Собирает отбор платформы и проверки, которые нельзя выполнить средствами платформы.
&НаСервереБезКонтекста
Функция ОтборЖурналаРегистрации(Параметры, ПроверкиОтбора)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", Параметры.ДатаНачала);
	Отбор.Вставить("ДатаОкончания", Параметры.ДатаОкончания);
	
	// Событие: платформенный отбор понимает только системные имена событий (вида _$Data$_.Update),
	// поэтому при точном сравнении по системным именам часть работы делает платформа,
	// а представления событий и неточные сравнения досверяются локально.
	Если Параметры.ВидСравненияСобытия = "exact" Тогда
		Для Каждого ЗначениеСобытия Из Параметры.Событие Цикл
			Токен = СокрЛП(Строка(ЗначениеСобытия));
			Если Токен = "" Тогда
				Продолжить;
			КонецЕсли;
			Если Лев(Токен, 2) = "_$" Тогда
				ПроверкиОтбора.СистемныеИменаСобытий.Добавить(Токен);
			Иначе
				ПроверкиОтбора.ЗначенияСобытий.Добавить(Токен);
			КонецЕсли;
		КонецЦикла;
		Если ПроверкиОтбора.ЗначенияСобытий.Количество() > 0 И ПроверкиОтбора.СистемныеИменаСобытий.Количество() > 0 Тогда
			// Платформенный отбор по системным именам отсечёт события, которые ищутся по представлению,
			// поэтому при смешанном наборе читаем без отбора по событию и сверяем всё локально.
			Для Каждого СистемноеИмя Из ПроверкиОтбора.СистемныеИменаСобытий Цикл
				ПроверкиОтбора.ЗначенияСобытий.Добавить(СистемноеИмя);
			КонецЦикла;
			ПроверкиОтбора.СистемныеИменаСобытий = Новый Массив;
		КонецЕсли;
		Если ПроверкиОтбора.СистемныеИменаСобытий.Количество() > 0 Тогда
			Отбор.Вставить("Событие", ПроверкиОтбора.СистемныеИменаСобытий);
		КонецЕсли;
	Иначе
		Для Каждого ЗначениеСобытия Из Параметры.Событие Цикл
			Токен = СокрЛП(Строка(ЗначениеСобытия));
			Если Токен <> "" Тогда
				ПроверкиОтбора.ЗначенияСобытий.Добавить(Токен);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Комментарий: точное сравнение выполняет платформа, локально досверяем его результат.
	Если Параметры.Комментарий <> "" Тогда
		Если Параметры.ВидСравненияКомментария = "exact" Тогда
			Отбор.Вставить("Комментарий", Параметры.Комментарий);
		КонецЕсли;
		ПроверкиОтбора.ЗначениеКомментария = Параметры.Комментарий;
	КонецЕсли;
	
	Если Параметры.Уровень.Количество() > 0 Тогда
		ЗначенияУровней = Новый Массив;
		Для Каждого ИмяУровня Из Параметры.Уровень Цикл
			ЗначениеУровня = ЗначениеУровняЖурналаРегистрации(Строка(ИмяУровня));
			Если ЗначениеУровня = Неопределено Тогда
				ВызватьИсключение СтрШаблон("Неизвестный уровень журнала регистрации: ""%1"". Допустимые значения: Информация, Ошибка, Предупреждение, Примечание (Information, Error, Warning, Note).", Строка(ИмяУровня));
			КонецЕсли;
			ЗначенияУровней.Добавить(ЗначениеУровня);
		КонецЦикла;
		Отбор.Вставить("Уровень", ЗначенияУровней);
	КонецЕсли;
	
	Если Параметры.СтатусТранзакции.Количество() > 0 Тогда
		ЗначенияСтатусов = Новый Массив;
		Для Каждого ИмяСтатуса Из Параметры.СтатусТранзакции Цикл
			ЗначениеСтатуса = ЗначениеСтатусаТранзакцииЖурналаРегистрации(Строка(ИмяСтатуса));
			Если ЗначениеСтатуса = Неопределено Тогда
				ВызватьИсключение СтрШаблон("Неизвестный статус транзакции: ""%1"". Допустимые значения: Зафиксирована, Отменена, НеЗавершена, НетТранзакции (Committed, RolledBack, Unfinished, NotApplicable).", Строка(ИмяСтатуса));
			КонецЕсли;
			ЗначенияСтатусов.Добавить(ЗначениеСтатуса);
		КонецЦикла;
		Отбор.Вставить("СтатусТранзакции", ЗначенияСтатусов);
	КонецЕсли;
	
	Если Параметры.Метаданные.Количество() > 0 Тогда
		ОбъектыМетаданных = Новый Массив;
		Для Каждого ПолноеИмя Из Параметры.Метаданные Цикл
			ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(ПолноеИмя)));
			Если ОбъектМетаданных = Неопределено Тогда
				ВызватьИсключение СтрШаблон("Не найден объект метаданных ""%1"". Укажите полное имя объекта метаданных на языке базы, например ""Документ.РеализацияТоваровУслуг"".", Строка(ПолноеИмя));
			КонецЕсли;
			ОбъектыМетаданных.Добавить(ОбъектМетаданных);
		КонецЦикла;
		Отбор.Вставить("Метаданные", ОбъектыМетаданных);
	КонецЕсли;
	
	Если Параметры.Данные <> "" Тогда
		Отбор.Вставить("Данные", СсылкаИзНавигационнойСсылкиЖурналаРегистрации(Параметры.Данные));
	КонецЕсли;
	Если Параметры.ПредставлениеДанных <> "" Тогда
		Отбор.Вставить("ПредставлениеДанных", Параметры.ПредставлениеДанных);
	КонецЕсли;
	
	ДобавитьОтборИзМассиваЖР(Отбор, "Пользователь", Параметры.Пользователь);
	ДобавитьОтборИзМассиваЖР(Отбор, "Компьютер", Параметры.Компьютер);
	ДобавитьОтборИзМассиваЖР(Отбор, "ИмяПриложения", Параметры.ИмяПриложения);
	ДобавитьОтборИзМассиваЖР(Отбор, "РабочийСервер", Параметры.РабочийСервер);
	ДобавитьОтборИзМассиваЖР(Отбор, "Транзакция", Параметры.Транзакция);
	ДобавитьОтборИзМассиваЧиселЖР(Отбор, "Сеанс", Параметры.Сеанс);
	ДобавитьОтборИзМассиваЧиселЖР(Отбор, "ОсновнойIPПорт", Параметры.ОсновнойIPПорт);
	ДобавитьОтборИзМассиваЧиселЖР(Отбор, "ВспомогательныйIPПорт", Параметры.ВспомогательныйIPПорт);
	
	Возврат Отбор;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьОтборИзМассиваЖР(Отбор, ИмяКлюча, Значения)
	
	Массив = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Токен = СокрЛП(Строка(Значение));
		Если Токен <> "" Тогда
			Массив.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Если Массив.Количество() > 0 Тогда
		Отбор.Вставить(ИмяКлюча, Массив);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьОтборИзМассиваЧиселЖР(Отбор, ИмяКлюча, Значения)
	
	Массив = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Токен = СокрЛП(Строка(Значение));
		Если Токен = "" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЧисловоеЗначение = Число(Токен);
		Исключение
			ВызватьИсключение СтрШаблон("Значение ""%1"" параметра %2 должно быть числом.", Токен, ИмяКлюча);
		КонецПопытки;
		Массив.Добавить(ЧисловоеЗначение);
	КонецЦикла;
	Если Массив.Количество() > 0 Тогда
		Отбор.Вставить(ИмяКлюча, Массив);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкаИзНавигационнойСсылкиЖурналаРегистрации(Стр)
	
	Если Лев(Стр, 11) <> "e1cib/data/" Тогда
		// Не навигационная ссылка: пробуем разобрать как внутреннее представление значения.
		Попытка
			Возврат ЗначениеИзСтрокиВнутр(Стр);
		Исключение
			ВызватьИсключение СтрШаблон("Не удалось получить ссылку из значения ""%1"". Передайте навигационную ссылку вида e1cib/data/... или строку ЗначениеВСтрокуВнутр.", Стр);
		КонецПопытки;
	КонецЕсли;
	
	ВтораяПозиция = СтрНайти(Стр, "?ref=");
	Если ВтораяПозиция = 0 Тогда
		ВызватьИсключение СтрШаблон("В навигационной ссылке ""%1"" не найдена строка ""?ref="".", Стр);
	КонецЕсли;
	
	ПредставлениеТипа = Сред(Стр, 12, ВтораяПозиция - 12);
	Попытка
		ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
		ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(Стр, ВтораяПозиция + 5));
		Возврат ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	Исключение
		ВызватьИсключение СтрШаблон("Из навигационной ссылки ""%1"" не получилось получить ссылку на объект базы данных.", Стр);
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеУровняЖурналаРегистрации(Знач Токен)
	
	Ключ = НРег(СокрЛП(Токен));
	Если Ключ = "информация" ИЛИ Ключ = "information" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("Уровень"), "Информация", "Information");
	ИначеЕсли Ключ = "ошибка" ИЛИ Ключ = "error" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("Уровень"), "Ошибка", "Error");
	ИначеЕсли Ключ = "предупреждение" ИЛИ Ключ = "warning" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("Уровень"), "Предупреждение", "Warning");
	ИначеЕсли Ключ = "примечание" ИЛИ Ключ = "note" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("Уровень"), "Примечание", "Note");
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеСтатусаТранзакцииЖурналаРегистрации(Знач Токен)
	
	Ключ = НРег(СокрЛП(Токен));
	Если Ключ = "зафиксирована" ИЛИ Ключ = "committed" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("СтатусТранзакции"), "Зафиксирована", "Committed");
	ИначеЕсли Ключ = "отменена" ИЛИ Ключ = "rolledback" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("СтатусТранзакции"), "Отменена", "RolledBack");
	ИначеЕсли Ключ = "незавершена" ИЛИ Ключ = "unfinished" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("СтатусТранзакции"), "НеЗавершена", "Unfinished");
	ИначеЕсли Ключ = "неттранзакции" ИЛИ Ключ = "notapplicable" Тогда
		Возврат ЗначениеПеречисленияЖР(ИменаТиповПеречисленияЖР("СтатусТранзакции"), "НетТранзакции", "NotApplicable");
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИменаТиповПеречисленияЖР(Вид)
	
	Имена = Новый Массив;
	Если Вид = "Уровень" Тогда
		Имена.Добавить("УровеньЖурналаРегистрации");
		Имена.Добавить("EventLogLevel");
	Иначе
		Имена.Добавить("СтатусТранзакцииЗаписиЖурналаРегистрации");
		Имена.Добавить("EventLogEntryTransactionStatus");
	КонецЕсли;
	Возврат Имена;
	
КонецФункции

// Значения системных перечислений в разных вариантах встроенного языка могут иметь
// разные имена типов и значений, поэтому подбираем рабочее сочетание перебором.
&НаСервереБезКонтекста
Функция ЗначениеПеречисленияЖР(ИменаТипов, ИмяЗначенияРус, ИмяЗначенияАнгл)
	
	ИменаЗначений = Новый Массив;
	ИменаЗначений.Добавить(ИмяЗначенияРус);
	ИменаЗначений.Добавить(ИмяЗначенияАнгл);
	
	Для Каждого ИмяТипа Из ИменаТипов Цикл
		Для Каждого ИмяЗначения Из ИменаЗначений Цикл
			Попытка
				Возврат Вычислить(ИмяТипа + "." + ИмяЗначения);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция КолонкиЧтенияЖурналаРегистрации(Параметры, ПроверкиОтбора, ИменаКолонок)
	
	КолонкиЧтения = Новый Соответствие;
	КолонкиЧтения.Вставить(ИменаКолонок.Получить("date"), Истина);
	
	Для Каждого ЛогическоеИмя Из Параметры.Колонки Цикл
		ИмяПлатформы = ИменаКолонок.Получить(ЛогическоеИмя);
		Если ИмяПлатформы <> Неопределено Тогда
			КолонкиЧтения.Вставить(ИмяПлатформы, Истина);
		КонецЕсли;
	КонецЦикла;
	
	// Колонки, нужные механике отбора, читаются всегда, но в вывод не попадают.
	// Событие и представление нужны локальному постфильтру; при отборе по системным именам их отбирает платформа.
	Если ПроверкиОтбора.ЗначенияСобытий.Количество() > 0 Тогда
		КолонкиЧтения.Вставить(ИменаКолонок.Получить("event"), Истина);
		КолонкиЧтения.Вставить(ИменаКолонок.Получить("event_presentation"), Истина);
	КонецЕсли;
	Если ПроверкиОтбора.ЗначениеКомментария <> "" Тогда
		КолонкиЧтения.Вставить(ИменаКолонок.Получить("comment"), Истина);
	КонецЕсли;
	
	Возврат КолонкиЧтения;
	
КонецФункции

// Собирает строку имён колонок для метода ВыгрузитьЖурналРегистрации.
&НаСервереБезКонтекста
Функция СтрокаКолонокЧтенияЖурналаРегистрации(КолонкиЧтения)

	Части = Новый Массив;
	Для Каждого КлючИЗначение Из КолонкиЧтения Цикл
		Части.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");

КонецФункции

&НаСервереБезКонтекста
Функция НоваяТаблицаРезультатаЖурналаРегистрации(Колонки)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДатаСортировки", Новый ОписаниеТипов("Дата"));
	Для Каждого ЛогическоеИмя Из Колонки Цикл
		Таблица.Колонки.Добавить(ЛогическоеИмя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Возврат Таблица;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьПодходящиеСтрокиЖурналаРегистрации(Параметры, ПроверкиОтбора, ИменаКолонок, КолонкиЧтения,
	ТаблицаПорции, ПропуститьСтрок, ПропускВКонце, ТаблицаРезультата, КешПользователей, Счётчики)
	
	ВсегоСтрок = ТаблицаПорции.Количество();
	НомерСтроки = 0;
	Для Каждого СтрокаПорции Из ТаблицаПорции Цикл
		НомерСтроки = НомерСтроки + 1;
		Если ПропуститьСтрок > 0 И ((ПропускВКонце И НомерСтроки > ВсегоСтрок - ПропуститьСтрок)
			ИЛИ (НЕ ПропускВКонце И НомерСтроки <= ПропуститьСтрок)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ СтрокаПодходитПоПостфильтруЖурналаРегистрации(ПроверкиОтбора, ИменаКолонок, КолонкиЧтения, СтрокаПорции) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультата = НоваяСтрокаРезультатаЖурналаРегистрации(Параметры, ИменаКолонок, СтрокаПорции, КешПользователей, Счётчики);
		НоваяСтрокаТаблицы = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаРезультата);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокаПодходитПоПостфильтруЖурналаРегистрации(ПроверкиОтбора, ИменаКолонок, КолонкиЧтения, СтрокаПорции)
	
	Если ПроверкиОтбора.ЗначенияСобытий.Количество() > 0 Тогда
		ИмяСобытия = "";
		ПредставлениеСобытия = "";
		Если КолонкиЧтения.Получить(ИменаКолонок.Получить("event")) <> Неопределено Тогда
			ИмяСобытия = СокрЛП(Строка(СтрокаПорции[ИменаКолонок.Получить("event")]));
		КонецЕсли;
		Если КолонкиЧтения.Получить(ИменаКолонок.Получить("event_presentation")) <> Неопределено Тогда
			ПредставлениеСобытия = СокрЛП(Строка(СтрокаПорции[ИменаКолонок.Получить("event_presentation")]));
		КонецЕсли;
		Совпало = Ложь;
		Для Каждого ЗначениеСобытия Из ПроверкиОтбора.ЗначенияСобытий Цикл
			Если СтрокаСоответствуетЖР(ИмяСобытия, ЗначениеСобытия, ПроверкиОтбора.ВидСравненияСобытий)
				ИЛИ СтрокаСоответствуетЖР(ПредставлениеСобытия, ЗначениеСобытия, ПроверкиОтбора.ВидСравненияСобытий) Тогда
				Совпало = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Совпало Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверкиОтбора.ЗначениеКомментария <> "" Тогда
		Комментарий = "";
		Если КолонкиЧтения.Получить(ИменаКолонок.Получить("comment")) <> Неопределено Тогда
			Комментарий = СокрЛП(Строка(СтрокаПорции[ИменаКолонок.Получить("comment")]));
		КонецЕсли;
		Если НЕ СтрокаСоответствуетЖР(Комментарий, ПроверкиОтбора.ЗначениеКомментария, ПроверкиОтбора.ВидСравненияКомментария) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаСоответствуетЖР(Знач Значение, Знач Образец, Знач ВидСравнения)
	
	Значение = НРег(СокрЛП(Значение));
	Образец = НРег(СокрЛП(Образец));
	
	Если ВидСравнения = "exact" Тогда
		Возврат Значение = Образец;
	ИначеЕсли ВидСравнения = "starts_with" Тогда
		Возврат Лев(Значение, СтрДлина(Образец)) = Образец;
	КонецЕсли;
	
	Возврат СтрНайти(Значение, Образец) > 0;
	
КонецФункции

&НаСервереБезКонтекста
Функция НоваяСтрокаРезультатаЖурналаРегистрации(Параметры, ИменаКолонок, СтрокаПорции, КешПользователей, Счётчики)
	
	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("ДатаСортировки", СтрокаПорции[ИменаКолонок.Получить("date")]);
	
	Для Каждого ЛогическоеИмя Из Параметры.Колонки Цикл
		Значение = СтрокаПорции[ИменаКолонок.Получить(ЛогическоеИмя)];
		СтрокаРезультата.Вставить(ЛогическоеИмя, ПредставлениеЗначенияЖурналаРегистрации(ЛогическоеИмя, Значение, Параметры, КешПользователей, Счётчики));
	КонецЦикла;
	
	Возврат СтрокаРезультата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеЗначенияЖурналаРегистрации(ЛогическоеИмя, Значение, Параметры, КешПользователей, Счётчики)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=DT");
	КонецЕсли;
	
	Если ЛогическоеИмя = "data" Тогда
		Текст = ДанныеЖурналаРегистрацииВСтроку(Значение);
		МаксимальнаяДлина = Параметры.МаксимальнаяДлинаДанных;
		Если МаксимальнаяДлина > 0 И СтрДлина(Текст) > МаксимальнаяДлина Тогда
			Счётчики.ОбрезаноЗначенийДанных = Счётчики.ОбрезаноЗначенийДанных + 1;
			Возврат Лев(Текст, МаксимальнаяДлина) + СтрШаблон("...обрезано (всего %1 символов)", Формат(СтрДлина(Текст), "ЧГ=0"));
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;
	
	Если ЛогическоеИмя = "metadata" ИЛИ ЛогическоеИмя = "metadata_presentation" Тогда
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Части = Новый Массив;
			Для Каждого Элемент Из Значение Цикл
				Части.Добавить(СокрЛП(Строка(Элемент)));
			КонецЦикла;
			Возврат СтрСоединить(Части, ", ");
		КонецЕсли;
	КонецЕсли;
	
	Если ЛогическоеИмя = "user" Тогда
		Возврат ИмяПользователяПоИдентификатору(Значение, КешПользователей);
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

&НаСервереБезКонтекста
Функция ИмяПользователяПоИдентификатору(Идентификатор, КешПользователей)
	
	Если Идентификатор = Неопределено ИЛИ СокрЛП(Строка(Идентификатор)) = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Ключ = Строка(Идентификатор);
	Имя = КешПользователей.Получить(Ключ);
	Если Имя <> Неопределено Тогда
		Возврат Имя;
	КонецЕсли;
	
	Имя = "";
	Попытка
		// В журнале регистрации пользователь хранится строкой, а метод ищет по значению типа УникальныйИдентификатор.
		Пользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Ключ));
		Если Пользователь <> Неопределено Тогда
			Имя = СокрЛП(Пользователь.Имя);
		КонецЕсли;
	Исключение
		Имя = "";
	КонецПопытки;
	Если Имя = "" Тогда
		Имя = Ключ;
	КонецЕсли;
	
	КешПользователей.Вставить(Ключ, Имя);
	Возврат Имя;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеЖурналаРегистрацииВСтроку(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Попытка
		ЗначениеДляЗаписи = Значение;
		Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			ЗначениеДляЗаписи = Значение.Выгрузить();
		КонецЕсли;
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ЗначениеДляЗаписи);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Попытка
			Возврат СокрЛП(Строка(Значение));
		Исключение
			Возврат "<значение не удалось преобразовать к строке>";
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

// Истина, если таблица платформы упорядочена по дате по возрастанию: прежние строки окажутся в конце.
// Если все даты равны, направление не определить - считаем порядок прежним (пропуск с начала).
&НаСервереБезКонтекста
Функция ПорядокПоВозрастаниюЖурналаРегистрации(Таблица, ИменаКолонок)

	Если Таблица.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяКолонки = ИменаКолонок.Получить("date");
	Возврат Таблица[Таблица.Количество() - 1][ИмяКолонки] > Таблица[0][ИмяКолонки];

КонецФункции

&НаСервереБезКонтекста
Функция МинимальнаяДатаТаблицыЖурналаРегистрации(Таблица, ИменаКолонок)
	
	ИмяКолонки = ИменаКолонок.Получить("date");
	Минимум = Неопределено;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ДатаСтроки = СтрокаТаблицы[ИмяКолонки];
		Если Минимум = Неопределено ИЛИ ДатаСтроки < Минимум Тогда
			Минимум = ДатаСтроки;
		КонецЕсли;
	КонецЦикла;
	Возврат Минимум;
	
КонецФункции

#КонецОбласти
