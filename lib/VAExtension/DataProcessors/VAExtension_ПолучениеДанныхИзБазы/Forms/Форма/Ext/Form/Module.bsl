#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	ОбработкаВыполнена = Ложь;
	ТекстИсключения = "";
	ЗначениеРезультат = "";
	
	Попытка
		Данные = ПолучитьДанныеСервер();
		ЗначениеРезультат = ЗаписатьОбъектJSON(Данные);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
		// Ошибка возвращается менеджеру в виде JSON-конверта {"ОшибкаВыполнения": "..."},
		// иначе менеджер получает пустую строку и падает на ПрочитатьJSON.
		ОбёрткаОшибки = Новый Структура;
		ОбёрткаОшибки.Вставить("ОшибкаВыполнения", ТекстИсключения);
		ЗначениеРезультат = ЗаписатьОбъектJSON(ОбёрткаОшибки);
	КонецПопытки;
	
	ОбработкаВыполнена = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметры(Команда)
	
	Если НЕ ЗначениеЗаполнено(ДляУстановкиПараметров) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ПрочитатьОбъектJSON(ДляУстановкиПараметров);
	
	Если Данные.Свойство("ДатаНачала") Тогда
		ДатаНачала = Данные.ДатаНачала;
	КонецЕсли;	
	Если Данные.Свойство("ДатаОкончания") Тогда
		ДатаОкончания = Данные.ДатаОкончания;
	КонецЕсли;	
	
	// Отбор по реквизитам (параметр filter инструмента get_table_data).
	// Сбрасываем всегда, иначе отбор предыдущего вызова "залипнет".
	ОтборПоРеквизитам = "";
	Если Данные.Свойство("ОтборПоРеквизитам") Тогда
		ОтборПоРеквизитам = Данные.ОтборПоРеквизитам;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПрочитатьОбъектJSON(ДанныеJSON, ПрочитатьВСоответствие = Ложь)
	
	ЧтениеJSON = New ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ДанныеJSON);
	ИменаСвойствСоЗначениямиДата = Новый Массив;
	ИменаСвойствСоЗначениямиДата.Добавить("ДатаНачала");
	ИменаСвойствСоЗначениямиДата.Добавить("ДатаОкончания");
	Значение = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата);
	ЧтениеJSON.Закрыть();
	Возврат Значение;
	
КонецФункции	 

&НаКлиенте
Функция ЗаписатьОбъектJSON(ДанныеJSON) Экспорт
	#Если НЕ ВебКлиент Тогда

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
	Возврат ЗаписьJSON.Закрыть();
	
	#КонецЕсли
КонецФункции

&НаСервере
Функция ПолучитьДанныеСервер()
	
	Результат = Новый Массив;
	
	Если Тип = "Перечисление" Тогда
		Если Метаданные.Перечисления.Найти(Вид) = Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("ОшибкаНетОбъектаМетаданных", Истина);
			Результат.Вставить("ВсеОбъекты", ВсеПеречисления());
			Возврат Результат;
		КонецЕсли;
		
		ОМ = Метаданные.Перечисления[Вид];
		Для Каждого Элем Из ОМ.ЗначенияПеречисления  Цикл
			ДанныеЗначения = Новый Структура;
			ДанныеЗначения.Вставить("Имя", Элем.Имя);
			ДанныеЗначения.Вставить("Представление", Элем.Синоним);
			Результат.Добавить(ДанныеЗначения);
		КонецЦикла;
	ИначеЕсли Тип = "Справочник" Тогда
		Если Метаданные.Справочники.Найти(Вид) = Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("ОшибкаНетОбъектаМетаданных", Истина);
			Результат.Вставить("ВсеОбъекты", ВсеСправочники());
			Возврат Результат;
		КонецЕсли;
		
		Возврат ПолучитьДанныеСправочника();
	ИначеЕсли Тип = "Документ" Тогда
		Если Метаданные.Документы.Найти(Вид) = Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("ОшибкаНетОбъектаМетаданных", Истина);
			Результат.Вставить("ВсеОбъекты", ВсеДокументы());
			Возврат Результат;
		КонецЕсли;

		Возврат ПолучитьДанныеДокумента();
	ИначеЕсли Тип = "ПланВидовХарактеристик" Тогда
		Если Метаданные.ПланыВидовХарактеристик.Найти(Вид) = Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("ОшибкаНетОбъектаМетаданных", Истина);
			Результат.Вставить("ВсеОбъекты", ВсеПланыВидовХарактеристик());
			Возврат Результат;
		КонецЕсли;

		Возврат ПолучитьДанныеПланаВидовХарактеристик();
	ИначеЕсли Тип = "Константа" Тогда
		Если Метаданные.Константы.Найти(Вид) = Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("ОшибкаНетОбъектаМетаданных", Истина);
			Результат.Вставить("ВсеОбъекты", ВсеКонстанты());
			Возврат Результат;
		КонецЕсли;
		Возврат ПолучитьДанныеКонстанты();
	ИначеЕсли Тип = "ВсеКонстанты" Тогда
		Возврат ПолучитьДанныеВсехКонстант();
	ИначеЕсли Тип = "ВсеСправочники" Тогда
		Возврат ВсеСправочники();
	ИначеЕсли Тип = "ВсеДокументы" Тогда
		Возврат ВсеДокументы();
	ИначеЕсли Тип = "ВсеПеречисления" Тогда
		Возврат ВсеПеречисления();
	ИначеЕсли Тип = "ВсеПланыВидовХарактеристик" Тогда
		Возврат ВсеПланыВидовХарактеристик();
	ИначеЕсли Тип = "ДанныеПоНавигационнойСсылке" Тогда
		Возврат ДанныеОбъектаПоНавигационнойСсылке();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкуИзНавигационной(Стр)
	
	Если ПустаяСтрока(Стр) Тогда
		ВызватьИсключение "Не передана навигационная ссылка";
	КонецЕсли;	
    
    ПерваяПозиция = Найти(Стр, "e1cib/data/");
	Если ПерваяПозиция = 0 Тогда
		ВызватьИсключение "В навигационной ссылке не найдена строка ""e1cib/data/""";
	КонецЕсли;
	
    ВтораяПозиция = Найти(Стр, "?ref=");
	Если ВтораяПозиция = 0 Тогда
		ВызватьИсключение "В навигационной ссылке не найдена строка ""?ref=""";
	КонецЕсли;	
    
    ПредставлениеТипа   = Сред(Стр, ПерваяПозиция + 11, ВтораяПозиция - ПерваяПозиция - 11);
	
	Попытка
    	ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
	Исключение
		ТекстСообщения = "Из навигационной ссылки <%1> не получилось вычислить ссылку на объект базы данных по типу <%2>.";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Стр);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2", ПредставлениеТипа);
		ВызватьИсключение ТекстСообщения
	КонецПопытки;
   	ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(Стр, ВтораяПозиция + 5));
	
	Попытка
    	Возврат ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	Исключение
		ТекстСообщения = "Из навигационной ссылки <%1> не получилось вычислить ссылку на объект базы данных.";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Стр);
		ВызватьИсключение ТекстСообщения
	КонецПопытки;
    
КонецФункции

