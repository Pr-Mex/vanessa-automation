#КонецОбласти

// Отбор по реквизитам (параметр filter инструмента get_table_data).
//
// Строка отбора: по одному условию в строке, вид "ИмяРеквизита [оператор] Значение".
// Операторы: = <> > >= < <= ПОДОБНО (LIKE) СОДЕРЖИТ (CONTAINS). По умолчанию "=".
// Строки, начинающиеся с "//" или "#", и пустые строки игнорируются.
// Значение приводится к типу реквизита по метаданным: ссылки ищутся по наименованию/коду/номеру
// (или принимаются навигационной ссылкой e1cib/...), перечисления - по имени или представлению,
// числа, даты и булевы значения - по общепринятой записи.
#Область ОтборПоРеквизитам

&НаСервере
Функция ОшибкаОтбора(Суть, ЧтоДелать = "")
	Текст = "Ошибка: " + Суть;
	Если ЗначениеЗаполнено(ЧтоДелать) Тогда
		Текст = Текст + Символы.ПС + "Что делать: " + ЧтоДелать;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Секция "ГДЕ ..." запроса по массиву условий. Пустая строка, если условий нет.
&НаСервере
Функция ТекстСекцииГДЕ(МассивУсловий)
	Если МассивУсловий.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "
		|ГДЕ " + СтрСоединить(МассивУсловий, "
		|	И ");
КонецФункции

&НаСервере
Процедура СкопироватьПараметрыЗапроса(ЗапросИсточник, ЗапросПриемник)
	Для Каждого ТекПараметр Из ЗапросИсточник.Параметры Цикл
		ЗапросПриемник.УстановитьПараметр(ТекПараметр.Ключ, ТекПараметр.Значение);
	КонецЦикла;
КонецПроцедуры

// Количество записей таблицы с учётом тех же условий, что и в основном запросе.
&НаСервере
Функция КоличествоПоУсловиям(ПолноеИмяТаблицы, МассивУсловий, ЗапросИсточник)
	ЗапросКоличество = Новый Запрос;
	ЗапросКоличество.Текст = "ВЫБРАТЬ
		|КОЛИЧЕСТВО(___Таблица___.Ссылка) КАК Количество
		|ИЗ
		|" + ПолноеИмяТаблицы + " КАК ___Таблица___" + ТекстСекцииГДЕ(МассивУсловий);
	СкопироватьПараметрыЗапроса(ЗапросИсточник, ЗапросКоличество);
	
	Выборка = ЗапросКоличество.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Разбирает строку отбора в массив условий: {ИмяРеквизита, Оператор, ТекстЗначения, ТипЗначения}.
&НаСервере
Функция РазобратьОтборПоРеквизитам(ТекстОтбора, ОМ)
	
	Результат = Новый Массив;
	СтрокиОтбора = СтрРазделить(ТекстОтбора, Символы.ПС, Истина);
	
	Для Каждого ТекСтрокаОтбора Из СтрокиОтбора Цикл
		ТекСтрокаОтбора = СокрЛП(ТекСтрокаОтбора);
		Если НЕ ЗначениеЗаполнено(ТекСтрокаОтбора) Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(ТекСтрокаОтбора, 2) = "//" ИЛИ Лев(ТекСтрокаОтбора, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизита = "";
		Оператор = "";
		ЗначениеУсловия = "";
		
		// Ищем символьный оператор сравнения.
		ПозицияОператора = 0;
		Для Сч = 1 По СтрДлина(ТекСтрокаОтбора) Цикл
			ТекСимвол = Сред(ТекСтрокаОтбора, Сч, 1);
			Если ТекСимвол = "=" ИЛИ ТекСимвол = "<" ИЛИ ТекСимвол = ">" Тогда
				ПозицияОператора = Сч;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПозицияОператора > 0 Тогда
			ИмяРеквизита = СокрЛП(Лев(ТекСтрокаОтбора, ПозицияОператора - 1));
			Остаток = Сред(ТекСтрокаОтбора, ПозицияОператора);
			ДвухсимвольныйОператор = Лев(Остаток, 2);
			Если ДвухсимвольныйОператор = "<>" ИЛИ ДвухсимвольныйОператор = ">=" ИЛИ ДвухсимвольныйОператор = "<=" Тогда
				Оператор = ДвухсимвольныйОператор;
				ЗначениеУсловия = СокрЛП(Сред(Остаток, 3));
			ИначеЕсли ДвухсимвольныйОператор = "==" ИЛИ ДвухсимвольныйОператор = "!=" Тогда
				Оператор = ?(ДвухсимвольныйОператор = "==", "=", "<>");
				ЗначениеУсловия = СокрЛП(Сред(Остаток, 3));
			Иначе
				Оператор = Лев(Остаток, 1);
				ЗначениеУсловия = СокрЛП(Сред(Остаток, 2));
			КонецЕсли;
		Иначе
			// Символьного оператора нет - возможно, использован словесный (ПОДОБНО, LIKE, СОДЕРЖИТ, CONTAINS).
			ПозицияПервогоПробела = Найти(ТекСтрокаОтбора, " ");
			Если ПозицияПервогоПробела = 0 Тогда
				ИмяРеквизита = ТекСтрокаОтбора;
			Иначе
				ИмяРеквизита = Лев(ТекСтрокаОтбора, ПозицияПервогоПробела - 1);
				Остаток = СокрЛП(Сред(ТекСтрокаОтбора, ПозицияПервогоПробела + 1));
				ПозицияВторогоПробела = Найти(Остаток, " ");
				Если ПозицияВторогоПробела = 0 Тогда
					СловоОператора = ВРег(Остаток);
					ЗначениеУсловия = "";
				Иначе
					СловоОператора = ВРег(Лев(Остаток, ПозицияВторогоПробела - 1));
					ЗначениеУсловия = СокрЛП(Сред(Остаток, ПозицияВторогоПробела + 1));
				КонецЕсли;
				
				Если СловоОператора = "ПОДОБНО" ИЛИ СловоОператора = "LIKE" Тогда
					Оператор = "ПОДОБНО";
				ИначеЕсли СловоОператора = "СОДЕРЖИТ" ИЛИ СловоОператора = "CONTAINS" Тогда
					Оператор = "СОДЕРЖИТ";
				Иначе
					ВызватьИсключение ОшибкаОтбора(
						"В условии отбора """ + ТекСтрокаОтбора + """ не найден оператор сравнения.",
						"Условие записывается как ""ИмяРеквизита оператор Значение"", например: ""Дата >= 01.01.2024"", ""Наименование СОДЕРЖИТ ООО"", ""Контрагент = Альфа"".");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
			ВызватьИсключение ОшибкаОтбора(
				"В условии отбора """ + ТекСтрокаОтбора + """ не указано имя реквизита.",
				"Условие записывается как ""ИмяРеквизита оператор Значение"".");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЗначениеУсловия) Тогда
			ВызватьИсключение ОшибкаОтбора(
				"В условии отбора """ + ТекСтрокаОтбора + """ не указано значение.",
				"Условие записывается как ""ИмяРеквизита оператор Значение"", например ""Дата >= 01.01.2024"".");
		КонецЕсли;
		
		РеквизитМетаданных = НайтиРеквизитОбъектаМетаданных(ОМ, ИмяРеквизита);
		Если РеквизитМетаданных = Неопределено Тогда
			ВызватьИсключение ОшибкаОтбора(
				"У объекта """ + ОМ.ПолноеИмя() + """ нет реквизита """ + ИмяРеквизита + """.",
				"Доступные реквизиты:" + Символы.ПС + ТекстРеквизитовОбъектаМетаданных(ОМ));
		КонецЕсли;
		
		Попытка
			ТипЗначения = РеквизитМетаданных.Тип;
		Исключение
			ВызватьИсключение ОшибкаОтбора(
				"Не получилось определить тип реквизита """ + ИмяРеквизита + """ объекта """ + ОМ.ПолноеИмя() + """.",
				"Уточните реквизит или передайте значение навигационной ссылкой.");
		КонецПопытки;
		
		Если Оператор = "ПОДОБНО" ИЛИ Оператор = "СОДЕРЖИТ" Тогда
			Если НЕ ТипЗначения.СодержитТип(Тип("Строка")) Тогда
				ВызватьИсключение ОшибкаОтбора(
					"Оператор """ + Оператор + """ в условии """ + ТекСтрокаОтбора + """ применим только к строковым реквизитам.",
					"Для остальных типов используйте = <> > >= < <=");
			КонецЕсли;
		ИначеЕсли Оператор = ">" ИЛИ Оператор = ">=" ИЛИ Оператор = "<" ИЛИ Оператор = "<=" Тогда
			Если НЕ ТипЗначения.СодержитТип(Тип("Число")) И НЕ ТипЗначения.СодержитТип(Тип("Дата")) Тогда
				ВызватьИсключение ОшибкаОтбора(
					"Оператор """ + Оператор + """ в условии """ + ТекСтрокаОтбора + """ применим только к числовым реквизитам и датам.",
					"Для строк используйте = <> ПОДОБНО СОДЕРЖИТ, для ссылок - = <>");
			КонецЕсли;
		КонецЕсли;
		
		Условие = Новый Структура;
		Условие.Вставить("ИмяРеквизита", ИмяРеквизита);
		Условие.Вставить("Оператор", Оператор);
		Условие.Вставить("ТекстЗначения", ЗначениеУсловия);
		Условие.Вставить("ТипЗначения", ТипЗначения);
		Результат.Добавить(Условие);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в запрос условия из ОтборПоРеквизитам. ПсевдонимТаблицы - псевдоним таблицы в запросе.
&НаСервере
Процедура ДобавитьУсловияОтбораПоРеквизитам(Запрос, Условия, ОМ, ПсевдонимТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ОтборПоРеквизитам) Тогда
		Возврат;
	КонецЕсли;
	
	РазобранныеУсловия = РазобратьОтборПоРеквизитам(ОтборПоРеквизитам, ОМ);
	
	НомерУсловия = 0;
	Для Каждого ТекУсловие Из РазобранныеУсловия Цикл
		НомерУсловия = НомерУсловия + 1;
		ИмяПараметра = "ОтборЗначение" + XMLСтрока(НомерУсловия);
		ПолеЗапроса = ПсевдонимТаблицы + "." + ТекУсловие.ИмяРеквизита;
		
		ЗначениеОтбора = ПривестиЗначениеОтбора(ТекУсловие.ТекстЗначения, ТекУсловие.ТипЗначения,
			ТекУсловие.ИмяРеквизита);
		
		// Дата без явно указанного времени: "=" и "<>" сравнивают с сутками целиком.
		Если ЗначениеОтбора.ЭтоДата И Не ЗначениеОтбора.ЕстьВремя Тогда
			НачалоСуток = НачалоДня(ЗначениеОтбора.Значение);
			КонецСуток = НачалоСуток + 86400;
			Запрос.УстановитьПараметр(ИмяПараметра + "Начало", НачалоСуток);
			Запрос.УстановитьПараметр(ИмяПараметра + "Конец", КонецСуток);
			Если ТекУсловие.Оператор = "=" Тогда
				Условия.Добавить(ПолеЗапроса + " >= &" + ИмяПараметра + "Начало И " + ПолеЗапроса + " < &" + ИмяПараметра + "Конец");
			ИначеЕсли ТекУсловие.Оператор = "<>" Тогда
				Условия.Добавить("(" + ПолеЗапроса + " < &" + ИмяПараметра + "Начало ИЛИ " + ПолеЗапроса + " >= &" + ИмяПараметра + "Конец)");
			Иначе
				Запрос.УстановитьПараметр(ИмяПараметра, НачалоСуток);
				Условия.Добавить(ПолеЗапроса + " " + ТекУсловие.Оператор + " &" + ИмяПараметра);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Значение = ЗначениеОтбора.Значение;
		Если ТекУсловие.Оператор = "СОДЕРЖИТ" Тогда
			Запрос.УстановитьПараметр(ИмяПараметра, "%" + ЭкранироватьСпецСимволыПодобно(Значение) + "%");
			Условия.Добавить(ПолеЗапроса + " ПОДОБНО &" + ИмяПараметра);
		Иначе
			Запрос.УстановитьПараметр(ИмяПараметра, Значение);
			Условия.Добавить(ПолеЗапроса + " " + ТекУсловие.Оператор + " &" + ИмяПараметра);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Приводит значение из строки отбора к типу реквизита по метаданным.
// Возвращает структуру {Значение, ЭтоДата, ЕстьВремя}.
&НаСервере
Функция ПривестиЗначениеОтбора(ТекстЗначения, ТипЗначения, ИмяРеквизита)
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоДата", Ложь);
	Результат.Вставить("ЕстьВремя", Истина);
	
	Если ТипЗначения.СодержитТип(Тип("Число")) И НЕ ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Результат.Вставить("Значение", ЧислоИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита));
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗначения.СодержитТип(Тип("Булево")) И НЕ ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Результат.Вставить("Значение", БулевоИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита));
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗначения.СодержитТип(Тип("Дата")) И НЕ ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		ДатаОтбора = ДатаИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита);
		Результат.Вставить("Значение", ДатаОтбора.Дата);
		Результат.Вставить("ЭтоДата", Истина);
		Результат.Вставить("ЕстьВремя", ДатаОтбора.ЕстьВремя);
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Результат.Вставить("Значение", ТекстЗначения);
		Возврат Результат;
	КонецЕсли;
	
	// Ссылочные типы (в том числе составные): значение ищем среди объектов подходящих типов.
	Результат.Вставить("Значение", НайтиСсылкуПоЗначению(ТекстЗначения, ТипЗначения.Типы(), ИмяРеквизита));
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЧислоИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита)
	
	Нормализованное = СтрЗаменить(ТекстЗначения, Символы.НБСП, "");
	Нормализованное = СтрЗаменить(Нормализованное, " ", "");
	Нормализованное = СтрЗаменить(Нормализованное, Символы.Таб, "");
	Нормализованное = СтрЗаменить(Нормализованное, ",", ".");
	
	Попытка
		Результат = Число(Нормализованное);
	Исключение
		ВызватьИсключение ОшибкаОтбора(
			"Значение """ + ТекстЗначения + """ в условии для реквизита """ + ИмяРеквизита + """ не похоже на число.",
			"Число записывайте цифрами, дробную часть отделяйте запятой: filter=Сумма >= 1000,50");
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция БулевоИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита)
	
	Значение = ВРег(СокрЛП(ТекстЗначения));
	Если Значение = "ДА" ИЛИ Значение = "ИСТИНА" ИЛИ Значение = "TRUE" ИЛИ Значение = "1" ИЛИ Значение = "ВЕРНО" Тогда
		Возврат Истина;
	ИначеЕсли Значение = "НЕТ" ИЛИ Значение = "ЛОЖЬ" ИЛИ Значение = "FALSE" ИЛИ Значение = "0" ИЛИ Значение = "НЕВЕРНО" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВызватьИсключение ОшибкаОтбора(
		"Значение """ + ТекстЗначения + """ в условии для реквизита """ + ИмяРеквизита + """ не похоже на булево значение.",
		"Используйте Да или Нет: filter=Проведен = Да");
	
КонецФункции

// Дата из строки отбора. Поддерживаются форматы "ДД.ММ.ГГГГ[ чч:мм[:сс]]" и "ГГГГ-ММ-ДД[ чч:мм[:сс]]".
// Возвращает структуру {Дата, ЕстьВремя}.
&НаСервере
Функция ДатаИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита)
	
	Текст = СокрЛП(ТекстЗначения);
	Год = 0;
	Месяц = 0;
	День = 0;
	Остаток = "";
	
	Попытка
		Если СтрДлина(Текст) >= 10 И Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-" Тогда
			// ГГГГ-ММ-ДД
			Год = Число(Лев(Текст, 4));
			Месяц = Число(Сред(Текст, 6, 2));
			День = Число(Сред(Текст, 9, 2));
			Остаток = СокрЛП(Сред(Текст, 11));
		ИначеЕсли СтрДлина(Текст) >= 10 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
			// ДД.ММ.ГГГГ
			День = Число(Лев(Текст, 2));
			Месяц = Число(Сред(Текст, 4, 2));
			Год = Число(Сред(Текст, 7, 4));
			Остаток = СокрЛП(Сред(Текст, 11));
		Иначе
			ВызватьИсключение ОшибкаОтбора("", "");
		КонецЕсли;
		
		ЕстьВремя = Ложь;
		Часы = 0;
		Минуты = 0;
		Секунды = 0;
		
		Если Лев(Остаток, 1) = "T" ИЛИ Лев(Остаток, 1) = "t" Тогда
			Остаток = СокрЛП(Сред(Остаток, 2));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Остаток) Тогда
			ЧастиВремени = СтрРазделить(Остаток, ":", Ложь);
			Если ЧастиВремени.Количество() < 2 ИЛИ ЧастиВремени.Количество() > 3 Тогда
				ВызватьИсключение ОшибкаОтбора("", "");
			КонецЕсли;
			Часы = Число(ЧастиВремени[0]);
			Минуты = Число(ЧастиВремени[1]);
			Если ЧастиВремени.Количество() = 3 Тогда
				Секунды = Число(ЧастиВремени[2]);
			КонецЕсли;
			ЕстьВремя = Истина;
		КонецЕсли;
		
		ДатаОтбора = Дата(Год, Месяц, День, Часы, Минуты, Секунды);
	Исключение
		ВызватьИсключение ОшибкаОтбора(
			"Значение """ + ТекстЗначения + """ в условии для реквизита """ + ИмяРеквизита + """ не похоже на дату.",
			"Форматы даты: ""ДД.ММ.ГГГГ"", ""ДД.ММ.ГГГГ чч:мм:сс"", ""ГГГГ-ММ-ДД"", ""ГГГГ-ММ-ДДTчч:мм:сс"". Пример: filter=Дата >= 01.06.2024");
	КонецПопытки;
	
	Если Год(ДатаОтбора) <> Год ИЛИ Месяц(ДатаОтбора) <> Месяц ИЛИ День(ДатаОтбора) <> День Тогда
		ВызватьИсключение ОшибкаОтбора(
			"Значение """ + ТекстЗначения + """ в условии для реквизита """ + ИмяРеквизита + """ не является корректной датой.",
			"Проверьте день, месяц и год. Пример: filter=Дата >= 01.06.2024");
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Дата", ДатаОтбора);
	Результат.Вставить("ЕстьВремя", ЕстьВремя);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭкранироватьСпецСимволыПодобно(Текст)
	Результат = СтрЗаменить(Текст, "[", "[[]");
	Результат = СтрЗаменить(Результат, "%", "[%]");
	Результат = СтрЗаменить(Результат, "_", "[_]");
	Возврат Результат;
КонецФункции

// Ищет ссылку по представлению значения: наименование, код, номер или навигационная ссылка.
&НаСервере
Функция НайтиСсылкуПоЗначению(ТекстЗначения, МассивТипов, ИмяРеквизита)
	
	Если Лев(ТекстЗначения, 6) = "e1cib/" Тогда
		Попытка
			Возврат ПолучитьСсылкуИзНавигационной(ТекстЗначения);
		Исключение
			ВызватьИсключение ОшибкаОтбора(
				"Не получилось прочитать навигационную ссылку в условии для реквизита """ + ИмяРеквизита + """: " + ТекстЗначения,
				"Проверьте ссылку или передайте значение представлением, например: filter=" + ИмяРеквизита + " = Альфа");
		КонецПопытки;
	КонецЕсли;
	
	// У составных ссылочных реквизитов типов могут быть сотни: перебор ограничиваем,
	// чтобы один отбор не породил сотни запросов.
	МаксимумТиповПоиска = 30;

	НайденныеСсылки = Новый Массив;
	НайденныеПредставления = Новый Массив;
	ПроверенныеТипы = Новый Массив;
	ОшибкиПоиска = Новый Массив;
	
	ОбработаноТипов = 0;
	ПереборОграничен = Ложь;
	Для Каждого ТекТип Из МассивТипов Цикл
		ОбработаноТипов = ОбработаноТипов + 1;
		Если ОбработаноТипов > МаксимумТиповПоиска Тогда
			ПереборОграничен = Истина;
			Прервать;
		КонецЕсли;

		ОМТипа = МетаданныеОбъектаПоТипу(ТекТип);
		Если ОМТипа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоПеречислоМетаданных(ОМТипа) Тогда
			ПроверенныеТипы.Добавить(ОМТипа.ПолноеИмя());
			ЗначениеПеречисления = ЗначениеПеречисленияПоСтроке(ОМТипа, ТекстЗначения);
			Если ЗначениеПеречисления <> Неопределено Тогда
				НайденныеСсылки.Добавить(ЗначениеПеречисления);
				НайденныеПредставления.Добавить(Строка(ЗначениеПеречисления));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ОписаниеПоиска = ОписаниеПоискаСсылкиПоЗначению(ОМТипа, ТекстЗначения);
		Если ОписаниеПоиска = Неопределено Тогда
			// Искать не по чему: у типа нет наименования, кода или номера либо значение к ним не приводится.
			Продолжить;
		КонецЕсли;
		
		ПроверенныеТипы.Добавить(ОМТипа.ПолноеИмя());

		Попытка
			ЗапросПоиска = Новый Запрос;
			ЗапросПоиска.Текст = ОписаниеПоиска.Текст;
			// У объекта Запрос есть только одиночный УстановитьПараметр.
			Для Каждого ТекПараметр Из ОписаниеПоиска.Параметры Цикл
				ЗапросПоиска.УстановитьПараметр(ТекПараметр.Ключ, ТекПараметр.Значение);
			КонецЦикла;
			Выборка = ЗапросПоиска.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				НайденныеСсылки.Добавить(Выборка.Ссылка);
				НайденныеПредставления.Добавить(Строка(Выборка.Ссылка));
			КонецЦикла;
		Исключение
			// Тип пропускаем, но причину сохраняем: иначе ошибка поиска неотличима от «ничего не найдено».
			Если ОшибкиПоиска.Количество() < 3 Тогда
				ОшибкиПоиска.Добавить(ОМТипа.ПолноеИмя() + ": " + ПерваяСтрокаТекста(ОписаниеОшибки()));
			КонецЕсли;
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	Если НайденныеСсылки.Количество() = 0 Тогда
		Если ПроверенныеТипы.Количество() > 0 Тогда
			// Полный список типов в тексте ошибки не нужен: их бывает много.
			ТипыДляТекста = ПроверенныеТипы;
			Если ПроверенныеТипы.Количество() > 5 Тогда
				ТипыДляТекста = Новый Массив;
				Для Индекс = 0 По 4 Цикл
					ТипыДляТекста.Добавить(ПроверенныеТипы[Индекс]);
				КонецЦикла;
				ТипыДляТекста.Добавить("и ещё " + XMLСтрока(ПроверенныеТипы.Количество() - 5));
			КонецЕсли;
			ЧтоДелать = "Поиск вёлся по " + СтрСоединить(ТипыДляТекста, ", ") + " (наименование, код, номер). Проверьте значение или передайте навигационную ссылку: filter=" + ИмяРеквизита + " = e1cib/data/...";
		Иначе
			ЧтоДелать = "Ни по одному типу значения поиск выполнить не удалось. Передайте навигационную ссылку: filter=" + ИмяРеквизита + " = e1cib/data/...";
		КонецЕсли;
		Если ПереборОграничен Тогда
			ЧтоДелать = ЧтоДелать + " Перебраны не все типы значения (их больше " + XMLСтрока(МаксимумТиповПоиска) + "): сузьте значение или передайте навигационную ссылку: filter=" + ИмяРеквизита + " = e1cib/data/...";
		КонецЕсли;
		Если ОшибкиПоиска.Количество() > 0 Тогда
			ЧтоДелать = ЧтоДелать + " Ошибки поиска: " + СтрСоединить(ОшибкиПоиска, "; ");
		КонецЕсли;
		ВызватьИсключение ОшибкаОтбора(
			"По значению """ + ТекстЗначения + """ в условии для реквизита """ + ИмяРеквизита + """ ничего не найдено.",
			ЧтоДелать);
	КонецЕсли;
	
	Если НайденныеСсылки.Количество() > 1 Тогда
		ВызватьИсключение ОшибкаОтбора(
			"По значению """ + ТекстЗначения + """ в условии для реквизита """ + ИмяРеквизита + """ найдено несколько объектов: " + СтрСоединить(НайденныеПредставления, "; "),
			"Уточните значение (например, допишите код или номер) или передайте навигационную ссылку: filter=" + ИмяРеквизита + " = e1cib/data/...");
	КонецЕсли;
	
	Возврат НайденныеСсылки[0];
	
КонецФункции

// Описание поиска ссылки по значению: структура {Текст, Параметры}. Неопределено, если искать не по чему.
// Параметры типизированы по полям: «Код» и «Номер» бывают не только строковыми, и сравнение
// строки с числовым полем запрос не выполнит.
&НаСервере
Функция ОписаниеПоискаСсылкиПоЗначению(ОМТипа, ТекстЗначения)
	
	ПоляПоиска = Новый Массив;
	ПараметрыПоиска = Новый Структура;

	Если НайтиСтандартныйРеквизитМетаданных(ОМТипа, "Наименование") <> Неопределено Тогда
		ПоляПоиска.Добавить("Т.Наименование = &ЗначениеНаименование");
		ПараметрыПоиска.Вставить("ЗначениеНаименование", ТекстЗначения);
	КонецЕсли;

	ДобавитьУсловиеПоискаПоРеквизиту(ПоляПоиска, ПараметрыПоиска, ОМТипа, "Код", "Т.Код = &ЗначениеКод", "ЗначениеКод", ТекстЗначения);
	ДобавитьУсловиеПоискаПоРеквизиту(ПоляПоиска, ПараметрыПоиска, ОМТипа, "Номер", "Т.Номер = &ЗначениеНомер", "ЗначениеНомер", ТекстЗначения);
	
	Если ПоляПоиска.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Текст", "ВЫБРАТЬ ПЕРВЫЕ 10
		|Т.Ссылка КАК Ссылка
		|ИЗ
		|" + ОМТипа.ПолноеИмя() + " КАК Т
		|ГДЕ " + СтрСоединить(ПоляПоиска, " ИЛИ "));
	Описание.Вставить("Параметры", ПараметрыПоиска);

	Возврат Описание;

КонецФункции

// Добавляет условие поиска по стандартному реквизиту (Код, Номер) с учётом его типа.
&НаСервере
Процедура ДобавитьУсловиеПоискаПоРеквизиту(ПоляПоиска, ПараметрыПоиска, ОМТипа, ИмяРеквизита, ТекстУсловия, ИмяПараметра, ТекстЗначения)

	Реквизит = НайтиСтандартныйРеквизитМетаданных(ОМТипа, ИмяРеквизита);
	Если Реквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ТипРеквизита = Реквизит.Тип;
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипРеквизита.СодержитТип(Тип("Число")) Тогда
		Значение = ЧислоИлиНеопределеноДляПоиска(ТекстЗначения);
		Если Значение = Неопределено Тогда
			// Значение не похоже на число: по числовому коду или номеру не ищем.
			Возврат;
		КонецЕсли;
		ПоляПоиска.Добавить(ТекстУсловия);
		ПараметрыПоиска.Вставить(ИмяПараметра, Значение);
	ИначеЕсли ТипРеквизита.СодержитТип(Тип("Строка")) Тогда
		ПоляПоиска.Добавить(ТекстУсловия);
		ПараметрыПоиска.Вставить(ИмяПараметра, ТекстЗначения);
	ИначеЕсли ТипРеквизита.СодержитТип(Тип("Дата")) Тогда
		// У документов бывает датовая нумерация: в условие идёт только корректная дата.
		Попытка
			ОписаниеДаты = ДатаИзСтрокиОтбора(ТекстЗначения, ИмяРеквизита);
		Исключение
			Возврат;
		КонецПопытки;
		ПоляПоиска.Добавить(ТекстУсловия);
		ПараметрыПоиска.Вставить(ИмяПараметра, ОписаниеДаты.Дата);
	КонецЕсли;

КонецПроцедуры

// Первая строка многострочного текста ошибки: в «Что делать» весь текст платформы не нужен.
&НаСервере
Функция ПерваяСтрокаТекста(Текст)

	Текст = СокрЛП(Текст);
	ПозицияПС = СтрНайти(Текст, Символы.ПС);
	Если ПозицияПС = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат СокрЛП(Лев(Текст, ПозицияПС - 1));

КонецФункции

// Число из строки для поиска по числовому коду или номеру. Неопределено, если строка не похожа на число.
&НаСервере
Функция ЧислоИлиНеопределеноДляПоиска(ТекстЗначения)

	Нормализованное = СтрЗаменить(ТекстЗначения, Символы.НБСП, "");
	Нормализованное = СтрЗаменить(Нормализованное, " ", "");
	Нормализованное = СтрЗаменить(Нормализованное, Символы.Таб, "");
	Нормализованное = СтрЗаменить(Нормализованное, ",", ".");
	// Пустое значение числом не считаем: искать по нулевому коду или номеру не нужно.
	Если НЕ ЗначениеЗаполнено(Нормализованное) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Результат = Число(Нормализованное);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Результат;
	
КонецФункции

// Объект метаданных по типу значения (СправочникСсылка.Х -> Справочник.Х). Неопределено, если тип не относится к объектам метаданных.
&НаСервере
Функция МетаданныеОбъектаПоТипу(ТекТип)
	
	Попытка
		Возврат Метаданные.НайтиПоТипу(ТекТип);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ЭтоПеречислоМетаданных(ОМТипа)
	Для Каждого ТекПеречисление Из Метаданные.Перечисления Цикл
		Если ТекПеречисление = ОМТипа Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Значение перечисления по имени значения или по его представлению. Неопределено, если не найдено.
&НаСервере
Функция ЗначениеПеречисленияПоСтроке(ОМПеречисления, ТекстЗначения)
	
	Для Каждого ТекЗначение Из ОМПеречисления.ЗначенияПеречисления Цикл
		Если ВРег(ТекЗначение.Имя) = ВРег(ТекстЗначения) ИЛИ ВРег(Строка(ТекЗначение.Синоним)) = ВРег(ТекстЗначения) Тогда
			Попытка
				Возврат ПредопределенноеЗначение("Перечисление." + ОМПеречисления.Имя + "." + ТекЗначение.Имя);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Полное имя вида "Перечисление.ИмяПеречисления.ИмяЗначения".
	Части = СтрРазделить(ТекстЗначения, ".", Ложь);
	Если Части.Количество() = 3 И ВРег(Части[0]) = "ПЕРЕЧИСЛЕНИЕ" И ВРег(Части[1]) = ВРег(ОМПеречисления.Имя) Тогда
		Попытка
			Возврат ПредопределенноеЗначение(ТекстЗначения);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция МассивТиповВладельцев(ОМ)
	
	Типы = Новый Массив;
	Для Каждого ТекВладелец Из ОМ.Владельцы Цикл
		// Владельцами справочника бывают только справочники и планы видов характеристик.
		Если Метаданные.Справочники.Содержит(ТекВладелец) Тогда
			Типы.Добавить(Тип("СправочникСсылка." + ТекВладелец.Имя));
		ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ТекВладелец) Тогда
			Типы.Добавить(Тип("ПланВидовХарактеристикСсылка." + ТекВладелец.Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Типы;
	
КонецФункции

// Реквизит объекта метаданных по имени: обычный или стандартный. Неопределено, если такого реквизита нет.
&НаСервере
Функция НайтиРеквизитОбъектаМетаданных(ОМ, ИмяРеквизита)
	
	Реквизит = ОМ.Реквизиты.Найти(ИмяРеквизита);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит;
	КонецЕсли;
	
	Реквизит = НайтиСтандартныйРеквизитМетаданных(ОМ, ИмяРеквизита);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит;
	КонецЕсли;
	
	// Табличные части и их реквизиты в отборе не участвуют, поэтому дальше не ищем.
	Возврат Неопределено;
	
КонецФункции

// Стандартный реквизит объекта метаданных по имени. Неопределено, если такого реквизита нет.
// Перебираем коллекцию, а не ищем методом Найти: у «Свойств стандартных реквизитов» метода Найти нет.
&НаСервере
Функция НайтиСтандартныйРеквизитМетаданных(ОМ, ИмяРеквизита)

	Попытка
		Для Каждого ТекРеквизит Из ОМ.СтандартныеРеквизиты Цикл
			Если ВРег(ТекРеквизит.Имя) = ВРег(ИмяРеквизита) Тогда
				Возврат ТекРеквизит;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// У объекта метаданных нет свойства СтандартныеРеквизиты.
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Список реквизитов объекта метаданных (обычных и стандартных) для текста подсказки.
&НаСервере
Функция ТекстРеквизитовОбъектаМетаданных(ОМ)
	
	Строки = Новый Массив;
	
	Попытка
		Для Каждого ТекРеквизит Из ОМ.СтандартныеРеквизиты Цикл
			Строки.Добавить("- " + ТекРеквизит.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Для Каждого ТекРеквизит Из ОМ.Реквизиты Цикл
		Строки.Добавить("- " + ТекРеквизит.Имя);
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

#КонецОбласти
