&НаСервере
Функция ПолучитьДанныеКонстанты()
	
	ТекКонстанта = Константы[Вид];
	ЗначениеКонстанты = ТекКонстанта.Получить();
	
	ДанныеКонстанты = Новый Структура;
	ДанныеКонстанты.Вставить("Имя", Метаданные.Константы[Вид].Имя);
	ДанныеКонстанты.Вставить("Представление", Метаданные.Константы[Вид].Синоним);
	ДанныеКонстанты.Вставить("Значение", Строка(ЗначениеКонстанты));
	ДанныеКонстанты.Вставить("ТипЗначения", Строка(ТипЗнч(ЗначениеКонстанты)));
	
	// Дополнительно возвращаем общее количество констант в базе,
	// чтобы MCP-клиент мог видеть, сколько всего констант определено в конфигурации.
	Результат = Новый Структура;
	Результат.Вставить("КоличествоКонстант", Метаданные.Константы.Количество());
	Результат.Вставить("ДанныеКонстанты", ДанныеКонстанты);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеВсехКонстант()

	// Параметры диапазона (1-based, включительные границы).
	// Если реквизиты формы не заполнены, берём весь список.
	НачальнаяГраница = ?(ЗначениеЗаполнено(НачальныйНомер), НачальныйНомер, 1);
	КонечнаяГраница  = ?(ЗначениеЗаполнено(КонечныйНомер),  КонечныйНомер,  Метаданные.Константы.Количество());

	// Если НачальнаяГраница > КонечнаяГраница, итерация ниже естественным образом
	// вернёт пустой массив - валидация на уровне MCP-инструмента выдаст ошибку INVALID_PARAMS.

	Данные = Новый Массив;

	ТекущийНомер = 0;
	Для Каждого ТекКонстанта Из Метаданные.Константы Цикл
		ТекущийНомер = ТекущийНомер + 1;

		Если ТекущийНомер < НачальнаяГраница Тогда
			Продолжить;
		КонецЕсли;
		Если ТекущийНомер > КонечнаяГраница Тогда
			Прервать;
		КонецЕсли;

		Имя = ТекКонстанта.Имя;
		ЗначениеКонстанты = Константы[Имя].Получить();

		ДанныеОднойКонстанты = Новый Структура;
		ДанныеОднойКонстанты.Вставить("Имя", Имя);
		ДанныеОднойКонстанты.Вставить("Представление", Метаданные.Константы[Имя].Синоним);
		ДанныеОднойКонстанты.Вставить("Значение", Строка(ЗначениеКонстанты));
		ДанныеОднойКонстанты.Вставить("ТипЗначения", Строка(ТипЗнч(ЗначениеКонстанты)));

		Данные.Добавить(ДанныеОднойКонстанты);
	КонецЦикла;

	// Обёртка для согласованности с ПолучитьДанныеКонстанты:
	// КоличествоКонстант - общее количество в базе,
	// ДанныеКонстант - отфильтрованный массив значений.
	Результат = Новый Структура;
	Результат.Вставить("КоличествоКонстант", Метаданные.Константы.Количество());
	Результат.Вставить("ДанныеКонстант", Данные);

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьОписаниеФункциональнойОпции(ИмяОпции)
	
	Для Каждого Опция Из Метаданные.ФункциональныеОпции Цикл
		Если Опция.Имя = ИмяОпции Тогда
			Возврат Опция;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеСправочника()

	Запрос = Новый Запрос;

	ИмяСправочника = Вид;

	ОМ = Метаданные.Справочники[ИмяСправочника];
	ДлинаКода = ОМ.ДлинаКода;
	ДлинаНаименования = ОМ.ДлинаНаименования;

	Если ДлинаКода > 0 Тогда
		ЕстьКод = Истина;
	Иначе
		ЕстьКод = Ложь;
	КонецЕсли;

	Если ДлинаНаименования > 0 Тогда
		ЕстьНаименование = Истина;
	Иначе
		ЕстьНаименование = Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборПоНаименованию) И НЕ ЕстьНаименование Тогда
		ВызватьИсключение "У справочника """ + ИмяСправочника + """ нет реквизита ""Наименование"" — отбор по наименованию невозможен. Справочники без наименования нужно читать без фильтра.";
	КонецЕсли;

	СтрокаКоличествоСсылок = " ПЕРВЫЕ " + XMLСтрока(КоличествоСсылок);
	Если КоличествоСсылок = 0 Тогда
		СтрокаКоличествоСсылок = "";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ" + СтрокаКоличествоСсылок + "
		|___Таблица___.Ссылка КАК Ссылка,
		|___Таблица___.ПометкаУдаления КАК ПометкаУдаления";

	Если ЕстьНаименование Тогда
		ТекстЗапроса = ТекстЗапроса + "," + Символы.ПС + "___Таблица___.Наименование КАК Наименование";
	КонецЕсли;
	Если ЕстьКод Тогда
		ТекстЗапроса = ТекстЗапроса + "," +  Символы.ПС + "___Таблица___.Код КАК Код";
	КонецЕсли;

	// Добавляем владельца если указан
	Если ЗначениеЗаполнено(ИмяВладельца) ИЛИ ОМ.Владельцы.Количество() Тогда
		ЕстьВладелец = Истина;
		ТекстЗапроса = ТекстЗапроса + ",
		|___Таблица___.Владелец КАК Владелец";
	Иначе
		ЕстьВладелец = Ложь;
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|Справочник." + ИмяСправочника + " КАК ___Таблица___";

	Условия = Новый Массив;

	// Условие по владельцу: сравнение по ссылке (значение ищется среди типов владельцев справочника).
	Если ЗначениеЗаполнено(ИмяВладельца) Тогда
		Если ОМ.Владельцы.Количество() = 0 Тогда
			ВызватьИсключение "У справочника """ + ИмяСправочника + """ нет реквизита ""Владелец"", поэтому параметр owner к нему неприменим."
				+ Символы.ПС + "Отбор по реквизитам справочника задавайте параметром filter, например: filter=Контрагент = Альфа"
				+ Символы.ПС + "Реквизиты справочника """ + ИмяСправочника + """:"
				+ Символы.ПС + ТекстРеквизитовОбъектаМетаданных(ОМ);
		КонецЕсли;
		
		СсылкаВладельца = НайтиСсылкуПоЗначению(ИмяВладельца, МассивТиповВладельцев(ОМ), "Владелец");
		Условия.Добавить("___Таблица___.Владелец = &Владелец");
		Запрос.УстановитьПараметр("Владелец", СсылкаВладельца);
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
		// ВидОтбораПоНаименованию: "EXACT" (точное совпадение), "PARTIAL" (подстрока в любом месте),
		// "STARTS_WITH" (наименование начинается со значения).
		// Любое другое или пустое значение трактуется как "EXACT" для обратной совместимости.
		ТекстУсловия = "___Таблица___.Наименование = &Наименование";
		ЗначениеПараметра = ОтборПоНаименованию;
		Если ВРег(ВидОтбораПоНаименованию) = "PARTIAL" Тогда
			ТекстУсловия = "___Таблица___.Наименование ПОДОБНО &Наименование";
			ЗначениеПараметра = "%" + ОтборПоНаименованию + "%";
		ИначеЕсли ВРег(ВидОтбораПоНаименованию) = "STARTS_WITH" Тогда
			ТекстУсловия = "___Таблица___.Наименование ПОДОБНО &Наименование";
			ЗначениеПараметра = ОтборПоНаименованию + "%";
		КонецЕсли;
		Условия.Добавить(ТекстУсловия);
		Запрос.УстановитьПараметр("Наименование", ЗначениеПараметра);
	КонецЕсли;

	// Отбор по реквизитам (параметр filter инструмента get_table_data).
	ДобавитьУсловияОтбораПоРеквизитам(Запрос, Условия, ОМ, "___Таблица___");

	ТекстЗапроса = ТекстЗапроса + ТекстСекцииГДЕ(Условия);

	// Реквизит «Наименование» есть не у всех справочников (например, КБК) — сортируем по тому, что есть.
	Если ЕстьНаименование Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО Наименование";
	ИначеЕсли ЕстьКод Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО Код";
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	РезультатЗапроса = Запрос.Выполнить();

	// Отдельный запрос без фильтров для получения общего количества элементов в базе.
	// На этот запрос НЕ накладываются фильтры (по владельцу, по наименованию),
	// чтобы пользователь видел реальное количество элементов в справочнике.
	ЗапросКоличество = Новый Запрос;
	ЗапросКоличество.Текст =
		"ВЫБРАТЬ
		|КОЛИЧЕСТВО(___Таблица___.Ссылка) КАК ВсегоЭлементов
		|ИЗ
		|Справочник." + ИмяСправочника + " КАК ___Таблица___";

	ВыборкаКоличество = ЗапросКоличество.Выполнить().Выбрать();
	ВсегоЭлементов = 0;
	Если ВыборкаКоличество.Следующий() Тогда
		ВсегоЭлементов = ВыборкаКоличество.ВсегоЭлементов;
	КонецЕсли;

	// Количество элементов, удовлетворяющих заданным отборам (чтобы было видно, сколько нашлось всего,
	// а не только сколько попало в ответ из-за параметра limit).
	НайденоЭлементов = КоличествоПоУсловиям("Справочник." + ИмяСправочника, Условия, Запрос);

	Результат = Новый Массив;

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ВыборкаДетальныеЗаписи.Ссылка);
		Данные = Новый Структура;
		Данные.Вставить("Ссылка", Строка(ВыборкаДетальныеЗаписи.Ссылка));
		Данные.Вставить("НавигационнаяСсылка", НавигационнаяСсылка);
		Данные.Вставить("ПометкаУдаления", ВыборкаДетальныеЗаписи.ПометкаУдаления);
		Если ЕстьНаименование Тогда
			Данные.Вставить("Наименование", ВыборкаДетальныеЗаписи.Наименование);
		КонецЕсли;
		Если ЕстьКод Тогда
			Данные.Вставить("Код", ВыборкаДетальныеЗаписи.Код);
		КонецЕсли;
		Если ЕстьВладелец Тогда
			Данные.Вставить("Владелец", Строка(ВыборкаДетальныеЗаписи.Владелец));
		КонецЕсли;
		Результат.Добавить(Данные);

	КонецЦикла;

	// Возвращаем обёртку {КоличествоЭлементов, НайденоЭлементов, ДанныеЭлементов}, чтобы MCP-клиент
	// мог видеть как список элементов, так и общее количество элементов в справочнике и количество по отбору.
	Обёртка = Новый Структура;
	Обёртка.Вставить("КоличествоЭлементов", ВсегоЭлементов);
	Обёртка.Вставить("НайденоЭлементов", НайденоЭлементов);
	Обёртка.Вставить("ДанныеЭлементов", Результат);
	Возврат Обёртка;

КонецФункции

&НаСервере
Функция ПолучитьДанныеПланаВидовХарактеристик()

	Запрос = Новый Запрос;

	ИмяПВХ = Вид;

	ОМ = Метаданные.ПланыВидовХарактеристик[ИмяПВХ];
	ДлинаКода = ОМ.ДлинаКода;
	ДлинаНаименования = ОМ.ДлинаНаименования;

	Если ДлинаКода > 0 Тогда
		ЕстьКод = Истина;
	Иначе
		ЕстьКод = Ложь;
	КонецЕсли;

	Если ДлинаНаименования > 0 Тогда
		ЕстьНаименование = Истина;
	Иначе
		ЕстьНаименование = Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборПоНаименованию) И НЕ ЕстьНаименование Тогда
		ВызватьИсключение "У плана видов характеристик """ + ИмяПВХ + """ нет реквизита ""Наименование"" — отбор по наименованию невозможен. Планы видов характеристик без наименования нужно читать без фильтра.";
	КонецЕсли;

	СтрокаКоличествоСсылок = " ПЕРВЫЕ " + XMLСтрока(КоличествоСсылок);
	Если КоличествоСсылок = 0 Тогда
		СтрокаКоличествоСсылок = "";
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ" + СтрокаКоличествоСсылок + "
		|___Таблица___.Ссылка КАК Ссылка,
		|___Таблица___.ПометкаУдаления КАК ПометкаУдаления";

	Если ЕстьНаименование Тогда
		ТекстЗапроса = ТекстЗапроса + "," + Символы.ПС + "___Таблица___.Наименование КАК Наименование";
	КонецЕсли;
	Если ЕстьКод Тогда
		ТекстЗапроса = ТекстЗапроса + "," +  Символы.ПС + "___Таблица___.Код КАК Код";
	КонецЕсли;

	// У плана видов характеристик не бывает владельцев.

	ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|ПланВидовХарактеристик." + ИмяПВХ + " КАК ___Таблица___";

	Условия = Новый Массив;

	Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
		// ВидОтбораПоНаименованию: "EXACT" (точное совпадение), "PARTIAL" (подстрока в любом месте),
		// "STARTS_WITH" (наименование начинается со значения).
		// Любое другое или пустое значение трактуется как "EXACT" для обратной совместимости.
		ТекстУсловия = "___Таблица___.Наименование = &Наименование";
		ЗначениеПараметра = ОтборПоНаименованию;
		Если ВРег(ВидОтбораПоНаименованию) = "PARTIAL" Тогда
			ТекстУсловия = "___Таблица___.Наименование ПОДОБНО &Наименование";
			ЗначениеПараметра = "%" + ОтборПоНаименованию + "%";
		ИначеЕсли ВРег(ВидОтбораПоНаименованию) = "STARTS_WITH" Тогда
			ТекстУсловия = "___Таблица___.Наименование ПОДОБНО &Наименование";
			ЗначениеПараметра = ОтборПоНаименованию + "%";
		КонецЕсли;
		Условия.Добавить(ТекстУсловия);
		Запрос.УстановитьПараметр("Наименование", ЗначениеПараметра);
	КонецЕсли;

	// Отбор по реквизитам (параметр filter инструмента get_table_data).
	ДобавитьУсловияОтбораПоРеквизитам(Запрос, Условия, ОМ, "___Таблица___");

	ТекстЗапроса = ТекстЗапроса + ТекстСекцииГДЕ(Условия);

	// Реквизит «Наименование» есть не у всех планов видов характеристик — сортируем по тому, что есть.
	Если ЕстьНаименование Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО Наименование";
	ИначеЕсли ЕстьКод Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО Код";
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	РезультатЗапроса = Запрос.Выполнить();

	// Отдельный запрос без фильтров для получения общего количества элементов в базе.
	// На этот запрос НЕ накладываются фильтры (по владельцу, по наименованию),
	// чтобы пользователь видел реальное количество элементов в плане видов характеристик.
	ЗапросКоличество = Новый Запрос;
	ЗапросКоличество.Текст =
		"ВЫБРАТЬ
		|КОЛИЧЕСТВО(___Таблица___.Ссылка) КАК ВсегоЭлементов
		|ИЗ
		|ПланВидовХарактеристик." + ИмяПВХ + " КАК ___Таблица___";

	ВыборкаКоличество = ЗапросКоличество.Выполнить().Выбрать();
	ВсегоЭлементов = 0;
	Если ВыборкаКоличество.Следующий() Тогда
		ВсегоЭлементов = ВыборкаКоличество.ВсегоЭлементов;
	КонецЕсли;

	// Количество элементов, удовлетворяющих заданным отборам.
	НайденоЭлементов = КоличествоПоУсловиям("ПланВидовХарактеристик." + ИмяПВХ, Условия, Запрос);

	Результат = Новый Массив;

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ВыборкаДетальныеЗаписи.Ссылка);
		Данные = Новый Структура;
		Данные.Вставить("Ссылка", Строка(ВыборкаДетальныеЗаписи.Ссылка));
		Данные.Вставить("НавигационнаяСсылка", НавигационнаяСсылка);
		Данные.Вставить("ПометкаУдаления", ВыборкаДетальныеЗаписи.ПометкаУдаления);
		Если ЕстьНаименование Тогда
			Данные.Вставить("Наименование", ВыборкаДетальныеЗаписи.Наименование);
		КонецЕсли;
		Если ЕстьКод Тогда
			Данные.Вставить("Код", ВыборкаДетальныеЗаписи.Код);
		КонецЕсли;
		Результат.Добавить(Данные);

	КонецЦикла;

	// Возвращаем обёртку {КоличествоЭлементов, НайденоЭлементов, ДанныеЭлементов}, чтобы MCP-клиент
	// мог видеть как список элементов, так и общее количество элементов в плане видов характеристик и количество по отбору.
	Обёртка = Новый Структура;
	Обёртка.Вставить("КоличествоЭлементов", ВсегоЭлементов);
	Обёртка.Вставить("НайденоЭлементов", НайденоЭлементов);
	Обёртка.Вставить("ДанныеЭлементов", Результат);
	Возврат Обёртка;

КонецФункции	

&НаСервере
Функция ПолучитьДанныеДокумента()
	
	Запрос = Новый Запрос;
	
	ИмяДокумента = Вид;
	
	ОМ = Метаданные.Документы[ИмяДокумента];
	ДлинаНомера = ОМ.ДлинаНомера;	
	
	Если ДлинаНомера > 0 Тогда
		ЕстьНомер = Истина;
	Иначе	
		ЕстьНомер = Ложь;
	КонецЕсли;
	
	Если ОМ.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		ЕстьПризнакПроведен = Истина;
	Иначе	
		ЕстьПризнакПроведен = Ложь;
	КонецЕсли;
	
	СтрокаКоличествоСсылок = " ПЕРВЫЕ " + XMLСтрока(КоличествоСсылок);
	Если КоличествоСсылок = 0 Тогда
		СтрокаКоличествоСсылок = "";
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ" + СтрокаКоличествоСсылок + "
		|___Таблица___.Ссылка КАК Ссылка,
		|___Таблица___.ПометкаУдаления КАК ПометкаУдаления";
	
	ТекстЗапроса = ТекстЗапроса + "," + Символы.ПС + "___Таблица___.Дата КАК Дата";
	Если ЕстьНомер Тогда
		ТекстЗапроса = ТекстЗапроса + "," +  Символы.ПС + "___Таблица___.Номер КАК Номер";
	КонецЕсли;	
	Если ЕстьПризнакПроведен Тогда
		ТекстЗапроса = ТекстЗапроса + "," +  Символы.ПС + "___Таблица___.Проведен КАК Проведен";
	КонецЕсли;	
	
	ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|Документ." + ИмяДокумента + " КАК ___Таблица___";
	
	Условия = Новый Массив;

	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Условия.Добавить("___Таблица___.Дата >= &ДатаНачала");
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Условия.Добавить("___Таблица___.Дата <= &ДатаОкончания");
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	КонецЕсли;

	// Отбор по реквизитам (параметр filter инструмента get_table_data).
	// Например: "Проведен = Да", "Контрагент = Альфа", "Номер = мп00-000001".
	ДобавитьУсловияОтбораПоРеквизитам(Запрос, Условия, ОМ, "___Таблица___");

	ТекстЗапроса = ТекстЗапроса + ТекстСекцииГДЕ(Условия);

	ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО Дата";
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	// Отдельный запрос без фильтров для получения общего количества документов в базе.
	// На этот запрос НЕ накладываются фильтры по датам (date_start, date_end),
	// чтобы пользователь видел реальное количество документов в информационной базе.
	ЗапросКоличество = Новый Запрос;
	ЗапросКоличество.Текст = 
		"ВЫБРАТЬ
		|КОЛИЧЕСТВО(___Таблица___.Ссылка) КАК ВсегоДокументов
		|ИЗ
		|Документ." + ИмяДокумента + " КАК ___Таблица___";
	
	ВыборкаКоличество = ЗапросКоличество.Выполнить().Выбрать();
	ВсегоДокументов = 0;
	Если ВыборкаКоличество.Следующий() Тогда
		ВсегоДокументов = ВыборкаКоличество.ВсегоДокументов;
	КонецЕсли;
	
	// Количество документов, удовлетворяющих заданным отборам (даты и filter).
	НайденоДокументов = КоличествоПоУсловиям("Документ." + ИмяДокумента, Условия, Запрос);
	
	Результат = Новый Массив;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ВыборкаДетальныеЗаписи.Ссылка);
		Данные = Новый Структура;
		Данные.Вставить("Ссылка", Строка(ВыборкаДетальныеЗаписи.Ссылка));
		Данные.Вставить("ПометкаУдаления", ВыборкаДетальныеЗаписи.ПометкаУдаления);
		Данные.Вставить("НавигационнаяСсылка", НавигационнаяСсылка);
		Данные.Вставить("Дата", ВыборкаДетальныеЗаписи.Дата);
		Если ЕстьНомер Тогда
			Данные.Вставить("Номер", ВыборкаДетальныеЗаписи.Номер);
		КонецЕсли;
		Если ЕстьПризнакПроведен Тогда
			Данные.Вставить("Проведен", ВыборкаДетальныеЗаписи.Проведен);
		КонецЕсли;
		Результат.Добавить(Данные);
		
	КонецЦикла;
	
	// Возвращаем обёртку {КоличествоДокументов, НайденоДокументов, ДанныеДокументов}, чтобы MCP-клиент
	// мог видеть как список документов, так и общее количество документов в базе и количество по отбору.
	Обёртка = Новый Структура;
	Обёртка.Вставить("КоличествоДокументов", ВсегоДокументов);
	Обёртка.Вставить("НайденоДокументов", НайденоДокументов);
	Обёртка.Вставить("ДанныеДокументов", Результат);
	Возврат Обёртка;
	
КонецФункции	

