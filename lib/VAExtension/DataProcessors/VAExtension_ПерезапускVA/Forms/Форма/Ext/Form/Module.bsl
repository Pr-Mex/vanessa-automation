&НаКлиенте
Перем Этап;

&НаКлиенте
Перем Счетчик;

&НаКлиенте
Перем СтараяФормаЗакрыта;

&НаКлиенте
Перем ВремяНачалаОжиданияЗакрытия;

&НаКлиенте
Перем ОшибкаПроверкиОконЗаписана;

&НаСервере
Процедура ПриСозданииНаСервере(Параметры, Отказ)

	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("ПутьКФайлуEPF", ПутьКОбработке);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ПустаяСтрока(ПутьКОбработке) Тогда
		ПрочитатьПутьИзФайлаПараметров();
	КонецЕсли;

	ЗаписатьШаг("ПриОткрытии: " + ПутьКОбработке);

	Если ПустаяСтрока(ПутьКОбработке) Тогда
		ЗаписатьШаг("Путь к EPF не передан, закрытие");
		Закрыть();
		Возврат;
	КонецЕсли;

	// Флаги нужно инициализировать: НЕ Неопределено даёт ошибку типа.
	СтараяФормаЗакрыта = Ложь;
	ОшибкаПроверкиОконЗаписана = Ложь;
	ВремяНачалаОжиданияЗакрытия = ТекущаяДата();
	Этап = 0;
	Счетчик = 0;
	ПодключитьОбработчикОжидания("ШагПерезапуска", 1);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЗакрытиеVanessaAutomation" Тогда
		СтараяФормаЗакрыта = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ШагПерезапуска()

	Счетчик = Счетчик + 1;

	Если Этап = 0 Тогда
		// Новую VA открываем только после оповещения о закрытии и исчезновения окна старой формы.
		СостояниеФормы = СостояниеСтаройОсновнойФормы();
		Если (СтараяФормаЗакрыта <> Истина) ИЛИ (СостояниеФормы = Истина) Тогда
			Если ТекущаяДата() - ВремяНачалаОжиданияЗакрытия >= 120 Тогда
				Попытка
					ЗаписатьШаг("Закрытие старой формы не подтверждено за 120 секунд, перезапуск отменён");
				Исключение
				КонецПопытки;
				ОтключитьОбработчикОжидания("ШагПерезапуска");
				Закрыть();
			КонецЕсли;
			Возврат;
		КонецЕсли;

		ЗаписатьШаг("Старая форма закрыта, перехожу к подключению");
		Этап = 1;
		Счетчик = 0;

	ИначеЕсли Этап = 1 Тогда
		// Пауза после фактического закрытия: даём освободить объект внешней обработки.
		Если Счетчик < 10 Тогда
			Возврат;
		КонецЕсли;

		ЗаписатьШаг("Подключение: " + ПутьКОбработке);
		Попытка
			ИмяОбработки = ПодключитьVA(ПутьКОбработке);
			Если ЗначениеЗаполнено(ИмяОбработки) Тогда
				ПараметрыФормы = Новый Структура;
				ФормаVA = ПолучитьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ЧтениеПараметровПриОткрытии",
					ПараметрыФормы, , Новый УникальныйИдентификатор);
				ФормаVA.Открыть();
				ЗаписатьСобытие("VanessaAutomation.MCP.Перезапуск.НоваяФормаЗапрошена",
					"{""ИмяОбработки"": """ + ИмяОбработки + """}");
				ЗаписатьШаг("Форма новой VA открыта: " + ИмяОбработки);
				Этап = 2;
				Счетчик = 0;
			ИначеЕсли Счетчик > 30 Тогда
				ЗаписатьШаг("Не удалось подключить VA из " + ПутьКОбработке);
				ОтключитьОбработчикОжидания("ШагПерезапуска");
				Закрыть();
			КонецЕсли;
		Исключение
			Если Счетчик > 30 Тогда
				ЗаписатьШаг("Ошибка подключения VA: " + ОписаниеОшибки());
				ОтключитьОбработчикОжидания("ШагПерезапуска");
				Закрыть();
			КонецЕсли;
		КонецПопытки;

	ИначеЕсли Этап = 2 Тогда
		// Ждём инициализации новой VA, затем закрываем помощник.
		Если Счетчик >= 10 Тогда
			ЗаписатьШаг("Новая VA открыта, помощник закрывается");
			ОтключитьОбработчикОжидания("ШагПерезапуска");
			Закрыть();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СостояниеСтаройОсновнойФормы()

	ПровереноОкон = 0;
	Попытка
		Для Каждого ТекОкно Из ПолучитьОкна() Цикл
			// Главное окно и рабочий стол могут не содержать форм.
			КоличествоФорм = Неопределено;
			Попытка
				КоличествоФорм = ТекОкно.Содержимое.Количество();
			Исключение
			КонецПопытки;
			Если КоличествоФорм = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ПровереноОкон = ПровереноОкон + 1;
			Если КоличествоФорм = 0 Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого ТекФорма Из ТекОкно.Содержимое Цикл
				ТекИмяФормы = "";
				Попытка
					ТекИмяФормы = ТекФорма.ИмяФормы;
				Исключение
				КонецПопытки;
				Если Прав(ТекИмяФормы, СтрДлина(".УправляемаяФорма")) = ".УправляемаяФорма" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Если ОшибкаПроверкиОконЗаписана <> Истина Тогда
			ОшибкаПроверкиОконЗаписана = Истина;
			Попытка
				ЗаписатьШаг("Не удалось проверить окна: " + ОписаниеОшибки());
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;

	Если ПровереноОкон = 0 Тогда
		// Ни одно окно прочитать не удалось - проверке доверять нельзя.
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ПрочитатьПутьИзФайлаПараметров()

	КаталогВременных = КаталогВременныхФайлов();
	Если Прав(КаталогВременных, 1) <> "\" И Прав(КаталогВременных, 1) <> "/" Тогда
		КаталогВременных = КаталогВременных + "\";
	КонецЕсли;
	ПутьФайлаПараметров = КаталогВременных + "va-restart-params.txt";

	Попытка
		ЧтениеПараметров = Новый ЧтениеТекста;
		ЧтениеПараметров.Открыть(ПутьФайлаПараметров, "UTF-8");
		ПутьКОбработке = ЧтениеПараметров.ПрочитатьСтроку();
		ЧтениеПараметров.Закрыть();
		УдалитьФайлы(ПутьФайлаПараметров);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьШаг(Текст)

	ЗаписатьСобытие("VAExtension.ПерезапускVA.Шаг", Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьСобытие(ИмяСобытия, Текст)

	Попытка
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , , Текст);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодключитьVA(Путь)

	Попытка
		ПутьДляВычисления = СтрЗаменить(Путь, """", """""");
		Команда = "ВнешниеОбработки.Создать(""" + ПутьДляВычисления + """, Ложь)";
		Обработка = Вычислить(Команда);
		Возврат Обработка.Метаданные().Имя;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции
