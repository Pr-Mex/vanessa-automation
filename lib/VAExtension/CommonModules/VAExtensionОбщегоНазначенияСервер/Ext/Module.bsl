#Область ПрограммныйИнтерфейс

Функция ДанныеОбъектаСервер(ТекОбъект, ПараметрыОтбора = Неопределено) Экспорт
	
	Попытка
		СсылкаОбъекта = ТекОбъект.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ТипОбъекта = ТипЗнч(СсылкаОбъекта);
	ОМ = Метаданные.НайтиПоТипу(ТипОбъекта);
	
	Результат = Новый Структура;	
	Результат.Вставить("СтандартныеРеквизиты", ПолучитьЗначенияРеквизитовОбъекта(ОМ.СтандартныеРеквизиты, ТекОбъект));
	Результат.Вставить("РеквизитыШапки", ПолучитьЗначенияРеквизитовОбъекта(ОМ.Реквизиты, ТекОбъект));
	
	ИмяТабличнойЧасти = "";
	БезТабличныхЧастей = Ложь;
	Если ПараметрыОтбора <> Неопределено И ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда
		Если ПараметрыОтбора.Свойство("ИмяТабличнойЧасти") Тогда
			ИмяТабличнойЧасти = СокрЛП(Строка(ПараметрыОтбора.ИмяТабличнойЧасти));
		КонецЕсли;
		Если ПараметрыОтбора.Свойство("БезТабличныхЧастей") Тогда
			БезТабличныхЧастей = ПараметрыОтбора.БезТабличныхЧастей = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ТабличныеЧасти = Новый Массив;
	Результат.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	Если НЕ БезТабличныхЧастей Тогда
		Для Каждого ТекТабличнаяЧасть Из ОМ.ТабличныеЧасти Цикл
			Если ЗначениеЗаполнено(ИмяТабличнойЧасти)
					И НРег(СокрЛП(ТекТабличнаяЧасть.Имя)) <> НРег(ИмяТабличнойЧасти) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеТаблицы = ПолучитьЗначениеТаблицыЗначений(
				ОМ.ТабличныеЧасти[ТекТабличнаяЧасть.Имя],
				ТекОбъект[ТекТабличнаяЧасть.Имя],
				ПараметрыОтбора);
			
			ДанныеТабличнойЧасти = Новый Структура;
			ДанныеТабличнойЧасти.Вставить("Имя", ТекТабличнаяЧасть.Имя);
			ДанныеТабличнойЧасти.Вставить("ЗначениеТаблицы", ДанныеТаблицы.ЗначениеТаблицы);
			ДанныеТабличнойЧасти.Вставить("ВсегоСтрок", ДанныеТаблицы.ВсегоСтрок);
			ДанныеТабличнойЧасти.Вставить("НомераСтрок", ДанныеТаблицы.НомераСтрок);
			ДанныеТабличнойЧасти.Вставить("ОтборСтрокЗадан", ДанныеТаблицы.ОтборСтрокЗадан);
			ДанныеТабличнойЧасти.Вставить("ЗапрошенныеСтроки", ДанныеТаблицы.ЗапрошенныеСтроки);
			ТабличныеЧасти.Добавить(ДанныеТабличнойЧасти);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьЗначенияРеквизитовОбъекта(РеквизитыОМ, ТекОбъект)
	
	Результат = Новый Массив;
	Для Каждого Элем Из РеквизитыОМ Цикл
		Попытка
			Значение = ТекОбъект[Элем.Имя];
		Исключение
			Продолжить;
		КонецПопытки;
		
		ДанныеРеквизита = Новый Структура;
		ДанныеРеквизита.Вставить("Имя", Элем.Имя);
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			ЗначениеСтрокой = XMLСтрока(Значение);
			ДанныеРеквизита.Вставить("Значение", ЗначениеСтрокой);
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
			ДанныеРеквизита.Вставить("Значение", Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			ДанныеРеквизита.Вставить("Значение", Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
			ДанныеРеквизита.Вставить("Значение", Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Неопределено") Тогда
			ДанныеРеквизита.Вставить("Значение", Значение);
		Иначе
			// Ссылочые типы преобразовываем к строке
			ДанныеРеквизита.Вставить("Значение", Строка(Значение));
		КонецЕсли;	
		ДанныеРеквизита.Вставить("Тип", СтроковоеПредставлениеТипа(ТипЗнч(Значение)));
		
		Результат.Добавить(ДанныеРеквизита);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

&НаСервере
Функция ПолучитьЗначениеТаблицыЗначений(ОМТабличнаяЧасть, ОбъектТабличнаяЧасть, ПараметрыОтбора = Неопределено)
	
	ЗначениеТаблицы = Новый Массив;
	НомераСтрок = Новый Массив;
	ВсегоСтрок = ОбъектТабличнаяЧасть.Количество();
	Отбор = ПодготовитьОтборСтрок(ПараметрыОтбора);
	
	НомерСтроки = 0;
	Для Каждого СтрокаОбъектТабличнаяЧасть Из ОбъектТабличнаяЧасть Цикл
		НомерСтроки = НомерСтроки + 1;
		Если Отбор.Задан И НЕ СтрокаПопадаетВОтбор(НомерСтроки, Отбор) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСтрокиТЧ = ПолучитьЗначенияРеквизитовОбъекта(ОМТабличнаяЧасть.Реквизиты, СтрокаОбъектТабличнаяЧасть);
		СтандартныеРеквизиты = ПолучитьЗначенияРеквизитовОбъекта(ОМТабличнаяЧасть.СтандартныеРеквизиты, СтрокаОбъектТабличнаяЧасть);
		Для Каждого ТекСтандартныйРеквизит Из СтандартныеРеквизиты Цикл
			ДанныеСтрокиТЧ.Добавить(ТекСтандартныйРеквизит);
		КонецЦикла;
		ЗначениеТаблицы.Добавить(ДанныеСтрокиТЧ);
		Если Отбор.Задан Тогда
			НомераСтрок.Добавить(НомерСтроки);
		КонецЕсли;
	КонецЦикла;	
	
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеТаблицы", ЗначениеТаблицы);
	Результат.Вставить("ВсегоСтрок", ВсегоСтрок);
	Результат.Вставить("НомераСтрок", НомераСтрок);
	Результат.Вставить("ОтборСтрокЗадан", Отбор.Задан);
	Результат.Вставить("ЗапрошенныеСтроки", Отбор.ЗапрошенныеСтроки);
	Возврат Результат;
КонецФункции

// Разбирает нормализованные MCP строки отбора. Диапазоны хранятся интервалами:
// запрос вида "1-1000000" не превращается в массив номеров.
&НаСервере
Функция ПодготовитьОтборСтрок(ПараметрыОтбора)
	
	Результат = Новый Структура;
	Результат.Вставить("Задан", Ложь);
	Результат.Вставить("Номера", Новый Массив);
	Результат.Вставить("Интервалы", Новый Массив);
	Результат.Вставить("ЗапрошенныеСтроки", "");
	
	Если ПараметрыОтбора = Неопределено ИЛИ ТипЗнч(ПараметрыОтбора) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	НомераТекст = "";
	Если ПараметрыОтбора.Свойство("НомераСтрок") Тогда
		НомераТекст = СокрЛП(Строка(ПараметрыОтбора.НомераСтрок));
	КонецЕсли;
	ДиапазоныТекст = "";
	Если ПараметрыОтбора.Свойство("ДиапазоныСтрок") Тогда
		ДиапазоныТекст = СокрЛП(Строка(ПараметрыОтбора.ДиапазоныСтрок));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НомераТекст) И НЕ ЗначениеЗаполнено(ДиапазоныТекст) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Часть Из СтрРазделить(НомераТекст, ",", Истина) Цикл
		Часть = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(Часть) Тогда
			Продолжить;
		КонецЕсли;
		Номер = Число(Часть);
		Если Номер > 0 И Результат.Номера.Найти(Номер) = Неопределено Тогда
			Результат.Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Часть Из СтрРазделить(ДиапазоныТекст, ",", Истина) Цикл
		Часть = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(Часть) Тогда
			Продолжить;
		КонецЕсли;
		ПозицияДефиса = СтрНайти(Часть, "-");
		Если ПозицияДефиса = 0 Тогда
			Начало = Число(Часть);
			Конец = Начало;
		Иначе
			Начало = Число(СокрЛП(Лев(Часть, ПозицияДефиса - 1)));
			Конец = Число(СокрЛП(Сред(Часть, ПозицияДефиса + 1)));
		КонецЕсли;
		Если Начало > 0 И Конец >= Начало Тогда
			Результат.Интервалы.Добавить(Новый Структура("Начало, Конец", Начало, Конец));
		КонецЕсли;
	КонецЦикла;
	
	ОбъединитьИнтервалы(Результат.Интервалы);
	Результат.Задан = Результат.Номера.Количество() > 0 ИЛИ Результат.Интервалы.Количество() > 0;
	Если Результат.Задан Тогда
		Части = Новый Массив;
		Если ЗначениеЗаполнено(НомераТекст) Тогда
			Части.Добавить(НомераТекст);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДиапазоныТекст) Тогда
			Части.Добавить(ДиапазоныТекст);
		КонецЕсли;
		Результат.ЗапрошенныеСтроки = СтрСоединить(Части, ",");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбъединитьИнтервалы(Интервалы)
	
	Если Интервалы.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	// Сортировка вставками: интервалов немного (MCP ограничивает количество).
	Для Инд = 1 По Интервалы.Количество() - 1 Цикл
		Текущий = Интервалы[Инд];
		Позиция = Инд - 1;
		Пока Позиция >= 0 Цикл
			Если Интервалы[Позиция].Начало <= Текущий.Начало Тогда
				Прервать;
			КонецЕсли;
			Интервалы[Позиция + 1] = Интервалы[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Интервалы[Позиция + 1] = Текущий;
	КонецЦикла;
	
	Объединённые = Новый Массив;
	Для Каждого Интервал Из Интервалы Цикл
		Если Объединённые.Количество() = 0 Тогда
			Объединённые.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Интервал.Конец));
			Продолжить;
		КонецЕсли;
		Последний = Объединённые[Объединённые.Количество() - 1];
		Если Интервал.Начало <= Последний.Конец + 1 Тогда
			Если Интервал.Конец > Последний.Конец Тогда
				Последний.Конец = Интервал.Конец;
			КонецЕсли;
		Иначе
			Объединённые.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Интервал.Конец));
		КонецЕсли;
	КонецЦикла;
	
	Интервалы.Очистить();
	Для Каждого Интервал Из Объединённые Цикл
		Интервалы.Добавить(Интервал);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СтрокаПопадаетВОтбор(Номер, Отбор)
	
	Если Отбор.Номера.Найти(Номер) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Интервал Из Отбор.Интервалы Цикл
		Если Номер >= Интервал.Начало И Номер <= Интервал.Конец Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция СтроковоеПредставлениеТипа(Тип) Экспорт
	
	Представление = "";
	
	Если ЭтоСсылка(Тип) Тогда
	
		ПолноеИмя = Метаданные.НайтиПоТипу(Тип).ПолноеИмя();
		ИмяОбъекта = СтрРазделить(ПолноеИмя, ".")[1];
		
		Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "СправочникСсылка";
		
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ДокументСсылка";
		
		ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "БизнесПроцессСсылка";
		
		ИначеЕсли БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().СодержитТип(Тип) Тогда
			Представление = "ТочкаМаршрутаБизнесПроцессаСсылка";
		
		ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ПланВидовХарактеристикСсылка";
		
		ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ПланСчетовСсылка";
		
		ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ПланВидовРасчетаСсылка";
		
		ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ЗадачаСсылка";
		
		ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ПланОбменаСсылка";
		
		ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда
			Представление = "ПеречислениеСсылка";
		
		КонецЕсли;
		
		Результат = ?(Представление = "", Представление, Представление + "." + ИмяОбъекта);
		
	ИначеЕсли Тип = Тип("Неопределено") Тогда
		Результат = "Неопределено";
		
	ИначеЕсли Тип = Тип("Строка") Тогда
		Результат = "Строка";

	ИначеЕсли Тип = Тип("Число") Тогда
		Результат = "Число";

	ИначеЕсли Тип = Тип("Булево") Тогда
		Результат = "Булево";

	ИначеЕсли Тип = Тип("Дата") Тогда
		Результат = "Дата";
	
	Иначе
		
		Результат = Строка(Тип);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭтоСсылка(ПроверяемыйТип) Экспорт
	
	Возврат ПроверяемыйТип <> Тип("Неопределено") И ОписаниеТипаВсеСсылки().СодержитТип(ПроверяемыйТип);
	
КонецФункции

&НаСервере
Функция ОписаниеТипаВсеСсылки() Экспорт
	
	Возврат Новый ОписаниеТипов(Новый ОписаниеТипов(Новый ОписаниеТипов(Новый ОписаниеТипов(Новый ОписаниеТипов(
		Новый ОписаниеТипов(Новый ОписаниеТипов(Новый ОписаниеТипов(Новый ОписаниеТипов(
			Справочники.ТипВсеСсылки(),
			Документы.ТипВсеСсылки().Типы()),
			ПланыОбмена.ТипВсеСсылки().Типы()),
			Перечисления.ТипВсеСсылки().Типы()),
			ПланыВидовХарактеристик.ТипВсеСсылки().Типы()),
			ПланыСчетов.ТипВсеСсылки().Типы()),
			ПланыВидовРасчета.ТипВсеСсылки().Типы()),
			БизнесПроцессы.ТипВсеСсылки().Типы()),
			БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().Типы()),
			Задачи.ТипВсеСсылки().Типы());
	
КонецФункции

#КонецОбласти