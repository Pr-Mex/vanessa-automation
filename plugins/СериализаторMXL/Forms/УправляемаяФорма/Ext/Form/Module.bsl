&НаКлиенте
Процедура ТаблицаДанныхСсылкаПриИзменении(Элемент)
	ТаблицаДанныхСсылкаПриИзмененииСервер(Элементы.ТаблицаДанных.ТекущаяСтрока);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура СоздатьМакетДанных(Команда)
	
	ПанельИсточников = Элементы.ГруппаСтраницы;
	Если ПанельИсточников.ТекущаяСтраница = ПанельИсточников.ПодчиненныеЭлементы.ГруппаМетаданные Тогда
		ПоказатьСводкуВыгрузкиПоМетаданным();
	Иначе
		СоздатьМакетДанныхПоТекущейСтранице();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМакетДанныхПоТекущейСтранице()
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПанельИсточников = Элементы.ГруппаСтраницы;
	Если ПанельИсточников.ТекущаяСтраница = ПанельИсточников.ПодчиненныеЭлементы.ГруппаМетаданные Тогда
		КоманднаяПанель1СоздатьМакетДанныхПоМетаданным();
	ИначеЕсли ПанельИсточников.ТекущаяСтраница = ПанельИсточников.ПодчиненныеЭлементы.ГруппаТаблицаДанных Тогда
		КоманднаяПанель1СоздатьМакетДанныхПоТаблицеДанных();
	ИначеЕсли ПанельИсточников.ТекущаяСтраница = ПанельИсточников.ПодчиненныеЭлементы.ГруппаПользователиИБ Тогда
		КоманднаяПанель1СоздатьМакетДанныхДляПользователейИБ();
	КонецЕсли;
	
	СообщитьДлительностьВыполнения(НачалоЗамера);
	
КонецПроцедуры

// Перед созданием макета по метаданным показывает, сколько объектов и записей попадет в макет,
// чтобы можно было отказаться от долгой выгрузки, например, при ошибке в отборе
&НаКлиенте
Процедура ПоказатьСводкуВыгрузкиПоМетаданным()
	
	ИтогиВыгрузки = ИтогиВыгрузкиПоДеревуМетаданных(Объект.ДеревоМетаданных, Объект.УровеньВыгрузки);
	Если ИтогиВыгрузки.Выбранные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не отмечены объекты метаданных для выгрузки';en='No metadata objects are marked for upload'"));
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru='Выполняется подсчет количества выгружаемых записей...';en='Counting the records to upload...'"));
	ИтогиВыгрузки = ИтогиВыгрузкиСКоличествомЗаписей(ИтогиВыгрузки);
	ИтогВыгрузки = ТекстИтогаВыгрузки(ИтогиВыгрузки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьСводкуВыгрузкиПоМетаданнымЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстСводкиВыгрузки(ИтогиВыгрузки), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСводкуВыгрузкиПоМетаданнымЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СоздатьМакетДанныхПоТекущейСтранице();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстСводкиВыгрузки(ИтогиВыгрузки)
	
	МаксимумОбъектовВСводке = 30;
	
	СписокОбъектов = Новый СписокЗначений;
	Для Каждого ОписаниеОбъекта Из ИтогиВыгрузки.Выбранные Цикл
		Если ОписаниеОбъекта.КоличествоЗаписей = Неопределено Тогда
			СписокОбъектов.Добавить(-1, ОписаниеОбъекта.ПолноеИмя + " - "
				+ НСтр("ru='не удалось подсчитать:';en='failed to count:'") + " " + ОписаниеОбъекта.ОшибкаПодсчета);
		Иначе
			СписокОбъектов.Добавить(ОписаниеОбъекта.КоличествоЗаписей,
				ОписаниеОбъекта.ПолноеИмя + " - " + Формат(ОписаниеОбъекта.КоличествоЗаписей, "ЧН=0; ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	СписокОбъектов.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	
	ТекстСводки = НСтр("ru='Сводка выгрузки в макет:';en='Upload summary:'") + Символы.ПС + ТекстИтогаВыгрузки(ИтогиВыгрузки) + Символы.ПС;
	Для Каждого ЭлементСписка Из СписокОбъектов Цикл
		Если СписокОбъектов.Индекс(ЭлементСписка) = МаксимумОбъектовВСводке Тогда
			ТекстСводки = ТекстСводки + Символы.ПС + СтрЗаменить(НСтр("ru='... и еще объектов: %1';en='... and more objects: %1'"),
				"%1", Формат(СписокОбъектов.Количество() - МаксимумОбъектовВСводке, "ЧГ=0"));
			Прервать;
		КонецЕсли;
		ТекстСводки = ТекстСводки + Символы.ПС + ЭлементСписка.Представление;
	КонецЦикла;
	
	Возврат ТекстСводки + Символы.ПС + Символы.ПС + НСтр("ru='Создать макет данных?';en='Create the data layout?'");
	
КонецФункции

&НаКлиенте
Процедура СообщитьДлительностьВыполнения(НачалоЗамера)
	
	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера) / 1000;
	ТекстСообщения = НСтр("ru='Длительность выполнения: %1 сек.';en='Execution time: %1 sec.'");
	Сообщить(СтрЗаменить(ТекстСообщения, "%1", Формат(Длительность, "ЧДЦ=3; ЧН=0")));
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанель1СоздатьМакетДанныхПоТаблицеДанных()
	Если ПроверитьЗаполнение() Тогда
		НовыйМакет = СоздатьМакетДанныхПоТаблицеДанныхСервер();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанель1СоздатьМакетДанныхПоМетаданным()
	
	СохранитьОтображениеДерева(Объект.ДеревоМетаданных.ПолучитьЭлементы());
	НовыйМакет = СоздатьМакетДанныхПоМетаданнымСервер();
	ВосстановитьОтображениеДерева(Объект.ДеревоМетаданных.ПолучитьЭлементы());
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанель1СоздатьМакетДанныхДляПользователейИБ()
	
	МассивИменПользователей = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.ПользователиИнфБазы.ВыделенныеСтроки Цикл
		Строка = Объект.ПользователиИБ.НайтиПоИдентификатору(ИдентификаторСтроки);
		МассивИменПользователей.Добавить(Строка.Имя);
	КонецЦикла;
	НовыйМакет = СоздатьМакетДанныхПоПользователямИБСервер(МассивИменПользователей);
	
КонецПроцедуры

&НаКлиенте
Процедура ПротестироватьЗагрузкуМакета(Команда)
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	МакетДляЗаполнения = ПолучитьМакетЗаполнения();
	
	ПроверитьЗагрузкуМакетаСервер(МакетДляЗаполнения);
	
	СообщитьДлительностьВыполнения(НачалоЗамера);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеМакетаВБазу(Команда)
	
	ТекстВопроса = НСтр("ru='Данные макета будут записаны в базу. Продолжить?';en='The layout data will be written to the database. Continue?'");
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьДанныеМакетаВБазуЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеМакетаВБазуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗагрузитьДанныеМакетаВБазуСервер();
	
	СообщитьДлительностьВыполнения(НачалоЗамера);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДанныеПоМакету(Команда)
	ВыбратьТипыДанныхДляУдаленияПоМакету(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДанныеПоМакетуКаскадно(Команда)
	ВыбратьТипыДанныхДляУдаленияПоМакету(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьТипыДанныхДляУдаленияПоМакету(Каскадно)
	
	СписокТипов = СоставТиповДанныхМакетаСервер(Истина);
	Если СписокТипов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='В макете нет объектов ссылочных типов';en='There are no objects of reference types in the layout'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьТипыДанныхДляУдаленияПоМакетуЗавершение", ЭтотОбъект, Каскадно);
	СписокТипов.ПоказатьОтметкуЭлементов(ОписаниеОповещения, НСтр("ru='Отметьте типы данных для удаления из базы';en='Check the data types to delete from the database'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьТипыДанныхДляУдаленияПоМакетуЗавершение(СписокТипов, Каскадно) Экспорт
	
	ТипыДанных = ОтмеченныеТипыДанных(СписокТипов);
	Если ТипыДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоставУдаления = ОбъектыДляУдаленияПоМакетуСервер(ТипыДанных, Каскадно);
	Если СоставУдаления.Ссылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Объекты макета отмеченных типов в базе не найдены';en='Objects of the checked types from the layout were not found in the database'"));
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрЗаменить(НСтр("ru='Из базы будут удалены объекты (%1):';en='Objects will be deleted from the database (%1):'"), 
		"%1", Формат(СоставУдаления.Ссылки.Количество(), "ЧГ=0"))
		+ ТекстСписка(СоставУдаления.КоличествоПоТипам) + Символы.ПС + Символы.ПС
		+ НСтр("ru='Восстановление будет невозможно. Продолжить?';en='This cannot be undone. Continue?'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьДанныеПоМакетуЗавершение", ЭтотОбъект, СоставУдаления.Ссылки);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДанныеПоМакетуЗавершение(РезультатВопроса, Ссылки) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	УдалитьОбъектыПоСсылкамСервер(Ссылки);
	
	СообщитьДлительностьВыполнения(НачалоЗамера);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьТипыИзМакета(Команда)
	
	СписокТипов = СоставТиповДанныхМакетаСервер(Ложь);
	Если СписокТипов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='В макете нет объектов';en='There are no objects in the layout'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИсключитьТипыИзМакетаПослеОтметки", ЭтотОбъект);
	СписокТипов.ПоказатьОтметкуЭлементов(ОписаниеОповещения, НСтр("ru='Отметьте типы данных, которые нужно исключить из макета';en='Check the data types to exclude from the layout'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьТипыИзМакетаПослеОтметки(СписокТипов, ДополнительныеПараметры) Экспорт
	
	ТипыДанных = ОтмеченныеТипыДанных(СписокТипов);
	Если ТипыДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Из макета будут исключены объекты отмеченных типов:';en='Objects of the checked types will be excluded from the layout:'")
		+ ТекстСписка(ТипыДанных) + Символы.ПС + Символы.ПС
		+ НСтр("ru='База данных не изменится. Продолжить?';en='The database will not be changed. Continue?'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИсключитьТипыИзМакетаЗавершение", ЭтотОбъект, ТипыДанных);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьТипыИзМакетаЗавершение(РезультатВопроса, ТипыДанных) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ИсключитьТипыИзМакетаСервер(ТипыДанных);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает значения отмеченных элементов списка типов данных или Неопределено, если выбор отменен
&НаКлиенте
Функция ОтмеченныеТипыДанных(СписокТипов)
	
	Если ТипЗнч(СписокТипов) <> Тип("СписокЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипыДанных = Новый Массив;
	Для Каждого ЭлементСписка Из СписокТипов Цикл
		Если ЭлементСписка.Пометка Тогда
			ТипыДанных.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если ТипыДанных.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не отмечен ни один тип данных';en='No data type is checked'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТипыДанных;
	
КонецФункции

// Возвращает значения массива, каждое с новой строки
&НаКлиенте
Функция ТекстСписка(Значения)
	
	Текст = "";
	Для Каждого Значение Из Значения Цикл
		Текст = Текст + Символы.ПС + Значение;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Процедура СохранитьМакетДанныхВФайл(Команда)
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.ПолноеИмяФайла = "";
	ДиалогВыбораФайла.Фильтр = "Табличный документ (*.mxl)|*.mxl|Все файлы (*.*)|*.*";
	ДиалогВыбораФайла.Заголовок = "Выберите файл";
	Если Не ДиалогВыбораФайла.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Макет.Записать(ДиалогВыбораФайла.ПолноеИмяФайла);
КонецПроцедуры

