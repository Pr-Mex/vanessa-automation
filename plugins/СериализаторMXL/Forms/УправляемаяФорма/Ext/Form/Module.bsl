КонецФункции

&НаСервере
Функция ОбъектыДляУдаленияПоМакетуСервер(ТипыДанных, Каскадно)
	
	Ссылки = Объект().ОбъектыДляУдаленияПоМакету(ПолучитьМакетЗаполнения(), ТипыДанных, Каскадно);
	
	ТипыОбъектов = Новый СписокЗначений;
	КоличествоОбъектовПоТипам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		ИмяТипа = Ссылка.Метаданные().ПолноеИмя();
		КоличествоОбъектов = КоличествоОбъектовПоТипам[ИмяТипа];
		Если КоличествоОбъектов = Неопределено Тогда
			ТипыОбъектов.Добавить(ИмяТипа);
			КоличествоОбъектов = 0;
		КонецЕсли;
		КоличествоОбъектовПоТипам.Вставить(ИмяТипа, КоличествоОбъектов + 1);
	КонецЦикла;
	ТипыОбъектов.СортироватьПоЗначению();
	
	КоличествоПоТипам = Новый Массив;
	Для Каждого ЭлементСписка Из ТипыОбъектов Цикл
		КоличествоПоТипам.Добавить(ЭлементСписка.Значение + " - " + Формат(КоличествоОбъектовПоТипам[ЭлементСписка.Значение], "ЧГ=0"));
	КонецЦикла;
	
	Возврат Новый Структура("Ссылки, КоличествоПоТипам", Ссылки, КоличествоПоТипам);
	
КонецФункции

