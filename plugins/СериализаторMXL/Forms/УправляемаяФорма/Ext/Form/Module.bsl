&НаСервере
Функция ИтогиВыгрузкиСКоличествомЗаписей(Знач ИтогиВыгрузки)
	
	ОбъектНаСервере = Объект();
	ИтогиВыгрузки.КоличествоЗаписей = 0;
	Для Каждого ОписаниеОбъекта Из ИтогиВыгрузки.Выбранные Цикл
		СтрокаДерева = Объект.ДеревоМетаданных.НайтиПоИдентификатору(ОписаниеОбъекта.Идентификатор);
		Попытка
			ОписаниеОбъекта.КоличествоЗаписей = ОбъектНаСервере.КоличествоЗаписейКВыгрузке(СтрокаДерева);
		Исключение
			// ошибка подсчета выводится в сводке и не мешает создать макет
			ОписаниеОбъекта.КоличествоЗаписей = Неопределено;
			ОписаниеОбъекта.ОшибкаПодсчета = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		ИтогиВыгрузки.КоличествоЗаписей = ИтогиВыгрузки.КоличествоЗаписей + ОписаниеОбъекта.КоличествоЗаписей;
	КонецЦикла;
	
	Возврат ИтогиВыгрузки;
	
КонецФункции

