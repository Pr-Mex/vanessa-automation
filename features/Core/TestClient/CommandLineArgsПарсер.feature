Функционал: Разбор командной строки процесса TestClient по CommandLineArgs
	Как разработчик Vanessa Automation
	Я хочу разбирать /N, /F, /S и /IBConnectionString по элементам argv
	Чтобы логин с пробелом и слитный /F не давали ложное «чужой клиент»

# Проверки не требуют клиента тестирования: функции разбора вызываются
# напрямую у формы Vanessa Automation. Синтетические argv повторяют
# Linux-форму из инцидента 00-00972719 и Windows-форму из живой пробы.

Сценарий: Логин из argv во всех формах /N
	И я выполняю код встроенного языка
	"""bsl
	// /N слитно с логином, логин содержит пробел.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/NАдминистратор (СоколовМИ)");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> "Администратор (СоколовМИ)" Тогда
		ВызватьИсключение "Слитный /N: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// /N отдельным аргументом.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/N");
	Аргументы.Добавить("Администратор (СоколовМИ)");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> "Администратор (СоколовМИ)" Тогда
		ВызватьИсключение "/N отдельно: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// /N=Логин.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/N=Администратор (СоколовМИ)");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> "Администратор (СоколовМИ)" Тогда
		ВызватьИсключение "/N=: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// Пустой /N не должен брать следующий параметр как логин.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/N");
	Аргументы.Добавить("/TESTCLIENT");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "Пустой /N: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// /NoWait — самостоятельный параметр, а не логин oWait.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/NoWait");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "/NoWait: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// Несколько разных /N неоднозначны.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/NПервый");
	Аргументы.Добавить("/NВторой");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "Разные /N: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// Кавычки вокруг значения, если компонента их не сняла.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/N""Vanessa Пробел""");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> "Vanessa Пробел" Тогда
		ВызватьИсключение "Кавычки /N: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// argv[0] — путь к исполняемому файлу, а не параметр /N.
	Аргументы = Новый Массив;
	Аргументы.Добавить("/nfs/1cv8/1cv8c");
	Аргументы.Добавить("/TESTCLIENT");
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "argv[0] /nfs: получено <" + Строка(Логин) + ">";
	КонецЕсли;
	"""

Сценарий: Параметр базы из argv
	И я выполняю код встроенного языка
	"""bsl
	// Linux-форма: /F слитно с абсолютным путём.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/F/builds/erp/erp2/bin/database");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""/builds/erp/erp2/bin/database""" Тогда
		ВызватьИсключение "Слитный /F: получено <" + База + ">";
	КонецЕсли;

	// /F отдельным аргументом, путь тоже начинается с /.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/F");
	Аргументы.Добавить("/builds/erp/erp2/bin/database");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""/builds/erp/erp2/bin/database""" Тогда
		ВызватьИсключение "/F отдельно: получено <" + База + ">";
	КонецЕсли;

	// Windows-форма из живой пробы: /Fc:\Bases\8.3.27.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/Fc:\Bases\8.3.27");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""c:\Bases\8.3.27""" Тогда
		ВызватьИсключение "Windows /F: получено <" + База + ">";
	КонецЕсли;

	// Серверная база.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/Sserver\base");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/S""server\base""" Тогда
		ВызватьИсключение "Слитный /S: получено <" + База + ">";
	КонецЕсли;

	// Сервер, имя которого начинается на save, — это /S, а не /SaveDataCompositionSettings.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/Ssave\base");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/S""save\base""" Тогда
		ВызватьИсключение "/Ssave: получено <" + База + ">";
	КонецЕсли;

	// /SDC не должен стать базой /S.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/SDC");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "" Тогда
		ВызватьИсключение "/SDC: получено <" + База + ">";
	КонецЕсли;

	// /SaveDataCompositionSettings не должен стать базой /S.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/SaveDataCompositionSettingsC:\settings.xml");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "" Тогда
		ВызватьИсключение "/SaveDataCompositionSettings: получено <" + База + ">";
	КонецЕсли;

	// Web-база.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/WShttp://server/base");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/WS""http://server/base""" Тогда
		ВызватьИсключение "/WS: получено <" + База + ">";
	КонецЕсли;

	// /WSP — другой параметр, а не web-база /WS.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/WSPsecret");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "" Тогда
		ВызватьИсключение "/WSP: получено <" + База + ">";
	КонецЕсли;

	// /SLev — другой параметр, а не серверная база /S.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/SLev");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "" Тогда
		ВызватьИсключение "/SLev: получено <" + База + ">";
	КонецЕсли;

	// После неподходящего /WSP реальная серверная база всё равно находится.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/WSPsecret");
	Аргументы.Добавить("/Sserver\base");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/S""server\base""" Тогда
		ВызватьИсключение "Поиск после /WSP: получено <" + База + ">";
	КонецЕсли;

	// argv[0] — путь к исполняемому файлу, а не параметр /S.
	Аргументы = Новый Массив;
	Аргументы.Добавить("/srv/1cv8/1cv8c");
	Аргументы.Добавить("/TESTCLIENT");
	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "" Тогда
		ВызватьИсключение "argv[0] /srv: получено <" + База + ">";
	КонецЕсли;
	"""

Сценарий: Склеенный /N внутри значения File не ломает сравнение базы
	И я выполняю код встроенного языка
	"""bsl
	// /N попал внутрь кавычек значения File (наблюдалось в ЖР v83ServiceBase8327).
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/IBConnectionString");
	Аргументы.Добавить("File=""C:\Bases\8.3.27; /N""");

	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""C:\Bases\8.3.27""" Тогда
		ВызватьИсключение "Склеенный /N: получено <" + База + ">";
	КонецЕсли;

	// Логин из такой формы не извлекается — сравнение логина не должно блокировать.
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "Склеенный /N, логин: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// /N с пустым аргументом — легальный запуск без пользователя.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/IBConnectionString");
	Аргументы.Добавить("File=""C:\Bases\8.3.27; /N""");
	Аргументы.Добавить("/N");
	Аргументы.Добавить("");

	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""C:\Bases\8.3.27""" Тогда
		ВызватьИсключение "Пустой /N отдельным аргументом, база: получено <" + База + ">";
	КонецЕсли;
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "Пустой /N отдельным аргументом, логин: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// /N"" — пустое имя пользователя в кавычках.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/IBConnectionString");
	Аргументы.Добавить("File=""C:\Bases\8.3.27; /N""");
	Аргументы.Добавить("/N""""");

	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""C:\Bases\8.3.27""" Тогда
		ВызватьИсключение "Пустое /N в кавычках, база: получено <" + База + ">";
	КонецЕсли;
	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> Неопределено Тогда
		ВызватьИсключение "Пустое /N в кавычках, логин: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// Слитная форма без пробела после разделителя.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/IBConnectionString");
	Аргументы.Добавить("File=""C:\Bases\8.3.27;/N""");

	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""C:\Bases\8.3.27""" Тогда
		ВызватьИсключение "Склеенный /N без пробела: получено <" + База + ">";
	КонецЕсли;

	// Серверная база: хвост /N в Ref.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/IBConnectionString");
	Аргументы.Добавить("Srvr=""srv"";Ref=""base; /N""");

	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/S""srv\base""" Тогда
		ВызватьИсключение "Склеенный /N в Ref: получено <" + База + ">";
	КонецЕсли;
	"""

Сценарий: База и логин из строки соединения
	И я выполняю код встроенного языка
	"""bsl
	СтрокаСоединения = "File=""c:\base"";Usr=""Администратор (СоколовМИ)"";";
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/IBConnectionString");
	Аргументы.Добавить(СтрокаСоединения);

	База = Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы);
	Если База <> "/F""c:\base""" Тогда
		ВызватьИсключение "IBConnectionString/база: получено <" + База + ">";
	КонецЕсли;

	Логин = Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы);
	Если Логин <> "Администратор (СоколовМИ)" Тогда
		ВызватьИсключение "IBConnectionString/Usr: получено <" + Строка(Логин) + ">";
	КонецЕсли;
	"""

Сценарий: Пустой argv и fallback на CommandLine
	И я выполняю код встроенного языка
	"""bsl
	// Пустой массив трактуется как отсутствие argv.
	Аргументы = Новый Массив;
	Если Ванесса.ЛогинИзАргументовКоманднойСтроки(Аргументы) <> Неопределено Тогда
		ВызватьИсключение "Пустой массив: логин должен быть Неопределено";
	КонецЕсли;
	Если Ванесса.ПараметрБазыИзАргументовКоманднойСтроки(Аргументы) <> "" Тогда
		ВызватьИсключение "Пустой массив: база должна быть пустой";
	КонецЕсли;

	// Нет CommandLineArgs — работает старый разбор CommandLine.
	Данные = Новый Структура;
	Данные.Вставить("CommandLine", """C:\1cv8c.exe"" ENTERPRISE /F""C:\Bases\Base"" /N""Администратор (СоколовМИ)""");
	База = Ванесса.ПараметрБазыИзДанныхПроцесса(Данные);
	Если База <> "/F""C:\Bases\Base""" Тогда
		ВызватьИсключение "Fallback/база: получено <" + База + ">";
	КонецЕсли;
	Логин = Ванесса.ЛогинИзДанныхПроцесса(Данные);
	Если Логин <> "Администратор (СоколовМИ)" Тогда
		ВызватьИсключение "Fallback/логин: получено <" + Строка(Логин) + ">";
	КонецЕсли;

	// CommandLineArgs есть — CommandLine не используется, даже если в нём есть параметры.
	Аргументы = Новый Массив;
	Аргументы.Добавить("1cv8c");
	Аргументы.Добавить("/TESTCLIENT");
	Данные = Новый Структура;
	Данные.Вставить("CommandLineArgs", Аргументы);
	Данные.Вставить("CommandLine", """C:\1cv8c.exe"" ENTERPRISE /F""C:\Bases\Base"" /N""Администратор""");
	Если Ванесса.ПараметрБазыИзДанныхПроцесса(Данные) <> "" Тогда
		ВызватьИсключение "Приоритет argv: база не должна разбираться из CommandLine";
	КонецЕсли;
	Если Ванесса.ЛогинИзДанныхПроцесса(Данные) <> Неопределено Тогда
		ВызватьИсключение "Приоритет argv: логин не должен разбираться из CommandLine";
	КонецЕсли;
	"""
