// Issue 2842: run_scenario с filePath должен загрузить файл с диска,
// даже если этот же файл уже загружен в дерево. Иначе mode=all проверяет
// устаревшее дерево и возвращает старую ошибку разбора.
// Фикстуры лежат в files/*.txt, чтобы тестовый раннер не исполнял v1
// с заведомой ошибкой разбора как отдельную фичу.
// Проверяем поведение в отдельном экземпляре VA: вызов run_scenario
// из выполняющегося сценария запрещён, поэтому менеджер (внешний VA)
// управляет вторым экземпляром и вызывает хендлер напрямую.

Функционал: Проверка issue 2842 — запуск с filePath после изменения файла

	Контекст:
		Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

	Сценарий: run_scenario mode=all с filePath перезагружает изменённый файл
		Когда Я открываю VanessaAutomation в режиме TestClient со стандартной библиотекой 'VAEditor'
		// VAEditor обязателен: без Vanessa Editor run_scenario с filePath возвращает ACTION_FAILED
		// (см. проверку в ПродолжитьВыполнитьСценарий1), и тест проверял бы не тот сценарий.
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/features/Core/MCP/files/Issue2842_v1.txt"' в переменную "ФайлV1"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/features/Core/MCP/files/Issue2842_v2.txt"' в переменную "ФайлV2"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp"' в переменную "РабочийКаталог"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp/Issue2842_work.feature"' в переменную "РабочийФайл"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp/Issue2842_done.txt"' в переменную "МаркерФайл"
		И я создаю каталог "$РабочийКаталог$"
		И я копирую файл "$ФайлV1$" "$РабочийФайл$"
		И я перехожу к закладке с именем "ГруппаЗапускТестов"
		И я снимаю флаг с именем 'ФлагСценарииЗагружены'
		И я буду выбирать внешний файл "$РабочийФайл$"
		# В режиме VAEditor кнопка загрузки одна - в командной панели редактора.
		И я нажимаю на кнопку с именем 'VanessaEditorФормаЗагрузитьОднуФичу'
		И у элемента с именем "ФлагСценарииЗагружены" я жду значения "Да" в течение 60 секунд
		# Исходное дерево построено по v1: пустое имя сценария.
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			Проблемы = ПолучитьПроблемыПоТекущейФиче();
			Сообщить("ПроблемДоЕсть=" + ?(Проблемы.Количество() > 0, "Да", "Нет"));
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И пауза 2
		Тогда в логе сообщений TestClient есть строки:
			|'ПроблемДоЕсть=Да'|
		# На диске уже исправленный v2, дерево не перезагружено.
		И я копирую файл "$ФайлV2$" "$РабочийФайл$"
		И я удаляю файл "$МаркерФайл$"
		И я перехожу к закладке с именем "ГруппаЗапускТестов"
		И я снимаю флаг с именем 'ФлагСценарииВыполнены'
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			Запрос = Новый Структура;
			Запрос.Вставить("Идентификатор", "AUTOTEST-2842");
			Аргументы = Новый Структура;
			Аргументы.Вставить("filePath", Ванесса.Объект.КаталогИнструментов + "/temp/Issue2842_work.feature");
			Аргументы.Вставить("mode", "all");
			Аргументы.Вставить("wait", Истина);
			Запрос.Вставить("Аргументы", Аргументы);
			Ванесса.МодульMCPVA().ВыполнитьСценарий(Запрос, Неопределено);
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И я перехожу к закладке с именем "ГруппаЗапускТестов"
		И у элемента с именем "ФлагСценарииВыполнены" я жду значения "Да" в течение 60 секунд
		И я жду существования файла "$МаркерФайл$" в течение 10 секунд
		И пауза 1
		# Дерево должно быть перезагружено по v2, прогон — успешным.
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			Проблемы = ПолучитьПроблемыПоТекущейФиче();
			Сообщить("ПроблемПосле=" + Проблемы.Количество());
			Сообщить("ИдетВыполнение=" + ?(Ванесса.Объект.ИдетВыполнениеСценариев, "Да", "Нет"));
			Результаты = Ванесса.ПолучитьМассивРезультатПрохожденияТестовСценария();
			Если ТипЗнч(Результаты) = Тип("Массив") Тогда
				Сообщить("ЕстьРезультат=" + ?(Результаты.Количество() > 0, "Да", "Нет"));
				Если Результаты.Количество() > 0 Тогда
					ПоследнийРезультат = Результаты[Результаты.Количество() - 1];
					Если ПоследнийРезультат.Свойство("Статус") Тогда
						Сообщить("Статус=" + ПоследнийРезультат.Статус);
					Иначе
						Сообщить("Статус=НетСтатуса");
					КонецЕсли;
				Иначе
					Сообщить("Статус=НетРезультата");
				КонецЕсли;
			Иначе
				Сообщить("ЕстьРезультат=Нет");
				Сообщить("Статус=НетРезультата");
			КонецЕсли;
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И пауза 2
		Тогда в логе сообщений TestClient есть строки:
			|'ПроблемПосле=0'|
			|'ИдетВыполнение=Нет'|
			|'ЕстьРезультат=Да'|
			|'Статус=Success'|
