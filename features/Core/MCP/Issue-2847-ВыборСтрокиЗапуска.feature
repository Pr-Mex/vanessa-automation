// Issue 2847: контрактный тест предиката допустимой строки запуска.
// Фикстура лежит в files/*.txt и копируется в temp/*.feature, чтобы тестовый
// раннер не исполнял её как отдельную фичу.
// Проверяем строки: обычный шаг, группа, условие, Иначе, вызов подсценария,
// вызов вложенной структуры, её тело и строки примеров. Верхнеуровневая
// структура сценария — обычный сценарий, её шаг тела стартует.

Функционал: Issue 2847 — выбор строки запуска

	Контекст:
		Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

	Сценарий: Предикат различает стартуемые и нестартуемые строки
		Когда Я открываю VanessaAutomation в режиме TestClient со стандартной библиотекой
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/features/Core/MCP/files/Issue2847_ВыборСтрокиЗапуска.txt"' в переменную "ИсходныйФайл"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp"' в переменную "РабочийКаталог"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp/Issue2847_ВыборСтрокиЗапуска.feature"' в переменную "РабочийФайл"
		И я создаю каталог "$РабочийКаталог$"
		И я копирую файл "$ИсходныйФайл$" "$РабочийФайл$"
		И я перехожу к закладке с именем "ГруппаЗапускТестов"
		И я снимаю флаг с именем 'ФлагСценарииЗагружены'
		И я буду выбирать внешний файл "$РабочийФайл$"
		И я нажимаю на кнопку с именем 'ФормаЗагрузитьОднуФичу'
		И у элемента с именем "ФлагСценарииЗагружены" я жду значения "Да" в течение 60 секунд
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			Номера = Новый Массив;
			Номера.Добавить(15);
			Номера.Добавить(16);
			Номера.Добавить(17);
			Номера.Добавить(18);
			Номера.Добавить(20);
			Номера.Добавить(22);
			Номера.Добавить(24);
			Номера.Добавить(28);
			Номера.Добавить(29);
			Номера.Добавить(30);
			Дерево = Ванесса.МодульДеревоТестов();
			Для Каждого Номер Из Номера Цикл
				Строка = Дерево.СтрокаДереваПоНомеруСтрокиФичи(Номер);
				Если Строка = Неопределено Тогда
					Сообщить("Строка" + Номер + "=НетСтроки");
				Иначе
					Сообщить("Строка" + Номер + "=" + ?(Дерево.ЭтуСтрокуМожноНачатьВыполнять(Строка), "Да", "Нет"));
					ДопТипСтроки = "";
					Если ТипЗнч(Строка.ДопТип) = Тип("Строка") Тогда
						ДопТипСтроки = СокрЛП(Строка.ДопТип);
					КонецЕсли;
					Сообщить("Тип" + Номер + "=" + Строка.Тип + "/" + ДопТипСтроки);
				КонецЕсли;
			КонецЦикла;
			СтрокаСтруктуры = Дерево.СтрокаДереваПоНомеруСтрокиФичи(24);
			Если СтрокаСтруктуры = Неопределено Тогда
				Сообщить("Тело24=НетСтроки");
			Иначе
				Дети = СтрокаСтруктуры.ПолучитьЭлементы();
				Если Дети.Количество() = 0 Тогда
					Сообщить("Тело24=НетДетей");
				Иначе
					Сообщить("Тело24=" + ?(Дерево.ЭтуСтрокуМожноНачатьВыполнять(Дети[0]), "Да", "Нет"));
				КонецЕсли;
			КонецЕсли;
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И пауза 2
		Тогда в логе сообщений TestClient есть строки:
			|'Строка15=Да'|
			|'Тип15=Шаг/'|
			|'Строка16=Да'|
			|'Тип16=Область/'|
			|'Строка17=Да'|
			|'Тип17=Шаг/'|
			|'Строка18=Да'|
			|'Тип18=Область/Условие'|
			|'Строка20=Нет'|
			|'Тип20=Область/УсловиеИначе'|
			|'Строка22=Да'|
			|'Тип22=ШагСценарий/'|
			|'Строка24=Нет'|
			|'Тип24=ШагСценарий/СтруктураСценария'|
			|'Строка28=Да'|
			|'Тип28=Шаг/'|
			|'Строка29=Нет'|
			|'Строка30=Нет'|
			|'Тело24=Нет'|
