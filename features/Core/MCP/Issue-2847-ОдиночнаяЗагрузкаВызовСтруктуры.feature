// Issue 2847: регрессия для одиночной загрузки файла.
// open_feature_file (и run_scenario с filePath) загружают фичу как отдельный файл:
// в таком дереве ДопТип строки вызова вложенной структуры сценария может быть пустым.
// Проверяем, что select_step, execute_feature_step и reloadAndRunFromLine
// не принимают строку 24 (вызов СтруктураДляПроверки2847) за стартовую.
//
// Тест управляет отдельным экземпляром Vanessa Automation в клиенте тестирования
// и вызывает хендлеры MCP напрямую, как в Issue-2842-ЗапускСФайломПослеИзменения.feature:
// вызов run_scenario из выполняющегося сценария запрещён, поэтому менеджер
// (внешний VA) управляет вторым экземпляром.
//
// Фикстура лежит в files/*.txt и копируется в temp/*.feature, чтобы тестовый
// раннер не исполнял её как отдельную фичу.

Функционал: Issue 2847 — одиночная загрузка файла и строка вызова структуры

	Контекст:
		Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

	Сценарий: MCP-инструменты отвергают строку вызова структуры после одиночной загрузки
		Когда Я открываю VanessaAutomation в режиме TestClient со стандартной библиотекой 'VAEditor'
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/features/Core/MCP/files/Issue2847_ОдиночнаяЗагрузка.txt"' в переменную "ИсходныйФайл"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp"' в переменную "РабочийКаталог"
		И Я запоминаю значение выражения 'Ванесса.Объект.КаталогИнструментов + "/temp/Issue2847_ОдиночнаяЗагрузка.feature"' в переменную "РабочийФайл"
		И я создаю каталог "$РабочийКаталог$"
		И я копирую файл "$ИсходныйФайл$" "$РабочийФайл$"

		# Загружаем фичу одиночным файлом через сам MCP-хендлер open_feature_file.
		И я перехожу к закладке с именем "ГруппаЗапускТестов"
		И я снимаю флаг с именем 'ФлагСценарииЗагружены'
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			Запрос = Новый Структура;
			Запрос.Вставить("Идентификатор", "AUTOTEST-2847-OPEN");
			Аргументы = Новый Структура;
			Аргументы.Вставить("filePath", Ванесса.Объект.КаталогИнструментов + "/temp/Issue2847_ОдиночнаяЗагрузка.feature");
			Запрос.Вставить("Аргументы", Аргументы);
			Попытка
				Результат = Ванесса.МодульMCPVA().ОткрытьФичаФайл(Запрос, Неопределено);
				Сообщить("open_feature_file_асинхронно=" + ?(Результат = Неопределено, "Да", "Нет"));
				Если ТипЗнч(Результат) = Тип("Строка") Тогда
					Сообщить("open_feature_file_ответ=" + СтрЗаменить(Результат, Символы.ПС, " "));
				КонецЕсли;
			Исключение
				Сообщить("open_feature_file_исключение=" + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));
			КонецПопытки;
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И у элемента с именем "ФлагСценарииЗагружены" я жду значения "Да" в течение 60 секунд
		И пауза 2

		# Проверяем, что дерево построено именно по одиночному файлу и строка 24
		# действительно распознаётся как вызов вложенной структуры.
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			РабочийФайл = Ванесса.Объект.КаталогИнструментов + "/temp/Issue2847_ОдиночнаяЗагрузка.feature";
			Дерево = Ванесса.МодульДеревоТестов();
			Корни = Ванесса.Объект.ДеревоТестов.ПолучитьЭлементы();
			Сообщить("КорнейДерева=" + Строка(Корни.Количество()));
			Для Каждого Корень Из Корни Цикл
				Сообщить("Корень=" + Корень.Тип + "|" + Строка(Корень.ПолныйПуть));
			КонецЦикла;
			Сообщить("РабочийФайл=" + РабочийФайл);
			Строка24БезФайла = Дерево.СтрокаДереваПоНомеруСтрокиФичи(24);
			Если Строка24БезФайла = Неопределено Тогда
				Сообщить("Строка24БезФайла=Нет");
			Иначе
				Сообщить("Строка24БезФайла=Да|" + Строка24БезФайла.Тип + "|" + Строка(Дерево.ОпределитьИмяФичаФайлаПоСтрокеДерева(Строка24БезФайла)));
			КонецЕсли;
			Строка24 = Дерево.СтрокаДереваПоНомеруСтрокиФичиИФайлу(24, РабочийФайл);
			Если Строка24 = Неопределено Тогда
				Сообщить("Строка24=НетСтроки");
			Иначе
				ДопТип = "";
				Если ТипЗнч(Строка24.ДопТип) = Тип("Строка") Тогда
					ДопТип = СокрЛП(Строка24.ДопТип);
				КонецЕсли;
				Сообщить("Строка24=Найдена");
				// Диагностика исходного условия: при одиночной загрузке без очистки
				// кеша step definition ДопТип строки вызова может остаться пустым.
				// Если парсер его заполнил, принудительно очищаем: проверка ниже
				// не должна полагаться только на ДопТип (суть исправления issue 2847).
				Сообщить("Тип24=" + Строка24.Тип + "/" + ДопТип);
				ДопТипБылЗаполнен = ЗначениеЗаполнено(ДопТип);
				Если ДопТипБылЗаполнен Тогда
					Строка24.ДопТип = "";
				КонецЕсли;
				Сообщить("ДопТипОчищен=" + ?(ДопТипБылЗаполнен, "Да", "Нет"));
				Сообщить("Предикат24=" + ?(Дерево.ЭтуСтрокуМожноНачатьВыполнять(Строка24), "Да", "Нет"));
				Сообщить("ЭтоВызов24=" + ?(Дерево.ЭтоВызовИлиСтрокаВложеннойСтруктурыСценария(Строка24), "Да", "Нет"));
			КонецЕсли;
			ДанныеЗагрузки = Ванесса.ДанныеПоследнейЗагрузкиФичиMCP();
			ФайлЗагрузки = "";
			Если ТипЗнч(ДанныеЗагрузки) = Тип("Структура") Тогда
				Сообщить("СтатусЗагрузки=" + ДанныеЗагрузки.Статус);
				Если ТипЗнч(ДанныеЗагрузки.Файл) = Тип("Строка") Тогда
					ФайлЗагрузки = ДанныеЗагрузки.Файл;
				КонецЕсли;
			Иначе
				Сообщить("СтатусЗагрузки=НетДанных");
			КонецЕсли;
			ФайлДерева = Ванесса.ИмяФайлаДереваТестов();
			СовпадаетФайлДерева = ЗначениеЗаполнено(ФайлДерева)
				И ЗначениеЗаполнено(ФайлЗагрузки)
				И Ванесса.СравнитьПутиФайловКлиент(ФайлДерева, ФайлЗагрузки);
			Сообщить("ФайлДереваСовпадает=" + ?(СовпадаетФайлДерева, "Да", "Нет"));
			ФайлВкладки = "";
			Попытка
				Если Ванесса.VanessaTabs <> Неопределено И Ванесса.VanessaTabs.current <> Неопределено Тогда
					ФайлВкладки = Ванесса.VanessaTabs.current.filename;
				КонецЕсли;
			Исключение
				ФайлВкладки = "";
			КонецПопытки;
			СовпадаетВкладка = ЗначениеЗаполнено(ФайлВкладки)
				И ЗначениеЗаполнено(ФайлДерева)
				И Ванесса.СравнитьПутиФайловКлиент(ФайлВкладки, ФайлДерева);
			Сообщить("ВкладкаСовпадает=" + ?(СовпадаетВкладка, "Да", "Нет"));
			АктивнаяВкладкаEdit = Ложь;
			Попытка
				АктивнаяВкладкаEdit = Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current);
			Исключение
				АктивнаяВкладкаEdit = Ложь;
			КонецПопытки;
			Сообщить("АктивнаяВкладкаEdit=" + ?(АктивнаяВкладкаEdit, "Да", "Нет"));
		"""
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И пауза 2
		Тогда в логе сообщений TestClient есть строки:
			|'open_feature_file_асинхронно=Да'|
			|'Строка24=Найдена'|
			|'Предикат24=Нет'|
			|'ЭтоВызов24=Да'|
			|'СтатусЗагрузки=Успех'|
			|'ФайлДереваСовпадает=Да'|
			|'ВкладкаСовпадает=Да'|
			|'АктивнаяВкладкаEdit=Да'|

		# select_step и execute_feature_step должны отказать синхронно, до действия.
		# reloadAndRunFromLine проверяем отдельно: он всегда перезагружает файл
		# и отвечает асинхронно, поэтому проверяем отсутствие запуска.
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			РабочийФайл = Ванесса.Объект.КаталогИнструментов + "/temp/Issue2847_ОдиночнаяЗагрузка.feature";

			Запрос = Новый Структура;
			Запрос.Вставить("Идентификатор", "AUTOTEST-2847-SELECT");
			Аргументы = Новый Структура;
			Аргументы.Вставить("lineNumber", 24);
			Запрос.Вставить("Аргументы", Аргументы);
			Попытка
				Результат = Ванесса.МодульMCPVA().ВыбратьШаг(Запрос, Неопределено);
				ТекстРезультата = "";
				КодРезультата = "";
				Если ТипЗнч(Результат) = Тип("Строка") Тогда
					ТекстРезультата = Результат;
				ИначеЕсли ТипЗнч(Результат) = Тип("Структура") ИЛИ ТипЗнч(Результат) = Тип("ФиксированнаяСтруктура") Тогда
					Если Результат.Свойство("Ошибка") Тогда
						ТекстРезультата = Строка(Результат.Ошибка);
					КонецЕсли;
					Если Результат.Свойство("КодОшибки") Тогда
						КодРезультата = Строка(Результат.КодОшибки);
					КонецЕсли;
				КонецЕсли;
				Сообщить("select_step_исключение=Нет");
				Сообщить("select_step_ACTION_FAILED=" + ?(Найти(ТекстРезультата + КодРезультата, "ACTION_FAILED") > 0, "Да", "Нет"));
				Сообщить("select_step_вложенная=" + ?(Найти(ТекстРезультата, "вложенной структуры") > 0, "Да", "Нет"));
			Исключение
				Сообщить("select_step_исключение=" + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));
				Сообщить("select_step_ACTION_FAILED=Нет");
				Сообщить("select_step_вложенная=Нет");
			КонецПопытки;

			Запрос = Новый Структура;
			Запрос.Вставить("Идентификатор", "AUTOTEST-2847-EXECUTE");
			Аргументы = Новый Структура;
			Аргументы.Вставить("filePath", РабочийФайл);
			Аргументы.Вставить("lineNumber", 24);
			Аргументы.Вставить("reload", Ложь);
			Запрос.Вставить("Аргументы", Аргументы);
			Попытка
				Результат = Ванесса.МодульMCPVA().ВыполнитьОдинШагВФичаФайле(Запрос, Неопределено);
				ТекстРезультата = "";
				КодРезультата = "";
				Если ТипЗнч(Результат) = Тип("Строка") Тогда
					ТекстРезультата = Результат;
				ИначеЕсли ТипЗнч(Результат) = Тип("Структура") ИЛИ ТипЗнч(Результат) = Тип("ФиксированнаяСтруктура") Тогда
					Если Результат.Свойство("Ошибка") Тогда
						ТекстРезультата = Строка(Результат.Ошибка);
					КонецЕсли;
					Если Результат.Свойство("КодОшибки") Тогда
						КодРезультата = Строка(Результат.КодОшибки);
					КонецЕсли;
				КонецЕсли;
				Сообщить("execute_step_исключение=Нет");
				Сообщить("execute_step_ACTION_FAILED=" + ?(Найти(ТекстРезультата + КодРезультата, "ACTION_FAILED") > 0, "Да", "Нет"));
				Сообщить("execute_step_вложенная=" + ?(Найти(ТекстРезультата, "вложенной структуры") > 0, "Да", "Нет"));
			Исключение
				Сообщить("execute_step_исключение=" + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));
				Сообщить("execute_step_ACTION_FAILED=Нет");
				Сообщить("execute_step_вложенная=Нет");
			КонецПопытки;
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И пауза 2
		Тогда в логе сообщений TestClient есть строки:
			|'select_step_исключение=Нет'|
			|'select_step_ACTION_FAILED=Да'|
			|'select_step_вложенная=Да'|
			|'execute_step_исключение=Нет'|
			|'execute_step_ACTION_FAILED=Да'|
			|'execute_step_вложенная=Да'|

		# reloadAndRunFromLine: фича загружается одиночным файлом, но строка 24
		# не должна приниматься как стартовая. Признак регрессии — начавшийся прогон
		# и изменившаяся переменная Ловушка2847.
		И я перехожу к закладке с именем "ГруппаЗапускТестов"
		И я снимаю флаг с именем 'ФлагСценарииЗагружены'
		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
			РабочийФайл = Ванесса.Объект.КаталогИнструментов + "/temp/Issue2847_ОдиночнаяЗагрузка.feature";
			Ванесса.СохранитьЗначениеПеременнойВКонтекст("Ловушка2847", "НЕ_ЗАПУСКАЛОСЬ", Ложь, Истина);
			ЗагрузкаИдет = Ванесса.ЗагрузкаФичиИдетMCP() ИЛИ Ванесса.ЕстьНезавершённаяЗагрузкаФичи();
			Сообщить("ЗагрузкаПередЗапуском=" + ?(ЗагрузкаИдет, "Да", "Нет"));
			РезультатыДо = Ванесса.ПолучитьМассивРезультатПрохожденияТестовСценария();
			КоличествоДо = 0;
			Если ТипЗнч(РезультатыДо) = Тип("Массив") Тогда
				КоличествоДо = РезультатыДо.Количество();
			КонецЕсли;
			Ванесса.СохранитьЗначениеПеременнойВКонтекст("РезультатовДо2847", КоличествоДо, Ложь, Истина);

			Запрос = Новый Структура;
			Запрос.Вставить("Идентификатор", "AUTOTEST-2847-RUNLINE");
			Аргументы = Новый Структура;
			Аргументы.Вставить("filePath", РабочийФайл);
			Аргументы.Вставить("mode", "reloadAndRunFromLine");
			Аргументы.Вставить("lineNumber", 24);
			Аргументы.Вставить("wait", Истина);
			Запрос.Вставить("Аргументы", Аргументы);
			Попытка
				Результат = Ванесса.МодульMCPVA().ВыполнитьСценарий(Запрос, Неопределено);
				Сообщить("run_scenario_исключение=Нет");
				Сообщить("run_scenario_асинхронно=" + ?(Результат = Неопределено, "Да", "Нет"));
				ТекстОтвета = "";
				Если ТипЗнч(Результат) = Тип("Строка") Тогда
					ТекстОтвета = Результат;
				ИначеЕсли (ТипЗнч(Результат) = Тип("Структура") ИЛИ ТипЗнч(Результат) = Тип("ФиксированнаяСтруктура")) И Результат.Свойство("Ошибка") Тогда
					ТекстОтвета = Строка(Результат.Ошибка);
				КонецЕсли;
				Если ЗначениеЗаполнено(ТекстОтвета) Тогда
					Сообщить("run_scenario_ответ=" + СтрЗаменить(ТекстОтвета, Символы.ПС, " "));
				КонецЕсли;
			Исключение
				Сообщить("run_scenario_исключение=" + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));
				Сообщить("run_scenario_асинхронно=Нет");
			КонецПопытки;
		"""
		И я очищаю окно сообщений пользователю
		И я нажимаю на кнопку с именем 'ВыполнитьПроизвольныйКод'
		И у элемента с именем "ФлагСценарииЗагружены" я жду значения "Да" в течение 60 секунд
		И пауза 5

		И я перехожу к закладке с именем "ГруппаНастройки"
		И я перехожу к закладке с именем "ГруппаСлужебная"
		И я перехожу к закладке с именем "ГруппаСлужебноеВыполнитьКод"
		И в поле с именем 'РеквизитПроизвольныйКод' я ввожу текст
		"""
