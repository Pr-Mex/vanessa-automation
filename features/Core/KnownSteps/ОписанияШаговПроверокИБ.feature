# Регрессия PR #2751 (коммит dc721b825): 20 шагов проверок существования записей ИБ
# библиотеки «Объекты конфигурации» объявлялись циклом с пустым описанием, теперь
# объявлены явно и у каждого есть описание с примером.
#
# Проверка идёт через интерфейс: дерево известных шагов выгружается в JSON кнопкой
# 'ФормаВыгрузитьШагиВJSON', а сам JSON разбирается кодом встроенного языка. Состав
# выгрузки (свойства ИмяШага, ОписаниеШага, ПолныйТипШага) — контракт формы
# «Известные шаги» (VanessaAutomation/Forms/ВыборИзвестногоШага), а не внутренняя
# деталь, поэтому проверка по нему устойчива.
#
# Представления шагов в дереве — с примерными именами объектов тестовой конфигурации
# («Справочник1», «РегистрНакопления1»), поэтому шаги ищутся по началу представления.

Функционал: Описания шагов проверок существования записей ИБ

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

Сценарий: У шагов проверок существования записей ИБ есть описания с примерами

	Когда Я открываю VanessaAutomation в режиме TestClient со стандартной библиотекой

	И я перехожу к закладке с именем "ГруппаДополнительно"
	И я нажимаю на кнопку с именем 'ДобавитьИзвестныйШаг'
	Тогда открылось окно 'Известные шаги*'

	# Каталог создаётся шагом: если каталог уже есть, шаг ничего не меняет.
	И я создаю каталог "C:\Temp\CommandFeature"
	Если Файл "C:\Temp\CommandFeature\ШагиПроверокИБ.json" существует тогда
		Тогда я удаляю файл "C:\Temp\CommandFeature\ШагиПроверокИБ.json"

	И я буду выбирать внешний файл "C:\Temp\CommandFeature\ШагиПроверокИБ.json"
	И я нажимаю на кнопку с именем 'ФормаВыгрузитьШагиВJSON'
	И я жду существования файла "C:\Temp\CommandFeature\ШагиПроверокИБ.json" в течение 30 секунд

	# 16 начал представлений дают 20 шагов: у шагов справочника по два варианта
	# (с равным реквизитом и с таблицей реквизитов), у остальных — по одному.
	# Среди найденных шагов имена должны быть уникальны, описания не пусты и содержать
	# разделы «### Описание» и «### Пример». Потерянный или переименованный шаг, снятое
	# описание, потерянный пример дают сообщение о том, что именно не сошлось.
	И я выполняю код встроенного языка
	"""bsl
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл("C:\Temp\CommandFeature\ШагиПроверокИБ.json");
		Шаги = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();

		ОжидаемыеНачала = Новый Соответствие;
		ОжидаемыеНачала.Вставить("Тогда существует элемент справочника", 2);
		ОжидаемыеНачала.Вставить("Тогда не существует элемент справочника", 2);
		ОжидаемыеНачала.Вставить("Если существует элемент справочника", 2);
		ОжидаемыеНачала.Вставить("Если не существует элемент справочника", 2);
		ОжидаемыеНачала.Вставить("Тогда существует документ", 1);
		ОжидаемыеНачала.Вставить("Тогда не существует документ", 1);
		ОжидаемыеНачала.Вставить("Если существует документ", 1);
		ОжидаемыеНачала.Вставить("Если не существует документ", 1);
		ОжидаемыеНачала.Вставить("Тогда существует запись регистра сведений", 1);
		ОжидаемыеНачала.Вставить("Тогда не существует запись регистра сведений", 1);
		ОжидаемыеНачала.Вставить("Если существует запись регистра сведений", 1);
		ОжидаемыеНачала.Вставить("Если не существует запись регистра сведений", 1);
		ОжидаемыеНачала.Вставить("Тогда существует запись регистра накопления", 1);
		ОжидаемыеНачала.Вставить("Тогда не существует запись регистра накопления", 1);
		ОжидаемыеНачала.Вставить("Если существует запись регистра накопления", 1);
		ОжидаемыеНачала.Вставить("Если не существует запись регистра накопления", 1);

		НайденоПоНачалу = Новый Соответствие;
		ИменаШагов = Новый Соответствие;
		Проблемы = "";

		Для Каждого Шаг Из Шаги Цикл
			// Отбор по типу шага: строки дерева без этого типа к проверяемым шагам
			// не относятся и в подсчёт не попадают.
			Если Найти(Шаг.ПолныйТипШага, "Объекты конфигурации") <> 1 Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого КлючИЗначение Из ОжидаемыеНачала Цикл
				Если Найти(Шаг.ИмяШага, КлючИЗначение.Ключ) <> 1 Тогда
					Продолжить;
				КонецЕсли;
				Найдено = НайденоПоНачалу[КлючИЗначение.Ключ];
				НайденоПоНачалу.Вставить(КлючИЗначение.Ключ, ?(Найдено = Неопределено, 1, Найдено + 1));
				ИменаШагов.Вставить(Шаг.ИмяШага, Истина);
				Если НЕ ЗначениеЗаполнено(Шаг.ОписаниеШага) Тогда
					Проблемы = Проблемы + "Пустое описание у шага: " + Шаг.ИмяШага + Символы.ПС;
				Иначе
					Если Найти(Шаг.ОписаниеШага, "### Описание") <> 1 Тогда
						Проблемы = Проблемы + "Описание не начинается с раздела «### Описание»: " + Шаг.ИмяШага + Символы.ПС;
					КонецЕсли;
					Если Найти(Шаг.ОписаниеШага, "### Пример") = 0 Тогда
						Проблемы = Проблемы + "В описании нет раздела «### Пример»: " + Шаг.ИмяШага + Символы.ПС;
					КонецЕсли;
				КонецЕсли;
				Прервать;
			КонецЦикла;
		КонецЦикла;

		ВсегоОжидается = 0;
		Для Каждого КлючИЗначение Из ОжидаемыеНачала Цикл
			ВсегоОжидается = ВсегоОжидается + КлючИЗначение.Значение;
			Найдено = НайденоПоНачалу[КлючИЗначение.Ключ];
			Если Найдено <> КлючИЗначение.Значение Тогда
				Проблемы = Проблемы + "Шагов с началом «" + КлючИЗначение.Ключ + "» найдено "
					+ Формат(?(Найдено = Неопределено, 0, Найдено), "ЧГ=0")
					+ ", ожидалось " + Формат(КлючИЗначение.Значение, "ЧГ=0") + Символы.ПС;
			КонецЕсли;
		КонецЦикла;

		// Повтор представления (например, шаг объявлен дважды) уменьшает число
		// уникальных имён и ловится здесь.
		Если ИменаШагов.Количество() <> ВсегоОжидается Тогда
			Проблемы = Проблемы + "Уникальных имён среди найденных шагов: "
				+ Формат(ИменаШагов.Количество(), "ЧГ=0")
				+ ", ожидалось " + Формат(ВсегоОжидается, "ЧГ=0") + Символы.ПС;
		КонецЕсли;

		Если Проблемы <> "" Тогда
			ВызватьИсключение "Проверка описаний шагов проверок ИБ не пройдена:" + Символы.ПС + Проблемы;
		КонецЕсли;
	"""

	И Я закрываю окно 'Известные шаги*'

	# Выгрузка удаляется после успешной проверки; при ошибке файл остаётся для разбора.
	Тогда я удаляю файл "C:\Temp\CommandFeature\ШагиПроверокИБ.json"
