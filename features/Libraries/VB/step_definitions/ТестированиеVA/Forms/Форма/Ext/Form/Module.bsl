&НаКлиенте
//И я проверяю что для всех фича файлов установлен тег для разделения фич на потоки
//@ЯПроверяюЧтоДляВсехФичаФайловУстановленТегДляРазделенияФичНаПотоки()
Функция ЯПроверяюЧтоДляВсехФичаФайловУстановленТегДляРазделенияФичНаПотоки() Экспорт
	
	Ошибки = Новый Массив;
	
	Файлы = НайтиФайлы(Ванесса.Объект.КаталогПроекта + "\features", "*.feature", Истина);
	Для Каждого Файл Из Файлы Цикл
		
		Если Найти(Файл.ПолноеИмя, "\Support") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(Файл.ПолноеИмя, "UTF-8");
		ТекстФайла = Текст.Прочитать();
		Текст.Закрыть();
		
		НРег_ТекстФайла = НРег(ТекстФайла);
		
		Если Найти(НРег_ТекстФайла, НРег("@IgnoreOnCIMainBuild")) > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Нашли = Ложь;
		МассивСтрок = Ванесса._СтрРазделить(НРег_ТекстФайла, Символы.ПС);
		Для Сч = 0 По МассивСтрок.Количество()-1 Цикл
			ТекСтрока = СокрЛП(НРег(МассивСтрок[Сч]));
			Если Лев(ТекСтрока, 1) = "#" Тогда
				Продолжить;
			ИначеЕсли Лев(ТекСтрока, 2) = "//" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Лев(ТекСтрока, 8) = "@uf-part" Тогда
				Нашли = Истина;
				Прервать;
			ИначеЕсли Лев(ТекСтрока, 9) = "сценарий:" Тогда				
				// Тег должен быть до сценариев
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;	
		
		Если НЕ Нашли Тогда
			Ошибки.Добавить(Файл.ПолноеИмя);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		ТекстОшибки = Ванесса.Локализовать("Есть фича файлы без тега @uf-part1 и @uf-part2 и т.д. Должен быть один из этих тегов. Список проблемных файлов:");
		ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса._СтрСоединить(Ошибки, Символы.ПС);
		ПоказатьПредупреждение(, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;	
	
КонецФункции

