&НаКлиенте
//Дано Версия редактора в модуле должна соответствовать версии из файла packages.json
//@ВерсияРедактораВМодулеДолжнаСоответствоватьВерсииИзФайлаPackagesjson()
Функция ВерсияРедактораВМодулеДолжнаСоответствоватьВерсииИзФайлаPackagesjson() Экспорт
	
	ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + "lib") + "packages.json";
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	Попытка
		ПараметрыФайла = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ПараметрыФайла = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();    
	
	ВерсияФайл = Неопределено;
	
	Для Каждого Элем Из ПараметрыФайла Цикл
		Если Элем.repo = "VAEditor" Тогда
			ВерсияФайл = Элем.version;
		КонецЕсли;	
	КонецЦикла;
	
	ВерсияVA = Ванесса.ВерсияРедактора();
	
	Если НЕ ЗначениеЗаполнено(ВерсияVA) Тогда
		ВызватьИсключение "Не заполнена версия редактора";
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ВерсияФайл) Тогда
		ВызватьИсключение "Не заполнена версия редактора в файле " + ИмяФайла;
	КонецЕсли;
	
	Если ВерсияVA <> ВерсияФайл Тогда
		ВызватьИсключение "Не совпадает версия редактора в модуле VA и в файле packages.json. ВерсияVA = " + ВерсияVA + ", ВерсияФайл = " + ВерсияФайл;
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
//И я генерирую код для создания перменной в сеансе VA для проверки РасширеннойПодсказки и сохраняю его в переменную "ИмяПеременной"
//@ЯГенерируюКодДляСозданияПерменнойВСеансеVAДляПроверкиРасширеннойПодсказкиИСохраняюЕгоВПеременную(Парам01)
Функция ЯГенерируюКодДляСозданияПерменнойВСеансеVAДляПроверкиРасширеннойПодсказкиИСохраняюЕгоВПеременную(ИмяПеременной) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого Элем Из Ванесса.Элементы Цикл
		Если Прав(НРег(Элем.Имя), 20) = "расширеннаяподсказка" И ЗначениеЗаполнено(Элем.Заголовок) Тогда
			Результат.Добавить(Элем.Имя);
		КонецЕсли;	
	КонецЦикла;
	
	Текст = "//Генерация переменной
	|Результат = Новый Массив;
	|ОбъектКонтекстСохраняемый.Вставить(""ИменаЭлементовСРасширеннойПодсказкой"", Результат);
	|";
	Для Каждого Стр Из Результат Цикл
		Текст = Текст + "Результат.Добавить(""" + Стр + """);" + Символы.ПС;
	КонецЦикла;	
	
	Ванесса.СохранитьЗначениеПеременнойВКонтекст(ИмяПеременной, Текст);
	
КонецФункции

