//И я проверяю, что во всех формах Vanessa Automation для каждого синонима ru или en есть пара
//@ЯПроверяюЧтоВоВсехФормахVanessaAutomationДляКаждогоСинонимаRuИлиEnЕстьПара()
Функция ЯПроверяюЧтоВоВсехФормахVanessaAutomationДляКаждогоСинонимаRuИлиEnЕстьПара() Экспорт
	
	ПроблемыВсе = Новый Массив;
	Путь = Ванесса.Объект.КаталогИнструментов + "\VanessaAutomation";
	СписокКаталогов = Новый СписокЗначений;
	СписокФайлов    = Новый СписокЗначений;
	Ванесса.НайтиФайлыКомандаСистемы(Путь, СписокКаталогов, СписокФайлов, Истина, Неопределено, "*.xml");
	Для Каждого Файл Из СписокФайлов Цикл
		
		ПроверкаСинонимовXMLСервер(Файл.Значение.ПолноеИмя, ПроблемыВсе);
		
	КонецЦикла;
	
	Если ПроблемыВсе.Количество() > 0 Тогда
		ВызватьИсключение Ванесса._СтрСоединить(ПроблемыВсе, Символы.ПС);
	КонецЕсли;	
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверкаСинонимовXMLСервер(ИмяФайла, ПроблемыВсе)
	
	Парсер = Новый ЧтениеXML;
    Парсер.ОткрытьФайл(ИмяФайла);
 
    Построитель = Новый ПостроительDOM;
 
    ДокументXML = Построитель.Прочитать(Парсер);
	ТекДанные = Новый Структура;
	ТекДанные.Вставить("ИменаЭлементов", Новый Соответствие);
	ТекДанные.Вставить("ru", Новый Соответствие);
	ТекДанные.Вставить("en", Новый Соответствие);
	ПроверкаСинонимовXMLСерверРекурсивно(ДокументXML, ТекДанные);
	
	Проблемы = Новый Массив;
	Для Каждого Элем Из ТекДанные.ИменаЭлементов Цикл
		
		Если НЕ ЗначениеЗаполнено(Элем.Ключ) Тогда
			Продолжить;
		КонецЕсли;	
		
		ru = ТекДанные.ru[Элем.Ключ];
		en = ТекДанные.en[Элем.Ключ];
		
		Если ЗначениеЗаполнено(ru) И НЕ ЗначениеЗаполнено(en) Тогда
			Проблемы.Добавить("Элемент " + Элем.Ключ + ", нет синонима en. Файл: " + ИмяФайла);
		ИначеЕсли ЗначениеЗаполнено(en) И НЕ ЗначениеЗаполнено(ru) Тогда
			Проблемы.Добавить("Элемент " + Элем.Ключ + ", нет синонима ru. Файл: " + ИмяФайла);
		КонецЕсли;	
	КонецЦикла;
	
	Если Проблемы.Количество() > 0 Тогда
		ПроблемыВсе.Добавить(ИмяФайла);
		Для Каждого Стр Из Проблемы Цикл
			ПроблемыВсе.Добавить(Стр);
		КонецЦикла;
		ПроблемыВсе.Добавить("");
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверкаСинонимовXMLСерверРекурсивно(ДокументXML, ТекДанные)
	
	Для Каждого ТекУзел Из ДокументXML.ДочерниеУзлы Цикл
		Если ТекУзел.Атрибуты <> Неопределено Тогда
			Для Каждого ТекАтрибут Из ТекУзел.Атрибуты Цикл
				Если ТекАтрибут.Имя = "name" Тогда
					ТекДанные.Вставить("ТекИмя", ТекАтрибут.ЗначениеУзла);
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		Если ТекДанные.Свойство("ТекИмя") Тогда
			Если ТекУзел.ТекстовоеСодержимое = "ru" И ТекУзел.ИмяУзла = "v8:lang" Тогда
				ИмяСвойства = ТекУзел.РодительскийУзел.РодительскийУзел.ИмяУзла;
				Если ИмяСвойства <> "dcsset:presentation" Тогда
					Имя = ТекДанные.ТекИмя + "_" + ИмяСвойства;
					ТекДанные.ИменаЭлементов.Вставить(Имя, Истина);
					ТекДанные.ru.Вставить(Имя, Истина);
				КонецЕсли;	
			ИначеЕсли ТекУзел.ТекстовоеСодержимое = "en" И ТекУзел.ИмяУзла = "v8:lang" Тогда
				ИмяСвойства = ТекУзел.РодительскийУзел.РодительскийУзел.ИмяУзла;
				Если ИмяСвойства <> "dcsset:presentation" Тогда
					Имя = ТекДанные.ТекИмя + "_" + ИмяСвойства;
					ТекДанные.ИменаЭлементов.Вставить(Имя, Истина);
					ТекДанные.en.Вставить(Имя, Истина);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		ПроверкаСинонимовXMLСерверРекурсивно(ТекУзел, ТекДанные);
	КонецЦикла;	
	
КонецПроцедуры

