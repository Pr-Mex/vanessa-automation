&НаКлиенте
//Дано У всех методов всех модулей управляемых форм проекта указаны директивы компиляции
//@УВсехМетодовВсехМодулейУправляемыхФормПроектаУказаныДирективыКомпиляции()
// Проверяет, что у всех методов модулей управляемых форм проекта указаны директивы компиляции.
//
// Обходятся файлы "...\Forms\<ИмяФормы>\Ext\Form\Module.bsl". Из проверки исключаются каталоги
// vendor, temp, .git и каталог features\Fixtures: в фикстурах нарушения директив сделаны намеренно,
// они нужны для самопроверки парсера шагами ПриПроверкеДирективКомпиляцииВКаталоге...
//
// Для каждого объявления процедуры или функции ищется ближайшая значимая строка выше: если она
// начинается с "&", директива есть. Пустые строки и строки комментариев пропускаются, поэтому
// директива может стоять и перед комментариями шага вида "//Дано ..." и "//@ИмяШага()".
//
// Строки модуля предварительно очищаются от комментариев и содержимого строковых литералов
// (в том числе многострочных, у которых строки-продолжения начинаются с "|"): примеры кода внутри
// описаний шагов не дают ложных срабатываний.
//
// Известные ограничения:
//   - проверяется наличие строки-директивы, а не её правильность: опечатка в имени директивы
//     (&НаКлинете) нарушением не считается, её отловит платформа при сборке обработок;
//   - объявление метода должно быть записано одной строкой (имя метода и скобка вместе);
//   - если параметризованная директива разорвана переносом строки (например, &Вместо("Начало" + ПС + "Конец")),
//     метод может быть ошибочно признан методом без директивы.
//
// Параметры:
//   КореньПроекта - Строка - каталог проекта. Если не заполнен, берётся КаталогИнструментов VA.
Процедура ПроверитьДирективыКомпиляцииМодулей(КореньПроекта = "") Экспорт
	
	КореньПроекта = СокрЛП(КореньПроекта);
	Если КореньПроекта = "" Тогда
		КореньПроекта = СокрЛП(Ванесса.Объект.КаталогИнструментов);
	КонецЕсли;
	Если КореньПроекта = "" Тогда
		ВызватьИсключение "Не заполнен каталог проекта: передайте параметр шага или заполните КаталогИнструментов.";
	КонецЕсли;
	КореньПроекта = Ванесса.ДополнитьСлешВПуть(КореньПроекта);
	
	Нарушения = Новый Массив;
	Счетчики = Новый Структура("Файлов, Методов", 0, 0);
	СобратьНарушенияДирективКомпиляции(КореньПроекта, Нарушения, Счетчики);
	
	Если Счетчики.Файлов = 0 Тогда
		ВызватьИсключение "В каталоге " + КореньПроекта + " не найдено ни одного модуля управляемой формы.";
	КонецЕсли;
	
	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение "Найдены методы без директив компиляции: " + Нарушения.Количество()
			+ " (проверено модулей форм: " + Счетчики.Файлов + ", методов: " + Счетчики.Методов + ")."
			+ Символы.ПС + Ванесса._СтрСоединить(Нарушения, Символы.ПС);
	КонецЕсли;
	
	Сообщить("Проверка директив компиляции пройдена: модулей форм " + Счетчики.Файлов + ", методов " + Счетчики.Методов + ".");
	
КонецПроцедуры

&НаКлиенте
// Собирает методы без директив компиляции в модулях управляемых форм каталога.
//
// Параметры:
//   КореньПроекта - Строка - каталог проекта (со слешем на конце).
//   Нарушения - Массив - в него добавляются строки "путь:номер строки: объявление метода".
//   Счетчики - Структура - счётчики "Файлов" и "Методов" для итоговых сообщений.
Процедура СобратьНарушенияДирективКомпиляции(КореньПроекта, Нарушения, Счетчики)
	
	// Каталоги, которые в проверку не попадают: сторонние библиотеки, рабочие файлы, служебный
	// каталог git и каталог features\Fixtures с фикстурами, где нарушения сделаны намеренно.
	ИсключаемыеКаталоги = Новый Массив;
	ИсключаемыеКаталоги.Добавить("\vendor\");
	ИсключаемыеКаталоги.Добавить("\temp\");
	ИсключаемыеКаталоги.Добавить("\.git\");
	ИсключаемыеКаталоги.Добавить("\fixtures\");
	
	ФайлКаталога = Новый Файл(КореньПроекта);
	Если НЕ ФайлКаталога.Существует() Тогда
		// Проверка нужна для понятного сообщения: НайтиФайлы по несуществующему каталогу
		// падает технической ошибкой платформы.
		ВызватьИсключение "Каталог " + КореньПроекта + " не найден.";
	КонецЕсли;
	
	Файлы = НайтиФайлы(КореньПроекта, "Module.bsl", Истина);
	Для Каждого Файл Из Файлы Цикл
		// Отбор идёт по пути относительно корня проекта: по абсолютному пути фильтровать нельзя,
		// иначе каталог вида "C:\temp" отбросил бы сразу весь проект.
		ПутьОтносительный = Сред(Файл.ПолноеИмя, СтрДлина(КореньПроекта) + 1);
		ПутьДляСравнения = "\" + НРег(СтрЗаменить(ПутьОтносительный, "/", "\"));
		
		// Проверяются только модули управляемых форм; модуль обычной формы лежит в файле Form.bin.
		Если Прав(ПутьДляСравнения, СтрДлина("\ext\form\module.bsl")) <> "\ext\form\module.bsl" Тогда
			Продолжить;
		КонецЕсли;
		
		Пропустить = Ложь;
		Для Каждого ИсключаемыйКаталог Из ИсключаемыеКаталоги Цикл
			Если Найти(ПутьДляСравнения, ИсключаемыйКаталог) > 0 Тогда
				Пропустить = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Пропустить Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчики.Файлов = Счетчики.Файлов + 1;
		ПроверитьМодульФормыНаДирективы(Файл.ПолноеИмя, ПутьОтносительный, Нарушения, Счетчики);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
// Проверяет один модуль формы; найденные нарушения добавляет в массив Нарушения.
//
// Параметры:
//   Путь - Строка - полный путь к файлу модуля.
//   ПутьОтносительный - Строка - путь для сообщений (относительно корня проекта).
//   Нарушения - Массив - в него добавляются описания найденных нарушений.
//   Счетчики - Структура - счётчики "Файлов" и "Методов" для итогового сообщения.
Процедура ПроверитьМодульФормыНаДирективы(Путь, ПутьОтносительный, Нарушения, Счетчики)
	
	СтрокиФайла = ПрочитатьСтрокиФайлаМодуля(Путь);
	
	// Очищенные строки: без комментариев и содержимого строковых литералов.
	ОчищенныеСтроки = Новый Массив;
	ВЛитерале = Ложь;
	Для Каждого СтрокаФайла Из СтрокиФайла Цикл
		ТекстСтроки = СтрокаФайла;
		Если ВЛитерале Тогда
			// Строка-продолжение многострочного литерала: текст литерала открывает символ "|",
			// а разбор строки продолжается из состояния "внутри литерала".
			ПозицияПродолжения = Найти(ТекстСтроки, "|");
			Если ПозицияПродолжения > 0 Тогда
				ТекстСтроки = Сред(ТекстСтроки, ПозицияПродолжения);
			КонецЕсли;
		КонецЕсли;
		РезультатОчистки = ОчиститьСтрокуМодуля(ТекстСтроки, ВЛитерале);
		ВЛитерале = РезультатОчистки.ВЛитерале;
		ОчищенныеСтроки.Добавить(РезультатОчистки.Текст);
	КонецЦикла;
	
	Для Номер = 0 По ОчищенныеСтроки.Количество() - 1 Цикл
		Если НЕ ЭтоОбъявлениеМетода(ОчищенныеСтроки[Номер]) Тогда
			Продолжить;
		КонецЕсли;
		Счетчики.Методов = Счетчики.Методов + 1;
		
		// Директива - ближайшая значимая строка выше: пустые строки и строки комментариев
		// (после очистки от них остаётся пустая строка) пропускаются.
		ЕстьДиректива = Ложь;
		НомерВыше = Номер - 1;
		Пока НомерВыше >= 0 Цикл
			СтрокаВыше = СокрЛП(ОчищенныеСтроки[НомерВыше]);
			Если СтрокаВыше = "" Тогда
				НомерВыше = НомерВыше - 1;
				Продолжить;
			КонецЕсли;
			ЕстьДиректива = (Лев(СтрокаВыше, 1) = "&");
			Прервать;
		КонецЦикла;
		
		Если НЕ ЕстьДиректива Тогда
			Нарушения.Добавить(ПутьОтносительный + ":" + (Номер + 1) + ": " + СокрЛП(СтрокиФайла[Номер]));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
// Читает файл модуля построчно.
//
// Параметры:
//   Путь - Строка - полный путь к файлу модуля.
//
// Возвращаемое значение:
//   Массив - строки файла (маркер BOM из строк удалён).
Функция ПрочитатьСтрокиФайлаМодуля(Путь)
	
	Строки = Новый Массив;
	Чтение = Новый ЧтениеТекста;
	Чтение.Открыть(Путь, "UTF-8");
	Попытка
		СтрокаТекста = Чтение.ПрочитатьСтроку();
		Пока СтрокаТекста <> Неопределено Цикл
			// BOM снимаем явно: если платформа его не отбросит, директива в первой строке файла
			// не распознается и даст ложное нарушение (в проекте так начинаются 20 модулей).
			Строки.Добавить(СтрЗаменить(СтрокаТекста, Символ(65279), ""));
			СтрокаТекста = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение "Не удалось прочитать файл " + Путь + ": " + ОписаниеОшибки();
	КонецПопытки;
	Чтение.Закрыть();
	
	Возврат Строки;
	
КонецФункции

&НаКлиенте
// Возвращает текст строки модуля, очищенный от комментария и содержимого строковых литералов.
//
// Учитываются удвоенные кавычки ("" - это экранирование кавычки, а не закрытие литерала).
// Состояние "внутри литерала" переносится на следующую строку: у многострочного литерала
// строки-продолжения начинаются с "|", а код после закрывающей кавычки продолжается.
//
// Параметры:
//   СтрокаМодуля - Строка - строка модуля.
//   ВЛитералеНачало - Булево - Истина, если строка является продолжением многострочного литерала.
//
// Возвращаемое значение:
//   Структура - поля:
//     * Текст - Строка - текст строки без комментария и содержимого литералов (код);
//     * ВЛитерале - Булево - Истина, если строка закончилась внутри строкового литерала.
Функция ОчиститьСтрокуМодуля(СтрокаМодуля, ВЛитералеНачало = Ложь)
	
	// Быстрый путь: строка не продолжает литерал, а кавычек и комментария в ней нет - чистить нечего.
	// Таких строк в модулях большинство, и посимвольный разбор для них не нужен.
	Если НЕ ВЛитералеНачало И Найти(СтрокаМодуля, """") = 0 И Найти(СтрокаМодуля, "//") = 0 Тогда
		Возврат Новый Структура("Текст, ВЛитерале", СтрокаМодуля, Ложь);
	КонецЕсли;
	
	Текст = "";
	Позиция = 1;
	ДлинаСтроки = СтрДлина(СтрокаМодуля);
	ВнутриСтроки = ВЛитералеНачало;
	Пока Позиция <= ДлинаСтроки Цикл
		СимволСтроки = Сред(СтрокаМодуля, Позиция, 1);
		СледующийСимвол = "";
		Если Позиция < ДлинаСтроки Тогда
			СледующийСимвол = Сред(СтрокаМодуля, Позиция + 1, 1);
		КонецЕсли;
		
		Если ВнутриСтроки Тогда
			Если СимволСтроки = """" Тогда
				Если СледующийСимвол = """" Тогда
					// Удвоенная кавычка - экранирование внутри литерала, он не закрывается.
					Позиция = Позиция + 2;
					Продолжить;
				КонецЕсли;
				ВнутриСтроки = Ложь; // литерал закрылся, дальше может быть код
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		
		Если СимволСтроки = """" Тогда
			ВнутриСтроки = Истина;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если СимволСтроки = "/" И СледующийСимвол = "/" Тогда
			Прервать; // начало комментария: остаток строки кодом не является
		КонецЕсли;
		
		Текст = Текст + СимволСтроки;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Результат = Новый Структура("Текст, ВЛитерале", Текст, ВнутриСтроки);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
// Определяет, что очищенная строка - объявление процедуры или функции.
//
// Учитываются ключевые слова Процедура/Функция и Procedure/Function. Модификатор асинхронности
// Асинх/Async (в платформе допустимы любые сочетания, например "Асинх Function") снимается
// до разбора. После ключевого слова должны идти имя метода и открывающая скобка, поэтому
// КонецПроцедуры, КонецФункции и строки вида "#Область СлужебныеПроцедурыИФункции" объявлениями
// не считаются.
//
// Параметры:
//   ОчищеннаяСтрока - Строка - строка модуля без комментария и содержимого литералов.
//
// Возвращаемое значение:
//   Булево - Истина, если строка является объявлением метода.
Функция ЭтоОбъявлениеМетода(ОчищеннаяСтрока)
	
	// Табуляция заменяется пробелом, кратные пробелы - одним: "Асинх   Функция" -> "асинх функция".
	СтрокаНРег = НРег(СокрЛП(СтрЗаменить(ОчищеннаяСтрока, Символы.Таб, " ")));
	Пока Найти(СтрокаНРег, "  ") > 0 Цикл
		СтрокаНРег = СтрЗаменить(СтрокаНРег, "  ", " ");
	КонецЦикла;
	
	Если Найти(СтрокаНРег, "асинх ") = 1 Тогда
		СтрокаНРег = Сред(СтрокаНРег, СтрДлина("асинх ") + 1);
	ИначеЕсли Найти(СтрокаНРег, "async ") = 1 Тогда
		СтрокаНРег = Сред(СтрокаНРег, СтрДлина("async ") + 1);
	КонецЕсли;
	
	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("процедура ");
	КлючевыеСлова.Добавить("функция ");
	КлючевыеСлова.Добавить("procedure ");
	КлючевыеСлова.Добавить("function ");
	
	БуквыИПодчеркивание = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя_";
	Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
		Если Найти(СтрокаНРег, КлючевоеСлово) <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(СтрокаНРег, СтрДлина(КлючевоеСлово) + 1);
		// После ключевого слова должно идти имя метода и скобка: это отсекает "конецпроцедуры",
		// "#область служебныепроцедурыифункции" и другие похожие тексты.
		Возврат (Найти(БуквыИПодчеркивание, Лев(Остаток, 1)) > 0) И (Найти(Остаток, "(") > 0);
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
//Дано при проверке директив компиляции в каталоге "ПутьКаталога" найдены методы без директив "ИмяМетода1, ИмяМетода2"
//@ПриПроверкеДирективКомпиляцииВКаталогеНайденыМетодыБезДиректив(Парам01,Парам02)
// Самопроверка парсера на фикстурах: в каталоге должны найтись методы без директив ровно
// с ожидаемыми именами (сравниваются имена методов, а не номера строк: номера строк в фикстурах
// могут меняться при их правке).
//
// Параметры:
//   ПутьКаталога - Строка - путь к каталогу с фикстурами (относительно КаталогИнструментов).
//   ОжидаемыеМетоды - Строка - имена методов без директив через запятую.
Процедура ПриПроверкеДирективКомпиляцииВКаталогеНайденыМетодыБезДиректив(ПутьКаталога, ОжидаемыеМетоды) Экспорт
	
	Нарушения = Новый Массив;
	Счетчики = Новый Структура("Файлов, Методов", 0, 0);
	СобратьНарушенияДирективКомпиляции(Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + ПутьКаталога, Нарушения, Счетчики);
	
	// Защита от опечатки в пути: если фикстуры не найдены, "нарушений нет" означало бы успех.
	Если Счетчики.Файлов = 0 Тогда
		ВызватьИсключение "В каталоге " + ПутьКаталога + " не найдено ни одного модуля формы: проверьте путь к фикстурам.";
	КонецЕсли;
	
	Ожидаемые = Ванесса._СтрРазделить(ОжидаемыеМетоды, ",");
	ОжидаемыхВсего = 0;
	Для Каждого Ожидаемый Из Ожидаемые Цикл
		ИмяОжидаемое = СокрЛП(Ожидаемый);
		Если ИмяОжидаемое = "" Тогда
			Продолжить;
		КонецЕсли;
		ОжидаемыхВсего = ОжидаемыхВсего + 1;
		
		Найдено = Ложь;
		Для Каждого Нарушение Из Нарушения Цикл
			Если ИмяМетодаИзНарушения(Нарушение) = ИмяОжидаемое Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			ВызватьИсключение "В каталоге " + ПутьКаталога + " не найдено нарушение у метода " + ИмяОжидаемое
				+ ". Фактические нарушения: " + Символы.ПС + Ванесса._СтрСоединить(Нарушения, Символы.ПС);
		КонецЕсли;
	КонецЦикла;
	
	// Проверяется и обратное: лишних нарушений быть не должно.
	Если Нарушения.Количество() <> ОжидаемыхВсего Тогда
		ВызватьИсключение "В каталоге " + ПутьКаталога + " найдено нарушений " + Нарушения.Количество()
			+ ", а ожидалось " + ОжидаемыхВсего + ": " + Символы.ПС + Ванесса._СтрСоединить(Нарушения, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
//Дано при проверке директив компиляции в каталоге "ПутьКаталога" не найдено методов без директив
//@ПриПроверкеДирективКомпиляцииВКаталогеНеНайденоМетодовБезДиректив(Парам01)
// Самопроверка парсера на фикстурах: в каталоге не должно быть ни одного метода без директивы.
