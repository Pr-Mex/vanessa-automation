&НаКлиенте
//Дано для каждого элемента формы VA есть урок
//@ДляКаждогоЭлементаФормыVAЕстьУрок()
Функция ДляКаждогоЭлементаФормыVAЕстьУрок() Экспорт
	
	КаталогУроков = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + "training";
	КаталогУроков = Ванесса.ДополнитьСлешВПуть(КаталогУроков) + "features";
	
	Словарь = Новый Соответствие;
	
	Файлы = НайтиФайлы(КаталогУроков, "*.feature", Истина);
	Для Каждого Файл Из Файлы Цикл
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(Файл.ПолноеИмя, "UTF-8");
		ТекстФайла = Текст.Прочитать();
		Текст.Закрыть();
		
		МассивСтрок = Ванесса._СтрРазделить(ТекстФайла, Символы.ПС);
		Для Каждого Стр Из МассивСтрок Цикл
			Стр = СокрЛП(Стр);
			Если Лев(Стр, 1) = "#" Тогда
				Продолжить;
			ИначеЕсли Лев(Стр, 2) = "//" Тогда
				Продолжить;
			КонецЕсли;
			
			Стр = СтрЗаменить(Стр, "|", "");
			Стр = СтрЗаменить(Стр, "'", "");
			Стр = СтрЗаменить(Стр, """", "");
			
			МассивСлов = Ванесса._СтрРазделить(Стр, " ");
			
			Для Каждого Слово Из МассивСлов Цикл
				Словарь.Вставить(Нрег(Слово), Слово);
			КонецЦикла;	 
			
		КонецЦикла;	 
		
	КонецЦикла;
	
	МассивЭлементовБезУроков = Новый Массив;
	
	Для Каждого Элем Из Ванесса.Элементы Цикл
		Если Словарь[НРег(Элем.Имя)] = Неопределено Тогда
			
			Если ТипЗнч(Элем) = Тип("ГруппаФормы") И Элем.Вид = ВидГруппыФормы.КонтекстноеМеню Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ГруппаФормы") И Элем.Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ГруппаФормы") И Элем.Вид = ВидГруппыФормы.ГруппаКнопок Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ГруппаФормы") И Элем.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ГруппаФормы") И Элем.Вид = ВидГруппыФормы.Подменю Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ГруппаФормы") И Элем.Вид = ВидГруппыФормы.КоманднаяПанель Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ДекорацияФормы") И Элем.Вид = ВидДекорацииФормы.Надпись Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ПолеФормы") И Элем.Вид = ВидПоляФормы.ПолеКартинки Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") Тогда
				Продолжить;
			ИначеЕсли ЭтотЭлементЯвляетсяИсключением(Элем, Элем.Имя) Тогда
				Продолжить;
			КонецЕсли;	 
			
			МассивЭлементовБезУроков.Добавить(Элем);
		КонецЕсли;	 
	КонецЦикла;	 
	
	Если МассивЭлементовБезУроков.Количество() > 0 Тогда
		СтрокаИсключения = "";
		
		Спс = Новый СписокЗначений;
		
		Для Каждого Элем Из МассивЭлементовБезУроков Цикл
			Спс.Добавить(Элем, Элем.Имя);
		КонецЦикла;
		Спс.СортироватьПоПредставлению();
		
		Для Каждого Элем Из Спс Цикл
			Тип = ТипЗнч(Элем.Значение);
			Попытка
				Вид = Элем.Значение.Вид;
			Исключение
				Вид = "";
			КонецПопытки;
			СтрокаИсключения = СтрокаИсключения + Элем.Значение.Имя + ", Тип: " + Тип + ", Вид: " + Вид + Символы.ПС;
		КонецЦикла;	 
		
		ВызватьИсключение "По некоторым элементам формы Vanessa Automation нет уроков:" + Символы.ПС + СтрокаИсключения;
	КонецЕсли;	 
	
КонецФункции

