&НаКлиенте
Процедура ПроверитьРезультатОтправки(Знач Недоставленные)

	Если Недоставленные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ошибки = Новый Массив;
	Для Каждого Получатель Из Недоставленные Цикл
		Ошибки.Добавить(Строка(Получатель.Ключ) + ": " + Строка(Получатель.Значение));
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Письмо не доставлено получателям: " + Ванесса._СтрСоединить(Ошибки, "; ");
	КонецЕсли;

КонецПроцедуры

// Повторяет запрос заголовков, пока сервер не вернёт хотя бы одно сообщение по установленному
// отбору: на реальных серверах письма доставляются асинхронно.
&НаКлиенте
Функция ПолучитьЗаголовкиСПовторами()

	ЗаголовкиПисем = Новый Массив;

	КоличествоПопыток = Ванесса.ЗначениеКоличествоПопытокВыполненияДействия();
	Для СчетчикПопыток = 1 По КоличествоПопыток Цикл
		ЗаголовкиПисем = ПолучитьЗаголовки();
		Если ЗаголовкиПисем.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		Если СчетчикПопыток < КоличествоПопыток Тогда
			Ванесса.sleep(1);
		КонецЕсли;
	КонецЦикла;

	Возврат ЗаголовкиПисем;

КонецФункции
