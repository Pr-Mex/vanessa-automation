&НаКлиенте
Процедура ОтфильтроватьПисьмаПоПолю(ИмяПоляЗаголовка, ИскомаяПодстрока)

	ЗаголовкиПисем = Контекст.ЗаголовкиПисем;

	Сч = 0;
	Пока Сч < ЗаголовкиПисем.Количество() Цикл
		ТекЗаголовок = ЗаголовкиПисем.Получить(Сч);

		Если Найти(ТекЗаголовок[ИмяПоляЗаголовка], ИскомаяПодстрока) = 0 Тогда
			ЗаголовкиПисем.Удалить(Сч);
		Иначе
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

