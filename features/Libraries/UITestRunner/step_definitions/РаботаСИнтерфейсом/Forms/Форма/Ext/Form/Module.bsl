		Для Каждого ЭлемОбъектыПанелиРазделов Из ОбъектыПанелиФункций Цикл
			Стр = Стр + Символы.ПС + ЭлемОбъектыПанелиРазделов.ТекстЗаголовка;
		КонецЦикла;	 
		ТекстСообщения = ТекстСообщения + Стр;
		
		ЛишниеЭлементы = Новый Массив;
		НедостающиеЭлементы = Новый Массив;
		
		Попытка
			КешЭталон = Новый Соответствие;
			Для Каждого Элем Из ТабПарам Цикл
				КешЭталон.Вставить(Элем.Кол1, Истина);
			КонецЦикла;
			
			КешТекущееЗначение = Новый Соответствие;
			Для Каждого Элем Из ОбъектыПанелиФункций Цикл
				КешТекущееЗначение.Вставить(Элем.ТекстЗаголовка, Истина);
			КонецЦикла;
			
			Для Каждого Элем Из ОбъектыПанелиФункций Цикл
				Если КешЭталон[Элем.ТекстЗаголовка] = Неопределено Тогда
					ЛишниеЭлементы.Добавить(Элем.ТекстЗаголовка);
				КонецЕсли;	
			КонецЦикла;
			
			Для Каждого Элем Из ТабПарам Цикл
				Если КешТекущееЗначение[Элем.Кол1] = Неопределено Тогда
					НедостающиеЭлементы.Добавить(Элем.Кол1);
				КонецЕсли;	
			КонецЦикла;
		Исключение
			Ванесса.ЗаписатьЛогВЖРОшибка("ПанельФункцийРавна", ОписаниеОшибки());
		КонецПопытки;
		
		Если ЛишниеЭлементы.Количество() > 0 Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС + Ванесса.Локализовать("Лишние элементы:") + Символы.ПС + Ванесса._СтрСоединить(ЛишниеЭлементы, Символы.ПС);
		КонецЕсли;
		
		Если НедостающиеЭлементы.Количество() > 0 Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС + Ванесса.Локализовать("Недостающие элементы:") + Символы.ПС + Ванесса._СтрСоединить(НедостающиеЭлементы, Символы.ПС);
		КонецЕсли;	
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	 
	
	Ном = -1;
	Для Каждого СтрокаТабПарам Из ТабПарам Цикл
		Ном = Ном + 1;
		ОбъектПанелиРазделов = ОбъектыПанелиФункций[Ном];
		
		Если НРег(СтрокаТабПарам.Кол1) <> НРег(ОбъектПанелиРазделов.ТекстЗаголовка) Тогда
			ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Ожидалось, что в панели функций будет элемент <%1> , а был найден элемент <%2>.");
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",СтрокаТабПарам.Кол1);
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",ОбъектПанелиРазделов.ТекстЗаголовка);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;	 
	КонецЦикла;	 
КонецФункции

