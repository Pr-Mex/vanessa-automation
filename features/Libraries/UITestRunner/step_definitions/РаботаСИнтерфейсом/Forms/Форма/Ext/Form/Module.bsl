				СтрокаПредставлениеСпискаВыбора = ПредставлениеСпискаВыбора[НомСтр];
				
				Если НРег(СокрЛП(СтрокаТабПарам.Кол1)) <> НРег(СокрЛП(СтрокаПредставлениеСпискаВыбора.ОтображаемыйТекст)) Тогда
