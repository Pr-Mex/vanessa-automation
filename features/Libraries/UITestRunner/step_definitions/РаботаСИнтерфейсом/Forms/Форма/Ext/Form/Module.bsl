				КонецЕсли;	 
				
			КонецЦикла;	
			
			Если МассивРазличий.Количество() > 0 Тогда
				ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Открытый список выбора <%1> не равен эталону. Различия: %2");
