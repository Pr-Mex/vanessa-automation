Функция ДополнитьРазделительПути(Знач Путь)
	Если Прав(Путь,1) = "\" или Прав(Путь,1) = "/" Тогда
		Возврат Лев(Путь,СтрДлина(Путь)-1);
	КонецЕсли;	 
	
	Возврат Путь;
