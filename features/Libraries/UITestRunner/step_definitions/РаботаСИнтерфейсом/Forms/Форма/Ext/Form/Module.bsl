		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",ИмяКнопки); 
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	 
	
	КнопкаКомандногоИнтерфейса.Нажать();
	Ванесса.ОбработатьСменуАктивногоОкна();
