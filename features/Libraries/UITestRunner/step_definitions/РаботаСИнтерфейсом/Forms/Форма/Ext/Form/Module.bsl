	Нашли = Ложь;
	МассивФорм = Ванесса.НайтиКонтейнерыТекущегоОкнаTestClient();
	Для каждого ТекущаяФорма Из МассивФорм Цикл
		
		Если ИскатьПоИмени Тогда
			МассивЭлементов = ТекущаяФорма.НайтиОбъекты(, , ИмяПоля);
