		Ванесса.ОпределитьРежимПоискаЭлементаНаФорме(ИмяЭлемента,ИскатьЭлементПоИмени);
		
		Если ИскатьЭлементПоИмени Тогда
			ЭлементПоИмени = ИменаЭлементов[ИмяЭлемента];
		Иначе	
			ЭлементПоИмени = ЗаголовкиЭлементов[ИмяЭлемента];
