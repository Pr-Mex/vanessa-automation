&НаКлиенте
//И Я устанавливаю метке 'Метка' значение 'Значение'
//@ЯУстанавливаюМеткеЗначение(Парам01, Парам02)
Функция ЯУстанавливаюМеткеЗначение(Метка, Значение) Экспорт
	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaBehavior();
	
	РезультатПрохожденияТестовВСценарии = СостояниеVanessaAutomation["ТекущийСценарий"].РезультатПрохожденияТестовСценария;
	Если НЕ РезультатПрохожденияТестовВСценарии.Свойство("СписокМеток") Тогда
		РезультатПрохожденияТестовВСценарии.Вставить("СписокМеток", Новый СписокЗначений);
	КонецЕсли;
	
	РезультатПрохожденияТестовВСценарии["СписокМеток"].Добавить(Метка, Значение);
	
КонецФункции

&НаКлиенте
//И я устанавливаю описание сценария для отчета Allure "Описание"
//@ЯУстанавливаюОписаниеСценарияДляОтчетаAllure(Парам01)
Функция ЯУстанавливаюОписаниеСценарияДляОтчетаAllure(Описание) Экспорт
	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaBehavior();
	
	РезультатПрохожденияТестовВСценарии = СостояниеVanessaAutomation["ТекущийСценарий"].РезультатПрохожденияТестовСценария;
	РезультатПрохожденияТестовВСценарии.Вставить("ОписаниеСценарияAllure", Описание);
КонецФункции

&НаКлиенте
// И я добавляю параметр "ИмяБазы" со значением "Значание" в отчёт Allure
//@ЯДобавляюПараметрСоЗначениемВОтчётAllure(Парам01, Парам02)
Функция ЯДобавляюПараметрСоЗначениемВОтчётAllure(ИмяПараметра, ЗначениеПараметра) Экспорт
	
	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaBehavior();
	
	РезультатПрохожденияТестовВСценарии = СостояниеVanessaAutomation["ТекущийСценарий"].РезультатПрохожденияТестовСценария;
	
	Если НЕ РезультатПрохожденияТестовВСценарии.Свойство("СписокПараметров") Тогда
		РезультатПрохожденияТестовВСценарии.Вставить("СписокПараметров", Новый Массив);
	КонецЕсли;
	
	Параметр = Новый Структура("name, value", ИмяПараметра, ЗначениеПараметра);
	РезультатПрохожденияТестовВСценарии.СписокПараметров.Добавить(Параметр);
	
КонецФункции

&НаКлиенте
//И я добавляю список параметров для отчёта Allure
//@ЯДобавляюСписокПараметровДляОтчётаAllure(ТабПарам)
Функция ЯДобавляюСписокПараметровДляОтчётаAllure(ТабПарам) Экспорт  
	
	Если ТабПарам = Неопределено ИЛИ ТипЗнч(ТабПарам) <> Тип("Массив") Тогда
		ВызватьИсключение "Ожидался массив структур";
	КонецЕсли;

	// Пропускаем первую строку (заголовки)!
	Если ТабПарам.Количество() < 2 Тогда
		ВызватьИсключение "Недостаточно строк: ожидалась хотя бы одна строка данных";
	КонецЕсли;

	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaBehavior();
	РезультатПрохожденияТестовВСценарии = СостояниеVanessaAutomation["ТекущийСценарий"].РезультатПрохожденияТестовСценария;
	
	Если НЕ РезультатПрохожденияТестовВСценарии.Свойство("СписокПараметров") Тогда
		РезультатПрохожденияТестовВСценарии.Вставить("СписокПараметров", Новый Массив);
	КонецЕсли;

	// Обрабатываем со второй строки (индекс 1)
	Для Индекс = 1 По ТабПарам.ВГраница() Цикл
		СтрокаТаблицы = ТабПарам[Индекс];
		
		ИмяПараметра = Неопределено;
		ЗначениеПараметра = Неопределено;
		
		// Попытка 1: по именам полей (если Vanessa сохранила заголовки как ключи)
		Для Каждого Поле Из СтрокаТаблицы Цикл
			ИмяКолонки = СокрЛП(СтрЗаменить(Поле.Ключ, "'", ""));
			Если ИмяКолонки = "ИмяПараметра" Тогда
				ИмяПараметра = СокрЛП(СтрЗаменить(Поле.Значение, "'", ""));
			ИначеЕсли ИмяКолонки = "ЗначениеПараметра" Тогда
				ЗначениеПараметра = СокрЛП(СтрЗаменить(Поле.Значение, "'", ""));
			КонецЕсли;
		КонецЦикла;
		
		// Попытка 2: по позиции (Кол1, Кол2)
		Если ИмяПараметра = Неопределено ИЛИ ЗначениеПараметра = Неопределено Тогда
			ИмяПараметра = СокрЛП(СтрЗаменить(СтрокаТаблицы["Кол1"], "'", ""));
			ЗначениеПараметра = СокрЛП(СтрЗаменить(СтрокаТаблицы["Кол2"], "'", ""));
		КонецЕсли;
		
		Параметр = Новый Структура("name, value", ИмяПараметра, ЗначениеПараметра);
		РезультатПрохожденияТестовВСценарии.СписокПараметров.Добавить(Параметр);
		
	КонецЦикла;

	Возврат Истина;
	
КонецФункции
