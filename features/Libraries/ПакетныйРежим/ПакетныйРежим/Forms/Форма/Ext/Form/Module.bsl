&НаКлиенте
Функция ПутьКФайлу1cv8()
	
	КаталогПрограммы = КаталогПрограммы();
	Если Ванесса.ЭтоLinux Тогда
		ИмяФайла = Ванесса.ДополнитьСлешВПуть(КаталогПрограммы) + "1cv8";
	Иначе	
		ИмяФайла = Ванесса.ДополнитьСлешВПуть(КаталогПрограммы) + "1cv8.exe";
	КонецЕсли;	 
	
	Возврат ИмяФайла; 
	
КонецФункции	 

&НаКлиенте
//Затем я создаю пустую базу 'File=ПутьККаталогу'
//@ЯСоздаюПустуюБазу(Парам01)
Функция ЯСоздаюПустуюБазу(ПараметрыСозданияБазы) Экспорт
	ПутьКФайлу1cv8 = ПутьКФайлу1cv8();
	ФайлВывода = ПолучитьИмяВременногоФайла("txt");
	
	Команда = """" + ПутьКФайлу1cv8 + """ CreateInfoBase " + ПараметрыСозданияБазы + " /out """ + ФайлВывода + """";
	Статус = Ванесса.ВыполнитьКомандуОСБезПоказаЧерногоОкна(Команда);
	Если Статус <> 0 Тогда
		ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Не получилось создать базу по строке: %1. Статус возврата: %2");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",ПараметрыСозданияБазы); 
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",Статус); 
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Ванесса.ЗаписатьЛогВЖРИнформация("ЯСоздаюПустуюБазу", Команда);
	ЛогКоманды = ПрочитатьЛогКоманды(ФайлВывода);
	Если ЗначениеЗаполнено(ЛогКоманды) Тогда
		Ванесса.ЗаписатьЛогВЖРИнформация("ЯСоздаюПустуюБазу", ЛогКоманды);
	КонецЕсли;	
	
	Если Ванесса.ЭтоОшибкаПакетногоЗапускаКонфигуратора(ЛогКоманды) Тогда
		ВызватьИсключение Ванесса.Локализовать("Не получилось создать пустую базу.") + Символы.ПС + ЛогКоманды;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
//Затем я загружаю базу 'СтрокаСоединения' из DT "ПутьКDT"
//@ЯЗагружаюБазуИзDT(Парам01,Парам02)
Функция ЯЗагружаюБазуИзDT(СтрокаСоединения,ПутьКDT) Экспорт
	ПутьКФайлу1cv8 = ПутьКФайлу1cv8();
	ФайлВывода = ПолучитьИмяВременногоФайла("txt");
	
	Команда = """" + ПутьКФайлу1cv8 + """ DESIGNER " + СтрокаСоединения + " /RestoreIB """ + ПутьКDT + """" + " /out """ + ФайлВывода + """";
	Ванесса.Отладка(Команда);
	Статус = Ванесса.ВыполнитьКомандуОСБезПоказаЧерногоОкна(Команда);
	Если Статус <> 0 Тогда
		ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Не получилось загрузить базу из dt: %1. ПутьКDT: %2. Статус возврата: %3");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",СтрокаСоединения); 
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",ПутьКDT); 
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%3",Статус); 
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Ванесса.ЗаписатьЛогВЖРИнформация("ЯЗагружаюБазуИзDT", Команда);
	ЛогКоманды = ПрочитатьЛогКоманды(ФайлВывода);
	Если ЗначениеЗаполнено(ЛогКоманды) Тогда
		Ванесса.ЗаписатьЛогВЖРИнформация("ЯЗагружаюБазуИзDT", ЛогКоманды);
	КонецЕсли;	
	
	Если Ванесса.ЭтоОшибкаПакетногоЗапускаКонфигуратора(ЛогКоманды) Тогда
		ВызватьИсключение Ванесса.Локализовать("Не получилось загрузить базу из DT.") + Символы.ПС + ЛогКоманды;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
//Затем я выгружаю базу 'СтрокаСоединения' в DT "ПутьКDT"
//@ЯВыгружаюБазуВDT(Парам01,Парам02)
Функция ЯВыгружаюБазуВDT(СтрокаСоединения,ПутьКDT) Экспорт
	ПутьКФайлу1cv8 = ПутьКФайлу1cv8();
	ФайлВывода = ПолучитьИмяВременногоФайла("txt");
	
	Команда = """" + ПутьКФайлу1cv8 + """ DESIGNER " + СтрокаСоединения + " /DumpIB """ + ПутьКDT + """" + " /out """ + ФайлВывода + """";
	Статус = Ванесса.ВыполнитьКомандуОСБезПоказаЧерногоОкна(Команда);
	Если Статус <> 0 Тогда
		ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Не получилось выгрузить базу в dt: <%1>. Путь к DT: <%2>. Статус возврата: <%3>.");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",СтрокаСоединения); 
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",ПутьКDT); 
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%3",Статус); 
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Ванесса.ЗаписатьЛогВЖРИнформация("ЯВыгружаюБазуВDT", Команда);
	ЛогКоманды = ПрочитатьЛогКоманды(ФайлВывода);
	Если ЗначениеЗаполнено(ЛогКоманды) Тогда
		Ванесса.ЗаписатьЛогВЖРИнформация("ЯВыгружаюБазуВDT", ЛогКоманды);
	КонецЕсли;
	
	Если Ванесса.ЭтоОшибкаПакетногоЗапускаКонфигуратора(ЛогКоманды) Тогда
		ВызватьИсключение Ванесса.Локализовать("Не получилось выгрузить базу в DT.") + Символы.ПС + ЛогКоманды;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьЛогКоманды(ФайлВывода)
	
	Если Ванесса.ФайлСуществуетКомандаСистемы(ФайлВывода) Тогда
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ФайлВывода, "UTF-8");
		ТекстФайла = Текст.Прочитать();
		Текст.Закрыть();
		Возврат ТекстФайла;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции