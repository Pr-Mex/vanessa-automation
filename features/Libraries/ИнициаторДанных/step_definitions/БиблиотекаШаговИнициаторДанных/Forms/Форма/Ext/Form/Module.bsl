Функция ОШ_ЯНахожуИлиСоздаюОбъектСИменем()
		
	Результат = НовоеОписаниеШага();
	Результат.Снипет = "ЯНахожуИлиСоздаюОбъектСИменем(ИмяМенеджера, ИмяПеременной)";
	Результат.ИмяПроцедуры = "ЯНахожуИлиСоздаюОбъектСИменем";
	Результат.ПредставлениеТеста = "И я нахожу или создаю объект ""КлассМнч.Вид"" с именем ""ИмяПеременной""";
	Результат.ОписаниеШага = "### Описание
	|Создание ссылочного объекта. " + ЧастьОписанияШагаОбъекта() + Символы.ПС + "
	|Основной шаг инициатора данных. Данные создаются **программно**, минуя интерфейс: не нужно открывать форму, заполнять поля и ждать записи. Так готовят окружение для проверки — контрагентов, номенклатуру, организации, — а интерфейс проверяют уже там, где он и есть предмет теста.
	|Слово «нахожу или создаю» означает идемпотентность: при повторном запуске объект не задваивается, потому что УИД считается по имени фичи, имени менеджера и имени переменной. Второй прогон сценария найдёт то, что создал первый.
	|Имя переменной становится указателем на ссылку: его подставляют в другие шаги инициатора вместо значения.
	|### Пример. Создать контрагента и заполнить его реквизиты
	|```Gherkin
	|	И я нахожу или создаю группу объекта 'Справочники.Контрагенты' с именем 'ГруппаКонтрагентов'
	|	И я нахожу или создаю объект 'Справочники.Контрагенты' с именем 'Контрагент'
	|	И я заполняю реквизиты объекта 'Контрагент' по таблице:
	|		| Имя       | Значение           |
	|		| Родитель  | ГруппаКонтрагентов |
	|		| ЮрФизЛицо | ЮридическоеЛицо    |
	|```
	|";
	
	УстановитьТипШага(Результат, "Создание объектов");
	
	Возврат Результат;
	
