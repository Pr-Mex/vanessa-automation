Функция ПредставлениеРеквизитов(ЗначенияРеквизитов, Разделитель = "; ")
	
	ТекстРеквизиты = Новый Массив;
	
	Для Каждого Значение Из ЗначенияРеквизитов Цикл 
		
		Текст = "%1 = '%2'";
