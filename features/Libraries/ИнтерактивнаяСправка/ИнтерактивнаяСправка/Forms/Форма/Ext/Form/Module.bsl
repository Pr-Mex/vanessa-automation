&НаКлиенте
Функция ПолучитьТекстДиктораВышеУказаннойСтрокиФичи(НомерСтроки, ИмяФайла)
	
	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ИмяФайла, "UTF-8");
	ТекстФайла = Текст.Прочитать();
	Текст.Закрыть();
	
	МассивСтрок = Ванесса._СтрРазделить(ТекстФайла, Символы.ПС);
	Попытка
		НомСтр = НомерСтроки - 1;
		Пока Истина Цикл
			ТекСтр = СокрЛП(МассивСтрок[НомСтр]);
			Если Лев(ТекСтр, 1) = "*" Тогда
				Возврат ТекСтр;
			КонецЕсли;
			
			НомСтр = НомСтр - 1;
			Если НомСтр < 0 Тогда
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;	
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции	

&НаКлиенте
Функция НайтиТекстДиктораВТекстеФичи(ТекстФичи, ТекстДиктора)
	
	МассивСтрок = Ванесса._СтрРазделить(ТекстФичи, Символы.ПС);
	Для Сч = 0 По МассивСтрок.Количество()-1 Цикл
		ТекСтр = МассивСтрок[Сч];
		Если Найти(ТекСтр, ТекстДиктора) > 0 Тогда
			Возврат Сч + 1;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции	

&НаКлиенте
//И я делаю подсветку текста данного шага в сеансе VA в режиме обучения
//@ЯДелаюПодсветкуТекстаДанногоШагаВСеансеVAВРежимеОбучения()
Функция ЯДелаюПодсветкуТекстаДанногоШагаВСеансеVAВРежимеОбучения() Экспорт
	
	СостояниеVA = Ванесса.ПолучитьСостояниеVanessaAutomation();
	
	НомерСтрокиФичи = СостояниеVA.ТекущийШаг.НомерСтрокиФичи;
	ТекстДиктора = ПолучитьТекстДиктораВышеУказаннойСтрокиФичи(НомерСтрокиФичи, СостояниеVA.ТекущаяФича.ПолныйПуть);
	
	ЭкземплярVanessaEditor = КонтекстСохраняемый.ФормаVAВРежимеОбучения.ПолучитьVanessaEditor();
	
	ТекстФичи = СокрЛП(ЭкземплярVanessaEditor.getContent());
	МассивСтрок = Ванесса._СтрРазделить(ТекстФичи, Символы.ПС);
	КолСтрок = МассивСтрок.Количество();
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("startLineNumber", КолСтрок + 1);
	Соответствие.Вставить("startColumn", 1);
	Соответствие.Вставить("endLineNumber", КолСтрок + 1);
	Соответствие.Вставить("endColumn", 1);
	
	Если НЕ ЗначениеЗаполнено(ТекстФичи) Тогда
		ЭкземплярVanessaEditor.insertText(ТекстДиктора, Ванесса.ЗаписатьОбъектJSON(Соответствие));
	Иначе	
		ЭкземплярVanessaEditor.insertText(Символы.ПС + ТекстДиктора, Ванесса.ЗаписатьОбъектJSON(Соответствие));
	КонецЕсли;	
	
	ТекстФичи = СокрЛП(ЭкземплярVanessaEditor.getContent());
	
	НомерСтроки = НайтиТекстДиктораВТекстеФичи(ТекстФичи, ТекстДиктора);
	Если НомерСтроки <> Неопределено Тогда
		ТекстДиктора = СокрЛП(ТекстДиктора);
		Если Лев(ТекстДиктора, 1) = "*" Тогда
			ТекстДиктора = СокрЛП(Сред(ТекстДиктора, 2));
		КонецЕсли;	
		ТекстШага = "И я делаю подсветку текста в редакторе VA в режиме обучения в строке '%1' '%2'";
		ТекстШага = Ванесса.ПодставитьПараметрыВСтроку(ТекстШага, НомерСтроки,ТекстДиктора);
		Ванесса.Шаг(ТекстШага);
		Ванесса.sleep(4);
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Функция ТекстДиктораТекущегоШагаВыполняемогоУрока()

	СостояниеVA = Ванесса.ПолучитьСостояниеVanessaAutomation();
	
	Если ЗначениеЗаполнено(СостояниеVA.ТекущийШаг.СтрокаШагаПодсценарияФичи) Тогда
		НомерСтрокиФичи = СостояниеVA.ТекущийШаг.СтрокаШагаПодсценарияФичи;
		СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтрокиФичи);
		СтрокаДерева = СтрокаДерева.ПолучитьРодителя();
		ТекстДиктора = СтрокаДерева.Имя;
	Иначе	
		НомерСтрокиФичи = СостояниеVA.ТекущийШаг.НомерСтрокиФичи;
		ТекстДиктора = ПолучитьТекстДиктораВышеУказаннойСтрокиФичи(НомерСтрокиФичи, СостояниеVA.ТекущаяФича.ПолныйПуть);
	КонецЕсли;
	
	ТекстДиктора = СтрЗаменить(ТекстДиктора, "^", "");
	
	Возврат ТекстДиктора;
	
КонецФункции	

&НаКлиенте
//И я добавляю строку с текстом текущего шага в текущее окно редактора VA в режиме обучения
//@ЯДобавляюСтрокуСТекстомТекущегоШагаВТекущееОкноРедактораVAВРежимеОбучения()
Функция ЯДобавляюСтрокуСТекстомТекущегоШагаВТекущееОкноРедактораVAВРежимеОбучения() Экспорт
	
	ТекстДиктора = ТекстДиктораТекущегоШагаВыполняемогоУрока();
	
	КонтекстСохраняемый.ФормаVAВРежимеОбучения.VanessaTabs.showMinimap = Ложь;
	ЭкземплярVanessaEditor = КонтекстСохраняемый.ФормаVAВРежимеОбучения.ПолучитьVanessaEditor();
	
	ТекстФичи = СокрЛП(ЭкземплярVanessaEditor.getContent());
	МассивСтрок = Ванесса._СтрРазделить(ТекстФичи, Символы.ПС);
	КолСтрок = МассивСтрок.Количество();
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("startLineNumber", КолСтрок + 1);
	Соответствие.Вставить("startColumn", 1);
	Соответствие.Вставить("endLineNumber", КолСтрок + 1);
	Соответствие.Вставить("endColumn", 1);
	
	Если НЕ ЗначениеЗаполнено(ТекстФичи) Тогда
		ЭкземплярVanessaEditor.insertText(ТекстДиктора, Ванесса.ЗаписатьОбъектJSON(Соответствие));
	Иначе	
		ЭкземплярVanessaEditor.insertText(Символы.ПС + ТекстДиктора, Ванесса.ЗаписатьОбъектJSON(Соответствие));
	КонецЕсли;
	
КонецФункции

