Функция ЯДелаюПодсветкуТекстаДанногоШагаВРедактореVAВРежимеОбучения() Экспорт
	
	ТекстДиктора = ТекстДиктораТекущегоШагаВыполняемогоУрока();
	
	ЭкземплярVanessaEditor = КонтекстСохраняемый.ФормаVAВРежимеОбучения.ПолучитьVanessaEditor();
	ТекстФичи = СокрЛП(ЭкземплярVanessaEditor.getContent());
	
	НомерСтроки = НайтиТекстДиктораВТекстеФичи(ТекстФичи, ТекстДиктора);
	Если НомерСтроки <> Неопределено Тогда
		ТекстДиктора = СокрЛП(ТекстДиктора);
		Если Лев(ТекстДиктора, 1) = "*" Тогда
			ТекстДиктора = СокрЛП(Сред(ТекстДиктора, 2));
		КонецЕсли;	
		//ТекстШага = "И я делаю подсветку текста в редакторе VA в режиме обучения в строке '%1' '%2'";
		//ТекстШага = Ванесса.ПодставитьПараметрыВСтроку(ТекстШага, НомерСтроки, ТекстДиктора);
		//Ванесса.Шаг(ТекстШага);
		//Ванесса.sleep(4);
		
		Ванесса.ЯДелаюПодсветкуТекстаВРедактореVAВРежимеОбученияВСтроке(НомерСтроки, ТекстДиктора);
	КонецЕсли;
	
КонецФункции
