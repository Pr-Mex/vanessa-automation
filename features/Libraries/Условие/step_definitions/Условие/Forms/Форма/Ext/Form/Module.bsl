&НаКлиенте
//Если текущее окно имеет заголовок "ИмяОкна" Тогда
//@ТекущееОкноИмеетЗаголовокТогда(Парам01)
Функция ТекущееОкноИмеетЗаголовокТогда(ЗаголовокОкна,ЧастьИмени2 = Неопределено
	                           ,ЧастьИмени3 = Неопределено
	                           ,ЧастьИмени4 = Неопределено
	                           ,ЧастьИмени5 = Неопределено
	                           ,ЧастьИмени6 = Неопределено
	                           ,ЧастьИмени7 = Неопределено) Экспорт
							   
							   
	НужноеОкно = Неопределено;							   
	ТекущееОкно = Неопределено;
	
	Если ТипЗнч(ЗаголовокОкна) = Тип("Массив") Тогда
		
		Для Каждого Элем Из ЗаголовокОкна Цикл
			ТекЗаголовок = Элем.Кол1;
			НужноеОкно  = Ванесса.НайтиОкноTestClientПоЗаголовку(ТекЗаголовок);
			ТекущееОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
			Если НужноеОкно <> Неопределено И ТекущееОкно <> Неопределено И НужноеОкно.Заголовок = ТекущееОкно.Заголовок Тогда
				Ванесса.ЗаписатьЛогВЖРИнформация("ТекущееОкно", ТекущееОкно.Заголовок);
				Прервать;
			КонецЕсли;	 
		КонецЦикла;
		
								   
	Иначе							   
		Ванесса.СоединитьСтрокиЕслиЭтоВозможно(ЗаголовокОкна,ЧастьИмени2,
		                                       ЧастьИмени3,
		                                       ЧастьИмени4,
		                                       ЧастьИмени5,
		                                       ЧастьИмени6,
		                                       ЧастьИмени7);							   
								   
								   
		НужноеОкно  = Ванесса.НайтиОкноTestClientПоЗаголовку(ЗаголовокОкна);
		ТекущееОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Если ТекущееОкно <> Неопределено Тогда
			Ванесса.ЗаписатьЛогВЖРИнформация("ТекущееОкно", ТекущееОкно.Заголовок);
		КонецЕсли;	 
	КонецЕсли;	
	
	Ванесса.ОбработатьСменуАктивногоОкна();
	
	Если НужноеОкно <> Неопределено И ТекущееОкно <> Неопределено И НужноеОкно.Заголовок = ТекущееОкно.Заголовок Тогда
		Ванесса.УстановитьРезультатУсловия(Истина);
	Иначе
		Ванесса.УстановитьРезультатУсловия(Ложь);
	КонецЕсли;
	
КонецФункции

