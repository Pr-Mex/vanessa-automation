	ДатаНачалаОбработкиОжидания       = ТекущаяДата();
	ИмяОкнаОбработкаОжидания          = ЗаголовокОкна;
	//для этого шага таймаут берём тот, что указан в шаге
	КоличествоСекундОбработкаОжидания = КоличествоСекунд;
	ПодключитьОбработчикОжидания("ОбработчикОжиданияПоявилосьОкноСЗаголовкомВТечениеСекундТогда",1,Ложь);
КонецФункции


&НаКлиенте
Процедура ВТаблицеПолеЗаполненоСлужебный(ИмяТЧ,ИмяПоля,ИскатьПоИмени,ПроверятьЗаполненность, ПроверятьУсловие)
	
	ТЧ = Ванесса.НайтиТЧПоИмени(ИмяТЧ);
	
	ПредставлениеДанных = ПредставлениеДанныхПоляТаблицы(ТЧ, ИмяТЧ, ИмяПоля, ИскатьПоИмени);
	
	Если ПредставлениеДанных = Неопределено Тогда
		ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("В таблице <%1> не найдено ячейки с заголовком <%2>");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",ИмяТЧ);
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",ИмяПоля);
		Ванесса.ДополнитьОшибку_НетПоляТаблицыMCP(ТЧ, ТекстСообщения);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Если ПроверятьУсловие Тогда
		Если ПроверятьЗаполненность Тогда
			Ванесса.УстановитьРезультатУсловия(ЗначениеЗаполнено(ПредставлениеДанных));
		Иначе	
			Ванесса.УстановитьРезультатУсловия(НЕ ЗначениеЗаполнено(ПредставлениеДанных));
		КонецЕсли;
	Иначе
		Если ПроверятьЗаполненность И НЕ ЗначениеЗаполнено(ПредставлениеДанных) Тогда
			ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Ожидалось, что в таблице <%1> поле <%2> будет заполнена");
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",ИмяТЧ);
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",ИмяПоля);
			ВызватьИсключение ТекстСообщения;
		ИначеЕсли НЕ ПроверятьЗаполненность И ЗначениеЗаполнено(ПредставлениеДанных) Тогда	
			ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Ожидалось, что в таблице <%1> поле <%2> будет не заполнена");
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",ИмяТЧ);
			ТекстСообщения = СтрЗаменить(ТекстСообщения,"%2",ИмяПоля);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры


