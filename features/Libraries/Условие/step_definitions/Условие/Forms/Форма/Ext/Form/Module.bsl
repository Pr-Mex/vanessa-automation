//Если существует переменная "ИмяПеременной" Тогда
//@СуществуетПеременнаяТогда(Парам01)
Функция СуществуетПеременнаяТогда(ИмяПеременной, ПроверятьСуществование = Истина) Экспорт
	
	Результат = Ложь;
	
	Попытка
		Если Контекст.Свойство(ИмяПеременной) ИЛИ КонтекстСохраняемый.Свойство(ИмяПеременной) Тогда
			Результат = Истина;
		КонецЕсли;	 
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	Если НЕ Результат Тогда
		Попытка
			ЗначениеПараметра = Ванесса.ЗначениеПараметраТекущегоСценария(0);
			Если Контекст.Свойство(ЗначениеПараметра) ИЛИ КонтекстСохраняемый.Свойство(ЗначениеПараметра) Тогда
				Результат = Истина;
			КонецЕсли;	 
		Исключение
			Результат = Ложь;
		КонецПопытки;
		
	КонецЕсли;	
	
	Если ПроверятьСуществование Тогда
		Ванесса.УстановитьРезультатУсловия(Результат);
	Иначе	
		Ванесса.УстановитьРезультатУсловия(НЕ Результат);
	КонецЕсли;
	
КонецФункции

