		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	 
	
	ПодключитьTestClientИзТаблицыКлиентовТестирования(ДанныеЗапускаКлиентаТестирования.Имя);
	
	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		// Если компонента используется, то при запуске клиента тестирования будет выполнена активизация основного окна и там будет использоваться Ванесса.ЗапретитьВыполнениеШагов();
		Ванесса.ЗапретитьВыполнениеШагов();
		ПодключитьОбработчикОжидания("ОбработчикЯПодключаюПрофильTestClient",0.1,Истина);
	КонецЕсли;
	
