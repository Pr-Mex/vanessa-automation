&НаКлиенте
//И я активизирую процесс "PID"
//@ЯАктивизируюПроцесс(Парам01)
Функция ЯАктивизируюПроцесс(PID, ДопПараметры = Неопределено) Экспорт
	
	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ВызватьИсключение Ванесса.Локализовать("Необходимо включить использование внешней компоненты VanessaExt.");
	КонецЕсли;
	
	Если ТипЗнч(PID) = Тип("Число") Тогда
		PIDЧисло = PID;
	Иначе	
		PIDЧисло = Число(XMLСтрока(PID));
	КонецЕсли;	
	
	НадоЗапретитьВыполнениеШагов = Истина;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("НадоЗапретитьВыполнениеШагов") Тогда
		НадоЗапретитьВыполнениеШагов = ДопПараметры.НадоЗапретитьВыполнениеШагов;
	КонецЕсли;	
	
	Если НадоЗапретитьВыполнениеШагов Тогда
		Ванесса.ЗапретитьВыполнениеШагов();
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("PID", PID);
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПослеПолучитьСписокОкон", ЭтаФорма, ДопПараметры);
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокОкон(ОписаниеОповещения, PIDЧисло);
	
КонецФункции

&НаКлиенте
Функция ОбработкаАктивироватьОкно(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
	Ванесса.ПродолжитьВыполнениеШагов();
КонецФункции

&НаКлиенте
Функция ОбработкаПослеПолучитьСписокОкон(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
	ДанныеОкон = Ванесса.ПрочитатьСтрокуJSON(РезультатВызова);
	
	ИДОкна = Неопределено;
	
	Если ТипЗнч(ДанныеОкон) = Тип("Массив") Тогда
		Для каждого ДанныеОкна из ДанныеОкон Цикл
			Если ДанныеОкна.Свойство("Owner") И ДанныеОкна.Owner = 0 Тогда
				ИДОкна = ДанныеОкна.Window;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	
	Если ИДОкна <> Неопределено Тогда
		Оповещение = Новый ОписаниеОповещения("ОбработкаАктивироватьОкно", ЭтаФорма, Неопределено);
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовАктивироватьОкно(Оповещение, ИДОкна); 
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось активизировать окно с PID <%1>."), ДополнительныеПараметры.PID);
		Ванесса.ПродолжитьВыполнениеШагов(Истина, ТекстИсключения);
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
//И я активизирую процесс по заголовку "Заголовок"
//@ЯАктивизируюПроцессПоЗаголовку(Парам01)
Функция ЯАктивизируюПроцессПоЗаголовку(ПараметрЗаголовок) Экспорт
	
	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ВызватьИсключение Ванесса.Локализовать("Необходимо включить использование внешней компоненты VanessaExt.");
	КонецЕсли;	 
	
	Ванесса.ЗапретитьВыполнениеШагов();
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ПараметрЗаголовок", ПараметрЗаголовок);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученСписокОконОСДляАктивизацииПоЗаголовку", ЭтаФорма, ДопПараметры);
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьПолучениеСписокОкон(ОписаниеОповещения);
	
КонецФункции

&НаКлиенте
Процедура ПолученСписокОконОСДляАктивизацииПоЗаголовку(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрЗаголовок = ДополнительныеПараметры.ПараметрЗаголовок;
	
	ПроцессНайден = Ложь;
	PID = Неопределено;
	Данные = Ванесса.ПрочитатьСтрокуJSON(Результат);
	Для Каждого ДанныеПроцесса Из Данные Цикл
		Если НЕ ДанныеПроцесса.Свойство("Title") Тогда
			Продолжить;
		КонецЕсли;	 
		
		Если НЕ ЗначениеЗаполнено(ДанныеПроцесса.Title) Тогда
			Продолжить;
		КонецЕсли;	 
		
		Если Ванесса.СтрокаСоответствуетШаблону(ДанныеПроцесса.Title, ПараметрЗаголовок) Тогда
			ПроцессНайден = Истина;
			PID = ДанныеПроцесса.ProcessId;
			Прервать;
		КонецЕсли;	 
		
	КонецЦикла;	 
	
	Если НЕ ПроцессНайден Тогда
		ТекстСообщения = Ванесса.Локализовать("Не удалось найти процесс по заголовку окна <%1>.");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", ПараметрЗаголовок);
		Ванесса.ПродолжитьВыполнениеШагов(Истина, ТекстСообщения);
		Возврат;
	КонецЕсли;	 
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("НадоЗапретитьВыполнениеШагов", Ложь);
	ЯАктивизируюПроцесс(PID, ДопПараметры);
		
КонецПроцедуры
