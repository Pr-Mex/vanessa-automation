	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaAutomation();
	
	Значение = Неопределено;
	Если СостояниеVanessaAutomation.ТекущийСценарий.Свойство("МассивТегов")
		И ТипЗнч(СостояниеVanessaAutomation.ТекущийСценарий.МассивТегов) = Тип("Массив") Тогда
			Значение = ЗначениеИзМассиваТегов(СостояниеVanessaAutomation.ТекущийСценарий.МассивТегов, ИмяТега);
	КонецЕсли;	
	
	Если Значение = Неопределено Тогда
		Если СостояниеVanessaAutomation.ТекущаяФича.Свойство("МассивТегов")
			И ТипЗнч(СостояниеVanessaAutomation.ТекущаяФича.МассивТегов) = Тип("Массив") Тогда
				Значение = ЗначениеИзМассиваТегов(СостояниеVanessaAutomation.ТекущаяФича.МассивТегов, ИмяТега);
		КонецЕсли;	
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Не найден тег <%1> из которого можно получить значение.");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%1",ИмяТега);
		ВызватьИсключение ТекстСообщения;
