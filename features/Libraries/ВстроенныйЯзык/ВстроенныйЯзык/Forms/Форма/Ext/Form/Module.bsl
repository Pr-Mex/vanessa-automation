&НаКлиенте
Функция ЗначениеИзМассиваТегов(Массив, ИмяТега)
	
	Для Каждого Элем Из Массив Цикл
		Стр = Элем.ТегИсходный;
		Поз = Найти(Стр, "=");
		Если Поз > 0 Тогда
			ЛевоеЗначение = СокрЛП(Лев(Стр, Поз - 1));
			ПравоеЗначение = СокрЛП(Сред(Стр, Поз + 1));
			
			Если НРег(ЛевоеЗначение) = НРег(ИмяТега) Тогда
				Возврат ПравоеЗначение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции	

