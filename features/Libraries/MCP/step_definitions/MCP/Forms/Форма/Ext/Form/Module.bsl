///////////////////////////////////////////////////
// Тестовая библиотека MCP-инструментов Vanessa Automation.
// Шаги вызывают хендлеры MCPVA напрямую и проверяют намерения,
// ошибки валидации и отсутствие реальных действий.
///////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем Ванесса;

&НаКлиенте
Перем Контекст Экспорт;

&НаКлиенте
Перем КонтекстСохраняемый Экспорт;

// Последний результат вызова MCP-инструмента.
&НаКлиенте
Перем ПоследнийРезультатMCP;

// Записи, которые транспорт получил от guard'ов: Вход и Намерение.
&НаКлиенте
Перем ЗаписиТранспортаMCP;

// Последнее намерение, собранное транспортом.
&НаКлиенте
Перем ПоследнееНамерениеMCP;

// Фасад, который был установлен до начала теста.
&НаКлиенте
Перем ПредыдущийФасадMCP;

// Признак того, что фасад был сохранён в Дано и его нужно восстановить.
&НаКлиенте
Перем ФасадMCPБылСохранён;

&НаКлиенте
Перем РежимТестированияВключенMCP;

&НаКлиенте
Перем СчетчикВызововMCP;

&НаКлиенте
Перем ЗарегистрированныеИнструментыMCP;

&НаКлиенте
Перем ОтложенныйОтветMCP;

&НаКлиенте
Перем ОжиданиеОтветаMCP;

#КонецОбласти

#Область Инициализация

&НаКлиенте
Функция ОтключениеМодуля() Экспорт

	ВосстановитьФасадMCP();
	Ванесса = Неопределено;
	Контекст = Неопределено;
	КонтекстСохраняемый = Неопределено;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПередОкончаниемСценария() Экспорт

	ВосстановитьФасадMCP();
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПолучитьСписокТестов(КонтекстФреймворкаBDD) Экспорт

	Ванесса = КонтекстФреймворкаBDD;
	ВсеТесты = Новый Массив;

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ЯПодготавливаюТестовыйТранспортMCP()",
		"ЯПодготавливаюТестовыйТранспортMCP",
		"Дано я подготавливаю тестовый транспорт MCP",
		"### Описание
		|Готовит тестовый транспорт MCP: запоминает текущий фасад, устанавливает двойник
		|Мсп_Сервер, выключает режим тестирования и очищает записи предыдущего вызова.
		|Выполняется в Контексте фичи перед вызовом инструментов.
		|",
		"MCP.Подготовка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ЯВызываюMCP_инструмент(Парам01)",
		"ЯВызываюMCPИнструмент",
		"Когда я вызываю MCP-инструмент ""ИмяИнструмента""",
		"### Описание
		|Вызывает MCP-инструмент по имени в режиме намерения с пустыми аргументами.
		|Режим намерения включается на время вызова и не выполняет реальных действий.
		|",
		"MCP.Вызов");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ЯВызываюMCP_инструментСПараметрами(Парам01,ТабПарам)",
		"ЯВызываюMCPИнструментСПараметрами",
		"Когда я вызываю MCP-инструмент ""ИмяИнструмента"" с параметрами
		|" + Символы.Таб + "|Имя|Значение|
		|" + Символы.Таб + "|action|click_button|
		|" + Символы.Таб + "|element_name|КнопкаОК|",
		"### Описание
		|Вызывает MCP-инструмент в режиме намерения с параметрами из таблицы.
		|Первая колонка - имя параметра, вторая - значение.
		|",
		"MCP.Вызов");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ЯВызываюMCP_инструментВРежиме(Парам01,Парам02)",
		"ЯВызываюMCPИнструментВРежиме",
		"Когда я вызываю MCP-инструмент ""ИмяИнструмента"" в режиме ""План|Намерение|Проверка""",
		"### Описание
		|Вызывает MCP-инструмент в явно заданном режиме.
		|Намерение - включить тестовый транспорт; Проверка - валидация без реальных действий;
		|План - синоним Намерения. Режим Выполнить (L3) пока не реализован.
		|",
		"MCP.Вызов");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ЯВызываюMCP_инструментВРежимеСПараметрами(Парам01,Парам02,ТабПарам)",
		"ЯВызываюMCPИнструментВРежимеСПараметрами",
		"Когда я вызываю MCP-инструмент ""ИмяИнструмента"" в режиме ""Режим"" с параметрами
		|" + Символы.Таб + "|Имя|Значение|
		|" + Символы.Таб + "|action|click_button|",
		"### Описание
		|Вызывает MCP-инструмент в явно заданном режиме с параметрами из таблицы.
		|",
		"MCP.Вызов");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"MCP_инструментВернулУспешныйОтвет()",
		"MCPИнструментВернулУспешныйОтвет",
		"Тогда MCP-инструмент вернул успешный ответ",
		"### Описание
		|Проверяет, что последний вызов завершился успешно и не был перехвачен транспортом.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"MCP_инструментВернулОшибку(Парам01)",
		"MCPИнструментВернулОшибку",
		"Тогда MCP-инструмент вернул ошибку ""КодОшибки""",
		"### Описание
		|Проверяет код ошибки последнего вызова: INVALID_PARAMS, ACTION_FAILED и т.п.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"MCP_инструментВернулОшибкуСТекстомСодержащим(Парам01,Парам02)",
		"MCPИнструментВернулОшибкуСТекстом",
		"Тогда MCP-инструмент вернул ошибку ""КодОшибки"" с текстом, содержащим ""Текст""",
		"### Описание
		|Проверяет код ошибки и подстроку в тексте ошибки.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ОтветMCP_инструментаСодержит(Парам01)",
		"ОтветMCPИнструментаСодержит",
		"Тогда ответ MCP-инструмента содержит ""Текст""",
		"### Описание
		|Проверяет подстроку в тексте ответа последнего вызова.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"MCP_инструментВернулНамерение(Парам01)",
		"MCPИнструментВернулНамерение",
		"Тогда MCP-инструмент вернул намерение ""КодНамерения""",
		"### Описание
		|Проверяет, что последний вызов перехвачен транспортом и код намерения совпал.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ВНамеренииMCP_инструментаПолеРавно(Парам01,Парам02)",
		"ВНамеренииMCPПолеРавно",
		"Тогда в намерении MCP-инструмента поле ""ИмяПоля"" равно ""Значение""",
		"### Описание
		|Проверяет точное значение поля в последнем намерении.
		|Поддерживаются поля action, element_name, table_name, instrument и другие аргументы запроса.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"MCP_инструментНеВыполнялРеальныхДействий()",
		"MCPИнструментНеВыполнялРеальныхДействий",
		"Тогда MCP-инструмент не выполнял реальных действий",
		"### Описание
		|Сравнивает снимок состояния до и после вызова. Снимок вспомогательный:
		|основное доказательство отсутствия действий - сработавший guard.
		|",
		"MCP.Проверка");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ЯПроверяюЧтоКаждыйMCP_инструментПокрытТестом()",
		"ЯПроверяюЧтоКаждыйMCPИнструментПокрытТестом",
		"Тогда я проверяю, что каждый MCP-инструмент покрыт тестом",
		"### Описание
		|Мета-тест: сверяет карту инструментов с реестром MCPVA, проверяет
		|уникальность имён, корректность хендлеров и наличие тега @tool:<имя>
		|в файлах фич каталога MCPAutotests.
		|",
		"MCP.Метатест");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"КонтрактРеестраMCPСоблюдён()",
		"КонтрактРеестраMCPСоблюдён",
		"Тогда контракт реестра MCP соблюдён",
		"### Описание
		|L0: проверяет количество инструментов, флаги отключения и регистрацию
		|на двойниках Мсп_Сервер и Мсп_СхемаПараметров.
		|",
		"MCP.Метатест");

	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты,
		"ВсеMCP_инструментыСообщаютНамерение()",
		"ЯПроверяюНамеренияВсехMCPИнструментов",
		"Тогда все MCP-инструменты сообщают намерение",
		"### Описание
		|Smoke: перебирает карту инструментов, вызывает каждый в режиме намерения
		|и проверяет, что guard записал Вход (и Намерение для L1b).
		|",
		"MCP.Метатест");

	Возврат ВсеТесты;

КонецФункции

#КонецОбласти

#Область ШагиВызова

&НаКлиенте
Функция ЯПодготавливаюТестовыйТранспортMCP() Экспорт

	ПоследнийРезультатMCP = Неопределено;
	ЗаписиТранспортаMCP = Новый Массив;
	ПоследнееНамерениеMCP = Неопределено;
	ОтложенныйОтветMCP = Неопределено;
	ОжиданиеОтветаMCP = Ложь;
	СчетчикВызововMCP = 0;
	ЗарегистрированныеИнструментыMCP = Новый Массив;

	МодульMCPVA = Ванесса.МодульMCPVA();
	Если МодульMCPVA.MCPСерверЗапущен() Тогда
		ВызватьИсключение "Сервер MCP запущен: автотесты MCP нельзя выполнять в сеансе с активным сервером.";
	КонецЕсли;
	ТекущийФасадMCP = МодульMCPVA.ПолучитьВнешнийФасадМсп();
	Если ТекущийФасадMCP <> ЭтаФорма Тогда
		ПредыдущийФасадMCP = ТекущийФасадMCP;
		ФасадMCPБылСохранён = Истина;
	ИначеЕсли НЕ ФасадMCPБылСохранён Тогда
		// Первый вход: предыдущего фасада не было.
		ПредыдущийФасадMCP = Неопределено;
		ФасадMCPБылСохранён = Истина;
	КонецЕсли;
	МодульMCPVA.УстановитьВнешнийФасадМсп(ПредыдущийФасадMCP);
	МодульMCPVA.ВыключитьРежимТестированияMCP();
	РежимТестированияВключенMCP = Ложь;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЯВызываюMCPИнструмент(ИмяИнструмента) Экспорт

	ВыполнитьВызовMCP(ИмяИнструмента, Новый Структура, "Намерение");
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЯВызываюMCPИнструментСПараметрами(ИмяИнструмента, ТабПарам) Экспорт

	Аргументы = АргументыИзТаблицыMCP(ТабПарам);
	ВыполнитьВызовMCP(ИмяИнструмента, Аргументы, "Намерение");
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЯВызываюMCPИнструментВРежиме(ИмяИнструмента, Режим) Экспорт

	ВыполнитьВызовMCP(ИмяИнструмента, Новый Структура, Режим);
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЯВызываюMCPИнструментВРежимеСПараметрами(ИмяИнструмента, Режим, ТабПарам) Экспорт

	Аргументы = АргументыИзТаблицыMCP(ТабПарам);
	ВыполнитьВызовMCP(ИмяИнструмента, Аргументы, Режим);
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ШагиПроверки

&НаКлиенте
Функция MCPИнструментВернулУспешныйОтвет() Экспорт

	ПроверитьЧтоРезультатЕстьMCP();
	Если ПоследнийРезультатMCP.Статус <> "Успех" Тогда
		ВызватьИсключение "Ожидался успешный ответ MCP, получен статус: " + ПоследнийРезультатMCP.Статус
			+ ". " + ПоследнийРезультатMCP.Текст;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция MCPИнструментВернулОшибку(КодОшибки) Экспорт

	ПроверитьЧтоРезультатЕстьMCP();
	Если ПоследнийРезультатMCP.Статус <> "Ошибка" Тогда
		ВызватьИсключение "Ожидалась ошибка MCP " + КодОшибки + ", получен статус: "
			+ ПоследнийРезультатMCP.Статус + ". " + ПоследнийРезультатMCP.Текст;
	КонецЕсли;
	Если ПоследнийРезультатMCP.КодОшибки <> КодОшибки Тогда
		ВызватьИсключение "Ожидалась ошибка " + КодОшибки + ", получена: "
			+ ПоследнийРезультатMCP.КодОшибки + ". " + ПоследнийРезультатMCP.Текст;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция MCPИнструментВернулОшибкуСТекстом(КодОшибки, Текст) Экспорт

	MCPИнструментВернулОшибку(КодОшибки);
	Если Найти(НРег(ПоследнийРезультатMCP.Текст), НРег(Текст)) = 0 Тогда
		ВызватьИсключение "В тексте ошибки нет подстроки <" + Текст + ">: " + ПоследнийРезультатMCP.Текст;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ОтветMCPИнструментаСодержит(Текст) Экспорт

	ПроверитьЧтоРезультатЕстьMCP();
	Если Найти(НРег(ПоследнийРезультатMCP.Текст), НРег(Текст)) = 0 Тогда
		ВызватьИсключение "В ответе MCP нет подстроки <" + Текст + ">: " + ПоследнийРезультатMCP.Текст;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция MCPИнструментВернулНамерение(КодНамерения) Экспорт

	ПроверитьЧтоРезультатЕстьMCP();
	Если ПоследнийРезультатMCP.Статус <> "Намерение" Тогда
		ВызватьИсключение "Ожидалось намерение " + КодНамерения + ", получен статус: "
			+ ПоследнийРезультатMCP.Статус + ". " + ПоследнийРезультатMCP.Текст;
	КонецЕсли;
	Если ПоследнееНамерениеMCP = Неопределено Тогда
		ВызватьИсключение "Транспорт не сохранил намерение MCP.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПоследнийРезультатMCP.КодИзОтвета) Тогда
		ВызватьИсключение "Ответ намерения не содержит код.";
	КонецЕсли;
	Если ПоследнийРезультатMCP.КодИзОтвета <> КодНамерения Тогда
		ВызватьИсключение "Ожидалось намерение " + КодНамерения + ", получено в ответе: "
			+ ПоследнийРезультатMCP.КодИзОтвета;
	КонецЕсли;
	Если ПоследнееНамерениеMCP.КодНамерения <> ПоследнийРезультатMCP.КодИзОтвета Тогда
		ВызватьИсключение "Код в записи транспорта не совпал с ответом: "
			+ ПоследнееНамерениеMCP.КодНамерения + " / " + ПоследнийРезультатMCP.КодИзОтвета;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПоследнийРезультатMCP.ИмяИзОтвета) И (ПоследнийРезультатMCP.ИмяИзОтвета <> ПоследнийРезультатMCP.Имя) Тогда
		ВызватьИсключение "В ответе намерения указан другой инструмент: " + ПоследнийРезультатMCP.ИмяИзОтвета;
	КонецЕсли;
	Если ПоследнийРезультатMCP.РежимL1 = "b" И ПоследнийРезультатMCP.ЗаписиТранспорта.Количество() < 2 Тогда
		ВызватьИсключение "L1b: boundary-guard не сработал, записей транспорта: "
			+ Строка(ПоследнийРезультатMCP.ЗаписиТранспорта.Количество());
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ВНамеренииMCPПолеРавно(ИмяПоля, Значение) Экспорт

	ПроверитьЧтоРезультатЕстьMCP();
	Если ПоследнееНамерениеMCP = Неопределено Тогда
		ВызватьИсключение "Транспорт не сохранил намерение MCP.";
	КонецЕсли;

	ЗначениеАргумента = Неопределено;
	Если ИмяПоля = "instrument" Тогда
		Фактическое = ПоследнееНамерениеMCP.Инструмент;
	ИначеЕсли ИмяПоля = "handler" Тогда
		Фактическое = ПоследнееНамерениеMCP.Хендлер;
	ИначеЕсли ИмяПоля = "action" Тогда
		Фактическое = ПоследнееНамерениеMCP.Действие;
	ИначеЕсли ПоследнееНамерениеMCP.Аргументы.Свойство(ИмяПоля, ЗначениеАргумента) Тогда
		Фактическое = ЗначениеАргумента;
	Иначе
		ВызватьИсключение "В намерении MCP нет поля <" + ИмяПоля + ">.";
	КонецЕсли;

	Если Строка(Фактическое) <> Строка(Значение) Тогда
		ВызватьИсключение "Поле намерения <" + ИмяПоля + "> равно <" + Строка(Фактическое)
			+ ">, ожидалось <" + Строка(Значение) + ">.";
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция MCPИнструментНеВыполнялРеальныхДействий() Экспорт

	ПроверитьЧтоРезультатЕстьMCP();
	Изменения = ИзмененияСнимкаMCP(ПоследнийРезультатMCP.СнимокДо, ПоследнийРезультатMCP.СнимокПосле);
	Если Изменения.Количество() > 0 Тогда
		ВызватьИсключение "Состояние изменилось после вызова MCP: " + СоединитьМассивMCP(Изменения, ", ");
	КонецЕсли;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Метатесты

&НаКлиенте
Функция ЯПроверяюЧтоКаждыйMCPИнструментПокрытТестом() Экспорт

	КартаMCP = MCPТестовыеМетаданные();
	МодульMCPVA = Ванесса.МодульMCPVA();
	ЕстьVAExtension = Ложь;
	Попытка
		ЕстьVAExtension = (Ванесса.ЗначениеДополнительногоПараметра("РасширениеVAExtensionУстановлено") = Истина);
	Исключение
		ЕстьVAExtension = Ложь;
	КонецПопытки;
	Описания = МодульMCPVA.ПолучитьОписанияИнструментовMCP(ЕстьVAExtension);

	Ошибки = Новый Массив;

	Если КартаMCP.Количество() <> 56 Тогда
		Ошибки.Добавить("В карте MCP " + Строка(КартаMCP.Количество()) + " инструментов, ожидалось 56.");
	КонецЕсли;

	Если Описания.Количество() <> 56 Тогда
		Ошибки.Добавить("В реестре MCP " + Строка(Описания.Количество()) + " инструментов, ожидалось 56.");
	КонецЕсли;

	Для Каждого Описание Из Описания Цикл
		ОписаниеКарты = КартаMCP.Получить(Описание.Имя);
		Если ОписаниеКарты = Неопределено Тогда
			Ошибки.Добавить("В карте нет инструмента из реестра: " + Описание.Имя);
			Продолжить;
		КонецЕсли;
		Если ОписаниеКарты.Хендлер <> Описание.Хендлер Тогда
			Ошибки.Добавить("Хендлер не совпал: " + Описание.Имя + " / " + Описание.Хендлер);
		КонецЕсли;

		ОжидаемоеОтключение = (ОписаниеКарты.Отключен = "да") ИЛИ (ОписаниеКарты.Отключен = "условно" И НЕ ЕстьVAExtension);
		Если Описание.Отключен <> ОжидаемоеОтключение Тогда
			Ошибки.Добавить("Признак отключения не совпал: " + Описание.Имя
				+ " / реестр=" + Строка(Описание.Отключен) + ", карта=" + ОписаниеКарты.Отключен + ".");
		КонецЕсли;

		ОжидаемаяАсинхронность = (ОписаниеКарты.Асинхронный = "да");
		Если (Описание.Асинхронный = Истина) <> ОжидаемаяАсинхронность Тогда
			Ошибки.Добавить("Признак асинхронности не совпал: " + Описание.Имя + ".");
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Описание.Описание) Тогда
			Ошибки.Добавить("Пустое описание у " + Описание.Имя + ".");
		КонецЕсли;

		ИменаСвойств = Новый Соответствие;
		Для Каждого Свойство Из Описание.Свойства Цикл
			Если НЕ ЗначениеЗаполнено(Свойство.Имя) ИЛИ НЕ ЗначениеЗаполнено(Свойство.Тип) Тогда
				Ошибки.Добавить("Некорректное свойство у " + Описание.Имя + ".");
			ИначеЕсли ИменаСвойств.Получить(Свойство.Имя) <> Неопределено Тогда
				Ошибки.Добавить("Дублирующееся свойство у " + Описание.Имя + ": " + Свойство.Имя);
			Иначе
				ИменаСвойств.Вставить(Свойство.Имя, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого КлючЗначение Из КартаMCP Цикл
		Описание = КлючЗначение.Значение;
		Если НЕ ЗначениеЗаполнено(Описание.Хендлер) Тогда
			Ошибки.Добавить("Не задан хендлер: " + Описание.Имя);
		КонецЕсли;
		Если Описание.РежимL1 <> "a" И Описание.РежимL1 <> "b" Тогда
			Ошибки.Добавить("Неверный режим L1 у " + Описание.Имя + ": " + Описание.РежимL1);
		КонецЕсли;
		Если НЕ КодНамеренияДопустимMCP(Описание.КодНамерения) Тогда
			Ошибки.Добавить("Неизвестный код намерения у " + Описание.Имя + ": " + Описание.КодНамерения);
		КонецЕсли;
	КонецЦикла;

	ТегиФич = СобратьТегиИнструментовMCP();
	Для Каждого КлючЗначение Из КартаMCP Цикл
		Имя = КлючЗначение.Ключ;
		Если ТегиФич.Получить(Имя) = Неопределено Тогда
			Ошибки.Добавить("Нет сценария @tool:" + Имя + " в фичах MCPAutotests.");
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Мета-тест MCP не пройден:" + Символы.ПС + СоединитьМассивMCP(Ошибки, Символы.ПС);
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция КонтрактРеестраMCPСоблюдён() Экспорт

	МодульMCPVA = Ванесса.МодульMCPVA();
	ЕстьVAExtension = Ложь;
	Попытка
		ЕстьVAExtension = (Ванесса.ЗначениеДополнительногоПараметра("РасширениеVAExtensionУстановлено") = Истина);
	Исключение
		ЕстьVAExtension = Ложь;
	КонецПопытки;
	Описания = МодульMCPVA.ПолучитьОписанияИнструментовMCP(ЕстьVAExtension);

	Если Описания.Количество() <> 56 Тогда
		ВызватьИсключение "Ожидалось 56 описаний MCP, получено " + Строка(Описания.Количество()) + ".";
	КонецЕсли;

	Отключено = 0;
	Активно = 0;
	Для Каждого Описание Из Описания Цикл
		Если Описание.Отключен Тогда
			Отключено = Отключено + 1;
		Иначе
			Активно = Активно + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отключено <> 3 И Отключено <> 4 Тогда
		ВызватьИсключение "Ожидалось 3 или 4 отключённых инструмента, получено " + Строка(Отключено) + ".";
	КонецЕсли;
	Если Активно <> 56 - Отключено Тогда
		ВызватьИсключение "Сумма активных и отключённых инструментов не равна 56: "
			+ Строка(Активно) + " + " + Строка(Отключено) + ".";
	КонецЕсли;

	ЗарегистрированныеИнструментыMCP = Новый Массив;
	ПараметрыСозданияMCP = Новый Структура;
	ПараметрыСозданияMCP.Вставить("МодульМсп_Сервер", ЭтаФорма);
	ПараметрыСозданияMCP.Вставить("МодульМсп_СхемаПараметров", ЭтаФорма);
	МодульMCPVA.ВызватьРегистрациюИнструментовMCP(ПараметрыСозданияMCP);

	Если ЗарегистрированныеИнструментыMCP.Количество() <> Активно Тогда
		ВызватьИсключение "Ожидалось " + Строка(Активно) + " зарегистрированных инструментов, получено "
			+ Строка(ЗарегистрированныеИнструментыMCP.Количество()) + ".";
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ЯПроверяюНамеренияВсехMCPИнструментов() Экспорт

	КартаMCP = MCPТестовыеМетаданные();
	Ошибки = Новый Массив;

	Для Каждого КлючЗначение Из КартаMCP Цикл
		Описание = КлючЗначение.Значение;
		Попытка
			Если Описание.РежимL1 = "b" Тогда
				Аргументы = АргументыSmokeMCP(Описание);
				ВыполнитьВызовMCP(Описание.Имя, Аргументы, "Намерение");
			Иначе
				ВыполнитьВызовMCP(Описание.Имя, Новый Структура, "Намерение");
			КонецЕсли;

			Если ПоследнийРезультатMCP.Статус <> "Намерение" Тогда
				Ошибки.Добавить(Описание.Имя + ": статус " + ПоследнийРезультатMCP.Статус
					+ ", " + ПоследнийРезультатMCP.Текст);
			ИначеЕсли ЗаписиТранспортаMCP.Количество() = 0 Тогда
				Ошибки.Добавить(Описание.Имя + ": транспорт не получил ни одной записи.");
			КонецЕсли;
		Исключение
			Ошибки.Добавить(Описание.Имя + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Smoke намерений MCP не пройден:" + Символы.ПС + СоединитьМассивMCP(Ошибки, Символы.ПС);
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Вызов

&НаКлиенте
Процедура ВыполнитьВызовMCP(ИмяИнструмента, Аргументы, Режим)

	КартаMCP = MCPТестовыеМетаданные();
	Описание = КартаMCP.Получить(ИмяИнструмента);
	Если Описание = Неопределено Тогда
		ВызватьИсключение "Неизвестный MCP-инструмент: " + ИмяИнструмента;
	КонецЕсли;

	РежимНормализованный = НормализоватьРежимMCP(Режим);
	ПроверитьРежимMCP(ИмяИнструмента, РежимНормализованный);

	// Режим Проверка допускает только заведомо неверный action: иначе валидный
	// вызов мог бы выполнить реальную ветку до проверки ожидаемой ошибки.
	Если РежимНормализованный = "Проверка" Тогда
		ЗначениеДействия = "";
		ЕстьДействие = Аргументы.Свойство("action", ЗначениеДействия);
		Если ЕстьДействие Тогда
			ЗначениеДействия = СокрЛП(Строка(ЗначениеДействия));
		КонецЕсли;
		Если ИмяИнструмента = "user_actions_recording" ИЛИ ИмяИнструмента = "manage_variables" Тогда
			// У этих инструментов отсутствие action означает реальное действие по умолчанию
			// (start/get), поэтому разрешён только заведомо неверный action.
			Если (НЕ ЕстьДействие) ИЛИ (ЗначениеДействия <> "__unknown__") Тогда
				ВызватьИсключение "Режим Проверка для " + ИмяИнструмента + " разрешён только с заведомо неверным action.";
			КонецЕсли;
		Иначе
			// Для остальных инструментов allowlist'а допустим отсутствующий action:
			// он отсекается проверкой обязательного параметра до действия.
			Если ЕстьДействие И ЗначениеДействия <> "__unknown__" Тогда
				ВызватьИсключение "Режим Проверка разрешён только для отсутствующего или заведомо неверного action.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	МодульMCPVA = Ванесса.МодульMCPVA();
	СнимокДо = СнимокСостоянияMCP();
	ЗаписиТранспортаMCP = Новый Массив;
	ПоследнееНамерениеMCP = Неопределено;
	ОтложенныйОтветMCP = Неопределено;

	СчетчикВызововMCP = СчетчикВызововMCP + 1;
	Запрос = Новый Структура;
	Запрос.Вставить("Идентификатор", "MCP-AUTOTEST-" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах()) + "-" + Формат(СчетчикВызововMCP, "ЧГ=0"));
	Запрос.Вставить("Аргументы", Аргументы);
	Запрос.Вставить("Контекст", Неопределено);

	// Фасад-двойник нужен в обоих режимах: в Намерении L1b-хендлер может
	// обратиться к Мсп_Сервер за текстом ошибки до boundary.
	Если (РежимНормализованный = "Проверка") ИЛИ (РежимНормализованный = "Намерение") Тогда
		МодульMCPVA.УстановитьВнешнийФасадМсп(ЭтаФорма);
	Иначе
		МодульMCPVA.УстановитьВнешнийФасадМсп(ПредыдущийФасадMCP);
	КонецЕсли;

	ВключатьРежим = (РежимНормализованный = "Намерение");
	Если ВключатьРежим Тогда
		МодульMCPVA.ВключитьРежимТестированияMCP(ЭтаФорма);
		РежимТестированияВключенMCP = Истина;
	Иначе
		МодульMCPVA.ВыключитьРежимТестированияMCP();
		РежимТестированияВключенMCP = Ложь;
	КонецЕсли;

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Статус = "Успех";
	КодОшибки = "";
	Текст = "";
	ИсключениеПриВызове = "";

	Попытка
		Результат = ВызватьХендлерMCP(МодульMCPVA, Описание.Хендлер, Запрос);
	Исключение
		Результат = Неопределено;
		ИсключениеПриВызове = ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Если РежимТестированияВключенMCP Тогда
			МодульMCPVA.ВыключитьРежимТестированияMCP();
			РежимТестированияВключенMCP = Ложь;
		КонецЕсли;
		Если (РежимНормализованный = "Проверка") ИЛИ (РежимНормализованный = "Намерение") Тогда
			МодульMCPVA.УстановитьВнешнийФасадМсп(ПредыдущийФасадMCP);
		КонецЕсли;
	Исключение
		// Снятие режима и фасада не должно скрывать исходную ошибку вызова.
		Попытка
			МодульMCPVA.ВыключитьРежимТестированияMCP();
			МодульMCPVA.УстановитьВнешнийФасадМсп(ПредыдущийФасадMCP);
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ИсключениеПриВызове) Тогда
			ИсключениеПриВызове = ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;

	Если Результат = Неопределено Тогда
		Текст = "";
	Иначе
		Текст = Строка(Результат);
	КонецЕсли;

	КодИзОтвета = "";
	ИмяИзОтвета = "";
	Если Лев(Текст, 11) = "MCP-INTENT|" Тогда
		ОстатокНамерения = Сред(Текст, 12, СтрДлина(Текст) - 11);
		ПозицияРазделителя = Найти(ОстатокНамерения, "|");
		Если ПозицияРазделителя > 0 Тогда
			КодИзОтвета = Лев(ОстатокНамерения, ПозицияРазделителя - 1);
			ИмяИзОтвета = Сред(ОстатокНамерения, ПозицияРазделителя + 1, СтрДлина(ОстатокНамерения) - ПозицияРазделителя);
		Иначе
			КодИзОтвета = ОстатокНамерения;
		КонецЕсли;
	КонецЕсли;

	ЕстьНамерение = Ложь;
	ЕстьВход = Ложь;
	Для Каждого ЗаписьТранспорта Из ЗаписиТранспортаMCP Цикл
		Если ЗаписьТранспорта.ТипЗаписи = "Намерение" Тогда
			ЕстьНамерение = Истина;
		ИначеЕсли ЗаписьТранспорта.ТипЗаписи = "Вход" Тогда
			ЕстьВход = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ИсключениеПриВызове) Тогда
		Статус = "Исключение";
		Текст = ИсключениеПриВызове;
	ИначеЕсли ЕстьНамерение Тогда
		Если Лев(Текст, 11) = "MCP-INTENT|" Тогда
			Статус = "Намерение";
		Иначе
			Статус = "Ошибка";
			КодОшибки = "INTENT_NOT_RETURNED";
			Текст = "Boundary-guard записал намерение, но хендлер не вернул ответ намерения: " + Текст;
		КонецЕсли;
	ИначеЕсли Лев(Текст, 10) = "MCP-ERROR|" Тогда
		Статус = "Ошибка";
		Остаток = Сред(Текст, 11, СтрДлина(Текст) - 10);
		Позиция = Найти(Остаток, "|");
		Если Позиция > 0 Тогда
			КодОшибки = Лев(Остаток, Позиция - 1);
			Текст = Сред(Остаток, Позиция + 1, СтрДлина(Остаток) - Позиция);
		Иначе
			КодОшибки = Остаток;
			Текст = "";
		КонецЕсли;
	ИначеЕсли ЕстьВход Тогда
		Если Лев(Текст, 11) = "MCP-INTENT|" Тогда
			Статус = "Намерение";
		Иначе
			Статус = "Ошибка";
			КодОшибки = "INTENT_NOT_RETURNED";
			Текст = "Guard записал вход, но хендлер не вернул ответ намерения: " + Текст;
		КонецЕсли;
	Иначе
		Статус = "Успех";
	КонецЕсли;

	ПоследнийРезультатMCP = Новый Структура;
	ПоследнийРезультатMCP.Вставить("Имя", ИмяИнструмента);
	ПоследнийРезультатMCP.Вставить("Хендлер", Описание.Хендлер);
	ПоследнийРезультатMCP.Вставить("РежимL1", Описание.РежимL1);
	ПоследнийРезультатMCP.Вставить("Режим", РежимНормализованный);
	ПоследнийРезультатMCP.Вставить("Статус", Статус);
	ПоследнийРезультатMCP.Вставить("КодОшибки", КодОшибки);
	ПоследнийРезультатMCP.Вставить("Текст", Текст);
	ПоследнийРезультатMCP.Вставить("КодИзОтвета", КодИзОтвета);
	ПоследнийРезультатMCP.Вставить("ИмяИзОтвета", ИмяИзОтвета);
	ПоследнийРезультатMCP.Вставить("ЗаписиТранспорта", ЗаписиТранспортаMCP);
	ПоследнийРезультатMCP.Вставить("Намерение", ПоследнееНамерениеMCP);
	ПоследнийРезультатMCP.Вставить("Аргументы", Аргументы);
	ПоследнийРезультатMCP.Вставить("ОтложеноЗавершено", ОтложенныйОтветMCP <> Неопределено);
	ПоследнийРезультатMCP.Вставить("ДлительностьМс", ДлительностьМс);
	ПоследнийРезультатMCP.Вставить("СнимокДо", СнимокДо);
	ПоследнийРезультатMCP.Вставить("СнимокПосле", СнимокСостоянияMCP());

	Ванесса.СохранитьЗначениеПеременнойВКонтекст("РезультатMCP", ПоследнийРезультатMCP, Ложь, Истина);

