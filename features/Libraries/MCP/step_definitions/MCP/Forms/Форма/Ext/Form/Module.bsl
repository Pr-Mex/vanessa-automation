&НаКлиенте
Процедура ДобавитьMCPМетаданные(КартаMCP, Имя, Хендлер, РежимL1, Отключен, Категория, КодНамерения, Требования = "")

	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Хендлер", Хендлер);
	Описание.Вставить("Обертка", "да");
	Описание.Вставить("Асинхронный", ?(ЭтоАсинхронныйMCP(Имя), "да", "нет"));
	Описание.Вставить("Отключен", Отключен);
	Описание.Вставить("Категория", Категория);
	Описание.Вставить("РежимL1", РежимL1);
