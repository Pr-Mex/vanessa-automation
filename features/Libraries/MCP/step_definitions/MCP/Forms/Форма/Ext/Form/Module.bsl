&НаКлиенте
Функция ИзмененияСнимкаMCP(До, После)

	Изменения = Новый Массив;
	Для Каждого КлючЗначение Из До Цикл
		ЗначениеПосле = Неопределено;
		Если После.Свойство(КлючЗначение.Ключ, ЗначениеПосле) Тогда
			Если Строка(КлючЗначение.Значение) <> Строка(ЗначениеПосле) Тогда
				Изменения.Добавить(КлючЗначение.Ключ + ": " + Строка(КлючЗначение.Значение)
					+ " -> " + Строка(ЗначениеПосле));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Изменения;

