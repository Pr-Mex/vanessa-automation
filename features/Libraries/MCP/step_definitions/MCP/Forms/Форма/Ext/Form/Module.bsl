&НаКлиенте
Функция СнимокСостоянияMCP()

	Снимок = Новый Структура;
	Снимок.Вставить("ЕстьКлиент", Ложь);
	Снимок.Вставить("ИдетВыполнениеСценариев", Ложь);
	Снимок.Вставить("ИспользоватьКомпонентуVanessaExt", Ложь);
	Снимок.Вставить("ИспользоватьРедакторVanessaEditor", Ложь);
	Снимок.Вставить("КоличествоВкладок", -1);
	Снимок.Вставить("ЕстьВнешняяКомпонента", Ложь);
	Снимок.Вставить("ИдетЗаписьДействий", Ложь);

	Попытка
		Снимок.ЕстьКлиент = (Ванесса.ТекущиеДанныеКлиентаТестирования() <> Неопределено);
	Исключение
	КонецПопытки;

	Попытка
		Снимок.ИдетВыполнениеСценариев = Ванесса.Объект.ИдетВыполнениеСценариев;
	Исключение
	КонецПопытки;

	Попытка
		Снимок.ИспользоватьКомпонентуVanessaExt = Ванесса.Объект.ИспользоватьКомпонентуVanessaExt;
	Исключение
	КонецПопытки;

	Попытка
		Снимок.ИспользоватьРедакторVanessaEditor = Ванесса.Объект.ИспользоватьРедакторVanessaEditor;
	Исключение
	КонецПопытки;

	Попытка
		Если Ванесса.VanessaTabs <> Неопределено И Ванесса.VanessaTabs.tabStack <> Неопределено Тогда
			Снимок.КоличествоВкладок = Ванесса.VanessaTabs.tabStack.length;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Снимок.ЕстьВнешняяКомпонента = (Ванесса.ВнешняяКомпонентаДляСкриншотов <> Неопределено) И (Ванесса.ВнешняяКомпонентаДляСкриншотов <> "");
	Исключение
	КонецПопытки;

	Попытка
		Снимок.ИдетЗаписьДействий = Ванесса.ИдетЗаписьДействийПользователя();
	Исключение
	КонецПопытки;

	Возврат Снимок;

