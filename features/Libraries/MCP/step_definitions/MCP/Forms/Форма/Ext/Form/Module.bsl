Функция НормализоватьРежимMCP(Режим)

	РежимНормализованный = НРег(СокрЛП(Строка(Режим)));
	Если РежимНормализованный = "план" Тогда
		Возврат "Намерение";
	ИначеЕсли РежимНормализованный = "намерение" Тогда
		Возврат "Намерение";
	ИначеЕсли РежимНормализованный = "проверка" Тогда
		Возврат "Проверка";
	ИначеЕсли РежимНормализованный = "выполнить" Тогда
		ВызватьИсключение "Режим Выполнить (L3) в быстром контуре не реализован.";
	КонецЕсли;
	ВызватьИсключение "Неизвестный режим MCP: " + Строка(Режим);

