&НаКлиенте
Функция АргументыИзТаблицыMCP(ТабПарам)

	Аргументы = Новый Структура;

	Если ТипЗнч(ТабПарам) = Тип("Строка") Тогда
		Возврат Аргументы;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ТабПарам Цикл
		ИмяПараметра = "";
		ЗначениеПараметра = "";
		Попытка
			ИмяПараметра = СокрЛП(Строка(СтрокаТаблицы.Кол1));
		Исключение
			ИмяПараметра = "";
		КонецПопытки;
		Попытка
			ЗначениеПараметра = СтрокаТаблицы.Кол2;
		Исключение
			ЗначениеПараметра = "";
		КонецПопытки;
		Если НРег(ИмяПараметра) = "имя" И НРег(СокрЛП(Строка(ЗначениеПараметра))) = "значение" Тогда
			// Строка заголовка таблицы Gherkin не является аргументом.
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяПараметра) Тогда
			Аргументы.Вставить(ИмяПараметра, ПреобразоватьЗначениеMCP(ЗначениеПараметра));
		КонецЕсли;
	КонецЦикла;

	Возврат Аргументы;

КонецФункции

&НаКлиенте
Функция ПреобразоватьЗначениеMCP(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	ЗначениеНормализованное = НРег(СокрЛП(Значение));
	Если ЗначениеНормализованное = "истина" ИЛИ ЗначениеНормализованное = "true" Тогда
		Возврат Истина;
	ИначеЕсли ЗначениеНормализованное = "ложь" ИЛИ ЗначениеНормализованное = "false" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение;

