&НаКлиенте
Функция КодНамеренияMCP(Имя, Действие)

	ДействиеНормализованное = НРег(СокрЛП(Строка(Действие)));

	Если Имя = "manage_editor" Тогда
		Если (ДействиеНормализованное = "get_state") ИЛИ (ДействиеНормализованное = "list_tabs") ИЛИ (ДействиеНормализованное = "get_tab_content") ИЛИ (ДействиеНормализованное = "line_info") ИЛИ (ДействиеНормализованное = "list_breakpoints") Тогда
			Возврат "va.editor.read";
		КонецЕсли;
		Возврат "va.editor.write";
	ИначеЕсли Имя = "manage_variables" Тогда
		Если (ДействиеНормализованное = "get") ИЛИ (НЕ ЗначениеЗаполнено(ДействиеНормализованное)) Тогда
			Возврат "va.variables.read";
		КонецЕсли;
		Возврат "va.variables.write";
	ИначеЕсли Имя = "manage_breakpoints" Тогда
		Если ДействиеНормализованное = "list" Тогда
			Возврат "va.breakpoints.read";
		КонецЕсли;
		Возврат "va.breakpoints.write";
	ИначеЕсли Имя = "manage_clipboard" Тогда
		Если ДействиеНормализованное = "get_text" Тогда
			Возврат "clipboard.read";
		КонецЕсли;
		Возврат "clipboard.write";
	ИначеЕсли Имя = "manage_test_client_profiles" Тогда
		Если ДействиеНормализованное = "get_list" Тогда
			Возврат "mcp.client.read";
		КонецЕсли;
		Возврат "mcp.client.manage";
	ИначеЕсли Имя = "user_actions_recording" Тогда
		Если ДействиеНормализованное = "status" ИЛИ ДействиеНормализованное = "get_result" Тогда
			Возврат "mcp.state.read";
		КонецЕсли;
		Возврат "mcp.client.manage";
	ИначеЕсли Имя = "manage_uiautomation" Тогда
		Если ДействиеНормализованное = "effect" Тогда
			Возврат "os.uiautomation.effect";
