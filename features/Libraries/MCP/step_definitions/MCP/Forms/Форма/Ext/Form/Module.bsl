&НаКлиенте
Функция СобратьТегиИнструментовMCP()

	Теги = Новый Соответствие;
	КаталогMCP = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + "features/Core/MCPAutotests";
	СписокКаталогов = Новый СписокЗначений;
	СписокФайлов = Новый СписокЗначений;

	Попытка
		Ванесса.НайтиФайлыКомандаСистемы(КаталогMCP, СписокКаталогов, СписокФайлов, Истина, Неопределено, "*.feature");
	Исключение
		ВызватьИсключение "Не удалось прочитать каталог фич MCP: " + КаталогMCP + ". " + ОписаниеОшибки();
	КонецПопытки;

	Для Каждого ЭлементСпискаФайлов Из СписокФайлов Цикл
		Файл = ЭлементСпискаФайлов.Значение;
		Текст = "";
		Попытка
			Чтение = Новый ЧтениеТекста;
			Чтение.Открыть(Файл.ПолноеИмя, "UTF-8");
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			Текст = "";
		КонецПопытки;

		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Продолжить;
		КонецЕсли;

		Позиция = Найти(Текст, "@tool:");
		Пока Позиция > 0 Цикл
			Остаток = Сред(Текст, Позиция + 6, СтрДлина(Текст) - Позиция - 5);
			КонецТега = Найти(Остаток, Символы.ПС);
			Если КонецТега = 0 Тогда
				КонецТега = Найти(Остаток, Символы.ВК);
			КонецЕсли;
			Если КонецТега = 0 Тогда
				КонецТега = СтрДлина(Остаток) + 1;
			КонецЕсли;
			Имя = СокрЛП(Лев(Остаток, КонецТега - 1));
			Если ЗначениеЗаполнено(Имя) Тогда
				Теги.Вставить(Имя, Истина);
			КонецЕсли;
			Текст = Сред(Текст, Позиция + 6 + КонецТега, СтрДлина(Текст) - Позиция - 5 - КонецТега);
			Позиция = Найти(Текст, "@tool:");
		КонецЦикла;
	КонецЦикла;

	Возврат Теги;

