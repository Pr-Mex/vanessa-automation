				Попытка
					ЭлементФормы = ТекФорма.КоманднаяПанель.ПодчиненныеЭлементы[ИмяЭлемента];
				Исключение
				КонецПопытки;
			КонецЕсли;	 
			
			Если ЭлементФормы = Неопределено Тогда
