Функция СтраницаБраузераСодержитТекстСлужебный(ТекстHTML, Данные)
	Результат = Ложь;
	
	СтраницаБраузераСодержитТекстСлужебныйРекурсивно(ТекстHTML, Данные, Результат);
	
	Возврат Результат;
