//И я запускаю браузер
//@ЯЗапускаюБраузер()
Функция ЯЗапускаюБраузер() Экспорт
	Ванесса.ЗапуститьБраузер(Ложь);

	Если Ванесса.Объект.ИспользоватьБраузерПлюсWebSocket И Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстОшибки = "";
		Ошибка = Ложь;
		КоличествоПопыток = Ванесса.ЗначениеКоличествоПопытокВыполненияДействия();
		Для СчетчикПопыток = 1 По КоличествоПопыток Цикл
			Ошибка = Ложь;
			ТекстОшибки = "";

			Попытка

				ДанныеВкладокБраузера = Ванесса.ДанныеВкладокБраузера();

			Исключение
				ТекстОшибки = ОписаниеОшибки();
				Ошибка = Истина;
				Если СчетчикПопыток < КоличествоПопыток Тогда
					// Первая попытка часто падает с холодного старта Chrome (--remote-debugging-port:9222
					// поднимается 3+ сек). После первой ошибки даём подольше, далее короткие паузы.
					Ванесса.sleep(?(СчетчикПопыток = 1, 3, 1));
				КонецЕсли;
			КонецПопытки;

			Если НЕ Ошибка Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Ошибка Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции

