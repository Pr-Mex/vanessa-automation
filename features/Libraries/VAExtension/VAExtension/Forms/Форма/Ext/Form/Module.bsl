//И я открываю объект по ссылке "ИмяПеременной" (расширение)
//@ЯОткрываюОбъектПоСсылкеРасширение(Парам01)
Функция ЯОткрываюОбъектПоСсылкеРасширение(ИмяПеременной) Экспорт
	
	Значение = Ванесса.ПолучитьЗначениеПеременнойИзКонтекста(ИмяПеременной);
	СсылкаСтрокой = СсылкуВСтрокуСервер(Значение);
	СсылкаСтрокой = СтрЗаменить(СсылкаСтрокой, """", """""");
	
	КодДляВыполнения = "
	|СсылкаНаОбъект = VAExtensionОбщегоНазначенияВызовСервера.СсылкаПоСтроковомуПредставлению(""%1"");
	|VAExtensionОбщегоНазначенияКлиент.ОткрытьСсылкуНаОбъектАсинхронно(СсылкаНаОбъект);
	|";
	
	КодДляВыполнения = СтрЗаменить(КодДляВыполнения, "%1", СсылкаСтрокой);
	
	ЯВыполняюКодВстроенногоЯзыкаРасширениеСлужебный(КодДляВыполнения, Истина);
	
КонецФункции

&НаКлиенте
//И я открываю объект по строковому представлению ссылки "ИмяПеременной" (расширение)
//@ЯОткрываюОбъектПоСтроковомуПредставлениюСсылкиРасширение(Парам01)
Функция ЯОткрываюОбъектПоСтроковомуПредставлениюСсылкиРасширение(ИмяПеременной) Экспорт
	
	Значение = Ванесса.ПолучитьЗначениеПеременнойИзКонтекста(ИмяПеременной);
	СсылкаСтрокой = СтрЗаменить(Значение, """", """""");
	
	КодДляВыполнения = "
	|СсылкаНаОбъект = VAExtensionОбщегоНазначенияВызовСервера.СсылкаПоСтроковомуПредставлению(""%1"");
	|VAExtensionОбщегоНазначенияКлиент.ОткрытьСсылкуНаОбъектАсинхронно(СсылкаНаОбъект);
	|";
	
	КодДляВыполнения = СтрЗаменить(КодДляВыполнения, "%1", СсылкаСтрокой);
	
	ЯВыполняюКодВстроенногоЯзыкаРасширениеСлужебный(КодДляВыполнения, Истина);
	
КонецФункции

&НаКлиенте
//И я помечаю на удаление документы "ВидДокумента" содержащих комментарий "ТекстКомментария" (Расширение)
//@ЯПомечаюНаУдалениеДокументыСодержащихКомментарийРасширение(Парам01,Парам02)
Функция ЯПомечаюНаУдалениеДокументыСодержащихКомментарийРасширение(ВидДокумента, ТекстКомментария) Экспорт
	
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ПроведениеДокумента");
	Ванесса.ПроверитьОткрыласьФорма("*.VAExtension_ПроведениеДокумента.*", Истина);
	
	РеквизитВидДокумента = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ВидДокумента", Истина);
	РеквизитВидДокумента.ВвестиТекст(ВидДокумента);
	РеквизитТекстКомментария = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ТекстКомментария", Истина);
	РеквизитТекстКомментария.ВвестиТекст(ТекстКомментария);
	РеквизитОбработкаВыполнена = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина);

	РеквизитТекстИсключения = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ТекстИсключения", Истина);
	
	АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	
	КнопкаВыполнитьКод = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаПометитьНаУдалениеПоКомментарию");
	КнопкаЗакрытьФорму = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	БылаОшибка = Истина;
	ТекстИсключения = "";
	КоличествоПопытокПолученияОкнаИзПриложения = Макс(Ванесса.ЗначениеКоличествоПопытокВыполненияДействия(), 5);
	Для Сч = 1 По КоличествоПопытокПолученияОкнаИзПриложения Цикл
		
		КнопкаВыполнитьКод.Нажать();
		
		ПредставлениеДанных = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитОбработкаВыполнена);
		ПредставлениеДанных = Ванесса.ПривестиЗначениеФлагаКСтандарту(ПредставлениеДанных);
		Если ПредставлениеДанных <> "Да" Тогда
			Ванесса.sleep(1);
			Продолжить;
		КонецЕсли;	 
		
		ТекстИсключения = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитТекстИсключения);
		Если ЗначениеЗаполнено(ТекстИсключения) Тогда
			БылаОшибка = Истина;
		Иначе	
			БылаОшибка = Ложь;
		КонецЕсли;	
		
		Если НЕ БылаОшибка Тогда
			КнопкаЗакрытьФорму.Нажать();
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если БылаОшибка Тогда
		ТекстОшибки = Ванесса.Локализовать("При пометке документов на удаление возникли ошибки:" + Символы.ПС + ТекстИсключения);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецФункции
