Перем КаталогПроекта;
Перем СтрокиОтчета;
Перем ПутьКФайлуОтчета;

Процедура ВывестиСтроку(Знач Текст)
	Сообщить(Текст);
	СтрокиОтчета.Добавить(Текст);
КонецПроцедуры

Процедура СохранитьОтчет()
	Если Не ЗначениеЗаполнено(ПутьКФайлуОтчета) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста;
	Запись.Открыть(ПутьКФайлуОтчета, "UTF-8");
	Для Каждого СтрокаОтчета Из СтрокиОтчета Цикл
		Запись.ЗаписатьСтроку(СтрокаОтчета);
	КонецЦикла;
	Запись.Закрыть();
	Сообщить("Отчет сохранен в файл: " + ПутьКФайлуОтчета);
КонецПроцедуры

Процедура ДобавитьСтрокиБлокаYAML(Знач СтрокиYAML, Знач Отступ, Знач ИмяПоля, Знач Значение)
	СтрокиYAML.Добавить(Отступ + ИмяПоля + ": |-");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		СтрокиYAML.Добавить(Отступ + "  ");
		Возврат;
	КонецЕсли;

	МассивСтрок = СтрРазделить(Значение, Символы.ПС, Ложь);
	Если МассивСтрок.Количество() = 0 Тогда
		СтрокиYAML.Добавить(Отступ + "  ");
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаБлока Из МассивСтрок Цикл
		СтрокиYAML.Добавить(Отступ + "  " + СтрокаБлока);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьПростоеПолеYAML(Знач СтрокиYAML, Знач Отступ, Знач ИмяПоля, Знач Значение)
	Если Значение = Неопределено Тогда
		Значение = "";
	КонецЕсли;

	СтрокиYAML.Добавить(Отступ + ИмяПоля + ": " + Строка(Значение));
КонецПроцедуры

Функция ПрочитатьСтрокиФайла(Знач ПолноеИмяФайла)
	Строки = Новый Массив;
	Чтение = Новый ЧтениеТекста;
	Чтение.Открыть(ПолноеИмяФайла, "UTF-8");

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Строки.Добавить(СтрокаФайла);
	КонецЦикла;

	Чтение.Закрыть();
	Возврат Строки;
КонецФункции

Функция СтрокаНачинаетсяС(Знач СтрокаДанных, Знач Префикс)
	Возврат Лев(СтрокаДанных, СтрДлина(Префикс)) = Префикс;
КонецФункции

Функция ПрочитатьБлокYAML(Знач СтрокиФайла, Знач ИндексСтроки)
	СтрокиБлока = Новый Массив;
	ИндексСтроки = ИндексСтроки + 1;

	Пока ИндексСтроки < СтрокиФайла.Количество() Цикл
		СтрокаФайла = СтрокиФайла[ИндексСтроки];
		Если Не СтрокаНачинаетсяС(СтрокаФайла, "      ") Тогда
			Прервать;
		КонецЕсли;

		СтрокиБлока.Добавить(Сред(СтрокаФайла, 7));
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;

	Возврат Новый Структура("Текст, ИндексСтроки", СтрСоединить(СтрокиБлока, Символы.ПС), ИндексСтроки - 1);
КонецФункции

Функция ПрочитатьПереводыИзФайлаОтчета(Знач ПолноеИмяФайлаОтчета)
	Результат = Новый Массив;
	СтрокиФайла = ПрочитатьСтрокиФайла(ПолноеИмяФайлаОтчета);
	ТекущаяЗапись = Неопределено;

	Для ИндексСтроки = 0 По СтрокиФайла.Количество() - 1 Цикл
		СтрокаФайла = СтрокиФайла[ИндексСтроки];

		Если СтрокаНачинаетсяС(СтрокаФайла, "  - occurrence_count:") Тогда
			Если ТекущаяЗапись <> Неопределено Тогда
				Результат.Добавить(ТекущаяЗапись);
			КонецЕсли;
			ТекущаяЗапись = Новый Структура("ИсходнаяСтрока, Перевод", "", "");
			Продолжить;
		КонецЕсли;

		Если ТекущаяЗапись = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаФайла = "    source: |-" Тогда
			Блок = ПрочитатьБлокYAML(СтрокиФайла, ИндексСтроки);
			ТекущаяЗапись.ИсходнаяСтрока = Блок.Текст;
			ИндексСтроки = Блок.ИндексСтроки;
			Продолжить;
		КонецЕсли;

		Если СтрокаФайла = "    translation: |-" Тогда
			Блок = ПрочитатьБлокYAML(СтрокиФайла, ИндексСтроки);
			ТекущаяЗапись.Перевод = Блок.Текст;
			ИндексСтроки = Блок.ИндексСтроки;
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	Если ТекущаяЗапись <> Неопределено Тогда
		Результат.Добавить(ТекущаяЗапись);
	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция ПолучитьЧислоТега(Знач ТекстXML, Знач ИмяТега)
	ОткрывающийТег = "<" + ИмяТега + ">";
	ЗакрывающийТег = "</" + ИмяТега + ">";
	ПозицияНачала = Найти(ТекстXML, ОткрывающийТег);
	Если ПозицияНачала = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ПозицияНачала = ПозицияНачала + СтрДлина(ОткрывающийТег);
	Остаток = Сред(ТекстXML, ПозицияНачала);
	ПозицияКонца = Найти(Остаток, ЗакрывающийТег);
	Если ПозицияКонца = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Лев(Остаток, ПозицияКонца - 1));
КонецФункции

Функция ЗаменитьЧислоТега(Знач ТекстXML, Знач ИмяТега, Знач НовоеЗначение)
	ОткрывающийТег = "<" + ИмяТега + ">";
	ЗакрывающийТег = "</" + ИмяТега + ">";
	ПозицияНачала = Найти(ТекстXML, ОткрывающийТег);
	Если ПозицияНачала = 0 Тогда
		Возврат ТекстXML;
	КонецЕсли;

	ПозицияПослеТега = ПозицияНачала + СтрДлина(ОткрывающийТег);
	Остаток = Сред(ТекстXML, ПозицияПослеТега);
	ПозицияКонца = Найти(Остаток, ЗакрывающийТег);
	Если ПозицияКонца = 0 Тогда
		Возврат ТекстXML;
	КонецЕсли;

	Возврат Лев(ТекстXML, ПозицияПослеТега - 1) + Строка(НовоеЗначение) + Сред(Остаток, ПозицияКонца);
КонецФункции

Функция ПолучитьМаксимальныйИндексСтрок(Знач ТекстXML)
	ПозицияТегаВысоты = Найти(ТекстXML, "<height>");
	Если ПозицияТегаВысоты = 0 Тогда
		ФрагментСтрок = ТекстXML;
	Иначе
		ФрагментСтрок = Лев(ТекстXML, ПозицияТегаВысоты - 1);
	КонецЕсли;

	ПозицияПоиска = 1;
	МаксимальныйИндекс = -1;
	ОткрывающийТег = "<index>";
	ЗакрывающийТег = "</index>";

	Пока ПозицияПоиска <= СтрДлина(ФрагментСтрок) Цикл
		Остаток = Сред(ФрагментСтрок, ПозицияПоиска);
		ПозицияИндексаВОстатке = Найти(Остаток, ОткрывающийТег);
		Если ПозицияИндексаВОстатке = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияИндекса = ПозицияПоиска + ПозицияИндексаВОстатке - 1;
		ПозицияНачалаЗначения = ПозицияИндекса + СтрДлина(ОткрывающийТег);
		ОстатокПослеТега = Сред(ФрагментСтрок, ПозицияНачалаЗначения);
		ПозицияЗакрывающегоТега = Найти(ОстатокПослеТега, ЗакрывающийТег);
		Если ПозицияЗакрывающегоТега = 0 Тогда
			Прервать;
		КонецЕсли;

		ТекстИндекса = Лев(ОстатокПослеТега, ПозицияЗакрывающегоТега - 1);
		Попытка
			ИндексСтроки = Число(ТекстИндекса);
			Если ИндексСтроки > МаксимальныйИндекс Тогда
				МаксимальныйИндекс = ИндексСтроки;
			КонецЕсли;
		Исключение
		КонецПопытки;

		ПозицияПоиска = ПозицияНачалаЗначения + ПозицияЗакрывающегоТега + СтрДлина(ЗакрывающийТег) - 1;
	КонецЦикла;

	Возврат МаксимальныйИндекс;
КонецФункции

Функция ПодготовитьТекстДляXML(Знач Текст)
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ПодготовленныйТекст = XMLСтрока(Текст);
	Если ПодготовленныйТекст = Текст Тогда
		ПодготовленныйТекст = СтрЗаменить(ПодготовленныйТекст, "&", "&amp;");
		ПодготовленныйТекст = СтрЗаменить(ПодготовленныйТекст, "<", "&lt;");
		ПодготовленныйТекст = СтрЗаменить(ПодготовленныйТекст, ">", "&gt;");
		ПодготовленныйТекст = СтрЗаменить(ПодготовленныйТекст, """", "&quot;");
	КонецЕсли;

	Возврат ПодготовленныйТекст;
КонецФункции

Функция СоздатьБлокСтрокиМакета(Знач ИндексСтроки, Знач ИсходнаяСтрока, Знач Перевод)
	Возврат
		"    <rowsItem>" + Символы.ПС +
		"        <index>" + Строка(ИндексСтроки) + "</index>" + Символы.ПС +
		"        <row>" + Символы.ПС +
		"            <c>" + Символы.ПС +
		"                <c>" + Символы.ПС +
		"                    <f>0</f>" + Символы.ПС +
		"                    <tl>" + Символы.ПС +
		"                        <v8:item>" + Символы.ПС +
		"                            <v8:lang>ru</v8:lang>" + Символы.ПС +
		"                            <v8:content>" + ПодготовитьТекстДляXML(ИсходнаяСтрока) + "</v8:content>" + Символы.ПС +
		"                        </v8:item>" + Символы.ПС +
		"                    </tl>" + Символы.ПС +
		"                </c>" + Символы.ПС +
		"            </c>" + Символы.ПС +
		"            <c>" + Символы.ПС +
		"                <c>" + Символы.ПС +
		"                    <f>14</f>" + Символы.ПС +
		"                    <tl>" + Символы.ПС +
		"                        <v8:item>" + Символы.ПС +
		"                            <v8:lang>ru</v8:lang>" + Символы.ПС +
		"                            <v8:content>" + ПодготовитьТекстДляXML(Перевод) + "</v8:content>" + Символы.ПС +
		"                        </v8:item>" + Символы.ПС +
		"                    </tl>" + Символы.ПС +
		"                </c>" + Символы.ПС +
		"            </c>" + Символы.ПС +
		"        </row>" + Символы.ПС +
		"    </rowsItem>";
КонецФункции

Функция ОбновитьПереводВТекстеXML(Знач ТекстXML, Знач ИсходнаяСтрока, Знач Перевод)
	ИскомаяСтрока = "<v8:content>" + ПодготовитьТекстДляXML(ИсходнаяСтрока) + "</v8:content>";
	ПозицияИсходнойСтроки = Найти(ТекстXML, ИскомаяСтрока);
	Если ПозицияИсходнойСтроки = 0 Тогда
		Возврат ТекстXML;
	КонецЕсли;

	Остаток = Сред(ТекстXML, ПозицияИсходнойСтроки + СтрДлина(ИскомаяСтрока));
	ПозицияНачалаПеревода = Найти(Остаток, "<v8:content>");
	Если ПозицияНачалаПеревода = 0 Тогда
		Возврат ТекстXML;
	КонецЕсли;

	ПозицияНачалаПеревода = ПозицияИсходнойСтроки + СтрДлина(ИскомаяСтрока) + ПозицияНачалаПеревода - 1;
	ПозицияНачалаЗначения = ПозицияНачалаПеревода + СтрДлина("<v8:content>");
	ОстатокПеревода = Сред(ТекстXML, ПозицияНачалаЗначения);
	ПозицияКонцаПеревода = Найти(ОстатокПеревода, "</v8:content>");
	Если ПозицияКонцаПеревода = 0 Тогда
		Возврат ТекстXML;
	КонецЕсли;

	Возврат Лев(ТекстXML, ПозицияНачалаЗначения - 1) + ПодготовитьТекстДляXML(Перевод) + Сред(ОстатокПеревода, ПозицияКонцаПеревода);
КонецФункции

Функция ЕстьСтрокаВТекстеXML(Знач ТекстXML, Знач ИсходнаяСтрока)
	ИскомаяСтрока = "<v8:content>" + ПодготовитьТекстДляXML(ИсходнаяСтрока) + "</v8:content>";
	Возврат Найти(ТекстXML, ИскомаяСтрока) > 0;
КонецФункции

Процедура ПрименитьПереводыИзФайлаОтчета(Знач Язык, Знач КаталогПроектаПараметр, Знач ПутьКФайлуПереводов)
	КаталогПроекта = НормализоватьКаталог(КаталогПроектаПараметр);
	ПутьКМакету = ОбъединитьПути(КаталогПроекта, "locales");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Messages");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Templates");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, Язык);
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Ext");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Template.xml");

	Если Не Новый Файл(ПутьКФайлуПереводов).Существует() Тогда
		ВывестиСтроку("Не найден файл отчета переводов: " + ПутьКФайлуПереводов);
		ЗавершитьРаботу(4);
	КонецЕсли;

	ПереводыИзОтчета = ПрочитатьПереводыИзФайлаОтчета(ПутьКФайлуПереводов);
	ТекстXML = ПрочитатьТекстФайла(ПутьКМакету);
	Высота = ПолучитьЧислоТега(ТекстXML, "height");
	ВиртуальныеСтроки = ПолучитьЧислоТега(ТекстXML, "vgRows");
	МаксимальныйИндекс = ПолучитьМаксимальныйИндексСтрок(ТекстXML);
	СледующийИндекс = МаксимальныйИндекс + 1;
	Если СледующийИндекс < Высота Тогда
		СледующийИндекс = Высота;
	КонецЕсли;
	Если СледующийИндекс < ВиртуальныеСтроки Тогда
		СледующийИндекс = ВиртуальныеСтроки;
	КонецЕсли;
	КоличествоИзменений = 0;
	КоличествоДобавлений = 0;

	Для Каждого ЗаписьПеревода Из ПереводыИзОтчета Цикл
		Если Не ЗначениеЗаполнено(ЗаписьПеревода.ИсходнаяСтрока) ИЛИ Не ЗначениеЗаполнено(ЗаписьПеревода.Перевод) Тогда
			Продолжить;
		КонецЕсли;

		Если ЕстьСтрокаВТекстеXML(ТекстXML, ЗаписьПеревода.ИсходнаяСтрока) Тогда
			ТекстXML = ОбновитьПереводВТекстеXML(ТекстXML, ЗаписьПеревода.ИсходнаяСтрока, ЗаписьПеревода.Перевод);
			КоличествоИзменений = КоличествоИзменений + 1;
		Иначе
			ПозицияВставки = Найти(ТекстXML, "<height>");
			Если ПозицияВставки = 0 Тогда
				ВывестиСтроку("Не найдено место вставки новых строк в XML-макете.");
				ЗавершитьРаботу(5);
			КонецЕсли;

			НовыйБлок = СоздатьБлокСтрокиМакета(СледующийИндекс, ЗаписьПеревода.ИсходнаяСтрока, ЗаписьПеревода.Перевод);
			ТекстXML = Лев(ТекстXML, ПозицияВставки - 1) + НовыйБлок + Символы.ПС + Сред(ТекстXML, ПозицияВставки);
			СледующийИндекс = СледующийИндекс + 1;
			КоличествоДобавлений = КоличествоДобавлений + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоДобавлений > 0 Тогда
		ТекстXML = ЗаменитьЧислоТега(ТекстXML, "height", СледующийИндекс);
		ТекстXML = ЗаменитьЧислоТега(ТекстXML, "vgRows", СледующийИндекс);
	КонецЕсли;

	Запись = Новый ЗаписьТекста;
	Запись.Открыть(ПутьКМакету, "UTF-8");
	Запись.Записать(ТекстXML);
	Запись.Закрыть();

	ВывестиСтроку(СтрШаблон("Применено переводов: %1. Добавлено новых строк: %2.", КоличествоИзменений, КоличествоДобавлений));
	ВывестиСтроку("Обновлен файл: " + ПутьКМакету);
КонецПроцедуры

Процедура СохранитьОтчетYAML(Знач Язык, Знач КаталогBSL, Знач ПутьКМакету, Знач СтрокиЛокализации, Знач Переводы, Знач ОтсутствующиеСтроки)
	Если Не ЗначениеЗаполнено(ПутьКФайлуОтчета) Тогда
		Возврат;
	КонецЕсли;

	СтрокиYAML = Новый Массив;
	ДобавитьПростоеПолеYAML(СтрокиYAML, "", "language", Язык);
	ДобавитьПростоеПолеYAML(СтрокиYAML, "", "source_directory", ПолучитьОтносительныйПуть(КаталогBSL));
	ДобавитьПростоеПолеYAML(СтрокиYAML, "", "template_path", ПолучитьОтносительныйПуть(ПутьКМакету));
	ДобавитьПростоеПолеYAML(СтрокиYAML, "", "total_unique_strings", Формат(СтрокиЛокализации.Количество(), "ЧГ=0; ЧН=0"));
	ДобавитьПростоеПолеYAML(СтрокиYAML, "", "template_entries", Формат(Переводы.Количество(), "ЧГ=0; ЧН=0"));
	ДобавитьПростоеПолеYAML(СтрокиYAML, "", "missing_count", Формат(ОтсутствующиеСтроки.Количество(), "ЧГ=0; ЧН=0"));
	СтрокиYAML.Добавить("missing_translations:");

	Для Каждого СтрокаОтчета Из ОтсутствующиеСтроки Цикл
		СтрокиYAML.Добавить("  - occurrence_count: " + Формат(СтрокаОтчета.КоличествоВхождений, "ЧГ=0; ЧН=0"));
		ДобавитьСтрокиБлокаYAML(СтрокиYAML, "    ", "source", СтрокаОтчета.ИсходнаяСтрока);
		ДобавитьСтрокиБлокаYAML(СтрокиYAML, "    ", "translation", "");
		СтрокиYAML.Добавить("    occurrences:");
		Для Каждого Вхождение Из СтрокиЛокализации[СтрокаОтчета.ИсходнаяСтрока] Цикл
			СтрокиYAML.Добавить("      - " + Вхождение);
		КонецЦикла;
	КонецЦикла;

	СтрокиОтчета = СтрокиYAML;
	СохранитьОтчет();
КонецПроцедуры

Процедура ПоказатьИспользование()
	ВывестиСтроку("Использование: oscript tools/onescript/CheckMissingTranslations.os <language> [projectRoot]");
	ВывестиСтроку("Или: oscript tools/onescript/CheckMissingTranslations.os <language> apply [projectRoot] [reportFile]");
	ВывестиСтроку("Пример: oscript tools/onescript/CheckMissingTranslations.os en");
	ВывестиСтроку("Пример: oscript tools/onescript/CheckMissingTranslations.os en apply");
КонецПроцедуры

Функция НормализоватьКаталог(Знач ПутьККаталогу)
	Если Не ЗначениеЗаполнено(ПутьККаталогу) Тогда
		Возврат "";
	КонецЕсли;

	ПутьККаталогу = СтрЗаменить(ПутьККаталогу, "/", ПолучитьРазделительПути());
	Если Прав(ПутьККаталогу, 1) <> ПолучитьРазделительПути() Тогда
		ПутьККаталогу = ПутьККаталогу + ПолучитьРазделительПути();
	КонецЕсли;

	Возврат ПутьККаталогу;
КонецФункции

Функция ПрочитатьТекстФайла(Знач ПолноеИмяФайла)
	Чтение = Новый ЧтениеТекста;
	Чтение.Открыть(ПолноеИмяФайла, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Возврат Текст;
КонецФункции

Функция ПолучитьОтносительныйПуть(Знач ПолноеИмяФайла)
	НормКаталогПроекта = НормализоватьКаталог(КаталогПроекта);
	НормПолноеИмя = СтрЗаменить(ПолноеИмяФайла, "/", ПолучитьРазделительПути());

	Если Лев(НормПолноеИмя, СтрДлина(НормКаталогПроекта)) = НормКаталогПроекта Тогда
		Возврат Сред(НормПолноеИмя, СтрДлина(НормКаталогПроекта) + 1);
	КонецЕсли;

	Возврат ПолноеИмяФайла;
КонецФункции

Функция ЭтоПробельныйСимвол(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС;
КонецФункции

Функция ПропуститьПробелы(Знач Текст, Знач Позиция, Знач НомерСтроки)
	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не ЭтоПробельныйСимвол(Символ) Тогда
			Прервать;
		КонецЕсли;

		Если Символ = Символы.ПС Тогда
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Новый Структура("Позиция, НомерСтроки", Позиция, НомерСтроки);
КонецФункции

Функция ПрочитатьСтроковыйЛитерал(Знач Текст, Знач Позиция, Знач НомерСтроки)
	Если Сред(Текст, Позиция, 1) <> """" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияНачалаЛитерала = Позиция;
	Позиция = Позиция + 1;

	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);

		Если Символ = Символы.ПС Тогда
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;

		Если Символ = """" Тогда
			Если Позиция < СтрДлина(Текст) И Сред(Текст, Позиция + 1, 1) = """" Тогда
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;

			СыройЛитерал = Сред(Текст, ПозицияНачалаЛитерала, Позиция - ПозицияНачалаЛитерала + 1);
			ЗначениеСтроки = ВычислитьСтроковыйЛитерал(СыройЛитерал);
			Если ЗначениеСтроки = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;

			Возврат Новый Структура("Значение, Позиция, НомерСтроки", ЗначениеСтроки, Позиция + 1, НомерСтроки);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Функция ВычислитьСтроковыйЛитерал(Знач СыройЛитерал)
	СтрокаДанных = "";

	Попытка
		Выполнить("СтрокаДанных = " + СыройЛитерал + ";");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат СтрокаДанных;
КонецФункции

Процедура ДобавитьВхождение(Знач СтрокиЛокализации, Знач ИсходнаяСтрока, Знач ПолноеИмяФайла, Знач НомерСтроки)
	Если Не ЗначениеЗаполнено(ИсходнаяСтрока) Тогда
		Возврат;
	КонецЕсли;

	Если СтрокиЛокализации.Получить(ИсходнаяСтрока) = Неопределено Тогда
		СтрокиЛокализации.Вставить(ИсходнаяСтрока, Новый Массив);
	КонецЕсли;

	СтрокиЛокализации[ИсходнаяСтрока].Добавить(СтрШаблон("%1:%2", ПолучитьОтносительныйПуть(ПолноеИмяФайла), Формат(НомерСтроки, "ЧГ=0; ЧН=0")));
КонецПроцедуры

Процедура СобратьСтрокиЛокализацииИзФайла(Знач ПолноеИмяФайла, Знач СтрокиЛокализации)
	Текст = ПрочитатьТекстФайла(ПолноеИмяФайла);
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	ИскомоеСлово = "Локализовать";
	ДлинаИскомогоСлова = СтрДлина(ИскомоеСлово);
	Позиция = 1;
	НомерСтроки = 1;
	ДлинаТекста = СтрДлина(Текст);

	Пока Позиция <= ДлинаТекста Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = Символы.ПС Тогда
			НомерСтроки = НомерСтроки + 1;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Позиция + ДлинаИскомогоСлова - 1 <= ДлинаТекста
			И Сред(Текст, Позиция, ДлинаИскомогоСлова) = ИскомоеСлово Тогда

			НомерСтрокиВызова = НомерСтроки;
			ПозицияПослеИмени = Позиция + ДлинаИскомогоСлова;
			Пробелы = ПропуститьПробелы(Текст, ПозицияПослеИмени, НомерСтроки);
			ПозицияПослеИмени = Пробелы.Позиция;
			НомерСтроки = Пробелы.НомерСтроки;

			Если ПозицияПослеИмени <= ДлинаТекста И Сред(Текст, ПозицияПослеИмени, 1) = "(" Тогда
				Параметр = ПропуститьПробелы(Текст, ПозицияПослеИмени + 1, НомерСтроки);
				Если Параметр.Позиция <= ДлинаТекста И Сред(Текст, Параметр.Позиция, 1) = """" Тогда
					Литерал = ПрочитатьСтроковыйЛитерал(Текст, Параметр.Позиция, Параметр.НомерСтроки);
					Если Литерал <> Неопределено Тогда
						ДобавитьВхождение(СтрокиЛокализации, Литерал.Значение, ПолноеИмяФайла, НомерСтрокиВызова);
						Позиция = Литерал.Позиция;
						НомерСтроки = Литерал.НомерСтроки;
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;
КонецПроцедуры

Функция СобратьСтрокиЛокализации(Знач КаталогBSL)
	СтрокиЛокализации = Новый Соответствие;
	ФайлыBSL = НайтиФайлы(КаталогBSL, "*.bsl", Истина);

	Для Каждого ФайлBSL Из ФайлыBSL Цикл
		Если ФайлBSL.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;

		СобратьСтрокиЛокализацииИзФайла(ФайлBSL.ПолноеИмя, СтрокиЛокализации);
	КонецЦикла;

	Возврат СтрокиЛокализации;
КонецФункции

Функция ПрочитатьПереводыИзМакета(Знач ПолноеИмяФайлаМакета)
	Переводы = Новый Соответствие;
	ЧитательXML = Новый ЧтениеXML;
	ЧитательXML.ОткрытьФайл(ПолноеИмяФайлаМакета);

	ТекущийЭлемент = "";
	ВнутриСтроки = Ложь;
	ГлубинаЯчейки = 0;
	ИндексЯчейки = -1;
	ЗначенияСтроки = Новый Соответствие;

	Пока ЧитательXML.Прочитать() Цикл
		Если ЧитательXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТекущийЭлемент = ЧитательXML.Имя;

			Если ТекущийЭлемент = "row" Тогда
				ВнутриСтроки = Истина;
				ГлубинаЯчейки = 0;
				ИндексЯчейки = -1;
				ЗначенияСтроки = Новый Соответствие;
			ИначеЕсли ВнутриСтроки И ТекущийЭлемент = "c" Тогда
				ГлубинаЯчейки = ГлубинаЯчейки + 1;
				Если ГлубинаЯчейки = 1 Тогда
					ИндексЯчейки = ИндексЯчейки + 1;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЧитательXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Если ВнутриСтроки И ТекущийЭлемент = "v8:content" Тогда
				КлючЯчейки = Строка(ИндексЯчейки);
				Если ЗначенияСтроки.Получить(КлючЯчейки) = Неопределено Тогда
					ЗначенияСтроки.Вставить(КлючЯчейки, ЧитательXML.Значение);
				Иначе
					Если Прав(ЗначенияСтроки[КлючЯчейки], 1) <> Символы.ПС
						И Лев(ЧитательXML.Значение, 1) <> Символы.ПС Тогда
						ЗначенияСтроки[КлючЯчейки] = ЗначенияСтроки[КлючЯчейки] + Символы.ПС + ЧитательXML.Значение;
					Иначе
						ЗначенияСтроки[КлючЯчейки] = ЗначенияСтроки[КлючЯчейки] + ЧитательXML.Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЧитательXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ВнутриСтроки И ЧитательXML.Имя = "c" Тогда
				ГлубинаЯчейки = ГлубинаЯчейки - 1;
			ИначеЕсли ЧитательXML.Имя = "row" Тогда
				ВнутриСтроки = Ложь;

				ИсходнаяСтрока = "";
				ПереводСтроки = "";
				Если ЗначенияСтроки.Получить("0") <> Неопределено Тогда
					ИсходнаяСтрока = ЗначенияСтроки["0"];
				КонецЕсли;
				Если ЗначенияСтроки.Получить("1") <> Неопределено Тогда
					ПереводСтроки = ЗначенияСтроки["1"];
				КонецЕсли;

				Если ЗначениеЗаполнено(ИсходнаяСтрока) И ИсходнаяСтрока <> "Строка поиска" Тогда
					Переводы.Вставить(ИсходнаяСтрока, ПереводСтроки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЧитательXML.Закрыть();

	Возврат Переводы;
КонецФункции

Функция ВывестиОтсутствующиеПереводы(Знач СтрокиЛокализации, Знач Переводы, Знач Язык)
	ОтсутствующиеСтроки = Новый ТаблицаЗначений;
	ОтсутствующиеСтроки.Колонки.Добавить("ИсходнаяСтрока");
	ОтсутствующиеСтроки.Колонки.Добавить("КоличествоВхождений");

	ВсегоУникальныхСтрок = 0;
	Для Каждого Пара Из СтрокиЛокализации Цикл
		ВсегоУникальныхСтрок = ВсегоУникальныхСтрок + 1;

		Если Переводы.Получить(Пара.Ключ) = Неопределено ИЛИ Не ЗначениеЗаполнено(Переводы[Пара.Ключ]) Тогда
			НоваяСтрока = ОтсутствующиеСтроки.Добавить();
			НоваяСтрока.ИсходнаяСтрока = Пара.Ключ;
			НоваяСтрока.КоличествоВхождений = Пара.Значение.Количество();
		КонецЕсли;
	КонецЦикла;

	Если ОтсутствующиеСтроки.Количество() = 0 Тогда
		ВывестиСтроку(СтрШаблон("Для языка %1 отсутствующих переводов не найдено. Проверено уникальных строк: %2.", Язык, Формат(ВсегоУникальныхСтрок, "ЧГ=0; ЧН=0")));
		Возврат ОтсутствующиеСтроки;
	КонецЕсли;

	ОтсутствующиеСтроки.Сортировать("ИсходнаяСтрока");
	ВывестиСтроку(СтрШаблон("Для языка %1 отсутствует %2 переводов из %3 уникальных строк:", Язык, Формат(ОтсутствующиеСтроки.Количество(), "ЧГ=0; ЧН=0"), Формат(ВсегоУникальныхСтрок, "ЧГ=0; ЧН=0")));

	Номер = 0;
	Для Каждого СтрокаОтчета Из ОтсутствующиеСтроки Цикл
		Номер = Номер + 1;
		ВывестиСтроку("");
		ВывестиСтроку(СтрШаблон("%1. %2", Формат(Номер, "ЧГ=0; ЧН=0"), СтрокаОтчета.ИсходнаяСтрока));
		Для Каждого Вхождение Из СтрокиЛокализации[СтрокаОтчета.ИсходнаяСтрока] Цикл
			ВывестиСтроку("   " + Вхождение);
		КонецЦикла;
	КонецЦикла;

	Возврат ОтсутствующиеСтроки;
КонецФункции

Процедура ВыполнитьПроверку(Знач Язык, Знач КаталогПроектаПараметр)
	КаталогПроекта = НормализоватьКаталог(КаталогПроектаПараметр);
	КаталогBSL = ОбъединитьПути(КаталогПроекта, "VanessaAutomation");
	ПутьКМакету = ОбъединитьПути(КаталогПроекта, "locales");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Messages");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Templates");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, Язык);
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Ext");
	ПутьКМакету = ОбъединитьПути(ПутьКМакету, "Template.xml");
	ПутьКФайлуОтчета = ОбъединитьПути(КаталогПроекта, СтрШаблон("missing-translations-%1.yaml", Язык));

	Если Не Новый Файл(КаталогBSL).Существует() Тогда
		ВывестиСтроку("Не найден каталог VanessaAutomation: " + КаталогBSL);
		ЗавершитьРаботу(2);
	КонецЕсли;

	Если Не Новый Файл(ПутьКМакету).Существует() Тогда
		ВывестиСтроку("Не найден файл макета переводов: " + ПутьКМакету);
		ЗавершитьРаботу(3);
	КонецЕсли;

	ВывестиСтроку("Собираю строки локализации из BSL...");
	СтрокиЛокализации = СобратьСтрокиЛокализации(КаталогBSL);
	ВывестиСтроку(СтрШаблон("Найдено уникальных строк: %1", Формат(СтрокиЛокализации.Количество(), "ЧГ=0; ЧН=0")));

	ВывестиСтроку("Читаю макет переводов...");
	Переводы = ПрочитатьПереводыИзМакета(ПутьКМакету);
	ВывестиСтроку(СтрШаблон("Найдено строк в макете: %1", Формат(Переводы.Количество(), "ЧГ=0; ЧН=0")));

	ОтсутствующиеСтроки = ВывестиОтсутствующиеПереводы(СтрокиЛокализации, Переводы, Язык);
	СохранитьОтчетYAML(Язык, КаталогBSL, ПутьКМакету, СтрокиЛокализации, Переводы, ОтсутствующиеСтроки);
КонецПроцедуры

СтрокиОтчета = Новый Массив;

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	ПоказатьИспользование();
	ЗавершитьРаботу(1);
КонецЕсли;

Язык = СокрЛП(АргументыКоманднойСтроки[0]);
Если Не ЗначениеЗаполнено(Язык) Тогда
	ПоказатьИспользование();
	ЗавершитьРаботу(1);
КонецЕсли;

Режим = "generate";
КаталогПроекта = ТекущийКаталог();
ПутьКФайлуОтчета = "";

Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	Если НРег(СокрЛП(АргументыКоманднойСтроки[1])) = "apply" Тогда
		Режим = "apply";
		Если АргументыКоманднойСтроки.Количество() > 2 Тогда
			КаталогПроекта = АргументыКоманднойСтроки[2];
		КонецЕсли;
		Если АргументыКоманднойСтроки.Количество() > 3 Тогда
			ПутьКФайлуОтчета = АргументыКоманднойСтроки[3];
		КонецЕсли;
	Иначе
		КаталогПроекта = АргументыКоманднойСтроки[1];
	КонецЕсли;
КонецЕсли;

КаталогПроекта = НормализоватьКаталог(КаталогПроекта);
Если Не ЗначениеЗаполнено(ПутьКФайлуОтчета) Тогда
	ПутьКФайлуОтчета = ОбъединитьПути(КаталогПроекта, СтрШаблон("missing-translations-%1.yaml", Язык));
КонецЕсли;

Если Режим = "apply" Тогда
	ПрименитьПереводыИзФайлаОтчета(Язык, КаталогПроекта, ПутьКФайлуОтчета);
	ЗавершитьРаботу(0);
КонецЕсли;

ВыполнитьПроверку(Язык, КаталогПроекта);