// Удаляет ведущие нули в числовых частях версии: 1.2.043.46 -> 1.2.43.46.
// Нечисловые части (например, суффикс -SNAPSHOT) не меняются.
// ЧГ=0 - без группировки разрядов, ЧН=0 - ноль как "0" (иначе Формат отдаёт для нуля пустую строку).
Функция НормализоватьВерсиюПакета(Знач Версия)
	ЧастиВерсии = СтрРазделить(Версия, ".");
	Для Сч = 0 По ЧастиВерсии.Количество()-1 Цикл
		ЧислоЧасти = Неопределено;
		Попытка
			ЧислоЧасти = Число(ЧастиВерсии[Сч]);
		Исключение
		КонецПопытки;
		Если ЧислоЧасти <> Неопределено Тогда
			ЧастиВерсии[Сч] = Формат(ЧислоЧасти, "ЧГ=0; ЧН=0");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(ЧастиВерсии, ".");
КонецФункции

ФайлСкрипта = Новый Файл(ТекущийСценарий().Каталог);
КаталогTools = Новый Файл(ФайлСкрипта.Путь);
ОсновнойКаталог = Новый Файл(КаталогTools.Путь);

ПутьКМодулюОбработки = ОбъединитьПути(ОсновнойКаталог.ПолноеИмя,"VanessaAutomationsingle\Ext\ObjectModule.bsl");
ЧтениеТекста = Новый ЧтениеТекста(ПутьКМодулюОбработки, КодировкаТекста.UTF8);

Содержимое = ЧтениеТекста.Прочитать();
ЧтениеТекста.Закрыть();

СтрокаПоиска = "Версия = ";
МассивСтрок = СтрРазделить(Содержимое, Символы.ПС);
Для Сч = 0 По МассивСтрок.Количество()-1 Цикл
	МассивСтрок[Сч] = "  " + МассивСтрок[Сч];
	Поз = Найти(МассивСтрок[Сч], СтрокаПоиска);
	Если Поз > 0 Тогда
		ВерсияПродукта = СокрЛП(Сред(МассивСтрок[Сч], Поз + 1 + СтрДлина(СтрокаПоиска)));
		ВерсияПродукта = СтрЗаменить(ВерсияПродукта, ";", "");
		ВерсияПродукта = СтрЗаменить(ВерсияПродукта, """", "");
		Прервать;
	КонецЕсли;
КонецЦикла;	

ВерсияПродукта = НормализоватьВерсиюПакета(ВерсияПродукта);

Сообщить("ВерсияПродукта=" + ВерсияПродукта);

Описание.Имя("vanessa-automation-single")
		.Автор("Leonid Pautov")
		.Версия(ВерсияПродукта)
		.ВключитьФайл("README.md")
		.ВключитьФайл("LICENSE")
		.ВключитьФайл("NOTICE.txt")
		.ВключитьФайл("licenses")
		.ВключитьФайл("vanessa-automation-single.epf")
;
