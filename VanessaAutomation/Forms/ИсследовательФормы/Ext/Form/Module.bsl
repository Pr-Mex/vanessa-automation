&НаКлиенте
Функция MCPСформироватьРезультатЧтенияФормы(МаксГлубина = Неопределено, ТолькоВидимые = Ложь, Компактно = Ложь)

	Строки = Новый Массив;
	MCPДобавитьСтрокиДереваФормы(ДеревоФормы.ПолучитьЭлементы(), 0, Строки, МаксГлубина, ТолькоВидимые, Истина, Неопределено, Компактно);
	ДанныеДерева = Ванесса._СтрСоединить(Строки, Символы.ПС);

	Результат = Новый Структура;
	Результат.Вставить("treeText", ДанныеДерева);
	Результат.Вставить("stepText", ТекстШагов.ПолучитьТекст());
	Если MCPФорматЧтенияФормы = "buttons" Тогда
		// buttonsCount = 0 означает, что кнопок на форме нет: MCP-слой покажет сообщение вместо скелета дерева.
		КнопокНайдено = 0;
		MCPПосчитатьКнопкиВДереве(ДеревоФормы.ПолучитьЭлементы(), КнопокНайдено);
		Результат.Вставить("buttonsCount", КнопокНайдено);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура MCPПосчитатьКнопкиВДереве(ЭлементыДерева, КнопокНайдено)
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева.ТипСтрока = Строка(Тип("ТестируемаяКнопкаФормы")) Тогда
			КнопокНайдено = КнопокНайдено + 1;
		КонецЕсли;
		MCPПосчитатьКнопкиВДереве(ЭлементДерева.ПолучитьЭлементы(), КнопокНайдено);
	КонецЦикла;
КонецПроцедуры

// Ограничивает результат чтения формы одной таблицей: в treeText остаются таблица и её колонки,
// а в режиме buttons - кнопки командной панели этой таблицы.
// Если таблица не найдена, в результат добавляются данные для сообщения об ошибке.
&НаКлиенте
Процедура MCPОграничитьРезультатОднойТаблицей(Результат, ИмяТаблицыФормы, Компактно = Ложь)
	
	СтрокиТаблиц = Новый Массив;
	УзелТаблицы = MCPНайтиУзелТаблицыФормы(ДеревоФормы.ПолучитьЭлементы(), ИмяТаблицыФормы, СтрокиТаблиц);
	
	Результат.Вставить("onlyTableName", ИмяТаблицыФормы);
	Результат.Вставить("tablesList", Ванесса._СтрСоединить(СтрокиТаблиц, ", "));
	
	Если УзелТаблицы = Неопределено Тогда
		Результат.Вставить("onlyTableFound", Ложь);
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("onlyTableFound", Истина);
	Если MCPФорматЧтенияФормы = "buttons" Тогда
		// В режиме buttons по выбранной таблице нужны не колонки, а кнопки её командной панели,
		// поэтому выводим поддерево таблицы тем же способом, что и для группы.
		Строки = Новый Массив;
		УзелДляВывода = Новый Массив;
		УзелДляВывода.Добавить(УзелТаблицы);
		MCPДобавитьСтрокиДереваФормы(УзелДляВывода, 0, Строки, Неопределено, Ложь, Истина, 0, Компактно);
		Результат.treeText = Ванесса._СтрСоединить(Строки, Символы.ПС);
	Иначе
		Результат.treeText = MCPТекстТаблицыФормы(УзелТаблицы, Компактно);
	КонецЕсли;
	
	// В режиме buttons счётчик пересчитывается по выбранной таблице: иначе кнопки в других
	// местах формы скрывали бы сообщение о том, что в этой таблице кнопок нет.
	Если Результат.Свойство("buttonsCount") Тогда
		КнопокНайдено = 0;
		MCPПосчитатьКнопкиВДереве(УзелТаблицы.ПолучитьЭлементы(), КнопокНайдено);
		Результат.buttonsCount = КнопокНайдено;
	КонецЕсли;
	
КонецПроцедуры

// Ищет узел таблицы формы по имени элемента или заголовку; попутно собирает список таблиц формы.
&НаКлиенте
Функция MCPНайтиУзелТаблицыФормы(ЭлементыДерева, ИмяТаблицыФормы, СтрокиТаблиц)
	
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева.ТипСтрока = Строка(Тип("ТестируемаяТаблицаФормы")) Тогда
			СтрокиТаблиц.Добавить(ЭлементДерева.Синоним + " [" + ЭлементДерева.Имя + "]");
			Если НРег(СокрЛП(ЭлементДерева.Имя)) = НРег(ИмяТаблицыФормы)
				ИЛИ НРег(СокрЛП(ЭлементДерева.Синоним)) = НРег(ИмяТаблицыФормы) Тогда
				Возврат ЭлементДерева;
			КонецЕсли;
		КонецЕсли;
		
		Найденный = MCPНайтиУзелТаблицыФормы(ЭлементДерева.ПолучитьЭлементы(), ИмяТаблицыФормы, СтрокиТаблиц);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Строит текст по одной таблице: строка таблицы и строка на каждую колонку (имя, заголовок,
// видимость, только просмотр). Компактный вывод дополнительно сокращает имена через общее правило.
&НаКлиенте
Функция MCPТекстТаблицыФормы(УзелТаблицы, Компактно = Ложь)
	
	Строки = Новый Массив;
	ТипКолонки = Строка(Тип("ТестируемоеПолеФормы"));
	
	Если Компактно Тогда
		ТипыПоУровням = Новый Соответствие;
		Строки.Добавить(MCPКомпактнаяСтрока(0, 0, УзелТаблицы, УзелТаблицы.ТекущаяВидимость, Истина, УзелТаблицы.ТекущееТолькоПросмотр, Неопределено, ТипыПоУровням, Истина));
		КолонокДобавлено = 0;
		Для Каждого ЭлементДерева Из УзелТаблицы.ПолучитьЭлементы() Цикл
			Если ЭлементДерева.ТипСтрока <> ТипКолонки Тогда
				Продолжить;
			КонецЕсли;
			КолонокДобавлено = КолонокДобавлено + 1;
			Строки.Добавить(MCPКомпактнаяСтрока(1, 0, ЭлементДерева, ЭлементДерева.ТекущаяВидимость, Истина, ЭлементДерева.ТекущееТолькоПросмотр, УзелТаблицы, ТипыПоУровням, Истина));
		КонецЦикла;
		
		Если КолонокДобавлено = 0 Тогда
			Строки.Добавить(" " + Ванесса.Локализовать("Колонки таблицы не найдены."));
		КонецЕсли;
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить("- " + УзелТаблицы.Синоним + " [" + УзелТаблицы.Имя + "] {" + УзелТаблицы.ТипСтрока + "} {" + Ванесса.Локализовать("Видимость") + ":" + УзелТаблицы.ТекущаяВидимость + "}");
	
	КолонокДобавлено = 0;
	Для Каждого ЭлементДерева Из УзелТаблицы.ПолучитьЭлементы() Цикл
		Если ЭлементДерева.ТипСтрока <> ТипКолонки Тогда
			Продолжить;
		КонецЕсли;
		КолонокДобавлено = КолонокДобавлено + 1;
		Строки.Добавить(Лев("------------------------------", 1) + "- " + ЭлементДерева.Синоним + " [" + ЭлементДерева.Имя + "] {" + ЭлементДерева.ТипСтрока + "} {" + Ванесса.Локализовать("Видимость") + ":" + ЭлементДерева.ТекущаяВидимость + "} {" + Ванесса.Локализовать("ТолькоПросмотр") + ":" + ЭлементДерева.ТекущееТолькоПросмотр + "}");
	КонецЦикла;
	
	Если КолонокДобавлено = 0 Тогда
		Строки.Добавить(Лев("------------------------------", 1) + "- " + Ванесса.Локализовать("Колонки таблицы не найдены."));
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции


// Строит строки дерева формы для MCP.
// Ограничение по глубине отсчитывается от формы: 1 - только элементы верхнего уровня формы.
// Если формы в выводе нет (вывод одной группы), корневой уровень отсчёта задаётся вызовом - уровнем группы.
// Компактно = Истина собирает строки компактного формата (код типа, состояние, сокращённые имена).
&НаКлиенте
Процедура MCPДобавитьСтрокиДереваФормы(ЭлементыДерева, Уровень, Строки, МаксГлубина = Неопределено, ТолькоВидимые = Ложь, РодительВиден = Истина, УровеньКорняГлубины = Неопределено, Компактно = Ложь, РодительУзел = Неопределено, ТипыПоУровням = Неопределено)

	Если ТипыПоУровням = Неопределено Тогда
		ТипыПоУровням = Новый Соответствие;
	КонецЕсли;

	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева.ТипСтрока = "Тестируемое окно клиентского приложения" Тогда
			ТекВидимостьЭлемента = Истина;
		ИначеЕсли ЭлементДерева.ТипСтрока = "Тестируемая форма" Тогда
			ТекВидимостьЭлемента = Истина;
		Иначе
			ТекВидимостьЭлемента = ЭлементДерева.ТекущаяВидимость;
		КонецЕсли;

		// Корень отсчёта глубины - форма; если формы в выводе нет, он задан вызывающей стороной.
		Если УровеньКорняГлубины = Неопределено И ЭлементДерева.ТипСтрока = "Тестируемая форма" Тогда
			УровеньКорняГлубины = Уровень;
		КонецЕсли;
		
		// Ограничение по глубине: 1 - только элементы верхнего уровня формы (группы) и так далее.
		Если МаксГлубина <> Неопределено И УровеньКорняГлубины <> Неопределено
			И (Уровень - УровеньКорняГлубины) > МаксГлубина Тогда
			Продолжить;
		КонецЕсли;

		ЭлементВиден = Истина;
		Если ТолькоВидимые И (НЕ РодительВиден ИЛИ НЕ ТекВидимостьЭлемента) Тогда
			ЭлементВиден = Ложь;
		КонецЕсли;

		Если ЭлементВиден Тогда
			Если Компактно Тогда
				СПрефиксомСостояния = Ложь;
				Если НЕ MCPБезСостоянияВКомпактномВыводе(ЭлементДерева.ТипСтрока) Тогда
					СПрефиксомСостояния = Истина;
				КонецЕсли;
				Строки.Добавить(MCPКомпактнаяСтрока(Уровень, УровеньКорняГлубины, ЭлементДерева, ТекВидимостьЭлемента, РодительВиден, ЭлементДерева.ТекущееТолькоПросмотр, РодительУзел, ТипыПоУровням, СПрефиксомСостояния));
			Иначе
				Строки.Добавить(Лев("------------------------------", Уровень) + "- " + ЭлементДерева.Синоним + " [" + ЭлементДерева.Имя + "] {" + ЭлементДерева.ТипСтрока + "} {" + Ванесса.Локализовать("Видимость") + ":" + ТекВидимостьЭлемента + "}");
			КонецЕсли;
		КонецЕсли;
		MCPДобавитьСтрокиДереваФормы(ЭлементДерева.ПолучитьЭлементы(), Уровень + 1, Строки, МаксГлубина, ТолькоВидимые, ЭлементВиден, УровеньКорняГлубины, Компактно, ЭлементДерева, ТипыПоУровням);
	КонецЦикла;

КонецПроцедуры

// Код типа элемента для компактного вывода. Неизвестный тип помечается "?" и раскрывается полным именем типа.
&НаКлиенте
Функция MCPКодТипаЭлементаДерева(ТипСтрока)
	
	Если ТипСтрока = Строка(Тип("ТестируемоеОкноКлиентскогоПриложения")) Тогда
		Возврат "О";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяФорма")) Тогда
		Возврат "Ф";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяГруппаФормы")) Тогда
		Возврат "Г";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяКнопкаФормы")) Тогда
		Возврат "К";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемоеПолеФормы")) Тогда
		Возврат "П";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяТаблицаФормы")) Тогда
		Возврат "Т";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяДекорацияФормы")) Тогда
		Возврат "Д";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемыйКомандныйИнтерфейсОкна")) Тогда
		Возврат "И";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяКнопкаКомандногоИнтерфейса")) Тогда
		Возврат "к";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемаяГруппаКомандногоИнтерфейса")) Тогда
		Возврат "г";
	ИначеЕсли ТипСтрока = Строка(Тип("ТестируемоеДополнениеЭлементаФормы")) Тогда
		Возврат "п";
	Иначе
		Возврат "?" + ТипСтрока;
	КонецЕсли;
	
КонецФункции

// Признак того, что у элемента в компактном выводе состояние не показывается (окно, форма, командный интерфейс).
&НаКлиенте
Функция MCPБезСостоянияВКомпактномВыводе(ТипСтрока)
	
	Возврат ТипСтрока = Строка(Тип("ТестируемоеОкноКлиентскогоПриложения"))
		ИЛИ ТипСтрока = Строка(Тип("ТестируемаяФорма"))
		ИЛИ ТипСтрока = Строка(Тип("ТестируемыйКомандныйИнтерфейсОкна"));
	
КонецФункции

// Код состояния элемента для компактного вывода: "+" видим, "~" невидим, "R" только просмотр, "-" невидим и только просмотр.
&НаКлиенте
Функция MCPСимволСостоянияЭлемента(Виден, ТолькоПросмотр)
	
	Если Виден = Истина И ТолькоПросмотр = Истина Тогда
		Возврат "R";
	ИначеЕсли Виден = Истина Тогда
		Возврат "+";
	ИначеЕсли ТолькоПросмотр = Истина Тогда
		Возврат "-";
	Иначе
		Возврат "~";
	КонецЕсли;
	
КонецФункции

// Собирает одну строку компактного вывода: "<отступ пробелами> <код типа><состояние> <заголовок> [внутреннее имя]".
// Внутреннее имя сокращается: [=] если совпадает с заголовком, [^...] через непосредственного родителя,
// [] для пустого имени. Тип опускается, если совпал с типом предыдущего выведенного соседа того же уровня.
&НаКлиенте
Функция MCPКомпактнаяСтрока(Уровень, УровеньКорняГлубины, ЭлементДерева, Виден, РодительВиден, ТолькоПросмотр, РодительУзел, ТипыПоУровням, СПрефиксомСостояния)
	
	КодТипа = MCPКодТипаЭлементаДерева(ЭлементДерева.ТипСтрока);
	
	// Для окна, формы и командного интерфейса состояние не выводится (заглушка пробелом, чтобы колонки не сбивались).
	Состояние = " ";
	Если СПрефиксомСостояния Тогда
		ТекВидимость = Истина;
		Если Виден = Ложь ИЛИ РодительВиден = Ложь Тогда
			ТекВидимость = Ложь;
		КонецЕсли;
		ТекТолькоПросмотр = Ложь;
		Если ТолькоПросмотр = Истина Тогда
			ТекТолькоПросмотр = Истина;
		КонецЕсли;
		Состояние = MCPСимволСостоянияЭлемента(ТекВидимость, ТекТолькоПросмотр);
	КонецЕсли;
	
	Отступ = Уровень;
	Если УровеньКорняГлубины <> Неопределено Тогда
		Отступ = Уровень - УровеньКорняГлубины;
	КонецЕсли;
	Если Отступ < 0 Тогда
		Отступ = 0;
	КонецЕсли;
	
	ЗаголовокЭлемента = СокрЛП(СтрЗаменить(СтрЗаменить(Строка(ЭлементДерева.Синоним), Символы.ПС, " "), Символы.Таб, " "));
	ИмяЭлемента = СокрЛП(Строка(ЭлементДерева.Имя));
	
	ТекстИмени = "";
	Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
		Если ИмяЭлемента = ЗаголовокЭлемента Тогда
			ТекстИмени = " [=]";
		Иначе
			ТекстИмени = " " + MCPКраткоеИмяЭлемента(ИмяЭлемента, РодительУзел);
		КонецЕсли;
	Иначе
		ТекстИмени = " []";
	КонецЕсли;
	
	// Тип наследуется от предыдущего выведенного соседа того же уровня.
	ПредыдущийТип = ТипыПоУровням.Получить(Отступ);
	ТипыПоУровням.Вставить(Отступ, КодТипа);
	Если ПредыдущийТип = КодТипа Тогда
		КодТипа = "";
	КонецЕсли;
	
	Возврат Лев("                                        ", Отступ) + СокрЛП(КодТипа + Состояние) + " " + ЗаголовокЭлемента + ТекстИмени;
	
КонецФункции

// Внутреннее имя элемента в компактном виде: "[Имя]" или сокращение "[^Суффикс]" через непосредственного
// родителя, если его имя является началом внутреннего имени элемента.
&НаКлиенте
Функция MCPКраткоеИмяЭлемента(ИмяЭлемента, РодительУзел)
	
	Если РодительУзел = Неопределено Тогда
		Возврат "[" + ИмяЭлемента + "]";
	КонецЕсли;
	
	ТипРодителя = ТипЗнч(РодительУзел);
	Если ТипРодителя = Тип("ДанныеФормыЭлементДерева") ИЛИ ТипРодителя = Тип("СтрокаДереваЗначений") Тогда
		ИмяПредка = СокрЛП(Строка(РодительУзел.Имя));
		Если ЗначениеЗаполнено(ИмяПредка) И ИмяПредка <> ИмяЭлемента И Лев(ИмяЭлемента, СтрДлина(ИмяПредка)) = ИмяПредка Тогда
			Остаток = Сред(ИмяЭлемента, СтрДлина(ИмяПредка) + 1);
			Если Лев(Остаток, 2) = "__" Тогда
				Возврат "[^ " + Сред(Остаток, 3) + "]";
			Иначе
				Возврат "[^" + Остаток + "]";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "[" + ИмяЭлемента + "]";
	
КонецФункции

// Ищет узел группы формы по имени элемента или заголовку; попутно собирает список групп формы.
&НаКлиенте
Функция MCPНайтиУзелГруппыФормы(ЭлементыДерева, ИмяГруппыФормы, СтрокиГрупп)
	
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если ЭлементДерева.ТипСтрока = Строка(Тип("ТестируемаяГруппаФормы")) Тогда
			СтрокиГрупп.Добавить(ЭлементДерева.Синоним + " [" + ЭлементДерева.Имя + "]");
			Если НРег(СокрЛП(ЭлементДерева.Имя)) = НРег(ИмяГруппыФормы)
				ИЛИ НРег(СокрЛП(ЭлементДерева.Синоним)) = НРег(ИмяГруппыФормы) Тогда
				Возврат ЭлементДерева;
			КонецЕсли;
		КонецЕсли;
		
		Найденный = MCPНайтиУзелГруппыФормы(ЭлементДерева.ПолучитьЭлементы(), ИмяГруппыФормы, СтрокиГрупп);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Ограничивает результат чтения формы одной группой (закладкой): в treeText остаются группа и её содержимое.
// Если группа не найдена, в результат добавляются данные для сообщения об ошибке.
&НаКлиенте
Процедура MCPОграничитьРезультатОднойГруппой(Результат, ИмяГруппыФормы, МаксГлубина = Неопределено, ТолькоВидимые = Ложь, Компактно = Ложь)
	
	СтрокиГрупп = Новый Массив;
	УзелГруппы = MCPНайтиУзелГруппыФормы(ДеревоФормы.ПолучитьЭлементы(), ИмяГруппыФормы, СтрокиГрупп);
	
	Результат.Вставить("onlyGroupName", ИмяГруппыФормы);
	Результат.Вставить("groupsList", Ванесса._СтрСоединить(СтрокиГрупп, ", "));
	
	Если УзелГруппы = Неопределено Тогда
		Результат.Вставить("onlyGroupFound", Ложь);
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("onlyGroupFound", Истина);
	
	Строки = Новый Массив;
	УзелДляВывода = Новый Массив;
	УзелДляВывода.Добавить(УзелГруппы);
	// Корень отсчёта глубины - сама группа: 1 - элементы её верхнего уровня.
	MCPДобавитьСтрокиДереваФормы(УзелДляВывода, 0, Строки, МаксГлубина, ТолькоВидимые, Истина, 0, Компактно);
	Результат.treeText = Ванесса._СтрСоединить(Строки, Символы.ПС);
	
	// В режиме buttons счётчик пересчитывается по выбранной группе: иначе кнопки в других
	// местах формы скрывали бы сообщение о том, что в этой группе кнопок нет.
	Если Результат.Свойство("buttonsCount") Тогда
		КнопокНайдено = 0;
		MCPПосчитатьКнопкиВДереве(УзелГруппы.ПолучитьЭлементы(), КнопокНайдено);
		Результат.buttonsCount = КнопокНайдено;
	КонецЕсли;
	
КонецПроцедуры

  #КонецОбласти

#КонецОбласти
