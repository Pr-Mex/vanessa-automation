&НаКлиенте
Функция ПолучитьТекстРедактированияЭлементаФормы(ПолеРеквизит)

	Если Ванесса.Версия8323ИлиВыше Тогда
		ТекстРедактирования = ПолеРеквизит.ПолучитьТекстРедактирования();
		Если НЕ ЗначениеЗаполнено(ТекстРедактирования) Тогда
			Попытка
				Возврат ПолеРеквизит.ПолучитьПредставлениеДанных();
			Исключение
				Возврат ТекстРедактирования;
			КонецПопытки;
		Иначе
			Возврат ТекстРедактирования;
		КонецЕсли;
	Иначе
		Возврат ПолеРеквизит.ПолучитьТекстРедактирования();
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ПолучитьТекстЯчейкиТаблицы(ЭлементТаблица, ЭлементФормы)
	Если Ванесса.Версия8323ИлиВыше Тогда
		ТекстЯчейки = ЭлементТаблица.ПолучитьТекстЯчейки(ЭлементФормы.Имя);
		Если НЕ ЗначениеЗаполнено(ТекстЯчейки) Тогда
			Попытка
				ТекстЯчейки = ЭлементТаблица.ПолучитьТекущийЭлемент().ПолучитьПредставлениеДанных();

				Если НЕ ЗначениеЗаполнено(ТекстЯчейки) Тогда
					Возврат ЭлементТаблица.ПолучитьТекущийЭлемент().ПолучитьОтображаемыйТекст();
				КонецЕсли;

				Возврат ЭлементТаблица.ПолучитьТекущийЭлемент().ПолучитьПредставлениеДанных();
			Исключение
				Возврат ТекстЯчейки;
			КонецПопытки;
		Иначе
			Возврат ТекстЯчейки;
		КонецЕсли;
	Иначе
		Возврат ЭлементТаблица.ПолучитьТекстЯчейки(ЭлементФормы.Имя);
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция НастройкамиПереданоДобавлятьТакойЭлемент(Элем, РазрешитьКонтейнерыКнопок = Ложь)

	Если MCPФорматЧтенияФормы = "buttons" Тогда
		// РазрешитьКонтейнерыКнопок: в дереве заходим и в таблицы - до кнопок их командных панелей.
		Если ТипЗнч(Элем) = Тип("ТестируемаяКнопкаФормы")
			ИЛИ ТипЗнч(Элем) = Тип("ТестируемаяГруппаФормы")
			ИЛИ ТипЗнч(Элем) = Тип("ТестируемыйКомандныйИнтерфейсОкна")
			ИЛИ ТипЗнч(Элем) = Тип("ТестируемаяФорма")
			ИЛИ (РазрешитьКонтейнерыКнопок И ТипЗнч(Элем) = Тип("ТестируемаяТаблицаФормы"))
			Тогда
				Возврат Истина;
			Иначе
				Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

