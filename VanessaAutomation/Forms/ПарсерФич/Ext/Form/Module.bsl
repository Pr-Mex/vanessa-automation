КонецФункции	 


#Область ПеренесённыеИзДругихКонтейнеров

&НаКлиенте
Функция МногострочнаяСтрокаИзПараметраШага(Параметр) Экспорт
	
	Если ТипЗнч(Параметр) = Тип("Строка") Тогда
		Текст = Параметр;
	Иначе	
		Текст = "";
		Для Сч = 0 По Параметр.Количество() - 1 Цикл
			СтрокаТабПарам = Параметр[Сч];
			Текст = Текст + СтрокаТабПарам.Кол1;
			Если СтрокаТабПарам.Свойство("Кол2") Тогда
				Текст = Текст + СтрокаТабПарам.Кол2;
			КонецЕсли;
			Если СтрокаТабПарам.Свойство("Кол3") Тогда
				Текст = Текст + СтрокаТабПарам.Кол3;
			КонецЕсли;
			Если СтрокаТабПарам.Свойство("Кол4") Тогда
				Текст = Текст + СтрокаТабПарам.Кол4;
			КонецЕсли;
			Если СтрокаТабПарам.Свойство("Кол5") Тогда
				Текст = Текст + СтрокаТабПарам.Кол5;
			КонецЕсли;
			Если СтрокаТабПарам.Свойство("Кол6") Тогда
				Текст = Текст + СтрокаТабПарам.Кол6;
			КонецЕсли;
			Если СтрокаТабПарам.Свойство("Кол7") Тогда
				Текст = Текст + СтрокаТабПарам.Кол7;
			КонецЕсли;
			Если Сч < Параметр.Количество() - 1 Тогда
				Текст = Текст + Символы.ПС;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Текст; 
	
КонецФункции

// Выравнивает по ширине колонок строки одной таблицы Gherkin.
// Строки таблицы могут содержать разное количество колонок: ширина колонки считается
// по тем строкам, где эта колонка есть, а строка с меньшим числом колонок так и остаётся
// короткой. Строка, которая не разбирается как строка таблицы, остаётся без изменений.
//
// Параметры:
//  МассивТаблицы - Массив из Строка - строки таблицы, изменяется в процессе работы.
//
&НаКлиенте
Процедура ФорматироватьТаблицуGherkin(МассивТаблицы) Экспорт
	
	МассивДлин = Новый Массив;
	ЗначенияСтрок = Новый Массив;
	
	Для каждого СтрТзн Из МассивТаблицы Цикл
		МассивПараметров = ЗначенияСтрокиТаблицыGherkinМассивом(СтрТзн);
		ЗначенияСтрок.Добавить(МассивПараметров);
		
		Если МассивПараметров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Пока МассивДлин.Количество() < МассивПараметров.Количество() Цикл
			МассивДлин.Добавить(0);
		КонецЦикла;
		
		Для Ккк = 0 По МассивПараметров.Количество() - 1 Цикл
			ДлинаСтроки = СтрДлина(СокрЛП(МассивПараметров[Ккк]));
			Если ДлинаСтроки > МассивДлин[Ккк] Тогда
				МассивДлин[Ккк] = ДлинаСтроки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Ррр = 0 По (МассивТаблицы.Количество() - 1) Цикл
		МассивПараметров = ЗначенияСтрок[Ррр];
		Если МассивПараметров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрПараметров = "|";
		Для Ккк = 0 По МассивПараметров.Количество() - 1 Цикл
			Зн = СокрЛП(МассивПараметров[Ккк]);
			Пока СтрДлина(Зн) < МассивДлин[Ккк] Цикл
				Зн = Зн + " ";
			КонецЦикла;
			СтрПараметров = СтрПараметров + " " + Зн + " |";
		КонецЦикла;
		
		МассивТаблицы[Ррр] = СтрПараметров;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает значения одной строки таблицы Gherkin.
//
// Параметры:
//  СтрокаТаблицы - Строка - строка текста фичи.
//
// Возвращаемое значение:
//  Массив из Строка - значения колонок строки;
//  Неопределено - строка не является строкой таблицы Gherkin.
//
&НаКлиенте
Функция ЗначенияСтрокиТаблицыGherkinМассивом(Знач СтрокаТаблицы)
	
	Значения = ЗначенияИзСтрокиТаблицыGherkin(СтрокаТаблицы);
	Если ТипЗнч(Значения) <> Тип("СписокЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Значения.ВыгрузитьЗначения();
	
КонецФункции

// Находит в тексте фичи все таблицы Gherkin.
// Строки внутри многострочных параметров (между строками с """) таблицами не считаются.
//
// Параметры:
//  МассивСтрок - Массив из Строка - строки текста фичи.
//
// Возвращаемое значение:
//  Массив из Структура - описание каждой найденной таблицы:
//   * НомерПервойСтроки - Число - номер первой строки таблицы в тексте, нумерация с единицы;
//   * НомерПоследнейСтроки - Число - номер последней строки таблицы в тексте;
//   * Строки - Массив из Строка - строки таблицы без отступа слева;
//   * Отступ - Строка - отступ слева первой строки таблицы.
//
&НаКлиенте
Функция ТаблицыGherkinИзМассиваСтрок(МассивСтрок) Экспорт
	
	Таблицы = Новый Массив;
	ТекущаяТаблица = Неопределено;
	ВнутриМногострочногоПараметра = Ложь;
	
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		ПолнаяСтрока = МассивСтрок[Ккк];
		ТекстСтроки = СокрЛ(ПолнаяСтрока);
		
		Если Лев(ТекстСтроки, 3) = """""""" Тогда
			ВнутриМногострочногоПараметра = НЕ ВнутриМногострочногоПараметра;
			ТекущаяТаблица = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если ВнутриМногострочногоПараметра ИЛИ Лев(ТекстСтроки, 1) <> "|" Тогда
			ТекущаяТаблица = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяТаблица = Неопределено Тогда
			ТекущаяТаблица = Новый Структура("НомерПервойСтроки, НомерПоследнейСтроки, Строки, Отступ");
			ТекущаяТаблица.НомерПервойСтроки = Ккк + 1;
			ТекущаяТаблица.Строки = Новый Массив;
			ТекущаяТаблица.Отступ = Лев(ПолнаяСтрока, СтрДлина(ПолнаяСтрока) - СтрДлина(ТекстСтроки));
			Таблицы.Добавить(ТекущаяТаблица);
		КонецЕсли;
		
		ТекущаяТаблица.НомерПоследнейСтроки = Ккк + 1;
		ТекущаяТаблица.Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	
	Возврат Таблицы;
	
КонецФункции

&НаКлиенте
Функция ФорматироватьТекстФичи(Знач Текст) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("Изменился", Ложь);
	Результат.Вставить("Ошибка", "");
	
	Если СтрДлина(Текст) = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИсходныйТекст = Текст;
	ЕстьBOM = Ложь;
	Если Лев(Текст, 1) = Символ(65279) Тогда
		ЕстьBOM = Истина;
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	МассивСтрок = Ванесса._СтрРазделить(Текст, Символы.ПС);
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		СтрТек = МассивСтрок[Ккк];
		Если Прав(СтрТек, 1) = Символы.ВК Тогда
			МассивСтрок[Ккк] = Лев(СтрТек, СтрДлина(СтрТек) - 1);
		КонецЕсли;
	КонецЦикла;
	
	Ошибка = "";
	Карта = ПолучитьКартуКлючевыхСловДляФорматирования(Ошибка);
	Если Карта = Неопределено Тогда
		Результат.Ошибка = Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	ЛокальнаяКарта = ПреобразоватьЛокальнуюКартуВКартуТипов(СоздатьСоответствиеТаблицПереводов());
	Язык = ОпределитьЯзыкФичиДляФорматирования(МассивСтрок, Карта, ЛокальнаяКарта);
	ТипыСлов = ПолучитьТипыСловДляЯзыка(Карта, ЛокальнаяКарта, Язык);
	Если ТипыСлов = Неопределено Тогда
		Результат.Ошибка = "Не удалось получить ключевые слова Gherkin для языка " + Язык + ".";
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ТипыСлов) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "Не удалось получить ключевые слова Gherkin для языка " + Язык + ".";
		Возврат Результат;
	КонецЕсли;
	
	МассивСлов = СобратьМассивКлючевыхСлов(ТипыСлов);
	Если МассивСлов.Количество() = 0 Тогда
		Результат.Ошибка = "Не удалось получить ключевые слова Gherkin.";
		Возврат Результат;
	КонецЕсли;
	
	// Маска docstring вычисляется до классификации строк.
	СодержимоеDocstring = Новый Массив;
	ОграничительDocstring = Новый Массив;
	ОткрывающийDocstring = Новый Массив;
	ВнутриDocstring = Ложь;
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		СодержимоеDocstring.Добавить(Ложь);
		ОграничительDocstring.Добавить(Ложь);
		ОткрывающийDocstring.Добавить(Ложь);
		Если ЭтоТриКавычки(МассивСтрок[Ккк]) Тогда
			ОграничительDocstring[Ккк] = Истина;
			Если НЕ ВнутриDocstring Тогда
				ОткрывающийDocstring[Ккк] = Истина;
				ВнутриDocstring = Истина;
			Иначе
				ВнутриDocstring = Ложь;
			КонецЕсли;
		ИначеЕсли ВнутриDocstring Тогда
			СодержимоеDocstring[Ккк] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Индекс первого контекста/сценария нужен для выбора стиля секции Переменные:.
	ИндексПервогоСценария = -1;
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		Если (СодержимоеDocstring[Ккк]) ИЛИ (ОграничительDocstring[Ккк]) Тогда
			Продолжить;
		КонецЕсли;
		Разбор = РазобратьСтрокуНаОтступИТекст(МассивСтрок[Ккк]);
		ТекстБезОтступа = Разбор.Текст;
		Если ЭтоТолькоПробелыИТабы(МассивСтрок[Ккк]) Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(ТекстБезОтступа, 1) = "@" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(ТекстБезОтступа, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(ТекстБезОтступа, 2) = "//" Тогда
			Продолжить;
		КонецЕсли;
		ТипКлючевого = ОпределитьТипСтрокиПоКлючевымСловам(ТекстБезОтступа, МассивСлов);
		Если (ТипКлючевого = "background") ИЛИ (ТипКлючевого = "scenario") ИЛИ (ТипКлючевого = "scenario_outline") Тогда
			ИндексПервогоСценария = Ккк;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокиИнфо = Новый Массив;
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		Инфо = Новый Структура;
		Инфо.Вставить("Класс", "");
		Инфо.Вставить("Тип", "");
		Инфо.Вставить("Отступ", 0);
		Инфо.Вставить("Значимая", Ложь);
		Инфо.Вставить("Уровень", 0);
		Инфо.Вставить("Владелец", -1);
		Инфо.Вставить("ТекстРезультата", Неопределено);
		Инфо.Вставить("Открывающий", Ложь);
		Инфо.Вставить("Закрывающий", Ложь);
		Инфо.Вставить("ПеременныеСтандартные", Ложь);
		СтрокиИнфо.Добавить(Инфо);
	КонецЦикла;
	
	Режим = "фича";
	СекцияПеременныхСтандартная = Ложь;
	СтекПеременных = Новый Массив;
	ПоследнийВладелец = -1;
	
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		Инфо = СтрокиИнфо[Ккк];
		Инфо.Владелец = ПоследнийВладелец;
		Инфо.ПеременныеСтандартные = (Режим = "переменные") И (СекцияПеременныхСтандартная);
		СтрТек = МассивСтрок[Ккк];
		
		Если СодержимоеDocstring[Ккк] Тогда
			Инфо.Класс = "содержимое_docstring";
			Продолжить;
		КонецЕсли;
		
		Если ОграничительDocstring[Ккк] Тогда
			Инфо.Класс = "docstring";
			Разбор = РазобратьСтрокуНаОтступИТекст(СтрТек);
			Инфо.Отступ = Разбор.Отступ;
			Инфо.Значимая = (Режим = "сценарий") ИЛИ ((Режим = "переменные") И (НЕ СекцияПеременныхСтандартная));
			Если ОткрывающийDocstring[Ккк] Тогда
				Инфо.Открывающий = Истина;
			Иначе
				Инфо.Закрывающий = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Разбор = РазобратьСтрокуНаОтступИТекст(СтрТек);
		Отступ = Разбор.Отступ;
		ТекстБезОтступа = Разбор.Текст;
		Инфо.Отступ = Отступ;
		
		Если ЭтоТолькоПробелыИТабы(СтрТек) Тогда
			Инфо.Класс = "пустая";
			Продолжить;
		КонецЕсли;
		
		Если Лев(ТекстБезОтступа, 1) = "@" Тогда
			Инфо.Класс = "тег";
			Продолжить;
		КонецЕсли;
		
		Если ЭтоКомментарий(ТекстБезОтступа) Тогда
			Инфо.Класс = "комментарий";
			Продолжить;
		КонецЕсли;
		
		Если Лев(ТекстБезОтступа, 1) = "|" Тогда
			Инфо.Класс = "таблица";
			Продолжить;
		КонецЕсли;
		
		ТипКлючевого = ОпределитьТипСтрокиПоКлючевымСловам(ТекстБезОтступа, МассивСлов);
		Инфо.Тип = ТипКлючевого;
		
		Если ТипКлючевого = "feature" Тогда
			Инфо.Класс = "заголовок";
			Инфо.Уровень = 0;
			Режим = "фича";
			ПоследнийВладелец = Ккк;
			Продолжить;
		КонецЕсли;
		
		Если ТипКлючевого = "variables" Тогда
			Инфо.Класс = "заголовок";
			Инфо.Уровень = 0;
			Режим = "переменные";
			СекцияПеременныхСтандартная = (ИндексПервогоСценария = -1) ИЛИ (Ккк < ИндексПервогоСценария);
			СтекПеременных = Новый Массив;
			ПоследнийВладелец = Ккк;
			Продолжить;
		КонецЕсли;
		
		Если (ТипКлючевого = "background") ИЛИ (ТипКлючевого = "scenario") ИЛИ (ТипКлючевого = "scenario_outline") Тогда
			Инфо.Класс = "заголовок";
			Инфо.Уровень = 0;
			Режим = "сценарий";
			ПоследнийВладелец = Ккк;
			Продолжить;
		КонецЕсли;
		
		Если Режим = "переменные" Тогда
			Инфо.Класс = "содержимое_переменных";
			Если СекцияПеременныхСтандартная Тогда
				Пока (СтекПеременных.Количество() > 0) И (Отступ <= СтекПеременных[СтекПеременных.Количество() - 1]) Цикл
					СтекПеременных.Удалить(СтекПеременных.Количество() - 1);
				КонецЦикла;
				Инфо.Уровень = 1 + СтекПеременных.Количество();
				Если Лев(ТекстБезОтступа, 1) = "*" Тогда
					СтекПеременных.Добавить(Отступ);
				КонецЕсли;
				Инфо.Значимая = Ложь;
			Иначе
				Инфо.Значимая = Истина;
			КонецЕсли;
			ПоследнийВладелец = Ккк;
			Продолжить;
		КонецЕсли;
		
		Если ТипКлючевого = "examples" Тогда
			Инфо.Класс = "значимая";
			Инфо.Значимая = Истина;
			ПоследнийВладелец = Ккк;
			Продолжить;
		КонецЕсли;
		
		Если Режим = "сценарий" Тогда
			Инфо.Класс = "значимая";
			Инфо.Значимая = Истина;
			ПоследнийВладелец = Ккк;
			Продолжить;
		КонецЕсли;
		
		Если Режим = "фича" Тогда
			Инфо.Класс = "описание";
			Инфо.Уровень = 0;
			Продолжить;
		КонецЕсли;
		
		Инфо.Класс = "значимая";
		Инфо.Значимая = Истина;
		ПоследнийВладелец = Ккк;
	КонецЦикла;
	
	// Уровень значимой строки — глубина вложенности отступов, а не ранг
	// абсолютного отступа по всему файлу.
	СтекОтступов = Новый Массив;
	СтекУровней = Новый Массив;
	СтекОтступов.Добавить(0);
	СтекУровней.Добавить(0);
	
	Для Ккк = 0 По СтрокиИнфо.Количество() - 1 Цикл
		Инфо = СтрокиИнфо[Ккк];

		// Заголовок начинает новую секцию: отступы внутри неё считаются заново.
		Если Инфо.Класс = "заголовок" Тогда
			Пока СтекОтступов.Количество() > 1 Цикл
				СтекОтступов.Удалить(СтекОтступов.Количество() - 1);
				СтекУровней.Удалить(СтекУровней.Количество() - 1);
			КонецЦикла;
		КонецЕсли;

		Если (Инфо.Значимая) И (Инфо.Класс <> "docstring") Тогда
			Пока (СтекОтступов.Количество() > 1) И (СтекОтступов[СтекОтступов.Количество() - 1] > Инфо.Отступ) Цикл
				СтекОтступов.Удалить(СтекОтступов.Количество() - 1);
				СтекУровней.Удалить(СтекУровней.Количество() - 1);
			КонецЦикла;
			ИндексВершины = СтекОтступов.Количество() - 1;
			Если Инфо.Отступ > СтекОтступов[ИндексВершины] Тогда
				Инфо.Уровень = СтекУровней[ИндексВершины] + 1;
				СтекОтступов.Добавить(Инфо.Отступ);
				СтекУровней.Добавить(Инфо.Уровень);
			Иначе
				Инфо.Уровень = СтекУровней[ИндексВершины];
			КонецЕсли;
		КонецЕсли;

		Если (Инфо.Класс = "заголовок") ИЛИ (Инфо.Класс = "описание") ИЛИ (Инфо.Класс = "тег") Тогда
			Инфо.Уровень = 0;
		КонецЕсли;
	КонецЦикла;
	
	// Ограничитель docstring не участвует в стеке (см. условие выше).
	// Его уровень считается от владельца: если ограничитель глубже владельца,
	// он получает уровень владельца + 1, иначе уровень владельца.
	Для Ккк = 0 По СтрокиИнфо.Количество() - 1 Цикл
		Инфо = СтрокиИнфо[Ккк];
		Если (Инфо.Класс = "docstring") И (Инфо.Значимая ИЛИ Инфо.ПеременныеСтандартные) Тогда
			Если Инфо.Владелец < 0 Тогда
				Инфо.Уровень = 0;
			ИначеЕсли Инфо.ПеременныеСтандартные Тогда
				Инфо.Уровень = СтрокиИнфо[Инфо.Владелец].Уровень;
			ИначеЕсли Инфо.Отступ > СтрокиИнфо[Инфо.Владелец].Отступ Тогда
				Инфо.Уровень = СтрокиИнфо[Инфо.Владелец].Уровень + 1;
			Иначе
				Инфо.Уровень = СтрокиИнфо[Инфо.Владелец].Уровень;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Таблицы = ТаблицыGherkinИзМассиваСтрок(МассивСтрок);
	Для Каждого ОписаниеТаблицы Из Таблицы Цикл
		Если БлокПересекаетDocstring(ОписаниеТаблицы, СодержимоеDocstring, ОграничительDocstring) Тогда
			Продолжить;
		КонецЕсли;
		ФорматироватьТаблицуGherkin(ОписаниеТаблицы.Строки);
		ИндексПервой = ОписаниеТаблицы.НомерПервойСтроки - 1;
		ИндексВладельца = СтрокиИнфо[ИндексПервой].Владелец;
		УровеньТаблицы = 0;
		Если ИндексВладельца >= 0 Тогда
			УровеньТаблицы = СтрокиИнфо[ИндексВладельца].Уровень + 1;
		КонецЕсли;
		Для Ккк = 0 По ОписаниеТаблицы.Строки.Количество() - 1 Цикл
			ИнфоТаблицы = СтрокиИнфо[ИндексПервой + Ккк];
			ИнфоТаблицы.Уровень = УровеньТаблицы;
			ИнфоТаблицы.ТекстРезультата = Табы(УровеньТаблицы) + ОбрезатьПробелыИТабы(ОписаниеТаблицы.Строки[Ккк]);
		КонецЦикла;
	КонецЦикла;
	
	СледующийУровень = 0;
	Для Ккк = 1 По СтрокиИнфо.Количество() Цикл
		ИндексСтроки = СтрокиИнфо.Количество() - Ккк;
		Инфо = СтрокиИнфо[ИндексСтроки];
		Если Инфо.Класс = "комментарий" Тогда
			Инфо.Уровень = СледующийУровень;
		ИначеЕсли ЭтоЗначимаяДляКомментария(Инфо) Тогда
			СледующийУровень = Инфо.Уровень;
		КонецЕсли;
	КонецЦикла;
	
	ТекущийN = 0;
	ТекущийP = "";
	МассивРезультата = Новый Массив;
	
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		Инфо = СтрокиИнфо[Ккк];
		СтрТек = МассивСтрок[Ккк];
		
		Если Инфо.Класс = "пустая" Тогда
			МассивРезультата.Добавить("");
			Продолжить;
		КонецЕсли;
		
		Если Инфо.Класс = "таблица" Тогда
			Если Инфо.ТекстРезультата = Неопределено Тогда
				МассивРезультата.Добавить(Табы(Инфо.Уровень) + ОбрезатьПробелыИТабы(СтрТек));
			Иначе
				МассивРезультата.Добавить(Инфо.ТекстРезультата);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Инфо.Класс = "docstring" Тогда
			Если Инфо.Открывающий Тогда
				Если Инфо.ПеременныеСтандартные Тогда
					Если Инфо.Владелец >= 0 Тогда
						ТекущийN = СтрокиИнфо[Инфо.Владелец].Уровень;
					Иначе
						ТекущийN = 0;
					КонецЕсли;
				Иначе
					ТекущийN = Инфо.Уровень;
				КонецЕсли;
				ТекущийP = ВедущиеПробелыИТабы(СтрТек);
				МассивРезультата.Добавить(Табы(ТекущийN) + ОбрезатьПробелыИТабы(СтрТек));
			Иначе
				Если Инфо.ПеременныеСтандартные Тогда
					МассивРезультата.Добавить(Табы(ТекущийN) + ОбрезатьПробелыИТабы(СтрТек));
				Иначе
					МассивРезультата.Добавить(Табы(Инфо.Уровень) + ОбрезатьПробелыИТабы(СтрТек));
				КонецЕсли;
				ТекущийP = "";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Инфо.Класс = "содержимое_docstring" Тогда
			Если СтрДлина(СтрТек) = 0 Тогда
				МассивРезультата.Добавить("");
			ИначеЕсли ЭтоТолькоПробелыИТабы(СтрТек) Тогда
				МассивРезультата.Добавить(СтрТек);
			Иначе
				Если СтрДлина(ТекущийP) = 0 Тогда
					Остаток = СтрТек;
				ИначеЕсли Лев(СтрТек, СтрДлина(ТекущийP)) = ТекущийP Тогда
					Остаток = Сред(СтрТек, СтрДлина(ТекущийP) + 1);
				Иначе
					Остаток = СтрТек;
				КонецЕсли;
				МассивРезультата.Добавить(Табы(ТекущийN) + Остаток);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		МассивРезультата.Добавить(Табы(Инфо.Уровень) + ОбрезатьПробелыИТабы(СтрТек));
	КонецЦикла;
	
	НовыйТекст = Ванесса._СтрСоединить(МассивРезультата, Символы.ПС);
	Если ЕстьBOM Тогда
		НовыйТекст = Символ(65279) + НовыйТекст;
	КонецЕсли;
	
	Результат.Текст = НовыйТекст;
	Результат.Изменился = (НовыйТекст <> ИсходныйТекст);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКартуКлючевыхСловДляФорматирования(Ошибка)
	
	Ошибка = "";
	КомпонентныйРежим = Ложь;
	Попытка
		КомпонентныйРежим = Истина;
		Если Ванесса.Объект.ИспользоватьКомпонентуVanessaExt <> Истина Тогда
			КомпонентныйРежим = Ложь;
		КонецЕсли;
		Если Ванесса.Объект.ИспользоватьПарсерGherkinИзКомпонентыVanessaExt <> Истина Тогда
			КомпонентныйРежим = Ложь;
		КонецЕсли;
	Исключение
		КомпонентныйРежим = Ложь;
	КонецПопытки;
	
	Если КомпонентныйРежим Тогда
		Попытка
			Карта = Ванесса.МодульПарсерGherkin().КлючевыеСловаGherkin();
		Исключение
			Ошибка = "Не удалось получить ключевые слова Gherkin из компоненты: " + ОписаниеОшибки();
			Возврат Неопределено;
		КонецПопытки;
		Если ТипЗнч(Карта) <> Тип("Соответствие") Тогда
			Ошибка = "Компонента вернула некорректную карту ключевых слов Gherkin.";
			Возврат Неопределено;
		КонецЕсли;
		Если Карта.Количество() = 0 Тогда
			Ошибка = "Компонента вернула пустую карту ключевых слов Gherkin.";
			Возврат Неопределено;
		КонецЕсли;
		Возврат Карта;
	КонецЕсли;
	
	Возврат ПреобразоватьЛокальнуюКартуВКартуТипов(СоздатьСоответствиеТаблицПереводов());
	
КонецФункции

&НаКлиенте
Функция ПреобразоватьЛокальнуюКартуВКартуТипов(ЛокальнаяКарта)
	
	Карта = Новый Соответствие;
	Для Каждого Элемент Из ЛокальнаяКарта Цикл
		Язык = Элемент.Ключ;
		ДанныеЯзыка = Элемент.Значение;
		Если ТипЗнч(ДанныеЯзыка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ДанныеЯзыка.Свойство("ТаблицаКлючевыхСлов") Тогда
			Продолжить;
		КонецЕсли;
		
		Типы = Новый Соответствие;
		Таблица = ДанныеЯзыка.ТаблицаКлючевыхСлов;
		Для Каждого ЭлементСлова Из Таблица Цикл
			ДанныеСлова = ЭлементСлова.Значение;
			Если ТипЗнч(ДанныеСлова) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ДанныеСлова.Свойство("Тип") Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьСловоВКартуТипов(Типы, ЭлементСлова.Ключ, ДанныеСлова.Тип);
		КонецЦикла;
		
		Если Язык = "ru" Тогда
			ДобавитьСловоВКартуТипов(Типы, "переменные", "variables");
		ИначеЕсли Язык = "en" Тогда
			ДобавитьСловоВКартуТипов(Типы, "variables", "variables");
			ДобавитьСловоВКартуТипов(Типы, "example", "scenario");
		КонецЕсли;
		
		Карта.Вставить(Язык, Типы);
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьСловоВКартуТипов(КартаТипов, Слово, ТипСлова)
	
	Если СтрДлина(СокрЛП(Слово)) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивСлов = КартаТипов.Получить(ТипСлова);
	Если МассивСлов = Неопределено Тогда
		МассивСлов = Новый Массив;
		КартаТипов.Вставить(ТипСлова, МассивСлов);
	КонецЕсли;
	МассивСлов.Добавить(НРег(СокрЛП(Слово)));
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьЯзыкФичиДляФорматирования(МассивСтрок, Карта, ЛокальнаяКарта)
	
	Язык = "ru";
	Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
		СтрТек = МассивСтрок[Ккк];
		Если Лев(СокрЛП(СтрТек), 1) <> "#" Тогда
			Продолжить;
		КонецЕсли;
		Поз = Найти(СтрТек, "language:");
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		Код = СокрЛП(Сред(СтрТек, Поз + СтрДлина("language:")));
		Если СтрДлина(Код) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если (Карта.Получить(Код) <> Неопределено) ИЛИ (ЛокальнаяКарта.Получить(Код) <> Неопределено) Тогда
			Язык = Код;
		КонецЕсли;
	КонецЦикла;
	Возврат Язык;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТипыСловДляЯзыка(Карта, ЛокальнаяКарта, Язык)
	
	Типы = Карта.Получить(Язык);
	Если Типы = Неопределено Тогда
		Типы = ЛокальнаяКарта.Получить(Язык);
	КонецЕсли;
	Если Типы = Неопределено Тогда
		Типы = Карта.Получить("ru");
	КонецЕсли;
	Если Типы = Неопределено Тогда
		Типы = ЛокальнаяКарта.Получить("ru");
	КонецЕсли;
	Возврат Типы;
	
КонецФункции

&НаКлиенте
Функция СобратьМассивКлючевыхСлов(ТипыСлов)
	
	МассивСлов = Новый Массив;
	Для Каждого Элемент Из ТипыСлов Цикл
		ТипКлюча = Элемент.Ключ;
		Если ТипЗнч(ТипКлюча) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Если (ТипКлюча = "rule") ИЛИ (ТипКлюча = "native") ИЛИ (ТипКлюча = "name") Тогда
			Продолжить;
		КонецЕсли;
		Если ТипКлюча = "scenarioOutline" Тогда
			ТипКлюча = "scenario_outline";
		КонецЕсли;
		
		Значение = Элемент.Значение;
		Если ТипЗнч(Значение) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Слово Из Значение Цикл
			Если ТипЗнч(Слово) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			СловоНРег = НРег(СокрЛП(Слово));
			Если СтрДлина(СловоНРег) > 0 Тогда
				МассивСлов.Добавить(Новый Структура("Слово, Тип", СловоНРег, ТипКлюча));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСлов;
	
КонецФункции

&НаКлиенте
Функция ОпределитьТипСтрокиПоКлючевымСловам(Текст, МассивСлов)
	
	НРегТекст = НРег(Текст);
	ЛучшееСлово = "";
	ЛучшийТип = "";
	Для Каждого Элемент Из МассивСлов Цикл
		Слово = Элемент.Слово;
		ДлинаСлова = СтрДлина(Слово);
		Если ДлинаСлова <= СтрДлина(ЛучшееСлово) Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(НРегТекст, ДлинаСлова) <> Слово Тогда
			Продолжить;
		КонецЕсли;
		СледующийСимвол = Сред(НРегТекст, ДлинаСлова + 1, 1);
		Если ЭтоГраницаСлова(СледующийСимвол) Тогда
			ЛучшееСлово = Слово;
			ЛучшийТип = Элемент.Тип;
		КонецЕсли;
	КонецЦикла;
	Возврат ЛучшийТип;
	
КонецФункции

&НаКлиенте
Функция ЭтоГраницаСлова(Символ)
	
	Если Символ = "" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Символ = " " Тогда
		Возврат Истина;
	КонецЕсли;
	Если Символ = Символы.Таб Тогда
		Возврат Истина;
	КонецЕсли;
	Если Символ = ":" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЭтоПробелИлиТаб(Символ)
	
	Если Символ = " " Тогда
		Возврат Истина;
	КонецЕсли;
	Если Символ = Символы.Таб Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЭтоКомментарий(Текст)
	
	Если Лев(Текст, 1) = "#" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Лев(Текст, 2) = "//" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция РазобратьСтрокуНаОтступИТекст(Строка)
	
	Отступ = 0;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если ЭтоПробелИлиТаб(Символ) Тогда
			Отступ = Отступ + 1;
			Позиция = Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Отступ, Текст", Отступ, Сред(Строка, Позиция));
	
КонецФункции

&НаКлиенте
