// ЭтоЗакомментированнаяСтрокаСценария
&НаКлиенте
Функция ЭтоЗакомментированнаяСтрокаСценария(Знач Стр) Экспорт
    Стр = СокрЛ(Стр);
    Если Лев(Стр, 1) = "#" Тогда
        Возврат Истина;
    ИначеЕсли Лев(Стр, 2) = "//" Тогда
        Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

