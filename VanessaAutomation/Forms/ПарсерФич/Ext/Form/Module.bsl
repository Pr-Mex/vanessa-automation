&НаКлиенте
Функция ЭтоТолькоПробелыИТабы(Строка)
	
	Если СтрДлина(Строка) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Ккк = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Ккк, 1);
		Если НЕ ЭтоПробелИлиТаб(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ОбрезатьПробелыИТабы(Строка)
	
	Начало = 1;
	Конец = СтрДлина(Строка);
	Пока Начало <= Конец Цикл
		Символ = Сред(Строка, Начало, 1);
		Если ЭтоПробелИлиТаб(Символ) Тогда
			Начало = Начало + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Пока Конец >= Начало Цикл
		Символ = Сред(Строка, Конец, 1);
		Если ЭтоПробелИлиТаб(Символ) Тогда
			Конец = Конец - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Конец < Начало Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Строка, Начало, Конец - Начало + 1);
	
КонецФункции

&НаКлиенте
Функция ВедущиеПробелыИТабы(Строка)
	
	Позиция = 1;
	Пока Позиция <= СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если ЭтоПробелИлиТаб(Символ) Тогда
			Позиция = Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(Строка, Позиция - 1);
	
КонецФункции

&НаКлиенте
Функция Табы(Количество)
	
	Если Количество <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Результат = "";
	Для Ккк = 1 По Количество Цикл
		Результат = Результат + Символы.Таб;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция БлокПересекаетDocstring(ОписаниеТаблицы, СодержимоеDocstring, ОграничительDocstring)
	
	ИндексПервой = ОписаниеТаблицы.НомерПервойСтроки - 1;
	ИндексПоследней = ОписаниеТаблицы.НомерПоследнейСтроки - 1;
	Для Ккк = ИндексПервой По ИндексПоследней Цикл
		Если (СодержимоеDocstring[Ккк]) ИЛИ (ОграничительDocstring[Ккк]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
