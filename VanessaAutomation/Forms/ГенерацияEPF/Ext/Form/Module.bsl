#Область СерверныеМетоды

// Серверный безконтекстный: преобразование тела модуля из строки в массив (внутренний).
&НаСервереБезКонтекста
Функция ПолучитьТелоМодуляВМассивСервер(Знач Стр)
	ТелоМодуля = ЗначениеИзСтрокиВнутр(Стр);
	ТелоМодуля.Сортировать("НомСтр");
	Массив = ТелоМодуля.ВыгрузитьКолонку("Стр");

	Возврат Массив;
КонецФункции

// Клиентская обёртка над СБК ПолучитьТелоМодуляВМассивСервер (урок 15/33).
&НаКлиенте
Функция ПолучитьТелоМодуляВМассивСерверКлиент(Знач Стр) Экспорт
	Возврат ПолучитьТелоМодуляВМассивСервер(Стр);
КонецФункции

// Серверный безконтекстный: получение текста модуля из структуры описания EPF (внутренний).
&НаСервереБезКонтекста
Функция ПолучитьТекстМодуляИзСтруктураОписанияEpfСервер(Знач ТекстМодуляВнутр)
	Стр = "";

	Тзн = ЗначениеИзСтрокиВнутр(ТекстМодуляВнутр);

	Для каждого СтрТзн Из Тзн Цикл
		Стр = Стр + СтрТзн.Стр + Символы.ПС;
	КонецЦикла;

	Возврат Стр;
КонецФункции

// Клиентская обёртка над СБК ПолучитьТекстМодуляИзСтруктураОписанияEpfСервер (урок 15/33).
&НаКлиенте
Функция ПолучитьТекстМодуляИзСтруктураОписанияEpfСерверКлиент(Знач ТекстМодуляВнутр) Экспорт
	Возврат ПолучитьТекстМодуляИзСтруктураОписанияEpfСервер(ТекстМодуляВнутр);
КонецФункции

#Область ПеренесённыеИзГлавнойФормы

// ВывестиТекстМодуляНаЭкран
&НаКлиенте
Процедура ВывестиТекстМодуляНаЭкран(СтруктураОписанияEpf) Экспорт
	Стр = ПолучитьТекстМодуляИзСтруктураОписанияEpfСервер(СтруктураОписанияEpf.ТелоМодуля);
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.ДобавитьСтроку(Стр);
	ТекстовыйДокумент.Показать();
КонецПроцедуры

#КонецОбласти


#Область ПеренесённыеИзДругихКонтейнеров

// ЗаменитьUIDФайлеОбработки
&НаКлиенте
Процедура ЗаменитьUIDФайлеОбработки(ИмяФайла, ЧастьСтроиПоиска, UID) Экспорт
	
	СтрокаПоиска = Неопределено;
	
	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ИмяФайла, "UTF-8");
	
	Пока Истина Цикл
		Стр = Текст.ПрочитатьСтроку();
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;	 
		
		Поз = Найти(Стр, ЧастьСтроиПоиска);
		Если Поз > 0 Тогда
			СтрокаПоиска = СокрЛП(Стр);
		КонецЕсли;	 
	КонецЦикла;	
	
	Текст.Закрыть();
	
	Если СтрокаПоиска = Неопределено Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В файле <%1> не найдена строка <%2>."),
			ИмяФайла,
			ЧастьСтроиПоиска
		);
	КонецЕсли;	 
	
	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ИмяФайла, "UTF-8");
	
	ТекстФайла = Текст.Прочитать();
	
	СтрокаЗамены = ЧастьСтроиПоиска + """%1"">";
	СтрокаЗамены = СтрЗаменить(СтрокаЗамены, "%1", UID);
	
	Если Найти(ТекстФайла, СтрокаПоиска) = 0 Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В файле <%1> не найдена строка <%2>."),
			ИмяФайла,
			СтрокаПоиска
		);
	КонецЕсли;	 
	
	ТекстФайла = СтрЗаменить(ТекстФайла, СтрокаПоиска, СтрокаЗамены);
	
	Текст.Закрыть();
	
	Ванесса.УдалитьФайлыКомандаСистемы(ИмяФайла);
	
	ЗТ = Новый ЗаписьТекста(ИмяФайла, "UTF-8",, Истина); 
	ЗТ.Записать(ТекстФайла); 
	ЗТ.Закрыть();
КонецПроцедуры

#КонецОбласти
#КонецОбласти
