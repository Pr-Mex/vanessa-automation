&НаКлиенте
Процедура НачатьОзвучкуШага(ТекШаг) Экспорт

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ВызватьИсключение Ванесса.Локализовать("Необходимо включить использование внешней компоненты VanessaExt.");
	КонецЕсли;

	Ванесса.НужноОжидатьОкончанияОзвучкиШага = Истина;
	ПараметрыВидео = ПолучитьПараметрыЗаписиВидео();
	ПодключитьБиблиотекуРаботыСВидео();
	Если ТекШаг.Свойство("ТекстИнструкция") Тогда
		ПараметрыВидео.Вставить("ТекстДляТестаГолоса", ТекШаг.ТекстИнструкция);
	Иначе
		ПараметрыВидео.Вставить("ТекстДляТестаГолоса", "");
	КонецЕсли;
	Если ТекШаг.Свойство("ТекстИнструкция") Тогда
		Ванесса.Отладка("Text=" + ТекШаг.ТекстИнструкция);
	КонецЕсли;
	ПараметрыВидео.Вставить("ОзвучкаВыполненияСценария", Истина);
	ПараметрыВидео.Вставить("Шаг", ТекШаг);
	ПараметрыВидео.Вставить("КопироватьФайлMp3", Ложь);
	ИмяФайлаMp3 = Ванесса.МодульРаботыСВидео.ТестГолоса(ПараметрыВидео);
	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайлаMp3) Тогда
		ВызватьИсключение Ванесса._СтрШаблон(Ванесса.Локализовать("Не найден файл <%1>"), Строка(ИмяФайлаMp3));
	КонецЕсли;
	Ванесса.ИДВоспроизведенияMp3 = ИмяФайлаMp3 + Новый УникальныйИдентификатор;
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовВоспроизвестиМедиа(Ванесса.ОписаниеПустогоОбработчика(3), ИмяФайлаMp3, Ванесса.ИДВоспроизведенияMp3);

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОбработкуДвижкаTTS(ОбработчикОповещения) Экспорт

	Если ПустаяСтрока(Ванесса.Объект.ЗаписьВидеоПутьКОбработкеДвижкаTTS) Тогда
		ВызватьИсключение Ванесса.Локализовать("Не указан путь к обработке, реализующей движок TTS.");
	КонецЕсли;

	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(Ванесса.Объект.ЗаписьВидеоПутьКОбработкеДвижкаTTS) Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Файл <%1> не найден."), (Ванесса.Объект.ЗаписьВидеоПутьКОбработкеДвижкаTTS));
	КонецЕсли;

	Если Ванесса.ФормаОбработкиПроизвольногоДвижкаTTS = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОбработчикОповещения);
		// callback остаётся в MAIN (урок 22) - используем Ванесса как форму-цель
		Оповещение = Новый ОписаниеОповещения("ОбработкаПослеПомещенияФайлаДвижкаTTS", Ванесса, ДополнительныеПараметры);
		// УникальныйИдентификатор MAIN - чтобы файл помещался в хранилище MAIN
		НачатьПомещениеФайла(Оповещение, , Ванесса.Объект.ЗаписьВидеоПутьКОбработкеДвижкаTTS, Ложь, Ванесса.УникальныйИдентификатор);
	КонецЕсли;

