&НаКлиенте
Процедура ПодключитьБиблиотекуРаботыСВидео() Экспорт
	Если Ванесса.МодульРаботыСВидео <> Неопределено Тогда
		Возврат;
	КонецЕсли;	 
	
	Если Ванесса.Объект.ВерсияПоставки = "single" Тогда
		ПараметрыФормы = Новый Структура;
		Ванесса.МодульРаботыСВидео = ПолучитьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.Video_РаботаСВидео", ПараметрыФормы);
	Иначе	
		
		Если ПустаяСтрока(Ванесса.Объект.КаталогИнструментов) Тогда
			Ванесса.Объект.КаталогИнструментов = Ванесса.КаталогИнструментовИзПутиКФреймворку();
		КонецЕсли;
		
		ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + "lib/Video/РаботаСВидео.epf";
		Если СокрЛП(Ванесса.Объект.КаталогИнструментов) = "" Тогда
			ЕстьКонстантаВКонфигурацииПутьКVA = Ванесса.ЕстьКонстантаВКонфигурацииСервер("ПутьКVanessaAutomation");
			Если ЕстьКонстантаВКонфигурацииПутьКVA Тогда
				ПутьКVanessaAutomation     = Ванесса.ПолучитьЗначениеКонстантыСервер("ПутьКVanessaAutomation");
				ФайлПутьКVanessaAutomation = Новый Файл(ПутьКVanessaAutomation);
				ИмяФайла                 = Ванесса.ДополнитьСлешВПуть(ФайлПутьКVanessaAutomation.Путь) + "lib/Video/РаботаСВидео.epf";
			КонецЕсли;	 
		КонецЕсли;	 
		
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
			Ванесса.СообщитьПользователю (Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Файл <%1> не существует."),
				ИмяФайла
			));
			Возврат;
		КонецЕсли;
		
		Ванесса.МодульРаботыСВидео = ПолучитьФорму("ВнешняяОбработка.РаботаСВидео.Форма.Форма");
	КонецЕсли;	 	
	
	Если Ванесса.МодульРаботыСВидео = Неопределено Тогда
		Возврат;
	КонецЕсли;	 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ванесса", Ванесса);
	Ванесса.МодульРаботыСВидео.УстановитьСлужебныеПеременные(СтруктураПараметров);
	
КонецПроцедуры

