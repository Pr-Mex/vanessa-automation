// ПолучитьТекстШагаИзТекстаФичиЕслиОнТамЗадан
&НаКлиенте
Процедура ПолучитьТекстШагаИзТекстаФичиЕслиОнТамЗадан(Знач Текст, Шаг, Сценарий) Экспорт
	//+++ ЦВ_ПР 22.10.2025 нужно учесть тег StartRecordVideo, который включает принудительно запись Видео и нежелательную озвучку отключим, если только не поменяет директива с текстом
	Если (Шаг.Свойство("ДирективныйЗапускЗаписиВидео") и Шаг.ДирективныйЗапускЗаписиВидео) Тогда 
		Текст = "<НЕ ОЗВУЧИВАТЬ>";
	  //Возврат; Снять комментарий, если далее возникнут нежелательные озвучки
	КонецЕсли;	     
	//--- ЦВ_ПР 22.10.2025

	МассивТекстФичи = Сценарий.МассивТекстФичи;
	
	СлужебнаяСтрока = Ванесса.НайтиСлужебнуюСтрокуВФичеДляЭтогоШага(МассивТекстФичи, "[autodoc.mute]", Шаг.НомерСтрокиВФиче);
	Если СлужебнаяСтрока <> Неопределено Тогда
		Текст = "<НЕ ОЗВУЧИВАТЬ>";
		Возврат;
	КонецЕсли;
	
	//+++ ЦВ_ПР 27.10.2025 Для ВидеоИнструкций также актуально проверитьслужебную директиву [autodoc.text]  
	Если Шаг.Свойство("МассивКомментариевШага") И Шаг.МассивКомментариевШага <> Неопределено Тогда
		Для Каждого КомментарийШага Из Шаг.МассивКомментариевШага Цикл
			Директива = "[autodoc.text]";
			Поз = Найти(НРег(КомментарийШага), Директива); 
			Если Поз > 0 Тогда
				СлужебнаяСтрока = СокрЛП(Сред(КомментарийШага, Поз + СтрДлина(Директива)));
				ПараметрыОбработки = Новый Структура;
				ПараметрыОбработки.Вставить("ОбработкаПараметровШага", Истина);
				ПараметрыОбработки.Вставить("ВычислитьВыражения", Истина);
				ПараметрыОбработки.Вставить("Шаг", Шаг);
				Ванесса.ОбработатьУправляющуюСтрокуИнструкции(СлужебнаяСтрока, ПараметрыОбработки);
				Текст = СлужебнаяСтрока;
				//Шаг.Вставить("ТекстИнструкция", СлужебнаяСтрока);
				Прервать; // Упрощенно Одна директива в массиве. Можно сделать склейку, если потребуется
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
    //--- ЦВ_ПР 27.10.2025

	СлужебнаяСтрока = Ванесса.НайтиСлужебнуюСтрокуВФичеДляЭтогоШага(МассивТекстФичи, "[autodoc.text]", Шаг.НомерСтрокиВФиче);
	Если Не ЗначениеЗаполнено(СлужебнаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ОбработкаПараметровШага", Истина);
	ПараметрыОбработки.Вставить("ВычислитьВыражения", Истина);
	ПараметрыОбработки.Вставить("Шаг", Шаг);
	Ванесса.ОбработатьУправляющуюСтрокуИнструкции(СлужебнаяСтрока, ПараметрыОбработки);
	
	Текст = СлужебнаяСтрока;
КонецПроцедуры

// ВКешЕстьВсеMp3ДляДаннойФичи
&НаКлиенте
Функция ВКешЕстьВсеMp3ДляДаннойФичи(ДанныеКеш, ИмяФайла) Экспорт
	
	Если ДанныеКеш = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	 
	
	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ИмяФайла, "UTF-8");
	ТекстФайла = Текст.Прочитать();
	Текст.Закрыть();
	
	МассивСтрок = Ванесса._СтрРазделить(ТекстФайла, Символы.ПС);
	Для Сч = 0 По МассивСтрок.Количество()-1 Цикл
		Стр = СокрЛП(МассивСтрок[Сч]);
		
		Если Лев(Стр, 1) = "*" Тогда
			ТекстДиктора = СокрЛП(Сред(Стр, 2));
			ДанныеИзКеш = ДанныеКеш[ТекстДиктора];
			Если ДанныеИзКеш = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;	 
		КонецЕсли;	 
	КонецЦикла;	
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
#КонецОбласти


