&НаКлиенте
Процедура ОбработатьУправляющуюСтрокуИнструкции(СлужебнаяСтрока, Параметры) Экспорт
	ПредставлениеКвадратнаяСкобкаЛевая  = "__&КвадратнаяСкобкаЛевая__";
	ПредставлениеКвадратнаяСкобкаПравая = "__&КвадратнаяСкобкаПравая__";
	ПредставлениеДирективаТекст1 = "__&ДирективаТекст1__";
	ПредставлениеДирективаТекст2 = "__&ДирективаТекст2__";
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, "\[", ПредставлениеКвадратнаяСкобкаЛевая);
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, "\]", ПредставлениеКвадратнаяСкобкаПравая);
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, "<[", ПредставлениеДирективаТекст1);
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, "]>", ПредставлениеДирективаТекст2);

	Если Параметры.Свойство("ОбработкаПараметровШага") Тогда
		Если Параметры.ОбработкаПараметровШага Тогда
			Для Ккк = 1 По Параметры.Шаг.ЗначенияПараметров.Количество() Цикл
				СтрокаЗамены = "%" + Формат(Ккк, "ЧГ=; ЧН=0");
				СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, СтрокаЗамены, Параметры.Шаг.ЗначенияПараметров[Ккк - 1].Значение.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если Параметры.Свойство("ВычислитьВыражения") Тогда
		Если Параметры.ВычислитьВыражения Тогда
			ВычислитьПараметрыВнутриСтроки(СлужебнаяСтрока);
		КонецЕсли;
	КонецЕсли;

	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, ПредставлениеКвадратнаяСкобкаЛевая, "[");
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, ПредставлениеКвадратнаяСкобкаПравая, "]");
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, ПредставлениеДирективаТекст1, "<[");
	СлужебнаяСтрока = СтрЗаменить(СлужебнаяСтрока, ПредставлениеДирективаТекст2, "]>");

	Если Параметры.Свойство("СтрокаДереваГруппа") Тогда
		// Значит этот шаг относится к группе, которая в видео попадёт как один шаг.
		Если (Параметры.Свойство("ОбработатьГруппыШаговКакОдинШаг") И Параметры.ОбработатьГруппыШаговКакОдинШаг)
			ИЛИ Ванесса.Объект.ЗаписьВидеоГруппаШаговКакШаг Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Уровень", 0);
			ДопПараметры.Вставить("НашлиПервыйШаг", Ложь);
			ДопПараметры.Вставить("ПоследнийШаг", Ложь);
			ДопПараметры.Вставить("ВременныйШаг", Неопределено);
			ДопПараметры.Вставить("ТекстШагаГруппы", СлужебнаяСтрока);
			ДопПараметры.Вставить("МасштабироватьВВидео", Ложь);
			Если Параметры.Свойство("МасштабироватьВВидео") Тогда
				ДопПараметры.Вставить("МасштабироватьВВидео", Параметры.МасштабироватьВВидео);
			КонецЕсли;
			Если Параметры.Свойство("ТегиГруппы") Тогда
				ДопПараметры.Вставить("ТегиГруппы", Параметры.ТегиГруппы);
			Иначе
				ДопПараметры.Вставить("ТегиГруппы", Новый Массив);
			КонецЕсли;
			//+++ ЦВ_ПР 25.06.2025 Для больших массивов шагов здесь "подвисает", неплохо бы оптимизировать быстродействие
			МаксСтрокаШага = Параметры.Сценарий.Шаги[Параметры.Сценарий.Шаги.Количество() - 1].СтрокаШага;
			Ванесса.СостояниеСВидео(Истина,Строка(Параметры.Шаг.СтрокаШага) + " Ждите. Заносим Шагам Свойства Групп шагов ",МаксСтрокаШага,Параметры.Шаг.СтрокаШага);
			//--- ЦВ_ПР 25.06.2025 конец вставки

			ПроставитьШагамСвойстваГруппировкиПриЗаписиРекурсивно(Параметры.СтрокаДереваГруппа, Параметры, ДопПараметры);
		КонецЕсли;

		Если Параметры.Свойство("ПроставитьПодчиненнымШагамИгнорироватьШагВАвтоинструкции") Тогда
			Если Параметры.ПроставитьПодчиненнымШагамИгнорироватьШагВАвтоинструкции Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("Уровень", 0);
				//+++ ЦВ_ПР 25.06.2025 Для больших массивов шагов здесь "подвисает", неплохо бы оптимизировать быстродействие
				МаксСтрокаШага = Параметры.Сценарий.Шаги[Параметры.Сценарий.Шаги.Количество() - 1].СтрокаШага;
				Ванесса.СостояниеСВидео(Истина,Строка(Параметры.Шаг.СтрокаШага) + " Ждите. Меняем ИГНОРИРОВАНИЕ в Автоинструкции...",МаксСтрокаШага,Параметры.Шаг.СтрокаШага);
				//--- ЦВ_ПР 25.06.2025 конец вставки
				Ванесса.ПроставитьШагамСвойстваИгнорироватьШагВАвтоинструкцииРекурсивно(Параметры.СтрокаДереваГруппа, Параметры, ДопПараметры);
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСлужебныеДирективыАвтоинструкций(Шаг, Сценарий) Экспорт

	ИдСтроки = Шаг.ИдСтроки;
	СтрокаДереваШаг = Неопределено;
	Ванесса.НайтиСтрокуДереваПоИдСтроки(ИдСтроки, Ванесса.Объект.ДеревоТестов.ПолучитьЭлементы(), СтрокаДереваШаг);
	ПроставитьСвойстваШагаСУчетомСвойствГруппы(Шаг, СтрокаДереваШаг, Сценарий);

	МассивСтрокПроизвольногоТекстаMarkdown = Новый Массив;

	Если Шаг.Свойство("МассивКомментариевШага") И Шаг.МассивКомментариевШага <> Неопределено Тогда
		Для Каждого КомментарийШага Из Шаг.МассивКомментариевШага Цикл
			Директива = "[autodoc.text]";
			Поз = Найти(НРег(КомментарийШага), Директива);
			Если Поз > 0 Тогда
				СлужебнаяСтрока = СокрЛП(Сред(КомментарийШага, Поз + СтрДлина(Директива)));
				ПараметрыОбработки = Новый Структура;
				ПараметрыОбработки.Вставить("ОбработкаПараметровШага", Истина);
				ПараметрыОбработки.Вставить("ВычислитьВыражения", Истина);
				ПараметрыОбработки.Вставить("Шаг", Шаг);
				ОбработатьУправляющуюСтрокуИнструкции(СлужебнаяСтрока, ПараметрыОбработки);

				Шаг.Вставить("ТекстИнструкция", СлужебнаяСтрока);
				Продолжить;
			КонецЕсли;

			Директива = "[autodoc.ignorestep]";
			Поз = Найти(НРег(КомментарийШага), Директива);
			Если Поз > 0 Тогда
				Шаг.Вставить("ИгнорироватьШагВАвтоинструкции", Истина);
				Продолжить;
			КонецЕсли;

			Директива = "[autodoc.md]";
			Поз = Найти(НРег(КомментарийШага), Директива);
			Если Поз > 0 Тогда
				СлужебнаяСтрока = СокрЛП(Прав(КомментарийШага, СтрДлина(КомментарийШага) - СтрДлина(Директива)));
				МассивСтрокПроизвольногоТекстаMarkdown.Добавить(СлужебнаяСтрока);
				Продолжить;
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;

	Если МассивСтрокПроизвольногоТекстаMarkdown.Количество() > 0 Тогда
		Шаг.Вставить("МассивСтрокПроизвольногоТекстаMarkdown", МассивСтрокПроизвольногоТекстаMarkdown);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьИзФичиПараметрыСборкиВидео() Экспорт
	Если Ванесса.Объект.РежимВыполненияОдногоШага Тогда
		Возврат;
	КонецЕсли;
	//+++ ЦВ_ПР 31.10.2025 Необходимо "Обрезать фичу" Сверху (если задан режим с текущего шага.. и до шага принудительной остановки сценариев, если таковой будет обнаружен)
	ПринудительнаяОстановкаСценария = Ложь;
	НайденШагЗапускаТеста = Ложь;
	НовыйМассивСценариев = Новый Массив;
	//+++ Определяем индекс текущего сценария для ГлубокоеКопирование
	Ванесса.ТекИД_СценарияВМассиве = -1;
	//--- ЦВ_ПР 31.10.2025

	Для Каждого Сценарий Из Ванесса.МассивСценариевДляВыполнения Цикл
		МассивФичи = ЗагрузитьФайлВМассив(Сценарий.ПолныйПутьКФиче);

		НайтиПризнакЧтоСценарийНадоИгнорировать(МассивФичи, Сценарий);
		НайтиПризнакЧтоСлайдСценарияНадоИгнорировать(МассивФичи, Сценарий);

		Шаги       = Сценарий.Шаги;
		//+++ ЦВ_ПР 22.10.2025 Необходими "Обрезать фичу" до шага принудительной остановки сценариев, если таковой будет обнаружен
		ИндексШагаОстановки = -1;
		НовыйМассивШагов = Новый Массив;
		//Определяем индекс текущего сценария для функции ГлубокоеКопирование
		Ванесса.ТекИД_СценарияВМассиве = Ванесса.ТекИД_СценарияВМассиве + 1;
		//--- ЦВ_ПР 22.10.2025
		Ванесса.ЗначениеТегаStartStopRecordVideo = Неопределено;  //+++ ЦВ_ПР 27.10.2025 Для управления директивным началом и окончанием записи Видео тегом StartRecordVideo и StopRecordVideo

		Для Каждого Шаг Из Шаги Цикл
			//+++ ЦВ_ПР 31.10.2025  Обрезка массива сверху с учетом параметров выполнения с Текущего шага...
			Если НЕ НайденШагЗапускаТеста
				И (Ванесса.Объект.РежимВыполненияДанногоСценарияСТекущегоШага ИЛИ Ванесса.Объект.РежимВыполненияДанногоСценарияСТекущегоШагаСПродолжением) Тогда
				Если Шаг.СтрокаШага < Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].ИдСтрокиШагаСКоторогоВыполнятьСценарийСДанногоШага Тогда
					Продолжить;
				КонецЕсли;
				НайденШагЗапускаТеста = Истина;
			КонецЕсли;
			//--- ЦВ_ПР 31.10.2025

			//+++ ЦВ_ПР 27.10.2025 Для управления директивным началом и окончанием записи Видео тегом StartRecordVideo и StopRecordVideo
			Если НЕ Ванесса.Объект.ЗаписьВидеоГруппаШаговКакШаг Тогда
				// Заполним здесь, если нет признака, Для группы шагов будет отдельная обработка,
				Ванесса.ЗначениеТегаStartStopRecordVideo =?(ЭтотШагНеИгнорироватьДляВидеоИнструкции(Шаг) ИЛИ (Шаг.Свойство("ПервыйВГруппеШагов") и Шаг.ПервыйВГруппеШагов),"Start",Ванесса.ЗначениеТегаStartStopRecordVideo);
				Если Ванесса.ШагИмеетТегКлиент(Шаг,"StartRecordVideo") Тогда
					Шаг.Вставить("ДирективныйЗапускЗаписиВидео", Истина);
					Ванесса.ЗначениеТегаStartStopRecordVideo = "Start";
				ИначеЕсли Ванесса.ШагИмеетТегКлиент(Шаг,"StopRecordVideo") Тогда
					Шаг.Вставить("ДирективныйОстановЗаписиВидео", Истина);
					Ванесса.ЗначениеТегаStartStopRecordVideo = "Stop";
				КонецЕсли;
				Шаг.Вставить("RecordVideo",Ванесса.ЗначениеТегаStartStopRecordVideo);
			КонецЕсли;
			//--- ЦВ_ПР 27.10.2025 конец вставки

			//+++ ЦВ_ПР 24.11.2025 Обрабатываем шаги до 1-го шага остановки выполнение сценариев данной фичи, дальнейшие шаги не выполняем
			ИндексШагаОстановки = ИндексШагаОстановки +1;
			Если Шаг.СтрокаРеальнойПроцедуры = "ЯОстанавливаюВыполнениеСценариевДаннойФичи" Тогда
				ПринудительнаяОстановкаСценария = Истина;
				Шаг.Вставить("ИдСледующегоШага", Неопределено);
				НовыйМассивШагов.Добавить(Ванесса.ГлубокоеКопирование(Шаг, Ложь));
				Прервать;
			КонецЕсли;
			//--- ЦВ_ПР 24.11.2025

			Если Шаг.Свойство("ЭтоШагКонтекста") И Шаг.ЭтоШагКонтекста Тогда
				НовыйМассивШагов.Добавить(Ванесса.ГлубокоеКопирование(Шаг, Ложь));
				Продолжить;
			КонецЕсли;

			НайтиГруппыШаговКоторыеНадоОбрабатыватьКакОдинШаг(МассивФичи, Шаг, Сценарий);
			НайтиГруппыШаговКоторыеНадоИгнорировать(МассивФичи, Шаг, Сценарий);

			Если НЕ Шаг.Свойство("ЭтоШагПодсценария") ИЛИ НЕ Шаг.ЭтоШагПодсценария Тогда
				НайтиШагиКоторыеНеНадоМасштабировать(МассивФичи, Шаг, Сценарий);
				НайтиШагиКоторыеНадоИгнорировать(МассивФичи, Шаг, Сценарий);
			КонецЕсли;
			НовыйМассивШагов.Добавить(Ванесса.ГлубокоеКопирование(Шаг, Ложь));

		КонецЦикла;
		//+++ ЦВ_ПР 25.06.2025 Почистим окно сообщений
		Ванесса.СостояниеСВидео(Истина,"",,);
		//--- ЦВ_ПР 25.06.2025 конец вставки
		//+++ ЦВ_ПР 31.10.2025 Если Начинали с текущего шага не в 1-м сценарии, то ничего не пишем в новый Массив
		Если НЕ НайденШагЗапускаТеста И (Ванесса.Объект.РежимВыполненияДанногоСценарияСТекущегоШага ИЛИ Ванесса.Объект.РежимВыполненияДанногоСценарияСТекущегоШагаСПродолжением) Тогда
			Продолжить;
		КонецЕсли;
		// Создаем обрезанный сценарий сразу с нужными шагами
		НовыйСценарий = Ванесса.ГлубокоеКопирование(Сценарий, Ложь);
		НовыйСценарий.Шаги = НовыйМассивШагов;
		Если НовыйМассивШагов.Количество() > 0 Тогда
			НовыйМассивСценариев.Добавить(НовыйСценарий);
		КонецЕсли;
		Если ПринудительнаяОстановкаСценария Тогда
			Прервать;
		КонецЕсли;
		//--- ЦВ_ПР 31.10.2025
	КонецЦикла;
	//+++ ЦВ_ПР 31.10.2025 Уточнение. Обрабатываем шаги до 1-го шага остановки выполнение сценариев или с указанного шага
	Если ПринудительнаяОстановкаСценария ИЛИ НайденШагЗапускаТеста Тогда
	// Заменяем исходный массив
		Ванесса.МассивСценариевДляВыполнения = НовыйМассивСценариев;
	КонецЕсли;
	//--- ЦВ_ПР 31.10.2025

КонецПроцедуры

