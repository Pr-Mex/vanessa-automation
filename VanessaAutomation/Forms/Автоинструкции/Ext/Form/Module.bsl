Функция ПрочитатьСтилиHTMLИнструкции() Экспорт
	
	ТекстСтилей = "";
	
	Попытка
		Если Ванесса.ФайлСуществуетКомандаСистемы(Ванесса.Объект.СтилиHTMLИнструкции) Тогда
			Текст = Новый ЧтениеТекста;
			Текст.Открыть(Ванесса.Объект.СтилиHTMLИнструкции, "UTF-8");
			ТекстСтилей = Текст.Прочитать();
			Текст.Закрыть();
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат ТекстСтилей;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьДопПараметрыШагаТекстовойИнструкции(СтруктураШага, ДанныеШагаДляТекстовойИнструкции) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеШагаДляТекстовойИнструкции.ТекстГруппы) Тогда
		СтруктураШага.Вставить("ТекстГруппы", ДанныеШагаДляТекстовойИнструкции.ТекстГруппы);
	КонецЕсли;	
	Если ЗначениеЗаполнено(ДанныеШагаДляТекстовойИнструкции.ИдГруппы) Тогда
		СтруктураШага.Вставить("ИдГруппы", ДанныеШагаДляТекстовойИнструкции.ИдГруппы);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеШагаДляТекстовойИнструкции.ШагИмеетТегScreenshot) Тогда
		СтруктураШага.Вставить("ШагИмеетТегScreenshot", ДанныеШагаДляТекстовойИнструкции.ШагИмеетТегScreenshot);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеШагаДляТекстовойИнструкции.ВГруппеЕстьШагиСТегомScreenshot) Тогда
		СтруктураШага.Вставить("ВГруппеЕстьШагиСТегомScreenshot", ДанныеШагаДляТекстовойИнструкции.ВГруппеЕстьШагиСТегомScreenshot);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеШагаДляТекстовойИнструкции(ТекШаг) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("УчаствуетВИнструкции", Истина);
	Результат.Вставить("ТекстГруппы", "");
	Результат.Вставить("ИдГруппы", "");
	Результат.Вставить("ШагИмеетТегScreenshot", "");
	Результат.Вставить("ВГруппеЕстьШагиСТегомScreenshot", "");
	
	Если Ванесса.Объект.ТекстовыеИнструкцииГруппаШаговКакШаг Тогда
		ГруппаВерхнегоУровняДляШага = СтрокаДереваГруппаВерхнегоУровняДляШага(ТекШаг);
		Если ГруппаВерхнегоУровняДляШага <> Неопределено Тогда
			ТекстГруппы = ГруппаВерхнегоУровняДляШага.Имя;
			Если Лев(ТекстГруппы, 1) = "*" Тогда
				ТекстГруппы = СокрЛП(Сред(ТекстГруппы, 2));
			КонецЕсли;
			
			Результат.Вставить("ТекстГруппы", ТекстГруппы);
			Результат.Вставить("ИдГруппы", ГруппаВерхнегоУровняДляШага.ИдСтроки);
			
			Если ВГруппеЕстьШагиСТегом(ГруппаВерхнегоУровняДляШага, "screenshot") Тогда
				Результат.Вставить("ВГруппеЕстьШагиСТегомScreenshot", "true");
				Результат.Вставить("УчаствуетВИнструкции", Ванесса.ШагИмеетТегКлиент(ТекШаг, "screenshot"));
			КонецЕсли;
			
			Если Ванесса.ШагИмеетТегКлиент(ТекШаг, "screenshot") Тогда
				Результат.Вставить("ШагИмеетТегScreenshot", "true");
			Иначе	
				Результат.Вставить("ШагИмеетТегScreenshot", "false");
			КонецЕсли;	
			
		КонецЕсли;
	//+++ ЦВ_ПР 25.11.2025 Часть шагов точно можно исключить для инструкции.	
	Иначе	                                                
		Если ТекШаг.Свойство("ДопТип") И
			(ТекШаг.ДопТип = "Условие" ИЛИ ТекШаг.ДопТип = "Цикл" ИЛИ ТекШаг.ДопТип = "УсловиеИначеЕсли" 
			ИЛИ ТекШаг.ДопТип = "Попытка" ИЛИ ТекШаг.ДопТип = "Исключение") Тогда
			Результат.Вставить("УчаствуетВИнструкции", Ложь);
 		КонецЕсли;	 
	//--- ЦВ_ПР 25.11.2025	
		
	КонецЕсли;	
	
	Возврат Результат;	
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВЛогИнструкцииHTMLВыполненияШага(СтруктураШага, РезультатПрохожденияШага) Экспорт
	
	Если Ванесса.СкриншотСделанВСценарии Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Ванесса.Объект.СоздаватьИнструкциюHTML Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураШага = Неопределено Тогда
		Ванесса.ТекИД_ВыполненногоШагаВМассиве = Ванесса.ТекИД_ШагаВМассиве;
		Шаги                           = Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].Шаги;
		СтруктураШага                  = Шаги[Ванесса.ТекИД_ШагаВМассиве];
	КонецЕсли;
	
	ДанныеШагаДляТекстовойИнструкции = ДанныеШагаДляТекстовойИнструкции(СтруктураШага);
	Если НЕ ДанныеШагаДляТекстовойИнструкции.УчаствуетВИнструкции Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСкриншота = "";
	КаталогВыгрузкиИнструкцийHTML = Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Ванесса.Объект.КаталогВыгрузкиИнструкцийHTML);
	Ванесса.МодульСкриншоты().СделатьСкриншотВТекстовойИнструкции(СтруктураШага, ИмяФайлаСкриншота, КаталогВыгрузкиИнструкцийHTML, Ванесса.ТекущиеДанныеИнструкцииHTML);
	
	//ТД = Новый ЗаписьТекста(ИмяФайлаЛогаИнструкцииHTML, КодировкаТекста.UTF8, , Истина);
	//ТД.ЗаписатьСтроку("НачалоШага");
	СтрокаШага = СтруктураШага.Имя; 
	//+++ ЦВ_ПР 27.06.2025 Для дополнительного определения текста шага  
	// и попробовать многое из добавленного заменить на "ДопТекст" из Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].ШагиУточ. 
	//При условии, что в этот момент уже появится запись (м.быть нужно переставить шаги записи в HTML ниже)
	ДопТекст = "";
	//--- ЦВ_ПР 27.06.2025 конец вставки
	Если СтруктураШага.Свойство("ШагСПараметрамиВТаблице") И СтруктураШага.ШагСПараметрамиВТаблице = Истина Тогда
		Для каждого СтрПараметрыТаблицы Из СтруктураШага.ПараметрыТаблицы Цикл
     		//+++ ЦВ_ПР 27.06.2025 не проставляется заголовок слайда по условию УШагаВыводитьТолькоСкриншот. 
			// Оставлено для возможного использования перед вызовом ОбработкаДопТекста. Удаляются двойные кавычки из текста (34- код двойных кавычек)
			//СтрДоп = СокрЛП(СтрЗаменить(СтрДоп, Символ(34), "")); 
			Если ЭтотШагНеИгнорироватьДляHTMLИнструкции(СтруктураШага) тогда
				ДопТекст = Ванесса.ОбработкаДопТекста(СтруктураШага.ПараметрыТаблицы[2]);
				ДопТекст = СтрЗаменить(ДопТекст,"Подсказка","");  
				ИмяФайлаСкриншота = Ванесса.ОбработкаДопТекста(СтруктураШага.ПараметрыТаблицы[1]);
				ИмяФайлаСкриншота = СтрЗаменить(ИмяФайлаСкриншота, "Путь", "");
				Прервать;
			иначе	
				СтрДоп = Ванесса.ОбработкаДопТекста(СтрПараметрыТаблицы);
				ДопТекст = ДопТекст + ?(ДопТекст = "","","\n") + СтрДоп;
			КонецЕсли;	
  			//--- ЦВ_ПР 27.06.2025 конец вставки
			
			СтрокаШага = СтрокаШага + "\n" + СтрПараметрыТаблицы;
		КонецЦикла;
  	//+++ ЦВ_ПР 27.06.2025 не проставляется заголовок слайда по условию УШагаВыводитьТолькоСкриншот.
	КонецЕсли;
    Если ДопТекст = "" тогда
		Если СтруктураШага.Свойство("ПереданныеВШагТаблицы") и СтруктураШага.ПереданныеВШагТаблицы.Количество() > 0 тогда;
			//+++ ЦВ_ПР В цикле неверно работают ПереданныеВШагТаблицы (Хранят 1-е значение, а не последнее - Почему?)
			Если ТипЗнч(СтруктураШага.ПереданныеВШагТаблицы[0][0])= Тип("Соответствие") тогда   
				Попытка
   					 ДопТекст = СтруктураШага.ПереданныеВШагТаблицы[0][0].получить("HTML").Тело.ТекстовоеСодержимое;
				Исключение
    				ДопТекст = ""; // или другое значение по умолчанию
				КонецПопытки;
			КонецЕсли;
			Если ДопТекст = "" тогда
				// +++ ЦВ_ПР Пока упрощенное чтение из 1-й колонки
				Если ЭтоШагВидеовставкиКартинки(СтруктураШага) Тогда
					ДопТекст = СтруктураШага.ЗначенияПараметров[1].Значение.Значение;
				иначе  
					Попытка
	   					 ДопТекст = СтруктураШага.ПереданныеВШагТаблицы[0][0].Кол1;
					Исключение
	    				ДопТекст = ""; // или другое значение по умолчанию
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;  
	КонецЕсли;  
	ДопТекст = Ванесса.ОбработкаДопТекста(ДопТекст);
	//--- ЦВ_ПР 27.06.2025 конец вставки
 	//+++ ЦВ_ПР 27.06.2025 не проставляется заголовок слайда по условию УШагаВыводитьТолькоСкриншот. Добавим Доп.Текст, если Шаг не игнорируется и есть доп.текст в шаге. 
    ЭтоШагБезСкриншотаДоп = ?(Ванесса.СписокШаговБезСкриншота.Найти(СтруктураШага.СтрокаРеальнойПроцедуры) = Неопределено, Ложь, Истина); 
	//ИгнорироватьШагВАвтоинструкции = ?(СтруктураШага.Свойство("ИгнорироватьШагВАвтоинструкции") = Ложь,Истина, СтруктураШага.ИгнорироватьШагВАвтоинструкции); 
	
	Если (ЭтоШагБезСкриншотаДоп = Истина и ДопТекст <> "" и ЭтоШагССубтитрами(СтруктураШага)) или (ДопТекст <> "" и ЭтоШагССубтитрами(СтруктураШага))
		или (ДопТекст <> "" и ЭтотШагНеИгнорироватьДляHTMLИнструкции(СтруктураШага)) Тогда 
		ДанныеШагаДляТекстовойИнструкции.ТекстГруппы = ДанныеШагаДляТекстовойИнструкции.ТекстГруппы + ". " + ДопТекст;
	КонецЕсли;                                                                                                          
	//--- ЦВ_ПР 27.06.2025 конец вставки	
 	//ТД.ЗаписатьСтроку("ИДШага=" + Формат(Ванесса.ТекИД_ШагаВМассиве, "ЧГ=; ЧН=0"));
	РезультатПрохожденияШага.Вставить("ИДШага", Ванесса.ТекИД_ШагаВМассиве);
	
	Если Не ПустаяСтрока(ИмяФайлаСкриншота) Тогда   
  		//ТД.ЗаписатьСтроку("Скриншот=" + ИмяФайлаСкриншота);
		РезультатПрохожденияШага.Вставить("Скриншот", ИмяФайлаСкриншота);
 	 //+++ ЦВ_ПР 04.06.2025. Добавлено здесь, для случая, когда нет Скриншота, но есть шаг с текстом (без скриншота).
	иначе                                           
		РезультатПрохожденияШага.Вставить("ДопТекст", ДопТекст);
 		Если ЗначениеЗаполнено(ДанныеШагаДляТекстовойИнструкции.ШагИмеетТегScreenShot) тогда 
			//ТД.ЗаписатьСтроку("ДопТекст=" + ДопТекст);
		иначе
			//ТД.ЗаписатьСтроку("ДопТекст=");
		КонецЕсли; 
	//--- ЦВ_ПР 04.06.2025 конец вставки	
	КонецЕсли;
	
	ЗаписатьДопПараметрыШагаТекстовойИнструкции(РезультатПрохожденияШага, ДанныеШагаДляТекстовойИнструкции);
	
	//ТД.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВЛогИнструкцииMarkdownВыполненияШага(СтруктураШага, РезультатПрохожденияШага) Экспорт
	
	Если Ванесса.СкриншотСделанВСценарии Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Ванесса.Объект.СоздаватьИнструкциюMarkdown Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураШага = Неопределено Тогда
		Ванесса.ТекИД_ВыполненногоШагаВМассиве = Ванесса.ТекИД_ШагаВМассиве;
		Шаги                           = Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].Шаги;
		СтруктураШага                  = Шаги[Ванесса.ТекИД_ШагаВМассиве];
	КонецЕсли;
	
	ДанныеШагаДляТекстовойИнструкции = ДанныеШагаДляТекстовойИнструкции(СтруктураШага);
	Если НЕ ДанныеШагаДляТекстовойИнструкции.УчаствуетВИнструкции Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСкриншота = "";
	КаталогВыгрузкиИнструкцийMarkdown = Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Ванесса.Объект.КаталогВыгрузкиИнструкцийMarkdown);
	Ванесса.МодульСкриншоты().СделатьСкриншотВТекстовойИнструкции(СтруктураШага, ИмяФайлаСкриншота, КаталогВыгрузкиИнструкцийMarkdown, Ванесса.ТекущиеДанныеИнструкцииMarkdown);
	
	//ТД = Новый ЗаписьТекста(ИмяФайлаЛогаИнструкцииMarkdown, КодировкаТекста.UTF8, , Истина);
	
	//ТД.ЗаписатьСтроку("НачалоШага");
	
	СтрокаШага = СтруктураШага.Имя;
	Если СтруктураШага.Свойство("ШагСПараметрамиВТаблице") И СтруктураШага.ШагСПараметрамиВТаблице = Истина Тогда
		Для каждого СтрПараметрыТаблицы Из СтруктураШага.ПараметрыТаблицы Цикл
			СтрокаШага = СтрокаШага + "\n" + СтрПараметрыТаблицы;
		КонецЦикла;
	КонецЕсли;
	
	//ТД.ЗаписатьСтроку("ИДШага=" + Формат(Ванесса.ТекИД_ШагаВМассиве, "ЧГ=; ЧН=0"));
	
	Если Не ПустаяСтрока(ИмяФайлаСкриншота) Тогда
		//ТД.ЗаписатьСтроку("Скриншот=" + ИмяФайлаСкриншота);
		РезультатПрохожденияШага.Вставить("Скриншот", ИмяФайлаСкриншота);
	КонецЕсли;
	
	РезультатПрохожденияШага.Вставить("ИДШага", Ванесса.ТекИД_ШагаВМассиве);
	ЗаписатьДопПараметрыШагаТекстовойИнструкции(РезультатПрохожденияШага, ДанныеШагаДляТекстовойИнструкции);
	
	//ТД.Закрыть();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

