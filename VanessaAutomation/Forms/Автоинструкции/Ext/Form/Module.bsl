	Если Ванесса.Объект.ЗаписьВидеоПодсвечиватьНажатияМышки Тогда
		Рез = Новый Массив;
		Ванесса.ЗаполнитьМассивPIDПоИмениПроцесса("MouseClickEvent.exe", Рез);
		Если Рез.Количество() = 0 Тогда
			ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + "tools\VideoTools\MouseClickEvent.exe";
				Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
					ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
						Ванесса.Локализовать("Не найден файл <%1>"),
						ИмяФайла
					);
				КонецЕсли;
				КомандаСистемы = ИмяФайла;
				Ванесса.ВыполнитьКомандуОСБезПоказаЧерногоОкна(КомандаСистемы, 0);
			КонецЕсли;

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаписьВидеоОдногоШага(ТекИД_СценарияВМассиве, ТекИД_ШагаВМассиве, ТекШаг) Экспорт
	Если Не Ванесса.Объект.СоздаватьИнструкциюВидео Тогда
		Возврат;
	КонецЕсли;	 
	
	Если Ванесса.Объект.ИдетЗаписьВидео Тогда
		Возврат;
	КонецЕсли;	 
	
	Если Ванесса.Объект.РежимВыполненияОдногоШага Тогда
		Возврат;
	КонецЕсли;	 

	//+++ ЦВ_ПР 27.10.2025 Уточнения с учетом директивного запуска или отказа от такового
	Если ТекШаг.Свойство("ДирективныйОстановЗаписиВидео") и ТекШаг.ДирективныйОстановЗаписиВидео Тогда 
		Возврат;
	КонецЕсли;
    ЭтотШагНеНужноЗаписывать = Ложь;
	Если ЭтотШагНеИгнорироватьДляВидеоИнструкции(ТекШаг) 
		ИЛИ (ТекШаг.Свойство("ДирективныйЗапускЗаписиВидео")  И ТекШаг.ДирективныйЗапускЗаписиВидео) Тогда
		// Директивное действие: Шаг не игнорировать или шаг с тегом StartRecordVideo или StartRecordVideo должны остановить текущую и возможно начать новую запись 			
	    ЭтотШагНеНужноЗаписывать = Ложь;
	ИначеЕсли ТекШаг.Свойство("RecordVideo") и ТекШаг.RecordVideo="Stop" Тогда 
	    ЭтотШагНеНужноЗаписывать = Истина;
	ИначеЕсли Ванесса.СписокШаговБезСкриншота.Найти(ТекШаг.СтрокаРеальнойПроцедуры)<>Неопределено Тогда 
	    ЭтотШагНеНужноЗаписывать = Истина; 
	ИначеЕсли ТекШаг.Свойство("ИгнорироватьШагВАвтоинструкции") и ТекШаг.ИгнорироватьШагВАвтоинструкции Тогда 
	    ЭтотШагНеНужноЗаписывать = Истина; 
	КонецЕсли;
	Если ЭтотШагНеНужноЗаписывать Тогда
		Возврат;
	КонецЕсли;	 
	//--- ЦВ_ПР 27.10.2025 конец вставки  

	ПараметрыВидео = ПолучитьПараметрыЗаписиВидео();
	ПараметрыВидео.Вставить("ТекИД_СценарияВМассиве", ТекИД_СценарияВМассиве);
	ПараметрыВидео.Вставить("ТекИД_ШагаВМассиве", ТекИД_ШагаВМассиве);
	ПараметрыВидео.Вставить("ТекШаг", ТекШаг);
	
	ПодключитьБиблиотекуРаботыСВидео();
	Ванесса.МодульРаботыСВидео.НачатьЗаписьВидеоОдногоШага(ПараметрыВидео);
	//+++ ЦВ_ПР 18.06.2025 Запомним для последующего использования в циклах ТекущийФайлВидео без пути доступа
	Если ПараметрыВидео.Свойство("ТекущийФайлВидео") тогда
		Ванесса.УстанановитьЗначениеДополнительногоПараметра("ТекущийФайлВидео", СтрЗаменить(ПараметрыВидео.ТекущийФайлВидео,ПараметрыВидео.ЗаписьВидеоКаталогДляВременныхФайлов + "\", ""));
	КонецЕсли;	 
	
	//--- ЦВ_ПР 18.06.2025	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаписьВидео() Экспорт
	Если НЕ Ванесса.Объект.СоздаватьИнструкциюВидео Тогда
		Возврат;
	КонецЕсли;	 
	
	ПараметрыВидео = ПолучитьПараметрыЗаписиВидео();
	ПараметрыВидео.Вставить("МассивСценариевДляВыполнения", Ванесса.МассивСценариевДляВыполнения);
	ПараметрыВидео.Вставить("МассивСтрокДереваДанныеФормы", Ванесса.МассивСтрокДереваДанныеФормы);
	
	Если Ванесса.СтатусЗапускаСценариев Тогда // если были упавшие шаги, то делать видео не надо
		ПодключитьБиблиотекуРаботыСВидео();
		Если ТипЗнч(Ванесса.ОбъектКонтекстСохраняемый) = Тип("Структура") И Ванесса.ОбъектКонтекстСохраняемый.Свойство("ВключенРежимОбучения") Тогда
			ПараметрыВидео.Вставить("ВключенРежимОбучения", Ванесса.ОбъектКонтекстСохраняемый.ВключенРежимОбучения);
			Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = ПрочитатьДанныеКешОзвучкиИнтерактивнойСправки();
			ПараметрыВидео.Вставить("ДанныеКешОзвучкиИнтерактивнойСправки", Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки);
			ПараметрыВидео.Вставить("КопироватьФайлыВоВрменныйКаталог", Истина);
		КонецЕсли;	
		Ванесса.МодульРаботыСВидео.ЗавершитьЗаписьВидео(ПараметрыВидео);
	КонецЕсли;	 
	
	Если Ванесса.Объект.ЗаписьВидеоПодсвечиватьНажатияМышки Тогда
		Ванесса.TASKKILL("MouseClickEvent.exe");
	КонецЕсли;	 
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеСловоряЗамен(ПараметрыВидео) Экспорт
	Если Ванесса.КешДанныеСловоряЗамен <> Неопределено Тогда
		Возврат Ванесса.КешДанныеСловоряЗамен;
	КонецЕсли;	 
	
	Результат = Новый Массив;
	
	Если ПараметрыВидео.ЗаписьВидеоСловарьЗамен.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Для Каждого ЭлементСловоряЗамен Из ПараметрыВидео.ЗаписьВидеоСловарьЗамен Цикл
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ЭлементСловоряЗамен.Значение) Тогда
			ТекстСообщения = Ванесса.Локализовать("Не найден файл словаря замен. <%1>");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", ЭлементСловоряЗамен.Значение);
			Ванесса.СообщитьПользователю(ТекстСообщения);
			ТекстСообщения = Ванесса.Локализовать("Не найден файл словаря замен. <%1>");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", ЭлементСловоряЗамен.Значение);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ЭлементСловоряЗамен.Значение, "UTF-8");
		
		Пока Истина Цикл
			Стр = Текст.ПрочитатьСтроку();
			Если Стр = Неопределено Тогда
				Прервать;
			КонецЕсли;	 
			
			Если СокрЛП(Стр) = "" Тогда
				Продолжить;
			КонецЕсли;	 
			
			Массив = Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(Стр, "|");
			
			ЗначениеЗамены = Новый Структура;
			ЗначениеЗамены.Вставить("ЧтоЗаменять", Массив[0]);
			ЗначениеЗамены.Вставить("НаЧтоЗаменять", Массив[1]);
			
			Результат.Добавить(ЗначениеЗамены);
		КонецЦикла;	
		
		Текст.Закрыть();
	КонецЦикла;
	
	Ванесса.КешДанныеСловоряЗамен = Результат;
	
	Возврат Результат; 
	
КонецФункции

&НаКлиенте
Функция Установлен_ffmpeg() Экспорт
	
	#Если НЕ ВебКлиент Тогда
	
	Строка_ffmpeg = Ванесса.Объект.ЗаписьВидеоКомандаFfmpeg;
	Если НЕ ЗначениеЗаполнено(Строка_ffmpeg) Тогда
		Строка_ffmpeg = "ffmpeg";
	КонецЕсли;	 
	
	Лог = ПолучитьИмяВременногоФайла("txt");
	Команда = """" + Строка_ffmpeg + """ -version > """ + Лог + """";
