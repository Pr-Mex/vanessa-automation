		//	ДополнитьСвойстваШага(Шаг, Сценарий, Шаг.ИДШага);
		//КонецЦикла;
		
		КешШагиСценария = КешШагиСценария(Сценарий.Шаги);
		Для каждого ВыполненныйШаг Из МассивШагов Цикл
			
			Если НЕ ВыполненныйШаг.Свойство("Скриншот") Тогда
				Продолжить;
			КонецЕсли;	
			
			Шаг = КешШагиСценария[ВыполненныйШаг.ИДСтроки];
			
			УШагаВыводитьТолькоСкриншот = Ложь;
			Если Шаг.Свойство("УШагаВыводитьТолькоСкриншот") Тогда
				УШагаВыводитьТолькоСкриншот = Шаг.УШагаВыводитьТолькоСкриншот;
			КонецЕсли;
			
			ЭтоШагБезСкриншота = ?(Ванесса.СписокШаговБезСкриншота.Найти(Шаг.СтрокаРеальнойПроцедуры) = Неопределено, Ложь, Истина);
			
			ОбработатьСлужебныеДирективыАвтоинструкций(Шаг, Сценарий);
			
			ИДСкриншота = ИДСкриншота + 1;
			
			Если Шаг.ИгнорироватьШагВАвтоинструкции Тогда
				Продолжить;
			КонецЕсли;
			
			Страница.ЗаписатьСтроку("");
			
			Если Шаг.Свойство("МассивСтрокПроизвольногоТекстаMarkdown")
				И Шаг.МассивСтрокПроизвольногоТекстаMarkdown.Количество() > 0 Тогда
				
				Для Каждого ЭлементМассива Из Шаг.МассивСтрокПроизвольногоТекстаMarkdown Цикл
					Страница.ЗаписатьСтроку(ЭлементМассива);
				КонецЦикла;
				
			Иначе
				
				Если ЭтоШагБезСкриншота Тогда
					МассивСтрок = Шаг.ПереданныеВШагТаблицы[0];
				Иначе
					ТекстШага = Шаг.Имя;
					Если Шаг.Свойство("ТекстИнструкция") И ЗначениеЗаполнено(Шаг.ТекстИнструкция) Тогда
						ТекстШага = Шаг.ТекстИнструкция;
					КонецЕсли;
					
					СтрокаШага = СтрЗаменить(ТекстШага, "\n", Символы.ПС);
					МассивСтрок = Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(СтрокаШага, Символы.ПС);
				КонецЕсли;
				
				Для Ккк = 0 По МассивСтрок.Количество() - 1 Цикл
					
					Если ЭтоШагБезСкриншота Тогда
						
						Если МассивСтрок[Ккк].Получить("MD") = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						Стр = МассивСтрок[Ккк].Получить("MD");
						Стр = стрЗаменить(Стр, "|", "");
						Стр = стрЗаменить(Стр, "'", "");
						Стр = СокрП(Стр);
						
					Иначе
						
						Стр = МассивСтрок[Ккк];
						
					КонецЕсли;
					
					Если ВыполненныйШаг.Свойство("ТекстГруппы") Тогда
						ЗаменятьТекстШаговНаИменаГрупп = Истина;
						Если Ванесса.ОбъектКонтекст.Свойство("ЗаменятьТекстШаговНаИменаГрупп") Тогда
							ЗаменятьТекстШаговНаИменаГрупп = Ванесса.ОбъектКонтекст.ЗаменятьТекстШаговНаИменаГрупп;
						КонецЕсли;
						
						Если ЗаменятьТекстШаговНаИменаГрупп Тогда
							Стр = ВыполненныйШаг.ТекстГруппы;
						КонецЕсли;
					КонецЕсли;
					
					Если Лев(Стр, 1) = "*" Тогда
						Стр = СокрЛ(Сред(Стр, 2));
					КонецЕсли;
					
					Если УШагаВыводитьТолькоСкриншот Тогда
						ТекстСтроки = "";
					ИначеЕсли Не Ванесса.Объект.АвтонумерацияШагов Или ЭтоШагБезСкриншота Тогда
						ТекстСтроки = Стр;
					ИначеЕсли Ккк = 0 Тогда
						ТекстСтроки = "" + Ванесса.ПолучитьФорматированныйНомер(НомШагаАвтонумерации, 3) + ". " + Стр;
						НомШагаАвтонумерации = НомШагаАвтонумерации + 1;
					Иначе
						ТекстСтроки = "" + Стр;
					КонецЕсли;
					
					Если Лев(ТекстСтроки, 1) = "*" Тогда
						ТекстСтроки = СокрЛ(Сред(ТекстСтроки, 2));
					КонецЕсли;
					
					Страница.ЗаписатьСтроку(Ванесса.УбратьСпецсиволыАвтоинструкций(ТекстСтроки));
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если ЭтоШагБезСкриншота Тогда
				Продолжить;
			КонецЕсли;
			
			Страница.ЗаписатьСтроку("");
			СтрСкриншотаДляMarkdown = СтрЗаменить(
				ВыполненныйШаг.Скриншот, 
				Ванесса.ДополнитьСлешВПуть(Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Ванесса.Объект.КаталогВыгрузкиИнструкцийMarkdown)), 
				"");
			Страница.ЗаписатьСтроку("![](" + СтрЗаменить(СтрСкриншотаДляMarkdown, "\", "/") + ")");
			
		КонецЦикла;
	КонецЦикла;
	
	Ванесса.СообщитьПользователю (Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Записываю %1"),
		ИмяФайлаДляЗаписи
	));
	Страница.Закрыть();
	
	//УдалитьФайлыКомандаСистемы(ИмяФайлаЛогаИнструкцииMarkdown);
	
КонецПроцедуры


