#Область Озвучка

&НаКлиенте
Функция ПрочитатьДанныеКешОзвучкиИнтерактивнойСправки(КаталогКеша = Неопределено) Экспорт
	#Если НЕ ВебКлиент Тогда

	Если Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки <> Неопределено Тогда
		Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;
	КонецЕсли;

	//Это значение кешируется в глобальных переменных
	Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Новый Соответствие;

	Если НЕ ЗначениеЗаполнено(КаталогКеша) Тогда
		КаталогКеша = Ванесса.Объект.КаталогКешОзвучкиДляИнтерактивнойСправки;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КаталогКеша) Тогда
		Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
		Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;
	КонецЕсли;

	ИмяФайла = Ванесса.ДополнитьСлешВПуть(КаталогКеша) + "Voices.json";

	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
		Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
		Ванесса.Отладка(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Файл <%1> не существует."),
			ИмяФайла
		));
		Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	Попытка
		ДанныеФайла = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ДанныеФайла = Неопределено;
		Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Если ДанныеФайла = Неопределено Тогда
		Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
		Ванесса.Отладка(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось прочитать данные файла <%1>."),
			ИмяФайла
		));
		Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;
	КонецЕсли;

	Для Каждого Элем Из ДанныеФайла.data Цикл
		ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.ДополнитьСлешВПуть(КаталогКеша) + Элем.Driver + "_" + Элем.Voice) + "data.json";
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
			Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
			Ванесса.Отладка(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Файл <%1> не существует."),
				ИмяФайла
			));
			Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;
		КонецЕсли;

		Файл = Новый Файл(ИмяФайла);
		ЧастьПути = Файл.Путь;
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.ОткрытьФайл(ИмяФайла);
		Попытка
			ДанныеФайлаОзвучки = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
			ДанныеФайлаОзвучки = Неопределено;
			Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;
		КонецПопытки;
		ЧтениеJSON.Закрыть();

		Для Каждого ДанныеMp3 Из ДанныеФайлаОзвучки.data Цикл
			Если НЕ ДанныеMp3.Свойство("Orig") Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ДанныеMp3.FileName, ЧастьПути) = 0 Тогда
				ДанныеMp3.FileName = ЧастьПути + ДанныеMp3.FileName;
			КонецЕсли;
			Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки.Вставить(ДанныеMp3.Text, ДанныеMp3);

			//Также добавляются данные по оригинальной строке, чтобы можно было понять есть ли для текста озвучка
			Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки.Вставить(ДанныеMp3.Orig, ДанныеMp3);
		КонецЦикла;

	КонецЦикла;

	Возврат Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки;

	#КонецЕсли

КонецФункции

&НаКлиенте
Функция ВерисияКешФайлаОзвучкиСовпадаетСМажорнойВерсией() Экспорт
	#Если НЕ ВебКлиент Тогда

	ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогКешОзвучкиДляИнтерактивнойСправки) + "Voices.json";
	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	Попытка
		ДанныеФайла = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ДанныеФайла = Неопределено;
		Ванесса.ДанныеКешОзвучкиИнтерактивнойСправки = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Если НЕ ДанныеФайла.Свойство("version") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ДанныеФайла.version = МажорнаяРелизнаяВерсия() Тогда
		Возврат Истина;
	КонецЕсли;

	#КонецЕсли

	Возврат Ложь;

