	Иначе
		Возврат;
	КонецЕсли;            
	
	ФайлФичи = Новый Файл(Ванесса.ТекущиеДанныеИнструкцииHTML.ПолныйПутьКФиче);
	
	//ШаблонИмяФайлаЛогаИнструкцииHTML = "%1InstrHTML_%2_%3_log.txt";
