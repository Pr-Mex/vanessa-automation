	//ИмяФайлаЛогаИнструкцииHTML = СтрЗаменить(ИмяФайлаЛогаИнструкцииHTML, Символы.НПП, "");
	
	//ТД = Новый ТекстовыйДокумент;
	ЗаголовокФичи = ПрочитатьЗаголовокФичи(Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].ПолныйПутьКФиче);
