	КешMD5 = Новый Соответствие;
КонецФункции

&НаКлиенте
Функция ОтключениеМодуля() Экспорт
	Ванесса = Неопределено;
	ДеревоТестов = Неопределено;
	ИмяТекущейСборки = Неопределено;
	ДобавлятьКИмениСценарияУсловияВыгрузки = Неопределено;
	КаталогОтносительноКоторогоНадоСтроитьИерархию = Неопределено;
	УровеньОтчета1 = Неопределено;
	УровеньОтчета2 = Неопределено;
	УровеньОтчета3 = Неопределено;
	ГруппировкаTestSuites = Неопределено;
	ПараметрыОтчетаУФ = Неопределено;
	StoryПоИДСтроки = Неопределено;
	КешMD5 = Неопределено;
КонецФункции

&НаКлиенте
Процедура Сформировать(СтруктураОФ) Экспорт
	#Если НЕ ВебКлиент Тогда
	ЗаполнитьРеквизитыИзОсновнойФормы();
	StoryПоИДСтроки.Очистить();
	КешMD5.Очистить();
	СформироватьОтчетАллюр2(СтруктураОФ, ДеревоТестов, ИмяТекущейСборки);
	StoryПоИДСтроки.Очистить();
	КешMD5.Очистить();
	ПараметрыОтчетаУФ = Неопределено;
	#Иначе
	Ванесса.СообщитьПользователю(Ванесса.Локализовать("Формирование отчёта в веб-клиенте не поддерживается."));
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыИзОсновнойФормы()
	ДеревоТестов = Ванесса.Объект.ДеревоТестов;
	ИмяТекущейСборки = Ванесса.Объект.ИмяТекущейСборки;
	ДобавлятьКИмениСценарияУсловияВыгрузки = Ванесса.Объект.ДобавлятьКИмениСценарияУсловияВыгрузки;
	КаталогОтносительноКоторогоНадоСтроитьИерархию = Ванесса.Объект.КаталогОтносительноКоторогоНадоСтроитьИерархию;
	УровеньОтчета1 = Ванесса.Объект.УровеньОтчета1;
	УровеньОтчета2 = Ванесса.Объект.УровеньОтчета2;
	УровеньОтчета3 = Ванесса.Объект.УровеньОтчета3;
	ГруппировкаTestSuites = Ванесса.Объект.ГруппировкаTestSuites;
КонецПроцедуры

