	Возврат "" + УИД + "-attachment.png";
КонецФункции

&НаКлиенте
Процедура ДобавитьСкриншотыКСценариюИлиШагуАллюр2(СтруктураВыгрузки, РезультатПрохождения)
	
	Если РезультатПрохождения.Свойство("МассивСкриншотов") Тогда
		// значит есть скриншоты
		
		Для каждого СтруктураСкриншот Из РезультатПрохождения.МассивСкриншотов Цикл
			ИмяФайлаСкриншотаВОтчете = "screenshot";
			Если СтруктураСкриншот.Свойство("ЗаголовокВнутреннегоОкна") Тогда
				ИмяФайлаСкриншотаВОтчете = СтруктураСкриншот.ЗаголовокВнутреннегоОкна;
			ИначеЕсли СтруктураСкриншот.Свойство("ИмяСкриншотаДляОтчета") Тогда
				ИмяФайлаСкриншотаВОтчете = СтруктураСкриншот.ИмяСкриншотаДляОтчета;
			КонецЕсли;
			Если СтруктураСкриншот.Свойство("ИмяКлиентаТестирования") Тогда
				ИмяФайлаСкриншотаВОтчете = СтруктураСкриншот.ИмяКлиентаТестирования + "." + ИмяФайлаСкриншотаВОтчете;
			КонецЕсли;	 
			
			Если СтруктураСкриншот.Свойство("ИмяФайлаИспользовалось") И СтруктураСкриншот.ИмяФайлаИспользовалось Тогда
				СтруктураСкриншот.ИмяФайла = ИмяФайлаСкриншотаБезКаталога();
			КонецЕсли;	 
			
			ДобавитьФайлКЭлементуАллюр2(СтруктураВыгрузки, ИмяФайлаСкриншотаВОтчете, СтруктураСкриншот.ИмяФайла, "image/png");
			СтруктураСкриншот.Вставить("ИмяФайлаИспользовалось", Истина);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлыКСценариюИлиШагуАллюр2(СтруктураВыгрузки, СписокФайлов, МассивXMLОтчетаAllure, ДопПараметрыАллюр2)
	
	Для каждого СтруктураФайл Из СписокФайлов Цикл
		РеальноеИмяФайла = СтруктураФайл.ИмяФайла;
		Если СтруктураФайл.Свойство("ДвоичныеДанные") Тогда
			ФайлОбъект = Новый Файл(Строка(СтруктураФайл.ИмяФайла) );
			
			РеальноеИмяФайла = Строка(Новый УникальныйИдентификатор()) + "-attachment" + ФайлОбъект.Расширение;
			
			СтруктураФайлаXML = Новый Структура;
			СтруктураФайлаXML.Вставить("РеальноеИмяФайла", РеальноеИмяФайла); 
			СтруктураФайлаXML.Вставить("ФайлXMLДвоичныеДанные", СтруктураФайл.ДвоичныеДанные);
			МассивXMLОтчетаAllure.Добавить(СтруктураФайлаXML);
		КонецЕсли;
		
		ТипФайла = Неопределено;
		СтруктураФайл.Свойство("ТипФайла", ТипФайла);
		Если ТипФайла = Неопределено Тогда
			ТипФайла = "text/plain";
		КонецЕсли;
		ДобавитьФайлКЭлементуАллюр2(СтруктураВыгрузки, СтруктураФайл.ИмяФайла, РеальноеИмяФайла, ТипФайла);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПодставитьЗначенияПеременныхВШаг(Знач Стр, ДанныеШага, ПодставлятьЗначения = Истина, СписокИсключений = Неопределено, СписокМаскируемых = Неопределено)
	
	ИсключенияПоИмени = СоответствиеИсключаемыхПеременных(СписокИсключений);

	// Получаем полный список переменных
	ПеременныеДляПоиска = Новый Массив;
	Если ДанныеШага.Свойство("ВсеПеременныеШага") Тогда
		ПеременныеДляПоиска = ДанныеШага.ВсеПеременныеШага;
	ИначеЕсли ДанныеШага.Свойство("ПеременныеДляСохраненияВШаг") Тогда
		ПеременныеДляПоиска = ДанныеШага.ПеременныеДляСохраненияВШаг;
	КонецЕсли;

	// Обрабатываем переменные в строке
	Для Каждого Элем Из ПеременныеДляПоиска Цикл
		Если Элем.Тип Тогда
			//Это глобальная переменная
			СпецСимволы = "$$";
		Иначе	
			//Это локальная переменная
			СпецСимволы = "$";
		КонецЕсли;	 
		
		Если ПодставлятьЗначения Тогда
			МаскироватьПеременную = ПеременнаяМаскируемаяПоСписку(Элем.Имя, СписокМаскируемых);
			Если МаскироватьПеременную ИЛИ ИсключенияПоИмени[НРег(СокрЛП(Элем.Имя))] = Неопределено Тогда
				ЗначениеДляПодстановки = ?(МаскироватьПеременную, "*****", Строка(Элем.Значение));
				Стр = СтрЗаменить(Стр, СпецСимволы + Элем.Имя + СпецСимволы, ЗначениеДляПодстановки);
				Если ДанныеШага.Свойство("ЕстьПеременныеТаблицыПеременных") И ДанныеШага.ЕстьПеременныеТаблицыПеременных Тогда
					Стр = СтрЗаменить(Стр, "'" + Элем.Имя + "'", "'" + ЗначениеДляПодстановки + "'");
					Стр = СтрЗаменить(Стр, """" + Элем.Имя + """", """" + ЗначениеДляПодстановки + """");
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;

	Если ПодставлятьЗначения И ДанныеШага.Свойство("ЗначенияИзТаблицыПеременных") Тогда
		Для Каждого КлючЗначение Из ДанныеШага.ЗначенияИзТаблицыПеременных Цикл
			МаскироватьПеременную = ПеременнаяМаскируемаяПоСписку(КлючЗначение.Ключ, СписокМаскируемых);
			Если МаскироватьПеременную ИЛИ ИсключенияПоИмени[НРег(СокрЛП(КлючЗначение.Ключ))] = Неопределено Тогда
				ЗначениеДляПодстановки = ?(МаскироватьПеременную, "*****", Строка(КлючЗначение.Значение));
				Стр = СтрЗаменить(Стр, "'" + КлючЗначение.Ключ + "'", "'" + ЗначениеДляПодстановки + "'");
				Стр = СтрЗаменить(Стр, """" + КлючЗначение.Ключ + """", """" + ЗначениеДляПодстановки + """");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Стр;

КонецФункции

&НаКлиенте
Функция СоответствиеИсключаемыхПеременных(СписокИсключений)
	Результат = Новый Соответствие;
	Если СписокИсключений <> Неопределено Тогда
		Для Каждого ЭлементСписка Из СписокИсключений Цикл
			Результат.Вставить(НРег(СокрЛП(ЭлементСписка)), Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проверяет имя переменной по списку шаблонов. Пустой список — маскирование выключено.
&НаКлиенте
Функция ПеременнаяМаскируемаяПоСписку(Знач ИмяПеременной, СписокМасок) Экспорт
	
	Если СписокМасок = Неопределено ИЛИ СписокМасок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Имя = НРег(СнятьОбрамляющиеКавычки(Строка(ИмяПеременной)));
	Для Каждого ЭлементСписка Из СписокМасок Цикл
		Шаблон = НРег(СокрЛП(Строка(ЭлементСписка)));
		Если Шаблон = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Имя = Шаблон ИЛИ СтрокаСоответствуетШаблонуМаски(Имя, Шаблон) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Матчер '*' без регулярных выражений и COM.
&НаКлиенте
Функция СтрокаСоответствуетШаблонуМаски(Знач Строка, Знач Шаблон) Экспорт
	
	ПозицияСтроки = 1;
	ПозицияШаблона = 1;
	ПозицияЗвездочки = -1;
	ПозицияСовпадения = 1;
	ДлинаСтроки = СтрДлина(Строка);
	ДлинаШаблона = СтрДлина(Шаблон);
	
	Пока ПозицияСтроки <= ДлинаСтроки Цикл
		СимволШаблона = ?(ПозицияШаблона <= ДлинаШаблона, Сред(Шаблон, ПозицияШаблона, 1), "");
		Если ПозицияШаблона <= ДлинаШаблона
			И СимволШаблона = Сред(Строка, ПозицияСтроки, 1) Тогда
			ПозицияШаблона = ПозицияШаблона + 1;
			ПозицияСтроки = ПозицияСтроки + 1;
		ИначеЕсли СимволШаблона = "*" Тогда
			ПозицияЗвездочки = ПозицияШаблона;
			ПозицияСовпадения = ПозицияСтроки;
			ПозицияШаблона = ПозицияШаблона + 1;
		ИначеЕсли ПозицияЗвездочки <> -1 Тогда
			ПозицияШаблона = ПозицияЗвездочки + 1;
			ПозицияСовпадения = ПозицияСовпадения + 1;
			ПозицияСтроки = ПозицияСовпадения;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Пока ПозицияШаблона <= ДлинаШаблона И Сред(Шаблон, ПозицияШаблона, 1) = "*" Цикл
		ПозицияШаблона = ПозицияШаблона + 1;
	КонецЦикла;
	
	Возврат ПозицияШаблона > ДлинаШаблона;
	
КонецФункции

// Возвращает значения паролей, явно указанных в тексте шага: пароль "..." / password "...".
&НаКлиенте
Функция ЗначенияПаролейИзТекстаШага(Знач Текст) Экспорт
	
	Возврат РазобратьПаролиВТекстеШага(Текст, Ложь).Значения;
	
КонецФункции

&НаКлиенте
Функция КлючевыеСловаПаролей()
	
	Результат = Новый Массив;
	Результат.Добавить("пароль");
	Результат.Добавить("паролем");
	Результат.Добавить("пароля");
	Результат.Добавить("паролей");
	Результат.Добавить("password");
	Результат.Добавить("passwords");
	Возврат Результат;
	
КонецФункции

// Заменяет значения паролей, явно указанных в тексте шага, на *****.
&НаКлиенте
Функция ЗамаскироватьПарольВТекстеШага(Знач Текст) Экспорт
	
	Возврат РазобратьПаролиВТекстеШага(Текст, Истина).Текст;
	
КонецФункции

// Разбирает литеральные пароли в тексте шага. Заменять=Истина — возвращает текст с *****.
&НаКлиенте
Функция РазобратьПаролиВТекстеШага(Знач Текст, Знач Заменять)
	
	Результат = Новый Структура("Текст, Значения", Текст, Новый Массив);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НижнийТекст = НРег(Текст);
	КлючевыеСлова = КлючевыеСловаПаролей();
	ДлинаТекста = СтрДлина(Текст);
	Позиция = 1;
	НовыйТекст = "";
	
	Пока Позиция <= ДлинаТекста Цикл
		Найденное = НайтиКлючевоеСловоПароля(Текст, НижнийТекст, Позиция, КлючевыеСлова);
		Если Найденное = Неопределено Тогда
			Если Заменять Тогда
				НовыйТекст = НовыйТекст + Сред(Текст, Позиция);
			КонецЕсли;
			Прервать;
		КонецЕсли;
		
		ПозицияПослеКлючевого = Найденное.Позиция + Найденное.Длина;
		ПозицияЗначения = ПозицияПослеКлючевого;
		Пока ПозицияЗначения <= ДлинаТекста Цикл
			Символ = Сред(Текст, ПозицияЗначения, 1);
			Если Символ = " " ИЛИ Символ = Символы.Таб Тогда
				ПозицияЗначения = ПозицияЗначения + 1;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// Метка может быть в кавычках: "password": "value" или 'Пароль'='value'.
		// Проверяем символ перед найденным ключевым словом, а не перед началом сканирования.
		СимволПередКлючевым = ?(Найденное.Позиция > 1, Сред(Текст, Найденное.Позиция - 1, 1), "");
		Если СимволПередКлючевым = """" ИЛИ СимволПередКлючевым = "'" Тогда
			Символ = ?(ПозицияЗначения <= ДлинаТекста, Сред(Текст, ПозицияЗначения, 1), "");
			Если Символ = """" ИЛИ Символ = "'" Тогда
				ПозицияЗначения = ПозицияЗначения + 1;
				Пока ПозицияЗначения <= ДлинаТекста Цикл
					Символ = Сред(Текст, ПозицияЗначения, 1);
					Если Символ = " " ИЛИ Символ = Символы.Таб Тогда
						ПозицияЗначения = ПозицияЗначения + 1;
					Иначе
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ЭтоПрисваивание = Ложь;
		Если ПозицияЗначения <= ДлинаТекста Тогда
			Символ = Сред(Текст, ПозицияЗначения, 1);
			Если Символ = ":" ИЛИ Символ = "=" Тогда
				ЭтоПрисваивание = Истина;
				ПозицияЗначения = ПозицияЗначения + 1;
				Пока ПозицияЗначения <= ДлинаТекста Цикл
					Символ = Сред(Текст, ПозицияЗначения, 1);
					Если Символ = " " ИЛИ Символ = Символы.Таб Тогда
						ПозицияЗначения = ПозицияЗначения + 1;
					Иначе
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		СимволЗначения = ?(ПозицияЗначения <= ДлинаТекста, Сред(Текст, ПозицияЗначения, 1), "");
		Если СимволЗначения = """" ИЛИ СимволЗначения = "'" Тогда
			ПозицияЗакрывающей = НайтиПодстрокуСПозиции(Текст, СимволЗначения, ПозицияЗначения + 1);
			Если ПозицияЗакрывающей = 0 Тогда
				Если Заменять Тогда
					НовыйТекст = НовыйТекст + Сред(Текст, Позиция);
				КонецЕсли;
				Прервать;
			КонецЕсли;
			
			Значение = Сред(Текст, ПозицияЗначения + 1, ПозицияЗакрывающей - ПозицияЗначения - 1);
			Если Значение <> "" И Значение <> "*****" И Лев(Значение, 1) <> "$" Тогда
				Результат.Значения.Добавить(Значение);
				Если Заменять Тогда
					НовыйТекст = НовыйТекст + Сред(Текст, Позиция, ПозицияЗначения - Позиция + 1) + "*****" + СимволЗначения;
				КонецЕсли;
			ИначеЕсли Заменять Тогда
				НовыйТекст = НовыйТекст + Сред(Текст, Позиция, ПозицияЗакрывающей - Позиция + 1);
			КонецЕсли;
			Позиция = ПозицияЗакрывающей + 1;
		ИначеЕсли ЭтоПрисваивание И ПозицияЗначения <= ДлинаТекста Тогда
			НачалоЗначения = ПозицияЗначения;
			Пока ПозицияЗначения <= ДлинаТекста Цикл
				Символ = Сред(Текст, ПозицияЗначения, 1);
				Если ЭтоРазделительЗначения(Символ) Тогда
					Прервать;
				КонецЕсли;
				ПозицияЗначения = ПозицияЗначения + 1;
			КонецЦикла;
			
			Значение = Сред(Текст, НачалоЗначения, ПозицияЗначения - НачалоЗначения);
			Если Значение <> "" И Значение <> "*****" И Лев(Значение, 1) <> "$" Тогда
				Результат.Значения.Добавить(Значение);
				Если Заменять Тогда
					НовыйТекст = НовыйТекст + Сред(Текст, Позиция, НачалоЗначения - Позиция) + "*****";
				КонецЕсли;
			ИначеЕсли Заменять Тогда
				НовыйТекст = НовыйТекст + Сред(Текст, Позиция, ПозицияЗначения - Позиция);
			КонецЕсли;
			Позиция = ПозицияЗначения;
		Иначе
			Если Заменять Тогда
				НовыйТекст = НовыйТекст + Сред(Текст, Позиция, ПозицияПослеКлючевого - Позиция);
			КонецЕсли;
			Позиция = ПозицияПослеКлючевого;
		КонецЕсли;
	КонецЦикла;
	
	Если Заменять Тогда
		Результат.Текст = НовыйТекст;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Позиция подстроки, начиная с указанной позиции. Нужна для совместимости с 8.2: трёхаргументный Найти недоступен.
&НаКлиенте
Функция НайтиПодстрокуСПозиции(Знач Текст, Знач Подстрока, Знач Начало)
	
	Если Начало > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Позиция = Найти(Сред(Текст, Начало), Подстрока);
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Начало + Позиция - 1;
	
КонецФункции

&НаКлиенте
Функция НайтиКлючевоеСловоПароля(Текст, НижнийТекст, Начало, КлючевыеСлова)
	
	ЛучшаяПозиция = 0;
	ЛучшаяДлина = 0;
	Для Каждого Ключевое Из КлючевыеСлова Цикл
		Поз = НайтиПодстрокуСПозиции(НижнийТекст, Ключевое, Начало);
		Пока Поз > 0 Цикл
			Если ЭтоГраницаСловаПароля(Текст, Поз, СтрДлина(Ключевое)) Тогда
				Если ЛучшаяПозиция = 0 ИЛИ Поз < ЛучшаяПозиция
					ИЛИ (Поз = ЛучшаяПозиция И СтрДлина(Ключевое) > ЛучшаяДлина) Тогда
					ЛучшаяПозиция = Поз;
					ЛучшаяДлина = СтрДлина(Ключевое);
				КонецЕсли;
				Прервать;
			КонецЕсли;
			Поз = НайтиПодстрокуСПозиции(НижнийТекст, Ключевое, Поз + 1);
		КонецЦикла;
	КонецЦикла;
	
	Если ЛучшаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("Позиция, Длина", ЛучшаяПозиция, ЛучшаяДлина);
	
КонецФункции

&НаКлиенте
Функция ЭтоГраницаСловаПароля(Текст, Позиция, ДлинаСлова)
	
	Если Позиция > 1 Тогда
		Предыдущий = Сред(Текст, Позиция - 1, 1);
		Если Предыдущий = """" ИЛИ Предыдущий = "'" Тогда
			Если НЕ ЭтоКлючСЗначением(Текст, Позиция + ДлинаСлова) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли ЭтоБукваИлиЦифра(Предыдущий) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПозицияПосле = Позиция + ДлинаСлова;
	Если ПозицияПосле <= СтрДлина(Текст) Тогда
		Следующий = Сред(Текст, ПозицияПосле, 1);
		Если ЭтоБукваИлиЦифра(Следующий) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Для ключа в кавычках разрешает маскирование только в форме "password": "value".
&НаКлиенте
Функция ЭтоКлючСЗначением(Текст, ПозицияПосле)
	
	Поз = ПозицияПосле;
	ДлинаТекста = СтрДлина(Текст);
	Пока Поз <= ДлинаТекста Цикл
		Символ = Сред(Текст, Поз, 1);
		Если Символ = " " ИЛИ Символ = Символы.Таб Тогда
			Поз = Поз + 1;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Поз = Поз + 1;
		Иначе
			Возврат Символ = ":" ИЛИ Символ = "=";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЭтоБукваИлиЦифра(Символ)
	
	Возврат Найти("abcdefghijklmnopqrstuvwxyz0123456789_абвгдеёжзийклмнопрстуфхцчшщъыьэюя", НРег(Символ)) > 0;
	
КонецФункции

&НаКлиенте
Функция ЭтоРазделительЗначения(Символ)
	
	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = ";" ИЛИ Символ = ","
		ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК ИЛИ Символ = ")" ИЛИ Символ = "]" ИЛИ Символ = "}";
	
КонецФункции

// Если значение совпало с паролем из текста шага, возвращает *****.
// Литеральные пароли внутри строкового параметра тоже маскируются.
&НаКлиенте
Функция ЗамаскироватьЗначениеПараметраПароля(Знач Значение, ЗначенияПаролей) Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ЗначенияПаролей <> Неопределено И ЗначенияПаролей.Количество() > 0
		И ЗначенияПаролей.Найти(Значение) <> Неопределено Тогда
		Возврат "*****";
	КонецЕсли;
	
	Возврат ЗамаскироватьПарольВТекстеШага(Значение);
	
КонецФункции

// Заменяет в строке значения маскируемых параметров на *****.
&НаКлиенте
Функция ЗамаскироватьПараметрыВСтроке(Знач Текст, ПараметрыМаскировки, СписокМаскируемых)
	
	Результат = ЗамаскироватьПарольВТекстеШага(Текст);
	Если НЕ ЗначениеЗаполнено(Результат) ИЛИ ПараметрыМаскировки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Параметры с именем «Пароль» маскируются всегда, даже при пустом списке масок.
	ЕстьПараметрыПароля = Ложь;
	Если СписокМаскируемых = Неопределено ИЛИ СписокМаскируемых.Количество() = 0 Тогда
		Для Каждого Параметр Из ПараметрыМаскировки Цикл
			Если ТипЗнч(Параметр) <> Тип("Структура")
				ИЛИ НЕ Параметр.Свойство("name") ИЛИ НЕ Параметр.Свойство("value") Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоИмяПараметраПароля(Параметр.name) Тогда
				ЕстьПараметрыПароля = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьПараметрыПароля Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДляЗамены = Новый Массив;
	Для Каждого Параметр Из ПараметрыМаскировки Цикл
		Если ТипЗнч(Параметр) <> Тип("Структура")
			ИЛИ НЕ Параметр.Свойство("name") ИЛИ НЕ Параметр.Свойство("value") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоИмяПараметраПароля(Параметр.name)
			И НЕ ПеременнаяМаскируемаяПоСписку(Параметр.name, СписокМаскируемых) Тогда
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Строка(Параметр.value));
		Если Значение = "" ИЛИ ЗначенияДляЗамены.Найти(Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначенияДляЗамены.Добавить(Значение);
	КонецЦикла;
	
	Для Инд1 = 1 По ЗначенияДляЗамены.Количество() - 1 Цикл
		Для Инд2 = 1 По ЗначенияДляЗамены.Количество() - Инд1 Цикл
			Если СтрДлина(ЗначенияДляЗамены[Инд2 - 1]) < СтрДлина(ЗначенияДляЗамены[Инд2]) Тогда
				ВременноеЗначение = ЗначенияДляЗамены[Инд2 - 1];
				ЗначенияДляЗамены[Инд2 - 1] = ЗначенияДляЗамены[Инд2];
				ЗначенияДляЗамены[Инд2] = ВременноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого Значение Из ЗначенияДляЗамены Цикл
		Если Результат = Значение Тогда
			Результат = "*****";
		ИначеЕсли СтрДлина(Значение) >= 4 Тогда
			Результат = СтрЗаменить(Результат, Значение, "*****");
		Иначе
			Результат = СтрЗаменить(Результат, """" + Значение + """", """*****""");
			Результат = СтрЗаменить(Результат, "'" + Значение + "'", "'*****'");
			Результат = СтрЗаменить(Результат, " " + Значение + " ", " ***** ");
			Результат = СтрЗаменить(Результат, "|" + Значение + "|", "|*****|");
			Результат = СтрЗаменить(Результат, "_" + Значение + "_", "_*****_");
			Если Прав(Результат, СтрДлина(Значение)) = Значение Тогда
				Результат = Лев(Результат, СтрДлина(Результат) - СтрДлина(Значение)) + "*****";
			КонецЕсли;
			Если Лев(Результат, СтрДлина(Значение)) = Значение Тогда
				Результат = "*****" + Сред(Результат, СтрДлина(Значение) + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Маскирует значения колонок «Пароль»/«Password» и маскируемых переменных в строке примера.
&НаКлиенте
Функция ЗамаскироватьИмяПримераДляОтчета(Знач Имя, СтрокаПримеров, СписокМаскируемых)
	
	Результат = ЗамаскироватьПарольВТекстеШага(Имя);
	Если СтрокаПримеров = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	РодительСтроки = СтрокаПримеров.ПолучитьРодителя();
	Если РодительСтроки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИменаПараметров = РодительСтроки.ИменованныеПараметры;
	Если ТипЗнч(ИменаПараметров) <> Тип("Массив") И ТипЗнч(ИменаПараметров) <> Тип("СписокЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Части = РазложитьСтрокуВМассивПодстрок(Результат, "|", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Смещение = 0;
	Если СокрЛП(Части[0]) = "" Тогда
		Смещение = 1;
	КонецЕсли;
	
	Результат = "";
	Для Инд = 0 По Части.Количество() - 1 Цикл
		Часть = Части[Инд];
		НомерПараметра = Инд - Смещение;
		Если НомерПараметра >= 0 И НомерПараметра < ИменаПараметров.Количество() Тогда
			Если ТипЗнч(ИменаПараметров) = Тип("СписокЗначений") Тогда
				ИмяПараметра = ИменаПараметров.Получить(НомерПараметра);
			Иначе
				ИмяПараметра = ИменаПараметров[НомерПараметра];
			КонецЕсли;
			ИмяПараметра = СокрЛП(Строка(ИмяПараметра));
			Если ЭтоИмяПараметраПароля(ИмяПараметра)
				ИЛИ ПеременнаяМаскируемаяПоСписку(ИмяПараметра, СписокМаскируемых) Тогда
				Часть = " ***** ";
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + ?(Инд = 0, "", "|") + Часть;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоИмяПараметраПароля(Знач ИмяПараметра)
	
	Имя = НРег(СнятьОбрамляющиеКавычки(ИмяПараметра));
	Для Каждого Ключевое Из КлючевыеСловаПаролей() Цикл
		Если Имя = Ключевое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Снимает обрамляющие кавычки/апострофы, которые могут остаться в заголовках таблиц.
&НаКлиенте
Функция СнятьОбрамляющиеКавычки(Знач Стр)
	
	Результат = СокрЛП(Стр);
	Если СтрДлина(Результат) >= 2 Тогда
		ПервыйСимвол = Лев(Результат, 1);
		ПоследнийСимвол = Прав(Результат, 1);
		Если (ПервыйСимвол = "'" И ПоследнийСимвол = "'")
			ИЛИ (ПервыйСимвол = """" И ПоследнийСимвол = """") Тогда
			Результат = СокрЛП(Сред(Результат, 2, СтрДлина(Результат) - 2));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВставитьГруппыШагов(СтрокаВыполнения, ДопПараметрыАллюр2, РезультатыПрохождения, МассивШагов)
	
	ДанныеГруппыШагов = ДопПараметрыАллюр2.ГруппыШагов[СтрокаВыполнения.ИдСтроки];
	Если ДанныеГруппыШагов <> Неопределено Тогда
		Возврат ДанныеГруппыШагов; 
	КонецЕсли;	 
	
	Если СтрокаВыполнения.Тип = "Сценарий" ИЛИ СтрокаВыполнения.Тип = "Пример" Тогда
		Возврат МассивШагов;
	КонецЕсли;	 
	
	МассивШагов = ВставитьГруппыШагов(СтрокаВыполнения.ПолучитьРодителя(), ДопПараметрыАллюр2, РезультатыПрохождения, МассивШагов);
	
	МассивИдСсылающихсяНаГруппу = ДопПараметрыАллюр2.СсылкиНаГруппы[СтрокаВыполнения.ПолучитьРодителя().ИдСтроки];
	Если МассивИдСсылающихсяНаГруппу = Неопределено Тогда
		МассивИдСсылающихсяНаГруппу = Новый Массив;
		ДопПараметрыАллюр2.СсылкиНаГруппы.Вставить(СтрокаВыполнения.ПолучитьРодителя().ИдСтроки, МассивИдСсылающихсяНаГруппу);
	КонецЕсли;	
	МассивИдСсылающихсяНаГруппу.Добавить(СтрокаВыполнения.ИдСтроки);
	
	Если (СтрокаВыполнения.Тип = "Область" И ПустаяСтрока(СтрокаВыполнения.ДопТип))
		ИЛИ СтрокаВыполнения.Тип = "ШагСценарий"
		ИЛИ СтрокаВыполнения.ДопТип = "Попытка"
		ИЛИ СтрокаВыполнения.ДопТип = "Исключение"
		ИЛИ СтрокаВыполнения.ДопТип = "УсловиеИначе"
		Тогда
		ШагВложенный = ПолучитьОписаниеШагаАллюр2();
		ШагВложенный.name  = ЗамаскироватьПарольВТекстеШага(Строка(СтрокаВыполнения.Имя));
		ШагВложенный.stage = "finished";
		ТекСтатус = РезультатыПрохождения.Статус;
		Если ТекСтатус = "Broken" И РезультатыПрохождения.Свойство("ШагУпалВСекцииПопыткаИсключение") И РезультатыПрохождения.ШагУпалВСекцииПопыткаИсключение Тогда
			ТекСтатус = "Success";
		КонецЕсли;	
		ЗаписатьСтатусВШагИлиСценарий2(ШагВложенный, ТекСтатус);
		МассивШагов.Добавить(ШагВложенный);
		МассивШагов = ШагВложенный.steps;
		ДопПараметрыАллюр2.ГруппыШагов.Вставить(СтрокаВыполнения.ИдСтроки, ШагВложенный.steps);
		Если СтрокаВыполнения.Тип = "ШагСценарий" ИЛИ ПустаяСтрока(СтрокаВыполнения.ДопТип) Тогда
			ДопПараметрыАллюр2.ОбъектыГруппШагов.Вставить(СтрокаВыполнения.ИдСтроки, ШагВложенный);
		КонецЕсли;
	КонецЕсли;	 
	
	Возврат МассивШагов; 
КонецФункции	 

&НаКлиенте
Процедура ОчиститьКешГруппШаговПриВыполненииСтрокиЦикла(СтрокаВыполнения, ДопПараметрыАллюр2)
	
	ТекИДСтроки = СтрокаВыполнения.ИДСтроки;
	ИдСтрокиКУдалению = Новый Соответствие;
	ИдСтрокиКУдалению.Вставить(ТекИДСтроки, Истина);
	Пока Истина Цикл
		
		Если ИдСтрокиКУдалению.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого КлючЗначение Из ИдСтрокиКУдалению Цикл
			ТекИДСтроки = КлючЗначение.Ключ;
			Прервать;
		КонецЦикла;	
		
		Если ДопПараметрыАллюр2.ГруппыШагов[ТекИДСтроки] <> Неопределено Тогда
			ДопПараметрыАллюр2.ГруппыШагов.Удалить(ТекИДСтроки);
		КонецЕсли;
		
		ДопПараметрыАллюр2.ОбъектыГруппШагов.Удалить(ТекИДСтроки);

		МассивИдСсылающихсяНаГруппу = ДопПараметрыАллюр2.СсылкиНаГруппы[ТекИДСтроки];
		Если МассивИдСсылающихсяНаГруппу <> Неопределено Тогда
			Для Каждого ПромИдСтроки Из МассивИдСсылающихсяНаГруппу Цикл
				ИдСтрокиКУдалению.Вставить(ПромИдСтроки, Истина);
			КонецЦикла;
			ДопПараметрыАллюр2.СсылкиНаГруппы.Удалить(ТекИДСтроки);
		КонецЕсли;	
		
		ИдСтрокиКУдалению.Удалить(ТекИДСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

// Обновляет статусы обычных групп и вызовов подсценариев, уже добавленных в отчет.
// Статусы управляющих шагов и обработанные исключения сохраняют свою семантику.
&НаКлиенте
Процедура ОбновитьСтатусыРодительскихГруппШагов(СтрокаВыполнения, РезультатыПрохождения, Статус, ДопПараметрыАллюр2)

	Если Статус <> "failed" И Статус <> "broken" Тогда
		Возврат;
	КонецЕсли;
	Если Статус = "broken" И РезультатыПрохождения.Свойство("ШагУпалВСекцииПопыткаИсключение")
		И РезультатыПрохождения.ШагУпалВСекцииПопыткаИсключение Тогда
		Возврат;
	КонецЕсли;

	СтрокаГруппы = СтрокаВыполнения.ПолучитьРодителя();
	Пока СтрокаГруппы <> Неопределено Цикл
		Если СтрокаГруппы.Тип = "Сценарий" ИЛИ СтрокаГруппы.Тип = "Пример" Тогда
			Прервать;
		КонецЕсли;

		ШагГруппы = ДопПараметрыАллюр2.ОбъектыГруппШагов[СтрокаГруппы.ИдСтроки];
		Если ШагГруппы <> Неопределено И (Статус = "failed" ИЛИ ШагГруппы.status <> "failed") Тогда
			ШагГруппы.status = Статус;
		КонецЕсли;
		СтрокаГруппы = СтрокаГруппы.ПолучитьРодителя();
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВыполнениеШагаАллюр2(МассивШагов, ДеревоТестов, РезультатыПрохождения, МассивXMLОтчетаAllure, СтруктураВыгрузкиСценария, ДопПараметрыАллюр2)
	
	МассивШаговДобавления = МассивШагов;
	СтрокаВыполнения = ДопПараметрыАллюр2.СтрокаДереваПоИдСтроки[РезультатыПрохождения.ИДСтроки];
	Если СтрокаВыполнения <> Неопределено Тогда
		МассивШаговДобавления = ВставитьГруппыШагов(СтрокаВыполнения.ПолучитьРодителя(), ДопПараметрыАллюр2, РезультатыПрохождения, МассивШаговДобавления);
	КонецЕсли;
	
	Если СтрокаВыполнения <> Неопределено И СтрокаВыполнения.ДопТип = "Цикл" Тогда
		ОчиститьКешГруппШаговПриВыполненииСтрокиЦикла(СтрокаВыполнения, ДопПараметрыАллюр2);
	КонецЕсли;	
	
	Шаг = ПолучитьОписаниеШагаАллюр2();
	Шаг.name  = Строка(РезультатыПрохождения.Имя);
    Если РезультатыПрохождения.Свойство("ПеременныеДляСохраненияВШаг") Тогда

        ДанныеДляИмени = Новый Структура;

		МассивПерем = Новый Массив;

		Для Каждого ПеремШага Из РезультатыПрохождения.ПеременныеДляСохраненияВШаг Цикл
			Позиция = Найти(Шаг.name, "'" + ПеремШага.Имя + "' в переменную");
			Если Позиция = 0 Тогда
				МассивПерем.Добавить(ПеремШага); 
			КонецЕсли;
        КонецЦикла;
		ДанныеДляИмени.Вставить("ПеременныеДляСохраненияВШаг", МассивПерем);

        Если РезультатыПрохождения.Свойство("ЕстьПеременныеТаблицыПеременных") Тогда
            ДанныеДляИмени.Вставить("ЕстьПеременныеТаблицыПеременных", РезультатыПрохождения.ЕстьПеременныеТаблицыПеременных);
        КонецЕсли;
        Если РезультатыПрохождения.Свойство("ЗначенияИзТаблицыПеременных") Тогда
            ДанныеДляИмени.Вставить("ЗначенияИзТаблицыПеременных", РезультатыПрохождения.ЗначенияИзТаблицыПеременных);
        КонецЕсли;

        Шаг.name = ПодставитьЗначенияПеременныхВШаг(Шаг.name, ДанныеДляИмени, ДопПараметрыАллюр2.ПодставлятьВОтчетеAllureЗначенияПеременных, ДопПараметрыАллюр2.СписокИсключаемыхПеременныхAllure, ДопПараметрыАллюр2.МаскируемыеПеременные);
    КонецЕсли;

	// Имя в результате шага уже замаскировано клиентом, поэтому литеральные пароли
	// извлекаем из исходной строки дерева фичи.
	ИсходноеИмяШага = Шаг.name;
	Если СтрокаВыполнения <> Неопределено Тогда
		ИсходноеИмяШага = СтрокаВыполнения.Имя;
	КонецЕсли;
	ЗначенияПаролей = ЗначенияПаролейИзТекстаШага(ИсходноеИмяШага);
	Шаг.name = ЗамаскироватьПарольВТекстеШага(Шаг.name);

	Если РезультатыПрохождения.Свойство("СвернутоИтераций") И РезультатыПрохождения.СвернутоИтераций > 0 Тогда
		Шаг.name = Шаг.name + " (" + СтрЗаменить(НСтр("ru = 'свернуто итераций цикла: %1'; en = 'collapsed loop iterations: %1'; sv = 'komprimerade loopiterationer: %1'"), "%1", Строка(РезультатыПрохождения.СвернутоИтераций)) + ")";
	КонецЕсли;

	Если РезультатыПрохождения.Свойство("ВремяНачала") И РезультатыПрохождения.ВремяНачала <> Неопределено Тогда
		Шаг.start = (РезультатыПрохождения.ВремяНачала - РазницаВМилисекундахМеждуЮниксИНачалЭпохи);
	КонецЕсли;
	Если РезультатыПрохождения.Свойство("ВремяОкончания") И РезультатыПрохождения.ВремяОкончания <> Неопределено Тогда
		Шаг.stop  = (РезультатыПрохождения.ВремяОкончания - РазницаВМилисекундахМеждуЮниксИНачалЭпохи);
	КонецЕсли;
	Шаг.stage = "finished";
	
	Если СтрокаВыполнения <> Неопределено Тогда	
		Счетчик = 1;
		Для каждого Элемент Из СтрокаВыполнения.ЗначенияПараметров Цикл
			ИмяПараметра = "Парам" + Счетчик;
			Счетчик = Счетчик + 1;
			Если ТипЗнч(Элемент.Значение) = Тип("Структура") И Элемент.Значение.Свойство("Значение") Тогда
				ТекстПараметра = Элемент.Значение.Значение;
			Иначе	
				ТекстПараметра = Элемент.Значение;
			КонецЕсли;	 
			ТекстДляПодстановки = ТекстПараметра;
			
			Если ДопПараметрыАллюр2.ПодставлятьВОтчетеAllureЗначенияПеременных Тогда
			    Значение = ПодставитьЗначенияПеременныхВШаг(ТекстДляПодстановки, РезультатыПрохождения, Истина, ДопПараметрыАллюр2.СписокИсключаемыхПеременныхAllure, ДопПараметрыАллюр2.МаскируемыеПеременные);
			Иначе	
			    Значение = ТекстПараметра;
			КонецЕсли;	 
			
			Значение = ЗамаскироватьЗначениеПараметраПароля(Значение, ЗначенияПаролей);
			Шаг["parameters"].Добавить(Новый Структура("name, value", ИмяПараметра, Значение));
		КонецЦикла;
		
		МассивПараметров = Новый Массив();		
		Если СтрокаВыполнения.ШагСПараметрамиВТаблице = Истина Тогда
			МассивСтрокCSV = Новый Массив;
			ПарамТаблица = Новый Массив;
			ПодчиненныеСтроки = СтрокаВыполнения.ПолучитьЭлементы();
			ЭтоЗаголовокТаблицы = Истина;
			ИндексыПарольныхКолонок = Новый Массив;
			Для каждого СтрокиТаблицы Из ПодчиненныеСтроки Цикл
				Если ЗначениеЗаполнено(СтрокиТаблицы.Тип) Тогда
					// значит это уже не строка таблицы
					Прервать;
				КонецЕсли;

				СтруктураПарамТаблица = Новый Структура;

				Если (СтрокиТаблицы.СтрокаПараметровШагаВВидеТаблицы <> Истина) ИЛИ (НЕ ЗначениеЗаполнено(СтрокиТаблицы.Имя)) Тогда
					ПарамТаблица = Новый Массив;
					МассивПараметров.Добавить(ПарамТаблица);
					ЭтоЗаголовокТаблицы = Истина;
					Продолжить;
				КонецЕсли;

				ЭтоСтрокаЗаголовка = ЭтоЗаголовокТаблицы;
				Если ЭтоСтрокаЗаголовка Тогда
					ИндексыПарольныхКолонок = Новый Массив;
					НомерКолонкиЗаголовка = 0;
					Для каждого Колонка Из СтрокиТаблицы.ПараметрыТаблицы Цикл
						НомерКолонкиЗаголовка = НомерКолонкиЗаголовка + 1;
						СтруктураПараметра = Колонка.Значение;
						ИмяКолонки = "";
						Если ТипЗнч(СтруктураПараметра) = Тип("Структура") И СтруктураПараметра.Свойство("ИмяПараметра") Тогда
							ИмяКолонки = СтруктураПараметра.ИмяПараметра;
						КонецЕсли;
						Если ЭтоИмяПараметраПароля(ИмяКолонки) Тогда
							ИндексыПарольныхКолонок.Добавить(НомерКолонкиЗаголовка);
						КонецЕсли;
					КонецЦикла;
					ЭтоЗаголовокТаблицы = Ложь;
				КонецЕсли;

				СтрокаЭтойСтроки = "";
				НомерКолонки = 0;
				Для каждого Колонка Из СтрокиТаблицы.ПараметрыТаблицы Цикл
					НомерКолонки       = НомерКолонки + 1;
					СтруктураПараметра = Колонка.Значение;
					Если ТипЗнч(СтруктураПараметра) = Тип("Структура") И СтруктураПараметра.Свойство("Значение") Тогда
						Значение = СтруктураПараметра.Значение;
					Иначе
						Значение = СтруктураПараметра;
					КонецЕсли;

				    Если ДопПараметрыАллюр2.ПодставлятьВОтчетеAllureЗначенияПеременных И ТипЗнч(Значение) = Тип("Строка") Тогда
				        Значение = ПодставитьЗначенияПеременныхВШаг(Значение, РезультатыПрохождения, Истина, ДопПараметрыАллюр2.СписокИсключаемыхПеременныхAllure, ДопПараметрыАллюр2.МаскируемыеПеременные);
				    КонецЕсли;
					Если НЕ ЭтоСтрокаЗаголовка И ИндексыПарольныхКолонок.Найти(НомерКолонки) <> Неопределено Тогда
						Значение = "*****";
					Иначе
						Значение = ЗамаскироватьЗначениеПараметраПароля(Значение, ЗначенияПаролей);
					КонецЕсли;

					СтрокаЭтойСтроки = СтрокаЭтойСтроки + ?(НомерКолонки = 1, "", ",") + """" + СтрЗаменить(Значение, """", """""") + """";
					СтруктураПарамТаблица.Вставить("Кол" + НомерКолонки, Значение);
				КонецЦикла;

				ПарамТаблица.Добавить(СтруктураПарамТаблица);
				МассивСтрокCSV.Добавить(СтрокаЭтойСтроки);
			КонецЦикла;

			Если ПарамТаблица.Количество() > 0 Тогда
				МассивПараметров.Добавить(ПарамТаблица);
			КонецЕсли;

			Если МассивПараметров.Количество() > 0 Тогда
				РеальноеИмяФайла = Строка(Новый УникальныйИдентификатор) + "-attachment.csv";

				Если МассивСтрокCSV.Количество() > 0 Тогда
					Попытка
						СтрокаCSV = Вычислить("СтрСоединить(МассивСтрокCSV, Символы.ВК + Символы.ПС)") + Символы.ВК + Символы.ПС;
					Исключение
						// 8.2 fallback — режим совместимости не позволяет использовать СтрСоединить
						СтрокаCSV = "";
						Для Каждого СтрТбл Из МассивСтрокCSV Цикл
							СтрокаCSV = СтрокаCSV + СтрТбл + Символы.ВК + Символы.ПС;
						КонецЦикла;
					КонецПопытки;
				Иначе
					СтрокаCSV = "";
				КонецЕсли;
				Попытка
					ДвоичныеДанныеФайла = Вычислить("ПолучитьДвоичныеДанныеИзСтроки(СтрокаCSV, КодировкаТекста.UTF8, Истина)");
				Исключение
					ВызватьИсключение "Для формирования отчёта Allure2 требуется платформа 8.3 и выше.";
				КонецПопытки;

				СтруктураФайлаXML = Новый Структура;
				СтруктураФайлаXML.Вставить("РеальноеИмяФайла", РеальноеИмяФайла);
				СтруктураФайлаXML.Вставить("ФайлXMLДвоичныеДанные", ДвоичныеДанныеФайла);
				МассивXMLОтчетаAllure.Добавить(СтруктураФайлаXML);
				ДобавитьФайлКЭлементуАллюр2(Шаг, "table", РеальноеИмяФайла, "text/csv");
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	МассивТегов = Неопределено;
	Если ТипЗнч(СтрокаВыполнения.ПроизвольныеЗначения) = Тип("Структура") Тогда
		СтрокаВыполнения.ПроизвольныеЗначения.Свойство("МассивТегов", МассивТегов);
	КонецЕсли;
	Если ТипЗнч(СтрокаВыполнения.ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура")
		И СтрокаВыполнения.ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивТегов") Тогда
		СтрокаВыполнения.ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивТегов", МассивТегов);
	КонецЕсли;

	ЗаписатьСтатусВШагИлиСценарий2(Шаг, РезультатыПрохождения.Статус, МассивТегов);
	ОбновитьСтатусыРодительскихГруппШагов(СтрокаВыполнения, РезультатыПрохождения, Шаг.status, ДопПараметрыАллюр2);
	Если ((РезультатыПрохождения.Статус = "Failed") ИЛИ (РезультатыПрохождения.Статус = "Pending")) 
		И РезультатыПрохождения.Свойство("ОписаниеОшибки") Тогда
		ОписаниеОшибки = "";
		ПодробноеОписаниеОшибки = "";
		ПодробноеОписаниеОшибкиAllure2(РезультатыПрохождения.ОписаниеОшибки, ОписаниеОшибки, ПодробноеОписаниеОшибки);
		Шаг.Вставить("statusDetails", 
			Новый Структура("known, muted, flaky, message, trace", 
							Ложь, Ложь, Ложь, ОписаниеОшибки, ПодробноеОписаниеОшибки));
	КонецЕсли; 
	
	МассивШаговДобавления.Добавить(Шаг);
	
	Если СтрокаВыполнения.Тип = "Область" И НЕ ПустаяСтрока(СтрокаВыполнения.ДопТип) Тогда
		МассивШаговДобавления = Шаг.steps;
		ДопПараметрыАллюр2.ГруппыШагов.Вставить(СтрокаВыполнения.ИдСтроки, Шаг.steps);
	КонецЕсли;	 
	
	Если РезультатыПрохождения.Свойство("СписокФайлов") Тогда
		ДобавитьФайлыКСценариюИлиШагуАллюр2(Шаг, РезультатыПрохождения.СписокФайлов, МассивXMLОтчетаAllure, ДопПараметрыАллюр2);
		
		СписокФайловДляСценария = Новый Массив;
		Для Каждого СтруктураФайл Из РезультатыПрохождения.СписокФайлов Цикл
			Если СтруктураФайл.Свойство("ДобавлятьФайлКСценарию") И НЕ СтруктураФайл.ДобавлятьФайлКСценарию Тогда
				Продолжить;
			КонецЕсли;	 
			
			СписокФайловДляСценария.Добавить(СтруктураФайл);
		КонецЦикла;	 
		
		ДобавитьФайлыКСценариюИлиШагуАллюр2(СтруктураВыгрузкиСценария, СписокФайловДляСценария, МассивXMLОтчетаAllure, ДопПараметрыАллюр2);
	КонецЕсли;	 
	
	ДобавитьСкриншотыКСценариюИлиШагуАллюр2(Шаг, РезультатыПрохождения);
КонецПроцедуры

&НаКлиенте
Процедура ПодробноеОписаниеОшибкиAllure2(Знач ИсходнаяСтрока, ОписаниеОшибки, ПодробноеОписаниеОшибки)
	ПодробноеОписаниеОшибки = ИсходнаяСтрока;
	
	СтрокаДеталиОшибки = ПолучитьТекстСообщенияПользователю("ДеталиОшибки:");
	Поз = Найти(ИсходнаяСтрока, СтрокаДеталиОшибки);
	Если Поз > 0 Тогда
		ИсходнаяСтрока = СокрЛП(Сред(ИсходнаяСтрока, Поз + 1 + СтрДлина(СтрокаДеталиОшибки)));
		ОписаниеОшибки = ИсходнаяСтрока;
		Возврат;
	КонецЕсли;	 
	
	Пока Истина Цикл
		Поз1 = Найти(ИсходнаяСтрока, "{");
		Поз2 = Найти(ИсходнаяСтрока, "}:");
		
		Если Поз1 = 0 ИЛИ Поз2 = 0 ИЛИ Поз1 > Поз2 Тогда
			Прервать;
		КонецЕсли;	 
		
		ЧастьСтроки1 = Лев(ИсходнаяСтрока, Поз1 - 1);
		ЧастьСтроки2 = СокрЛ(Сред(ИсходнаяСтрока, Поз2 + 3));
		
		ИсходнаяСтрока = ЧастьСтроки1 + ЧастьСтроки2;
	КонецЦикла;	

	СтрокаТехническиеДанные = ПолучитьТекстСообщенияПользователю("Технические данные");
	Поз = Найти(ИсходнаяСтрока, СтрокаТехническиеДанные);
	Если Поз > 0 Тогда
		ИсходнаяСтрока = СокрЛП(Лев(ИсходнаяСтрока, Поз - 1));
	КонецЕсли;	 
	
	ВСкобках = 0;
	
	ОткСкобки = "<([";
	ЗакрСкобки = ">)]";
	Прерывание = ".:" + Символы.ПС;
	
	Для Поз = 0 По СтрДлина(ИсходнаяСтрока) - 1 Цикл
		
		Символ = Сред(ИсходнаяСтрока, Поз, 1);
		Если Найти(ОткСкобки, Символ) > 0 Тогда
			
			ВСкобках = ВСкобках + 1;
			
		ИначеЕсли Найти(ЗакрСкобки, Символ) > 0 Тогда
			
			ВСкобках = Макс(ВСкобках - 1, 0);
			
		ИначеЕсли Найти(Прерывание, Символ) > 0 И ВСкобках = 0 Тогда
			
			ИсходнаяСтрока = Лев(ИсходнаяСтрока, Поз);
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеОшибки = ИсходнаяСтрока;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаписатьОбъектВJson(СтруктураОбъекта, ИмяФайла, МассивXMLОтчетаAllure)
	Перем ЗаписьJSON, ПараметрыЗаписиJSON, СтрокаJSON, СтруктураФайлаXML;

	Попытка
		ЗаписьJSON = Вычислить("Новый ЗаписьJSON");
		ПараметрыЗаписиJSON = Вычислить("Новый ПараметрыЗаписиJSON(, Символы.Таб)");
	Исключение
		ВызватьИсключение "Для формирования отчёта Allure2 требуется платформа 8.3 и выше.";
	КонецПопытки;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураОбъекта);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	СтруктураФайлаXML = Новый Структура;
	СтруктураФайлаXML.Вставить("РеальноеИмяФайла", Строка(ИмяФайла));
	СтруктураФайлаXML.Вставить("ФайлXMLДвоичныеДанные", Вычислить("ПолучитьДвоичныеДанныеИзСтроки(СтрокаJSON, КодировкаТекста.UTF8)"));
	МассивXMLОтчетаAllure.Добавить(СтруктураФайлаXML);

КонецПроцедуры

&НаКлиенте
Функция ОпределитьМассивТеговШага(СтрСтроки)
	Перем МассивТегов;
	МассивТегов = Новый Массив;

	МассивТеговШага = Новый Массив;
	Если ТипЗнч(СтрСтроки.ПроизвольныеЗначения) = Тип("Структура") Тогда 
		Если СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТеговШага") Тогда
			СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТеговШага", МассивТеговШага);
		КонецЕсли;
		
		Если ТипЗнч(МассивТеговШага) = Тип("Массив") И МассивТеговШага.Количество() = 0 Тогда 
			Если СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов") Тогда
				СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов", МассивТеговШага);
			КонецЕсли;
		ИначеЕсли  НЕ ТипЗнч(МассивТеговШага) = Тип("Массив")   Тогда
			Если СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов") Тогда
				СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов", МассивТеговШага);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(МассивТеговШага) = Тип("Массив") Тогда
		Если (МассивТеговШага.Количество() = 0 И СтрСтроки.ПолучитьРодителя() <> Неопределено)
			ИЛИ (СтрСтроки.ПолучитьРодителя() <> Неопределено И НЕ МассивТеговШага.Количество() > 0)  Тогда
			
			МассивТеговШага = ОпределитьМассивТеговШага(СтрСтроки.ПолучитьРодителя());
			
		КонецЕсли; 
	КонецЕсли; 
	
	Если ТипЗнч(МассивТеговШага) = Тип("Массив") Тогда
		ФиксМассив = Новый ФиксированныйМассив(МассивТеговШага);
		МассивТегов = Новый Массив(ФиксМассив);
	КонецЕсли;
	
	Возврат МассивТегов;
	
КонецФункции			

&НаКлиенте
Функция ПустойРезультатПрохожденияТестовСценария(СтрокаДерева)
	РезультатПрохожденияТестовШагов = Новый Структура;
	РезультатПрохожденияТестовШагов.Вставить("ВремяНачала", ТекущаяУниверсальнаяДатаВМиллисекундах());
	РезультатПрохожденияТестовШагов.Вставить("ВремяОкончания", РезультатПрохожденияТестовШагов.ВремяНачала);
	РезультатПрохожденияТестовШагов.Вставить("ДатаНачала", ТекущаяДата());
	РезультатПрохожденияТестовШагов.Вставить("ИДСтроки", СтрокаДерева.ИДСтроки);
	РезультатПрохожденияТестовШагов.Вставить("НомерСтрокиВФиче", СтрокаДерева.НомерСтрокиВФиче);
	РезультатПрохожденияТестовШагов.Вставить("ОписаниеОшибки", "");
	РезультатПрохожденияТестовШагов.Вставить("РезультатПрохожденияТестовШагов", Новый Массив);
	Возврат РезультатПрохожденияТестовШагов; 
КонецФункции	 

&НаКлиенте
Процедура РассчитатьДлительностьВыполненияГруппШаговРекурсивно(Шаги, НачалоВыполненияРодитель, ОкончаниеВыполненияРодитель)
	Для Каждого ТекШаг Из Шаги Цикл
		НачалоВыполнения = ТекШаг.start;
		ОкончаниеВыполнения = ТекШаг.stop;
		Если ТекШаг.Свойство("Steps") Тогда
			РассчитатьДлительностьВыполненияГруппШаговРекурсивно(ТекШаг.Steps, НачалоВыполнения, ОкончаниеВыполнения);
		ИначеЕсли ТекШаг.Свойство("befores") Тогда
			РассчитатьДлительностьВыполненияГруппШаговРекурсивно(ТекШаг.befores, НачалоВыполнения, ОкончаниеВыполнения);
		КонецЕсли;	 
		ТекШаг.start = НачалоВыполнения;
		ТекШаг.stop = ОкончаниеВыполнения;
		
		Если НачалоВыполненияРодитель = Неопределено ИЛИ (НачалоВыполнения <> Неопределено И НачалоВыполненияРодитель > НачалоВыполнения) Тогда
			НачалоВыполненияРодитель = НачалоВыполнения;
		КонецЕсли;	 
		Если ОкончаниеВыполненияРодитель = Неопределено ИЛИ (ОкончаниеВыполнения <> Неопределено И ОкончаниеВыполненияРодитель < ОкончаниеВыполнения) Тогда
			ОкончаниеВыполненияРодитель = ОкончаниеВыполнения;
		КонецЕсли;	 
	КонецЦикла;	 
КонецПроцедуры 

&НаКлиенте
Процедура РассчитатьДлительностьВыполненияГруппШагов(СтруктураВыгрузки)
	Если СтруктураВыгрузки.Свойство("Steps") Тогда
		НачалоВыполнения = СтруктураВыгрузки.start;
		ОкончаниеВыполнения = СтруктураВыгрузки.stop;
		РассчитатьДлительностьВыполненияГруппШаговРекурсивно(СтруктураВыгрузки.Steps, НачалоВыполнения, ОкончаниеВыполнения);
	ИначеЕсли СтруктураВыгрузки.Свойство("befores") Тогда
		НачалоВыполнения = СтруктураВыгрузки.start;
		ОкончаниеВыполнения = СтруктураВыгрузки.stop;
		РассчитатьДлительностьВыполненияГруппШаговРекурсивно(СтруктураВыгрузки.befores, НачалоВыполнения, ОкончаниеВыполнения);
	КонецЕсли;	 
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьИмяФичиИзПолногоПути(Знач Стр)
    // Ищем последнее вхождение ":"
    Поз = 0;
    Для Сч = 1 По СтрДлина(Стр) Цикл
        Если Сред(Стр, Сч, 1) = ":" Тогда
            Поз = Сч;
        КонецЕсли;
    КонецЦикла;
    
    // Если ":" найдено И оно НЕ в позиции 2 (как в "D:"), то обрезаем
    Если Поз > 2 Тогда
        Возврат СокрЛП(Лев(Стр, Поз - 1));
    Иначе
        Возврат СокрЛП(Стр);
    КонецЕсли;
КонецФункции

&НаКлиенте
Функция УниверсальноеПолноеИмяФайлаTestOps(Знач ПолноеИмяФайлаИлиФайл)
	
	Возврат НРег(СтрЗаменить(ПолноеИмяФайлаИлиФайл, "\", "/"));
	
КонецФункции

// Заменяет значения параметров на ***** в копиях, не меняя исходные структуры результата прогона.
&НаКлиенте
Функция ЗамаскироватьЗначенияПараметровДляОтчета(ПараметрыМаскировки, СписокМаскируемых)
	
	Если ПараметрыМаскировки = Неопределено Тогда
		Возврат ПараметрыМаскировки;
	КонецЕсли;
	
	Для Инд = 0 По ПараметрыМаскировки.Количество() - 1 Цикл
		Парам = ПараметрыМаскировки[Инд];
		Если ТипЗнч(Парам) <> Тип("Структура")
			ИЛИ НЕ Парам.Свойство("name") ИЛИ НЕ Парам.Свойство("value") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоИмяПараметраПароля(Парам.name)
			И НЕ ПеременнаяМаскируемаяПоСписку(Парам.name, СписокМаскируемых) Тогда
			Если ТипЗнч(Парам.value) = Тип("Строка") Тогда
				МаскированноеЗначение = ЗамаскироватьПарольВТекстеШага(Парам.value);
				Если МаскированноеЗначение <> Парам.value Тогда
					КопияПараметра = Новый Структура;
					Для Каждого Поле Из Парам Цикл
						КопияПараметра.Вставить(Поле.Ключ, Поле.Значение);
					КонецЦикла;
					КопияПараметра.value = МаскированноеЗначение;
					ПараметрыМаскировки[Инд] = КопияПараметра;
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		КопияПараметра = Новый Структура;
		Для Каждого Поле Из Парам Цикл
			КопияПараметра.Вставить(Поле.Ключ, Поле.Значение);
		КонецЦикла;
		КопияПараметра.value = "*****";
		ПараметрыМаскировки[Инд] = КопияПараметра;
	КонецЦикла;
	
	Возврат ПараметрыМаскировки;
	
КонецФункции

&НаКлиенте
Процедура ЗамаскироватьПоляСценарияАллюр(СтруктураВыгрузки, СписокМаскируемыхПеременных)
	
	ПараметрыСценария = Новый Массив;
	Если СтруктураВыгрузки.Свойство("parameters") Тогда
		ПараметрыСценария = СтруктураВыгрузки.parameters;
	КонецЕсли;
	
	Если СтруктураВыгрузки.Свойство("name") Тогда
		СтруктураВыгрузки.name = ЗамаскироватьПараметрыВСтроке(СтруктураВыгрузки.name, ПараметрыСценария, СписокМаскируемыхПеременных);
	КонецЕсли;
	
	Если СтруктураВыгрузки.Свойство("fullName") Тогда
		СтруктураВыгрузки.fullName = ЗамаскироватьПараметрыВСтроке(СтруктураВыгрузки.fullName, ПараметрыСценария, СписокМаскируемыхПеременных);
	КонецЕсли;
	
	ЗамаскироватьЗначенияПараметровДляОтчета(ПараметрыСценария, СписокМаскируемыхПеременных);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыДляAllureTestOps(СтруктураВыгрузки, СтрокаСценария, ДопПараметрыАллюр2)
	
	СписокМаскируемыхПеременных = Новый Массив;
	Если ДопПараметрыАллюр2.Свойство("МаскируемыеПеременные") Тогда
		СписокМаскируемыхПеременных = ДопПараметрыАллюр2.МаскируемыеПеременные;
	КонецЕсли;
	
	Если НЕ ДопПараметрыАллюр2.Свойство("КаталогПроекта") Тогда
		ЗамаскироватьПоляСценарияАллюр(СтруктураВыгрузки, СписокМаскируемыхПеременных);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДопПараметрыАллюр2.КаталогПроекта) Тогда
		ЗамаскироватьПоляСценарияАллюр(СтруктураВыгрузки, СписокМаскируемыхПеременных);
		Возврат;
	КонецЕсли;	
	
	Если СтрокаСценария.Тип = "Пример" Тогда
		ПутьКФиче = СтрокаСценария.ПолучитьРодителя().ПолучитьРодителя().ПолучитьРодителя().ПолныйПуть;
	Иначе
		ПутьКФиче = СтрокаСценария.ПолныйПуть;
	КонецЕсли; 

	ПутьКФиче = ПолучитьИмяФичиИзПолногоПути(ПутьКФиче);
	ПутьКФичеУниверсальный = УниверсальноеПолноеИмяФайлаTestOps(ПутьКФиче);
	КаталогПроектаУниверсальный = УниверсальноеПолноеИмяФайлаTestOps(ДопПараметрыАллюр2.КаталогПроекта);
	Если Прав(КаталогПроектаУниверсальный, 1) <> "/" Тогда
		КаталогПроектаУниверсальный = КаталогПроектаУниверсальный + "/";
	КонецЕсли;	
	
	Поз = Найти(ПутьКФичеУниверсальный, КаталогПроектаУниверсальный);
	Если Поз = 0 Тогда
		ЗамаскироватьПоляСценарияАллюр(СтруктураВыгрузки, СписокМаскируемыхПеременных);
		Возврат;
	КонецЕсли;	
	
	ОтносительныйКаталогФичи = СокрЛП(Сред(ПутьКФичеУниверсальный, СтрДлина(КаталогПроектаУниверсальный) + 1));

	// Объединение примеров структуры сценария в один тест-кейс (настройка включена)
	ОбъединятьПримеры = ДопПараметрыАллюр2.Свойство("ОбъединятьПримерыСтруктурыСценарияВAllure")
		И ДопПараметрыАллюр2.ОбъединятьПримерыСтруктурыСценарияВAllure = Истина;

	Если ОбъединятьПримеры И НРег(СтрокаСценария.Тип) = "пример" Тогда
		РазделенноеИмяСценария = РазделитьИмяСценарияСтруктуры(СтруктураВыгрузки.name);
		fullName = ОтносительныйКаталогФичи + "_" + РазделенноеИмяСценария.ИмяСценарияБезНомера;
		ИменованныеПараметры = СтрокаСценария.ПолучитьРодителя().ИменованныеПараметры;
		ЗначенияПараметров = РазложитьСтрокуВМассивПодстрок(СтрокаСценария.Имя, "|", Ложь);
		МассивСырыхЗначений = Новый Массив;
		НачалоПараметровПримера = СтруктураВыгрузки.parameters.Количество();
		Индекс = 1;
		Для Каждого ИмяПараметра Из ИменованныеПараметры Цикл
			Если Индекс >= ЗначенияПараметров.Количество() Тогда
				Прервать;
			КонецЕсли;
			ЗначениеПараметра = СокрЛП(ЗначенияПараметров[Индекс]);
			МассивСырыхЗначений.Добавить(ЗначениеПараметра);
			ПараметрПримера = Новый Структура;
			ПараметрПримера.Вставить("name", ИмяПараметра.Значение);
			ПараметрПримера.Вставить("value", ?(ПеременнаяМаскируемаяПоСписку(ИмяПараметра.Значение, СписокМаскируемыхПеременных), "*****", ЗначениеПараметра));
			СтруктураВыгрузки.parameters.Добавить(ПараметрПримера);
			Индекс = Индекс + 1;
		КонецЦикла;
		// historyId и testCaseId считаются по сырым значениям, чтобы не меняться при включении маскирования.
		СтрокаПараметровДляИстории = "";
		Если СтруктураВыгрузки.parameters.Количество() > 0 Тогда
			СтрокаПараметровДляИмени = "";
			Сч = 0;
			Для Каждого ПараметрАллюра Из СтруктураВыгрузки.parameters Цикл
				СтрокаПараметровДляИмени = СтрокаПараметровДляИмени + " | " + Строка(ПараметрАллюра.value);
				ИндексСырогоЗначения = Сч - НачалоПараметровПримера;
				Если ИндексСырогоЗначения >= 0 И ИндексСырогоЗначения < МассивСырыхЗначений.Количество() Тогда
					ЗначениеДляИстории = Строка(МассивСырыхЗначений[ИндексСырогоЗначения]);
				Иначе
					ЗначениеДляИстории = Строка(ПараметрАллюра.value);
				КонецЕсли;
				СтрокаПараметровДляИстории = СтрокаПараметровДляИстории + "_" + ЗначениеДляИстории;
				Сч = Сч + 1;
			КонецЦикла;
			СтруктураВыгрузки.name = СтруктураВыгрузки.name + СтрокаПараметровДляИмени;
		КонецЕсли;
		fullName = НРег(fullName);
		testCaseId = MD5Хеш(fullName);
		historyId = fullName + " " + РазделенноеИмяСценария.НомерПримера + СтрокаПараметровДляИстории + "_" + testCaseId;
		СтруктураВыгрузки.fullName = fullName;
		СтруктураВыгрузки.testCaseId = testCaseId;
		СтруктураВыгрузки.historyId = historyId;
		ЗамаскироватьПоляСценарияАллюр(СтруктураВыгрузки, СписокМаскируемыхПеременных);
		Возврат;
	КонецЕсли;

	// Формируем fullName: путь + имя сценария + параметры (если они есть)
	fullName = ОтносительныйКаталогФичи + "_" + СтруктураВыгрузки.name;

	// Добавляем параметры к fullName, если они есть
	Если СтруктураВыгрузки.Свойство("parameters") И СтруктураВыгрузки.parameters.Количество() > 0 Тогда
		МассивЗначенийПараметров = Новый Массив;
		Для Каждого Парам Из СтруктураВыгрузки.parameters Цикл
			МассивЗначенийПараметров.Добавить(Парам.value);
		КонецЦикла;
		
		СтрокаПараметров = "";
		Для Каждого Значение Из МассивЗначенийПараметров Цикл
			Если СтрокаПараметров <> "" Тогда
				СтрокаПараметров = СтрокаПараметров + "_";
			КонецЕсли;
			СтрокаПараметров = СтрокаПараметров + Строка(Значение);
		КонецЦикла;
		
		fullName = fullName + "_" + СтрокаПараметров; 
	КонецЕсли;

	ИмяДляОтображения = ЗамаскироватьПараметрыВСтроке(СтруктураВыгрузки.name, СтруктураВыгрузки.parameters, СписокМаскируемыхПеременных);
	ПолноеИмяДляОтображения = НРег(ЗамаскироватьПараметрыВСтроке(fullName, СтруктураВыгрузки.parameters, СписокМаскируемыхПеременных));
	
	fullName = НРег(fullName);

	testCaseId = MD5Хеш(fullName);
	historyId = fullName + "_" + testCaseId;
	
	ЗамаскироватьЗначенияПараметровДляОтчета(СтруктураВыгрузки.parameters, СписокМаскируемыхПеременных);
	
	СтруктураВыгрузки.name = ИмяДляОтображения;
	СтруктураВыгрузки.fullName = ПолноеИмяДляОтображения;
	СтруктураВыгрузки.testCaseId = testCaseId;
	СтруктураВыгрузки.historyId = historyId;    
	
КонецПроцедуры

&НаКлиенте
Функция РазделитьИмяСценарияСтруктуры(ИмяСценария)

	Результат = Новый Структура;
	Результат.Вставить("ИмяСценарияБезНомера", ИмяСценария);
	Результат.Вставить("НомерПримера", "");

	// Последнее вхождение «№»; для режима совместимости 8.2 — цикл по символам
	Поз = 0;
	Для Сч = 1 По СтрДлина(ИмяСценария) Цикл
		Если Сред(ИмяСценария, Сч, 1) = "№" Тогда
			Поз = Сч;
		КонецЕсли;
	КонецЦикла;

	Если Поз > 1 Тогда
		Результат.ИмяСценарияБезНомера = СокрЛП(Лев(ИмяСценария, Поз - 1));
		Результат.НомерПримера = Сред(ИмяСценария, Поз);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ОбъединитьТегиФичиИСценария(СтрокаФичи, МассивТеговШага)
	Результат = Новый Массив;
	ИмеющиесяКлючи = Новый Соответствие;

	Для Каждого Элем Из МассивТеговШага Цикл
		Результат.Добавить(Элем);
		ИмеющиесяКлючи.Вставить(НРег(Элем.ТегИсходный), Истина);
	КонецЦикла;

	Если ТипЗнч(СтрокаФичи.ПроизвольныеЗначения) = Тип("Структура") И СтрокаФичи.ПроизвольныеЗначения.Свойство("МассивТегов") Тогда
		Для Каждого Элем Из СтрокаФичи.ПроизвольныеЗначения.МассивТегов Цикл
			Ключ = НРег(Элем.ТегИсходный);
			Если ИмеющиесяКлючи.Получить(Ключ) = Неопределено Тогда
				Результат.Добавить(Элем);
				ИмеющиесяКлючи.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбойтиДеревоДляОтчетаАллюр2(Дерево, ДеревоТестов, ДанныеАллюрМеток, ДопПараметрыАллюр2)
	
	Для каждого СтрСтроки Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрСтроки.Тип = "Фича" Тогда
			
			ОбойтиДеревоДляОтчетаАллюр2(СтрСтроки, ДеревоТестов, ДанныеАллюрМеток, ДопПараметрыАллюр2); 
					
		ИначеЕсли (СтрСтроки.Тип = "Сценарий") ИЛИ (СтрСтроки.Тип = "Пример") Тогда
			ДопПараметрыАллюр2.Вставить("ГруппыШагов", Новый Соответствие);
			ДопПараметрыАллюр2.Вставить("ОбъектыГруппШагов", Новый Соответствие);
			ДопПараметрыАллюр2.Вставить("СсылкиНаГруппы", Новый Соответствие);
			Если (СтрСтроки.ДопТип = "Контекст") Тогда
				// его не ненадо добавлять в отчет, т.к. этот сценарий включается в каждый сценарий
				
			ИначеЕсли (СтрСтроки.ДопТип = "СтруктураСценария") ИЛИ ((СтрСтроки.ПолучитьЭлементы().Количество() = 0) И (СтрСтроки.Тип <> "Пример")) Тогда
				// его не ненадо добавлять в отчет, т.к. этот сценарий явно не выполняется
				ОбойтиДеревоДляОтчетаАллюр2(СтрСтроки, ДеревоТестов, ДанныеАллюрМеток, ДопПараметрыАллюр2); 
			Иначе
				// Пропускаем "нулевой" пример (заголовок таблицы Примеров)
				Если СтрСтроки.Тип = "Пример" Тогда
					Если СтрСтроки.ПолучитьРодителя().ПолучитьЭлементы().Индекс(СтрСтроки) = 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;	
				
				РезультатПрохожденияТестовСценария = ПолучитьРезультатПрохожденияТестовСценария(СтрСтроки);
				Если РезультатПрохожденияТестовСценария = Неопределено Тогда
					РезультатПрохожденияТестовСценария = ПустойРезультатПрохожденияТестовСценария(СтрСтроки);
				КонецЕсли;
								
				GUID = Новый УникальныйИдентификатор();
				СтруктураВыгрузки = ПолучитьОписаниеСценарияАллюр2();
				СтруктураВыгрузки.Вставить("uuid", Строка(GUID));

				// Добавляем параметры из СписокПараметров (если есть)
				Если РезультатПрохожденияТестовСценария.Свойство("СписокПараметров") Тогда
				    Для Каждого Парам Из РезультатПрохожденияТестовСценария.СписокПараметров Цикл
				        СтруктураВыгрузки.parameters.Добавить(Парам);
				    КонецЦикла;
				КонецЕсли;
				
				ПрефиксИмениСценария = ПолучитьПрефиксИмениСценария2(ДобавлятьКИмениСценарияУсловияВыгрузки);
				
				СтрокаФичи = СтрСтроки.ПолучитьРодителя();
				Если СтрСтроки.Тип = "Пример" Тогда
					СтруктураВыгрузки.name	= ПрефиксИмениСценария + СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().Имя + " №" + (СтрСтроки.ПолучитьРодителя().ПолучитьЭлементы().Индекс(СтрСтроки));
					СтрокаФичи		= СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПолучитьРодителя();
					
					Для Каждого ИменованныйПараметр Из СтрСтроки.ИменованныеПараметры Цикл
						Если НРег(ИменованныйПараметр.Значение.ИмяПараметра) = "description"
							ИЛИ НРег(ИменованныйПараметр.Значение.ИмяПараметра) = "описание"
							Тогда
							СтруктураВыгрузки.name = ИменованныйПараметр.Значение.Значение;
						КонецЕсли;	 
					КонецЦикла;	 
					
				Иначе	
					СтруктураВыгрузки.name     = ПрефиксИмениСценария + СтрСтроки.Имя;
				КонецЕсли;
				
				// Оставлено для совместимости со старым поведением, когда historyId всегда заполнялся каким-то значением
				СтруктураВыгрузки.historyId = СтрокаФичи.Имя + "." +  СтруктураВыгрузки.name;
				
				МассивТеговШага = ОпределитьМассивТеговШага(СтрСтроки);

				Если РезультатПрохожденияТестовСценария.Свойство("ВремяНачала") И РезультатПрохожденияТестовСценария.ВремяНачала <> Неопределено Тогда
					СтруктураВыгрузки.Вставить("start", (РезультатПрохожденияТестовСценария.ВремяНачала - РазницаВМилисекундахМеждуЮниксИНачалЭпохи));
				КонецЕсли;
				Если РезультатПрохожденияТестовСценария.Свойство("ВремяОкончания") И РезультатПрохожденияТестовСценария.ВремяОкончания <> Неопределено Тогда
					СтруктураВыгрузки.Вставить("stop", (РезультатПрохожденияТестовСценария.ВремяОкончания - РазницаВМилисекундахМеждуЮниксИНачалЭпохи));
				КонецЕсли;
				
				ЗаполнитьПараметрыДляAllureTestOps(СтруктураВыгрузки, СтрСтроки, ДопПараметрыАллюр2);
				
				МассивШаговBefore = Новый Массив();
				Если СтрСтроки.ДопТип = "СтруктураСценария" Тогда
					ОбойтиДеревоДляОтчетаАллюр2(СтрСтроки, ДеревоТестов, ДанныеАллюрМеток, ДопПараметрыАллюр2); 
				Иначе
					МассивШаговДляЗаполнения = СтруктураВыгрузки.steps;
					Если СтрСтроки.Тип = "Пример" Тогда
						Шаг = ПолучитьОписаниеШагаАллюр2();
						Шаг.name = ЗамаскироватьИмяПримераДляОтчета(СтрСтроки.Имя, СтрСтроки, ДопПараметрыАллюр2.МаскируемыеПеременные);
						
						Для Каждого ИменованныйПараметр Из СтрСтроки.ИменованныеПараметры Цикл
							Если НРег(ИменованныйПараметр.Значение.ИмяПараметра) = "description"
								ИЛИ НРег(ИменованныйПараметр.Значение.ИмяПараметра) = "описание"
								Тогда
								Шаг.name = ЗамаскироватьПарольВТекстеШага(ИменованныйПараметр.Значение.Значение);
							КонецЕсли;	 
						КонецЦикла;	 
						
						МассивТегов = Неопределено;
						Если ТипЗнч(СтрСтроки.ПроизвольныеЗначения) = Тип("Структура") Тогда
							СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов", МассивТегов);
						КонецЕсли;
						
						ЗаписатьСтатусВШагИлиСценарий2(Шаг, СтрСтроки.Статус, МассивТегов);
						МассивШаговДляЗаполнения = Шаг.steps;
						СтруктураВыгрузки.steps.Добавить(Шаг);
					КонецЕсли;
					
					Для каждого СтрРезультатПрохожденияТестовШагов Из РезультатПрохожденияТестовСценария.РезультатПрохожденияТестовШагов Цикл
						
						Если СтрРезультатПрохожденияТестовШагов.ЭтоШагКонтекста Тогда
							МассивШаговBefore.Добавить(СтрРезультатПрохожденияТестовШагов);
						Иначе							
							ЗаписатьВыполнениеШагаАллюр2(
								МассивШаговДляЗаполнения,
								ДеревоТестов,
								СтрРезультатПрохожденияТестовШагов,
								ПараметрыОтчетаУФ.МассивXMLОтчетаAllure,
								СтруктураВыгрузки,
								ДопПараметрыАллюр2);
							ВложенныеШаги = Неопределено;
							Если СтрРезультатПрохожденияТестовШагов.Свойство("ВложенныеШаги", ВложенныеШаги) 
								И ТипЗнч(ВложенныеШаги) = Тип("Массив") Тогда
								ТекущийШагРезультата = МассивШаговДляЗаполнения.Получить(МассивШаговДляЗаполнения.ВГраница());
								Для каждого СтрПрохожденияВложенныхШагов Из ВложенныеШаги Цикл
									ЗаписатьВыполнениеШагаАллюр2(
										ТекущийШагРезультата.steps,
										ДеревоТестов,
										СтрПрохожденияВложенныхШагов,
										ПараметрыОтчетаУФ.МассивXMLОтчетаAllure,
										СтруктураВыгрузки,
										ДопПараметрыАллюр2);
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
				МассивТегов = Неопределено;
				Если ТипЗнч(СтрСтроки.ПроизвольныеЗначения) = Тип("Структура")
					И СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов") Тогда
					СтрСтроки.ПроизвольныеЗначения.Свойство("МассивТегов", МассивТегов);
				КонецЕсли;

				Если МассивТеговШага = Неопределено ИЛИ (ТипЗнч(МассивТеговШага) = Тип("Массив") И МассивТеговШага.Количество() = 0) Тогда
					МассивТеговШага = ОпределитьМассивТеговШага(СтрСтроки);
				КонецЕсли;
				
				Если РезультатПрохожденияТестовСценария.Свойство("Статус") Тогда
					ТекСтатус = РезультатПрохожденияТестовСценария.Статус;
				Иначе	
					ТекСтатус = СтрСтроки.Статус;
				КонецЕсли;
				
				Если РезультатПрохожденияТестовСценария.Свойство("СчитатьСценарийУпавшим") И РезультатПрохожденияТестовСценария.СчитатьСценарийУпавшим Тогда
					ТекСтатус = "Failed";
				КонецЕсли;
				
				Если РезультатПрохожденияТестовСценария.Свойство("УстановленСтатусВручную") Тогда
					ТекСтатус = РезультатПрохожденияТестовСценария.УстановленСтатусВручную;
				КонецЕсли;	 
				
				ЗаписатьСтатусВШагИлиСценарий2(СтруктураВыгрузки, ТекСтатус, МассивТегов);
				
				ОписаниеОшибкиСценария = "";
				Если РезультатПрохожденияТестовСценария.Свойство("ОписаниеОшибки") Тогда
					ОписаниеОшибкиСценария = РезультатПрохожденияТестовСценария.ОписаниеОшибки;
				ИначеЕсли РезультатПрохожденияТестовСценария.Свойство("УстановленСтатусВручную")
					И (ТекСтатус = "Failed" ИЛИ ТекСтатус = "Pending") Тогда
					ОписаниеОшибкиСценария = "Scenario status = " + ТекСтатус;
				КонецЕсли;
				Если ЗначениеЗаполнено(ОписаниеОшибкиСценария) Тогда
					ОписаниеОшибки = "";
					ПодробноеОписаниеОшибки = "";
					ПодробноеОписаниеОшибкиAllure2(ОписаниеОшибкиСценария, ОписаниеОшибки, ПодробноеОписаниеОшибки);
					
					СтруктураОписанияОшибки = Новый Структура;
					СтруктураОписанияОшибки.Вставить("known", Ложь);
					СтруктураОписанияОшибки.Вставить("muted", Ложь);
					СтруктураОписанияОшибки.Вставить("flaky", Ложь);
					СтруктураОписанияОшибки.Вставить("message", ОписаниеОшибки);
					СтруктураОписанияОшибки.Вставить("trace", ПодробноеОписаниеОшибки);
					
					СтруктураВыгрузки.statusDetails = СтруктураОписанияОшибки;
				КонецЕсли; 
				
				ДобавитьСкриншотыКСценариюИлиШагуАллюр2(СтруктураВыгрузки, РезультатПрохожденияТестовСценария);
				Если РезультатПрохожденияТестовСценария.Свойство("СписокФайлов") Тогда
					ДобавитьФайлыКСценариюИлиШагуАллюр2(СтруктураВыгрузки, РезультатПрохожденияТестовСценария.СписокФайлов, ПараметрыОтчетаУФ.МассивXMLОтчетаAllure, ДопПараметрыАллюр2);
				КонецЕсли;

				СписокМетокПереопределяемый = Новый СписокЗначений;
				Если РезультатПрохожденияТестовСценария.Свойство("СписокМеток") Тогда
					СписокМетокПереопределяемый = РезультатПрохожденияТестовСценария["СписокМеток"];
				КонецЕсли;
				
				СписокСсылок = Новый СписокЗначений;
				Если РезультатПрохожденияТестовСценария.Свойство("СписокСсылок") Тогда
					СписокСсылок = РезультатПрохожденияТестовСценария["СписокСсылок"];
				КонецЕсли;
				
				Для каждого СсылкаUrl Из СписокСсылок Цикл
					ОписаниеСсылки = Новый Структура("name,url,type");
					ОписаниеСсылки.name = СсылкаUrl.Значение.name;
					ОписаниеСсылки.url = СсылкаUrl.Значение.url;
					ОписаниеСсылки.type = СсылкаUrl.Значение.type;
					
					СтруктураВыгрузки.links.Добавить(ОписаниеСсылки);
				КонецЦикла;
				
				МассивТегов = Новый Массив();
				Если СтрокаФичи.Тип = "Фича" Тогда
					ДополнительноеОписаниеФичи = СтрокаФичи.ПроизвольныеЗначения;
					Если ТипЗнч(ДополнительноеОписаниеФичи) = Тип("Структура") И ДополнительноеОписаниеФичи.Свойство("tags") Тогда
						МассивТегов = ДополнительноеОписаниеФичи["tags"];
					КонецЕсли;

				КонецЕсли;
				
				ФайлФичи = Новый Файл(СтрокаФичи.ПолныйПуть);
				ПутьФичи = Новый Файл(ФайлФичи.Путь);
				КаталогФичи = ПутьФичи.ИмяБезРасширения;
				
				СписокМеток =  СтруктураВыгрузки.labels;

				ДобавитьМетку2(СписокМеток, "host", ИмяКомпьютера(), СписокМетокПереопределяемый);
				ДобавитьМетку2(СписокМеток, "package", КаталогФичи, СписокМетокПереопределяемый);
				Если РезультатПрохожденияТестовСценария.Свойство("ЕстьДополнительныеФайлыСравненияЗначенияСЭталоном")
					И РезультатПрохожденияТестовСценария.ЕстьДополнительныеФайлыСравненияЗначенияСЭталоном Тогда
					ДобавитьМетку2(СписокМеток, "testType", "screenshotDiff", СписокМетокПереопределяемый);
				КонецЕсли;

				Для каждого Строка Из ДанныеАллюрМеток Цикл 
					Если ПустаяСтрока(Строка.РегулярноеВыражение) И Не Строка.Шаблон Тогда
						//если не указано регулярное выражение, то метка добавляется безусловно
						ДобавитьМетку2(СписокМеток, Строка.ИмяМетки, Строка.Значение, СписокМетокПереопределяемый);
					КонецЕсли;
				КонецЦикла;
				
				ДанныеШаблоновМеток = Новый Массив;
				Для Каждого Строка Из ДанныеАллюрМеток Цикл
					Если Строка.Шаблон Тогда
						ДанныеШаблоновМеток.Добавить(Строка);
					КонецЕсли;
				КонецЦикла;
				
				МассивТеговДляОбработки = ОбъединитьТегиФичиИСценария(СтрокаФичи, МассивТеговШага);
				
				Для Каждого ТегДляОбработки Из МассивТеговДляОбработки Цикл
					
					ТегИсходный = ТегДляОбработки.ТегИсходный;
					Тег         = ТегДляОбработки.Тег;
					
					ПозицияРазделителя = Найти(Тег, ":");
					
					Если ПозицияРазделителя > 0 Тогда
						ИмяТега = НРег(Лев(ТегИсходный, ПозицияРазделителя - 1));
						ЗначениеТега = СокрЛП(Сред(ТегИсходный, ПозицияРазделителя + 1));
						
						Для Каждого Шаблон Из ДанныеШаблоновМеток Цикл 
							Если Нрег(ИмяТега) =  НРег(Шаблон.ИмяМетки) Тогда
								ЗначениеТега = СтрЗаменить(Шаблон.Значение, "{}", ЗначениеТега);
							КонецЕсли;
						КонецЦикла;
					Иначе
						ИмяТега = "tag";
						ЗначениеТега = ТегИсходный;
					КонецЕсли;
					
					Если ИмяТега = "description" Или ИмяТега = "описание" Тогда
						СтруктураВыгрузки.description = ЗначениеТега;
						Продолжить;
					КонецЕсли;
					
					Если ИмяТега = "issue" Или ИмяТега = "задача" Тогда
						
						ОписаниеСсылки = Новый Структура;
						
						URL = ЗначениеТега;
						
						НачалоОписанияURL = Найти(url, "(");
						Если НачалоОписанияURL > 0 Тогда
							КонецОписанияURL = Найти(URL, ")");
							ОписаниеURL = Сред(URL,НачалоОписанияURL + 1 , КонецОписанияURL - НачалоОписанияURL -1);
							URL = СтрЗаменить(URL, "(" + ОписаниеURL + ")", "");
							URL = СтрЗаменить(URL, " ", "");
							URL = СтрЗаменить(URL, "#", "");
							
							ОписаниеСсылки.Вставить("name", ОписаниеURL);
						КонецЕсли;
						
						ОписаниеСсылки.Вставить("url", URL);
						ОписаниеСсылки.Вставить("type", "issue");
						
						СтруктураВыгрузки.links.Добавить(ОписаниеСсылки);
						Продолжить;
					КонецЕсли;
					
					Если ИмяТега = "link" Или ИмяТега = "ссылка" Тогда
						
						ОписаниеСсылки = Новый Структура;
						ОписаниеСсылки.Вставить("url", ЗначениеТега);
						ОписаниеСсылки.Вставить("type", "custom");
						
						СтруктураВыгрузки.links.Добавить(ОписаниеСсылки);
						Продолжить;
					КонецЕсли;
					
					ДобавитьМетку2(СписокМеток, ИмяТега, ЗначениеТега, СписокМетокПереопределяемый);
				
					Для Каждого Строка Из ДанныеАллюрМеток Цикл
						Если Не Строка.Шаблон Тогда
							Если ПустаяСтрока(Строка.РегулярноеВыражение) Тогда
								//если не указано регулярное выражение, то метка игнорируется
								Продолжить;
							КонецЕсли;
							
							Если СтрокаСоответствуетШаблону(ТегИсходный, Строка.РегулярноеВыражение) Тогда 
								ДобавитьМетку2(СписокМеток, Строка.ИмяМетки, Строка.Значение, СписокМетокПереопределяемый);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
				КонецЦикла;
				
				Если РезультатПрохожденияТестовСценария.Свойство("ОписаниеСценарияAllure") Тогда
					СтруктураВыгрузки.description = РезультатПрохожденияТестовСценария["ОписаниеСценарияAllure"];
				КонецЕсли;
				
				Если ЗначениеЗаполнено(УровеньОтчета1) 
						ИЛИ ЗначениеЗаполнено(УровеньОтчета2) 
						ИЛИ ЗначениеЗаполнено(УровеньОтчета3) 
						ИЛИ ЗначениеЗаполнено(ГруппировкаTestSuites)
						Тогда
						
					epic = "";
					feature = "";
					story = "";
					suite = "";
					ДанныеПоИерархииОтчетаИзОтносительногоПути2(epic, feature, story, suite, СтрСтроки.ПолучитьРодителя(), СтрСтроки, КаталогОтносительноКоторогоНадоСтроитьИерархию);
					
					Если ЗначениеЗаполнено(suite) Тогда
							
						ДобавитьМетку2(СписокМеток, "suite", suite, СписокМетокПереопределяемый);
							
					КонецЕсли;

					Если ЗначениеЗаполнено(epic)
							И ИспользоватьУровеньОтчета(УровеньОтчета1) Тогда
							
						ДобавитьМетку2(СписокМеток, "epic", epic, СписокМетокПереопределяемый);
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(feature)
							И ИспользоватьУровеньОтчета(УровеньОтчета2) Тогда
							
						ДобавитьМетку2(СписокМеток, "feature", feature, СписокМетокПереопределяемый);
						
					КонецЕсли;

					Если ЗначениеЗаполнено(story) 
							И ИспользоватьУровеньОтчета(УровеньОтчета3) Тогда
							
						ДанныеStoryСценария = ДанныеStoryПоИДСтроки(СтрСтроки.ПолучитьРодителя().ИдСтроки);
						ДанныеStoryСценария.story = story;
						
					КонецЕсли;
				Иначе
					epic = "";
					Если ТипЗнч(СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура")  Тогда
						// смотрим комментарии фичи
						МассивКомментариев = Новый Массив;
						Если СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивКомментариев") Тогда
							МассивКомментариев = СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения.МассивКомментариев;
						КонецЕсли;	 
						
						Если СтрСтроки.ПолучитьРодителя().Тип = "Примеры" Тогда
							Если ТипЗнч(СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура")
								И СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивКомментариев")
								Тогда
								МассивКомментариев = СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения.МассивКомментариев;
							КонецЕсли;	 
						КонецЕсли;	 
						
						Для Каждого КомментарийСтруктура Из МассивКомментариев Цикл
							Комментарий = СокрЛП(КомментарийСтруктура.Комментарий);
							НрегКомментарий = НРег(Комментарий);
							Если Лев(НрегКомментарий, 12) = "report.epic=" Тогда
								ПромСтр = Сред(Комментарий, 13);
								Если ЗначениеЗаполнено(ПромСтр) Тогда
									epic = ПромСтр;
									Прервать;
								КонецЕсли;	 
							КонецЕсли;	 
						КонецЦикла;	 
					КонецЕсли;	 
					Если ЗначениеЗаполнено(epic) Тогда
						ДобавитьМетку2(СписокМеток, "epic", epic, СписокМетокПереопределяемый);
						
					КонецЕсли;	 

					feature = СтрСтроки.Имя;
					Если ТипЗнч(СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура")  Тогда
						// смотрим комментарии фичи
						МассивКомментариев = Новый Массив;
						Если СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивКомментариев") Тогда
							МассивКомментариев = СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения.МассивКомментариев;
						КонецЕсли;	 
						
						Если СтрСтроки.ПолучитьРодителя().Тип = "Примеры" 
								И ТипЗнч(СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура")
								И СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивКомментариев") Тогда
							МассивКомментариев = СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения.МассивКомментариев;
						КонецЕсли;	 
						
						Для Каждого КомментарийСтруктура Из МассивКомментариев Цикл
							Комментарий = СокрЛП(КомментарийСтруктура.Комментарий);
							НрегКомментарий = НРег(Комментарий);
							Если Лев(НрегКомментарий, 15) = "report.feature=" Тогда
								ПромСтр = Сред(Комментарий, 16);
								Если ЗначениеЗаполнено(ПромСтр) Тогда
									feature = ПромСтр;
									Прервать;
								КонецЕсли;	 
							КонецЕсли;	 
						КонецЦикла;	 
					КонецЕсли;	 
					ДобавитьМетку2(СписокМеток, "feature", feature, СписокМетокПереопределяемый);
				КонецЕсли;	 

				story = "";
				Если ЗначениеЗаполнено(УровеньОтчета3) 
						И ИспользоватьУровеньОтчета(УровеньОтчета3) Тогда
						
					ДанныеStory = ДанныеStoryПоИДСтроки(СтрСтроки.ПолучитьРодителя().ИдСтроки);
					
					Если ЗначениеЗаполнено(ДанныеStory.story) Тогда
						story = ДанныеStory.story;
					КонецЕсли;
					
					Если ДанныеStory.ИмяСценария_для_story Тогда
						story = СтрСтроки.Имя;
						
						Если СтрСтроки.Тип = "Пример" Тогда
							story = СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().Имя;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(story) Тогда
					Если ЗначениеЗаполнено(ДанныеStoryПоИДСтроки(СтрСтроки.ПолучитьРодителя().ИдСтроки).story) Тогда
						story = ДанныеStoryПоИДСтроки(СтрСтроки.ПолучитьРодителя().ИдСтроки).story;
					Иначе
							Если ТипЗнч(СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура") Тогда
							// смотрим комментарии фичи
							МассивКомментариев = Новый Массив;
							Если СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивКомментариев") Тогда
								МассивКомментариев = СтрСтроки.ПолучитьРодителя().ПроизвольныеЗначения.МассивКомментариев;
							КонецЕсли;	 
							
							Если СтрСтроки.ПолучитьРодителя().Тип = "Примеры" Тогда
								Если ТипЗнч(СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения) = Тип("Структура")
									И СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения.Свойство("МассивКомментариев")
									Тогда
									МассивКомментариев = СтрСтроки.ПолучитьРодителя().ПолучитьРодителя().ПроизвольныеЗначения.МассивКомментариев;
								КонецЕсли;	 
							КонецЕсли;	 
							Для Каждого КомментарийСтруктура Из МассивКомментариев Цикл
								Комментарий = СокрЛП(КомментарийСтруктура.Комментарий);
								НрегКомментарий = НРег(Комментарий);
								Если Лев(НрегКомментарий, 13) = "report.story=" Тогда
									ПромСтр = Сред(Комментарий, 14);
									Если ЗначениеЗаполнено(ПромСтр) Тогда
										story = ПромСтр;
										Прервать;
									КонецЕсли;	 
								КонецЕсли;	 
							КонецЦикла;	 
						КонецЕсли;	 
					КонецЕсли;	 
				КонецЕсли;	 
				
				Если НЕ ЗначениеЗаполнено(story) Тогда
					story = СтрСтроки.Имя;
				КонецЕсли;	 
				
				Если ЗначениеЗаполнено(story) 
							И ИспользоватьУровеньОтчета(УровеньОтчета3) Тогда
							
					ДобавитьМетку2(СписокМеток, "story", story, СписокМетокПереопределяемый);
					
				КонецЕсли;	 

				Для каждого Тег Из МассивТегов Цикл
					ДобавитьМетку2(СписокМеток, "tag", Тег.Тег, СписокМетокПереопределяемый);
				КонецЦикла;
				
				Для каждого ЭлементМетки Из СписокМетокПереопределяемый Цикл
					ДобавитьМетку2(СписокМеток, ЭлементМетки.Значение, ЭлементМетки.Представление);
				КонецЦикла;

				СписокМетокПереопределяемый = Новый СписокЗначений;
				Если СтрСтроки.ПолучитьЭлементы().Количество() > 0 Тогда
					РезультатПрохожденияТестовСценария = ПолучитьРезультатПрохожденияТестовСценария(СтрСтроки.ПолучитьЭлементы().Получить(0));
					Если РезультатПрохожденияТестовСценария <> Неопределено И РезультатПрохожденияТестовСценария.Свойство("СписокМеток") Тогда
						СписокМетокПереопределяемый = РезультатПрохожденияТестовСценария["СписокМеток"];
					КонецЕсли;
				КонецЕсли;
				
				Для каждого ЭлементМетки Из СписокМетокПереопределяемый Цикл
					ДобавитьМетку2(СписокМеток, ЭлементМетки.Значение, ЭлементМетки.Представление);
				КонецЦикла;

				РассчитатьДлительностьВыполненияГруппШагов(СтруктураВыгрузки);
				РеальноеИмяФайла = "" + GUID + "-result.json";
				ЗаписатьОбъектВJson(СтруктураВыгрузки, РеальноеИмяФайла, ПараметрыОтчетаУФ.МассивXMLОтчетаAllure);
				
				Если МассивШаговBefore.Количество() > 0 Тогда
					СтруктураШаговКонтекста = ПолучитьОписаниеКонтекстныхШаговАллюр2();
					СтруктураШаговКонтекста.uuid = Строка(Новый УникальныйИдентификатор);
					СтруктураШаговКонтекста.name = "Контекст_" + СтруктураВыгрузки.name;
					СтруктураШаговКонтекста.description = "";
					СтруктураШаговКонтекста.children.Добавить(Строка(GUID));
					СтруктураШаговКонтекста.Вставить("befores", Новый Массив());

					Для Сч = 0 По МассивШаговBefore.ВГраница() Цикл
						
						ЭлементМассива = МассивШаговBefore.Получить(Сч);
						
						ЗаписатьВыполнениеШагаАллюр2(
						СтруктураШаговКонтекста.befores,
						ДеревоТестов,
						ЭлементМассива,
						ПараметрыОтчетаУФ.МассивXMLОтчетаAllure,
						СтруктураВыгрузки,
						ДопПараметрыАллюр2
						);
						
					КонецЦикла;
					РеальноеИмяФайла = "" + GUID + "-container.json";
					РассчитатьДлительностьВыполненияГруппШагов(СтруктураШаговКонтекста);
					ЗаписатьОбъектВJson(СтруктураШаговКонтекста, РеальноеИмяФайла, ПараметрыОтчетаУФ.МассивXMLОтчетаAllure);
				КонецЕсли;
				
			КонецЕсли;
		ИначеЕсли СтрСтроки.Тип = "Шаг" Тогда
			Если СтрСтроки.ПолучитьРодителя().ДопТип = "СтруктураСценария" Тогда
				// его не ненадо добавлять в отчет, т.к. этот сценарий явно не выполняется
				ОбойтиДеревоДляОтчетаАллюр2(СтрСтроки, ДеревоТестов, ДанныеАллюрМеток, ДопПараметрыАллюр2); 
			КонецЕсли; 
		Иначе	
			ОбойтиДеревоДляОтчетаАллюр2(СтрСтроки, ДеревоТестов, ДанныеАллюрМеток, ДопПараметрыАллюр2); 
		КонецЕсли; 
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДереваПоИдСтрокиРекурсивно(Дерево, Результат)
	Для Каждого ТекСтрока Из Дерево.ПолучитьЭлементы() Цикл
		Результат.Вставить(ТекСтрока.ИдСтроки, ТекСтрока);
		СтрокаДереваПоИдСтрокиРекурсивно(ТекСтрока, Результат)
	КонецЦикла;	 
КонецПроцедуры 

&НаКлиенте
Функция СтрокаДереваПоИдСтроки(Дерево)
	Результат = Новый Соответствие;
	СтрокаДереваПоИдСтрокиРекурсивно(Дерево, Результат);
	Возврат Результат; 
КонецФункции	 

&НаКлиенте
Процедура СформироватьОтчетАллюр2(СтруктураОФ, ДеревоТестовПарам, ИмяСборки) Экспорт

	Если СтруктураОФ = Неопределено Тогда
		ВызватьИсключение "Не поддерживаем ОФ";
	КонецЕсли;

	ДанныеАллюрМеток = Новый Массив;
	Если СтруктураОФ.Свойство("ДанныеАллюрМеток") Тогда
		ДанныеАллюрМеток = СтруктураОФ.ДанныеАллюрМеток;
	КонецЕсли;
	
	ИмяТекущейСборки = ИмяСборки;
	ОтчетВРежимеУФ = Истина;
	ПараметрыОтчетаУФ    = СтруктураОФ;
		
	МассивXMLОтчетаAllure = Новый Массив;
	СтруктураОФ.Вставить("МассивXMLОтчетаAllure", МассивXMLОтчетаAllure);
	
	ДопПараметрыАллюр2 = Новый Структура;
	ДопПараметрыАллюр2.Вставить("СтрокаДереваПоИдСтроки", СтрокаДереваПоИдСтроки(ДеревоТестовПарам));
	ДопПараметрыАллюр2.Вставить("ПодставлятьВОтчетеAllureЗначенияПеременных", СтруктураОФ.ПодставлятьВОтчетеAllureЗначенияПеременных);
	ДопПараметрыАллюр2.Вставить("СписокИсключаемыхПеременныхAllure", СтруктураОФ.СписокИсключаемыхПеременныхAllure);
	Если СтруктураОФ.Свойство("МаскируемыеПеременные") Тогда
		ДопПараметрыАллюр2.Вставить("МаскируемыеПеременные", СтруктураОФ.МаскируемыеПеременные);
	Иначе
		ДопПараметрыАллюр2.Вставить("МаскируемыеПеременные", Новый Массив);
	КонецЕсли;
	Если СтруктураОФ.Свойство("КаталогПроекта") Тогда
		ДопПараметрыАллюр2.Вставить("КаталогПроекта", СтруктураОФ.КаталогПроекта);
	КонецЕсли;	
	Если СтруктураОФ.Свойство("ОбъединятьПримерыСтруктурыСценарияВAllure") Тогда
		ДопПараметрыАллюр2.Вставить("ОбъединятьПримерыСтруктурыСценарияВAllure", СтруктураОФ.ОбъединятьПримерыСтруктурыСценарияВAllure);
	КонецЕсли;
	ОбойтиДеревоДляОтчетаАллюр2(ДеревоТестовПарам, ДеревоТестовПарам, ДанныеАллюрМеток, ДопПараметрыАллюр2);
	ДопПараметрыАллюр2.СтрокаДереваПоИдСтроки.Очистить();
КонецПроцедуры

&НаКлиенте
Функция ИспользоватьУровеньОтчета(ЗначениеГруппировки)
	
	Результат = Не (НРег(ЗначениеГруппировки) = "неиспользовать"
						ИЛИ НРег(ЗначениеГруппировки) = "donotuse");
						
	Возврат Результат;
	
КонецФункции

