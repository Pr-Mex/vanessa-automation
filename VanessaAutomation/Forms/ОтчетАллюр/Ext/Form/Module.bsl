&НаСервереБезКонтекста
Функция MD5ХешСервер(Знач Строка)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Строка);
	Возврат НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""));
КонецФункции

&НаКлиенте
Функция MD5Хеш(Знач Строка)
	Результат = КешMD5.Получить(Строка);
	Если Результат = Неопределено Тогда
		Результат = MD5ХешСервер(Строка);
		КешMD5.Вставить(Строка, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ДанныеStoryПоИДСтроки(ИДСтроки)
	Результат = StoryПоИДСтроки.Получить(ИДСтроки);
	Если Результат = Неопределено Тогда
		Результат = Новый Структура("story,ИмяСценария_для_story", "", Ложь);
		StoryПоИДСтроки.Вставить(ИДСтроки, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

