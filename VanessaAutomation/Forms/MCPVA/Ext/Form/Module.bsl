// Внутренняя функция для создания нового элемента
&НаКлиенте
Функция СоздатьНовый(ИмяЭлемента, ИмяТаблицы)
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
			Поле = Таблица.НайтиОбъект(,,ИмяЭлемента);
			Если Поле = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено в таблице '%2'."), ИмяЭлемента, ИмяТаблицы);
				Ванесса.ДополнитьОшибку_НетПоляТаблицыMCP(Таблица, ТекстОшибки);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			Поле.Активизировать();
			Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
				Таблица.ИзменитьСтроку();
			КонецЕсли;
			
			Ванесса.ЯНажимаюНаКнопкуСоздатьПоля(ИмяЭлемента, Истина);
		Иначе
			Ванесса.ЯНажимаюНаКнопкуСоздатьПоля(ИмяЭлемента, Истина);
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("У поля '%1' вызвана команда создания нового элемента."), ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка создания нового элемента:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
