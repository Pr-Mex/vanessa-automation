					Ванесса.Локализовать("Элемент '%1' не является табличным документом."), ИмяЭлемента));
		КонецЕсли;
		Поле.УстановитьТекущуюОбласть(Адрес);
		Поле.НачатьРедактированиеТекущейОбласти();
		ПолеОбласти = Поле.ПолучитьПолеТекущейОбласти();
		Если ПолеОбласти = Неопределено Тогда
			Попытка
				Поле.ЗакончитьРедактированиеТекущейОбласти();
			Исключение
			КонецПопытки;
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Не удалось начать редактирование области %1 табличного документа %2."),
					Адрес, ИмяЭлемента));
		КонецЕсли;
		Ванесса.ВвестиВПолеТекст(ПолеОбласти, Текст);
		Поле.ЗакончитьРедактированиеТекущейОбласти();
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В область %1 табличного документа '%2' введён текст. Текущий адрес: %3"),
			Адрес, ИмяЭлемента, Поле.ПолучитьАдресТекущейОбласти());
	Исключение
		Попытка
			Поле.ЗакончитьРедактированиеТекущейОбласти();
		Исключение
		КонецПопытки;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

