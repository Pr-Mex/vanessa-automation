&НаКлиенте
Процедура ДополнитьОшибку_НетГруппыШапкиMCP(ТекстОшибки) Экспорт
	
	Если НЕ Ванесса.ВыполняетсяВызовMCP() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка = Ванесса.Локализовать("## Группы формы. Имя группы и заголовок группы:");
	Если Найти(ТекстОшибки, СтрокаЗаголовка) > 0 Тогда
		// Значит уже происходило дополнение текста ошибки.
		Возврат;
	КонецЕсли;
	
	ТекОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Если ТекОкно = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Попытка
		ТипПоля = Тип("ТестируемаяГруппаФормы");
		ПоляОкна = ТекОкно.НайтиОбъекты(ТипПоля); //Будут найдены как поля шапки формы так и поля таблиц формы
		
		КешПоляТаблиц = Новый Соответствие;
		ТаблицыОкна = ТекОкно.НайтиОбъекты(Тип("ТестируемаяТаблицаФормы"));
		Для Каждого ТекТаблица Из ТаблицыОкна Цикл
			ПоляТаблицы = ТекТаблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));
			Для Каждого ТекПолеТаблицы Из ПоляТаблицы Цикл
				КешПоляТаблиц.Вставить(ТекПолеТаблицы.Имя, Истина);
			КонецЦикла;
		КонецЦикла;	
		
		ИмяИскомое = MCPИмяЭлементаИзТекстаОшибки(ТекстОшибки);
		ПределГрупп = 30;
		
		ГруппыФормы = Новый Массив;
		Для Каждого ТекПоле Из ПоляОкна Цикл
			Если КешПоляТаблиц[ТекПоле.Имя] <> Неопределено Тогда
				Продолжить; // Не выводим группы внутри таблиц
			КонецЕсли;
			ГруппыФормы.Добавить(ТекПоле);
		КонецЦикла;
		
		// Сначала группы, похожие на искомую (по имени или заголовку), затем остальные.
		Похожие = Новый Массив;
		Остальные = Новый Массив;
		Для Каждого ТекПоле Из ГруппыФормы Цикл
			Если ИмяИскомое <> "" И Найти(НРег(ТекПоле.Имя + " " + ТекПоле.ТекстЗаголовка), НРег(ИмяИскомое)) > 0 Тогда
				Похожие.Добавить(ТекПоле);
			Иначе
				Остальные.Добавить(ТекПоле);
			КонецЕсли;
		КонецЦикла;
		
		Строки = Новый Массив;
		
		Если Похожие.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("## Группы формы, похожие на <%1>. Имя группы и заголовок группы:"), ИмяИскомое));
			Для Каждого ТекПоле Из Похожие Цикл
				Строки.Добавить("- " + ТекПоле.Имя + " (" + ТекПоле.ТекстЗаголовка + ")");
			КонецЦикла;
		КонецЕсли;
		
		Показано = 0;
		Если Остальные.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить(СтрокаЗаголовка);
			Для Каждого ТекПоле Из Остальные Цикл
				Если Показано >= ПределГрупп Тогда
					Прервать;
				КонецЕсли;
				Строки.Добавить("- " + ТекПоле.Имя + " (" + ТекПоле.ТекстЗаголовка + ")");
				Показано = Показано + 1;
			КонецЦикла;
			
			ВсегоГрупп = ГруппыФормы.Количество();
			Если ВсегоГрупп > Похожие.Количество() + Показано Тогда
				Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("...показано %1 из %2 групп формы. Полный список: get_form_analysis (format=elements, only_group) или format=elements."),
					Похожие.Количество() + Показано, ВсегоГрупп));
			КонецЕсли;
		КонецЕсли;
		
		Строки.Добавить("");
		
		ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса._СтрСоединить(Строки);
	Исключение
		Ванесса.ЗаписатьЛогВЖРОшибка("ДополнитьОшибку_НетГруппыШапкиMCP", ОписаниеОшибки());
	КонецПопытки;
	

КонецПроцедуры

