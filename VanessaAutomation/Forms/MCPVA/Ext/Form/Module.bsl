// Загружает или перезагружает .feature файлы
&НаКлиенте
Функция ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл(Запрос, ДополнительныеПараметры) Экспорт
	
	ПутьКФайлу = Строка(ЗначениеПараметраИзЗапроса(Запрос, "path"));
	
	ДопПараметрыВызоваMCP = Новый Структура;
	ДопПараметрыВызоваMCP.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ТекстОшибки = Неопределено;
		ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;	
	КонецЕсли;	
	
	ОткрытиеФичаФайлаВРедакторе(ПутьКФайлу, Запрос, "ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл", ДопПараметрыВызоваMCP);
	
КонецФункции

// Получает состояние редактора
&НаКлиенте
Функция ПолучитьСостояниеРедактора(Запрос, ДополнительныеПараметры) Экспорт
	
	ВключитьСодержимое = Истина;
	ЗначениеИзЗапроса = ЗначениеПараметраИзЗапроса(Запрос, "includeContent");
	Если ЗначениеИзЗапроса <> Неопределено Тогда
		ВключитьСодержимое = ЗначениеИзЗапроса = Истина;
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Состояние редактора"));
	Строки.Добавить("");
	
	// Вкладки
	Строки.Добавить(Ванесса.Локализовать("## Открытые вкладки"));
	Если Ванесса.VanessaTabs <> Неопределено Тогда
		Попытка
			КоличествоВкладок = Ванесса.VanessaTabs.count();
			Строки.Добавить(Ванесса.Локализовать("Количество:") + " " + Формат(КоличествоВкладок, "ЧГ=0; ЧН=0"));
			Строки.Добавить("");
			
			Для Инд = 0 По КоличествоВкладок - 1 Цикл
				Вкладка = Ванесса.VanessaTabs.tabStack[Инд];
				ИмяФайла = Вкладка.filename;
				Изменена = Вкладка.modified;
				Текущая = (Ванесса.VanessaTabs.current <> Неопределено И НРег(Ванесса.VanessaTabs.current.filename) = НРег(ИмяФайла));
				
				Префикс = "";
				Если Текущая Тогда
					Префикс = "**→** ";
				КонецЕсли;
				
				Суффикс = "";
				Если Изменена = Истина Тогда
					Суффикс = " " + Ванесса.Локализовать("*(изменена)*");
				КонецЕсли;
				
				Строки.Добавить("- " + Префикс + ИмяФайла + Суффикс);
			КонецЦикла;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("ошибка чтения вкладок:") + " " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Редактор не инициализирован. Загрузите фичи: `load_features`."));
	КонецЕсли;
	Строки.Добавить("");
	
	// Текущий файл и позиция
	Строки.Добавить(Ванесса.Локализовать("## Активный документ"));
	Если Не Ванесса.ОтсутствуетVanessaEditor() Тогда
		Попытка
			Редактор = Ванесса.ПолучитьVanessaEditor();
			
			// Позиция курсора
			Попытка
				Позиция = Редактор.getPosition();
				Если Позиция <> Неопределено Тогда
					Строки.Добавить(Ванесса.Локализовать("- Строка:") + " " + Формат(Позиция.lineNumber, "ЧГ=0; ЧН=0"));
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			// Выбранный сценарий
			СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(Позиция.lineNumber);
			ЕстьВыбранныйСценарий = Ложь;
			Если СтрокаДерева <> Неопределено Тогда
				ЭтоПример = Ложь;
				ЭтоШагКонтекста = Ложь;
				СтрокаСценария = Ванесса.НайтиСтрокуСценарияЧерезРодителя(СтрокаДерева, ЭтоПример, ЭтоШагКонтекста);
				Если СтрокаСценария <> Неопределено Тогда
					ЕстьВыбранныйСценарий = Истина;
					Строки.Добавить("");
					Строки.Добавить(Ванесса.Локализовать("### Выбранный сценарий:") + " " + СтрокаСценария.Имя);
				КонецЕсли;	
			КонецЕсли;	
			
			Если НЕ ЕстьВыбранныйСценарий Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("### Выбранный сценарий:") + " " + Ванесса.Локализовать("Нет выбранного сценария. Можно запустить все сценарии на выполнение с помощью"));
			КонецЕсли;
			
			// Все сценарии текущей вкладки
			ВсеСценарии = Ванесса.ПолучитьИменаСценариевПоТекущейФиче();
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("### Всего сценариев в файле:") + " " + ВсеСценарии.Количество());
			Строки.Добавить(Ванесса.Локализовать("### Все сценарии из файла:"));
			Для Каждого ТекСценарий Из ВсеСценарии Цикл
				Строки.Добавить("- " + ТекСценарий.Имя);
			КонецЦикла;	
			
			// Содержимое
			Если ВключитьСодержимое Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("### Содержимое"));
				Строки.Добавить("```gherkin");
				Попытка
					Содержимое = Редактор.getContent();
					Если ЗначениеЗаполнено(Содержимое) Тогда
						Строки.Добавить(Содержимое);
					Иначе
						Строки.Добавить(Ванесса.Локализовать("(пустой документ)"));
					КонецЕсли;
				Исключение
					Строки.Добавить(Ванесса.Локализовать("(ошибка чтения:") + " " + ОписаниеОшибки() + ")");
				КонецПопытки;
				Строки.Добавить("```");
			КонецЕсли;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("ошибка доступа к редактору:") + " " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Редактор не открыт"));
	КонецЕсли;
	Строки.Добавить("");
	
	// Ошибки
	Строки.Добавить(Ванесса.Локализовать("## Ошибки в редакторе"));
	Попытка
		Если Ванесса.ДанныеОшибокVanessaEditor <> Неопределено И ТипЗнч(Ванесса.ДанныеОшибокVanessaEditor) = Тип("Соответствие") Тогда
			КоличествоОшибок = 0;
			Для Каждого КлючЗначение Из Ванесса.ДанныеОшибокVanessaEditor Цикл
				КоличествоОшибок = КоличествоОшибок + 1;
			КонецЦикла;
			Строки.Добавить(Ванесса.Локализовать("Количество:") + " " + Формат(КоличествоОшибок, "ЧГ=0; ЧН=0"));
			Если КоличествоОшибок > 0 Тогда
				Для Каждого КлючЗначение Из Ванесса.ДанныеОшибокVanessaEditor Цикл
					Строки.Добавить(Ванесса.Локализовать("- Строка") + " " + Формат(КлючЗначение.Значение.НомерСтрокиВФиче, "ЧГ=0; ЧН=0") + ". Текст ошибки: " + КлючЗначение.Значение.КраткийТекстОшибки);
					Строки.Добавить("  " + Ванесса.Локализовать("Имя feature файла где возникла эта ошибка:") + " " + КлючЗначение.Значение.ИмяФичи);
				КонецЦикла;
			КонецЕсли;
		Иначе
			Строки.Добавить(Ванесса.Локализовать("нет ошибок"));
		КонецЕсли;
	Исключение
		Строки.Добавить(Ванесса.Локализовать("ошибка чтения:") + " " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Выбирает и делает сценарий текущим. После этого можно вызывать выполнение текущего сценария
&НаКлиенте
Функция ВыбратьСценарий(Запрос, ДополнительныеПараметры) Экспорт
	
	ИмяСценария = ЗначениеПараметраИзЗапроса(Запрос, "name");
	Если НЕ ЗначениеЗаполнено(ИмяСценария) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не указан обязательный параметр 'name'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;	
	
	СценарииФичи = Ванесса.ПолучитьИменаСценариевПоТекущейФиче();
	
	Для Каждого ТекСценарий Из СценарииФичи Цикл
		Если НРег(ТекСценарий.Имя) = НРег(ИмяСценария) Тогда
			
			Ванесса.СделатьСтрокуДереваТекущейПоНомеруСтрокиФичи(ТекСценарий.НомерСтрокиВФиче);
			СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(ТекСценарий.НомерСтрокиВФиче);
			Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(СтрокаДерева.ИдСтроки, ТекСценарий.НомерСтрокиВФиче);
			
			Идентификатор = Запрос.Идентификатор;
			Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
			ПодключитьОбработчикОжидания("ЗавершитьВыборСценария", 0.1, Истина);
			Возврат Неопределено;
		КонецЕсли;	
	КонецЦикла;
	
	ТекстСообщения = Ванесса.Локализовать("Не найден сценарий:") + " " + ИмяСценария;
	Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	
КонецФункции

// Выбирает и делает шаг текущим. После этого можно вызывать выполнение с текущего шага
&НаКлиенте
Функция ВыбратьШаг(Запрос, ДополнительныеПараметры) Экспорт
	
	НомерСтроки = ЗначениеПараметраИзЗапроса(Запрос, "lineNumber");
	Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не указан обязательный параметр 'lineNumber'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;	
	
	ТекстОшибки = Неопределено;
	СделатьШагФичиТекущим(НомерСтроки, Запрос.Идентификатор, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;	
	ПодключитьОбработчикОжидания("ЗавершитьВыборШага", 0.1, Истина);
	
КонецФункции

// Вызывается при успешном завершении загрузки фичи/фич
&НаКлиенте
Процедура ОповеститьMCP_ОЗавершенииЗагрузкиФичи(ПутьКФайлу, Тип, ДопПараметрыВызоваMCP) Экспорт
	
	Если Тип = "СинтаксКонтроль" Тогда
		ЗавершитьПроверкуСинтаксиса(ПутьКФайлу);
	ИначеЕсли Тип = "ОткрытьФичаФайл" Тогда
		ЗавершитьОткрытиеФичаФайла(ПутьКФайлу);
	ИначеЕсли Тип = "ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл" Тогда
		ЗавершитьОткрытьЗагрузитьИлиПерезагрузитьФичаФайл(ПутьКФайлу, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "ВыполнитьОдинШагВФичаФайле" Тогда
		ПродолжитьВыполнениеШагаВРедакторе(ПутьКФайлу, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "ВыполнитьСценарий" Тогда
		ПродолжитьВыполнитьСценарий1(ПутьКФайлу, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "ЗагрузитьФичуДляВыполненияСценария" Тогда
		// Проверяем, есть ли режим после загрузки (для reloadAndRunFromLine)
		Если ДопПараметрыВызоваMCP <> Неопределено И ДопПараметрыВызоваMCP.Свойство("РежимПослеЗагрузки") Тогда
			Если ДопПараметрыВызоваMCP.РежимПослеЗагрузки = "reloadAndRunFromLine" Тогда
				// Устанавливаем текущий шаг по номеру строки
				НомерСтроки = ДопПараметрыВызоваMCP.НомерСтроки;
				
				Текст = Новый ЧтениеТекста;
				Текст.Открыть(ДопПараметрыВызоваMCP.ИсходныйПутьКФайлу, "UTF-8");
				ТекстФайла = Текст.Прочитать();
				Текст.Закрыть();
				
				МассивСтрокФайла = Ванесса._СтрРазделить(ТекстФайла, Символы.ПС);
				
				НашлиШаг = Ложь;
				Пока Истина Цикл
					СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
					Если СтрокаДерева <> Неопределено И СтрокаДерева.Тип = "Шаг" Тогда
						ЭтоПример = Ложь;
						ЭтоШагКонтекста = Ложь;
						СтрокаСценария  = Ванесса.НайтиСтрокуСценарияЧерезРодителя(СтрокаДерева, ЭтоПример, ЭтоШагКонтекста);
						
						Если ЭтоШагКонтекста Тогда
							ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В файле <%1> первым шагом, который можно выполнить, начиная со строки <%2> и ниже, оказался шаг контекста в строке <%3>. Но нельзя запускаться выполнение сценария с определенного шага и при этом передавать номер строки, где располагается секция Контекст, т.к. секция Контекст не является самостоятельным сценарием."), ДопПараметрыВызоваMCP.ИсходныйПутьКФайлу, ДопПараметрыВызоваMCP.НомерСтроки, НомерСтроки);
							МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
							Возврат;
						КонецЕсли;	
						
						НашлиШаг = Истина;
						Прервать;
					КонецЕсли;
					
					НомерСтроки = НомерСтроки + 1;
					Если НомерСтроки > МассивСтрокФайла.Количество() Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если НЕ НашлиШаг Тогда
					ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В файле <%1> нет шагов для выполнения, начиная со строки <%2> и ниже."), ДопПараметрыВызоваMCP.ИсходныйПутьКФайлу, ДопПараметрыВызоваMCP.НомерСтроки);
					МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
					Возврат;
				КонецЕсли;	
				
				ТекстОшибки = Неопределено;
				СделатьШагФичиТекущим(НомерСтроки, Ванесса.ИдентификаторЗадачиMCP(), ТекстОшибки);
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
					Возврат;
				КонецЕсли;	
				ПодключитьОбработчикОжидания("ЗавершитьВыборШагаДляВыполненияСценарияСТекущегоШага", 0.1, Истина);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ПродолжитьВыполнитьСценарий2(ПутьКФайлу, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "ЗагрузитьФичаФайлИВыполнитьСценарии" Тогда
		Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
		Если Проблемы.Количество() > 0 Тогда
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
			Возврат;
		КонецЕсли;
		Ванесса.КомандаВыполнитьСценарии();
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP после загрузки фичи <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецПроцедуры

// Вызывается при успешном завершении выполнения одной строки фичи
&НаКлиенте
Функция ОповеститьMCP_ОУспешномЗавершенииВыполненияОднойСтрокиФичи(Тип, ДопПараметрыВызоваMCP) Экспорт
	
	Если Тип = "ВыполнитьОдинШагВФичаФайле" Тогда
		ЗавершитьУспешноеВыполнениеШагаВРедакторе(ДопПараметрыВызоваMCP);
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP после выполнения одной строки фичи <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецФункции

// Вызывается при окончании выполнения сценариев
&НаКлиенте
Функция ОповеститьMCP_ОЗавершенииВыполненияСценариев(Тип, ДопПараметрыВызоваMCP) Экспорт
	
	Если Тип = "selected" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "all" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "reloadAndRun" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "reloadAndRunFromLine" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "fromCurrentStep" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP при завершении выполнения сценариев <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецФункции

// Вызывается при ошибке при выполнении одной строки фичи
&НаКлиенте
Функция ОповеститьMCP_ОбОшибкеПриВыполненияОднойСтрокиФичи(Тип, ДопПараметрыВызоваMCP, РезультатПрохожденияШага) Экспорт
	
	Если Тип = "ВыполнитьОдинШагВФичаФайле" Тогда
		ЗавершитьВыполнениеШагаВРедактореСОшибкой(ДопПараметрыВызоваMCP, РезультатПрохожденияШага);
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецФункции

// Вызывается при ошибке выполнения выделенного сценария
&НаКлиенте
Функция ОповеститьMCP_ОбОшибкеВыполненияВыделенногоСценария(ДопПараметрыВызоваMCP, ТекстОшибки) Экспорт
	
	МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), ТекстОшибки);
	Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
	
КонецФункции

// Вызывается при завершении выполнения шага строкой в MCPИнструментВыполнитьОдинШагТекстом
&НаКлиенте
Процедура ЗавершениеВыполнениеШагаИзСтроки() Экспорт
	МодульМсп_Сервер = МодульМсп_Сервер();
	ТекстСообщения = Ванесса.Локализовать("Шаг выполнен успешно");
	МодульМсп_Сервер.ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), ТекстСообщения);
	Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
КонецПроцедуры

// Возвращает общий модуль из расширения MCP
// Если установлен внешний фасад (альтернативный MCP транспорт, плагин MCPRagSearch) - возвращает его.
&НаКлиенте
Функция МодульМсп_Сервер() Экспорт
	Если ВнешнийФасадМсп <> Неопределено Тогда
		Возврат ВнешнийФасадМсп;
	КонецЕсли;
	Возврат Вычислить("Мсп_Сервер");
КонецФункции

// Устанавливает внешний фасад Мсп_Сервер (Неопределено - вернуться к штатному модулю расширения).
&НаКлиенте
Процедура УстановитьВнешнийФасадМсп(Фасад) Экспорт
	ВнешнийФасадМсп = Фасад;
КонецПроцедуры

// Сохраняет табличный документ в файл
&НаКлиенте
Функция СохранитьТабличныйДокументВФайл(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр file_name (обязательный)
	ИмяФайла = Строка(ЗначениеПараметраИзЗапроса(Запрос, "file_name"));
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр file_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр form_element_name (обязательный)
	ИмяЭлементаФормы = Строка(ЗначениеПараметраИзЗапроса(Запрос, "form_element_name"));
	Если НЕ ЗначениеЗаполнено(ИмяЭлементаФормы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр form_element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр format (по умолчанию 'mxl')
	Формат = Строка(ЗначениеПараметраИзЗапроса(Запрос, "format"));
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		Формат = "mxl";
	Иначе
		Формат = НРег(СокрЛП(Формат));
	КонецЕсли;
	
	// Проверка допустимого значения формата
	Если Формат <> "mxl" И Формат <> "xlsx" И Формат <> "pdf" Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение format. Допустимые значения: 'mxl', 'xlsx', 'pdf'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Получаем табличный документ из активной формы
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	Попытка
		ТабличныйДокумент = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлементаФормы, Истина,,,ДопПараметры);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	// Сохраняем табличный документ в файл
	Попытка
		// ИндексФильтра начинается с нуля
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("РасширениеФайла", Формат);
		ДопПараметры.Вставить("ИмяФайлаДляСохранения", ИмяФайла);
		Если Формат = "pdf" Тогда
			ДопПараметры.Вставить("ИндексФильтра", 2);
		ИначеЕсли Формат = "xlsx" Тогда
			ДопПараметры.Вставить("ИндексФильтра", 7);
		КонецЕсли;	
		ТабДок = Ванесса.ПолучитьТабличныйДокументTestClient(ТабличныйДокумент, ДопПараметры);
		
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"# Табличный документ %1 сохранен
			|
			|- Файл: %2
			|- Формат: %3"),ИмяЭлементаФормы, ИмяФайла,Формат);
		Возврат ТекстОтвета;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка сохранения табличного документа:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Возвращает данные указанного элемента формы
&НаКлиенте
Функция ПолучитьДанныеЭлементаФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр element_name (обязательный)
	ИмяЭлемента = Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_name"));
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Получаем элемент формы
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	Попытка
		ЭлементФормы = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Если ЭлементФормы = Неопределено Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Элемент формы '%1' не найден."), ИмяЭлемента);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Получаем данные элемента
	Попытка
		ДанныеЭлемента = Новый Структура;
		ДанныеЭлемента.Вставить("Имя", ИмяЭлемента);
		
		// Получаем заголовок элемента
		Заголовок = Неопределено;
		Попытка
			Заголовок = ЭлементФормы.ТекстЗаголовка;
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Заголовок", Заголовок);
		
		// Получаем тип элемента
		ТипЭлемента = Неопределено;
		Попытка
			ТипЭлемента = Строка(ТипЗнч(ЭлементФормы));
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Тип", ТипЭлемента);
		
		// Получаем вид элемента
		ВидЭлемента = Неопределено;
		Попытка
			ВидЭлемента = Строка(ЭлементФормы.Вид);
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Вид", ВидЭлемента);
		
		// Получаем значение элемента
		ЗначениеЭлемента = Неопределено;
		ТекстРедактирования = Неопределено;
		Попытка
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("УдалятьПустыеСтрокиИзМакета", Ложь);
			СостояниеФормыTestClient = Ванесса.ПолучитьСостояниеЭлементаФормыTestClient(ЭлементФормы, ДопПараметры);
			Если ТипЗнч(ЭлементФормы) = Тип("ТестируемаяТаблицаФормы") Тогда
				ЗначениеЭлемента = Ванесса.ПолучитьСтрокуСТЧФормаTestClient(СостояниеФормыTestClient.ЗначениеТЧ, Неопределено);
			ИначеЕсли СостояниеФормыTestClient.Вид = ВидПоляФормы.ПолеТабличногоДокумента Тогда
				ЗначениеЭлемента = Ванесса.ПолучитьСтрокуТабличныйДокументФормаTestClient(СостояниеФормыTestClient.ТабДок);
			Иначе	
				ЗначениеЭлемента = СостояниеФормыTestClient.ПредставлениеДанных;
				Если СостояниеФормыTestClient.Свойство("ТекстРедактирования") Тогда
					ТекстРедактирования = СостояниеФормыTestClient.ТекстРедактирования;
				КонецЕсли;	
			КонецЕсли;	
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("ТекстРедактирования", ТекстРедактирования);
		ДанныеЭлемента.Вставить("Значение", ЗначениеЭлемента);
		
		Если ТипЗнч(ЭлементФормы) = Тип("ТестируемаяКнопкаФормы") Тогда
			// Получаем значение пометки
			Пометка = Неопределено;
			Попытка
				Пометка = ЭлементФормы.ТекущееПометка();
			Исключение
			КонецПопытки;
			ДанныеЭлемента.Вставить("Пометка", Пометка);
		КонецЕсли;	
		
		// Получаем представление значения
		ПредставлениеЗначения = Неопределено;
		Попытка
			ПредставлениеЗначения = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(ЭлементФормы);
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Представление", ПредставлениеЗначения);
		
		// Получаем доступность
		ДоступностьЭлемента = Неопределено;
		Попытка
			ДоступностьЭлемента = ЭлементФормы.ТекущаяДоступность();
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Доступность", ДоступностьЭлемента);
		
		// Получаем видимость
		ВидимостьЭлемента = Неопределено;
		Попытка
			ВидимостьЭлемента = ЭлементФормы.ТекущаяВидимость();
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Видимость", ВидимостьЭлемента);
		
		// Получаем только просмотр
		ТолькоПросмотрЭлемента = Неопределено;
		Попытка
			ТолькоПросмотрЭлемента = ЭлементФормы.ТекущееТолькоПросмотр();
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("ТолькоПросмотр", ТолькоПросмотрЭлемента);
		
		// Формируем результат в формате Markdown
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("# Данные элемента формы"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Основная информация"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("- Имя:") + " " + ДанныеЭлемента.Имя);
		Если ДанныеЭлемента.Заголовок <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Заголовок:") + " " + ДанныеЭлемента.Заголовок);
		КонецЕсли;
		Если ДанныеЭлемента.Вид <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Вид:") + " " + ДанныеЭлемента.Вид);
		КонецЕсли;
		Если ДанныеЭлемента.Тип <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Тип:") + " " + ДанныеЭлемента.Тип);
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Значение элемента формы"));
		Строки.Добавить("");
		Если ДанныеЭлемента.Значение <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Значение:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Значение));
		КонецЕсли;
		Если ДанныеЭлемента.Представление <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Представление:") + " " + ДанныеЭлемента.Представление);
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Состояние"));
		Строки.Добавить("");
		Если ДанныеЭлемента.Доступность <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Доступность:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Доступность));
		КонецЕсли;
		Если ДанныеЭлемента.Видимость <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Видимость:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Видимость));
		КонецЕсли;
		Если ДанныеЭлемента.ТолькоПросмотр <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- ТолькоПросмотр:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.ТолькоПросмотр));
		КонецЕсли;
		Если ДанныеЭлемента.Свойство("Пометка") И ДанныеЭлемента.Пометка <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Пометка:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Пометка));
		КонецЕсли;
		
		Если ТипЗнч(ЭлементФормы) = Тип("ТестируемаяТаблицаФормы") Тогда
			// Получаем значение пометки
			ТекущийРежимРедактирование = Неопределено;
			Попытка
				ТекущийРежимРедактирование = ЭлементФормы.ТекущийРежимРедактирование();
			Исключение
			КонецПопытки;
			Если ТекущийРежимРедактирование <> Неопределено Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("- Таблица в режиме редактирования:") + " " + MCPПредставлениеЗначенияДляMarkdown(ТекущийРежимРедактирование));
			КонецЕсли;	
		КонецЕсли;	
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка получения данных элемента формы:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции	

// Универсальный инструмент для выполнения последовательности действий с элементами формы
&НаКлиенте
Функция ВыполнитьПоследовательностьДействийФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр actions_json (обязательный)
	ActionsJSON = Строка(ЗначениеПараметраИзЗапроса(Запрос, "actions_json"));
	Если НЕ ЗначениеЗаполнено(ActionsJSON) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр actions_json обязателен.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Парсим JSON с массивом действий
	Попытка
		МассивДействий = Ванесса.ПрочитатьОбъектJSON(ActionsJSON);
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка парсинга JSON:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецПопытки;
	
	Если ТипЗнч(МассивДействий) <> Тип("Массив") Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр actions_json должен содержать массив действий.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если МассивДействий.Количество() = 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Массив действий пуст.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Идентификатор = Запрос.Идентификатор;
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
	
	// Выполняем действия последовательно
	СтрокиРезультата = Новый Массив;
	СтрокиРезультата.Добавить(Ванесса.Локализовать("# Выполнение последовательности действий"));
	СтрокиРезультата.Добавить("");
	СтрокиРезультата.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Всего действий: %1"), МассивДействий.Количество()));
	СтрокиРезультата.Добавить("");
	
	Для Сч = 0 По МассивДействий.Количество() - 1 Цикл
		Действие = МассивДействий[Сч];
		
		Если ТипЗнч(Действие) <> Тип("Структура") Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Действие %1 не является структурой."), Сч + 1);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		
		// Получаем тип действия
		ТипДействия = "";
		Если Действие.Свойство("action") Тогда
			ТипДействия = Строка(Действие.action);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТипДействия) Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В действии %1 не указан параметр action."), Сч + 1);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		
		// Формируем запрос для вызова УправлениеЭлементамиФормы
		ЗапросЭлемента = Новый Структура;
		ЗапросЭлемента.Вставить("Идентификатор", Запрос.Идентификатор);
		ЗапросЭлемента.Вставить("Аргументы", Новый Структура);
		ЗапросЭлемента.Аргументы.Вставить("action", ТипДействия);
		
		// Копируем остальные параметры
		Для Каждого КлючЗначение Из Действие Цикл
			Если КлючЗначение.Ключ <> "action" Тогда
				ЗапросЭлемента.Аргументы.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		
		// Выполняем действие
		РезультатДействия = УправлениеЭлементамиФормыСлужебный(ЗапросЭлемента, ДополнительныеПараметры, Истина);
		
		// Проверяем результат
		Если ТипЗнч(РезультатДействия) = Тип("Строка") Тогда
			// Успешное выполнение
			СтрокиРезультата.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Действие %1: %2 - выполнено"), Сч + 1, ТипДействия));
			СтрокиРезультата.Добавить(РезультатДействия);
			СтрокиРезультата.Добавить("");
		Иначе
			// Ошибка выполнения
			СтрокиРезультата.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Действие %1: %2 - не выполнено"), Сч + 1, ТипДействия));
			
			//Добавляем данные об ошибке
			СтрокиРезультата.Добавить(Ванесса.ЗаписатьОбъектJSON(РезультатДействия));
			
			ТекстОшибки = Ванесса._СтрСоединить(СтрокиРезультата, Символы.ПС);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокиРезультата.Добавить(Ванесса.Локализовать("# Все действия выполнены успешно"));
	Возврат Ванесса._СтрСоединить(СтрокиРезультата, Символы.ПС);
	
КонецФункции

// Универсальный инструмент для управления элементами формы
&НаКлиенте
Функция УправлениеЭлементамиФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	Идентификатор = Запрос.Идентификатор;
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
	Возврат УправлениеЭлементамиФормыСлужебный(Запрос, ДополнительныеПараметры);
	
КонецФункции

// Внутренняя функция для нажатия кнопки формы
&НаКлиенте
Функция НажатьКнопкуФормы(ИмяЭлемента, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'click_button' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			Ванесса.ВОткрытойФормеВТЧЯНажимаюНаКнопкуСЗаголовком(ИмяТаблицы, ИмяЭлемента, Истина, ДопПараметры);
		Иначе
			ДопПараметры.Вставить("ДополнитьОшибкуПоискаКнопки", Истина);
			Кнопка = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,Тип("ТестируемаяКнопкаФормы"),ДопПараметры);

			Если Кнопка = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Кнопка '%1' не найдена."), ИмяЭлемента);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			Кнопка.Нажать();
		КонецЕсли;
		
		Если ПослеНажатияНаКнопкуНадоСделатьПаузу(ИмяЭлемента) Тогда
			Ванесса.sleep(1);
		КонецЕсли;
		
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Кнопка '%1' была успешно нажата."), ИмяЭлемента));
		
		Попытка
			ОкноМодальногоДиалога = Ванесса.НайтиОкноМодальногоДиалога();
			Если ОкноМодальногоДиалога <> Неопределено Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("После нажатия кнопки появился модальный диалог."));
				
				ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога);
			КонецЕсли;	
		Исключение
		КонецПопытки;
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		
		ТекстОшибки = Ванесса.Локализовать("Ошибка нажатия кнопки:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		
