		Открыта = Группа.ТекущееОткрыта();
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Группа '%1' открыта: %2."), ИмяЭлемента,
				MCPПредставлениеЗначенияДляMarkdown(Открыта))
			+ Символы.ПС + Ванесса.Локализовать(
				"Примечание: до платформы 8.3.27.2224 результат мог быть неверным.");
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

