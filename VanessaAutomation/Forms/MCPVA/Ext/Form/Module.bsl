// Поля и группы: cancel_edit
&НаКлиенте
Функция ОтменитьРедактированиеЭлементаMCP(ИмяЭлемента, ИмяТаблицы)
	ТекстОшибки = MCPОтменитьРедактированиеЭлемента(ИмяЭлемента, ИмяТаблицы);
	Если ТекстОшибки <> Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	ТекстРезультата = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Редактирование '%1' отменено."), ИмяЭлемента);
	Если ЭтоЯчейкаТаблицыMCP(ИмяЭлемента, ИмяТаблицы) Тогда
		// Отмена ячейки не завершает редактирование строки
		ТекстРезультата = ТекстРезультата + Символы.ПС +
			Ванесса.Локализовать("Строка таблицы осталась в режиме редактирования - завершите её действием 'end_edit_row'.");
	КонецЕсли;
	Возврат ТекстРезультата;
КонецФункции

// Проверяет, что элемент таблицы - ячейка (поле формы), а не дополнение формы.
// Без имени таблицы считает, что элемента таблицы нет.
&НаКлиенте
Функция ЭтоЯчейкаТаблицыMCP(ИмяЭлемента, ИмяТаблицы)
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		РезультатПоиска = НайтиКолонкуТаблицыMCP(Таблица, ИмяЭлемента, ИмяТаблицы);
		Возврат ТипЗнч(РезультатПоиска.Колонка) = Тип("ТестируемоеПолеФормы");
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Отменяет редактирование элемента: ячейки таблицы, дополнения формы (строка поиска и подобные)
// или поля/группы шапки формы. Возвращает Неопределено при успехе либо текст ошибки.
&НаКлиенте
Функция MCPОтменитьРедактированиеЭлемента(ИмяЭлемента, ИмяТаблицы)
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Таблица = НайтиТаблицуMCP(ИмяТаблицы);
			// Колонка принимается заголовком или внутренним именем поля формы; ячейка таблицы
			// (ТестируемоеПолеФормы) и дополнение формы (ТестируемоеДополнениеЭлементаФормы) -
			// разные объекты, поэтому ищем без ограничения по типу.
			РезультатПоиска = НайтиКолонкуТаблицыMCP(Таблица, ИмяЭлемента, ИмяТаблицы);
			ЭлементТаблицы = РезультатПоиска.Колонка;
			Если ЭлементТаблицы = Неопределено Тогда
				Возврат ТекстОшибкиКолонкаНеНайденаMCP(Таблица, ИмяЭлемента, ИмяТаблицы, РезультатПоиска);
			КонецЕсли;
			Если ТипЗнч(ЭлементТаблицы) = Тип("ТестируемоеДополнениеЭлементаФормы") Тогда
				ЭлементТаблицы.ОтменитьРедактирование();
			Иначе
				// Ячейку отменяем тем же методом. Он работает, только пока таблица в режиме редактирования
				// строки; откат строки (ЗакончитьРедактированиеСтроки) не используем - он удаляет добавленную строку.
				РежимРедактированиеСтроки = Истина;
				Попытка
					РежимРедактированиеСтроки = Таблица.ТекущийРежимРедактирование();
				Исключение
				КонецПопытки;
				Если РежимРедактированиеСтроки Тогда
					ЭлементТаблицы.ОтменитьРедактирование();
				Иначе
					Возврат Ванесса.ПодставитьПараметрыВСтроку(
						Ванесса.Локализовать("В таблице '%1' нет незавершённого ввода для отмены."), ИмяТаблицы);
				КонецЕсли;
			КонецЕсли;
		Иначе
			Поле = НайтиПолеMCP(ИмяЭлемента, Неопределено);
			Поле.ОтменитьРедактирование();
		КонецЕсли;
	Исключение
		Возврат ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Поля и группы: current_opened
