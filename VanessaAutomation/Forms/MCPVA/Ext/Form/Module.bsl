	Возврат MCPVAСлужебныйМодуль.ПроизнестиТекст(Запрос, ДополнительныеПараметры);
КонецФункции

// Управляет элементами UI Automation в окнах любых приложений (инструмент manage_uiautomation)
&НаКлиенте
Функция УправлениеЭлементамиUIAutomation(Запрос, ДополнительныеПараметры) Экспорт

	ОшибкаКомпоненты = MCPПроверитьКомпонентуUIAutomation();
	Если ОшибкаКомпоненты <> Неопределено Тогда
		Возврат ОшибкаКомпоненты;
	КонецЕсли;

	Действие = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"))));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: %1."), MCPДопустимыеДействияUIAutomation());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	// Проверка параметров вне Попытка оставила бы запрос MCP без ответа при неожиданном вводе
	Попытка
		ТекстОшибкиПараметров = MCPПроверитьПараметрыUIAutomation(Запрос, Действие);
	Исключение
		ТекстОшибкиПараметров = Ванесса.Локализовать("Не удалось проверить параметры запроса.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(ТекстОшибкиПараметров) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиПараметров);
	КонецЕсли;

	КонтекстMCP = MCPНовыйКонтекстЗапроса(Запрос);
	Результат = Неопределено;
	Попытка
		Если Действие = "find_elements" Тогда
			Результат = УправлениеЭлементамиUIAutomation_НайтиЭлементы(Запрос);
		ИначеЕсли Действие = "get_element" Тогда
			Результат = УправлениеЭлементамиUIAutomation_ДанныеЭлемента(Запрос);
		ИначеЕсли Действие = "get_children" Тогда
			Результат = УправлениеЭлементамиUIAutomation_ДочерниеЭлементы(Запрос);
		ИначеЕсли Действие = "get_parent" Тогда
			Результат = УправлениеЭлементамиUIAutomation_РодительскийЭлемент(Запрос);
		ИначеЕсли Действие = "get_next" Тогда
			Результат = УправлениеЭлементамиUIAutomation_СледующийЭлемент(Запрос);
		ИначеЕсли Действие = "get_active" Тогда
			Результат = УправлениеЭлементамиUIAutomation_АктивныйЭлемент(Запрос);
		ИначеЕсли Действие = "click" Тогда
			Результат = УправлениеЭлементамиUIAutomation_Клик(Запрос);
		ИначеЕсли Действие = "input_text" Тогда
			Результат = УправлениеЭлементамиUIAutomation_ВводТекста(Запрос);
		ИначеЕсли Действие = "press_keys" Тогда
			Результат = УправлениеЭлементамиUIAutomation_НажатиеКлавиш(Запрос);
		ИначеЕсли Действие = "mouse_wheel" Тогда
			Результат = УправлениеЭлементамиUIAutomation_КолесоМыши(Запрос);
		ИначеЕсли Действие = "move_cursor" Тогда
			Результат = УправлениеЭлементамиUIAutomation_Курсор(Запрос);
		ИначеЕсли Действие = "effect" Тогда
			Результат = УправлениеЭлементамиUIAutomation_Эффект(Запрос);
		Иначе
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Неизвестное значение параметра action: '%1'. Допустимые значения: %2."), Действие, MCPДопустимыеДействияUIAutomation());
			Результат = MCPОшибкаПараметровUIAutomation(ТекстСообщения);
		КонецЕсли;
	Исключение
		Результат = MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Если Результат = Неопределено Тогда
		// Асинхронное действие завершит вызов из колбэка
		Возврат Неопределено;
	КонецЕсли;

	Если Результат.Успех Тогда
		MCPЗавершитьВызовУспешно(КонтекстMCP, Результат.Текст);
	Иначе
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, Результат.Код, Результат.Текст);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ПолученыЭлементыUIAutomation(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		// Компонента отвечает null, когда ничего не найдено (проверено по её исходникам) — это не сбой.
		// Разбор null может дать как Null, так и Неопределено, поэтому проверяем оба значения
		ДанныеЭлементов = MCPДанныеИзJSONUIAutomation(РезультатВызова);
		Если ДанныеЭлементов = Неопределено ИЛИ ДанныеЭлементов = Null Тогда
			ТекстОтветаКомпоненты = СокрЛП(Строка(РезультатВызова));
			Если НЕ ЗначениеЗаполнено(ТекстОтветаКомпоненты) ИЛИ НРег(ТекстОтветаКомпоненты) = "null" Тогда
				ДанныеЭлементов = Новый Массив;
			Иначе
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не удалось разобрать ответ внешней компоненты VanessaExt: %1"),
					Лев(ТекстОтветаКомпоненты, 200));
				MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДанныеЭлементов) = Тип("Структура") Тогда
			// Так компонента сообщает о неверном ключе отбора
			ТекстОшибкиКомпоненты = MCPЗначениеПоляUIAutomation(ДанныеЭлементов, "error");
			Если ЗначениеЗаполнено(ТекстОшибкиКомпоненты) Тогда
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Внешняя компонента VanessaExt отклонила отбор: %1"), ТекстОшибкиКомпоненты);
				MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(ДанныеЭлементов) <> Тип("Массив") Тогда
			ТекстСообщения = Ванесса.Локализовать("Не удалось получить список элементов от внешней компоненты VanessaExt.");
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		НайденныеЭлементы = ДанныеЭлементов;
		Если ЗначениеЗаполнено(ДопПараметры.ЗаголовокОкна) Тогда
			НайденныеЭлементы = MCPОтобратьЭлементыПоОкнуUIAutomation(НайденныеЭлементы, ДопПараметры.ЗаголовокОкна);
		КонецЕсли;

		ПоказанныеЭлементы = НайденныеЭлементы;
		Если ДопПараметры.Лимит > 0 И НайденныеЭлементы.Количество() > ДопПараметры.Лимит Тогда
			ПоказанныеЭлементы = Новый Массив;
			Для Сч = 0 По ДопПараметры.Лимит - 1 Цикл
				ПоказанныеЭлементы.Добавить(НайденныеЭлементы[Сч]);
			КонецЦикла;
		КонецЕсли;

		ТекстОтвета = MCPСформироватьMarkdownСпискаЭлементовUIAutomation(ПоказанныеЭлементы, НайденныеЭлементы.Количество(), ДопПараметры);
		Если НЕ ЗначениеЗаполнено(ДопПараметры.ИмяЭлемента) И НЕ ЗначениеЗаполнено(ДопПараметры.ТипЭлемента) И НЕ ЗначениеЗаполнено(ДопПараметры.Подсказка) Тогда
			ТекстОтвета = ТекстОтвета + Символы.ПС + Символы.ПС
				+ Ванесса.Локализовать("Отбор для поиска не задан: внешняя компонента VanessaExt ищет элементы только по критериям — укажите name, control_type или help_text. Отбор по окну применяется к уже найденным элементам.");
		КонецЕсли;
		MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстОтвета);

	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершенЭффектUIAutomation(Результат, ПараметрыВызова, ДопПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка
		MCPЗавершитьВызовУспешно(КонтекстMCP, ДопПараметры.ТекстОтвета);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_НайтиЭлементы(Запрос)

	Попытка
		PID = Ванесса.ПолучитьКорректныйPID(ЗначениеПараметраИзЗапроса(Запрос, "pid"));
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	ОтборЭлементов = Новый Структура;
	ОтборЭлементов.Вставить("ProcessId", Число(PID));

	ИмяЭлемента = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "name")));
	Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ОтборЭлементов.Вставить("Name", ИмяЭлемента);
	КонецЕсли;

	ТипЭлемента = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "control_type")));
	Если ЗначениеЗаполнено(ТипЭлемента) Тогда
		ОтборЭлементов.Вставить("ControlType", ТипЭлемента);
	КонецЕсли;

	ПодсказкаЭлемента = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "help_text")));
	Если ЗначениеЗаполнено(ПодсказкаЭлемента) Тогда
		Если Ванесса.Версия8319ИлиВыше Тогда
			ОтборЭлементов.Вставить("HelpText", ПодсказкаЭлемента);
		Иначе
			ОтборЭлементов.Вставить("LegacyIAccessibleHelp", ПодсказкаЭлемента);
		КонецЕсли;
	КонецЕсли;

	Лимит = 100;
	ЧислоЛимита = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "limit");
	Если ЧислоЛимита <> Неопределено Тогда
		Лимит = Цел(ЧислоЛимита);
	КонецЕсли;
	Если Лимит < 0 Тогда
		Возврат MCPОшибкаПараметровUIAutomation(Ванесса.Локализовать("Параметр limit не может быть отрицательным."));
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("PID", Число(PID));
	ДопПараметры.Вставить("ЗаголовокОкна", СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "window_title"))));
	ДопПараметры.Вставить("ИмяЭлемента", ИмяЭлемента);
	ДопПараметры.Вставить("ТипЭлемента", ТипЭлемента);
	ДопПараметры.Вставить("Подсказка", ПодсказкаЭлемента);
	ДопПараметры.Вставить("Лимит", Лимит);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученыЭлементыUIAutomation", ЭтаФорма, ДопПараметры);

	Попытка
		ОтборЭлементовJSON = Ванесса.ЗаписатьОбъектJSON(ОтборЭлементов);
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовНайтиЭлементы(ОписаниеОповещения, ОтборЭлементовJSON);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_ДанныеЭлемента(Запрос)

	РезультатЭлемента = MCPЭлементПоИдентификаторуUIAutomation(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id"))));
	Если НЕ РезультатЭлемента.Успех Тогда
		Возврат РезультатЭлемента;
	КонецЕсли;

	Возврат MCPУспехUIAutomation(MCPОписаниеЭлементаUIAutomation(РезультатЭлемента.Данные, Ванесса.Локализовать("Элемент UI Automation")));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_ДочерниеЭлементы(Запрос)

	РезультатЭлемента = MCPЭлементПоИдентификаторуUIAutomation(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id"))));
	Если НЕ РезультатЭлемента.Успех Тогда
		Возврат РезультатЭлемента;
	КонецЕсли;

	Идентификатор = Строка(MCPЗначениеПоляUIAutomation(РезультатЭлемента.Данные, "Id"));

	Попытка
		ДанныеJSON = Ванесса.ВнешняяКомпонентаДляСкриншотов.ПолучитьЭлементы(Идентификатор);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	// Компонента отдаёт пустую строку или null, если элемент не разрешился, и не добавляет Tree, если детей нет
	Если НЕ ЗначениеЗаполнено(ДанныеJSON) ИЛИ ДанныеJSON = Null Тогда
		Возврат MCPРезультатUIAutomation(Ложь, Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Элемент UI Automation с Id <%1> не найден. Возможно, окно закрылось или изменилось — выполните поиск заново."), Идентификатор), "ACTION_FAILED");
	КонецЕсли;

	ДанныеДетей = MCPДанныеИзJSONUIAutomation(ДанныеJSON);
	ДочерниеЭлементы = Новый Массив;
	Если ТипЗнч(ДанныеДетей) = Тип("Структура") Тогда
		ТекстОшибкиКомпоненты = MCPЗначениеПоляUIAutomation(ДанныеДетей, "error");
		Если ЗначениеЗаполнено(ТекстОшибкиКомпоненты) Тогда
			Возврат MCPРезультатUIAutomation(Ложь, Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Внешняя компонента VanessaExt отклонила запрос: %1"), ТекстОшибкиКомпоненты), "ACTION_FAILED");
		КонецЕсли;
		ЗначениеДетей = MCPЗначениеПоляUIAutomation(ДанныеДетей, "Tree");
		Если ТипЗнч(ЗначениеДетей) = Тип("Массив") Тогда
			ДочерниеЭлементы = ЗначениеДетей;
		КонецЕсли;
	Иначе
		Возврат MCPРезультатUIAutomation(Ложь, Ванесса.Локализовать("Не удалось получить дочерние элементы от внешней компоненты VanessaExt."), "ACTION_FAILED");
	КонецЕсли;

	ИмяЭлемента = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "name")));
	ТипЭлемента = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "control_type")));
	Если ЗначениеЗаполнено(ИмяЭлемента) ИЛИ ЗначениеЗаполнено(ТипЭлемента) Тогда
		ДочерниеЭлементы = MCPОтобратьЭлементыПоИмениИТипуUIAutomation(ДочерниеЭлементы, ИмяЭлемента, ТипЭлемента);
	КонецЕсли;

	Возврат MCPУспехUIAutomation(MCPСформироватьMarkdownДочернихЭлементовUIAutomation(ДочерниеЭлементы, Идентификатор));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_РодительскийЭлемент(Запрос)

	Идентификатор = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id")));

	Попытка
		ДанныеJSON = Ванесса.ВнешняяКомпонентаДляСкриншотов.ПолучитьРодителяЭлемента(Идентификатор);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Результат = MCPЭлементИзОтветаКомпонентыUIAutomation(ДанныеJSON, Идентификатор,
		Ванесса.Локализовать("Не удалось получить родителя элемента. Возможно, элемент верхнего уровня или окно изменилось."));
	Если НЕ Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат MCPУспехUIAutomation(MCPОписаниеЭлементаUIAutomation(Результат.Данные, Ванесса.Локализовать("Родительский элемент")));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_СледующийЭлемент(Запрос)

	Идентификатор = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id")));

	Попытка
		ДанныеJSON = Ванесса.ВнешняяКомпонентаДляСкриншотов.ПолучитьСледующийЭлемент(Идентификатор);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Результат = MCPЭлементИзОтветаКомпонентыUIAutomation(ДанныеJSON, Идентификатор,
		Ванесса.Локализовать("Не удалось получить следующий элемент. Возможно, элемент последний или окно изменилось."));
	Если НЕ Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат MCPУспехUIAutomation(MCPОписаниеЭлементаUIAutomation(Результат.Данные, Ванесса.Локализовать("Следующий элемент")));

КонецФункции

// Возвращает элемент из ответа компоненты; MCP-результат с элементом в поле Данные
&НаКлиенте
Функция MCPЭлементИзОтветаКомпонентыUIAutomation(Знач ДанныеJSON, Знач Идентификатор, ТекстОшибкиПоУмолчанию)

	Элемент = MCPСтруктураИзJSONUIAutomation(ДанныеJSON);
	Если Элемент = Неопределено Тогда
		Возврат MCPРезультатUIAutomation(Ложь, Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибкиПоУмолчанию + " Id <%1>.", Идентификатор), "ACTION_FAILED");
	КонецЕсли;

	Возврат MCPРезультатUIAutomation(Истина, "", "", Элемент);

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_АктивныйЭлемент(Запрос)

	Попытка
		АктивныйЭлемент = Ванесса.ПрочитатьОбъектJSON(Ванесса.ВнешняяКомпонентаДляСкриншотов.АктивныйЭлемент);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Если ТипЗнч(АктивныйЭлемент) <> Тип("Структура") Тогда
		Возврат MCPРезультатUIAutomation(Ложь, Ванесса.Локализовать("Не удалось получить активный элемент UI Automation."), "ACTION_FAILED");
	КонецЕсли;

	ТекстОтвета = MCPОписаниеЭлементаUIAutomation(АктивныйЭлемент, Ванесса.Локализовать("Активный элемент UI Automation"));

	Если НЕ MCPПараметрНеЗаданUIAutomation(Запрос, "pid") Тогда
		PIDЭлемента = MCPЗначениеПоляUIAutomation(АктивныйЭлемент, "ProcessId");
		Если ЗначениеЗаполнено(PIDЭлемента) Тогда
			ПроверяемыйPID = Число(Ванесса.ПолучитьКорректныйPID(ЗначениеПараметраИзЗапроса(Запрос, "pid")));
			Если Число(PIDЭлемента) <> ПроверяемыйPID Тогда
				Возврат MCPРезультатUIAutomation(Ложь, Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Активный элемент принадлежит другому процессу (PID %1), а указан pid %2."), Число(PIDЭлемента), ПроверяемыйPID), "ACTION_FAILED");
			КонецЕсли;
		Иначе
			ТекстОтвета = ТекстОтвета + Символы.ПС + Ванесса.Локализовать("Примечание: проверить соответствие указанному pid не удалось — компонента не вернула ProcessId активного элемента.");
		КонецЕсли;
	КонецЕсли;

	Возврат MCPУспехUIAutomation(ТекстОтвета);

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_Клик(Запрос)

	ТипКлика = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "click_type"))));
	Если НЕ ЗначениеЗаполнено(ТипКлика) Тогда
		ТипКлика = "left";
	КонецЕсли;

	Результат = MCPКликПоЭлементуUIAutomation(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id"))), ТипКлика);
	Если НЕ Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат MCPУспехUIAutomation(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Выполнен клик '%1' по элементу. Id: %2, имя: %3, тип: %4."),
		ТипКлика,
		MCPТекстПоляЭлементаUIAutomation(Результат.Данные, "Id"),
		MCPТекстПоляЭлементаUIAutomation(Результат.Данные, "Name"),
		MCPТекстПоляЭлементаUIAutomation(Результат.Данные, "Type")));

КонецФункции

// Выполняет клик по элементу UI Automation; MCP-результат с элементом в поле Данные
&НаКлиенте
Функция MCPКликПоЭлементуUIAutomation(Знач Идентификатор, ТипКлика)

	РезультатЭлемента = MCPЭлементПоИдентификаторуUIAutomation(Идентификатор);
	Если НЕ РезультатЭлемента.Успех Тогда
		Возврат РезультатЭлемента;
	КонецЕсли;

	ДвойнойКлик = Ложь;
	ЛеваяКнопка = Истина;
	Если ТипКлика = "right" Тогда
		ЛеваяКнопка = Ложь;
	ИначеЕсли ТипКлика = "double" Тогда
		ДвойнойКлик = Истина;
	КонецЕсли;

	Координаты = MCPКоординатыUIAutomation(РезультатЭлемента.Данные);
	Если Координаты = Неопределено Тогда
		Возврат MCPРезультатUIAutomation(Ложь,
			Ванесса.Локализовать("Не удалось выполнить клик — координаты элемента не определены (элемент невидим). Обновите поиск через action='find_elements'."), "ACTION_FAILED");
	КонецЕсли;

	Ванесса.КликПоЭлементуБезПеремещенияМышкиUIAutomation(Координаты, ДвойнойКлик, ЛеваяКнопка);

	Возврат MCPРезультатUIAutomation(Истина, "", "", РезультатЭлемента.Данные);

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_ВводТекста(Запрос)

	Значение = Строка(ЗначениеПараметраИзЗапроса(Запрос, "value"));

	Задержка = 100;
	ЧислоЗадержки = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "delay");
	Если ЧислоЗадержки <> Неопределено Тогда
		Задержка = Цел(ЧислоЗадержки);
	КонецЕсли;
	Если Задержка < 0 Тогда
		Возврат MCPОшибкаПараметровUIAutomation(Ванесса.Локализовать("Параметр delay не может быть отрицательным."));
	КонецЕсли;

	Идентификатор = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id")));
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		// Сначала кликаем по элементу, чтобы передать ему фокус ввода
		РезультатКлика = MCPКликПоЭлементуUIAutomation(Идентификатор, "left");
		Если НЕ РезультатКлика.Успех Тогда
			Возврат РезультатКлика;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Ванесса.ВнешняяКомпонентаДляСкриншотов.ЭмуляцияВводаТекста(Значение, Задержка);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Возврат MCPУспехUIAutomation(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Текст введён в активное окно: %1."), Значение));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_НажатиеКлавиш(Запрос)

	РезультатРазбора = MCPКодыКлавишИзСочетанияUIAutomation(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "keys"))));
	Если НЕ РезультатРазбора.Успех Тогда
		Возврат РезультатРазбора;
	КонецЕсли;

	Попытка
		Ванесса.ВнешняяКомпонентаДляСкриншотов.ЭмуляцияНажатияКлавиши(Ванесса.ЗаписатьОбъектJSON(РезультатРазбора.Данные));
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Возврат MCPУспехUIAutomation(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Нажато сочетание клавиш: %1."), СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "keys")))));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_КолесоМыши(Запрос)

	Направление = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "direction"))));

	Если Направление = "forward" ИЛИ Направление = "вперёд" ИЛИ Направление = "вперед" Тогда
		КодНаправления = 1;
	Иначе
		КодНаправления = -1;
	КонецЕсли;

	ТекстJSON = Неопределено;
	СочетаниеКлавиш = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "keys")));
	Если ЗначениеЗаполнено(СочетаниеКлавиш) Тогда
		РезультатРазбора = MCPКодыКлавишИзСочетанияUIAutomation(СочетаниеКлавиш);
		Если НЕ РезультатРазбора.Успех Тогда
			Возврат РезультатРазбора;
		КонецЕсли;
		ТекстJSON = Ванесса.ЗаписатьОбъектJSON(РезультатРазбора.Данные);
	КонецЕсли;

	Попытка
		Ванесса.ВнешняяКомпонентаДляСкриншотов.ЭмуляцияКолесаМыши(КодНаправления, ТекстJSON);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Возврат MCPУспехUIAutomation(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Выполнено вращение колеса мыши: %1."), Направление));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_Курсор(Запрос)

	Идентификатор = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id")));
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		РезультатЭлемента = MCPЭлементПоИдентификаторуUIAutomation(Идентификатор);
		Если НЕ РезультатЭлемента.Успех Тогда
			Возврат РезультатЭлемента;
		КонецЕсли;

		Координаты = MCPКоординатыUIAutomation(РезультатЭлемента.Данные);
		Если Координаты = Неопределено Тогда
			Возврат MCPРезультатUIAutomation(Ложь,
				Ванесса.Локализовать("Не удалось определить координаты элемента — возможно, элемент невидим. Обновите поиск через action='find_elements'."), "ACTION_FAILED");
		КонецЕсли;

		X = Окр((Координаты.Left + Координаты.Right) / 2, 0);
		Y = Окр((Координаты.Top + Координаты.Bottom) / 2, 0);
	Иначе
		X = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "x");
		Y = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "y");
	КонецЕсли;

	Попытка
		Ванесса.ВнешняяКомпонентаДляСкриншотов.УстановитьПозициюКурсора(X, Y);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Возврат MCPУспехUIAutomation(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Курсор перемещён в точку (%1, %2)."), Формат(X, "ЧГ=; ЧН=0"), Формат(Y, "ЧГ=; ЧН=0")));

КонецФункции

&НаКлиенте
Функция УправлениеЭлементамиUIAutomation_Эффект(Запрос)

	ТипЭффекта = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "effect_type"))));

	// Область эффекта: по элементу UI Automation или по явным координатам
	Идентификатор = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_id")));
	Область = Неопределено;
	ОписаниеЦели = "";
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		РезультатЭлемента = MCPЭлементПоИдентификаторуUIAutomation(Идентификатор);
		Если НЕ РезультатЭлемента.Успех Тогда
			Возврат РезультатЭлемента;
		КонецЕсли;

		Область = MCPКоординатыUIAutomation(РезультатЭлемента.Данные);
		Если Область = Неопределено Тогда
			Возврат MCPРезультатUIAutomation(Ложь,
				Ванесса.Локализовать("Не удалось определить координаты элемента — возможно, элемент невидим. Обновите поиск через action='find_elements'."), "ACTION_FAILED");
		КонецЕсли;

		ОписаниеЦели = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Элемент Id %1, имя: %2, тип: %3."),
			MCPТекстПоляЭлементаUIAutomation(РезультатЭлемента.Данные, "Id"),
			MCPТекстПоляЭлементаUIAutomation(РезультатЭлемента.Данные, "Name"),
			MCPТекстПоляЭлементаUIAutomation(РезультатЭлемента.Данные, "Type"));
	Иначе
		Область = MCPОбластьИзПараметровUIAutomation(Запрос);
	КонецЕсли;

	Настройки = MCPНастройкиОтрисовкиUIAutomation(ТипЭффекта, Запрос);
	НастройкиJSON = Ванесса.ЗаписатьОбъектJSON(Настройки);

	ТекстНадписи = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "text")));

	Left = Область.Left;
	Top = Область.Top;
	Right = Область.Right;
	Bottom = Область.Bottom;
	// Имена без квалификатора Ширина и Высота писались бы в свойства формы, а не в локальные переменные
	ШиринаОбласти = Right - Left;
	ВысотаОбласти = Bottom - Top;
	Толщина = Число(Настройки.thickness);

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекстОтвета", MCPТекстОтветаЭффектаUIAutomation(ТипЭффекта, Область, ОписаниеЦели));
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенЭффектUIAutomation", ЭтаФорма, ДопПараметры);

	Попытка
		Если ТипЭффекта = "dim" Тогда
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовНарисоватьТень(ОписаниеОповещения, НастройкиJSON, Left, Top, ШиринаОбласти, ВысотаОбласти);
		ИначеЕсли ТипЭффекта = "frame" Тогда
			// Надпись у рамки не поддерживается: у метода компоненты 5 параметров
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовНарисоватьПрямоугольник(ОписаниеОповещения, НастройкиJSON,
				Left - Толщина, Top - Толщина, ШиринаОбласти + Толщина * 2, ВысотаОбласти + Толщина * 2);
		ИначеЕсли ТипЭффекта = "ellipse" Тогда
			// Толщину контура эллипс добавляет сам, поэтому смещение здесь не делаем
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовНарисоватьЭллипс(ОписаниеОповещения, НастройкиJSON,
				Left, Top, ШиринаОбласти, ВысотаОбласти);
		ИначеЕсли ТипЭффекта = "arrow" Тогда
			ИнформацияЭкрана = Вычислить("ПолучитьИнформациюЭкрановКлиента()[0]");
			X1 = Цел(ИнформацияЭкрана.Ширина / 2);
			Y1 = Цел(ИнформацияЭкрана.Высота / 2);
			Если Left > X1 Тогда
				X2 = Left;
			Иначе
				X2 = Right;
			КонецЕсли;
			Y2 = Top + Цел(ВысотаОбласти / 2);
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовНарисоватьСтрелку(ОписаниеОповещения, НастройкиJSON, X1, Y1, X2, Y2);
		Иначе
			// balloon: текст передаётся отдельным аргументом и не входит в JSON настроек
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПоказатьПодсказку(ОписаниеОповещения, НастройкиJSON,
				Left + Цел(ШиринаОбласти / 2) + Толщина, Top + Цел(ВысотаОбласти / 2) + Толщина, ТекстНадписи);
		КонецЕсли;
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Возвращает настройки отрисовки эффекта: базовые значения по типу эффекта, перекрытые параметрами запроса
&НаКлиенте
Функция MCPНастройкиОтрисовкиUIAutomation(ТипЭффекта, Запрос)

	Если ТипЭффекта = "balloon" Тогда
		Настройки = Новый Структура;
		Настройки.Вставить("color", 3289800);
		Настройки.Вставить("background", 15793151);
		Настройки.Вставить("fontColor", 0);
		Настройки.Вставить("fontName", "Calibri");
		Настройки.Вставить("fontSize", 12);
		Настройки.Вставить("duration", 4000);
		Настройки.Вставить("thickness", 4);
		Настройки.Вставить("radius", 5);
	Иначе
		Настройки = Ванесса.ПолучитьНастройкиРисования();
		// Надпись по умолчанию не рисуем
		Настройки.Удалить("text");
	КонецЕсли;

	ПараметрыСтиля = Новый Соответствие;
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "thickness", "thickness");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "transparency", "transparency");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "duration", "duration");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "frameDelay", "frame_delay");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "fontSize", "font_size");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "fontColor", "font_color");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "background", "background");
	MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, "radius", "radius");

	Если НЕ MCPПараметрНеЗаданUIAutomation(Запрос, "color") Тогда
		ПараметрыСтиля.Вставить("color", MCPЦветЭффектаUIAutomation(ЗначениеПараметраИзЗапроса(Запрос, "color")));
	КонецЕсли;

	ИмяШрифта = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "font_name")));
	Если ЗначениеЗаполнено(ИмяШрифта) Тогда
		ПараметрыСтиля.Вставить("fontName", ИмяШрифта);
	КонецЕсли;

	ТекстНадписи = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "text")));
	// Надпись в настройках читает только затемнение; у балуна она передаётся отдельным аргументом,
	// а рамка и эллипс надпись не поддерживают вовсе (у методов компоненты 5 параметров)
	Если ТипЭффекта = "dim" И ЗначениеЗаполнено(ТекстНадписи) Тогда
		ПараметрыСтиля.Вставить("text", ТекстНадписи);
	КонецЕсли;

	Возврат Ванесса.ДополнитьПараметрыОтрисовкиПереданныеПользователем(Настройки, ПараметрыСтиля);

КонецФункции

&НаКлиенте
Процедура MCPДобавитьЧисловойПараметрСтиляUIAutomation(ПараметрыСтиля, Настройки, Запрос, ИмяНастройки, ИмяПараметра)

	Значение = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, ИмяПараметра);
	Если Значение <> Неопределено Тогда
		ПараметрыСтиля.Вставить(ИмяНастройки, Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция MCPЦветЭффектаUIAutomation(ЗначениеЦвета)

	СтрокаЦвета = СокрЛП(Строка(ЗначениеЦвета));

	Попытка
		Возврат Число(СтрокаЦвета);
	Исключение
	КонецПопытки;

	// Значение цвета или число (BGR), или имя цвета; ЦветЧислом переводит объект Цвет в число, которое сериализуется в JSON настроек
	Возврат Ванесса.ЦветЧислом(WebЦвета[СтрокаЦвета]);

КонецФункции

&НаКлиенте
Функция MCPТекстОтветаЭффектаUIAutomation(ТипЭффекта, Область, ОписаниеЦели)

	ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Эффект '%1' показан на области: Left %2, Top %3, Right %4, Bottom %5."),
		ТипЭффекта,
		Формат(Область.Left, "ЧГ=; ЧН=0"),
		Формат(Область.Top, "ЧГ=; ЧН=0"),
		Формат(Область.Right, "ЧГ=; ЧН=0"),
		Формат(Область.Bottom, "ЧГ=; ЧН=0"));

	Если ЗначениеЗаполнено(ОписаниеЦели) Тогда
		ТекстОтвета = ТекстОтвета + Символы.ПС + ОписаниеЦели;
	КонецЕсли;

	Возврат ТекстОтвета;

КонецФункции

// Проверяет параметры запроса до старта работы; возвращает текст ошибки или Неопределено
&НаКлиенте
Функция MCPПроверитьПараметрыUIAutomation(Запрос, Действие)

	ТекстОшибкиЧисел = MCPПроверитьЧисловыеПараметрыUIAutomation(Запрос);
	Если ЗначениеЗаполнено(ТекстОшибкиЧисел) Тогда
		Возврат ТекстОшибкиЧисел;
	КонецЕсли;

	Если Действие = "find_elements" И MCPПараметрНеЗаданUIAutomation(Запрос, "pid") Тогда
		Возврат Ванесса.Локализовать("Для action='find_elements' параметр pid обязателен. Укажите число (PID процесса), имя клиента тестирования, 'ЭтотСеанс' или 'ЭтотПроцесс' (сам сеанс Vanessa Automation).");
	КонецЕсли;

	Если (Действие = "get_element" ИЛИ Действие = "get_children" ИЛИ Действие = "get_parent" ИЛИ Действие = "get_next" ИЛИ Действие = "click")
		И MCPПараметрНеЗаданUIAutomation(Запрос, "element_id") Тогда
		Возврат Ванесса.Локализовать("Для этого действия параметр element_id обязателен. Возьмите Id элемента из результата action='find_elements'.");
	КонецЕсли;

	Если Действие = "click" Тогда
		ТипКлика = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "click_type"))));
		Если ЗначениеЗаполнено(ТипКлика) И ТипКлика <> "left" И ТипКлика <> "right" И ТипКлика <> "double" Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Некорректное значение параметра click_type: '%1'. Допустимые значения: 'left', 'right', 'double'."), ТипКлика);
		КонецЕсли;
	КонецЕсли;

	Если Действие = "input_text" И MCPПараметрНеЗаданUIAutomation(Запрос, "value") Тогда
		Возврат Ванесса.Локализовать("Для action='input_text' параметр value обязателен.");
	КонецЕсли;

	Если Действие = "press_keys" И MCPПараметрНеЗаданUIAutomation(Запрос, "keys") Тогда
		Возврат Ванесса.Локализовать("Для action='press_keys' параметр keys обязателен. Пример: 'Ctrl+S', 'ENTER', 'Alt+F4'.");
	КонецЕсли;

	Если Действие = "mouse_wheel" Тогда
		Направление = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "direction"))));
		Если Направление <> "forward" И Направление <> "вперёд" И Направление <> "вперед" И Направление <> "back" И Направление <> "назад" Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Некорректное значение параметра direction: '%1'. Допустимые значения: 'forward' (вперёд) или 'back' (назад)."), Направление);
		КонецЕсли;
	КонецЕсли;

	Если Действие = "move_cursor"
		И MCPПараметрНеЗаданUIAutomation(Запрос, "element_id")
		И (MCPПараметрНеЗаданUIAutomation(Запрос, "x") ИЛИ MCPПараметрНеЗаданUIAutomation(Запрос, "y")) Тогда
		Возврат Ванесса.Локализовать("Для action='move_cursor' укажите element_id либо координаты x и y.");
	КонецЕсли;

	Если Действие = "effect" Тогда
		ТипЭффекта = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "effect_type"))));
		Если ТипЭффекта <> "dim" И ТипЭффекта <> "frame" И ТипЭффекта <> "ellipse" И ТипЭффекта <> "arrow" И ТипЭффекта <> "balloon" Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Некорректное значение параметра effect_type: '%1'. Допустимые значения: 'dim' (затемнение), 'frame' (рамка), 'ellipse' (эллипс), 'arrow' (стрелка), 'balloon' (подсказка-балун)."), ТипЭффекта);
		КонецЕсли;
		Если ТипЭффекта = "balloon" И MCPПараметрНеЗаданUIAutomation(Запрос, "text") Тогда
			Возврат Ванесса.Локализовать("Для effect_type='balloon' параметр text обязателен.");
		КонецЕсли;
		Если MCPПараметрНеЗаданUIAutomation(Запрос, "element_id")
			И (MCPПараметрНеЗаданUIAutomation(Запрос, "left") ИЛИ MCPПараметрНеЗаданUIAutomation(Запрос, "top")) Тогда
			Возврат Ванесса.Локализовать("Для action='effect' укажите element_id либо координаты left и top (можно добавить width и height).");
		КонецЕсли;
		ШиринаОбласти = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "width");
		ВысотаОбласти = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "height");
		Если (ШиринаОбласти <> Неопределено И ШиринаОбласти < 0) ИЛИ (ВысотаОбласти <> Неопределено И ВысотаОбласти < 0) Тогда
			Возврат Ванесса.Локализовать("Параметры width и height не могут быть отрицательными.");
		КонецЕсли;
		Если НЕ MCPПараметрНеЗаданUIAutomation(Запрос, "color") Тогда
			ТекстОшибкиЦвета = MCPПроверитьЦветЭффектаUIAutomation(ЗначениеПараметраИзЗапроса(Запрос, "color"));
			Если ЗначениеЗаполнено(ТекстОшибкиЦвета) Тогда
				Возврат ТекстОшибкиЦвета;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция MCPПроверитьЧисловыеПараметрыUIAutomation(Запрос)

	Для Каждого ИмяПараметра Из MCPЧисловыеПараметрыUIAutomation() Цикл
		Если MCPПараметрНеЗаданUIAutomation(Запрос, ИмяПараметра) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ЧислоЗначение = Число(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра))));
		Исключение
			ЧислоЗначение = Неопределено;
		КонецПопытки;

		Если ЧислоЗначение = Неопределено Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Некорректное значение параметра %1 — нужно передать число."), ИмяПараметра);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция MCPЧисловыеПараметрыUIAutomation()

	ЧисловыеПараметры = Новый Массив;
	ЧисловыеПараметры.Добавить("limit");
	ЧисловыеПараметры.Добавить("delay");
	ЧисловыеПараметры.Добавить("x");
	ЧисловыеПараметры.Добавить("y");
	ЧисловыеПараметры.Добавить("left");
	ЧисловыеПараметры.Добавить("top");
	ЧисловыеПараметры.Добавить("width");
	ЧисловыеПараметры.Добавить("height");
	ЧисловыеПараметры.Добавить("thickness");
	ЧисловыеПараметры.Добавить("transparency");
	ЧисловыеПараметры.Добавить("duration");
	ЧисловыеПараметры.Добавить("frame_delay");
	ЧисловыеПараметры.Добавить("font_size");
	ЧисловыеПараметры.Добавить("font_color");
	ЧисловыеПараметры.Добавить("background");
	ЧисловыеПараметры.Добавить("radius");
	Возврат ЧисловыеПараметры;

КонецФункции

&НаКлиенте
Функция MCPПроверитьЦветЭффектаUIAutomation(ЗначениеЦвета)

	СтрокаЦвета = СокрЛП(Строка(ЗначениеЦвета));

	Попытка
		ЧислоЦвета = Число(СтрокаЦвета);
	Исключение
		ЧислоЦвета = Неопределено;
	КонецПопытки;

	Если ЧислоЦвета <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Цвет = WebЦвета[СтрокаЦвета];
		Возврат Неопределено;
	Исключение
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не удалось определить цвет <%1>. Передайте число цвета или имя цвета, например 'Красный'."), СтрокаЦвета);
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, ИмяПараметра)

	Если MCPПараметрНеЗаданUIAutomation(Запрос, ИмяПараметра) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Число(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра))));

КонецФункции

&НаКлиенте
Функция MCPПараметрНеЗаданUIAutomation(Запрос, ИмяПараметра)

	Значение = ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра);
	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НЕ ЗначениеЗаполнено(СокрЛП(Строка(Значение)));

КонецФункции

&НаКлиенте
Функция MCPДопустимыеДействияUIAutomation()

	Возврат "'find_elements', 'get_element', 'get_children', 'get_parent', 'get_next', 'get_active', 'click', 'input_text', 'press_keys', 'mouse_wheel', 'move_cursor', 'effect'";

КонецФункции

&НаКлиенте
Функция MCPПроверитьКомпонентуUIAutomation()

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстСообщения = Ванесса.Локализовать("Для работы с UI Automation нужно в Vanessa Automation включить использование внешней компоненты VanessaExt.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если Ванесса.ВнешняяКомпонентаДляСкриншотов = Неопределено
		ИЛИ ТипЗнч(Ванесса.ВнешняяКомпонентаДляСкриншотов) = Тип("Строка") Тогда
		ТекстСообщения = Ванесса.Локализовать("Внешняя компонента VanessaExt не инициализирована. Перезапустите Vanessa Automation с включённой внешней компонентой.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция MCPРезультатUIAutomation(Успех, Текст = "", Код = "", Данные = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("Код", Код);
	Результат.Вставить("Данные", Данные);
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция MCPУспехUIAutomation(Текст = "", Данные = Неопределено)

	Возврат MCPРезультатUIAutomation(Истина, Текст, "", Данные);

КонецФункции

&НаКлиенте
Функция MCPОшибкаПараметровUIAutomation(ТекстСообщения)

	Возврат MCPРезультатUIAutomation(Ложь, ТекстСообщения, "INVALID_PARAMS");

КонецФункции

// Возвращает элемент UI Automation по идентификатору; MCP-результат с элементом в поле Данные
&НаКлиенте
Функция MCPЭлементПоИдентификаторуUIAutomation(Знач Идентификатор)

	Попытка
		ДанныеJSON = Ванесса.ВнешняяКомпонентаДляСкриншотов.ЭлементПоИдентификатору(Идентификатор);
	Исключение
		Возврат MCPРезультатUIAutomation(Ложь, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), "ACTION_FAILED");
	КонецПопытки;

	Элемент = MCPСтруктураИзJSONUIAutomation(ДанныеJSON);
	Если Элемент = Неопределено Тогда
		Возврат MCPРезультатUIAutomation(Ложь, Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Элемент UI Automation с Id <%1> не найден. Возможно, окно закрылось или изменилось — выполните поиск заново."), Идентификатор), "ACTION_FAILED");
	КонецЕсли;

	Возврат MCPРезультатUIAutomation(Истина, "", "", Элемент);

КонецФункции

&НаКлиенте
Функция MCPКоординатыUIAutomation(Элемент)

	Координаты = Ванесса.КоординатыЭлементаUIAutomation(Элемент);
	Если Координаты.Right < Координаты.Left ИЛИ Координаты.Bottom < Координаты.Top
		ИЛИ (Координаты.Left = 0 И Координаты.Top = 0 И Координаты.Right = 0 И Координаты.Bottom = 0) Тогда
		// Нулевые координаты у невидимого элемента: как в КликПоЭлементуБезПеремещенияМышкиUIAutomation
		Возврат Неопределено;
	КонецЕсли;

	Возврат Координаты;

КонецФункции

&НаКлиенте
Функция MCPОбластьИзПараметровUIAutomation(Запрос)

	Left = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "left");
	Top = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "top");

	ШиринаОбласти = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "width");
	Если ШиринаОбласти = Неопределено Тогда
		ШиринаОбласти = 0;
	КонецЕсли;

	ВысотаОбласти = MCPЧисловоеЗначениеПараметраUIAutomation(Запрос, "height");
	Если ВысотаОбласти = Неопределено Тогда
		ВысотаОбласти = 0;
	КонецЕсли;

	Возврат Новый Структура("Left, Top, Right, Bottom", Left, Top, Left + ШиринаОбласти, Top + ВысотаОбласти);

КонецФункции

&НаКлиенте
Функция MCPОтобратьЭлементыПоОкнуUIAutomation(Элементы, Знач ЗаголовокОкна)

	Результат = Новый Массив;
	НРегЗаголовок = НРег(СокрЛП(ЗаголовокОкна));

	Для Каждого Элемент Из Элементы Цикл
		ОкноЭлемента = MCPЗначениеПоляUIAutomation(Элемент, "Window");
		Если ОкноЭлемента = Неопределено ИЛИ Найти(НРег(Строка(ОкноЭлемента)), НРегЗаголовок) > 0 Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция MCPОтобратьЭлементыПоИмениИТипуUIAutomation(Элементы, Знач ИмяЭлемента, Знач ТипЭлемента)

	Результат = Новый Массив;
	НРегИмя = НРег(СокрЛП(ИмяЭлемента));
	НРегТип = НРег(СокрЛП(ТипЭлемента));

	Для Каждого Элемент Из Элементы Цикл
		Если ЗначениеЗаполнено(НРегИмя)
			И Найти(НРег(Строка(MCPЗначениеПоляUIAutomation(Элемент, "Name"))), НРегИмя) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(НРегТип)
			И Найти(НРег(Строка(MCPЗначениеПоляUIAutomation(Элемент, "Type"))), НРегТип) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция MCPСтруктураИзJSONUIAutomation(Знач ДанныеJSON)

	Данные = MCPДанныеИзJSONUIAutomation(ДанныеJSON);
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Возврат Данные;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция MCPДанныеИзJSONUIAutomation(Знач ДанныеJSON)

	Если НЕ ЗначениеЗаполнено(ДанныеJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Данные = Ванесса.ПрочитатьСтрокуJSON(ДанныеJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Данные;

КонецФункции

// Возвращает значение поля элемента UI Automation; регистр имени поля в JSON внешней компоненты непостоянен
&НаКлиенте
Функция MCPЗначениеПоляUIAutomation(Элемент, ИмяПоля)

	Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Варианты = Новый Массив;
	Варианты.Добавить(ИмяПоля);
	Варианты.Добавить(НРег(ИмяПоля));
	Варианты.Добавить(ВРег(Лев(ИмяПоля, 1)) + Сред(ИмяПоля, 2));

	Для Каждого Вариант Из Варианты Цикл
		Значение = Неопределено;
		Если Элемент.Свойство(Вариант, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция MCPТекстПоляЭлементаUIAutomation(Элемент, ИмяПоля)

	Значение = MCPЗначениеПоляUIAutomation(Элемент, ИмяПоля);
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=; ЧН=0");
	КонецЕсли;

	Возврат MCPЭкранироватьЯчейкуMarkdownUIAutomation(Строка(Значение));

КонецФункции

&НаКлиенте
Функция MCPЭкранироватьЯчейкуMarkdownUIAutomation(Знач Текст)

	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, "|", "\|");

	Возврат СокрЛП(Текст);

КонецФункции

&НаКлиенте
Функция MCPОписаниеЭлементаUIAutomation(Элемент, Заголовок)

	Строки = Новый Массив;
	Строки.Добавить("# " + Заголовок);
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("| Свойство | Значение |"));
	Строки.Добавить("|----------|----------|");

	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "Id", MCPЗначениеПоляUIAutomation(Элемент, "Id"));
	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "Name", MCPЗначениеПоляUIAutomation(Элемент, "Name"));
	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "Type", MCPЗначениеПоляUIAutomation(Элемент, "Type"));
	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "Value", MCPЗначениеПоляUIAutomation(Элемент, "Value"));
	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "HelpText", MCPЗначениеПоляUIAutomation(Элемент, "HelpText"));
	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "Window", MCPЗначениеПоляUIAutomation(Элемент, "Window"));
	MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, "ProcessId", MCPЗначениеПоляUIAutomation(Элемент, "ProcessId"));

	Координаты = MCPКоординатыUIAutomation(Элемент);
	Если Координаты = Неопределено Тогда
		MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, Ванесса.Локализовать("Координаты"), Ванесса.Локализовать("не определены (элемент невидим)"));
	Иначе
		MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, Ванесса.Локализовать("Координаты (Left, Top, Right, Bottom)"),
			Формат(Координаты.Left, "ЧГ=; ЧН=0") + ", " + Формат(Координаты.Top, "ЧГ=; ЧН=0") + ", "
			+ Формат(Координаты.Right, "ЧГ=; ЧН=0") + ", " + Формат(Координаты.Bottom, "ЧГ=; ЧН=0"));
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура MCPДобавитьСтрокуСвойстваЭлементаUIAutomation(Строки, ИмяСвойства, Значение)

	Если Значение = Неопределено Тогда
		ТекстЗначения = "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		ТекстЗначения = Формат(Значение, "ЧГ=; ЧН=0");
	Иначе
		ТекстЗначения = Строка(Значение);
	КонецЕсли;

	Строки.Добавить("| " + MCPЭкранироватьЯчейкуMarkdownUIAutomation(ИмяСвойства) + " | " + MCPЭкранироватьЯчейкуMarkdownUIAutomation(ТекстЗначения) + " |");

КонецПроцедуры

&НаКлиенте
Функция MCPСформироватьMarkdownСпискаЭлементовUIAutomation(ПоказанныеЭлементы, ВсегоНайдено, ДопПараметры)

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Элементы UI Automation"));
	Строки.Добавить("");
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("PID процесса: %1."), Формат(ДопПараметры.PID, "ЧГ=; ЧН=0")));

	Если ЗначениеЗаполнено(ДопПараметры.ИмяЭлемента) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Отбор по имени: %1."), ДопПараметры.ИмяЭлемента));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопПараметры.ТипЭлемента) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Отбор по типу: %1."), ДопПараметры.ТипЭлемента));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопПараметры.Подсказка) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Отбор по подсказке: %1."), ДопПараметры.Подсказка));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопПараметры.ЗаголовокОкна) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Отбор по окну (вхождение): %1."), ДопПараметры.ЗаголовокОкна));
	КонецЕсли;

	Если ДопПараметры.Лимит > 0 Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено: %1. Показано: %2 (лимит %3)."), ВсегоНайдено, ПоказанныеЭлементы.Количество(), ДопПараметры.Лимит));
	Иначе
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено: %1. Показано: %2."), ВсегоНайдено, ПоказанныеЭлементы.Количество()));
	КонецЕсли;

	Если ПоказанныеЭлементы.Количество() > 0 Тогда
		MCPДобавитьТаблицуЭлементовUIAutomation(Строки, ПоказанныеЭлементы);
	Иначе
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Элементы не найдены."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Если ВсегоНайдено > ПоказанныеЭлементы.Количество() Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Показаны не все элементы: увеличьте limit или уточните отбор."));
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Функция MCPСформироватьMarkdownДочернихЭлементовUIAutomation(ДочерниеЭлементы, ИдентификаторРодителя)

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Дочерние элементы UI Automation"));
	Строки.Добавить("");
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Родительский элемент: %1."), ИдентификаторРодителя));
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено: %1."), ДочерниеЭлементы.Количество()));

	Если ДочерниеЭлементы.Количество() = 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Дочерние элементы не найдены."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	MCPДобавитьТаблицуЭлементовUIAutomation(Строки, ДочерниеЭлементы);

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура MCPДобавитьТаблицуЭлементовUIAutomation(Строки, Элементы)

	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("| Id | Name | Type | Left | Top | Right | Bottom | HelpText |"));
	Строки.Добавить("|----|------|------|------|-----|-------|--------|----------|");

	Для Каждого Элемент Из Элементы Цикл
		Координаты = MCPКоординатыUIAutomation(Элемент);
		Если Координаты = Неопределено Тогда
			Left = "";
			Top = "";
			Right = "";
			Bottom = "";
		Иначе
			Left = Формат(Координаты.Left, "ЧГ=; ЧН=0");
			Top = Формат(Координаты.Top, "ЧГ=; ЧН=0");
			Right = Формат(Координаты.Right, "ЧГ=; ЧН=0");
			Bottom = Формат(Координаты.Bottom, "ЧГ=; ЧН=0");
		КонецЕсли;

		Строки.Добавить("| " + MCPТекстПоляЭлементаUIAutomation(Элемент, "Id") + " | "
			+ MCPТекстПоляЭлементаUIAutomation(Элемент, "Name") + " | "
			+ MCPТекстПоляЭлементаUIAutomation(Элемент, "Type") + " | "
			+ Left + " | " + Top + " | " + Right + " | " + Bottom + " | "
			+ MCPТекстПоляЭлементаUIAutomation(Элемент, "HelpText") + " |");
	КонецЦикла;

КонецПроцедуры

// Возвращает коды клавиш (VK) из строки сочетания, например "Ctrl+S"; MCP-результат с массивом кодов в поле Данные
&НаКлиенте
Функция MCPКодыКлавишИзСочетанияUIAutomation(Знач СочетаниеКлавиш)

	СоответствиеКлавиш = MCPСоответствиеКлавишUIAutomation();
	КодыКлавиш = Новый Массив;

	Для Каждого ЧастьСочетания Из Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(СочетаниеКлавиш, "+") Цикл
		ЧастьСочетания = ВРег(СокрЛП(ЧастьСочетания));
		КодКлавиши = СоответствиеКлавиш.Получить(ЧастьСочетания);
		Если КодКлавиши = Неопределено Тогда
			Возврат MCPОшибкаПараметровUIAutomation(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Не удалось определить код клавиши <%1>. Поддерживаются: Ctrl, Shift, Alt, буквы, цифры, F1-F12, ENTER, TAB, ESC, SPACE, BACKSPACE, DELETE, INSERT, HOME, END, PAGEUP, PAGEDOWN, стрелки."),
				ЧастьСочетания));
		КонецЕсли;
		КодыКлавиш.Добавить(КодКлавиши);
	КонецЦикла;

	Если КодыКлавиш.Количество() = 0 Тогда
		Возврат MCPОшибкаПараметровUIAutomation(Ванесса.Локализовать("Не удалось разобрать сочетание клавиш. Пример: 'Ctrl+S'."));
	КонецЕсли;

	Возврат MCPРезультатUIAutomation(Истина, "", "", КодыКлавиш);

КонецФункции

&НаКлиенте
Функция MCPСоответствиеКлавишUIAutomation()

	Клавиши = Новый Соответствие;
	Клавиши.Вставить("CTRL", 17);
	Клавиши.Вставить("CONTROL", 17);
	Клавиши.Вставить("SHIFT", 16);
	Клавиши.Вставить("ALT", 18);
	Клавиши.Вставить("ENTER", 13);
	Клавиши.Вставить("RETURN", 13);
	Клавиши.Вставить("TAB", 9);
	Клавиши.Вставить("ESC", 27);
	Клавиши.Вставить("ESCAPE", 27);
	Клавиши.Вставить("SPACE", 32);
	Клавиши.Вставить("BACKSPACE", 8);
	Клавиши.Вставить("BACK", 8);
	Клавиши.Вставить("DELETE", 46);
	Клавиши.Вставить("DEL", 46);
	Клавиши.Вставить("INSERT", 45);
	Клавиши.Вставить("INS", 45);
	Клавиши.Вставить("HOME", 36);
	Клавиши.Вставить("END", 35);
	Клавиши.Вставить("PAGEUP", 33);
	Клавиши.Вставить("PRIOR", 33);
	Клавиши.Вставить("PAGEDOWN", 34);
	Клавиши.Вставить("NEXT", 34);
	Клавиши.Вставить("LEFT", 37);
	Клавиши.Вставить("UP", 38);
	Клавиши.Вставить("RIGHT", 39);
	Клавиши.Вставить("DOWN", 40);

	Для КодКлавиши = 112 По 123 Цикл
		Клавиши.Вставить("F" + (КодКлавиши - 111), КодКлавиши);
	КонецЦикла;

	Для КодКлавиши = 65 По 90 Цикл
		Клавиши.Вставить(Символ(КодКлавиши), КодКлавиши);
	КонецЦикла;

	Для КодКлавиши = 48 По 57 Цикл
		Клавиши.Вставить(Символ(КодКлавиши), КодКлавиши);
	КонецЦикла;

	Возврат Клавиши;

КонецФункции

// Управляет системным буфером обмена (инструмент manage_clipboard)
&НаКлиенте
Функция УправлениеБуферомОбмена(Запрос, ДополнительныеПараметры) Экспорт

	ОшибкаКомпоненты = MCPПроверитьКомпонентуБуфераОбмена();
	Если ОшибкаКомпоненты <> Неопределено Тогда
		Возврат ОшибкаКомпоненты;
	КонецЕсли;

	Действие = ЗначениеПараметраИзЗапроса(Запрос, "action");
	Если Действие = Null ИЛИ Действие = Неопределено Тогда
		Действие = "";
	КонецЕсли;
	Действие = НРег(СокрЛП(Строка(Действие)));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: %1."), MCPДопустимыеДействияБуфераОбмена());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("MCPИдентификаторЗапроса", Запрос.Идентификатор);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);

	Если Действие = "set_text" Тогда
		Возврат MCPЗаписатьТекстВБуферОбмена(Запрос, ДопПараметры);
	ИначеЕсли Действие = "get_text" Тогда
		Возврат MCPПрочитатьТекстИзБуфераОбмена(ДопПараметры);
	ИначеЕсли Действие = "clear" Тогда
		Возврат MCPОчиститьБуферОбмена(ДопПараметры);
	КонецЕсли;

	ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Неизвестное значение параметра action: '%1'. Допустимые значения: %2."),
		Действие, MCPДопустимыеДействияБуфераОбмена());
	Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);

КонецФункции

// Помещает текст в буфер обмена (action='set_text' инструмента manage_clipboard)
&НаКлиенте
Функция MCPЗаписатьТекстВБуферОбмена(Запрос, ДопПараметры)

	ТекстБуфера = ЗначениеПараметраИзЗапроса(Запрос, "text");
	// MCP-клиент может передать null для неуказанного параметра, в 1С это Неопределено
	Если ТекстБуфера = Null ИЛИ ТекстБуфера = Неопределено Тогда
		ТекстБуфера = "";
	КонецЕсли;
	ТекстБуфера = Строка(ТекстБуфера);

	Если СтрДлина(ТекстБуфера) = 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр text обязателен и не может быть пустым. Для очистки буфера обмена используйте action='clear'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	МаксимальнаяДлинаТекста = 100000;
	Если СтрДлина(ТекстБуфера) > МаксимальнаяДлинаТекста Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Текст длиннее %1 символов."), МаксимальнаяДлинаТекста);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ДопПараметры.Вставить("ДлинаТекста", СтрДлина(ТекстБуфера));

	Оповещение = Новый ОписаниеОповещения("БуферОбменаТекстЗаписан", ЭтаФорма, ДопПараметры);
	Попытка
		Ванесса.БуферОбменаVA.НачатьВызовЗаписатьТекст(Оповещение, ТекстБуфера);
	Исключение
		MCPЗавершитьИнструментБуфераСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

