// Таблицы: set_cell_text
&НаКлиенте
Функция ВвестиТекстЯчейкиТаблицыMCP(ИмяТаблицы, ИмяЭлемента, Текст)
	Если Ванесса.ТекущийTestclientЭтоWebКлиент Тогда
		Возврат ОшибкаВебКлиента("set_cell_text");
	КонецЕсли;
	Таблица = Неопределено;
	Поле = Неопределено;
	Попытка
		// Колонка принимается заголовком или внутренним именем поля формы; поле проверяется
		// до входа в режим редактирования, чтобы не открывать строку впустую.
		СведенияОКолонке = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
		Таблица = СведенияОКолонке.Таблица;
		Если СведенияОКолонке.Колонка = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", СведенияОКолонке.ТекстОшибки);
		КонецЕсли;
		Поле = СведенияОКолонке.Колонка;
		ТекстОшибкиРежима = ОбеспечитьРежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы, Поле);
		Если ЗначениеЗаполнено(ТекстОшибкиРежима) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиРежима);
		КонецЕсли;
		Ванесса.ВОткрытойФормеВТЧВПолеСЗаголовкомЯВвожуТекст(ИмяТаблицы, Поле.Имя, Текст, Истина,
			Новый Структура("КоличествоПопыток", 1));
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В поле '%1' таблицы '%2' введён текст. Строка открыта на редактирование - при необходимости вызовите 'end_edit_row'."), ИмяЭлемента, ИмяТаблицы);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Если Таблица <> Неопределено Тогда
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		КонецЕсли;
		MCPДополнитьОшибкуПоСостояниюПоляMCP(Поле, ТекстОшибки, "",
			Ванесса.Локализовать("Колонка не принимает ввод прямо в ячейку (возможно, значение вводится через отдельный диалог или кнопку выбора). Выберите колонку, принимающую ввод, и не повторяйте действие с этой колонкой."));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
КонецФункции

// Таблицы: set_order
&НаКлиенте
Функция УстановитьПорядокТаблицыMCP(ИмяТаблицы, ИмяКолонки)
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		РезультатПоиска = НайтиКолонкуТаблицыMCP(Таблица, ИмяКолонки, ИмяТаблицы, Истина, Тип("ТестируемоеПолеФормы"));
		Колонка = РезультатПоиска.Колонка;
		Если Колонка = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				ТекстОшибкиКолонкаНеНайденаMCP(Таблица, ИмяКолонки, ИмяТаблицы, РезультатПоиска, Истина));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Колонка.ТекстЗаголовка) Тогда
			// Порядок устанавливается по заголовку, поэтому у колонки без заголовка это невозможно.
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("В таблице '%1' у колонки '%2' не заполнен заголовок, а порядок устанавливается по заголовку колонки. Укажите колонку с заголовком."), ИмяТаблицы, Колонка.Имя);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		Попытка
			Таблица.УстановитьПорядок(Колонка.ТекстЗаголовка);
		Исключение
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Не удалось установить порядок по колонке '%2' таблицы '%1':"), ИмяТаблицы, Колонка.ТекстЗаголовка)
				+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()) + Символы.ПС
				+ Ванесса.Локализовать("Возможно, сортировка этим методом работает с таблицами-списками (динамическими списками), а не с табличными частями документов.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В таблице '%1' установлен порядок по колонке '%2'."), ИмяТаблицы, Колонка.ТекстЗаголовка);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Ищет колонку таблицы: по внутреннему имени, затем по заголовку; при РазрешитьИмяРеквизитаТЧ = Истина
// дополнительно по имени реквизита ТЧ из метаданных (имя поля формы длиннее на имя таблицы).
// ТипКандидата ограничивает кандидатов одним типом объектов таблицы (Неопределено - без ограничения).
// Возвращает структуру: Колонка (найденная колонка или Неопределено) и Варианты
// (объекты-кандидаты, когда совпадений несколько).
&НаКлиенте
Функция НайтиКолонкуТаблицыMCP(Таблица, ИмяИлиЗаголовок, ИмяТаблицы, РазрешитьИмяРеквизитаТЧ = Ложь, ТипКандидата = Неопределено)
	Результат = Новый Структура("Колонка, Варианты", Неопределено, Неопределено);
	Если НЕ ЗначениеЗаполнено(ИмяИлиЗаголовок) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Колонка = Таблица.НайтиОбъект(, , ИмяИлиЗаголовок);
		Если Колонка <> Неопределено И (ТипКандидата = Неопределено ИЛИ ТипЗнч(Колонка) = ТипКандидата) Тогда
			Результат.Колонка = Колонка;
			Возврат Результат;
		КонецЕсли;
	Исключение
		// Форма вызова НайтиОбъект(, , Имя) может быть не поддержана - уходим в обход полей
	КонецПопытки;

	// Перебор объектов таблицы: подходит объект типа ТипКандидата (Неопределено - любого типа),
	// у которого совпали имя или заголовок.
	ИскомоеЗначение = НРег(СокрЛП(ИмяИлиЗаголовок));
	Варианты = Новый Массив;
	ОбъектыТаблицы = Неопределено;
	Попытка
		ОбъектыТаблицы = Таблица.НайтиОбъекты();
	Исключение
		// Перебор объектов недоступен - работаем по первой стадии
	КонецПопытки;
	Если ОбъектыТаблицы <> Неопределено Тогда
		Для Каждого ТекОбъект Из ОбъектыТаблицы Цикл
			Если ТипКандидата <> Неопределено И ТипЗнч(ТекОбъект) <> ТипКандидата Тогда
				Продолжить;
			КонецЕсли;
			ТекИмя = Неопределено;
			ТекЗаголовок = Неопределено;
			Попытка
				ТекИмя = ТекОбъект.Имя;
			Исключение
				Продолжить;
			КонецПопытки;
			Если ТипЗнч(ТекИмя) <> Тип("Строка") Тогда
				// Колонка без имени не пригодна для шагов: они ищут поле по имени
				Продолжить;
			КонецЕсли;
			Если НРег(СокрЛП(ТекИмя)) = ИскомоеЗначение Тогда
				Результат.Колонка = ТекОбъект;
				Возврат Результат;
			КонецЕсли;
			Попытка
				ТекЗаголовок = ТекОбъект.ТекстЗаголовка;
			Исключение
				ТекЗаголовок = Неопределено;
			КонецПопытки;
			Если ТипЗнч(ТекЗаголовок) = Тип("Строка") И ЗначениеЗаполнено(ТекЗаголовок) Тогда
				Если НРег(СокрЛП(ТекЗаголовок)) = ИскомоеЗначение Тогда
					Варианты.Добавить(ТекОбъект);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Варианты.Количество() = 1 Тогда
		Результат.Колонка = Варианты[0];
		Возврат Результат;
	ИначеЕсли Варианты.Количество() > 1 Тогда
		Результат.Варианты = Варианты;
		Возврат Результат;
	КонецЕсли;

	Если НЕ РазрешитьИмяРеквизитаТЧ Тогда
		Возврат Результат;
	КонецЕсли;

	// Третья стадия: агент может передать имя реквизита ТЧ из метаданных, тогда как
	// имя поля формы длиннее на имя таблицы (ИмяТаблицы + ИмяРеквизита).
	Попытка
		ОжидаемоеИмяПоля = НРег(СокрЛП(ИмяТаблицы) + СокрЛП(ИмяИлиЗаголовок));
		ИскомоеИмя = НРег(СокрЛП(ИмяИлиЗаголовок));
		ТочноеСовпадение = Неопределено;
		СовпаденияПоХвосту = Новый Массив;
		Для Каждого ТекОбъект Из Таблица.НайтиОбъекты() Цикл
			Если ТипКандидата <> Неопределено И ТипЗнч(ТекОбъект) <> ТипКандидата Тогда
				Продолжить;
			КонецЕсли;
			ТекИмя = Неопределено;
			Попытка
				ТекИмя = ТекОбъект.Имя;
			Исключение
				Продолжить;
			КонецПопытки;
			Если ТипЗнч(ТекИмя) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			ТекИмяНорм = НРег(СокрЛП(ТекИмя));
			Если ТекИмяНорм = ОжидаемоеИмяПоля Тогда
				ТочноеСовпадение = ТекОбъект;
				Прервать;
			ИначеЕсли Прав(ТекИмяНорм, СтрДлина(ИскомоеИмя)) = ИскомоеИмя Тогда
				СовпаденияПоХвосту.Добавить(ТекОбъект);
			КонецЕсли;
		КонецЦикла;
		Если ТочноеСовпадение <> Неопределено Тогда
			Результат.Колонка = ТочноеСовпадение;
		ИначеЕсли СовпаденияПоХвосту.Количество() = 1 Тогда
			Результат.Колонка = СовпаденияПоХвосту[0];
		ИначеЕсли СовпаденияПоХвосту.Количество() > 1 Тогда
			Результат.Варианты = СовпаденияПоХвосту;
		КонецЕсли;
	Исключение
		// Перебор полей не удался - работаем без третьей стадии
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Находит таблицу и колонку для табличных действий. Колонка принимается заголовком
// или внутренним именем поля формы; кандидаты ограничены полями таблицы (ТестируемоеПолеФормы) -
// действия-ячейки работают только с полями.
// Возвращает структуру: Колонка, Таблица и ТекстОшибки (заполнен, если найти не удалось).
&НаКлиенте
Функция НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяКолонки)
	Результат = Новый Структура("Колонка, Таблица, ТекстОшибки", Неопределено, Неопределено, "");
	Попытка
		Результат.Таблица = НайтиТаблицуБезИсключенияMCP(ИмяТаблицы);
	Исключение
		// Исключение поиска таблицы возвращаем текстом, чтобы вызывающий код не ловил его сам
		Результат.ТекстОшибки = Ванесса.Локализовать("Не удалось найти таблицу:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	Если Результат.Таблица = Неопределено Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' не найдена."), ИмяТаблицы);
		ДополнитьОшибку_НетТаблицыMCP(ТекстОшибки);
		Результат.ТекстОшибки = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Попытка
		РезультатПоиска = НайтиКолонкуТаблицыMCP(Результат.Таблица, ИмяКолонки, ИмяТаблицы, Ложь, Тип("ТестируемоеПолеФормы"));
	Исключение
		Результат.ТекстОшибки = Ванесса.Локализовать("Не удалось найти колонку:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	Если РезультатПоиска.Колонка = Неопределено Тогда
		Результат.ТекстОшибки = ТекстОшибкиКолонкаНеНайденаMCP(Результат.Таблица, ИмяКолонки, ИмяТаблицы, РезультатПоиска);
		Возврат Результат;
	КонецЕсли;
	Результат.Колонка = РезультатПоиска.Колонка;
	Возврат Результат;
КонецФункции

// Собирает текст ошибки для ненайденной колонки таблицы: при нескольких совпадениях - список
// вариантов, иначе - "не найдена" со списком доступных колонок и формами имени.
&НаКлиенте
Функция ТекстОшибкиКолонкаНеНайденаMCP(Таблица, ИмяИлиЗаголовок, ИмяТаблицы, РезультатПоиска, РазрешитьИмяРеквизитаТЧ = Ложь)
	Если РезультатПоиска.Варианты <> Неопределено Тогда
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В таблице '%1' значению '%2' соответствуют несколько колонок. Укажите внутреннее имя поля формы:"), ИмяТаблицы, ИмяИлиЗаголовок));
		Для Каждого ТекКолонка Из РезультатПоиска.Варианты Цикл
			ПредставлениеКолонки = ТекКолонка.Имя;
			ТекстЗаголовкаВарианта = Неопределено;
			Попытка
				ТекстЗаголовкаВарианта = ТекКолонка.ТекстЗаголовка;
			Исключение
				ТекстЗаголовкаВарианта = Неопределено;
			КонецПопытки;
			Если ТипЗнч(ТекстЗаголовкаВарианта) = Тип("Строка") И ЗначениеЗаполнено(ТекстЗаголовкаВарианта) Тогда
				ПредставлениеКолонки = ПредставлениеКолонки + " (" + ТекстЗаголовкаВарианта + ")";
			КонецЕсли;
			Строки.Добавить("- " + ПредставлениеКолонки);
		КонецЦикла;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	Если РазрешитьИмяРеквизитаТЧ Тогда
		ФормыИмени = Ванесса.Локализовать("Принимаются три формы имени: имя реквизита табличной части, полное имя поля формы (имя таблицы + имя реквизита) или заголовок колонки.");
	Иначе
		ФормыИмени = Ванесса.Локализовать("Принимаются две формы имени: внутреннее имя поля формы (например, ТоварыКоличество) или заголовок колонки.");
	КонецЕсли;
	ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("В таблице '%1' не найдена колонка '%2'. %3"), ИмяТаблицы, ИмяИлиЗаголовок, ФормыИмени);
	СписокКолонок = СписокКолонокТаблицыMCP(Таблица);
	Если ЗначениеЗаполнено(СписокКолонок) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС
			+ Ванесса.Локализовать("Доступные колонки: ") + MCPСократитьТекстДляОтвета(СписокКолонок, 300);
	КонецЕсли;
	Возврат ТекстОшибки;
КонецФункции

// Возвращает список колонок (полей) таблицы одной строкой в виде "Имя (Заголовок)" (для текста ошибки).
&НаКлиенте
Функция СписокКолонокТаблицыMCP(Таблица)
	Колонки = Новый Массив;
	Попытка
		Для Каждого ТекОбъект Из Таблица.НайтиОбъекты() Цикл
			Если ТипЗнч(ТекОбъект) <> Тип("ТестируемоеПолеФормы") Тогда
				Продолжить;
			КонецЕсли;
			ТекИмя = Неопределено;
			ТекЗаголовок = Неопределено;
			Попытка
				ТекИмя = ТекОбъект.Имя;
				ТекЗаголовок = ТекОбъект.ТекстЗаголовка;
			Исключение
				Продолжить;
			КонецПопытки;
			Если ТипЗнч(ТекИмя) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(ТекЗаголовок) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекЗаголовок) Тогда
				Продолжить;
			КонецЕсли;
			Колонки.Добавить(ТекИмя + " (" + ТекЗаголовок + ")");
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Ванесса._СтрСоединить(Колонки, ", ");
КонецФункции

// Таблицы: switch_row_delete_mark
&НаКлиенте
Функция ПереключитьПометкуУдаленияMCP(ИмяТаблицы)
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		Таблица.ПереключитьПометкуУдаленияСтроки();
		ОкноВопроса = Ванесса.НайтиОкноМодальногоДиалога(Истина);
		Если ОкноВопроса <> Неопределено Тогда
			// Автоматически отвечаем "Да" только на вопрос самой платформы о пометке удаления
			ТекстВопроса = Ванесса.ПолучитьТекстПредупреждения();
			Если НЕ ЗначениеЗаполнено(ТекстВопроса) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
					Ванесса.Локализовать("Появился модальный вопрос, текст которого не удалось прочитать. Ответьте на него в клиенте вручную и повторите действие."));
			КонецЕсли;
			Если НЕ Ванесса.ЭтоТекстДиалогаПредлагающегоПометитьЭлементНаУдаление(ТекстВопроса)
				И НЕ Ванесса.ЭтоТекстДиалогаПредлагающегоСнятьПометкуУдаления(ТекстВопроса) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
					Ванесса.ПодставитьПараметрыВСтроку(
						Ванесса.Локализовать("Появился модальный вопрос '%1'. Ответьте на него в клиенте вручную и повторите действие."), ТекстВопроса));
			КонецЕсли;
			КнопкаДа = ОкноВопроса.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Да");
			Если КнопкаДа = Неопределено Тогда
				КнопкаДа = ОкноВопроса.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Yes");
			КонецЕсли;
			Если КнопкаДа = Неопределено Тогда
				Строки = Новый Массив;
				Строки.Добавить(Ванесса.Локализовать("Появился модальный вопрос, который не удалось подтвердить автоматически. Ответьте на него вручную."));
				MCPVAСлужебныйМодуль.ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноВопроса);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса._СтрСоединить(Строки, Символы.ПС));
			КонецЕсли;
			Попытка
				КнопкаДа.Нажать();
			Исключение
				ТекстОшибки = Ванесса.Локализовать("Не удалось подтвердить модальный вопрос автоматически:")
					+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
				Если Ванесса.НайтиОкноМодальногоДиалога(Истина) <> Неопределено Тогда
					ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса.Локализовать("Модальный вопрос всё ещё открыт - ответьте на него в клиенте вручную.");
				КонецЕсли;
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецПопытки;
			Ванесса.ОбработатьСменуАктивногоОкна();
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В таблице '%1' переключена пометка удаления текущей строки."), ИмяТаблицы);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

