		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Значение поля '%1' увеличено."), ИмяЭлемента);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Поля и группы: goto_value
&НаКлиенте
Функция ПерейтиКЗначениюПолосыMCP(ИмяЭлемента, Процент)
	Если Процент = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Для действия 'goto_value' необходимо указать параметр percent."));
	КонецЕсли;
	Попытка
		Если Процент < 0 ИЛИ Процент > 100 Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.Локализовать("Параметр percent должен быть в диапазоне 0-100."));
		КонецЕсли;
		Поле = НайтиПолеMCP(ИмяЭлемента, Тип("ТестируемоеПолеФормы"));
		Если Поле.Вид <> ВидПоляФормы.ПолеПолосыРегулирования Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Элемент '%1' не является полосой регулирования."), ИмяЭлемента));
		КонецЕсли;
		Поле.Активизировать();
		Поле.ПерейтиКЗначению(Процент);
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Полоса регулирования '%1' установлена на %2%."), ИмяЭлемента, Процент);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Форма: current_modified
&НаКлиенте
Функция ПолучитьМодифицированностьФормыMCP()
	Попытка
		ФормаТестовая = Ванесса.НайтиТекущуюФормуTestClient();
		Модифицированность = ФормаТестовая.ТекущаяМодифицированность();
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Активная форма модифицирована: %1"),
			MCPПредставлениеЗначенияДляMarkdown(Модифицированность));
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Форма: execute_choice_from_menu
&НаКлиенте
Функция ВыполнитьВыборИзМенюMCP(ПутьМеню)
