&НаКлиенте
Функция УправлениеЭлементамиФормыСлужебный(Запрос, ДополнительныеПараметры, ПодавитьДанныеОбОкне = Ложь)
	// Получаем параметр action (обязательный)
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: 'click_button', 'input_text', 'open_dropdown', 'get_dropdown_state', 'select_from_dropdown', 'set_value', 'open_choice_form', 'set_radio_button', 'set_checkbox', 'unset_checkbox', 'toggle_checkbox', 'click_hyperlink', 'simulate_tab', 'activate_column', 'navigate_next_column', 'navigate_previous_column', 'start_edit_row', 'end_edit_row', 'navigate_to_row', 'navigate_next_row', 'navigate_previous_row', 'select_row', 'get_selected_rows', 'create_new', 'switch_tab', 'toggle_group', 'activate_header_element', 'clear_field', 'clear_message_window', 'select_from_form_dropdown'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр element_name (обязательный для большинства действий)
	ИмяЭлемента = Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_name"));
	
	// Получаем параметр table_name (необязательный)
	ИмяТаблицы = Строка(ЗначениеПараметраИзЗапроса(Запрос, "table_name"));
	
	// Получаем параметр value (необязательный)
	Значение = Строка(ЗначениеПараметраИзЗапроса(Запрос, "value"));
	
	ЗначениеПереходаКСтроке = Строка(ЗначениеПараметраИзЗапроса(Запрос, "row_criteria"));
	
	// Получаем параметр hyperlink_title (необязательный)
	ЗаголовокГиперссылки = Строка(ЗначениеПараметраИзЗапроса(Запрос, "hyperlink_title"));
	Если НЕ ЗначениеЗаполнено(ЗаголовокГиперссылки) Тогда
		ЗаголовокГиперссылки = Неопределено;
	КонецЕсли;	
	
	// Получаем параметр hyperlink_index (необязательный)
	Попытка
		ИндексГиперссылки = ЗначениеПараметраИзЗапроса(Запрос, "hyperlink_index");
		Если ИндексГиперссылки <> Неопределено Тогда
			ИндексГиперссылки = Число(ИндексГиперссылки);
		КонецЕсли;
	Исключение
		ИндексГиперссылки = Неопределено;
	КонецПопытки;
	
	// Получаем параметр tab_direction (необязательный)
	НаправлениеПерехода = Строка(ЗначениеПараметраИзЗапроса(Запрос, "tab_direction"));
	Если НЕ ЗначениеЗаполнено(НаправлениеПерехода) Тогда
		НаправлениеПерехода = "next";
	КонецЕсли;
	
	// Получаем параметр exact_match (необязательный)
	ТочноеСовпадение = ЗначениеПараметраИзЗапроса(Запрос, "exact_match");
	Если ТочноеСовпадение = Неопределено Тогда
		ТочноеСовпадение = Ложь;
	Иначе
		Попытка
			ТочноеСовпадение = Булево(ТочноеСовпадение);
		Исключение
			ТочноеСовпадение = Ложь;
		КонецПопытки;
	КонецЕсли;

	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	Идентификатор = Запрос.Идентификатор;
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
	
	// Выполняем действие в зависимости от параметра action
	Если Действие = "click_button" Тогда
		Результат = НажатьКнопкуФормы(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "input_text" Тогда
		Результат = ВвестиТекстВПоле(ИмяЭлемента, Значение, ИмяТаблицы);
	ИначеЕсли Действие = "open_dropdown" Тогда
		Результат = ОткрытьВыпадающийСписок(ИмяЭлемента, ИмяТаблицы, Истина);
	ИначеЕсли Действие = "get_dropdown_state" Тогда
		Результат = ОткрытьВыпадающийСписок(ИмяЭлемента, ИмяТаблицы, Ложь);
	ИначеЕсли Действие = "select_from_dropdown" Тогда
		Результат = ВыбратьИзВыпадающегоСписка(ИмяЭлемента, Значение, ИмяТаблицы);
	ИначеЕсли Действие = "set_value" Тогда
		Результат = УстановитьЗначениеВПоле(ИмяЭлемента, Значение, ИмяТаблицы, ТочноеСовпадение);
	ИначеЕсли Действие = "open_choice_form" Тогда
		Результат = ОткрытьФормуВыбора(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "set_radio_button" Тогда
		Результат = УстановитьПереключатель(ИмяЭлемента, Значение);
	ИначеЕсли Действие = "set_checkbox" Тогда
		Результат = УстановитьФлаг(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "unset_checkbox" Тогда
		Результат = СнятьФлаг(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "toggle_checkbox" Тогда
		Результат = ПереключитьФлаг(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "click_hyperlink" Тогда
		Результат = НажатьГиперссылку(ИмяЭлемента, ЗаголовокГиперссылки, ИндексГиперссылки);
	ИначеЕсли Действие = "simulate_tab" Тогда
		Результат = ЭмуляцияПереходаTAB(НаправлениеПерехода);
	ИначеЕсли Действие = "activate_column" Тогда
		Результат = АктивизироватьКолонкуТаблицы(ИмяТаблицы, Значение);
	ИначеЕсли Действие = "navigate_next_column" Тогда
		Результат = ПереходКСледующейКолонке(ИмяТаблицы);
	ИначеЕсли Действие = "navigate_previous_column" Тогда
		Результат = ПереходКПредыдущейКолонке(ИмяТаблицы);
	ИначеЕсли Действие = "start_edit_row" Тогда
		Результат = НачатьРедактированиеСтроки(ИмяТаблицы);
	ИначеЕсли Действие = "end_edit_row" Тогда
		Результат = ЗакончитьРедактированиеСтроки(ИмяТаблицы);
	ИначеЕсли Действие = "navigate_to_row" Тогда
		Результат = ПереходКСтрокеТаблицы(ИмяТаблицы, ЗначениеПереходаКСтроке);
	ИначеЕсли Действие = "navigate_next_row" Тогда
		Результат = ПереходКСледующейСтрокеТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "navigate_previous_row" Тогда
		Результат = ПереходКПредыдущейСтрокеТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "select_row" Тогда
		Результат = ВыбратьСтрокуТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "get_selected_rows" Тогда
		Результат = ПолучитьВыделенныеСтрокиТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "create_new" Тогда
		Результат = СоздатьНовый(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "switch_tab" Тогда
		Результат = ПереключитьсяНаЗакладку(ИмяЭлемента);
	ИначеЕсли Действие = "toggle_group" Тогда
		Результат = РазвернутьСвернутьГруппу(ИмяЭлемента, Значение);
	ИначеЕсли Действие = "activate_header_element" Тогда
		Результат = АктивизироватьЭлементШапки(ИмяЭлемента);
	ИначеЕсли Действие = "clear_field" Тогда
		Результат = ОчиститьПоле(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "clear_message_window" Тогда
		Результат = ОчиститьОкноСообщенийПользователю();
	ИначеЕсли Действие = "select_from_form_dropdown" Тогда
		Результат = ВыбратьИзСпискаВыбораФормы(Значение);
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Неизвестное действие: ") + Действие + ". " + Ванесса.Локализовать("Допустимые: 'click_button', 'input_text', 'open_dropdown', 'get_dropdown_state', 'select_from_dropdown', 'set_value', 'open_choice_form', 'set_radio_button', 'set_checkbox', 'unset_checkbox', 'toggle_checkbox', 'click_hyperlink', 'simulate_tab', 'activate_column', 'navigate_next_column', 'navigate_previous_column', 'start_edit_row', 'end_edit_row', 'navigate_to_row', 'navigate_next_row', 'navigate_previous_row', 'select_row', 'get_selected_rows', 'create_new', 'switch_tab', 'toggle_group', 'activate_header_element', 'clear_field', 'clear_message_window', 'select_from_form_dropdown'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Если НЕ ПодавитьДанныеОбОкне Тогда
			Результат = ДобавитьВСообщениеДанныеОбАктивномОкне(Результат);
		КонецЕсли;
		Возврат Результат;
	Иначе	
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ДополнениеОшибокMCP

&НаКлиенте
Процедура ДополнитьОшибку_НетПоляТаблицыMCP(Таблица, ТекстОшибки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ванесса.ИдентификаторЗадачиMCP()) Тогда
		Возврат;
	КонецЕсли;
	
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка = Ванесса.Локализовать("## Поля таблицы. Имя поля и заголовок поля:");
	Если Найти(ТекстОшибки, СтрокаЗаголовка) > 0 Тогда
		// Значит уже происходило дополнение текста ошибки.
		Возврат;
	КонецЕсли;
	
