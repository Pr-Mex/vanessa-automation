// Регистрирует один инструмент MCP по его описанию.
&НаКлиенте
Процедура MCPЗарегистрироватьИнструментПоОписанию(ПараметрыСозданияMCP, Описание)

	Свойства = Новый Структура;
	ТребуемыеПоля = Новый Массив;

	Для Каждого Свойство Из Описание.Свойства Цикл
		Свойства.Вставить(Свойство.Имя, ПараметрыСозданияMCP.МодульМсп_СхемаПараметров.НовыйСвойствоСхемы(Свойство.Тип, Ванесса.Локализовать(Свойство.Описание)));
		Если Свойство.Обязательный Тогда
			ТребуемыеПоля.Добавить(Свойство.Имя);
		КонецЕсли;
	КонецЦикла;

	Схема = ПараметрыСозданияMCP.МодульМсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, ТребуемыеПоля);

	Если Описание.Асинхронный = Неопределено Тогда
		Инструмент = ПараметрыСозданияMCP.МодульМсп_Сервер.НовыйИнструмент(
			Описание.Имя,
			Ванесса.Локализовать(Описание.Описание),
			Схема,
			Новый ОписаниеОповещения(Описание.Хендлер, Вычислить("ЭтотОбъект")));
	Иначе
		Инструмент = ПараметрыСозданияMCP.МодульМсп_Сервер.НовыйИнструмент(
			Описание.Имя,
			Ванесса.Локализовать(Описание.Описание),
			Схема,
			Новый ОписаниеОповещения(Описание.Хендлер, Вычислить("ЭтотОбъект")),
			Описание.Асинхронный);
	КонецЕсли;

	ПараметрыСозданияMCP.МодульМсп_Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

