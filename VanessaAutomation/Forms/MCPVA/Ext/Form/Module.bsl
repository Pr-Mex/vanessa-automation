Функция MCPПолучитьСодержимоеВкладки(Запрос)
	
	Найденная = MCPНайтиВкладкуПоСелектору(Запрос, "get_tab_content");
	Если НЕ Найденная.Успех Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента(Найденная.Код, Найденная.Текст);
	КонецЕсли;
	
	Ограничение = MCPНеотрицательноеЧислоИзЗапроса(Запрос, "maxLength", 20000);
	Если НЕ Ограничение.Успех Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ограничение.Текст);
	КонецЕсли;
	
	Индекс = Найденная.Индекс;
	Описание = Найденная.Описание;
	Вкладка = Неопределено;
	Попытка
		Вкладка = Ванесса.VanessaTabs.tab(Индекс);
	Исключение
		Вкладка = Неопределено;
	КонецПопытки;
	Если Вкладка = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Вкладка недоступна."));
	КонецЕсли;
	
	Текст = Неопределено;
	Попытка
		Текст = Вкладка.model.getValue();
	Исключение
		Текст = Неопределено;
	КонецПопытки;
	Если Текст = Неопределено ИЛИ Текст = Null Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Текст вкладки недоступен: модель редактора не найдена."));
	КонецЕсли;
	Текст = Строка(Текст);
	ИсходнаяДлина = СтрДлина(Текст);
	Максимум = Цел(Ограничение.Значение);
	Показано = "";
	Если Максимум > 0 И ИсходнаяДлина > Максимум Тогда
		Текст = Лев(Текст, Максимум);
		Показано = " (показано " + Формат(Максимум, "ЧГ=0; ЧН=0") + " из " + Формат(ИсходнаяДлина, "ЧГ=0; ЧН=0") + ")";
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить("# Содержимое вкладки");
	Строки.Добавить("");
	Строки.Добавить("- Вкладка: " + MCPСтрокаВкладкиMarkdown(Описание));
	Строки.Добавить("- Символов: " + Формат(ИсходнаяДлина, "ЧГ=0; ЧН=0") + Показано);
	Строки.Добавить("");
	Если Описание.Вид = "edit" И Прав(НРег(Описание.ИмяФайла), 8) = ".feature" Тогда
		Строки.Добавить("```gherkin");
	Иначе
		Строки.Добавить("```");
	КонецЕсли;
	Если ЗначениеЗаполнено(Текст) Тогда
		Строки.Добавить(Текст);
	Иначе
		Строки.Добавить("(пустой документ)");
	КонецЕсли;
	Строки.Добавить("```");
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция MCPНеотрицательноеЧислоИзЗапроса(Запрос, ИмяПараметра, ЗначениеПоУмолчанию)
	
	Результат = Новый Структура("Успех, Значение, Текст", Истина, ЗначениеПоУмолчанию, "");
	Значение = MCPVAСлужебныйМодуль.ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра);
	Если Значение = Неопределено ИЛИ Значение = Null ИЛИ Значение = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ТекстЗначения = СокрЛП(Значение);
		ДопустимыеСимволы = "0123456789+-.,";
		Для ПозицияСимвола = 1 По СтрДлина(ТекстЗначения) Цикл
			Если Найти(ДопустимыеСимволы, Сред(ТекстЗначения, ПозицияСимвола, 1)) = 0 Тогда
				Результат.Успех = Ложь;
				Результат.Текст = Ванесса.Локализовать("Параметр") + " " + ИмяПараметра + " " + Ванесса.Локализовать("должен быть неотрицательным целым числом.");
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		ЧислоЗначение = Число(Значение);
	Исключение
		Результат.Успех = Ложь;
		Результат.Текст = Ванесса.Локализовать("Параметр") + " " + ИмяПараметра + " " + Ванесса.Локализовать("должен быть неотрицательным целым числом.");
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(Значение) = Тип("Булево") ИЛИ ЧислоЗначение < 0 ИЛИ Цел(ЧислоЗначение) <> ЧислоЗначение Тогда
		Результат.Успех = Ложь;
		Результат.Текст = Ванесса.Локализовать("Параметр") + " " + ИмяПараметра + " " + Ванесса.Локализовать("должен быть неотрицательным целым числом.");
		Возврат Результат;
	КонецЕсли;
	Результат.Значение = ЧислоЗначение;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPСохранитьВкладку(Запрос)
	
	Найденная = MCPНайтиВкладкуПоСелектору(Запрос, "save_tab");
	Если НЕ Найденная.Успех Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента(Найденная.Код, Найденная.Текст);
	КонецЕсли;
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона."));
	КонецЕсли;
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
	КонецЕсли;
	
	Описание = Найденная.Описание;
	Если Описание.Вид <> "edit" Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Сохранять можно только edit-вкладку."));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Описание.ИмяФайла) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Вкладка не связана с файлом на диске."));
	КонецЕсли;
	Попытка
		Если Ванесса.МодульРедакторТекста().ИмяФайлаСоответствуетПустойНовойРедактора(Описание.ИмяФайла) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Вкладка не связана с файлом на диске."));
		КонецЕсли;
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	Вкладка = Неопределено;
	Попытка
		Вкладка = Ванесса.VanessaTabs.tab(Найденная.Индекс);
	Исключение
		Вкладка = Неопределено;
	КонецПопытки;
	Если Вкладка = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Вкладка недоступна."));
	КонецЕсли;
	
	Изменена = Истина;
	Попытка
		Изменена = Ванесса.МодульРедакторТекста().ВкладкаИзмененаРедактора(Вкладка);
	Исключение
		Изменена = Истина;
	КонецПопытки;
	Если НЕ Изменена Тогда
		Возврат "# Вкладка не изменена" + Символы.ПС + "- Сохранение не требуется.";
	КонецЕсли;
	
	Попытка
		Ванесса.МодульРедакторТекста().СохранитьИзмененияОднойВкладкиРедактора(Вкладка);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось сохранить вкладку:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	Изменена = Истина;
	Попытка
		Изменена = Ванесса.МодульРедакторТекста().ВкладкаИзмененаРедактора(Вкладка);
	Исключение
		Изменена = Истина;
	КонецПопытки;
	Если Изменена Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("После сохранения вкладка осталась изменённой."));
	КонецЕсли;
	
	MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.Сохранение",
		Новый Структура("Индекс, Файл", Найденная.Индекс, Описание.ИмяФайла));
	Возврат "# Вкладка сохранена" + Символы.ПС + "- Файл: " + MCPЗначениеДляMarkdown(Описание.ИмяФайла);
	
КонецФункции

