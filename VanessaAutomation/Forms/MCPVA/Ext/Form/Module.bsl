// Имя элемента формы из текста ошибки вида "Элемент формы <Имя> не найден." (первое <...> в тексте).
Функция MCPИмяЭлементаИзТекстаОшибки(ТекстОшибки)
	
	НачалоИмени = Найти(ТекстОшибки, "<");
	Если НачалоИмени = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(ТекстОшибки, НачалоИмени + 1);
	КонецИмени = Найти(Остаток, ">");
	Если КонецИмени = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(Остаток, 1, КонецИмени - 1);
	
