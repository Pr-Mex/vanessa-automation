&НаКлиенте
Процедура ЗавершитьПроверкуСинтаксиса(ПутьКФайлу, ДопПараметрыВызоваMCP = Неопределено)
	
	Идентификатор = Неопределено;
	Если ДопПараметрыВызоваMCP <> Неопределено И ТипЗнч(ДопПараметрыВызоваMCP) = Тип("Структура") Тогда
		ДопПараметрыВызоваMCP.Свойство("Идентификатор", Идентификатор);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = Ванесса.ПолучитьИдентификаторЗадачиMCP();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.НетИдентификатора", Новый Структура("Файл", ПутьКФайлу));
		Возврат;
	КонецЕсли;
	
	Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
	
	// Читаем найденные проблемы
	МассивПроблем = ПреобразоватьПроблемыПроверкиСинтаксиса(Проблемы);
	ПроверяемыйФайл = MCPПроверяемыйФайлИзДопПараметров(ПутьКФайлу, ДопПараметрыВызоваMCP);

	// Проверка оставляет проверяемый файл текущим: фиксируем фактическое состояние вкладок,
	// но не закрываем вкладки и не возвращаем прежний каталог фич.
	СостояниеВкладок = MCPСостояниеВкладокПослеПроверкиСинтаксиса(ПутьКФайлу, ДопПараметрыВызоваMCP);
	
	Результат = Новый Структура;
	Результат.Вставить("valid", МассивПроблем.Количество() = 0);
	Результат.Вставить("problemCount", МассивПроблем.Количество());
	Результат.Вставить("problems", МассивПроблем);
	Результат.Вставить("filePath", ПроверяемыйФайл);
	Результат.Вставить("editorState", СостояниеВкладок);
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	СтрокаРезультат = MCPСформироватьMarkdownПроверкиСинтаксиса(Результат);
	MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.Результат", Новый Структура("Файл, Проблем, valid, Идентификатор",
		ПроверяемыйФайл, МассивПроблем.Количество(), Результат.valid, MCPИдентификаторИзКонтекста(КонтекстMCP)));
	MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.СостояниеВкладок", Новый Структура(
		"Файл, activeTabChanged, previousActiveTab, currentActiveTab, newTabOpened, fileWasAlreadyOpen, editTabWasAlreadyOpen, duplicateTabSuspected, checkedFileIsActive, currentFeatureFile, catalogMatchesCheckedFile",
		ПроверяемыйФайл, СостояниеВкладок.activeTabChanged, СостояниеВкладок.previousActiveTab, СостояниеВкладок.currentActiveTab,
		СостояниеВкладок.newTabOpened, СостояниеВкладок.fileWasAlreadyOpen, СостояниеВкладок.editTabWasAlreadyOpen,
		СостояниеВкладок.duplicateTabSuspected, СостояниеВкладок.checkedFileIsActive, СостояниеВкладок.currentFeatureFile,
		СостояниеВкладок.catalogMatchesCheckedFile));
	
	// Инструмент возвращает Markdown строкой: состояние вкладок уже включено в текст
	MCPЗавершитьВызовУспешно(КонтекстMCP, СтрокаРезультат);
	
КонецПроцедуры

&НаКлиенте
Функция MCPСостояниеВкладокПослеПроверкиСинтаксиса(ПутьКФайлу, ДопПараметрыВызоваMCP)
	
	ПроверяемыйФайл = MCPПроверяемыйФайлИзДопПараметров(ПутьКФайлу, ДопПараметрыВызоваMCP);
	ПредыдущаяВкладка = СокрЛП(Строка(MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПредыдущаяВкладка", "")));
	ПредыдущаяВкладкаЗаголовок = СокрЛП(Строка(MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПредыдущаяВкладкаЗаголовок", "")));
	ПредыдущаяВкладкаВид = СокрЛП(Строка(MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПредыдущаяВкладкаВид", "none")));
	ПредыдущаяВкладкаКлюч = СокрЛП(Строка(MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПредыдущаяВкладкаКлюч", "none|")));
	ФайлБылОткрыт = MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПроверяемыйФайлБылОткрыт", Ложь) = Истина;
	ФайлБылОткрытВРедакторе = MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПроверяемыйФайлБылОткрытВРедакторе", Ложь) = Истина;
	КоличествоВкладокПроверяемогоФайлаДо = MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "КоличествоВкладокПроверяемогоФайлаДо", 0);
	Если ТипЗнч(КоличествоВкладокПроверяемогоФайлаДо) <> Тип("Число") Тогда
		КоличествоВкладокПроверяемогоФайлаДо = 0;
	КонецЕсли;

	Состояние = Новый Структура;
	Состояние.Вставить("editorStateAvailable", Ложь);
	Состояние.Вставить("editorStateError", "");
	Состояние.Вставить("activeTabChanged", Ложь);
	Состояние.Вставить("previousActiveTab", ПредыдущаяВкладка);
	Состояние.Вставить("previousActiveTabTitle", ПредыдущаяВкладкаЗаголовок);
	Состояние.Вставить("previousActiveTabType", ПредыдущаяВкладкаВид);
	Состояние.Вставить("currentActiveTab", "");
	Состояние.Вставить("currentActiveTabTitle", "");
	Состояние.Вставить("currentActiveTabType", "none");
	Состояние.Вставить("newTabOpened", Ложь);
	Состояние.Вставить("fileWasAlreadyOpen", ФайлБылОткрыт);
	Состояние.Вставить("editTabWasAlreadyOpen", ФайлБылОткрытВРедакторе);
	Состояние.Вставить("duplicateTabSuspected", Ложь);
	Состояние.Вставить("checkedFilePath", ПроверяемыйФайл);
	Состояние.Вставить("checkedFileIsActive", Ложь);
	Состояние.Вставить("currentFeatureFile", "");
	Состояние.Вставить("catalogMatchesCheckedFile", Ложь);
	
	Попытка
		Если Ванесса.Объект.КаталогФич <> Неопределено Тогда
			Состояние.currentFeatureFile = СокрЛП(Строка(Ванесса.Объект.КаталогФич));
		КонецЕсли;
	Исключение
		Состояние.editorStateError = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	Состояние.catalogMatchesCheckedFile = MCPПутиСовпадают(Состояние.checkedFilePath, Состояние.currentFeatureFile);

	Если Ванесса.VanessaTabs = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Состояние.editorStateError) Тогда
			Состояние.editorStateError = Ванесса.Локализовать("Редактор Vanessa Editor недоступен.");
		КонецЕсли;
		Возврат Состояние;
	КонецЕсли;

	Попытка
		ОписаниеТекущейВкладки = MCPОписаниеВкладки(Ванесса.VanessaTabs.current);
		Состояние.currentActiveTab = ОписаниеТекущейВкладки.ИмяФайла;
		Состояние.currentActiveTabTitle = ОписаниеТекущейВкладки.Заголовок;
		Состояние.currentActiveTabType = ОписаниеТекущейВкладки.Вид;
		Состояние.activeTabChanged = ОписаниеТекущейВкладки.Ключ <> ПредыдущаяВкладкаКлюч;

		// Считаем именно edit-вкладки проверяемого файла: так ловится и обычное открытие,
		// и дубль, созданный из-за различия в написании пути, но чужие вкладки не влияют.
		Состояние.newTabOpened = MCPКоличествоВкладокСФайлом(Состояние.checkedFilePath, Истина) > КоличествоВкладокПроверяемогоФайлаДо;

		Состояние.checkedFileIsActive = ОписаниеТекущейВкладки.Вид = "edit"
			И MCPПутиСовпадают(Состояние.currentActiveTab, Состояние.checkedFilePath);
		Состояние.duplicateTabSuspected = Состояние.fileWasAlreadyOpen
			И Состояние.editTabWasAlreadyOpen
			И Состояние.newTabOpened;
		Состояние.editorStateAvailable = Истина;
	Исключение
		Состояние.editorStateAvailable = Ложь;
		Состояние.editorStateError = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Состояние;

КонецФункции

&НаКлиенте
Функция MCPПроверяемыйФайлИзДопПараметров(ПутьКФайлу, ДопПараметрыВызоваMCP)

	ПроверяемыйФайл = MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПроверяемыйФайл", "");
	Если ЗначениеЗаполнено(ПроверяемыйФайл) Тогда
		Возврат СокрЛП(Строка(ПроверяемыйФайл));
	КонецЕсли;
	Если ПутьКФайлу = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(ПутьКФайлу));

КонецФункции

&НаКлиенте
Функция MCPПолеСтруктуры(Источник, ИмяПоля, ЗначениеПоУмолчанию)

	Если ТипЗнч(Источник) = Тип("Структура") И Источник.Свойство(ИмяПоля) Тогда
		Возврат Источник[ИмяПоля];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

&НаКлиенте
Функция MCPПутиСовпадают(Путь1, Путь2)

	НормализованныйПуть1 = MCPНормализоватьПутьДляСравнения(Путь1);
	НормализованныйПуть2 = MCPНормализоватьПутьДляСравнения(Путь2);
	Возврат ЗначениеЗаполнено(НормализованныйПуть1) И НормализованныйПуть1 = НормализованныйПуть2;

КонецФункции

&НаКлиенте
Функция MCPНормализоватьПутьДляСравнения(Путь)

	Результат = "";
	Если Путь <> Неопределено И Путь <> Null Тогда
		Результат = СокрЛП(Строка(Путь));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат "";
	КонецЕсли;
	Если Найти(НРег(Результат), "memory:") = 1 Тогда
		Возврат НРег(Результат);
	КонецЕсли;
	Если НЕ Ванесса.ЭтоLinux Тогда
		Результат = СтрЗаменить(Результат, "/", "\");
		Результат = НРег(Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция MCPОписаниеВкладки(Вкладка)

	Описание = Новый Структура("ИмяФайла, Заголовок, Вид, Ключ", "", "", "none", "none|");
	Если Вкладка = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	Попытка
		ЗначениеИмени = Вкладка.filename;
		Если ЗначениеИмени <> Неопределено И ЗначениеИмени <> Null Тогда
			Описание.ИмяФайла = СокрЛП(Строка(ЗначениеИмени));
		КонецЕсли;
	Исключение
		Описание.ИмяФайла = "";
	КонецПопытки;
	Попытка
		ЗначениеЗаголовка = Вкладка.title;
		Если ЗначениеЗаголовка <> Неопределено И ЗначениеЗаголовка <> Null Тогда
			Описание.Заголовок = СокрЛП(Строка(ЗначениеЗаголовка));
		КонецЕсли;
	Исключение
		Описание.Заголовок = "";
	КонецПопытки;
	Попытка
		Если Ванесса.ЭтоВкладкаDiff(Вкладка) Тогда
			Описание.Вид = "diff";
		ИначеЕсли Ванесса.ЭтоВкладкаEdit(Вкладка) Тогда
			Описание.Вид = "edit";
		Иначе
			Описание.Вид = "viewer";
		КонецЕсли;
	Исключение
		Описание.Вид = "viewer";
	КонецПопытки;
	Описание.Ключ = Описание.Вид + "|" + MCPНормализоватьПутьДляСравнения(Описание.ИмяФайла) + "|" + НРег(СокрЛП(Описание.Заголовок));
	Возврат Описание;

КонецФункции

&НаКлиенте
Функция MCPКоличествоВкладок()

	Если Ванесса.VanessaTabs = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Ванесса.VanessaTabs.count();
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция MCPКоличествоВкладокСФайлом(Путь, ТолькоРедактируемые = Ложь)

	НормализованныйПуть = MCPНормализоватьПутьДляСравнения(Путь);
	Если НЕ ЗначениеЗаполнено(НормализованныйПуть) ИЛИ Ванесса.VanessaTabs = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Количество = 0;
	Попытка
		КоличествоВкладок = MCPКоличествоВкладок();
		Для Индекс = 0 По КоличествоВкладок - 1 Цикл
			Вкладка = Ванесса.VanessaTabs.tab(Индекс);
			Если Вкладка <> Неопределено
				И (НЕ ТолькоРедактируемые ИЛИ Ванесса.ЭтоВкладкаEdit(Вкладка))
				И MCPНормализоватьПутьДляСравнения(Вкладка.filename) = НормализованныйПуть Тогда
				Количество = Количество + 1;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Количество;
	КонецПопытки;
	Возврат Количество;

КонецФункции

&НаКлиенте
Функция MCPВкладкаСФайлом(Путь)

	Возврат MCPКоличествоВкладокСФайлом(Путь) > 0;

КонецФункции

&НаКлиенте
Функция MCPВкладкаСФайломВРедакторе(Путь)

	Возврат MCPКоличествоВкладокСФайлом(Путь, Истина) > 0;

КонецФункции

// Загрузка или проверка фичи ещё не завершена. Одного флага мало: он сбрасывается
// до вызова диспетчера и не покрывает окно ожидания готовности дерева.
&НаКлиенте
Функция MCPЗагрузкаФичиНеЗавершена()

	Если Ванесса.ЕстьНезавершённаяЗагрузкаФичи() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат глMCPДедлайнОжиданияЗагрузкиФичи <> Неопределено;

КонецФункции

&НаКлиенте
Функция MCPТекстОшибкиПроверкиСинтаксисаСТечением(ТекстОшибки, ДопПараметрыВызоваMCP, ПутьКФайлу, Причина, ОткатыватьКаталог = Истина)

	// Ошибка или таймаут: вкладку не закрываем. Прежний каталог возвращаем только до
	// построения дерева: если дерево уже загружено, каталог и дерево должны остаться
	// от проверяемого файла. Дополнительно не затираем каталог нового параллельного
	// MCP-запроса.
	ПроверяемыйФайл = MCPПроверяемыйФайлИзДопПараметров(ПутьКФайлу, ДопПараметрыВызоваMCP);
	ПредыдущийКаталогФич = MCPПолеСтруктуры(ДопПараметрыВызоваMCP, "ПредыдущийКаталогФич", Неопределено);
	ТекущийКаталогФич = "";
	ДеревоФичЗагружено = Истина;
	Попытка
		ДеревоФичЗагружено = Ванесса.ФлагСценарииЗагружены = Истина;
	Исключение
		// Не смогли прочитать флаг — считаем дерево загруженным, чтобы не рассинхронизировать его с каталогом
	КонецПопытки;
	Попытка
		Если Ванесса.Объект.КаталогФич <> Неопределено Тогда
			ТекущийКаталогФич = СокрЛП(Строка(Ванесса.Объект.КаталогФич));
		КонецЕсли;
	Исключение
		// Не смогли прочитать каталог — откат не выполняем
	КонецПопытки;
	Если ОткатыватьКаталог
		И НЕ ДеревоФичЗагружено
		И ПредыдущийКаталогФич <> Неопределено
		И MCPПутиСовпадают(ТекущийКаталогФич, ПроверяемыйФайл) Тогда
		Попытка
			Ванесса.Объект.КаталогФич = ПредыдущийКаталогФич;
		Исключение
			MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.ОшибкаОткатаКаталога", Новый Структура("Файл, Причина",
				ПроверяемыйФайл, Причина));
		КонецПопытки;
	КонецЕсли;

	СостояниеВкладок = MCPСостояниеВкладокПослеПроверкиСинтаксиса(ПутьКФайлу, ДопПараметрыВызоваMCP);
	MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.СостояниеВкладок", Новый Структура(
		"Причина, Файл, activeTabChanged, previousActiveTab, currentActiveTab, newTabOpened, fileWasAlreadyOpen, editTabWasAlreadyOpen, duplicateTabSuspected, checkedFileIsActive, currentFeatureFile, catalogMatchesCheckedFile",
		Причина, СостояниеВкладок.checkedFilePath, СостояниеВкладок.activeTabChanged, СостояниеВкладок.previousActiveTab,
		СостояниеВкладок.currentActiveTab, СостояниеВкладок.newTabOpened, СостояниеВкладок.fileWasAlreadyOpen,
		СостояниеВкладок.editTabWasAlreadyOpen, СостояниеВкладок.duplicateTabSuspected, СостояниеВкладок.checkedFileIsActive,
		СостояниеВкладок.currentFeatureFile, СостояниеВкладок.catalogMatchesCheckedFile));

	Результат = "";
	Если ТекстОшибки <> Неопределено Тогда
		Результат = СокрЛП(Строка(ТекстОшибки));
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат) Тогда
		Результат = Результат + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПроверяемыйФайл) Тогда
		Результат = Результат + Ванесса.Локализовать("Проверяемый файл:") + " "
			+ MCPVAСлужебныйМодуль.MCPПредставлениеЗначенияДляMarkdown(ПроверяемыйФайл) + Символы.ПС + Символы.ПС;
	КонецЕсли;
	Возврат Результат + MCPVAСлужебныйМодуль.MCPСформироватьMarkdownСостоянияВкладок(СостояниеВкладок);

КонецФункции

&НаКлиенте
Процедура ЗавершитьОткрытиеФичаФайла(ПутьКФайлу, КонтекстMCP = Неопределено)
	
	ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("# Файл открыт в редакторе
							|
							|- Открыт: да
							|- Путь: %1
							|- Источник: %2
							|- Вкладка была открыта: %3
							|- Вкладка была открыта в редакторе: %4
							|- Активная вкладка: %5
							|- Дерево фич: загрузка запущена; готовность ожидают run_scenario, execute_feature_step и check_syntax
							|
							|## Следующие шаги
							|- Получите состояние редактора: `manage_editor` с `action: get_state`
							|- Проверьте синтаксис: `check_syntax`
							|- Получите состояние редактора: `get_editor_state`
							|- Перезагрузите дерево, если меняли файл на диске: `load_features`"),
		ПутьКФайлу);
		
	Если ТипЗнч(КонтекстMCP) = Тип("Структура") Тогда
		MCPЗаписатьСлужебныеДанные("ОткрытиеФичаФайла.Готово", Новый Структура("Файл, Идентификатор", ПутьКФайлу, MCPИдентификаторИзКонтекста(КонтекстMCP)));
		MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстОтвета);
		Возврат;
	КонецЕсли;	
	
	// Совместимость: старый путь без контекста отвечает по общему слоту.
	// Пустой ИД не отправляем молча: иначе вызов останется без ответа и без записи в ЖР.
	Идентификатор = Ванесса.ПолучитьИдентификаторЗадачиMCP();
	MCPЗаписатьСлужебныеДанные("ОткрытиеФичаФайла.Готово", Новый Структура("Файл, Идентификатор", ПутьКФайлу, Идентификатор));
	КонтекстСовместимости = Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", Идентификатор, Неопределено);
	MCPЗавершитьВызовУспешно(КонтекстСовместимости, ТекстОтвета);
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОткрытьЗагрузитьИлиПерезагрузитьФичаФайл(ПутьКФайлу, ДопПараметрыВызоваMCP)

	Если ДопПараметрыВызоваMCP = Неопределено Тогда
		// Задача уже завершилась (состояние сброшено) — продолжать нечего
		Возврат;
	КонецЕсли;
	
	Идентификатор = ДопПараметрыВызоваMCP.Идентификатор;
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = Ванесса.ПолучитьИдентификаторЗадачиMCP();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Путь = ДопПараметрыВызоваMCP.ИсходныйПутьКФайлу;
	
	Если ЗначениеЗаполнено(Путь) Тогда
		ПутьОтвета = Путь;
	Иначе
		ПутьОтвета = Ванесса.Объект.КаталогФич + " " + Ванесса.Локализовать("(текущий)");
	КонецЕсли;
	ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
		"# Загрузка фич
		|
		|- Загружено: да
		|- Путь: %1
		|
		|## Следующие шаги"),
		ПутьОтвета);
	Если НЕ MCPКлиентТестированияПодключен() Тогда
		ТекстОтвета = ТекстОтвета + Символы.ПС + Ванесса.Локализовать("- Подключите клиента тестирования: `manage_test_client` с `action: connect`");
	КонецЕсли;
	ТекстОтвета = ТекстОтвета + Символы.ПС + Ванесса.Локализовать("- Найдите нужные шаги: `search_for_steps_by_keywords`");
	ТекстОтвета = ТекстОтвета + Символы.ПС + Ванесса.Локализовать("- Запустите сценарий: `run_scenario`");

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	MCPЗаписатьСлужебныеДанные("ОткрытиеФичаФайла.Готово", Новый Структура("Файл, Идентификатор", ПутьКФайлу, MCPИдентификаторИзКонтекста(КонтекстMCP)));

	MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстОтвета);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыполнениеШагаВРедакторе(ПутьКФайлу, ДопПараметрыВызоваMCP)

	Если ДопПараметрыВызоваMCP = Неопределено Тогда
		// Задача уже завершилась (состояние сброшено) — продолжать нечего
		Возврат;
	КонецЕсли;
	
	//Подготовка шага использует общий слот: второй вызов отклоняем, чтобы не перепутать ответы
	Если глДопПараметрыВызоваMCP <> Неопределено Тогда
		КонтекстВходящегоВызова = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
		ИдентификаторВходящего = MCPИдентификаторИзКонтекста(КонтекстВходящегоВызова);
		ИдентификаторТекущего = MCPИдентификаторИзКонтекста(MCPКонтекстИзДопПараметров(глДопПараметрыВызоваMCP));
		Если ЗначениеЗаполнено(ИдентификаторВходящего) И ИдентификаторВходящего = ИдентификаторТекущего Тогда
			//Повторное оповещение того же вызова: ответит уже запущенная подготовка
			Возврат;
		КонецЕсли;
		MCPЗавершитьВызовСОшибкой(КонтекстВходящегоВызова, "ACTION_FAILED",
			Ванесса.Локализовать("Уже выполняется подготовка другого шага. Дождитесь ответа."));
		Возврат;
	КонецЕсли;
	
	ИдентификаторОжидания = Неопределено;
	НомерСтрокиШага = Неопределено;
	Попытка
		ДопПараметрыВызоваMCP.Свойство("Идентификатор", ИдентификаторОжидания);
		ДопПараметрыВызоваMCP.Свойство("НомерСтроки", НомерСтрокиШага);
	Исключение
		// Диагностика не должна мешать продолжению шага
	КонецПопытки;
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	Если НЕ ЗначениеЗаполнено(MCPИдентификаторИзКонтекста(КонтекстMCP)) Тогда
		КонтекстMCP = Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", ИдентификаторОжидания, Неопределено);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НомерСтрокиШага) Тогда
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"ACTION_FAILED", Истина, ИдентификаторОжидания, ПутьКФайлу, НомерСтрокиШага));
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED",
			Ванесса.Локализовать("Не удалось продолжить шаг: номер строки не передан."));
		Возврат;
	КонецЕсли;

	// Несохранённый буфер MCP-запуском на диск не сохраняем: просим сохранить файл явно
	ТекстОтказаНесохранённой = MCPТекстОтказаНесохранённойВкладки(ПутьКФайлу);
	Если ЗначениеЗаполнено(ТекстОтказаНесохранённой) Тогда
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"ACTION_FAILED", Истина, ИдентификаторОжидания, ПутьКФайлу, НомерСтрокиШага));
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстОтказаНесохранённой);
		Возврат;
	КонецЕсли;	

	// Проверяем что файл действительно открыт
	ТекущийФайл = MCPТекущийФайлРедактора();
	Если НРег(ТекущийФайл) <> НРег(ПутьКФайлу) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не удалось активировать вкладку файла:") + " " + ПутьКФайлу;
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"ACTION_FAILED", Истина, ИдентификаторОжидания, ПутьКФайлу, НомерСтрокиШага));
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
	ПолныйТекст = ЭкземплярVanessaEditor.getContent();
	
	НомерСтроки = НомерСтрокиШага;
	КоличествоСтрок = Ванесса._СтрРазделить(ПолныйТекст, Символы.ПС).Количество();
	Если НомерСтроки > КоличествоСтрок Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Строка %1 выходит за пределы файла (%2 строк): %3"),
				НомерСтроки, КоличествоСтрок, ПутьКФайлу);
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"ACTION_FAILED", Истина, ИдентификаторОжидания, ПутьКФайлу, НомерСтроки));
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	
	СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
	Если СтрокаДерева = Неопределено Тогда
		ТекстСтроки = ЭкземплярVanessaEditor.getLineContent(НомерСтроки);
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("По строке %1 не получилось найти исполнимую строку фича файла.
		|Текст в строке: %2
		|Имя файла: %3"),
				НомерСтроки, ТекстСтроки, ПутьКФайлу);
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"ACTION_FAILED", Истина, ИдентификаторОжидания, ПутьКФайлу, НомерСтроки));
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;	
	Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(СтрокаДерева.ИдСтроки, НомерСтроки);
	ДопПараметрыВызоваMCP.Вставить("ИдСтроки", СтрокаДерева.ИдСтроки);
	
	// Запускаем обработчик ожидания: он дождётся, пока редактор перейдёт к нужной строке
	глДопПараметрыВызоваMCP = ДопПараметрыВызоваMCP;
	глMCPПопытокОжиданияСтроки = 0;
	ПодключитьОбработчикОжидания("ПослеСделатьПереходКТекстуВРедакторе", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыполнитьСценарий1(ПутьКФайлу, ДопПараметрыВызоваMCP)
	
	РежимСценария = Неопределено;
	ЖдатьСценария = Неопределено;
	НомерСтрокиСценария = Неопределено;
	ИдентификаторСценария = Неопределено;
	Если ТипЗнч(ДопПараметрыВызоваMCP) = Тип("Структура") Тогда
		ДопПараметрыВызоваMCP.Свойство("Режим", РежимСценария);
		ДопПараметрыВызоваMCP.Свойство("Ждать", ЖдатьСценария);
		ДопПараметрыВызоваMCP.Свойство("НомерСтроки", НомерСтрокиСценария);
		ДопПараметрыВызоваMCP.Свойство("Идентификатор", ИдентификаторСценария);
	КонецЕсли;
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	MCPЗаписатьСлужебныеДанные("Сценарий.Продолжение1", Новый Структура("Файл, Режим, Ждать, НомерСтроки, Идентификатор",
		ПутьКФайлу, РежимСценария, ЖдатьСценария, НомерСтрокиСценария, MCPИдентификаторИзКонтекста(КонтекстMCP)));

	ЭтоРежимПерезагрузки = (РежимСценария = "reloadAndRun" ИЛИ РежимСценария = "reloadAndRunFromLine");
	Если ЭтоРежимПерезагрузки И Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		// Режимы перезагрузки всегда читают файл с диска. Загрузку выполняем здесь один раз:
		// повторная загрузка в Продолжить2 теряла флаг оповещения, и wait=true зависал.
		Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ТекстОшибки = Неопределено;
			ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстОшибки);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Попытка
			ПутьКФайлу = MCPНормализоватьПутьКФичаФайлу(ПутьКФайлу);
		Исключение
			ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "INVALID_PARAMS", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
			Возврат;
		КонецПопытки;
		ДопПараметрыВызоваMCP.Вставить("ФичаУжеЗагружена", Истина);
		ДопПараметрыВызоваMCP.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
	КонецЕсли;

	// Обеспечить наличие активной вкладки .feature в VanessaEditor
	// (без неё КомандаВыполнитьСценарии/ВыполнитьВыделенныйСценарий молча завершаются)
	Если Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		МСПНадоОткрытьФайл = ЭтоРежимПерезагрузки;
		Если Ванесса.VanessaTabs = Неопределено ИЛИ Ванесса.VanessaTabs.current = Неопределено Тогда
			МСПНадоОткрытьФайл = Истина;
		ИначеЕсли НЕ Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current) Тогда
			МСПНадоОткрытьФайл = Истина;
		ИначеЕсли (НРег(Ванесса.Объект.КаталогФич) <> НРег(ПутьКФайлу)) И ЗначениеЗаполнено(ПутьКФайлу) Тогда
			МСПНадоОткрытьФайл = Истина;
		КонецЕсли;
		
		Если МСПНадоОткрытьФайл Тогда
			// Не портим КаталогФич несуществующим путём: иначе следующие вызовы будут падать на этом пути.
			// Пустой путь не проверяем: для него ниже своё сообщение.
			// Относительный путь разворачиваем в полный: ядро его не разрешает и падает на проверке существования файла
			Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
				Попытка
					ПутьКФайлу = MCPНормализоватьПутьКФичаФайлу(ПутьКФайлу);
				Исключение
					ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "INVALID_PARAMS", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
					Возврат;
				КонецПопытки;
			КонецЕсли;	
			Ванесса.Объект.КаталогФич = ПутьКФайлу;
			ФайлВРедакторе = Ванесса.Объект.КаталогФич;
			Если ЗначениеЗаполнено(ФайлВРедакторе) И Прав(НРег(СокрЛП(ФайлВРедакторе)), 8) = ".feature" Тогда
				Попытка
					MCPOpenFeatureFileВРедакторе(ФайлВРедакторе, "ЗагрузитьФичуДляВыполненияСценария", ДопПараметрыВызоваMCP, ДопПараметрыВызоваMCP.Идентификатор)
				Исключение
					ТекстСообщения = Ванесса.Локализовать("Не удалось открыть файл в редакторе:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
					ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
					Возврат;
				КонецПопытки;
				// Загрузка завершится асинхронно и вызовет ПродолжитьВыполнитьСценарий2 из оповещения.
				// Повторный вызов здесь запускает прогон до готовности дерева и приводит к ошибке
				// "Сценарии уже выполняются", хотя прогон уже стартовал.
				Возврат;
			Иначе
				ТекстСообщения = Ванесса.Локализовать("Нет активного .feature файла в редакторе. Используйте параметр filePath, или сначала загрузите фичу через load_features(path='путь/к/файлу.feature') и openFeatureFile.");
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПродолжитьВыполнитьСценарий2(ПутьКФайлу, ДопПараметрыВызоваMCP);
	
КонецПроцедуры

// MCP-запуск не должен молча сохранять несохранённую вкладку .feature на диск (в UI движок это делает).
// Возвращает текст отказа или пустую строку, если запускать можно.
// ПутьКФайлу задан — проверяется вкладка именно этого файла (загрузка заменит её содержимое
// дисковым), иначе — активная вкладка.
&НаКлиенте
Функция MCPТекстОтказаНесохранённойВкладки(ПутьКФайлу = "")
	
	Если НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		Возврат "";
	КонецЕсли;	
	Если Ванесса.VanessaTabs = Неопределено Тогда
		Возврат "";
	КонецЕсли;	
	
	MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.ПроверкаПередДействием",
		Новый Структура("ЗапрошенныйФайл", ПутьКФайлу));

	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		// Перебираем все вкладки: diff того же файла мог оказаться раньше edit.
		// Ранний выход на первом совпадении пропускал изменённую edit-вкладку.
		Для Инд = 0 По Ванесса.VanessaTabs.count() - 1 Цикл
			Вкладка = Ванесса.VanessaTabs.tab(Инд);
			Если Вкладка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ MCPПутиСовпадают(Вкладка.filename, ПутьКФайлу) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ Ванесса.ЭтоВкладкаEdit(Вкладка) ИЛИ Ванесса.ЭтоВкладкаDiff(Вкладка) Тогда
				Продолжить;
			КонецЕсли;
			Изменена = Ложь;
			Попытка
				Изменена = (Вкладка.modified = Истина);
			Исключение
				Изменена = Ложь;
			КонецПопытки;
			Если Изменена Тогда
				MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.ОтказЗагрузки",
					Новый Структура("ЗапрошенныйФайл, Вкладка, Причина", ПутьКФайлу, Вкладка.filename, "modified"));
				Возврат Ванесса.Локализовать("Для выполнения данного действия необходимо сохранить файл.");
			КонецЕсли;
		КонецЦикла;
		// Файл не открыт или открыт без изменений: загрузке нечего затирать
		Возврат "";
	КонецЕсли;
	
	Если Ванесса.VanessaTabs.current = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current) ИЛИ Ванесса.ЭтоВкладкаDiff(Ванесса.VanessaTabs.current) Тогда
		Возврат "";
	КонецЕсли;	
	Если Ванесса.VanessaTabs.current.modified Тогда
		MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.ОтказЗагрузки",
			Новый Структура("ЗапрошенныйФайл, Вкладка, Причина", ПутьКФайлу, Ванесса.VanessaTabs.current.filename, "modified"));
		Возврат Ванесса.Локализовать("Для выполнения данного действия необходимо сохранить файл.");
	КонецЕсли;	
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьВыполнитьСценарий2(ПутьКФайлу, ДопПараметрыВызоваMCP, ИсточникВызова = "Продолжить1")

	Попытка
		
		MCPЗаписатьСлужебныеДанные("Сценарий.Продолжение2", Новый Структура("ИсточникВызова, Файл, Режим, Ждать, НомерСтроки, Идентификатор",
			ИсточникВызова, ПутьКФайлу, ДопПараметрыВызоваMCP.Режим, ДопПараметрыВызоваMCP.Ждать, ДопПараметрыВызоваMCP.НомерСтроки, ДопПараметрыВызоваMCP.Идентификатор));

		Режим = ДопПараметрыВызоваMCP.Режим;
		КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
		Идентификатор = MCPИдентификаторИзКонтекста(КонтекстMCP);
		
		// Между проверкой занятости в начале ВыполнитьСценарий и этой точкой прогон мог начать
		// другой источник: тогда команда запуска молча ничего не сделает, а вызов ответит отчётом чужого прогона
		Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
			ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED",
				Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона."));
			Возврат;
		КонецЕсли;	
		
		// Несохранённый буфер MCP-запуском на диск не сохраняем: просим сохранить файл явно.
		// Без filePath проверяем текущую фичу движка, а не только активную вкладку
		ПутьДляПроверки = ПутьКФайлу;
		Если НЕ ЗначениеЗаполнено(ПутьДляПроверки) Тогда
			ПутьДляПроверки = Ванесса.Объект.КаталогФич;
		КонецЕсли;	
		ТекстОтказаНесохранённой = MCPТекстОтказаНесохранённойВкладки(ПутьДляПроверки);
		Если ЗначениеЗаполнено(ТекстОтказаНесохранённой) Тогда
			ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстОтказаНесохранённой);
			Возврат;
		КонецЕсли;	
		
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Режим, ДопПараметрыВызоваMCP);
		// Вызов вернётся в ОповеститьMCP_ОЗавершенииВыполненияСценариев
		
		Если Режим = "selected" Тогда
			ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
			ПозицияVanessaEditor = ЭкземплярVanessaEditor.getPosition();
			ТекНомерСтроки = ПозицияVanessaEditor.lineNumber;
			
			СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(ТекНомерСтроки);
			Если СтрокаДерева = Неопределено Тогда
				ТекстСообщения = Ванесса.Локализовать("Не найдена строка внутреннего дерева по номеру строки фичи:") + ТекНомерСтроки;
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;	
			
			Ванесса.ВыполнитьВыделенныйСценарий();
		ИначеЕсли Режим = "all" Тогда
			Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
			Если Проблемы.Количество() > 0 Тогда
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
				Возврат;
			КонецЕсли;
			
			Ванесса.КомандаВыполнитьСценарии();
		ИначеЕсли Режим = "reloadAndRun" Тогда
			//Ванесса.ПерезагрузитьИВыполнитьДанныйСценарий();
			Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
				ТекстОшибки = Неопределено;
				ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстОшибки);
					Возврат;
				КонецЕсли;
			КонецЕсли;	
			
			Если ДопПараметрыВызоваMCP.Свойство("ФичаУжеЗагружена") И ДопПараметрыВызоваMCP.ФичаУжеЗагружена = Истина Тогда
				// Фичу уже перечитал Продолжить1: второй загрузки и второго оповещения не будет
				Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
				Если Проблемы.Количество() > 0 Тогда
					ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
					Возврат;
				КонецЕсли;
				Ванесса.КомандаВыполнитьСценарии();
				Возврат;
			КонецЕсли;
			
			ЖдатьЗавершения = Истина;
			Если ДопПараметрыВызоваMCP.Свойство("Ждать") Тогда
				ЖдатьЗавершения = ДопПараметрыВызоваMCP.Ждать;
			КонецЕсли;	
			
			ДопПараметрыВызоваMCP = Новый Структура;
			ДопПараметрыВызоваMCP.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
			ДопПараметрыВызоваMCP.Вставить("ЗапуститьВсеСценарииПослеЗагрузки", Истина);
			// Загрузка фичи перезапишет структуру вызова в движке: wait и контекст переносим в новую структуру
			ДопПараметрыВызоваMCP.Вставить("Ждать", ЖдатьЗавершения);
			ДопПараметрыВызоваMCP.Вставить("Идентификатор", Идентификатор);
			ДопПараметрыВызоваMCP.Вставить("КонтекстMCP", КонтекстMCP);
			MCPOpenFeatureFileВРедакторе(ПутьКФайлу, "ЗагрузитьФичаФайлИВыполнитьСценарии", ДопПараметрыВызоваMCP, Идентификатор);
			
		ИначеЕсли Режим = "fromCurrentStep" Тогда
			Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
			Если Проблемы.Количество() > 0 Тогда
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
				Возврат;
			КонецЕсли;
			
			// При отказе запуска вызов MCP завершит Ванесса.ОповеститьMCP_ОНевозможностиЗапуска
			Ванесса.ВыполнитьДанныйСценарийСТекущегоШага();
		ИначеЕсли Режим = "reloadAndRunFromLine" Тогда
			// Получаем номер строки из параметров
			НомерСтроки = ДопПараметрыВызоваMCP.НомерСтроки;
			Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
				ТекстСообщения = Ванесса.Локализовать("Для режима reloadAndRunFromLine необходимо указать параметр lineNumber.");
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;	
			
			// Сначала загружаем фича файл
			Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
				ТекстОшибки = Неопределено;
				ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстОшибки);
					Возврат;
				КонецЕсли;
			КонецЕсли;	
			
			Если ДопПараметрыВызоваMCP.Свойство("ФичаУжеЗагружена") И ДопПараметрыВызоваMCP.ФичаУжеЗагружена = Истина Тогда
				// Фичу уже перечитал Продолжить1: сразу переходим к строке и запускаем
				MCPПодготовитьЗапускСоСтроки(ПутьКФайлу, ДопПараметрыВызоваMCP);
				Возврат;
			КонецЕсли;
			
			ЖдатьЗавершения = Истина;
			Если ДопПараметрыВызоваMCP.Свойство("Ждать") Тогда
				ЖдатьЗавершения = ДопПараметрыВызоваMCP.Ждать;
			КонецЕсли;	
			
			// Сохраняем номер строки в доп параметрах для последующего использования
			ДопПараметрыЗагрузки = Новый Структура;
			ДопПараметрыЗагрузки.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
			ДопПараметрыЗагрузки.Вставить("НомерСтроки", НомерСтроки);
			ДопПараметрыЗагрузки.Вставить("РежимПослеЗагрузки", "reloadAndRunFromLine");
			// Загрузка фичи перезапишет структуру вызова в движке: wait и контекст переносим в новую структуру
			ДопПараметрыЗагрузки.Вставить("Ждать", ЖдатьЗавершения);
			ДопПараметрыЗагрузки.Вставить("Идентификатор", Идентификатор);
			ДопПараметрыЗагрузки.Вставить("КонтекстMCP", КонтекстMCP);
			MCPOpenFeatureFileВРедакторе(ПутьКФайлу, "ЗагрузитьФичуДляВыполненияСценария", ДопПараметрыЗагрузки, Идентификатор);
			Возврат;
		Иначе
			ТекстСообщения = Ванесса.Локализовать("Неизвестный режим:") + " " + Режим + Ванесса.Локализовать(". Допустимые: selected, all, reloadAndRun, fromCurrentStep, reloadAndRunFromLine.");
			ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка запуска:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

// Переводит редактор к строке запуска и запускает сценарий с текущего шага.
// Вызывается после загрузки фичи (reloadAndRunFromLine), когда дерево уже построено.
&НаКлиенте
Процедура MCPПодготовитьЗапускСоСтроки(ПутьКФайлу, ДопПараметрыВызоваMCP)
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	ИдентификаторЗапуска = MCPИдентификаторИзКонтекста(КонтекстMCP);
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапуска) Тогда
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED",
			Ванесса.Локализовать("Не удалось определить идентификатор запроса MCP."));
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ИдентификаторВыбораMCP) Тогда
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED",
			Ванесса.Локализовать("Уже выполняется выбор сценария или шага. Дождитесь ответа."));
		Возврат;
	КонецЕсли;	
	ИдентификаторВыбораMCP = ИдентификаторЗапуска;
	НомерСтроки = MCPБезопасноеСвойство(ДопПараметрыВызоваMCP, "НомерСтроки");
	Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для режима reloadAndRunFromLine необходимо указать параметр lineNumber.");
		ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
		ИдентификаторВыбораMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ИсходныйПуть = MCPБезопасноеСвойство(ДопПараметрыВызоваMCP, "ИсходныйПутьКФайлу");
	Если НЕ ЗначениеЗаполнено(ИсходныйПуть) Тогда
		ИсходныйПуть = ПутьКФайлу;
	КонецЕсли;
	
	Попытка
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ИсходныйПуть, "UTF-8");
		ТекстФайла = Текст.Прочитать();
		Текст.Закрыть();
		
		МассивСтрокФайла = Ванесса._СтрРазделить(ТекстФайла, Символы.ПС);
	Исключение
		//Слот нельзя оставлять занятым: иначе выбор сценария или шага заблокирован навсегда
		ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
		ИдентификаторВыбораMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		Возврат;
	КонецПопытки;
	
	НашлиШаг = Ложь;
	Пока Истина Цикл
		СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
		Если СтрокаДерева <> Неопределено И СтрокаДерева.Тип = "Шаг" Тогда
			ЭтоПример = Ложь;
			ЭтоШагКонтекста = Ложь;
			Ванесса.НайтиСтрокуСценарияЧерезРодителя(СтрокаДерева, ЭтоПример, ЭтоШагКонтекста);
			
			Если ЭтоШагКонтекста Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В файле <%1> первым шагом, который можно выполнить, начиная со строки <%2> и ниже, оказался шаг контекста в строке <%3>. Но нельзя запускаться выполнение сценария с определенного шага и при этом передавать номер строки, где располагается секция Контекст, т.к. секция Контекст не является самостоятельным сценарием."), ИсходныйПуть, ДопПараметрыВызоваMCP.НомерСтроки, НомерСтроки);
				ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
				ИдентификаторВыбораMCP = Неопределено;
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED", ТекстОшибки);
				Возврат;
			КонецЕсли;	
			
			НашлиШаг = Истина;
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки > МассивСтрокФайла.Количество() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ НашлиШаг Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В файле <%1> нет шагов для выполнения, начиная со строки <%2> и ниже."), ИсходныйПуть, ДопПараметрыВызоваMCP.НомерСтроки);
		ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
		ИдентификаторВыбораMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED", ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	ТекстОшибки = Неопределено;
	Попытка
		СделатьШагФичиТекущим(НомерСтроки, ИдентификаторВыбораMCP, ТекстОшибки);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
		ИдентификаторВыбораMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED", ТекстОшибки);
		Возврат;
	КонецЕсли;	
	// Шаг становится текущим асинхронно: ждём фактического перехода редактора к строке
	глMCPЦелеваяИдСтрокиОжидания = СтрокаДерева.ИдСтроки;
	глMCPЦелевойНомерСтрокиОжидания = НомерСтроки;
	глMCPПопытокОжиданияСтроки = 0;
	ПодключитьОбработчикОжидания("MCPПроверитьГотовностьСтрокиЗапускаСценария", 0.1, Истина);
	
КонецПроцедуры

// Завершает вызов инструмента ошибкой и сбрасывает состояние MCP-задачи.
// Без сброса после неудачного запуска сценариев остаётся взведённый флаг оповещения, и при следующем запуске сценариев уходит уведомление прогресса с устаревшим токеном
&НаКлиенте
Процедура ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(Идентификатор, КодОшибки, ТекстОшибки)

	MCPЗаписатьСлужебныеДанные("ОшибкаВызова", Новый Структура("Код, ЕстьТекст, Идентификатор",
		КодОшибки, ЗначениеЗаполнено(ТекстОшибки), Идентификатор));
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		MCPЗаписатьСлужебныеДанные("MCP.ПустойИдентификаторЗапроса",
			Новый Структура("Инструмент, Код", "ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP", КодОшибки));
	КонецЕсли;	
	МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Идентификатор, КодОшибки, MCPТекстБезНедопустимыхСимволовXML(ТекстОшибки));
	// Сбрасываем состояние только своей задачи: ожидающий вызов должен принадлежать этому ИД.
	// Пустой владелец означает, что состояние ещё не взведено - тогда сброс безопасен.
	ИдентификаторОжидания = Ванесса.ИдентификаторОжидающегоВызоваMCP();
	Если НЕ ЗначениеЗаполнено(ИдентификаторОжидания) ИЛИ ИдентификаторОжидания = Идентификатор Тогда
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеЗагрузкиФичи(Неопределено);
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Неопределено, Неопределено);
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияОднойСтрокиФичи(Неопределено);
	КонецЕсли;

КонецПроцедуры

// Отвечает отказом входящему MCP-вызову, не сбрасывая состояние ожидающего прогона.
// Во время прогона глобальный ИД и флаги ожидания принадлежат ему: их очистка оставила бы
// выполняющийся вызов без отчёта (дефект «ожидающий вызов теряет ответ»)
&НаКлиенте
Процедура MCPОтветитьОтказомБезСбросаПрогона(Идентификатор, КодОшибки, ТекстОшибки)
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		// Не знаем ИД входящего вызова: отвечать нельзя, иначе ответ уйдёт чужому вызову
		MCPЗаписатьСлужебныеДанные("MCP.ПустойИдентификаторЗапроса",
			Новый Структура("Инструмент, Код", "MCPОтветитьОтказомБезСбросаПрогона", КодОшибки));
		Возврат;
	КонецЕсли;	
	
	MCPЗаписатьСлужебныеДанные("ОтказБезСбросаПрогона", Новый Структура("Код, ЕстьТекст, Идентификатор, ПрогонИдёт",
		КодОшибки, ЗначениеЗаполнено(ТекстОшибки), Идентификатор, Ванесса.Объект.ИдетВыполнениеСценариев));

	МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Идентификатор, КодОшибки, MCPТекстБезНедопустимыхСимволовXML(ТекстОшибки));
	
	// Прогона нет (например, отказ предстартовой загрузке): сбрасываем состояние своего вызова,
	// иначе взведённый флаг отправит отчёт следующего прогона устаревшему вызову
	ИдентификаторОжидания = Ванесса.ИдентификаторОжидающегоВызоваMCP();
	Если НЕ Ванесса.Объект.ИдетВыполнениеСценариев
		И (НЕ ЗначениеЗаполнено(ИдентификаторОжидания) ИЛИ ИдентификаторОжидания = Идентификатор) Тогда
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Неопределено, Неопределено);
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияОднойСтрокиФичи(Неопределено);
	КонецЕсли;	
	
КонецПроцедуры

// Убирает символы, недопустимые в XML: текст с ними нельзя передать в МодульМсп_Сервер,
// и вызывающая сторона вместо ответа получит ошибку транспортного уровня
&НаКлиенте
Функция MCPТекстБезНедопустимыхСимволовXML(Знач Текст)
	
	Результат = "";
	Для Сч = 1 По СтрДлина(Текст) Цикл
		КодСимволаТек = КодСимвола(Текст, Сч);
		Если КодСимволаТек < 32 И КодСимволаТек <> 9 И КодСимволаТек <> 10 И КодСимволаТек <> 13 Тогда
			Продолжить;
		КонецЕсли;
		Результат = Результат + Сред(Текст, Сч, 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя сценария из списка запуска по идентификатору строки дерева: после прогона дерево может быть перестроено
&НаКлиенте
Функция MCPИмяСценарияИзСпискаЗапуска(ИДСтроки)
	
	МассивСценариев = Ванесса.МассивСценариевДляВыполнения;
	Если ТипЗнч(МассивСценариев) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;	
	
	Для Каждого ДанныеСценария Из МассивСценариев Цикл
		Если ДанныеСценария.Свойство("СтрокаДерева") И ДанныеСценария.СтрокаДерева = ИДСтроки Тогда
			Если ДанныеСценария.Свойство("Имя") Тогда
				Возврат ДанныеСценария.Имя;
			КонецЕсли;	
			Возврат "";
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP)
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	ИдентификаторЗапроса = MCPИдентификаторИзКонтекста(КонтекстMCP);
	МассивРезультатПрохожденияТестовСценария = Ванесса.ПолучитьМассивРезультатПрохожденияТестовСценария();
	Если МассивРезультатПрохожденияТестовСценария = Неопределено Тогда
		МассивРезультатПрохожденияТестовСценария = Новый Массив;
	КонецЕсли;	
	БылиОшибки = Ложь;
	ЕстьНезавершенныеСценарии = Ложь;
	Для Каждого ДанныеСценария Из МассивРезультатПрохожденияТестовСценария Цикл
		Если ДанныеСценария.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(ДанныеСценария.ОписаниеОшибки) Тогда
			БылиОшибки = Истина;
		КонецЕсли;	
		// У записи, прерванной остановкой (например, на точке останова), статус не заполняется или помечается как Broken
		Если НЕ ДанныеСценария.Свойство("Статус") Тогда
			ЕстьНезавершенныеСценарии = Истина;
		ИначеЕсли Строка(ДанныеСценария.Статус) = "Broken" Тогда
			ЕстьНезавершенныеСценарии = Истина;
		КонецЕсли;	
	КонецЦикла;	
	
	// Записей меньше, чем выбранных сценариев, — прогон прерван, часть сценариев не выполнялась
	ПрогонНеполный = Ложь;
	МассивСценариевДляВыполнения = Ванесса.МассивСценариевДляВыполнения;
	Если ТипЗнч(МассивСценариевДляВыполнения) = Тип("Массив") Тогда
		ПрогонНеполный = МассивРезультатПрохожденияТестовСценария.Количество() < МассивСценариевДляВыполнения.Количество();
	КонецЕсли;	
	
	MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.ПослеПрогона",
		Новый Структура("Тип, Неполный", Тип, ЕстьНезавершенныеСценарии ИЛИ ПрогонНеполный));

	МассивСтрок = Новый Массив;
	Если БылиОшибки Тогда
		ТекстСтроки = Ванесса.Локализовать("## Результат выполнения сценариев: были ошибки");
	ИначеЕсли ЕстьНезавершенныеСценарии ИЛИ ПрогонНеполный Тогда
		ТекстСтроки = Ванесса.Локализовать("## Результат выполнения сценариев: прогон прерван, не все сценарии завершены");
	Иначе	
		ТекстСтроки = Ванесса.Локализовать("## Результат выполнения сценариев: все сценарии выполнены успешно");
	КонецЕсли;	
	МассивСтрок.Добавить(ТекстСтроки);
	Если ПрогонНеполный Тогда
		МассивСтрок.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В отчёт попало %1 из %2 выбранных сценариев"),
			Формат(МассивРезультатПрохожденияТестовСценария.Количество(), "ЧГ=0"),
			Формат(МассивСценариевДляВыполнения.Количество(), "ЧГ=0")));
	КонецЕсли;	
	Если ЕстьНезавершенныеСценарии ИЛИ ПрогонНеполный Тогда
		МассивСтрок.Добавить(Ванесса.Локализовать("Причина:") + " " + MCPТекстПричиныОстановкиПрогона());
	КонецЕсли;
	МассивСтрок.Добавить("");
	
	НадоСнятьСкриншот = Ложь;
	
	Для Каждого ДанныеСценария Из МассивРезультатПрохожденияТестовСценария Цикл
		СтрокаСценария = Ванесса.СтрокаДереваПоИдСтроки(ДанныеСценария.ИДСтроки);
		
		Если СтрокаСценария = Неопределено Тогда
			// Дерево могло быть перестроено после прогона: не падаем, имя пробуем взять из списка запуска
			ИмяСценарияИзСписка = MCPИмяСценарияИзСпискаЗапуска(ДанныеСценария.ИДСтроки);
			Если ЗначениеЗаполнено(ИмяСценарияИзСписка) Тогда
				ТекстСтроки = Ванесса.Локализовать("Имя сценария:") + " " + ИмяСценарияИзСписка;
			Иначе
				ТекстСтроки = Ванесса.Локализовать("Имя сценария:") + " " + Ванесса.Локализовать("(строка дерева не найдена)");
			КонецЕсли;	
		Иначе
			ТекстСтроки = Ванесса.Локализовать("Имя сценария:" + " " + СтрокаСценария.Имя);
		КонецЕсли;	
		МассивСтрок.Добавить(ТекстСтроки);
		Если ДанныеСценария.Свойство("Статус") Тогда
			ТекстСтроки = Ванесса.Локализовать("Результат прохождения сценария:") + " " + ДанныеСценария.Статус;
		Иначе
			ТекстСтроки = Ванесса.Локализовать("Сценарий не завершён.");
		КонецЕсли;	
		МассивСтрок.Добавить(ТекстСтроки);
		
		НомерСтрокиВФиче = Неопределено;
		СтрокаУпавшегоШага = Неопределено;
		
		Если ДанныеСценария.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(ДанныеСценария.ОписаниеОшибки) Тогда
			БылиОшибки = Истина;
			
			Если ДанныеСценария.Свойство("ДанныеДляФормированияJsonОбОшибке") Тогда
				СтрокаУпавшегоШага = Ванесса.СтрокаДереваПоИдСтроки(ДанныеСценария.ДанныеДляФормированияJsonОбОшибке.ИДСтрокиУпавшегоШага);
			КонецЕсли;
			
			Если СтрокаУпавшегоШага <> Неопределено Тогда
				ТекстСтроки = Ванесса.Локализовать("Текст упавшего шага:") + " " + СтрокаУпавшегоШага.Имя;
				МассивСтрок.Добавить(ТекстСтроки);
				ТекстСтроки = Ванесса.Локализовать("Статус упавшего шага:") + " " + СтрокаУпавшегоШага.Статус;
				МассивСтрок.Добавить(ТекстСтроки);
				ТекстСтроки = Ванесса.Локализовать("Номер строки упавшего шага в feature файле:") + " " + XMLСтрока(СтрокаУпавшегоШага.НомерСтрокиВФиче);
				МассивСтрок.Добавить(ТекстСтроки);
				ТекстСтроки = Ванесса.Локализовать("Текст ошибки:") + " " + ДанныеСценария.ДанныеДляФормированияJsonОбОшибке.ОписаниеОшибкиКратко;
				МассивСтрок.Добавить(ТекстСтроки);
				
				НомерСтрокиВФиче = СтрокаУпавшегоШага.НомерСтрокиВФиче;
			Иначе
				// Данных об упавшем шаге нет (например, исключение до начала шага) — в отчёт идёт только текст ошибки
				ТекстСтроки = Ванесса.Локализовать("Текст ошибки:") + " " + ДанныеСценария.ОписаниеОшибки;
				МассивСтрок.Добавить(ТекстСтроки);
			КонецЕсли;	
			
			ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
			
			МассивСтрок.Добавить("");
			МассивСтрок.Добавить("");
			
			Если НомерСтрокиВФиче <> Неопределено Тогда
				ОбновитьКешДанныхУпавшегоШагаИСказатьИИСнятьСкриншот(НомерСтрокиВФиче, МассивСтрок, НадоСнятьСкриншот);
			КонецЕсли;
			
			Если СтрокаУпавшегоШага <> Неопределено Тогда
				Если ДляШагаНадоВсегдаСниматьСкриншот(СтрокаУпавшегоШага) Тогда
					НадоСнятьСкриншот = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НадоСнятьСкриншот Тогда
		СнятьСкриншотыОконКлиентаТестированияИОтправитьИхИИДляАнализаПослеВыполненияСценария(МассивСтрок);
	КонецЕсли;
	
	ВыбраноСценариев = 0;
	Если ТипЗнч(МассивСценариевДляВыполнения) = Тип("Массив") Тогда
		ВыбраноСценариев = МассивСценариевДляВыполнения.Количество();
	КонецЕсли;
	Режим = Неопределено;
	Если ТипЗнч(ДопПараметрыВызоваMCP) = Тип("Структура") Тогда
		ДопПараметрыВызоваMCP.Свойство("Режим", Режим);
	КонецЕсли;
	MCPЗаписатьСлужебныеДанные("Сценарий.Результат", Новый Структура(
		"Тип, Режим, Идентификатор, ВсегоРезультатов, ВыбраноСценариев, БылиОшибки, ЕстьНезавершенные, ПрогонНеполный, ПричинаОстановки",
		Тип, Режим, ИдентификаторЗапроса,
		МассивРезультатПрохожденияТестовСценария.Количество(), ВыбраноСценариев,
		БылиОшибки, ЕстьНезавершенныеСценарии, ПрогонНеполный,
		?(ЕстьНезавершенныеСценарии ИЛИ ПрогонНеполный, MCPТекстПричиныОстановкиПрогона(), "")));

	MCPЗавершитьВызовУспешно(КонтекстMCP, Ванесса._СтрСоединить(МассивСтрок, Символы.ПС));
	Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Неопределено, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПослеСделатьПереходКТекстуВРедакторе()
	НомерСтроки = глДопПараметрыВызоваMCP.НомерСтроки;
	ПутьКФайлу = глДопПараметрыВызоваMCP.ПутьКФайлу;
	
	// Переиздаём позиционирование: после загрузки фичи редактор возвращает курсор к прежней позиции,
	// последний setPosition должен остаться за нами
	СвежийИдСтроки = MCPСвежийИдСтрокиПоНомеруСтрокиФичи(НомерСтроки);
	Если СвежийИдСтроки <> Неопределено Тогда
		глДопПараметрыВызоваMCP.Вставить("ИдСтроки", СвежийИдСтроки);
	КонецЕсли;	
	Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(глДопПараметрыВызоваMCP.ИдСтроки, НомерСтроки);
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(глДопПараметрыВызоваMCP);
	
	// Без ожидания фактического перехода редактора выполнился бы прежний текущий шаг
	Если НЕ MCPСтрокаРедактораСталаТекущей(глДопПараметрыВызоваMCP.ИдСтроки) Тогда
		глMCPПопытокОжиданияСтроки = глMCPПопытокОжиданияСтроки + 1;
		Если глMCPПопытокОжиданияСтроки < 100 Тогда
			ПодключитьОбработчикОжидания("ПослеСделатьПереходКТекстуВРедакторе", 0.1, Истина);
			Возврат;
		КонецЕсли;	
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Редактор не перешёл к строке %1 за отведённое время (текущая позиция: %2). Шаг не выполнен."), XMLСтрока(НомерСтроки), MCPФактическаяПозицияКурсораРедактораСтрокой());
		глДопПараметрыВызоваMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;	
	
	ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
	ТекстСтроки = ЭкземплярVanessaEditor.getLineContent(НомерСтроки);
	
	Если НЕ ЗначениеЗаполнено(ТекстСтроки) Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Строка %1 пуста в файле: %2"),
				НомерСтроки, ПутьКФайлу);
		глДопПараметрыВызоваMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	// Пока шло ожидание перехода редактора, прогон мог начать другой источник: команда шага
	// молча ничего не сделает, а вызов останется без ответа
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		глДопПараметрыВызоваMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED",
			Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона."));
		Возврат;
	КонецЕсли;	
	
	ПараметрыВыполняемогоШага = глДопПараметрыВызоваMCP;
	глДопПараметрыВызоваMCP = Неопределено;
	Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияОднойСтрокиФичи(ПараметрыВыполняемогоШага.Тип, ПараметрыВыполняемогоШага);
	// При отказе запуска вызов MCP завершит Ванесса.ОповеститьMCP_ОНевозможностиЗапуска
	Ванесса.ВыполнитьОдинШаг();
	
	// Вызов вернётся в ОповеститьMCP_ОЗавершенииВыполненияОднойСтрокиФичи
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьУспешноеВыполнениеШагаВРедакторе(ДопПараметрыВызоваMCP)
	ТекстСообщения = Ванесса.Локализовать("Шаг в строке фича файла успешно выполнен");
	MCPЗавершитьВызовУспешно(MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP), ТекстСообщения);
КонецПроцедуры

// Завершает вызов run_scenario сразу после старта прогона (wait=false): отчёт по завершении
// забирается инструментами get_vanessa_automation_state и get_test_results
&НаКлиенте
Процедура MCPЗавершитьЗапускПрогонаБезОжидания(Режим, ДопПараметрыВызоваMCP = Неопределено) Экспорт
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	MCPЗаписатьСлужебныеДанные("Сценарий.БезОжидания", Новый Структура("Режим, Идентификатор",
		Режим, MCPИдентификаторИзКонтекста(КонтекстMCP)));

	ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
		"# Прогон запущен
		|
		|- Режим: %1
		|- Ожидание завершения: нет (wait=false)
		|- Прогресс по шагам (step N/M) не отправляется; если подходящих сценариев нет, прогон завершится сразу
		|
		|## Следующие шаги
		|- Наблюдать за прогоном: `get_vanessa_automation_state`
		|- Результаты по завершении: `get_test_results`
		|- Остановить прогон: `stop_scenario`"),
		MCPПредставлениеЗначенияДляMarkdown(Режим));
	
	MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстОтвета);
	Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Неопределено, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыполнениеШагаВРедактореСОшибкой(ДопПараметрыВызоваMCP, РезультатПрохожденияШага)
	ТекстСообщения = ТекстОшибкиИзОписанияОшибки(РезультатПрохожденияШага.ОписаниеОшибки);
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(ТекстСообщения);
	ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
	
	MCPЗавершитьВызовСОшибкой(MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP), "ACTION_FAILED", Ванесса._СтрСоединить(МассивСтрок, Символы.ПС));
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеФичаФайлаВРедакторе(ПутьКФайлу, Запрос, ТипВызова, ДопПараметрыВызоваMCP = Неопределено)
	
	MCPЗаписатьСлужебныеДанные("ОткрытиеФичаФайла.Запрос", Новый Структура("Тип, Файл, Идентификатор",
		ТипВызова, ПутьКФайлу, Запрос.Идентификатор));

	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ПутьКФайлу) Тогда
			
			ПолныйПутьКФайлуВКаталогеПроекта = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + ПутьКФайлу;
			Если Не Ванесса.ЭтоLinux Тогда
				// Относительный путь мог прийти с "/": в диагностике не должно быть смеси разделителей
				ПолныйПутьКФайлуВКаталогеПроекта = СтрЗаменить(ПолныйПутьКФайлуВКаталогеПроекта, "/", "\");
			КонецЕсли;	
			Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ПолныйПутьКФайлуВКаталогеПроекта) Тогда
				ТекстОшибки = Ванесса.Локализовать("Файл <%1> не был найден.");
				Если НЕ Ванесса.ЭтоLinux И Найти(ПутьКФайлу, ":") = 0 Тогда
					ТекстОшибки = Ванесса.Локализовать("Файл <%1> не был найден. В каталоге проекта файл <%2> тоже не был найден. Видимо был передан относительный путь, попробуйте передать полный путь к файлу.");
				КонецЕсли;
				
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибки, ПутьКФайлу, ПолныйПутьКФайлуВКаталогеПроекта);
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(Запрос.Идентификатор, "INVALID_PARAMS", ТекстОшибки);
				Возврат;
			Иначе
				ПутьКФайлу = ПолныйПутьКФайлуВКаталогеПроекта;
			КонецЕсли;	
			
		КонецЕсли;	
		Попытка
			ПутьКФайлу = MCPНормализоватьПутьКФичаФайлу(ПутьКФайлу);
		Исключение
			// Некорректный путь (каталог, файл не найден) - это ошибка входных данных, а не внутренняя
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(Запрос.Идентификатор, "INVALID_PARAMS", ТекстОшибки);
			Возврат;
		КонецПопытки;
		
		КонтекстMCP = MCPНовыйКонтекстЗапроса(Запрос);
		Идентификатор = MCPИдентификаторИзКонтекста(КонтекстMCP);
		// Проверяем занятость до перезаписи глобального ИД: иначе отчёт ожидающего
		// прогона уйдёт этому вызову, а его флаги будут сброшены
		Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
			MCPОтветитьОтказомБезСбросаПрогона(Идентификатор, "ACTION_FAILED",
				Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона или вызовите stop_scenario."));
			Возврат;
		КонецЕсли;	
		Если ТипЗнч(ДопПараметрыВызоваMCP) <> Тип("Структура") Тогда
			ДопПараметрыВызоваMCP = Новый Структура;
			ДопПараметрыВызоваMCP.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
		КонецЕсли;	
		ДопПараметрыВызоваMCP.Вставить("Идентификатор", Идентификатор);
		ДопПараметрыВызоваMCP.Вставить("КонтекстMCP", КонтекстMCP);
		Если КонтекстMCP.ТокенПрогресса <> Неопределено Тогда
			МодульМсп_Сервер().УведомитьОПрогрессе(КонтекстMCP.ТокенПрогресса, 0, 3, Ванесса.Локализовать("Загрузка feature файла."));
		КонецЕсли;
		
		MCPOpenFeatureFileВРедакторе(ПутьКФайлу, ТипВызова, ДопПараметрыВызоваMCP, Идентификатор);
	Иначе
		ТекстОшибки = Ванесса.Локализовать("Не передан путь к файлу.");
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(Запрос.Идентификатор, "INVALID_PARAMS", ТекстОшибки);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстОшибкиИзОписанияОшибки(Знач Стр)
	Возврат MCPVAСлужебныйМодуль.ТекстОшибкиИзОписанияОшибки(Стр);
КонецФункции

&НаКлиенте
Процедура MCPДанныеИсследователяФормы(КонтекстMCP, ФорматВывода, ИмяТаблицыФормы = "", ИмяГруппыФормы = "", МаксГлубина = Неопределено, ТолькоВидимые = Ложь, Компактно = Ложь, ВыводитьGherkin = Истина, ВключатьМеню = Ложь, РежимGherkin = "filled", РежимЛегенды = "full")
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Язык", Ванесса.Объект.ЯзыкГенератораGherkin);
	ПараметрыФормы.Вставить("ТекущийTestclientЭтоWebКлиент", Ванесса.ТекущийTestclientЭтоWebКлиент);
		ПараметрыФормы.Вставить("ВладелецУникальныйИдентификатор", Ванесса.УникальныйИдентификатор);
	ПараметрыФормы.Вставить("MCPРежимЧтенияФормы", Истина);
	ПараметрыФормы.Вставить("MCPФорматЧтенияФормы", ФорматВывода);
	ПараметрыФормы.Вставить("ТолькоТаблицаФормы", ИмяТаблицыФормы);
	
	// Параметры чтения передаются напрямую в MCPПолучитьРезультатЧтенияФормы,
	// чтобы не добавлять новые реквизиты в форму ИсследовательФормы.
	ПараметрыЧтения = Новый Структура;
	ПараметрыЧтения.Вставить("ФорматЧтенияФормы", ФорматВывода);
	ПараметрыЧтения.Вставить("ТолькоТаблицаФормы", ИмяТаблицыФормы);
	ПараметрыЧтения.Вставить("ТолькоГруппаФормы", ИмяГруппыФормы);
	ПараметрыЧтения.Вставить("МаксГлубина", МаксГлубина);
	ПараметрыЧтения.Вставить("ТолькоВидимые", ТолькоВидимые);
	ПараметрыЧтения.Вставить("КомпактныйВывод", Компактно);
	ПараметрыЧтения.Вставить("ВключатьМеню", ВключатьМеню);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КонтекстMCP", КонтекстMCP);
	ДополнительныеПараметры.Вставить("MCPФорматВывода", ФорматВывода);
	ДополнительныеПараметры.Вставить("MCPКомпактныйВывод", Компактно);
	ДополнительныеПараметры.Вставить("MCPВыводитьGherkin", ВыводитьGherkin);
	ДополнительныеПараметры.Вставить("MCPРежимGherkin", РежимGherkin);
	ДополнительныеПараметры.Вставить("MCPРежимЛегенды", РежимЛегенды);
	
	//ОписаниеОповещения = Новый ОписаниеОповещения("MCPПолученАнализФормы", ЭтаФорма, ДополнительныеПараметры);
	//ОткрытьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.ИсследовательФормы", ПараметрыФормы, Ванесса, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИсследовательФормы = ПолучитьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.ИсследовательФормы",ПараметрыФормы,Ванесса);
	Данные = ИсследовательФормы.MCPПолучитьРезультатЧтенияФормы(ПараметрыЧтения);

	MCPСформироватьОтветАнализаФормы(Данные, ФорматВывода, Компактно, ВыводитьGherkin, РежимGherkin, РежимЛегенды, КонтекстMCP);

КонецПроцедуры

// Формирует Markdown-ответ анализа формы из полученных данных исследователя формы.
// Используется как синхронным вызовом (MCPДанныеИсследователяФормы), так и асинхронным callback (MCPПолученАнализФормы).
&НаКлиенте
Процедура MCPСформироватьОтветАнализаФормы(Данные, ФорматВывода, Компактно = Ложь, ВыводитьGherkin = Истина, РежимGherkin = "filled", РежимЛегенды = "full", КонтекстMCP = Неопределено)

	ДеревоЭлементов = "";
	ШагиТекущегоЭлемента = "";
	КнопокНайдено = Неопределено;

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство("compact") Тогда
			Компактно = Данные.compact;
		КонецЕсли;
		Если Данные.Свойство("buttonsCount") Тогда
			КнопокНайдено = Данные.buttonsCount;
		КонецЕсли;
		Если Данные.Свойство("onlyTableFound") И Данные.onlyTableFound = Ложь Тогда
			Если ЗначениеЗаполнено(Данные.tablesList) Тогда
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица формы <%1> не найдена. Доступные таблицы формы: %2."), Данные.onlyTableName, Данные.tablesList);
			Иначе
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица формы <%1> не найдена. На форме нет таблиц."), Данные.onlyTableName);
			КонецЕсли;
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;
		Если Данные.Свойство("onlyGroupFound") И Данные.onlyGroupFound = Ложь Тогда
			Если ЗначениеЗаполнено(Данные.groupsList) Тогда
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Группа формы <%1> не найдена. Доступные группы формы: %2."), Данные.onlyGroupName, Данные.groupsList);
			Иначе
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Группа формы <%1> не найдена. На форме нет групп."), Данные.onlyGroupName);
			КонецЕсли;
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;
		Если Данные.Свойство("treeText") Тогда
			ДеревоЭлементов = MCPПредставлениеЗначенияДляMarkdown(Данные.treeText);
		КонецЕсли;
		Если Данные.Свойство("stepText") Тогда
			ШагиТекущегоЭлемента = MCPПредставлениеЗначенияДляMarkdown(Данные.stepText);
		КонецЕсли;
	ИначеЕсли Данные <> Неопределено Тогда
		ТекстСообщения = Ванесса.Локализовать("Ошибка чтения результата анализа формы: неожиданный тип результата") + " " + Строка(ТипЗнч(Данные));
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Анализ текущей формы"));
	Строки.Добавить("");

	// Gherkin-состояние строится только в формате full и только если не отключено параметром gherkin=false.
	Если ФорматВывода = "full" И ВыводитьGherkin Тогда
		Попытка
			Ванесса.ПолучитьИзмененияФормыGherkin();
			Gherkin = Ванесса.Объект.СгенерированныйСценарий;
			Gherkin = MCPСжатьGherkinСостояниеФормы(Gherkin, РежимGherkin);
			Если ЗначениеЗаполнено(Gherkin) Тогда
				Строки.Добавить(Ванесса.Локализовать("## Gherkin-состояние формы"));
				Строки.Добавить("```gherkin");
				Строки.Добавить(Gherkin);
				Строки.Добавить("```");
				Строки.Добавить("");
			Иначе
				Строки.Добавить(Ванесса.Локализовать("## Gherkin-состояние формы"));
				Строки.Добавить(Ванесса.Локализовать("Нет данных."));
				Строки.Добавить("");
			КонецЕсли;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("## Gherkin-состояние формы"));
			Строки.Добавить(Ванесса.Локализовать("ошибка:") + " " + ОписаниеОшибки());
			Строки.Добавить("");
		КонецПопытки;
	КонецЕсли;

	Строки.Добавить(Ванесса.Локализовать("## Элементы формы"));
	Если ФорматВывода = "buttons" И КнопокНайдено <> Неопределено И КнопокНайдено = 0 Тогда
		Если Данные.Свойство("onlyTableName") Тогда
			// Счётчик пересчитан по выбранной таблице - сообщение относится к ней, а не к форме целиком.
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("В таблице '%1' кнопки не найдены. Состав формы смотрите через format='elements'."), Данные.onlyTableName));
		ИначеЕсли Данные.Свойство("onlyGroupName") Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("В группе '%1' кнопки не найдены. Состав формы смотрите через format='elements'."), Данные.onlyGroupName));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Кнопки на форме не найдены. Состав формы смотрите через format='elements'; кнопки командного интерфейса окна - инструмент manage_command_interface."));
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ДеревоЭлементов) Тогда
		Строки.Добавить("```text");
		Если Компактно Тогда
			// Меню скрыты, только если они действительно не выводились (для format='buttons' они всегда в дереве).
			МенюСкрыты = Ложь;
			Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("menus") И Данные.menus = Ложь Тогда
				МенюСкрыты = Истина;
			КонецЕсли;
			Легенда = MCPЛегендаКомпактногоВывода(МенюСкрыты, РежимЛегенды);
			Если ЗначениеЗаполнено(Легенда) Тогда
				Строки.Добавить(Легенда);
			КонецЕсли;
		КонецЕсли;
		Строки.Добавить(ДеревоЭлементов);
		Строки.Добавить("```");
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Нет данных."));
	КонецЕсли;

	Если ФорматВывода = "full" И ВыводитьGherkin И ЗначениеЗаполнено(ШагиТекущегоЭлемента) Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Часто используемые шаги для текущего элемента"));
		Строки.Добавить("```gherkin");
		Строки.Добавить(ШагиТекущегоЭлемента);
		Строки.Добавить("```");
	КонецЕсли;

	Если ФорматВывода = "full" Тогда
		Попытка
			АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Исключение
		КонецПопытки;

		Если АктивноеОкно <> Неопределено Тогда
			CообщенияПользователю = ПолучитьСообщенияПользователюИзОкна(АктивноеОкно);
			Если CообщенияПользователю = Неопределено Тогда
				Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В окне <%1> нет сообщений пользователю."), АктивноеОкно.Заголовок));
			Иначе
				Строки.Добавить(Ванесса.Локализовать("Обнаружены сообщения пользователю:"));
				Для Каждого Стр Из CообщенияПользователю Цикл
					Строки.Добавить(Стр);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	MCPЗавершитьВызовУспешно(КонтекстMCP, Ванесса._СтрСоединить(Строки, Символы.ПС));

КонецПроцедуры

// Асинхронный callback для получения анализа формы. Сохранён как экспортный — может вызываться внешним кодом.
&НаКлиенте
Процедура MCPПолученАнализФормы(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДополнительныеПараметры);
	ФорматВывода = ДополнительныеПараметры.MCPФорматВывода;
	
	Компактно = Ложь;
	Если ДополнительныеПараметры.Свойство("MCPКомпактныйВывод") Тогда
		Компактно = ДополнительныеПараметры.MCPКомпактныйВывод;
	КонецЕсли;
	
	ВыводитьGherkin = Истина;
	Если ДополнительныеПараметры.Свойство("MCPВыводитьGherkin") Тогда
		ВыводитьGherkin = ДополнительныеПараметры.MCPВыводитьGherkin;
	КонецЕсли;
	
	РежимGherkin = "filled";
	Если ДополнительныеПараметры.Свойство("MCPРежимGherkin") Тогда
		РежимGherkin = ДополнительныеПараметры.MCPРежимGherkin;
	КонецЕсли;
	
	РежимЛегенды = "full";
	Если ДополнительныеПараметры.Свойство("MCPРежимЛегенды") Тогда
		РежимЛегенды = ДополнительныеПараметры.MCPРежимЛегенды;
	КонецЕсли;

	MCPСформироватьОтветАнализаФормы(РезультатЗакрытия, ФорматВывода, Компактно, ВыводитьGherkin, РежимGherkin, РежимЛегенды, КонтекстMCP);

КонецПроцедуры

// Сжимает Gherkin-состояние формы по режиму gherkin_mode: 'all' - без изменений,
// 'filled' - скрываются строки с пустыми значениями, 'compact' - ещё и декорации-заглушки.
&НаКлиенте
Функция MCPСжатьGherkinСостояниеФормы(Текст, Режим = "filled")
	
	Если Режим = "all" Или НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	
	СтрокиГеркин = Ванесса._СтрРазделить(Текст, Символы.ПС, Ложь);
	Результат = Новый Массив;
	Для Каждого Стр Из СтрокиГеркин Цикл
		Если MCPGherkinСтрокаСкрывается(Стр, Режим) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Стр);
	КонецЦикла;
	
	ТекстРезультата = Ванесса._СтрСоединить(Результат, Символы.ПС);
	Если НЕ ЗначениеЗаполнено(СокрЛП(ТекстРезультата)) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат ТекстРезультата;
	
КонецФункции

// Проверяет, скрывается ли строка Gherkin-состояния: только строки с «стал равен» и значением в кавычках.
// Многострочные значения (формат |'...'|) и прочие шаги не трогаются.
&НаКлиенте
Функция MCPGherkinСтрокаСкрывается(Стр, Режим)
	
	Позиция = Найти(Стр, "стал равен ");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Остаток = Сред(Стр, Позиция + СтрДлина("стал равен "));
	Кавычка = """";
	Если СтрДлина(Остаток) < 2 Или Лев(Остаток, 1) <> Кавычка Или Прав(Остаток, 1) <> Кавычка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Значение = Сред(Остаток, 2, СтрДлина(Остаток) - 2);
	Если MCPGherkinПустоеЗначение(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Режим = "compact" И MCPGherkinДекорацияЗаглушка(Стр, Значение);
	
КонецФункции

// Пустое значение: пустая строка, маска из пробелов/двоеточий/точек или пустая дата 01.01.0001.
&НаКлиенте
Функция MCPGherkinПустоеЗначение(Значение)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Лев(Значение, 10) = "01.01.0001" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Маска = СтрЗаменить(Значение, ":", "");
	Маска = СтрЗаменить(Маска, ".", "");
	Маска = СтрЗаменить(Маска, Символ(160), " ");
	Возврат НЕ ЗначениеЗаполнено(СокрЛП(Маска));
	
КонецФункции

// Заглушка декорации: значение строки совпадает с именем декорации.
&НаКлиенте
Функция MCPGherkinДекорацияЗаглушка(Стр, Значение)
	
	ПозицияИмени = Найти(Стр, "с именем '");
	Если ПозицияИмени = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачалоИмени = ПозицияИмени + СтрДлина("с именем '");
	Хвост = Сред(Стр, НачалоИмени);
	ПозицияКонца = Найти(Хвост, "'");
	Если ПозицияКонца = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяЭлемента = Лев(Хвост, ПозицияКонца - 1);
	Если Найти(НРег(ИмяЭлемента), "декорация") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НРег(Значение) = НРег(ИмяЭлемента);
	
КонецФункции

// Легенда компактного вывода дерева формы (параметр compact): расшифровка колонок строк.
// Одна строка: легенда выводится при каждом дереве, а её содержание стабильно.
&НаКлиенте
Функция MCPЛегендаКомпактногоВывода(МенюСкрыты = Ложь, Режим = "full")
	
	Если Режим = "none" Тогда
		Если МенюСкрыты Тогда
			Возврат "меню скрыты (include_menus=true - показать)";
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	
	Если Режим = "short" Тогда
		Легенда = "# Компактный вывод: <отступ> <код типа><состояние> <заголовок> [имя]; типы: О окно, Ф форма, Г группа, К кнопка, П поле, Т таблица, Д декорация, И КИ, к/г кнопка/группа КИ, п дополнение, ? прочий тип; состояние: + видим, ~ невидим, R только просмотр, - невидим и только просмотр (у групп - только видимость); имя: [=] как заголовок, [] пусто, [^Хвост] через родителя; отступ от формы; полная легенда - legend='full', подробный формат - compact=false";
	Иначе
		Легенда = "# Компактный вывод: <отступ> <код типа><состояние> <заголовок> [имя]; типы: О окно, Ф форма, Г группа, К кнопка, П поле, Т таблица, Д декорация, И командный интерфейс, к/г кнопка/группа КИ, п дополнение, ?<полное имя типа> (код опущен, если совпал с соседом того же уровня); состояние: + видим, ~ невидим, R видим и только просмотр, - невидим и только просмотр (у окна, формы и КИ состояния нет, у групп - только видимость); имя: [=] как заголовок, [] пустое, [^Хвост] через родителя, [^ Хвост] через родителя и ""__""; сокращение - только когда имя родителя является началом имени, иначе имя выводится полностью; у колонок имя полное; отступ отсчитан от формы (при only_group - от группы, при only_table - от таблицы); compact=false - подробный формат";
	КонецЕсли;
	Если МенюСкрыты Тогда
		Легенда = Легенда + "; меню скрыты (include_menus=true - показать)";
	КонецЕсли;
	Возврат Легенда;
	
КонецФункции

