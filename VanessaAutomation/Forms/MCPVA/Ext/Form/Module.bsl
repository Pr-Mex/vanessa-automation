КонецФункции

&НаКлиенте
Процедура БуферОбменаТекстЗаписан(Результат, ПараметрыВызова, ДопПараметры) Экспорт

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		Если Результат = Ложь Тогда
			MCPЗавершитьИнструментБуфераСОшибкой(ДопПараметры, Ванесса.Локализовать("Не удалось поместить текст в буфер обмена: возможно, буфер занят другим приложением. Повторите вызов."));
			Возврат;
		КонецЕсли;

		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("# Текст помещён в буфер обмена"));
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Передано символов: %1."), ДопПараметры.ДлинаТекста));
		Строки.Добавить(Ванесса.Локализовать("Активизируйте окно-приёмник (activate_process_os) и вставьте текст сочетанием Ctrl+V (manage_uiautomation, action='press_keys')."));
		MCPЗавершитьИнструментБуфераУспешно(ДопПараметры, Ванесса._СтрСоединить(Строки, Символы.ПС));

	Исключение
		MCPЗавершитьИнструментБуфераСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура БуферОбменаТекстПрочитан(Значение, ДопПараметры) Экспорт

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		ТекстБуфера = Значение;
		Если ТекстБуфера = Null ИЛИ ТекстБуфера = Неопределено Тогда
			ТекстБуфера = "";
		КонецЕсли;
		ТекстБуфера = Строка(ТекстБуфера);

		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("# Текстовое содержимое буфера обмена"));

		Если СтрДлина(ТекстБуфера) = 0 Тогда
			// Пустая строка возможна и когда буфер занят другим приложением, и когда в буфере не текст, а картинка или файлы
			Строки.Добавить(Ванесса.Локализовать("Текста в буфере обмена нет: буфер пуст, содержит не текст или занят другим приложением."));
		Иначе
			МаксимальнаяДлинаВывода = 100000;
			Если СтрДлина(ТекстБуфера) > МаксимальнаяДлинаВывода Тогда
				ТекстБуфера = Лев(ТекстБуфера, МаксимальнаяДлинаВывода);
				Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Показаны первые %1 символов."), МаксимальнаяДлинаВывода));
			КонецЕсли;
			Строки.Добавить(ТекстБуфера);
		КонецЕсли;

		MCPЗавершитьИнструментБуфераУспешно(ДопПараметры, Ванесса._СтрСоединить(Строки, Символы.ПС));

	Исключение
		MCPЗавершитьИнструментБуфераСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура БуферОбменаОчищен(Результат, ПараметрыВызова, ДопПараметры) Экспорт

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		Если Результат = Ложь Тогда
			MCPЗавершитьИнструментБуфераСОшибкой(ДопПараметры, Ванесса.Локализовать("Не удалось очистить буфер обмена: возможно, буфер занят другим приложением. Повторите вызов."));
			Возврат;
		КонецЕсли;

		MCPЗавершитьИнструментБуфераУспешно(ДопПараметры, Ванесса.Локализовать("# Буфер обмена очищен"));

	Исключение
		MCPЗавершитьИнструментБуфераСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

// Завершает вызов инструмента manage_clipboard успешно и освобождает идентификатор задачи
&НаКлиенте
Процедура MCPЗавершитьИнструментБуфераУспешно(ДопПараметры, ТекстОтвета)

	МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(ДопПараметры.MCPИдентификаторЗапроса, MCPТекстБезНедопустимыхСимволовXML(ТекстОтвета));
	MCPОсвободитьЗадачуБуфераОбмена(ДопПараметры);

