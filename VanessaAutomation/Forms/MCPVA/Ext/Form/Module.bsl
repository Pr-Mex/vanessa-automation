КонецФункции

// Внутренняя функция для нажатия кнопки формы
&НаКлиенте
Функция НажатьКнопкуФормы(ИмяЭлемента, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'click_button' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			Ванесса.ВОткрытойФормеВТЧЯНажимаюНаКнопкуСЗаголовком(ИмяТаблицы, ИмяЭлемента, Истина, ДопПараметры);
		Иначе
			ДопПараметры.Вставить("ДополнитьОшибкуПоискаКнопки", Истина);
			Кнопка = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,Тип("ТестируемаяКнопкаФормы"),ДопПараметры);

			Если Кнопка = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Кнопка '%1' не найдена."), ИмяЭлемента);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			Кнопка.Нажать();
		КонецЕсли;
		
		Если ПослеНажатияНаКнопкуНадоСделатьПаузу(ИмяЭлемента) Тогда
			Ванесса.sleep(1);
		КонецЕсли;
		
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Кнопка '%1' была успешно нажата."), ИмяЭлемента));
		
		Попытка
			ОкноМодальногоДиалога = Ванесса.НайтиОкноМодальногоДиалога();
			Если ОкноМодальногоДиалога <> Неопределено Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("После нажатия кнопки появился модальный диалог."));
				
				ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога);
			КонецЕсли;	
		Исключение
		КонецПопытки;
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		
		ТекстОшибки = Ванесса.Локализовать("Ошибка нажатия кнопки:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Находит модальный диалог перебором окон клиентского приложения (основное окно пропускается).
// Окна интерактивного выбора (Выбор типа данных, Список значений) возвращаются только при ВключатьОкнаВыбора:
// с ними работает вызывающая сторона, поэтому цепочка действий их диалогами не считает.
&НаКлиенте
Функция MCPНайтиОкноМодальногоДиалога(ВключатьОкнаВыбора = Ложь)
	
	Попытка
		ОкнаПриложения = Ванесса.ОбъектКонтекстСохраняемый.ТестовоеПриложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Для Каждого ТекОкно Из ОкнаПриложения Цикл
		Попытка
			Если ТекОкно.Основное Тогда
				Продолжить;
			КонецЕсли;
			ЗаголовокОкна = СокрЛП(Строка(ТекОкно.Заголовок));
			Если ЗаголовокОкна = "Выбор типа данных" ИЛИ ЗаголовокОкна = "Список значений" Тогда
				Если ВключатьОкнаВыбора Тогда
					Возврат ТекОкно;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ЗаголовокОкна = "Данные были изменены" ИЛИ ЗаголовокОкна = "Предупреждение безопасности"
				ИЛИ Ванесса.ЭтоМодальныйДиалог(ТекОкно) Тогда
				Возврат ТекОкно;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Находит модальный диалог, блокирующий цепочку действий.
// Окна интерактивного выбора (Выбор типа данных, Список значений) пропускаются - с ними работает вызывающая сторона.
&НаКлиенте
Функция MCPОкноМодальногоДиалогаЦепочки()
	
	Возврат MCPНайтиОкноМодальногоДиалога();
	
КонецФункции

// Текст модального диалога из указанного окна; если текст получить не удалось - пустая строка.
&НаКлиенте
Функция MCPТекстМодальногоДиалога(ОкноМодальногоДиалога)
	
	Попытка
		Возврат СокрЛП(Строка(Ванесса.ТекстПредупреждения(ОкноМодальногоДиалога)));
	Исключение
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

// Список заголовков видимых кнопок модального диалога (для подсказки вызывающей стороне).
&НаКлиенте
Функция MCPКнопкиМодальногоДиалога(ОкноМодальногоДиалога)
	
	Результат = Новый Массив;
	Попытка
		Для Каждого ТекКнопка Из ОкноМодальногоДиалога.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
			Если ТекКнопка.ТекущаяВидимость() Тогда
				Результат.Добавить(СокрЛП(Строка(ТекКнопка.ТекстЗаголовка)));
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Нажимает кнопку модального диалога по заголовку (или имени).
// Возвращает текст результата (Строка) или структуру с полем ТекстОшибки.
&НаКлиенте
Функция MCPНажатьКнопкуМодальногоДиалога(ОкноМодальногоДиалога, ЗаголовокКнопки)
	
	НайденныеКнопки = Новый Массив;
	ДоступныеКнопки = MCPКнопкиМодальногоДиалога(ОкноМодальногоДиалога);
	ИскомоеЗначение = НРег(СокрЛП(ЗаголовокКнопки));
	
	Попытка
		Для Каждого ТекКнопка Из ОкноМодальногоДиалога.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
			Если НЕ ТекКнопка.ТекущаяВидимость() Тогда
				Продолжить;
			КонецЕсли;
			Если НРег(СокрЛП(Строка(ТекКнопка.ТекстЗаголовка))) = ИскомоеЗначение
				ИЛИ НРег(СокрЛП(Строка(ТекКнопка.Имя))) = ИскомоеЗначение Тогда
				НайденныеКнопки.Добавить(ТекКнопка);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Если НайденныеКнопки.Количество() = 0 Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Кнопка '%1' не найдена в модальном диалоге."), ЗаголовокКнопки);
		Если ДоступныеКнопки.Количество() > 0 Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса.Локализовать("Доступные кнопки: ")
				+ Ванесса._СтрСоединить(ДоступныеКнопки, ", ");
		КонецЕсли;
		Возврат Новый Структура("ТекстОшибки", ТекстОшибки);
	ИначеЕсли НайденныеКнопки.Количество() > 1 Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В модальном диалоге несколько кнопок с заголовком или именем '%1'. Уточните кнопку."), ЗаголовокКнопки)
			+ Символы.ПС + Ванесса.Локализовать("Доступные кнопки: ") + Ванесса._СтрСоединить(ДоступныеКнопки, ", ");
		Возврат Новый Структура("ТекстОшибки", ТекстОшибки);
	КонецЕсли;
	
	// Чтение и нажатие в Попытке: окно может закрыться между поиском кнопок и нажатием
	Попытка
		ТекстДиалога = MCPТекстМодальногоДиалога(ОкноМодальногоДиалога);
		ЗаголовокНажатойКнопки = СокрЛП(Строка(НайденныеКнопки[0].ТекстЗаголовка));
		НайденныеКнопки[0].Нажать();
	Исключение
		Возврат Новый Структура("ТекстОшибки", Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Не удалось ответить на модальный диалог кнопкой '%1': %2"),
			ЗаголовокКнопки, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки())));
	КонецПопытки;
	
	MCPОжидатьЗакрытияМодальногоДиалога();
	Попытка
		Ванесса.ОбработатьСменуАктивногоОкна();
	Исключение
	КонецПопытки;
	
	ТекстРезультата = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Модальный диалог: нажата кнопка '%1'."), ЗаголовокНажатойКнопки);
	Если ЗначениеЗаполнено(ТекстДиалога) Тогда
		ТекстРезультата = ТекстРезультата + " " + Ванесса.Локализовать("Текст диалога: ") + ТекстДиалога;
	КонецЕсли;
	
	Возврат ТекстРезультата;
	
КонецФункции

// Ожидает закрытия модального диалога после нажатия кнопки (не более 5 секунд).
// Критерий тот же, что у паузы цепочки: окна выбора диалогами не считаются и ожидание не затягивают.
&НаКлиенте
Процедура MCPОжидатьЗакрытияМодальногоДиалога()
	
	Для Сч = 1 По 5 Цикл
		Если MCPОкноМодальногоДиалогаЦепочки() = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Ванесса.sleep(1);
	КонецЦикла;
	
КонецПроцедуры

// Находит модальный диалог для действия manage_modal_dialog.
// В отличие от поиска для цепочки окна выбора (Выбор типа данных, Список значений) считаются диалогами.
&НаКлиенте
Функция MCPОкноМодальногоДиалогаДействия()
	
	Возврат MCPНайтиОкноМодальногоДиалога(Истина);
	
КонецФункции

// Действие manage_modal_dialog: отвечает на модальный диалог нажатием кнопки.
&НаКлиенте
Функция ОтветитьНаМодальныйДиалогMCP(ЗаголовокКнопки, ОжидаемыйТекст = "", НеобязательноеДействие = Ложь)
	
	ЗаголовокКнопки = СокрЛП(ЗаголовокКнопки);
	Если НЕ ЗначениеЗаполнено(ЗаголовокКнопки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Для действия 'manage_modal_dialog' необходимо указать параметр element_name - заголовок или имя кнопки модального диалога."));
	КонецЕсли;
	
	// Основное окно диалогом не считаем - ищем перебором всех окон, а не первым подходящим
	ОкноМодальногоДиалога = MCPОкноМодальногоДиалогаДействия();
	
	Если ОкноМодальногоДиалога = Неопределено Тогда
		Если НеобязательноеДействие Тогда
			Возврат Ванесса.Локализовать("Модальный диалог не найден. Действие пропущено (optional=true).");
		КонецЕсли;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Модальный диалог не найден. Ожидалось, что платформа задаст вопрос, но форма продолжает работу без вопроса."));
	КонецЕсли;
	
	ТекстДиалога = MCPТекстМодальногоДиалога(ОкноМодальногоДиалога);
	Если ЗначениеЗаполнено(ОжидаемыйТекст)
		И Найти(НРег(ТекстДиалога), НРег(СокрЛП(ОжидаемыйТекст))) = 0 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Текст модального диалога не содержит '%1'."), ОжидаемыйТекст)
			+ Символы.ПС + Ванесса.Локализовать("Текст диалога: ") + ТекстДиалога
			+ Символы.ПС + Ванесса.Локализовать("Кнопки модального диалога: ")
			+ Ванесса._СтрСоединить(MCPКнопкиМодальногоДиалога(ОкноМодальногоДиалога), ", "));
	КонецЕсли;
	
	РезультатНажатия = MCPНажатьКнопкуМодальногоДиалога(ОкноМодальногоДиалога, ЗаголовокКнопки);
	Если ТипЗнч(РезультатНажатия) = Тип("Структура") Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", РезультатНажатия.ТекстОшибки);
	КонецЕсли;
	
	Возврат РезультатНажатия;
	
КонецФункции

// Проверяет модальный диалог перед очередным действием цепочки и после него.
// Возвращает структуру с полями: Приостановить, ОкноМодальногоДиалога.
&НаКлиенте
Функция MCPОбработатьМодальныйДиалогВЦепочке(ТипДействия)
	
	РезультатПроверки = Новый Структура("Приостановить, ОкноМодальногоДиалога", Ложь, Неопределено);
	
	ОкноМодальногоДиалога = MCPОкноМодальногоДиалогаЦепочки();
	Если ОкноМодальногоДиалога = Неопределено Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатПроверки.ОкноМодальногоДиалога = ОкноМодальногоДиалога;
	
	// Действие manage_modal_dialog само отвечает на диалог - цепочку не останавливаем
	Если ТипДействия = "manage_modal_dialog" Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатПроверки.Приостановить = Истина;
	Возврат РезультатПроверки;
	
КонецФункции

// Текст результата "цепочка действий приостановлена: открыт модальный диалог" (обычный результат, не ошибка).
// ОшибкаДействия - результат упавшего действия (структура) или Неопределено.
&НаКлиенте
Функция MCPТекстПриостановкиЦепочки(СтрокиРезультата, МассивДействий, ИндексДействия, ОкноМодальногоДиалога, Причина = "", ОшибкаДействия = Неопределено)
	
	ВсегоДействий = МассивДействий.Количество();
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Выполнение последовательности действий приостановлено: открыт модальный диалог"));
	Строки.Добавить("");
	// Копируем накопленные строки без первой шапки - ее заменяет шапка о приостановке
	Для ИндексСтроки = 2 По СтрокиРезультата.Количество() - 1 Цикл
		Строки.Добавить(СтрокиРезультата[ИндексСтроки]);
	КонецЦикла;
	
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Выполнено действий: %1 из %2. Осталось: %3."), ИндексДействия, ВсегоДействий, ВсегоДействий - ИндексДействия));
	
	Строки.Добавить("");
	ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога);
	
	Если ЗначениеЗаполнено(Причина) Тогда
		Строки.Добавить(Ванесса.Локализовать("Причина остановки: ") + Причина);
		Строки.Добавить("");
	КонецЕсли;
	Если ОшибкаДействия <> Неопределено Тогда
		Попытка
			ТекстОшибкиДействия = Ванесса.ЗаписатьОбъектJSON(ОшибкаДействия);
		Исключение
			ТекстОшибкиДействия = Ванесса.Локализовать("Данные результата действия не удалось представить в JSON.");
		КонецПопытки;
		Если ЗначениеЗаполнено(ТекстОшибкиДействия) Тогда
			Строки.Добавить(Ванесса.Локализовать("Результат последнего действия: ") + ТекстОшибкиДействия);
			Строки.Добавить("");
		КонецЕсли;
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("Чтобы закрыть ожидаемый диалог, вставьте в цепочку действие manage_modal_dialog (element_name - заголовок или имя кнопки диалога) сразу после действия, вызывающего диалог. Ответить на уже открытый диалог можно вызовом manage_form_elements с action='manage_modal_dialog'."));
	Если ИндексДействия >= ВсегоДействий И ВсегоДействий > 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Все действия цепочки выполнены, но открылся модальный диалог. Ответьте на него вызовом manage_form_elements (action='manage_modal_dialog', element_name - заголовок или имя кнопки) - повторять цепочку не нужно."));
	ИначеЕсли ИндексДействия > 0 Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Действия 1..%1 уже выполнены - повторять их не нужно. После ответа на диалог запустите остаток цепочки."), ИндексДействия));
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Ни одно действие цепочки не выполнено. Сначала ответьте на диалог, затем запустите цепочку."));
	КонецЕсли;
	
	// Машиночитаемый статус: выполненная часть, диалог и остаток цепочки
	ОстатокДействий = Новый Массив;
	Для Сч = ИндексДействия По ВсегоДействий - 1 Цикл
		ОстатокДействий.Добавить(МассивДействий[Сч]);
	КонецЦикла;
	
	// Заголовок в Попытке: окно могло закрыться между обнаружением диалога и формированием ответа
	ЗаголовокДиалога = "";
	Попытка
		ЗаголовокДиалога = СокрЛП(Строка(ОкноМодальногоДиалога.Заголовок));
	Исключение
	КонецПопытки;
	ОписаниеДиалога = Новый Структура;
	ОписаниеДиалога.Вставить("заголовок", ЗаголовокДиалога);
	ОписаниеДиалога.Вставить("текст", MCPТекстМодальногоДиалога(ОкноМодальногоДиалога));
	ОписаниеДиалога.Вставить("кнопки", MCPКнопкиМодальногоДиалога(ОкноМодальногоДиалога));
	
	СтатусЦепочки = Новый Структура;
	СтатусЦепочки.Вставить("status", "paused_modal_dialog");
	СтатусЦепочки.Вставить("executed", ИндексДействия);
	СтатусЦепочки.Вставить("total", ВсегоДействий);
	СтатусЦепочки.Вставить("dialog", ОписаниеДиалога);
	СтатусЦепочки.Вставить("remainder", ОстатокДействий);
	
	ТекстJSON = "";
	Попытка
		ТекстJSON = Ванесса.ЗаписатьОбъектJSON(СтатусЦепочки);
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(ТекстJSON) Тогда
		Строки.Добавить("");
		Строки.Добавить("```json");
		Строки.Добавить(ТекстJSON);
		Строки.Добавить("```");
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Внутренняя функция для ввода текста в поле
&НаКлиенте
Функция ВвестиТекстВПоле(ИмяЭлемента, Значение, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'input_text' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'input_text' необходимо указать параметр value.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);

	Таблица = Неопределено;
	Поле = Неопределено;

	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			// Колонка принимается заголовком или внутренним именем поля формы.
			СведенияОКолонке = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
			Таблица = СведенияОКолонке.Таблица;
			Если СведенияОКолонке.Колонка = Неопределено Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", СведенияОКолонке.ТекстОшибки);
			КонецЕсли;

			ВыделеноБольшеОднойСтроки = Ложь;
			Попытка
				ВыделенныеСтроки = Таблица.ПолучитьВыделенныеСтроки();
				Если ВыделенныеСтроки.Количество() > 1 Тогда
					ВыделеноБольшеОднойСтроки = Истина;
				КонецЕсли;
			Исключение
			КонецПопытки;

			Если ВыделеноБольшеОднойСтроки Тогда
				ТекстОшибки = Ванесса.Локализовать("В таблице выделено больше одной строки. Редактирование не возможно.");
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;

			// Поле ищется заранее, чтобы старт редактирования шёл с целевой (редактируемой) ячейки.
			ПолеЦели = СведенияОКолонке.Колонка;
			Поле = ПолеЦели;

			ТекстОшибкиРежима = ОбеспечитьРежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы, ПолеЦели);
			Если ЗначениеЗаполнено(ТекстОшибкиРежима) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиРежима);
			КонецЕсли;

			Ванесса.ВОткрытойФормеВТЧВПолеСЗаголовкомЯВвожуТекст(ИмяТаблицы, ПолеЦели.Имя, Значение, Истина, ДопПараметры);
			Возврат Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Текст '%1' был успешно введен в поле '%2'. Строка открыта на редактирование - при необходимости вызовите 'end_edit_row'."), Значение, ИмяЭлемента);
		Иначе
			Поле = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
			Поле.ВвестиТекст(Значение);
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Текст '%1' был успешно введен в поле '%2'."), Значение, ИмяЭлемента);
		КонецЕсли;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка ввода текста:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ДаннымиПоляMCP(Поле, ИмяЭлемента, ТекстОшибки);
		ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		MCPДополнитьОшибкуПоСостояниюПоляMCP(Поле, ТекстОшибки, Ванесса.Локализовать("Ошибка ввода текста"));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Внутренняя функция для открытия выпадающего списка
&НаКлиенте
Функция ОткрытьВыпадающийСписок(ИмяЭлемента, ИмяТаблицы, ОткрыватьСписок)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'open_dropdown' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Поле = Неопределено;
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			// Колонка принимается заголовком или внутренним именем поля формы.
			СведенияОКолонке = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
			Таблица = СведенияОКолонке.Таблица;
			Если СведенияОКолонке.Колонка = Неопределено Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", СведенияОКолонке.ТекстОшибки);
			КонецЕсли;
			Поле = СведенияОКолонке.Колонка;
			
			Если ОткрыватьСписок Тогда
				Поле.Активизировать();
				
				Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
					Таблица.ИзменитьСтроку();
				КонецЕсли;
			КонецЕсли;
		Иначе
			Поле = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
		КонецЕсли;
		
		Если Поле = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено."), ИмяЭлемента);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		Если ОткрыватьСписок Тогда
			Если НЕ Поле.ВыпадающийСписокОткрыт() Тогда
				Поле.ОткрытьВыпадающийСписок();
			КонецЕсли;
			Поле.ОжидатьФормированияВыпадающегоСписка(Ванесса.ЗначениеТаймаутаДляАсинхронногоШага(3));
		Иначе
			// После ввода текста в ссылочное поле с вводом по строке список наполняется асинхронно.
			// Без ожидания чтение вернёт пустой список; для перечислений ожидание завершается мгновенно.
			// Пустое поле список не наполняет, поэтому ждём только при введённом тексте.
			Попытка
				Если Поле.ВыпадающийСписокОткрыт() И ЗначениеЗаполнено(Поле.ПолучитьТекстРедактирования()) Тогда
					Поле.ОжидатьФормированияВыпадающегоСписка(Ванесса.ЗначениеТаймаутаДляАсинхронногоШага(3));
				КонецЕсли;
			Исключение
				// У полей без выпадающего списка (кнопки, надписи) метод недоступен - читаем список как есть
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			ПредставлениеСпискаВыбора = Ванесса.ДополнитьПредставлениеСпискаВыбора(Поле.ПолучитьПредставлениеСпискаВыбора());
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Не вышло получить представление открытого списка выбора <%1>.");
			ТекстОшибки = СтрЗаменить(ТекстОшибки,"%1",ИмяЭлемента);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
		Строки = Новый Массив;
		Если ОткрыватьСписок Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Выпадающий список поля '%1' был успешно открыт."), ИмяЭлемента));
			Строки.Добавить(Ванесса.Локализовать("Содержимое списка:"));
		Иначе
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Содержимое списка '%1'."), ИмяЭлемента));
		КонецЕсли;	
		Для Каждого Элем Из ПредставлениеСпискаВыбора Цикл
			Строки.Добавить("  -" + Элем.ОтображаемыйТекст);
		КонецЦикла;	
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка открытия выпадающего списка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		// Подсказка по состоянию - только для самого открытия списка: у get_dropdown_state
		// ошибки связаны с асинхронным наполнением, а не с видимостью поля.
		Если ОткрыватьСписок Тогда
			MCPДополнитьОшибкуПоСостояниюПоляMCP(Поле, ТекстОшибки, Ванесса.Локализовать("Ошибка открытия выпадающего списка"));
		КонецЕсли;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для выбора из выпадающего списка
&НаКлиенте
Функция ВыбратьИзВыпадающегоСписка(ИмяЭлемента, Значение, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'select_from_dropdown' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'select_from_dropdown' необходимо указать параметр value.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Поле = Неопределено;
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			// Колонка принимается заголовком или внутренним именем поля формы.
			СведенияОКолонке = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
			Таблица = СведенияОКолонке.Таблица;
			Если СведенияОКолонке.Колонка = Неопределено Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", СведенияОКолонке.ТекстОшибки);
			КонецЕсли;
			Поле = СведенияОКолонке.Колонка;
			
		Иначе
			Поле = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
		КонецЕсли;
		
		Если Поле = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено."), ИмяЭлемента);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;

		// После ввода текста в ссылочное поле с вводом по строке список наполняется асинхронно:
		// дожидаемся формирования, иначе выбор из ещё пустого списка завершится ошибкой.
		Попытка
			Если Поле.ВыпадающийСписокОткрыт() Тогда
				Поле.ОжидатьФормированияВыпадающегоСписка(Ванесса.ЗначениеТаймаутаДляАсинхронногоШага(3));
			КонецЕсли;
		Исключение
			// У полей без выпадающего списка (кнопки, надписи) метод недоступен - выбор выполняем как есть
		КонецПопытки;

		Если НЕ Поле.ВыпадающийСписокОткрыт() Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Нельзя сделать выбор из выпадающего списка '%1' т.к. он не открыт."), ИмяЭлемента);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		Поле.ВыполнитьВыборИзВыпадающегоСписка(Значение);
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Значение '%1' было успешно выбрано из выпадающего списка поля '%2'."), Значение, ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка выбора из списка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ЗначениеОткрытогоСписка(Поле, ТекстОшибки);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для установки значения в поле
&НаКлиенте
Функция УстановитьЗначениеВПоле(ИмяЭлемента, Значение, ИмяТаблицы, ТочноеСовпадение)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'set_value' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'set_value' необходимо указать параметр value.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	// Колонка может быть указана заголовком: приводим её к внутреннему имени до зонда,
	// чтобы зонд, шаг выбора и откат работали с одним именем.
	ИмяПоляДляШага = ИмяЭлемента;
	Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
		СведенияОКолонке = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
		Если СведенияОКолонке.Колонка = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", СведенияОКолонке.ТекстОшибки);
		КонецЕсли;
		ИмяПоляДляШага = СведенияОКолонке.Колонка.Имя;
	КонецЕсли;
	
	// Поля простых типов (число, строка, дата) списка выбора не имеют: зонд отсекает их
	// до шага выбора, иначе агент получает нечитаемую ошибку шага "выбрать из списка"
	ЕстьСписокВыбора = MCPЕстьВыпадающийСписокУПоля(ИмяПоляДляШага, ИмяТаблицы);
	Если ЕстьСписокВыбора = Ложь Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Поле '%1' не поддерживает выбор из списка (список выбора не формируется). Для простых типов (число, строка, дата) используйте 'input_text' для поля шапки или 'set_cell_text'/'input_text' с table_name для ячейки таблицы."), ИмяЭлемента);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Если ТочноеСовпадение Тогда
				Ванесса.ВТаблицеИзВыпадающегоСпискаЯВыбираюТочноеЗначение(ИмяТаблицы, ИмяПоляДляШага, Значение, Истина, ДопПараметры);
			Иначе	
				Ванесса.ВОткрытойФормеВТЧИзВыпадающегоСпискаСЗаголовкомЯВыбираю(ИмяТаблицы, ИмяПоляДляШага, Значение, Истина, ДопПараметры);
			КонецЕсли;	
		Иначе
			Если ТочноеСовпадение Тогда
				Ванесса.ИзВыпадающегоСпискаЯВыбираюТочноеЗначение(ИмяЭлемента,Значение,Истина,ДопПараметры);
			Иначе
				// выбор по строке
				Ванесса.ВОткрытойФормеИзВыпадающегоСпискаСЗаголовкомЯВыбираю(ИмяЭлемента,Значение,Истина,ДопПараметры);
			КонецЕсли;	
		КонецЕсли;
		
		Возврат MCPТекстУспехаУстановкиЗначения(ИмяЭлемента, ИмяПоляДляШага, ИмяТаблицы, Значение, ТочноеСовпадение);
	Исключение
		ТекстШага = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ЧтоДелатьОшибки = Ванесса.Локализовать("Точное совпадение не найдено: представление значения в списке формы может отличаться от значения в базе (например, ""Самовывоз (с нашего склада)"", ""Admin (Договор)""). Выберите значение его представлением из открытого списка: open_dropdown -> get_dropdown_state -> select_from_dropdown; это же представление можно передать в set_value.");
		ПодсказкаСостоянияПоля = MCPПодсказкаПоСостояниюПоляMCP(
			MCPНайтиПолеДляПодсказкиПоСостояниюMCP(ИмяЭлемента, ИмяТаблицы));
		Если ЗначениеЗаполнено(ПодсказкаСостоянияПоля) Тогда
			ЧтоДелатьОшибки = ЧтоДелатьОшибки + " " + ПодсказкаСостоянияПоля;
		КонецЕсли;
		ДеталиОшибки = MCPVAСлужебныйМодуль.MCPДеталиОшибкиИзТекста(ТекстШага);
		// Шаг выбора сначала печатает текст и лишь потом выбирает из списка: при сбое в поле
		// остаётся незавершённый ввод, который позже фиксируется. Откатываем его.
		ТекстОтката = MCPОтменитьНезавершённыйВводПриОшибке(ИмяПоляДляШага, ИмяТаблицы);
		Если ЗначениеЗаполнено(ТекстОтката) Тогда
			ДеталиОшибки = ДеталиОшибки + Символы.ПС + ТекстОтката;
		КонецЕсли;
		ТекстОшибки = MCPVAСлужебныйМодуль.MCPОформитьОшибку(
			MCPVAСлужебныйМодуль.MCPСутьОшибкиИзТекста(ТекстШага), ЧтоДелатьОшибки, ДеталиОшибки);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
	КонецПопытки;
	
КонецФункции

// Откатывает незавершённый ввод в поле после неудачного выбора значения.
// Возвращает текст-пояснение для сообщения об ошибке.
&НаКлиенте
Функция MCPОтменитьНезавершённыйВводПриОшибке(ИмяЭлемента, ИмяТаблицы)
	// Успех отката определяем по результату самой операции, а не по типу возвращённого значения
	ТекстОшибкиОтката = MCPОтменитьРедактированиеЭлемента(ИмяЭлемента, ИмяТаблицы);
	Если ТекстОшибкиОтката = Неопределено Тогда
		Возврат Ванесса.Локализовать("Незавершённый ввод отменён, значение поля не изменилось.");
	КонецЕсли;
	// Причину показываем в тексте, иначе неясно, что именно помешало откату
	ТекстОшибкиОтката = СокрП(ТекстОшибкиОтката);
	Если Прав(ТекстОшибкиОтката, 1) <> "." Тогда
		ТекстОшибкиОтката = ТекстОшибкиОтката + ".";
	КонецЕсли;
	Возврат Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Откатить незавершённый ввод не удалось: %1 Проверьте значение поля и при необходимости вызовите 'cancel_edit'."),
		ТекстОшибкиОтката);
КонецФункции

// Определяет, поддерживает ли поле выбор из списка: открывает список и ждёт его формирования.
// Возврат: Истина - список есть; Ложь - списка нет; Неопределено - проверить не удалось.
&НаКлиенте
Функция MCPЕстьВыпадающийСписокУПоля(ИмяЭлемента, ИмяТаблицы)
	Поле = Неопределено;
	Таблица = Неопределено;
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Таблица = НайтиТаблицуMCP(ИмяТаблицы);
			Поле = Таблица.НайтиОбъект(,,ИмяЭлемента);
			Если Поле = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Поле.Активизировать();
			Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
				Таблица.ИзменитьСтроку();
			КонецЕсли;
		Иначе
			Поле = НайтиПолеMCP(ИмяЭлемента, Тип("ТестируемоеПолеФормы"));
			Если Поле = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Поле.Активизировать();
		КонецЕсли;
	Исключение
		// Поле не удалось подготовить (например, фокус удерживает другая ячейка): вердикт не выносим,
		// действие отработает как раньше и вернёт штатную диагностику
		Возврат Неопределено;
	КонецПопытки;
	
	Попытка
		СписокОткрыт = Поле.ВыпадающийСписокОткрыт();
	Исключение
		// Метод может бросить исключение, если открылось другое окно: вердикт не выносим
		// (в шаге выбора из списка этот случай также не считается ошибкой)
		Возврат Неопределено;
	КонецПопытки;
	
	Если НЕ СписокОткрыт Тогда
		Попытка
			Поле.ОткрытьВыпадающийСписок();
		Исключение
			// Первый отрицательный сигнал: у поля без списка падает уже открытие
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		СписокСформировался = Поле.ОжидатьФормированияВыпадающегоСписка(Ванесса.ЗначениеТаймаутаДляАсинхронногоШага(10));
	Исключение
		// Второй отрицательный сигнал: список не сформировался
		Возврат Ложь;
	КонецПопытки;
	Если СписокСформировался = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СписокСформировался;
КонецФункции

// Текст успеха установки значения: фактически выбранное представление делает успех проверяемым -
// выбор по строке берёт первый элемент списка, и подставленное значение может отличаться от введённого.
&НаКлиенте
Функция MCPТекстУспехаУстановкиЗначения(ИмяЭлемента, ИмяПоляДляШага, ИмяТаблицы, Значение, ТочноеСовпадение)
	
	ТекстУспеха = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Значение '%1' было успешно установлено в поле '%2'."), Значение, ИмяЭлемента);
	
	// Дополнения к базовому тексту: при сбое чтения представления или склейки успех остаётся успехом.
	Попытка
		ПредставлениеЗначения = MCPПредставлениеУстановленногоЗначения(ИмяПоляДляШага, ИмяТаблицы);
		Если ЗначениеЗаполнено(ПредставлениеЗначения) Тогда
			ТекстУспеха = ТекстУспеха + " " + Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Выбрано из списка: ""%1""."), ПредставлениеЗначения);
			
			// При тексте без совпадений платформа может показать список значений (сообщение "нет в списке"),
			// и тогда выбор по строке молча берёт первый элемент - выбранное представление не содержит введённый текст.
			Если НЕ ТочноеСовпадение И Найти(НРег(ПредставлениеЗначения), НРег(СокрЛП(Строка(Значение)))) = 0 Тогда
				ТекстУспеха = ТекстУспеха + " " + Ванесса.Локализовать("Внимание: в выбранном представлении нет введённого текста - возможно, текст не совпал ни с одним элементом списка, и выбран первый элемент предложенного списка. Проверьте значение; точный выбор: open_dropdown -> get_dropdown_state -> select_from_dropdown.");
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат ТекстУспеха;
	
КонецФункции

// Представление фактически установленного значения поля; пустая строка - прочитать не удалось.
&НаКлиенте
Функция MCPПредставлениеУстановленногоЗначения(ИмяПоляДляШага, ИмяТаблицы)
	Попытка
		Поле = MCPНайтиПолеДляПодсказкиПоСостояниюMCP(ИмяПоляДляШага, ИмяТаблицы);
		Если Поле = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		ПредставлениеЗначенияПоля = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(Поле);
		Если ТипЗнч(ПредставлениеЗначенияПоля) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;
		Возврат СокрЛП(ПредставлениеЗначенияПоля);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Внутренняя функция для открытия формы выбора
&НаКлиенте
Функция ОткрытьФормуВыбора(ИмяЭлемента, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'open_choice_form' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Колонка принимается заголовком или внутренним именем поля формы.
			СведенияОКолонке = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
			Если СведенияОКолонке.Колонка = Неопределено Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", СведенияОКолонке.ТекстОшибки);
			КонецЕсли;
			Ванесса.ВОткрытойФормеВТЧЯНажимаюКнопкуВыбораУРеквизитаСЗаголовком(ИмяТаблицы, СведенияОКолонке.Колонка.Имя, Истина, ДопПараметры);
		Иначе
			Ванесса.ВОткрытойФормеЯНажимаюКнопкуВыбораУПоляСЗаголовком(ИмяЭлемента, Истина, ДопПараметры);
		КонецЕсли;
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Форма выбора для поля '%1' была успешно открыта."), ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка открытия формы выбора:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPДополнитьОшибкуПоСостояниюПоляMCP(
			MCPНайтиПолеДляПодсказкиПоСостояниюMCP(ИмяЭлемента, ИмяТаблицы), ТекстОшибки,
			Ванесса.Локализовать("Ошибка открытия формы выбора"));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для установки переключателя
&НаКлиенте
Функция УстановитьПереключатель(ИмяЭлемента, Значение)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'set_radio_button' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
