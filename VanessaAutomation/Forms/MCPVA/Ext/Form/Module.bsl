&НаКлиенте
Процедура ДополнитьОшибку_НетОкнаMCP(ТекстОшибки) Экспорт
	
	Если НЕ Ванесса.ВыполняетсяВызовMCP() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка = Ванесса.Локализовать("## Окна клиента тестирования:");
	Если Найти(ТекстОшибки, СтрокаЗаголовка) > 0 Тогда
		// Значит уже происходило дополнение текста ошибки.
		Возврат;
	КонецЕсли;
	
	Попытка
		ТипПоля = Тип("ТестируемоеОкноКлиентскогоПриложения");
		ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
		ОкнаКлиентаТестирования = ТестовоеПриложение.НайтиОбъекты(ТипПоля);
		
		Строки = Новый Массив;
		Строки.Добавить("");
		Строки.Добавить(СтрокаЗаголовка);
		Для Каждого ТекОкно Из ОкнаКлиентаТестирования Цикл
			Строки.Добавить("- " + ТекОкно.Заголовок);
			Если Ванесса.ЭтоМодальныйДиалог(ТекОкно) Тогда
				ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ТекОкно);
			КонецЕсли;
		КонецЦикла;
		
		Строки.Добавить("");
		
		СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaAutomation();
		Если СостояниеVanessaAutomation.Свойство("ТекущийШаг") И СостояниеVanessaAutomation.ТекущийШаг.ИдСтроки <> Неопределено Тогда
			СтрокаДерева = Ванесса.СтрокаДереваПоИдСтроки(СостояниеVanessaAutomation.ТекущийШаг.ИДСтроки);
			Если СтрокаДерева <> Неопределено Тогда
				Результат = Новый Массив;
				Ванесса.ПроверкаЭтоШагПроверкиОкнаИПроблемаССимволомЗвездочка(СтрокаДерева, Результат);
				Если Результат.Количество() > 0 Тогда
					Строки.Добавить(Результат[0].Текст);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Заголовок активного окна:") + " " + АктивноеОкно.Заголовок);
		
		ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса._СтрСоединить(Строки);
	Исключение
		Ванесса.ЗаписатьЛогВЖРОшибка("ДополнитьОшибку_НетТаблицыMCP", ОписаниеОшибки());
	КонецПопытки;
	

