Функция ДанныеПанелиФункций(ПанельФункций)
	Возврат MCPVAСлужебныйМодуль.ДанныеПанелиФункций(ПанельФункций);
КонецФункции

&НаКлиенте
Функция НажатьКнопкуПанелиФункций(Запрос)
	Возврат MCPVAСлужебныйМодуль.НажатьКнопкуПанелиФункций(Запрос);
КонецФункции

// Получает информацию о строке сценария. Если в строке находится шаг - то возвращает подробную информацию о шаге.
&НаКлиенте
Функция ПолучитьПодробнуюИнформациюОШагеВСтрокеСценария(Запрос, ДополнительныеПараметры) Экспорт
	
	НомерСтроки = Число(ЗначениеПараметраИзЗапроса(Запрос, "lineNumber"));	
	Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не указан обязательный параметр 'lineNumber'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
	
	ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
	Если СтрокаДерева = Неопределено Тогда
		Попытка
			ПолныйТекст = ЭкземплярVanessaEditor.getContent();
			Если НЕ ЗначениеЗаполнено(ПолныйТекст) Тогда
				ПолныйТекст = "";
			КонецЕсли;	
			КоличествоСтрок = Ванесса._СтрРазделить(ПолныйТекст, Символы.ПС).Количество();
			Если НомерСтроки > КоличествоСтрок Тогда
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Строка %1 выходит за пределы файла (%2 строк)."), XMLСтрока(НомерСтроки), XMLСтрока(КоличествоСтрок));
				Возврат ТекстСообщения;
			КонецЕсли;	
			ТекстСтроки = ЭкземплярVanessaEditor.getLineContent(НомерСтроки);
			Если ТекстСтроки = Неопределено Тогда
				ТекстСтроки = "";
			КонецЕсли;	
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В строке %1 не найден шаг.
			|Текст в строке: %2"), XMLСтрока(НомерСтроки), ТекстСтроки);
			Возврат ТекстСообщения;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("### Данные строки"));
	Строки.Добавить("");
	ТекстСтроки = СокрЛ(ЭкземплярVanessaEditor.getLineContent(НомерСтроки));
	Строки.Добавить(Ванесса.Локализовать("Текст в строке:") + " " + ТекстСтроки);
	Строки.Добавить(Ванесса.Локализовать("Шаг в строке:") + " " + СтрокаДерева.Имя);
	Строки.Добавить(Ванесса.Локализовать("Снипет:") + " " + СтрокаДерева.Снипет);
	Строки.Добавить(Ванесса.Локализовать("Тип данных в строке:") + " " + СтрокаДерева.Тип);
	Если ЗначениеЗаполнено(СтрокаДерева.ДопТип) Тогда
		Строки.Добавить(Ванесса.Локализовать("Уточнение типа:") + " " + СтрокаДерева.ДопТип);
	КонецЕсли;	
	
	Если СтрокаДерева.Тип = "Шаг" Тогда
		СтрокаДляПоиска = ПолучитьСтрокуДляПоискаШагаПоСнипету(СтрокаДерева.Снипет);
		Отбор = Новый Структура();
		Отбор.Вставить("СтрокаДляПоиска", СтрокаДляПоиска);
		СтрокиТаблицы = Ванесса.ТаблицаИзвестныхStepDefinition.НайтиСтроки(Отбор);
		СтрокаТаблицаИзвестныхStepDefinition = Неопределено;
		Если СтрокиТаблицы.Количество() > 0 Тогда
			СтрокаТаблицаИзвестныхStepDefinition = СтрокиТаблицы[0];
		КонецЕсли;	
		Если СтрокаТаблицаИзвестныхStepDefinition = Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("В таблице известных шагов не найден шаг:") + " " + СтрокаДерева.Имя);
		Иначе	
			Строки.Добавить(Ванесса.Локализовать("## Данные шага:"));
			Строки.Добавить(Ванесса.Локализовать("  " + "- Тип шага:") + " " + СтрокаТаблицаИзвестныхStepDefinition.ТипШага);
			ИмяФайла = СтрокаТаблицаИзвестныхStepDefinition.ИмяФайла;
			Если НЕ Ванесса.ЭтоLinuxКлиент() Тогда
				ИмяФайла = СтрЗаменить(ИмяФайла, "/", "\");
			КонецЕсли;	
			Строки.Добавить(Ванесса.Локализовать("  " + "- Имя файла где находится реализация шага:") + " " + ИмяФайла);
			Строки.Добавить(Ванесса.Локализовать("# Описание шага:"));
			Строки.Добавить(СтрокаТаблицаИзвестныхStepDefinition.ОписаниеШага);
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Добавляет, читает и удаляет точки останова
&НаКлиенте
Функция УправлениеТочкамиОстанова(Запрос, ДополнительныеПараметры) Экспорт
	
	Если НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		ТекстОшибки = Ванесса.Локализовать("Работать с точками останова можно только когда используется основной редактор Vanessa Automation, а сейчас он выключен.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;	
	
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Действие = "toggle";
	КонецЕсли;
	
	Если Действие = "list" Тогда
		Попытка
			Строки = Новый Массив;
			Строки.Добавить(Ванесса.Локализовать("# Точки останова"));
			Строки.Добавить("");
			
			МассивБрейкпоинтов = Ванесса.БрейкпоинтыVanessaEditor();
			Если МассивБрейкпоинтов = Неопределено ИЛИ ТипЗнч(МассивБрейкпоинтов) <> Тип("Массив") Тогда
				Строки.Добавить(Ванесса.Локализовать("Нет данных из редактора (обновятся при следующем обращении к редактору)."));
			ИначеЕсли МассивБрейкпоинтов.Количество() = 0 Тогда
				Строки.Добавить(Ванесса.Локализовать("Точек останова нет (по данным редактора)."));
			Иначе
				Строки.Добавить(Ванесса.Локализовать("Количество:") + " " + Формат(МассивБрейкпоинтов.Количество(), "ЧГ=0; ЧН=0"));
				Для Каждого ДанныеТочкиОстанова Из МассивБрейкпоинтов Цикл
					Строки.Добавить("- " + ДанныеТочкиОстанова.НомерСтроки);
				КонецЦикла;
			КонецЕсли;
			
			// Счётчик участников строим по кешу текущей вкладки: массив движка обновляется
			// при старте прогона и может быть устаревшим.
			КоличествоВПрогоне = 0;
			Если ТипЗнч(МассивБрейкпоинтов) = Тип("Массив") Тогда
				КоличествоВПрогоне = МассивБрейкпоинтов.Количество();
			КонецЕсли;	
			Строки.Добавить("");
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Участники следующего прогона (кеш текущей вкладки): %1."), Формат(КоличествоВПрогоне, "ЧГ=0; ЧН=0")));
			Строки.Добавить(Ванесса.Локализовать("Счётчик строится по кешу текущей вкладки; массив движка обновится при старте прогона. Переключение через manage_breakpoints(action='toggle') отражается сразу; переключение мышью в редакторе может запаздывать, пока редактор не пришлёт обновление."));
			
			Строки.Добавить("");
			Строки.Добавить("## Открытые файлы");
			Если Ванесса.VanessaTabs = Неопределено Тогда
				Строки.Добавить(Ванесса.Локализовать("Редактор не инициализирован. Загрузите фичи (`load_features`)."));
			Иначе	
				Попытка
					КоличествоВкладок = Ванесса.VanessaTabs.count();
					Если КоличествоВкладок = 0 Тогда
						Строки.Добавить(Ванесса.Локализовать("Файлы не открыты. Загрузите фичи (`load_features`) и откройте сценарий."));
					Иначе	
						Для Инд = 0 По КоличествоВкладок - 1 Цикл
							Вкладка = Ванесса.VanessaTabs.tabStack[Инд];
							Префикс = "";
							Если Ванесса.VanessaTabs.current <> Неопределено
								И НРег(Ванесса.VanessaTabs.current.filename) = НРег(Вкладка.filename) Тогда
								Префикс = "**→** ";
							КонецЕсли;	
							Строки.Добавить("- " + Префикс + Вкладка.filename);
						КонецЦикла;
					КонецЕсли;	
				Исключение
					Строки.Добавить(Ванесса.Локализовать("ошибка чтения вкладок:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
				КонецПопытки;
			КонецЕсли;	
			
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("## Как добавить"));
			Строки.Добавить(Ванесса.Локализовать("- Используйте `manage_editor` с `action: toggle_breakpoint` и параметром `line` (или `manage_breakpoints(action='toggle', line=N)`) для переключения точки останова на строке N."));
			
			Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
	ИначеЕсли Действие = "remove_all" Тогда
		Попытка
			// Количество — по тому же источнику, что и список: массив движка обновляется только при старте прогона
			МассивБрейкпоинтов = Ванесса.БрейкпоинтыVanessaEditor();
			Количество = 0;
			ИсточникКоличества = Ванесса.Локализовать("по данным редактора");
			Если МассивБрейкпоинтов = Неопределено ИЛИ ТипЗнч(МассивБрейкпоинтов) <> Тип("Массив") Тогда
				ИсточникКоличества = Ванесса.Локализовать("нет данных из редактора");
			Иначе
				Количество = МассивБрейкпоинтов.Количество();
			КонецЕсли;	
			
			// Удаляем все точки останова через API редактора
			Если НЕ Ванесса.ОтсутствуетVanessaEditor() Тогда
				Ванесса.УдалитьВсеТочкиОстановаРедактора();
			КонецЕсли;
			
			ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Точки останова удалены
				|
				|- Удалено: %1 (%2)"),
				Формат(Количество, "ЧГ=0; ЧН=0"),
				ИсточникКоличества);
			Возврат ТекстОтвета;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
	ИначеЕсли Действие = "toggle" Тогда
		Попытка
			
			НомерСтроки = Неопределено;
			Если MCPVAСлужебныйМодуль.ПараметрПрисутствуетВЗапросе(Запрос, "line") Тогда
				ЗначениеНомераСтроки = MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "line");
				Попытка
					ЧислоНомера = Число(ЗначениеНомераСтроки);
				Исключение
					ЧислоНомера = Неопределено;
				КонецПопытки;
				Если ЧислоНомера = Неопределено ИЛИ ЧислоНомера <= 0 ИЛИ ЧислоНомера <> Цел(ЧислоНомера) Тогда
					ТекстОшибки = Ванесса.Локализовать("Некорректное значение параметра line. Нужно передать положительное целое число.");
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
				КонецЕсли;
				НомерСтроки = Цел(ЧислоНомера);
			КонецЕсли;
			РедакторДоступен = НЕ Ванесса.ОтсутствуетVanessaEditor();

			Если НЕ Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current) Тогда
				ТекстОшибки = Ванесса.Локализовать("В редакторе не открыт фича файл.");
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;	
			
			Если НомерСтроки <> Неопределено И РедакторДоступен Тогда
				Редактор = Ванесса.ПолучитьVanessaEditor();
				
				// Кеш редактора обновляется событием UPDATE_BREAKPOINTS асинхронно, поэтому сразу после
				// toggle list показывал устаревшие данные. Синхронно переносим переключение в кеш:
				// list сразу видит результат, а следующее событие редактора данные согласует.
				МассивБрейкпоинтовКеша = Ванесса.БрейкпоинтыVanessaEditor();
				ИндексТочкиВКеше = -1;
				Если ТипЗнч(МассивБрейкпоинтовКеша) = Тип("Массив") Тогда
					Для Инд = 0 По МассивБрейкпоинтовКеша.Количество() - 1 Цикл
						Если МассивБрейкпоинтовКеша[Инд].НомерСтроки = НомерСтроки
							И НЕ ЗначениеЗаполнено(МассивБрейкпоинтовКеша[Инд].ИдВиджета) Тогда
							ИндексТочкиВКеше = Инд;
							Прервать;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;	
				
				Редактор.toggleBreakpoint(НомерСтроки);
				
				Если ТипЗнч(МассивБрейкпоинтовКеша) = Тип("Массив") Тогда
					Если ИндексТочкиВКеше >= 0 Тогда
						МассивБрейкпоинтовКеша.Удалить(ИндексТочкиВКеше);
					Иначе
						МассивБрейкпоинтовКеша.Добавить(Ванесса.МодульРедакторТекста().ДанныеБрейкПоинта(НомерСтроки, "", Истина));
					КонецЕсли;	
				КонецЕсли;	
			ИначеЕсли НомерСтроки <> Неопределено И Не РедакторДоступен Тогда
				ТекстОшибки = Ванесса.Локализовать("Редактор Monaco недоступен. Загрузите фичи (`load_features`) для инициализации редактора.");
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			Иначе
				Ванесса.ОбработатьУстановкуСнятиеБрейкпоинта();
			КонецЕсли;
			
			Если НомерСтроки <> Неопределено Тогда
				ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
					"# Брейкпоинт переключён
					|
					|- Строка: %1"),
					Формат(НомерСтроки, "ЧГ=0; ЧН=0"));
			Иначе
				ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
					"# Брейкпоинт переключён
					|
					|- Строка: текущая"));
			КонецЕсли;
			Возврат ТекстОтвета;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
	Иначе
		ТекстОшибки = Ванесса.Локализовать("Неизвестное действие:") + " " + Действие + ". " + Ванесса.Локализовать("Допустимые: toggle, remove_all, list.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
КонецФункции

// Выполняет сценарий или все сценарии
&НаКлиенте
Функция ВыполнитьСценарий(Запрос, ДополнительныеПараметры) Экспорт
	
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		MCPЗаписатьСлужебныеДанные("Сценарий.Отказ", Новый Структура("Причина, Идентификатор", "УжеВыполняется", Запрос.Идентификатор));
		ТекстСообщения = Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона или вызовите stop_scenario. Прогон, запущенный через MCP, остановится только после завершения текущего вызова: чтобы остановка работала во время прогона, запускайте с wait=false.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем занятость до перезаписи глобального ИД: иначе отчёт ожидающей загрузки
	// уйдёт этому вызову, а сброс флагов оставит её без ответа
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		MCPОтветитьОтказомБезСбросаПрогона(Запрос.Идентификатор, "ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
		Возврат Неопределено;
	КонецЕсли;
	
	РежимВвода = НРег(СокрЛП(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "mode")));
	Если НЕ ЗначениеЗаполнено(РежимВвода) Тогда
		РежимВвода = "all";
	КонецЕсли;
	// Ниже режим сравнивается с camelCase-литералами, поэтому приводим его к каноническому виду
	Если РежимВвода = "all" ИЛИ РежимВвода = "selected" Тогда
		Режим = РежимВвода;
	ИначеЕсли РежимВвода = "fromcurrentstep" Тогда
		Режим = "fromCurrentStep";
	ИначеЕсли РежимВвода = "reloadandrun" Тогда
		Режим = "reloadAndRun";
	ИначеЕсли РежимВвода = "reloadandrunfromline" Тогда
		Режим = "reloadAndRunFromLine";
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Неизвестный режим:") + " " + РежимВвода + Ванесса.Локализовать(". Допустимые: selected, all, reloadAndRun, fromCurrentStep, reloadAndRunFromLine.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Параметр filePath: загрузить фичу и открыть в редакторе перед запуском.
	// Проверяем до сброса ИД и флагов, чтобы ошибка входных данных не меняла состояние MCP.
	ПутьКФайлу = MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "filePath");
	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Попытка
			ПутьКФайлу = MCPНормализоватьПутьКФичаФайлу(ПутьКФайлу);
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		КонецПопытки;
	КонецЕсли;
	
	НомерСтроки = Неопределено;
	ЗначениеНомераСтроки = MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "lineNumber");
	Если ЗначениеЗаполнено(ЗначениеНомераСтроки) Тогда
		Попытка
			ЧислоНомера = Число(ЗначениеНомераСтроки);
		Исключение
			ЧислоНомера = Неопределено;
		КонецПопытки;
		Если ЧислоНомера = Неопределено ИЛИ ЧислоНомера <= 0 ИЛИ ЧислоНомера <> Цел(ЧислоНомера) Тогда
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра lineNumber. Нужно передать положительное целое число.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		НомерСтроки = Цел(ЧислоНомера);
	КонецЕсли;
	Если Режим = "reloadAndRunFromLine" И НомерСтроки = Неопределено Тогда
		ТекстСообщения = Ванесса.Локализовать("Для режима reloadAndRunFromLine необходимо указать параметр lineNumber.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	MCPСброситьКлючиПовторов();
	MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.ПередПрогоном", Новый Структура("Файл, Режим", ПутьКФайлу, Режим));

	Идентификатор = Запрос.Идентификатор;
	
	ЖдатьЗавершения = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "wait", Истина);
	
	ДопПараметрыВызоваMCP = Новый Структура;
	ДопПараметрыВызоваMCP.Вставить("Тип", "ВыполнитьСценарий");
	ДопПараметрыВызоваMCP.Вставить("ПутьКФайлу", ПутьКФайлу);
	ДопПараметрыВызоваMCP.Вставить("Режим", Режим);
	ДопПараметрыВызоваMCP.Вставить("Идентификатор", Идентификатор);
	ДопПараметрыВызоваMCP.Вставить("НомерСтроки", НомерСтроки);
	ДопПараметрыВызоваMCP.Вставить("Ждать", ЖдатьЗавершения);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметрыВызоваMCP, Запрос);
	
	MCPЗаписатьСлужебныеДанные("Сценарий.Запрос", Новый Структура("Инструмент, Идентификатор, Режим, Файл, НомерСтроки, Ждать",
		"run_scenario", Идентификатор, Режим, ПутьКФайлу, НомерСтроки, ЖдатьЗавершения));

	ПродолжитьВыполнитьСценарий1(ПутьКФайлу, ДопПараметрыВызоваMCP);
	
КонецФункции

// Останавливает выполнение сценариев
&НаКлиенте
Функция ОстановитьВыполнениеСценариев(Запрос, ДополнительныеПараметры) Экспорт
	
	БылоВыполнение = Ванесса.Объект.ИдетВыполнениеСценариев;
	Идентификатор = Запрос.Идентификатор;
	MCPЗаписатьСлужебныеДанные("Сценарий.Остановка", Новый Структура("БылоВыполнение, ИдетВыполнениеДо, Идентификатор",
		БылоВыполнение, Ванесса.Объект.ИдетВыполнениеСценариев, Идентификатор));
	
	ОшибкаОстановки = Ложь;
	ТекстОшибкиОстановки = "";
	Если БылоВыполнение Тогда
		глMCPПричинаОстановкиПрогона = "stop_scenario";
	КонецЕсли;
	Попытка
		Ванесса.КомандаОстановитьСценарии();
	Исключение
		ОшибкаОстановки = Истина;
		ТекстОшибкиОстановки = ОписаниеОшибки();
		MCPЗаписатьСлужебныеДанные("Сценарий.ОшибкаОстановки", Новый Структура("ЕстьТекст, Идентификатор",
			ЗначениеЗаполнено(ТекстОшибкиОстановки), Идентификатор));
	КонецПопытки;
	Если ОшибкаОстановки Тогда
		Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
			глMCPПричинаОстановкиПрогона = Неопределено;
		КонецЕсли;
		ТекстОшибки = Ванесса.Локализовать("Не удалось остановить выполнение сценариев:") + " " + ТекстОшибкиОстановки;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	MCPЗаписатьСлужебныеДанные("Сценарий.ОстановкаВыполнена", Новый Структура("ИдетВыполнениеПосле, Идентификатор",
		Ванесса.Объект.ИдетВыполнениеСценариев, Идентификатор));
	
	Если Не БылоВыполнение Тогда
		ТекстОтвета = Ванесса.Локализовать(
			"# Остановка выполнения
			|
			|- Команда остановки: обработана
			|- Остановлено: нет (активного прогона не было)
			|- Было активное выполнение: нет
			|
			|Активного прогона не было, останавливать было нечего. Сценарии не выполнялись.
			|Используйте `run_scenario` для запуска.");
	Иначе
		ТекстОтвета = Ванесса.Локализовать(
			"# Остановка выполнения
			|
			|- Команда остановки: обработана
			|- Остановлено: да
			|- Был активный прогон: да
			|
			|## Следующие шаги
			|- Дождитесь завершения остановки и получите результаты: `get_test_results`");
		Ванесса.СообщитьПользователю(Ванесса.Локализовать("Выполнена остановка выполнения сценариев"));
	КонецЕсли;
		
	Возврат ТекстОтвета;
	
КонецФункции

// Получает результат выполнения тестов
&НаКлиенте
Функция ПолучитьРезультатВыполненияТестов(Запрос, ДополнительныеПараметры) Экспорт

	// Во время прогона отдаём снапшот: это основной способ наблюдать за прогоном, запущенным с wait=false
	ПрогонИдёт = Ванесса.ИдетВыполнениеСценариевДляMCP();
	
	Результат = Неопределено;
	ИдСценария = Неопределено;
	ИндексВыбранногоРезультата = Неопределено;
	ВсегоЗаписей = Неопределено;
	ИдСценарияСтрокой = MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "scenarioId");

	Если ЗначениеЗаполнено(ИдСценарияСтрокой) Тогда
		Попытка
			ИдСценария = Число(ИдСценарияСтрокой);
		Исключение
			ИдСценария = Неопределено;
		КонецПопытки;
		// Число("1,5") исключения не вызывает — отдельно проверяем целочисленность
		Если ИдСценария <> Неопределено Тогда
			Если ИдСценария <> Цел(ИдСценария) Тогда
				ИдСценария = Неопределено;
			КонецЕсли;	
		КонецЕсли;	
		Если ИдСценария = Неопределено Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр scenarioId должен быть числовым ИД строки сценария в дереве, получено <%1>."), ИдСценарияСтрокой);
			MCPЗаписатьСлужебныеДанные("Результаты.ОтказПараметра", Новый Структура("ScenarioId, Идентификатор", ИдСценарияСтрокой, Запрос.Идентификатор));
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;	
		Попытка
			Результат = Ванесса.ПолучитьРезультатПрохожденияТестовСценария(ИдСценария);
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка получения результата:") + " " + ОписаниеОшибки();
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	Иначе
		// Последний завершённый результат: у сценария, который ещё выполняется, статус не заполнен.
		// Без этого во время прогона отдавался текущий сценарий, а тексты ниже обещали завершённый.
		МассивРезультатПрохожденияТестовСценария = Ванесса.ПолучитьМассивРезультатПрохожденияТестовСценария();	
		
		Попытка
			Если МассивРезультатПрохожденияТестовСценария <> Неопределено Тогда
				ВсегоЗаписей = МассивРезультатПрохожденияТестовСценария.Количество();
			КонецЕсли;
			Если МассивРезультатПрохожденияТестовСценария <> Неопределено 
				И МассивРезультатПрохожденияТестовСценария.Количество() > 0 Тогда
				// У прерванного сценария статус сценария может быть не заполнен:
				// Broken остаётся только у шага. Если прогон уже не идёт, показываем такую запись.
				ПоследняяЗапись = МассивРезультатПрохожденияТестовСценария[МассивРезультатПрохожденияТестовСценария.Количество() - 1];
				Если НЕ ПрогонИдёт
					И НЕ ЗначениеЗаполнено(MCPБезопасноеСвойство(ПоследняяЗапись, "Статус")) Тогда
					Результат = ПоследняяЗапись;
					ИндексВыбранногоРезультата = МассивРезультатПрохожденияТестовСценария.Количество() - 1;
				Иначе
					ИндексРезультата = МассивРезультатПрохожденияТестовСценария.Количество() - 1;
					Пока ИндексРезультата >= 0 Цикл
						КандидатРезультата = МассивРезультатПрохожденияТестовСценария[ИндексРезультата];
						Если ЗначениеЗаполнено(MCPБезопасноеСвойство(КандидатРезультата, "Статус")) Тогда
							Результат = КандидатРезультата;
							ИндексВыбранногоРезультата = ИндексРезультата;
							Прервать;
						КонецЕсли;
						ИндексРезультата = ИндексРезультата - 1;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;	
	
	Если Результат = Неопределено Тогда
		
		Если ПрогонИдёт Тогда
			Если ИдСценария = Неопределено Тогда
				СтрокаНетРезультата = Ванесса.Локализовать("Прогон ещё идёт: ни один сценарий ещё не завершён. Дождитесь завершения или смотрите get_vanessa_automation_state.");
			Иначе
				СтрокаНетРезультата = Ванесса.Локализовать("Прогон ещё идёт: результат для запрошенного сценария пока не готов. Смотрите get_vanessa_automation_state.");
			КонецЕсли;	
		ИначеЕсли ИдСценария = Неопределено Тогда
			СтрокаНетРезультата = Ванесса.Локализовать("Нет результатов выполнения.");
		Иначе
			СтрокаНетРезультата = Ванесса.Локализовать("Нет результатов для строки дерева с ИД") + " " + XMLСтрока(ИдСценария) + ": " + Ванесса.Локализовать("сценарий с таким ИД ещё не выполнялся.");
		КонецЕсли;	
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Результаты тестов
				|
				|%1
				|
				|## Следующие шаги
				|- Загрузите фичи: `load_features`
				|- Запустите сценарий: `run_scenario`
				|- Затем повторите: `get_test_results`"), СтрокаНетРезультата);
		
		Если НЕ ПрогонИдёт ИЛИ ИдСценария <> Неопределено Тогда
			КлючНетДанных = Строка(ИдСценарияСтрокой) + "|" + Строка(ПрогонИдёт);
			Если КлючНетДанных <> глMCPПоследнийКлючНетДанных Тогда
				глMCPПоследнийКлючНетДанных = КлючНетДанных;
				MCPЗаписатьСлужебныеДанные("Результаты.НетДанных", Новый Структура("ScenarioId, ПрогонИдёт, Идентификатор",
					ИдСценарияСтрокой, ПрогонИдёт, Запрос.Идентификатор));
			КонецЕсли;
		КонецЕсли;
		глMCPПоследнийКлючВыбранногоРезультата = Неопределено;
		глMCPПоследнийКлючПрерванногоРезультата = Неопределено;

		Возврат ТекстСообщения;
	КонецЕсли;
	
	глMCPПоследнийКлючНетДанных = Неопределено;
	СтатусРезультата = MCPБезопасноеСвойство(Результат, "Статус");
	ЭтоОдиночныйШаг = MCPБезопасноеСвойство(Результат, "ЭтоОдиночныйШаг") = Истина;
	ПрогонПрерван = Строка(СтатусРезультата) = "Broken";
	// В этой ветке строка о продолжающемся прогоне уже выводится: вторую не дублируем.
	// Для одиночного шага статус сценария не заполняется, но это не прерванный сценарий.
	СтрокаОПрогонеУжеДобавлена = (НЕ ЗначениеЗаполнено(СтатусРезультата) ИЛИ ПрогонПрерван) И НЕ ЭтоОдиночныйШаг;
	
	КлючВыбранногоРезультата = Строка(ИдСценарияСтрокой) + "|" + Строка(MCPБезопасноеСвойство(Результат, "ИДСтроки")) + "|" + Строка(СтатусРезультата) + "|" + Строка(ПрогонИдёт);
	Если КлючВыбранногоРезультата <> глMCPПоследнийКлючВыбранногоРезультата Тогда
		глMCPПоследнийКлючВыбранногоРезультата = КлючВыбранногоРезультата;
		MCPЗаписатьСлужебныеДанные("Результаты.Выбран", Новый Структура(
			"ScenarioId, ИДСтроки, ИндексВМассиве, ВсегоЗаписей, Статус, ПрогонИдёт, Идентификатор",
			ИдСценарияСтрокой, MCPБезопасноеСвойство(Результат, "ИДСтроки"), ИндексВыбранногоРезультата, ВсегоЗаписей,
			СтатусРезультата, ПрогонИдёт, Запрос.Идентификатор));
	КонецЕсли;

	Если (ПрогонПрерван ИЛИ НЕ ЗначениеЗаполнено(СтатусРезультата)) И (НЕ ПрогонИдёт ИЛИ ИдСценария <> Неопределено) И НЕ ЭтоОдиночныйШаг Тогда
		КлючПрерванногоРезультата = Строка(ИдСценарияСтрокой) + "|" + Строка(ПрогонИдёт) + "|" + Строка(СтатусРезультата);
		Если КлючПрерванногоРезультата <> глMCPПоследнийКлючПрерванногоРезультата Тогда
			глMCPПоследнийКлючПрерванногоРезультата = КлючПрерванногоРезультата;
			ИмяСобытияРезультата = ?(ПрогонПрерван, "Результаты.Прерван", "Результаты.НеЗавершён");
			ПричинаРезультата = "";
			Если НЕ ПрогонИдёт ИЛИ ПрогонПрерван Тогда
				ПричинаРезультата = MCPТекстПричиныОстановкиПрогона();
			КонецЕсли;
			MCPЗаписатьСлужебныеДанные(ИмяСобытияРезультата, Новый Структура("ScenarioId, ПрогонИдёт, Статус, Причина, Идентификатор",
				ИдСценарияСтрокой, ПрогонИдёт, СтатусРезультата, ПричинаРезультата, Запрос.Идентификатор));
		КонецЕсли;
	Иначе
		глMCPПоследнийКлючПрерванногоРезультата = Неопределено;
	КонецЕсли;

	Строки = Новый Массив;
	Если СтрокаОПрогонеУжеДобавлена Тогда
		Строки.Добавить(Ванесса.Локализовать("# Результаты тестов"));
		Строки.Добавить("");
		// ПрогонИдёт — снимок на момент вызова; статуса нет у ещё не завершённого сценария, Broken — у прерванного
		Если ПрогонИдёт Тогда
			Если ИдСценария = Неопределено Тогда
				// Показан последний завершённый (возможно, прерванный) сценарий, а не текущий
				Если ПрогонПрерван Тогда
					Строки.Добавить(Ванесса.Локализовать("- Последний завершённый сценарий прерван: ") + MCPТекстПричиныОстановкиПрогона());
				КонецЕсли;	
			ИначеЕсли ПрогонПрерван Тогда
				Строки.Добавить(Ванесса.Локализовать("- Сценарий прерван: ") + MCPТекстПричиныОстановкиПрогона());
			Иначе
				Строки.Добавить(Ванесса.Локализовать("- Прогон продолжается: отчёт по сценарию на текущий момент."));
			КонецЕсли;	
		Иначе
			Строки.Добавить(Ванесса.Локализовать("- Сценарий не завершён: ") + MCPТекстПричиныОстановкиПрогона());
		КонецЕсли;	
	Иначе
		Если ЭтоОдиночныйШаг Тогда
			Строки.Добавить(Ванесса.Локализовать("# Результаты тестов"));
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("- Результат выполнения одиночного шага."));
		Иначе
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Результаты тестов
				|
				|- Статус: %1"),
				MCPПредставлениеЗначенияДляMarkdown(СтатусРезультата)));
		КонецЕсли;	
	КонецЕсли;	
	Если ПрогонИдёт Тогда
		Если ИдСценария = Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Прогон ещё идёт: показаны результаты последнего завершённого сценария."));
		ИначеЕсли НЕ СтрокаОПрогонеУжеДобавлена Тогда
			Строки.Добавить(Ванесса.Локализовать("- Прогон ещё идёт: отчёт по запрошенному сценарию на текущий момент."));
		КонецЕсли;	
	КонецЕсли;	
	
	ВремяНач = MCPБезопасноеСвойство(Результат, "ВремяНачала");
	ВремяКон = MCPБезопасноеСвойство(Результат, "ВремяОкончания");
	Если ВремяНач <> Неопределено И ВремяКон <> Неопределено Тогда
		Строки.Добавить(Ванесса.Локализовать("- Длительность:") + " " + Формат(ВремяКон - ВремяНач, "ЧГ=0; ЧН=0") + Ванесса.Локализовать(" мс"));
	КонецЕсли;
	
	ОписаниеОшибкиРез = MCPБезопасноеСвойство(Результат, "ОписаниеОшибки");
	Если ЗначениеЗаполнено(ОписаниеОшибкиРез) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Ошибка:") + " " + ОписаниеОшибкиРез);
	КонецЕсли;
	Строки.Добавить("");
	
	ШагиРезультаты = MCPБезопасноеСвойство(Результат, "РезультатПрохожденияТестовШагов");
	Если ШагиРезультаты <> Неопределено И ТипЗнч(ШагиРезультаты) = Тип("Массив") Тогда
		Строки.Добавить(Ванесса.Локализовать("## Шаги (") + Формат(ШагиРезультаты.Количество(), "ЧГ=0; ЧН=0") + ")");
		Номер = 0;
		Для Каждого ШагРез Из ШагиРезультаты Цикл
			Номер = Номер + 1;
			ИмяШага = MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(ШагРез, "Имя"));
			СтатусШага = MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(ШагРез, "Статус"));
			
			ВремяНачШ = MCPБезопасноеСвойство(ШагРез, "ВремяНачала");
			ВремяКонШ = MCPБезопасноеСвойство(ШагРез, "ВремяОкончания");
			ВремяШага = "";
			Если ВремяНачШ <> Неопределено И ВремяКонШ <> Неопределено Тогда
				ВремяШага = " (" + Формат(ВремяКонШ - ВремяНачШ, "ЧГ=0; ЧН=0") + " " + Ванесса.Локализовать("мс)");
			КонецЕсли;
			
			ОшибкаШага = ТекстОшибкиИзОписанияОшибки(MCPБезопасноеСвойство(ШагРез, "ОписаниеОшибки"));
			
			Строки.Добавить(Формат(Номер, "ЧГ=0; ЧН=0") + ". " + ИмяШага + " → **" + СтатусШага + "**" + ВремяШага);
			Если ЗначениеЗаполнено(ОшибкаШага) Тогда
				Строки.Добавить(Ванесса.Локализовать("   " + "- Ошибка:") + " " + ОшибкаШага);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает текущую дату на сервере
&НаКлиенте
Функция ПолучитьТекущуюДатуНаСервере1С(Запрос, ДополнительныеПараметры) Экспорт
	Возврат ПолучитьТекущуюДатуНаСервере1СMCP_Сервер();
КонецФункции

// Проверяет подключение клиента тестирования: есть активное окно и определён текущий профиль.
&НаКлиенте
Функция MCPКлиентТестированияПодключен()

	Попытка
		Если Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Ванесса.ТекущиеДанныеКлиентаТестирования() <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает состояние Vanessa Automation
&НаКлиенте
Функция ПолучитьСостояниеVanessaAutomation(Запрос, ДополнительныеПараметры) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("isRunning", Ванесса.ИдетВыполнениеСценариевДляMCP());
	Результат.Вставить("featureDirectory", Ванесса.Объект.КаталогФич);
	Результат.Вставить("КаталогПроекта", Ванесса.Объект.КаталогПроекта);
	Результат.Вставить("ВключенаЗаписьДействийПользователя", Ванесса.ИдетЗаписьДействийПользователя());
	
	// Реальная проверка подключения клиента тестирования
	Попытка
		АктивноеОкноVA = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Значение = АктивноеОкноVA <> Неопределено;
		ТекущиеДанныеКлиентаТестирования = Ванесса.ТекущиеДанныеКлиентаТестирования();
		Если ТекущиеДанныеКлиентаТестирования = Неопределено Тогда
			Значение = Ложь;
		КонецЕсли;	
		Результат.Вставить("testClientConnected", Значение);
		Если Значение Тогда
			ТекущиеДанныеКлиентаТестирования = Ванесса.ТекущиеДанныеКлиентаТестирования();
			Если ТекущиеДанныеКлиентаТестирования <> Неопределено Тогда
				Результат.Вставить("ИмяПрофиляКлиентаТестирования", ТекущиеДанныеКлиентаТестирования.Имя);
			КонецЕсли;	
		КонецЕсли;	
	Исключение
		Результат.Вставить("testClientConnected", Ложь);
	КонецПопытки;
	
	ПримечаниеОФайлеВРедакторе = "";
	
	Попытка
		СостояниеVA = Ванесса.ПолучитьСостояниеVanessaAutomation();
	Исключение
		СостояниеVA = Неопределено;
	КонецПопытки;
	
	ПрогонИдёт = Результат.isRunning;
	Если СостояниеVA = Неопределено Тогда
		КлючНетДанныхСостояния = Строка(ПрогонИдёт) + "|" + Строка(Ванесса.Объект.КаталогФич);
		Если КлючНетДанныхСостояния <> глMCPПоследнийКлючНетДанныхСостояния Тогда
			глMCPПоследнийКлючНетДанныхСостояния = КлючНетДанныхСостояния;
			MCPЗаписатьСлужебныеДанные("Состояние.НетДанных", Новый Структура("isRunning, КаталогФич, Идентификатор",
				ПрогонИдёт, Ванесса.Объект.КаталогФич, Запрос.Идентификатор));
		КонецЕсли;
	Иначе
		глMCPПоследнийКлючНетДанныхСостояния = Неопределено;
	КонецЕсли;

	Если СостояниеVA <> Неопределено Тогда
		
		ПолныйПутьФичиПрогона = "";
		Если СостояниеVA.Свойство("ТекущаяФича") И ТипЗнч(СостояниеVA.ТекущаяФича) = Тип("Структура") Тогда
			ПолныйПутьФичиПрогона = СокрЛП(Строка(MCPБезопасноеСвойство(СостояниеVA.ТекущаяФича, "ПолныйПуть")));
		КонецЕсли;	
		
		Если Ванесса.Объект.ИспользоватьРедакторVanessaEditor
			И Ванесса.VanessaTabs <> Неопределено
			И Ванесса.VanessaTabs.current <> Неопределено
			И Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current)
			И ЗначениеЗаполнено(Ванесса.Объект.КаталогФич)
			И НРег(СтрЗаменить(ПолныйПутьФичиПрогона, "\", "/")) <> НРег(СтрЗаменить(СокрЛП(Строка(Ванесса.Объект.КаталогФич)), "\", "/"))
			Тогда
			// Данные состояния относятся к прогону, а не к файлу в редакторе: дополняем пояснением
			ПримечаниеОФайлеВРедакторе = Ванесса.Локализовать("В редакторе открыт файл:") + " " + Ванесса.Объект.КаталогФич + ". " + Ванесса.Локализовать("Детализация — manage_editor (action: get_state).");
		КонецЕсли;	
		
		// Текущая фича
		Если СостояниеVA.Свойство("ТекущаяФича") И ТипЗнч(СостояниеVA.ТекущаяФича) = Тип("Структура") Тогда
			Фича = Новый Структура;
			Фича.Вставить("name", MCPБезопасноеСвойство(СостояниеVA.ТекущаяФича, "Имя"));
			Фича.Вставить("fullPath", MCPБезопасноеСвойство(СостояниеVA.ТекущаяФича, "ПолныйПуть"));
			Фича.Вставить("language", MCPБезопасноеСвойство(СостояниеVA.ТекущаяФича, "ЯзыкФичи"));
			Фича.Вставить("tags", MCPБезопасноеСвойство(СостояниеVA.ТекущаяФича, "МассивТегов"));
			Результат.Вставить("currentFeature", Фича);
		Иначе
			Результат.Вставить("currentFeature", Неопределено);
		КонецЕсли;
		
		// Текущий сценарий
		Если СостояниеVA.Свойство("ТекущийСценарий") И ТипЗнч(СостояниеVA.ТекущийСценарий) = Тип("Структура") Тогда
			Сценарий = Новый Структура;
			Сценарий.Вставить("name", MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "Имя"));
			Сценарий.Вставить("id", MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "ИдСценария"));
			// ИД строки сценария в дереве тестов — его принимает get_test_results в scenarioId
			Сценарий.Вставить("treeRowId", MCPБезопасноеСвойство(MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "ОписаниеСценария"), "СтрокаДерева"));
			Сценарий.Вставить("result", MCPVAСлужебныйМодуль.MCPКраткийРезультатСценария(MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "РезультатПрохожденияТестовСценария")));
			Сценарий.Вставить("tags", MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "МассивТегов"));
			Сценарий.Вставить("retryNumber", MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "НомерПопыткиВыполненияСценария"));
			Результат.Вставить("currentScenario", Сценарий);
		Иначе
			Результат.Вставить("currentScenario", Неопределено);
		КонецЕсли;
		
		// После прогона сценарий без имени и ИД означает несогласованное состояние: прогон уже завершён,
		// а состояние ещё не обновилось. Логируем переход, а не каждый опрос.
		СценарииВыполненыПоФлагу = Ложь;
		Попытка
			СценарииВыполненыПоФлагу = Ванесса.MCPСценарииВыполнены();
		Исключение
			// Если основная форма недоступна, не считаем состояние несогласованным
		КонецПопытки;
		// Успешно завершённый прогон тоже оставляет currentScenario пустым:
		// наличие результата со статусом означает, что это не несогласованность.
		ЕстьЗавершённыйРезультат = Ложь;
		Попытка
			МассивРезультатовДляПроверкиСостояния = Ванесса.ПолучитьМассивРезультатПрохожденияТестовСценария();
			Если ТипЗнч(МассивРезультатовДляПроверкиСостояния) = Тип("Массив") Тогда
				Для Каждого ЗаписьРезультатаДляПроверкиСостояния Из МассивРезультатовДляПроверкиСостояния Цикл
					Если ЗначениеЗаполнено(MCPБезопасноеСвойство(ЗаписьРезультатаДляПроверкиСостояния, "Статус")) Тогда
						ЕстьЗавершённыйРезультат = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если НЕ Результат.isRunning И СценарииВыполненыПоФлагу И НЕ ЕстьЗавершённыйРезультат Тогда
			СценарийТекущий = Результат.currentScenario;
			ИмяСценарияСостояния = MCPБезопасноеСвойство(СценарийТекущий, "name");
			ИдСценарияСостояния = MCPБезопасноеСвойство(СценарийТекущий, "id");
			TreeRowIdСостояния = MCPБезопасноеСвойство(СценарийТекущий, "treeRowId");
			Если НЕ ЗначениеЗаполнено(ИмяСценарияСостояния)
				И НЕ ЗначениеЗаполнено(ИдСценарияСостояния)
				И НЕ ЗначениеЗаполнено(TreeRowIdСостояния) Тогда
				КлючНесогласованного = Строка(ИмяСценарияСостояния) + "|" + Строка(ИдСценарияСостояния) + "|" + Строка(TreeRowIdСостояния);
				Если КлючНесогласованного <> глMCPПоследнийКлючНесогласованногоСостояния Тогда
					глMCPПоследнийКлючНесогласованногоСостояния = КлючНесогласованного;
					MCPЗаписатьСлужебныеДанные("Состояние.Несогласовано", Новый Структура(
						"isRunning, ФлагСценарииВыполнены, Имя, ИдСценария, treeRowId, ЕстьРезультат, Статус",
						Результат.isRunning, Истина, ИмяСценарияСостояния, ИдСценарияСостояния, TreeRowIdСостояния,
						MCPБезопасноеСвойство(СценарийТекущий, "result") <> Неопределено,
						MCPБезопасноеСвойство(MCPБезопасноеСвойство(СценарийТекущий, "result"), "status")));
				КонецЕсли;
			Иначе
				глMCPПоследнийКлючНесогласованногоСостояния = Неопределено;
			КонецЕсли;
		Иначе
			глMCPПоследнийКлючНесогласованногоСостояния = Неопределено;
		КонецЕсли;

		// Текущий шаг
		Если СостояниеVA.Свойство("ТекущийШаг") И ТипЗнч(СостояниеVA.ТекущийШаг) = Тип("Структура") Тогда
			Шаг = Новый Структура;
			Шаг.Вставить("name", MCPБезопасноеСвойство(СостояниеVA.ТекущийШаг, "Имя"));
			Шаг.Вставить("paramValues", MCPБезопасноеСвойство(СостояниеVA.ТекущийШаг, "ЗначенияПараметров"));
			// В ядре ключ называется "НомерСтрокиФичи", а не "НомерСтрокиВФиче".
			Шаг.Вставить("lineNumber", MCPБезопасноеСвойство(СостояниеVA.ТекущийШаг, "НомерСтрокиФичи"));
			Шаг.Вставить("id", MCPБезопасноеСвойство(СостояниеVA.ТекущийШаг, "ИдСтроки"));
			Шаг.Вставить("status", MCPСтатусТекущегоШага(СостояниеVA));
			Результат.Вставить("currentStep", Шаг);
		Иначе
			Результат.Вставить("currentStep", Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстСостояния = MCPСформироватьMarkdownСостоянияVA(Результат);
	Если ЗначениеЗаполнено(ПримечаниеОФайлеВРедакторе) Тогда
		ТекстСостояния = ТекстСостояния + Символы.ПС + Символы.ПС + ПримечаниеОФайлеВРедакторе;
	КонецЕсли;	
	Возврат ТекстСостояния;
	
КонецФункции

&НаКлиенте
// Возвращает статус записи текущего шага из результата сценария. "Running" означает, что шаг выполняется.
// Запись ищется с конца: в циклах один и тот же ИДСтроки повторяется, актуальна последняя запись.
Функция MCPСтатусТекущегоШага(СостояниеVA)
	
	ИДСтрокиШага = MCPБезопасноеСвойство(СостояниеVA.ТекущийШаг, "ИдСтроки");
	Если ИДСтрокиШага = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	РезультатСценария = MCPБезопасноеСвойство(СостояниеVA.ТекущийСценарий, "РезультатПрохожденияТестовСценария");
	Если ТипЗнч(РезультатСценария) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ЗаписиШагов = MCPБезопасноеСвойство(РезультатСценария, "РезультатПрохожденияТестовШагов");
	Если ТипЗнч(ЗаписиШагов) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ИндексЗаписи = ЗаписиШагов.Количество() - 1;
	Пока ИндексЗаписи >= 0 Цикл
		ЗаписьШага = ЗаписиШагов[ИндексЗаписи];
		Если ТипЗнч(ЗаписьШага) = Тип("Структура")
			И MCPБезопасноеСвойство(ЗаписьШага, "ИДСтроки") = ИДСтрокиШага Тогда
			Возврат MCPБезопасноеСвойство(ЗаписьШага, "Статус");
		КонецЕсли;	
		ИндексЗаписи = ИндексЗаписи - 1;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Выполняет синтакс контроль
&НаКлиенте
Функция СинтаксКонтроль(Запрос, ДополнительныеПараметры) Экспорт
	
	ПутьКФайлу = Строка(ЗначениеПараметраИзЗапроса(Запрос, "filePath"));
	
	СтрокаСообщения = Ванесса.Локализовать("Выполнение синтакс контроля.
	|filePath=%1");
	СтрокаСообщения = Ванесса.ПодставитьПараметрыВСтроку(СтрокаСообщения, ПутьКФайлу);
	Ванесса.СообщитьПользователю(СтрокаСообщения);
	
	// Проверка синтаксиса оставляет проверяемый файл текущим. Запоминаем состояние редактора
	// до вызова, чтобы вернуть вызывающей стороне сведения о смене активной вкладки.
	ДопПараметрыВызоваMCP = Новый Структура;
	ДопПараметрыВызоваMCP.Вставить("ПредыдущаяВкладка", "");
	ДопПараметрыВызоваMCP.Вставить("ПредыдущаяВкладкаЗаголовок", "");
	ДопПараметрыВызоваMCP.Вставить("ПредыдущаяВкладкаВид", "none");
	ДопПараметрыВызоваMCP.Вставить("ПредыдущаяВкладкаКлюч", "none|");
	ДопПараметрыВызоваMCP.Вставить("КоличествоВкладокПроверяемогоФайлаДо", 0);
	ДопПараметрыВызоваMCP.Вставить("ПроверяемыйФайл", "");
	ДопПараметрыВызоваMCP.Вставить("ПроверяемыйФайлБылОткрыт", Ложь);
	ДопПараметрыВызоваMCP.Вставить("ПроверяемыйФайлБылОткрытВРедакторе", Ложь);
	ДопПараметрыВызоваMCP.Вставить("ПредыдущийКаталогФич", Ванесса.Объект.КаталогФич);
	ДопПараметрыВызоваMCP.Вставить("Идентификатор", Запрос.Идентификатор);
	Если Ванесса.VanessaTabs <> Неопределено Тогда
		// Запоминаем любую активную вкладку, а не только edit: в ответе должно быть
		// понятно, что было активно до проверки, включая memory:welcome.
		ОписаниеПредыдущейВкладки = MCPОписаниеВкладки(Ванесса.VanessaTabs.current);
		ДопПараметрыВызоваMCP.ПредыдущаяВкладка = ОписаниеПредыдущейВкладки.ИмяФайла;
		ДопПараметрыВызоваMCP.ПредыдущаяВкладкаЗаголовок = ОписаниеПредыдущейВкладки.Заголовок;
		ДопПараметрыВызоваMCP.ПредыдущаяВкладкаВид = ОписаниеПредыдущейВкладки.Вид;
		ДопПараметрыВызоваMCP.ПредыдущаяВкладкаКлюч = ОписаниеПредыдущейВкладки.Ключ;
		ТекстОшибкиНормализации = "";
		ПолныйПутьКФайлу = MCPНормализоватьПутьКФичам(ПутьКФайлу, ТекстОшибкиНормализации);
		Если НЕ ЗначениеЗаполнено(ТекстОшибкиНормализации) И ЗначениеЗаполнено(ПолныйПутьКФайлу) Тогда
			ДопПараметрыВызоваMCP.ПроверяемыйФайл = ПолныйПутьКФайлу;
			ДопПараметрыВызоваMCP.ПроверяемыйФайлБылОткрыт = MCPВкладкаСФайлом(ПолныйПутьКФайлу);
			ДопПараметрыВызоваMCP.ПроверяемыйФайлБылОткрытВРедакторе = MCPВкладкаСФайломВРедакторе(ПолныйПутьКФайлу);
			ДопПараметрыВызоваMCP.КоличествоВкладокПроверяемогоФайлаДо = MCPКоличествоВкладокСФайлом(ПолныйПутьКФайлу, Истина);
		КонецЕсли;	
	КонецЕсли;	
	
	MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.Запрос", Новый Структура(
		"Файл, ПроверяемыйФайл, ПредыдущаяВкладка, ПредыдущаяВкладкаЗаголовок, ПредыдущаяВкладкаВид, ПроверяемыйФайлБылОткрыт, ПроверяемыйФайлБылОткрытВРедакторе, КоличествоВкладокПроверяемогоФайлаДо, ПредыдущийКаталогФич, Идентификатор",
		ПутьКФайлу, ДопПараметрыВызоваMCP.ПроверяемыйФайл, ДопПараметрыВызоваMCP.ПредыдущаяВкладка, ДопПараметрыВызоваMCP.ПредыдущаяВкладкаЗаголовок,
		ДопПараметрыВызоваMCP.ПредыдущаяВкладкаВид, ДопПараметрыВызоваMCP.ПроверяемыйФайлБылОткрыт, ДопПараметрыВызоваMCP.ПроверяемыйФайлБылОткрытВРедакторе,
		ДопПараметрыВызоваMCP.КоличествоВкладокПроверяемогоФайлаДо, ДопПараметрыВызоваMCP.ПредыдущийКаталогФич, Запрос.Идентификатор));

	ОткрытиеФичаФайлаВРедакторе(ПутьКФайлу, Запрос, "СинтаксКонтроль", ДопПараметрыВызоваMCP);	
	
КонецФункции

// Общая точка входа open_feature_file и load_features: путь может быть не указан.
&НаКлиенте
Функция MCPОткрытьФичаФайлПоПути(Запрос, ИмяПараметраПути, ТипВызова)
	
	ПутьКФайлу = MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, ИмяПараметраПути);
	
	ДопПараметрыВызоваMCP = Новый Структура;
	ДопПараметрыВызоваMCP.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
	ДопПараметрыВызоваMCP.Вставить("ИсточникИзАктивнойВкладки", Ложь);
	ДопПараметрыВызоваMCP.Вставить("Идентификатор", Запрос.Идентификатор);
	
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Если ТипВызова = "ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл" Тогда
			ТекстОшибки = Неопределено;
			ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
					Ванесса.Локализовать("Не удалось определить текущий файл. Укажите путь к файлу."));
			КонецЕсли;
		Иначе
			Попытка
				Если НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
						Ванесса.Локализовать("Редактор Vanessa Editor не инициализирован. Укажите путь к файлу."));
				КонецЕсли;
				Если Ванесса.VanessaTabs = Неопределено Тогда
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
						Ванесса.Локализовать("Редактор Vanessa Editor не инициализирован. Укажите путь к файлу."));
				КонецЕсли;
				Если Ванесса.VanessaTabs.count() = 0 Тогда
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
						Ванесса.Локализовать("В редакторе нет вкладок. Укажите путь к файлу."));
				КонецЕсли;
				Вкладка = Ванесса.VanessaTabs.current;
				Если Вкладка = Неопределено Тогда
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
						Ванесса.Локализовать("Активная вкладка не определена. Укажите путь к файлу."));
				КонецЕсли;
				Если НЕ Ванесса.ЭтоВкладкаEdit(Вкладка) ИЛИ Ванесса.ЭтоВкладкаDiff(Вкладка) Тогда
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
						Ванесса.Локализовать("Активна вкладка diff/viewer. Укажите путь к файлу."));
				КонецЕсли;
				ОписаниеВкладки = MCPОписаниеВкладкиБезопасно(Вкладка);
				ИмяФайлаВкладки = ОписаниеВкладки.ИмяФайла;
				ЭтоПустаяВкладка = НЕ ЗначениеЗаполнено(ИмяФайлаВкладки);
				Если НЕ ЭтоПустаяВкладка Тогда
					ЭтоПустаяВкладка = Ванесса.МодульРедакторТекста().ИмяФайлаСоответствуетПустойНовойРедактора(ИмяФайлаВкладки);
				КонецЕсли;
				Если ЭтоПустаяВкладка Тогда
					Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
						Ванесса.Локализовать("Текущая вкладка не связана с файлом на диске. Укажите путь к файлу."));
				КонецЕсли;
				ПутьКФайлу = ИмяФайлаВкладки;
				ДопПараметрыВызоваMCP.ИсточникИзАктивнойВкладки = Истина;
			Исключение
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
					Ванесса.Локализовать("Не удалось определить файл активной вкладки:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	ОткрытиеФичаФайлаВРедакторе(ПутьКФайлу, Запрос, ТипВызова, ДопПараметрыВызоваMCP);
	Возврат Неопределено;
	
КонецФункции

// Открывает фича файл
&НаКлиенте
Функция ОткрытьФичаФайл(Запрос, ДополнительныеПараметры) Экспорт
	
	Возврат MCPОткрытьФичаФайлПоПути(Запрос, "filePath", "ОткрытьФичаФайл");
	
КонецФункции

// Загружает или перезагружает .feature файлы
&НаКлиенте
Функция ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл(Запрос, ДополнительныеПараметры) Экспорт
	
	Возврат MCPОткрытьФичаФайлПоПути(Запрос, "path", "ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл");
	
КонецФункции

// Получает состояние редактора
&НаКлиенте
Функция ПолучитьСостояниеРедактора(Запрос, ДополнительныеПараметры) Экспорт
	
	ВключитьСодержимое = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "includeContent", Истина);
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Состояние редактора"));
	Строки.Добавить("");
	
	// Вкладки
	Строки.Добавить(Ванесса.Локализовать("## Открытые вкладки"));
	Если Ванесса.VanessaTabs <> Неопределено Тогда
		Попытка
			КоличествоВкладок = Ванесса.VanessaTabs.count();
			Строки.Добавить(Ванесса.Локализовать("Количество:") + " " + Формат(КоличествоВкладок, "ЧГ=0; ЧН=0"));
			Строки.Добавить("");
			
			Для Инд = 0 По КоличествоВкладок - 1 Цикл
				Вкладка = Ванесса.VanessaTabs.tabStack[Инд];
				ИмяФайла = Вкладка.filename;
				Изменена = Вкладка.modified;
				Текущая = (Ванесса.VanessaTabs.current <> Неопределено И НРег(Ванесса.VanessaTabs.current.filename) = НРег(ИмяФайла));
				
				Префикс = "";
				Если Текущая Тогда
					Префикс = "**→** ";
				КонецЕсли;
				
				Суффикс = "";
				Если Изменена = Истина Тогда
					Суффикс = " " + Ванесса.Локализовать("*(изменена)*");
				КонецЕсли;
				
				Строки.Добавить("- " + Префикс + ИмяФайла + Суффикс);
			КонецЦикла;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("ошибка чтения вкладок:") + " " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Редактор не инициализирован. Загрузите фичи: `load_features`."));
	КонецЕсли;
	Строки.Добавить("");
	
	// Текущий файл и позиция
	Строки.Добавить(Ванесса.Локализовать("## Активный документ"));
	Если Не Ванесса.ОтсутствуетVanessaEditor() Тогда
		Попытка
			Редактор = Ванесса.ПолучитьVanessaEditor();
			
			// Позиция курсора
			Позиция = Неопределено;
			Попытка
				Позиция = Редактор.getPosition();
				Если Позиция <> Неопределено Тогда
					Строки.Добавить(Ванесса.Локализовать("- Строка:") + " " + Формат(Позиция.lineNumber, "ЧГ=0; ЧН=0"));
				КонецЕсли;
			Исключение
			КонецПопытки;

			// Выбранный сценарий
			ЕстьВыбранныйСценарий = Ложь;
			Если Позиция <> Неопределено Тогда
				СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(Позиция.lineNumber);
				Если СтрокаДерева <> Неопределено Тогда
					ЭтоПример = Ложь;
					ЭтоШагКонтекста = Ложь;
					СтрокаСценария = Ванесса.НайтиСтрокуСценарияЧерезРодителя(СтрокаДерева, ЭтоПример, ЭтоШагКонтекста);
					Если СтрокаСценария <> Неопределено Тогда
						ЕстьВыбранныйСценарий = Истина;
						Строки.Добавить("");
						Строки.Добавить(Ванесса.Локализовать("### Выбранный сценарий:") + " " + СтрокаСценария.Имя);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЕстьВыбранныйСценарий Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("### Выбранный сценарий:") + " " + Ванесса.Локализовать("Нет выбранного сценария. Можно запустить все сценарии на выполнение с помощью"));
			КонецЕсли;
			
			// Все сценарии текущей вкладки
			ВсеСценарии = Ванесса.ПолучитьИменаСценариевПоТекущейФиче();
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("### Всего сценариев в файле:") + " " + ВсеСценарии.Количество());
			Строки.Добавить(Ванесса.Локализовать("### Все сценарии из файла:"));
			Для Каждого ТекСценарий Из ВсеСценарии Цикл
				Строки.Добавить("- " + ТекСценарий.Имя);
			КонецЦикла;
			
			// Содержимое
			Если ВключитьСодержимое Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("### Содержимое"));
				Строки.Добавить("```gherkin");
				Попытка
					Содержимое = Редактор.getContent();
					Если ЗначениеЗаполнено(Содержимое) Тогда
						Строки.Добавить(Содержимое);
					Иначе
						Строки.Добавить(Ванесса.Локализовать("(пустой документ)"));
					КонецЕсли;
				Исключение
					Строки.Добавить(Ванесса.Локализовать("(ошибка чтения:") + " " + ОписаниеОшибки() + ")");
				КонецПопытки;
				Строки.Добавить("```");
			КонецЕсли;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("ошибка доступа к редактору:") + " " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Редактор не открыт"));
	КонецЕсли;
	Строки.Добавить("");
	
	// Ошибки
	Строки.Добавить(Ванесса.Локализовать("## Ошибки в редакторе"));
	Попытка
		Если Ванесса.ДанныеОшибокVanessaEditor <> Неопределено И ТипЗнч(Ванесса.ДанныеОшибокVanessaEditor) = Тип("Соответствие") Тогда
			КоличествоОшибок = 0;
			Для Каждого КлючЗначение Из Ванесса.ДанныеОшибокVanessaEditor Цикл
				КоличествоОшибок = КоличествоОшибок + 1;
			КонецЦикла;
			Строки.Добавить(Ванесса.Локализовать("Количество:") + " " + Формат(КоличествоОшибок, "ЧГ=0; ЧН=0"));
			Если КоличествоОшибок > 0 Тогда
				Для Каждого КлючЗначение Из Ванесса.ДанныеОшибокVanessaEditor Цикл
					Строки.Добавить(Ванесса.Локализовать("- Строка") + " " + Формат(КлючЗначение.Значение.НомерСтрокиВФиче, "ЧГ=0; ЧН=0") + ". Текст ошибки: " + КлючЗначение.Значение.КраткийТекстОшибки);
					Строки.Добавить("  " + Ванесса.Локализовать("Имя feature файла где возникла эта ошибка:") + " " + КлючЗначение.Значение.ИмяФичи);
				КонецЦикла;
			КонецЕсли;
		Иначе
			Строки.Добавить(Ванесса.Локализовать("нет ошибок"));
		КонецЕсли;
	Исключение
		Строки.Добавить(Ванесса.Локализовать("ошибка чтения:") + " " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Управляет редактором Vanessa Automation. Действия синхронные: загрузка фичи и запуск
// сценариев остаются отдельными асинхронными инструментами.
&НаКлиенте
Функция УправлятьРедактором(Запрос, ДополнительныеПараметры) Экспорт
	
	Действие = НРег(СокрЛП(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "action")));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Не указан обязательный параметр 'action'."));
	КонецЕсли;
	
	Попытка
		Если Действие = "get_state" Тогда
			Возврат MCPСостояниеРедактораMarkdown(Запрос);
		ИначеЕсли Действие = "list_tabs" Тогда
			Возврат MCPСписокВкладокMarkdown();
		ИначеЕсли Действие = "activate_tab" Тогда
			Возврат MCPАктивизироватьВкладку(Запрос);
		ИначеЕсли Действие = "get_tab_content" Тогда
			Возврат MCPПолучитьСодержимоеВкладки(Запрос);
		ИначеЕсли Действие = "save_tab" Тогда
			Возврат MCPСохранитьВкладку(Запрос);
		ИначеЕсли Действие = "close_tab" Тогда
			Возврат MCPЗакрытьВкладку(Запрос);
		ИначеЕсли Действие = "line_info" Тогда
			Возврат ПолучитьПодробнуюИнформациюОШагеВСтрокеСценария(Запрос, ДополнительныеПараметры);
		ИначеЕсли Действие = "list_breakpoints" Тогда
			Возврат MCPВыполнитьДействиеТочекОстанова(Запрос, "list");
		ИначеЕсли Действие = "toggle_breakpoint" Тогда
			Возврат MCPВыполнитьДействиеТочекОстанова(Запрос, "toggle");
		ИначеЕсли Действие = "remove_all_breakpoints" Тогда
			Возврат MCPВыполнитьДействиеТочекОстанова(Запрос, "remove_all");
		КонецЕсли;
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
		Ванесса.Локализовать("Неизвестное действие manage_editor:") + " " + Действие);
	
КонецФункции

// Возвращает текст причины, по которой редактор недоступен, или пустую строку.
&НаКлиенте
Функция MCPПричинаНедоступностиРедактора()
	
	Если НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		Возврат Ванесса.Локализовать("Редактор Vanessa Editor отключён в настройках.");
	КонецЕсли;
	Если Ванесса.VanessaTabs = Неопределено Тогда
		Возврат Ванесса.Локализовать("Редактор Vanessa Editor не инициализирован.");
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Безопасно описывает вкладку. Сбой чтения одной вкладки не должен ломать список.
&НаКлиенте
Функция MCPОписаниеВкладкиБезопасно(Вкладка, Индекс = Неопределено, Активная = Ложь)
	
	Описание = Новый Структура;
	Описание.Вставить("Индекс", Индекс);
	Описание.Вставить("ИмяФайла", "");
	Описание.Вставить("Заголовок", "");
	Описание.Вставить("Вид", "unknown");
	Описание.Вставить("Изменена", Ложь);
	Описание.Вставить("Активная", Активная);
	Описание.Вставить("НормализованныйПуть", "");
	Описание.Вставить("Ошибка", "");
	
	Если Вкладка = Неопределено Тогда
		Описание.Ошибка = Ванесса.Локализовать("Вкладка недоступна.");
		Возврат Описание;
	КонецЕсли;
	
	Попытка
		Значение = Вкладка.filename;
		Если Значение <> Неопределено И Значение <> Null Тогда
			Описание.ИмяФайла = СокрЛП(Строка(Значение));
		КонецЕсли;
	Исключение
		Описание.Ошибка = Ванесса.Локализовать("Не удалось прочитать filename вкладки.");
	КонецПопытки;
	
	Попытка
		Значение = Вкладка.title;
		Если Значение <> Неопределено И Значение <> Null Тогда
			Описание.Заголовок = СокрЛП(Строка(Значение));
		КонецЕсли;
	Исключение
		Если НЕ ЗначениеЗаполнено(Описание.Ошибка) Тогда
			Описание.Ошибка = Ванесса.Локализовать("Не удалось прочитать заголовок вкладки.");
		КонецЕсли;
	КонецПопытки;
	
	Попытка
		Если Ванесса.ЭтоВкладкаDiff(Вкладка) Тогда
			Описание.Вид = "diff";
		ИначеЕсли Ванесса.ЭтоВкладкаEdit(Вкладка) Тогда
			Описание.Вид = "edit";
		Иначе
			Описание.Вид = "viewer";
		КонецЕсли;
	Исключение
		Описание.Вид = "unknown";
	КонецПопытки;
	
	Если Описание.Вид = "edit" Тогда
		Попытка
			Описание.Изменена = (Вкладка.modified = Истина);
		Исключение
			Описание.Изменена = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Описание.НормализованныйПуть = MCPНормализоватьПутьДляСравнения(Описание.ИмяФайла);
	Возврат Описание;
	
КонецФункции

// Возвращает массив описаний всех вкладок. Индекс всегда соответствует VanessaTabs.tab(Индекс).
&НаКлиенте
Функция MCPОписанияВкладок()
	
	Результат = Новый Массив;
	Причина = MCPПричинаНедоступностиРедактора();
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		КоличествоВкладок = Ванесса.VanessaTabs.count();
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Для Индекс = 0 По КоличествоВкладок - 1 Цикл
		Вкладка = Неопределено;
		Попытка
			Вкладка = Ванесса.VanessaTabs.tab(Индекс);
		Исключение
			Вкладка = Неопределено;
		КонецПопытки;
		Результат.Добавить(MCPОписаниеВкладкиБезопасно(Вкладка, Индекс, Индекс = КоличествоВкладок - 1));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPЗначениеДляMarkdown(Значение)
	
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрЗаменить(СокрЛП(Строка(Значение)), "|", "\|");
	
КонецФункции

&НаКлиенте
Функция MCPСтрокаВкладкиMarkdown(Описание)
	
	Префикс = "";
	Если Описание.Активная Тогда
		Префикс = "**→** ";
	КонецЕсли;
	
	Номер = "";
	Если Описание.Индекс <> Неопределено Тогда
		Номер = Формат(Описание.Индекс, "ЧГ=0; ЧН=0") + ". ";
	КонецЕсли;
	
	Имя = MCPЗначениеДляMarkdown(Описание.ИмяФайла);
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Имя = "нет файла";
	КонецЕсли;
	
	РезультатСтроки = Префикс + Номер + Описание.Вид + " | " + Имя;
	Если Найти(НРег(Описание.ИмяФайла), "memory:") = 1 И ЗначениеЗаполнено(Описание.Заголовок) Тогда
		РезультатСтроки = Префикс + Номер + Описание.Вид + " | " + MCPЗначениеДляMarkdown(Описание.Заголовок) + " (" + Имя + ")";
	ИначеЕсли ЗначениеЗаполнено(Описание.Заголовок) Тогда
		РезультатСтроки = РезультатСтроки + " | " + MCPЗначениеДляMarkdown(Описание.Заголовок);
	КонецЕсли;
	Если Описание.Изменена Тогда
		РезультатСтроки = РезультатСтроки + " | изменена";
	КонецЕсли;
	Если ЗначениеЗаполнено(Описание.Ошибка) Тогда
		РезультатСтроки = РезультатСтроки + " | ошибка: " + MCPЗначениеДляMarkdown(Описание.Ошибка);
	КонецЕсли;
	
	Возврат РезультатСтроки;
	
КонецФункции

&НаКлиенте
Функция MCPСписокВкладокMarkdown()
	
	Строки = Новый Массив;
	Строки.Добавить("# Вкладки редактора");
	Строки.Добавить("");
	
	Причина = MCPПричинаНедоступностиРедактора();
	Если ЗначениеЗаполнено(Причина) Тогда
		Строки.Добавить("- " + Причина);
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Описания = MCPОписанияВкладок();
	Если Описания.Количество() = 0 Тогда
		Строки.Добавить("- Вкладок нет.");
	Иначе
		Строки.Добавить("- Всего: " + Формат(Описания.Количество(), "ЧГ=0; ЧН=0"));
		Для Каждого Описание Из Описания Цикл
			Строки.Добавить("- " + MCPСтрокаВкладкиMarkdown(Описание));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Состояние редактора в Markdown. Сценарии выводятся только когда дерево относится
// к активной файловой edit-вкладке.
&НаКлиенте
Функция MCPСостояниеРедактораMarkdown(Запрос)
	
	ВключитьСодержимое = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "includeContent", Истина);
	ВключитьДокумент = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "includeDocument", Истина);
	ВключитьВкладки = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "includeTabs", Истина);
	
	Строки = Новый Массив;
	Строки.Добавить("# Состояние редактора");
	Строки.Добавить("");
	
	Причина = MCPПричинаНедоступностиРедактора();
	Если ЗначениеЗаполнено(Причина) Тогда
		Строки.Добавить("- " + Причина);
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Описания = MCPОписанияВкладок();
	Активная = Неопределено;
	Если Описания.Количество() > 0 Тогда
		Активная = Описания[Описания.Количество() - 1];
	КонецЕсли;
	
	Если ВключитьВкладки Тогда
		Строки.Добавить("## Открытые вкладки");
		Если Описания.Количество() = 0 Тогда
			Строки.Добавить("- Вкладок нет.");
		Иначе
			Строки.Добавить("- Всего: " + Формат(Описания.Количество(), "ЧГ=0; ЧН=0"));
			Для Каждого Описание Из Описания Цикл
				Строки.Добавить("- " + MCPСтрокаВкладкиMarkdown(Описание));
			КонецЦикла;
		КонецЕсли;
		Строки.Добавить("");
	КонецЕсли;
	
	Если ВключитьДокумент Тогда
		Строки.Добавить("## Активный документ");
		Если Активная = Неопределено Тогда
			Строки.Добавить("- Нет активной вкладки.");
		Иначе
			Строки.Добавить("- Файл: " + MCPЗначениеДляMarkdown(Активная.ИмяФайла));
			Строки.Добавить("- Тип: " + Активная.Вид);
			Строки.Добавить("- Заголовок: " + MCPЗначениеДляMarkdown(Активная.Заголовок));
			Строки.Добавить("- Изменена: " + MCPБулевоВТекст(Активная.Изменена));
			
			Позиция = Неопределено;
			Попытка
				Позиция = Ванесса.ПолучитьVanessaEditor().getPosition();
			Исключение
				Позиция = Неопределено;
			КонецПопытки;
			Если Позиция <> Неопределено Тогда
				СтрокаКурсора = "";
				КолонкаКурсора = "";
				Попытка
					СтрокаКурсора = Формат(Позиция.lineNumber, "ЧГ=0; ЧН=0");
				Исключение
					СтрокаКурсора = "";
				КонецПопытки;
				Попытка
					КолонкаКурсора = Формат(Позиция.column, "ЧГ=0; ЧН=0");
				Исключение
					КолонкаКурсора = "";
				КонецПопытки;
				Если ЗначениеЗаполнено(СтрокаКурсора) Тогда
					Строки.Добавить("- Курсор: строка " + СтрокаКурсора + ", колонка " + КолонкаКурсора);
				КонецЕсли;
			КонецЕсли;
			
			Если ВключитьСодержимое Тогда
				Строки.Добавить("");
				Строки.Добавить("### Содержимое");
				Текст = MCPТекстАктивнойВкладки(Активная);
				Если Текст = Неопределено Тогда
					Строки.Добавить("- Содержимое недоступно.");
				Иначе
					Если Активная.Вид = "edit" И Прав(НРег(Активная.ИмяФайла), 8) = ".feature" Тогда
						Строки.Добавить("```gherkin");
					Иначе
						Строки.Добавить("```");
					КонецЕсли;
					Если ЗначениеЗаполнено(Текст) Тогда
						Строки.Добавить(Текст);
					Иначе
						Строки.Добавить("(пустой документ)");
					КонецЕсли;
					Строки.Добавить("```");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Строки.Добавить("");
		
		Строки.Добавить("## Ошибки в редакторе");
		Попытка
			Если Ванесса.ДанныеОшибокVanessaEditor <> Неопределено И ТипЗнч(Ванесса.ДанныеОшибокVanessaEditor) = Тип("Соответствие") Тогда
				КоличествоОшибок = 0;
				Для Каждого КлючЗначение Из Ванесса.ДанныеОшибокVanessaEditor Цикл
					КоличествоОшибок = КоличествоОшибок + 1;
				КонецЦикла;
				Строки.Добавить("- Количество: " + Формат(КоличествоОшибок, "ЧГ=0; ЧН=0"));
				Для Каждого КлючЗначение Из Ванесса.ДанныеОшибокVanessaEditor Цикл
					Строки.Добавить("- Строка " + Формат(КлючЗначение.Значение.НомерСтрокиВФиче, "ЧГ=0; ЧН=0") + ": " + MCPЗначениеДляMarkdown(КлючЗначение.Значение.КраткийТекстОшибки));
				КонецЦикла;
			Иначе
				Строки.Добавить("- нет ошибок");
			КонецЕсли;
		Исключение
			Строки.Добавить("- ошибка чтения: " + MCPЗначениеДляMarkdown(ОписаниеОшибки()));
		КонецПопытки;
		Строки.Добавить("");
	КонецЕсли;
	
	MCPДобавитьСтрокиДереваФич(Строки, Активная, ВключитьДокумент);
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция MCPБулевоВТекст(Значение)
	
	Если Значение = Истина Тогда
		Возврат "да";
	КонецЕсли;
	Возврат "нет";
	
КонецФункции

// Текст активной вкладки. Для неактивной вкладки используйте get_tab_content.
&НаКлиенте
Функция MCPТекстАктивнойВкладки(Описание)
	
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вкладка = Неопределено;
	Попытка
		Вкладка = Ванесса.VanessaTabs.current;
	Исключение
		Вкладка = Неопределено;
	КонецПопытки;
	Если Вкладка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Текст = Неопределено;
	Попытка
		Текст = Вкладка.model.getValue();
	Исключение
		Текст = Неопределено;
	КонецПопытки;
	Если Текст <> Неопределено И Текст <> Null Тогда
		Возврат Строка(Текст);
	КонецЕсли;
	
	Попытка
		Текст = Ванесса.ПолучитьVanessaEditor().getContent();
	Исключение
		Текст = Неопределено;
	КонецПопытки;
	Если Текст = Неопределено ИЛИ Текст = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Текст);
	
КонецФункции

&НаКлиенте
Процедура MCPДобавитьСтрокиДереваФич(Строки, Активная, ВключитьДокумент)
	
	Строки.Добавить("## Дерево фич");
	КаталогФич = "";
	Попытка
		КаталогФич = СокрЛП(Строка(Ванесса.Объект.КаталогФич));
	Исключение
		КаталогФич = "";
	КонецПопытки;
	Строки.Добавить("- Каталог фич: " + MCPЗначениеДляMarkdown(КаталогФич));
	
	ИмяФайлаДерева = "";
	Попытка
		ИмяФайлаДерева = СокрЛП(Строка(Ванесса.ИмяФайлаДереваТестов()));
	Исключение
		ИмяФайлаДерева = "";
	КонецПопытки;
	Строки.Добавить("- Файл дерева: " + MCPЗначениеДляMarkdown(ИмяФайлаДерева));
	
	ФлагЗагружены = Ложь;
	Попытка
		ФлагЗагружены = (Ванесса.ФлагСценарииЗагружены = Истина);
	Исключение
		ФлагЗагружены = Ложь;
	КонецПопытки;
	Строки.Добавить("- ФлагСценарииЗагружены: " + MCPБулевоВТекст(ФлагЗагружены));
	
	ДанныеЗагрузки = Неопределено;
	Попытка
		ДанныеЗагрузки = Ванесса.ДанныеПоследнейЗагрузкиФичиMCP();
	Исключение
		ДанныеЗагрузки = Неопределено;
	КонецПопытки;
	Если ТипЗнч(ДанныеЗагрузки) = Тип("Структура") Тогда
		Статус = "";
		ДанныеЗагрузки.Свойство("Статус", Статус);
		ФайлЗагрузки = "";
		ДанныеЗагрузки.Свойство("Файл", ФайлЗагрузки);
		ТекстОшибки = "";
		ДанныеЗагрузки.Свойство("ТекстОшибки", ТекстОшибки);
		Строки.Добавить("- Последняя загрузка: " + MCPЗначениеДляMarkdown(Статус) + " (" + MCPЗначениеДляMarkdown(ФайлЗагрузки) + ")");
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Строки.Добавить("- Ошибка загрузки: " + MCPЗначениеДляMarkdown(ТекстОшибки));
		КонецЕсли;
	КонецЕсли;
	
	Если Активная = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ФайлАктивной = Активная.ИмяФайла;
	Если Активная.Вид = "edit" И ЗначениеЗаполнено(ФайлАктивной) И ЗначениеЗаполнено(ИмяФайлаДерева) Тогда
		Если НЕ MCPПутиСовпадают(ФайлАктивной, ИмяФайлаДерева) Тогда
			Строки.Добавить("- Предупреждение: дерево загружено для другого файла (" + MCPЗначениеДляMarkdown(ИмяФайлаДерева) + "); сценарии к активной вкладке не относятся.");
			Возврат;
		КонецЕсли;
	ИначеЕсли Активная.Вид <> "edit" ИЛИ НЕ ЗначениеЗаполнено(ФайлАктивной) Тогда
		Строки.Добавить("- Сценарии к активной вкладке не относятся.");
		Возврат;
	КонецЕсли;
	
	Если НЕ ФлагЗагружены Тогда
		Строки.Добавить("- Дерево ещё не загружено.");
		Возврат;
	КонецЕсли;
	
	Если НЕ ВключитьДокумент Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Сценарии = Ванесса.ПолучитьИменаСценариевПоТекущейФиче();
	Исключение
		Сценарии = Неопределено;
	КонецПопытки;
	Если Сценарии = Неопределено Тогда
		Строки.Добавить("- Не удалось прочитать сценарии.");
		Возврат;
	КонецЕсли;
	Строки.Добавить("- Сценариев: " + Формат(Сценарии.Количество(), "ЧГ=0; ЧН=0"));
	Для Каждого Сценарий Из Сценарии Цикл
		Строки.Добавить("  - " + MCPЗначениеДляMarkdown(Сценарий.Имя));
	КонецЦикла;
	
КонецПроцедуры

// Ищет ровно одну вкладку по одному селектору. Возвращает структуру с результатом,
// чтобы вызывающая сторона могла вернуть INVALID_PARAMS или ACTION_FAILED.
&НаКлиенте
Функция MCPНайтиВкладкуПоСелектору(Запрос, Действие)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Код", "");
	Результат.Вставить("Текст", "");
	Результат.Вставить("Индекс", Неопределено);
	Результат.Вставить("Описание", Неопределено);
	
	Причина = MCPПричинаНедоступностиРедактора();
	Если ЗначениеЗаполнено(Причина) Тогда
		Результат.Код = "ACTION_FAILED";
		Результат.Текст = Причина;
		Возврат Результат;
	КонецЕсли;
	
	ИндексПрисутствует = MCPVAСлужебныйМодуль.ПараметрПрисутствуетВЗапросе(Запрос, "index");
	ЗначениеИндекса = MCPVAСлужебныйМодуль.ЗначениеПараметраИзЗапроса(Запрос, "index");
	ИндексЗадан = Ложь;
	Если ИндексПрисутствует Тогда
		Если ЗначениеИндекса <> Неопределено И ЗначениеИндекса <> Null Тогда
			Если ТипЗнч(ЗначениеИндекса) = Тип("Строка") Тогда
				ИндексЗадан = ЗначениеЗаполнено(СокрЛП(ЗначениеИндекса));
			Иначе
				ИндексЗадан = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПутьЗадан = ЗначениеЗаполнено(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "filePath"));
	ЗаголовокЗадан = ЗначениеЗаполнено(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "title"));
	КоличествоСелекторов = 0;
	Если ИндексЗадан Тогда
		КоличествоСелекторов = КоличествоСелекторов + 1;
	КонецЕсли;
	Если ПутьЗадан Тогда
		КоличествоСелекторов = КоличествоСелекторов + 1;
	КонецЕсли;
	Если ЗаголовокЗадан Тогда
		КоличествоСелекторов = КоличествоСелекторов + 1;
	КонецЕсли;
	Если КоличествоСелекторов <> 1 Тогда
		Результат.Код = "INVALID_PARAMS";
		Результат.Текст = Ванесса.Локализовать("Для действия") + " " + Действие + " " + Ванесса.Локализовать("укажите ровно один селектор: index, filePath или title.");
		Возврат Результат;
	КонецЕсли;
	
	ВидФильтр = НРег(СокрЛП(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "type")));
	Если НЕ ЗначениеЗаполнено(ВидФильтр) Тогда
		ВидФильтр = "any";
	КонецЕсли;
	Если ВидФильтр <> "any" И ВидФильтр <> "edit" И ВидФильтр <> "diff" И ВидФильтр <> "viewer" Тогда
		Результат.Код = "INVALID_PARAMS";
		Результат.Текст = Ванесса.Локализовать("Недопустимый type. Допустимо: any, edit, diff, viewer.");
		Возврат Результат;
	КонецЕсли;
	
	Описания = MCPОписанияВкладок();
	КоличествоВкладок = Описания.Количество();
	
	Если ИндексЗадан Тогда
		Если ТипЗнч(ЗначениеИндекса) <> Тип("Число") Тогда
			Результат.Код = "INVALID_PARAMS";
			Результат.Текст = Ванесса.Локализовать("Параметр index должен быть целым числом.");
			Возврат Результат;
		КонецЕсли;
		Если Цел(ЗначениеИндекса) <> ЗначениеИндекса ИЛИ ЗначениеИндекса < 0 Тогда
			Результат.Код = "INVALID_PARAMS";
			Результат.Текст = Ванесса.Локализовать("Параметр index должен быть неотрицательным целым числом.");
			Возврат Результат;
		КонецЕсли;
		Если ЗначениеИндекса >= КоличествоВкладок Тогда
			Результат.Код = "ACTION_FAILED";
			Результат.Текст = Ванесса.Локализовать("Индекс вкладки вне диапазона. Всего вкладок:") + " " + Формат(КоличествоВкладок, "ЧГ=0; ЧН=0");
			Возврат Результат;
		КонецЕсли;
		Индекс = Цел(ЗначениеИндекса);
		Описание = Описания[Индекс];
		Если ВидФильтр <> "any" И Описание.Вид <> ВидФильтр Тогда
			Результат.Код = "ACTION_FAILED";
			Результат.Текст = Ванесса.Локализовать("Тип вкладки не совпал: ожидался") + " " + ВидФильтр + ", " + Ванесса.Локализовать("фактически") + " " + Описание.Вид + ".";
			Возврат Результат;
		КонецЕсли;
		Результат.Успех = Истина;
		Результат.Индекс = Индекс;
		Результат.Описание = Описание;
		Возврат Результат;
	КонецЕсли;
	
	Кандидаты = Новый Массив;
	Если ПутьЗадан Тогда
		ИскомыйПуть = MCPНормализоватьПутьВкладки(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "filePath"));
		Если НЕ ЗначениеЗаполнено(ИскомыйПуть) Тогда
			Результат.Код = "INVALID_PARAMS";
			Результат.Текст = Ванесса.Локализовать("Не удалось нормализовать filePath.");
			Возврат Результат;
		КонецЕсли;
		Для Каждого Описание Из Описания Цикл
			Если ВидФильтр <> "any" И Описание.Вид <> ВидФильтр Тогда
				Продолжить;
			КонецЕсли;
			Если Описание.НормализованныйПуть = ИскомыйПуть Тогда
				Кандидаты.Добавить(Описание);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИскомыйЗаголовок = НРег(СокрЛП(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "title")));
		Для Каждого Описание Из Описания Цикл
			Если ВидФильтр <> "any" И Описание.Вид <> ВидФильтр Тогда
				Продолжить;
			КонецЕсли;
			Если НРег(СокрЛП(Описание.Заголовок)) = ИскомыйЗаголовок Тогда
				Кандидаты.Добавить(Описание);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Кандидаты.Количество() = 0 Тогда
		Результат.Код = "ACTION_FAILED";
		Результат.Текст = Ванесса.Локализовать("Вкладка не найдена.") + Символы.ПС + MCPСписокВкладокMarkdown();
		Возврат Результат;
	КонецЕсли;
	Если Кандидаты.Количество() > 1 Тогда
		Результат.Код = "ACTION_FAILED";
		Результат.Текст = Ванесса.Локализовать("Найдено несколько вкладок. Укажите index или type.") + Символы.ПС + MCPСписокКандидатовMarkdown(Кандидаты);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Индекс = Кандидаты[0].Индекс;
	Результат.Описание = Кандидаты[0];
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPСписокКандидатовMarkdown(Кандидаты)
	
	Строки = Новый Массив;
	Строки.Добавить("## Кандидаты");
	Максимум = 20;
	Для Индекс = 0 По Кандидаты.Количество() - 1 Цикл
		Если Индекс >= Максимум Тогда
			Строки.Добавить("- показано " + Формат(Максимум, "ЧГ=0; ЧН=0") + " из " + Формат(Кандидаты.Количество(), "ЧГ=0; ЧН=0"));
			Прервать;
		КонецЕсли;
		Строки.Добавить("- " + MCPСтрокаВкладкиMarkdown(Кандидаты[Индекс]));
	КонецЦикла;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция MCPНормализоватьПутьВкладки(Путь)
	
	Если Путь = Неопределено ИЛИ Путь = Null Тогда
		Возврат "";
	КонецЕсли;
	СтрокаПути = СокрЛП(Строка(Путь));
	Если НЕ ЗначениеЗаполнено(СтрокаПути) Тогда
		Возврат "";
	КонецЕсли;
	Если Найти(НРег(СтрокаПути), "memory:") = 1 Тогда
		Возврат НРег(СтрокаПути);
	КонецЕсли;
	
	Кандидат = СтрокаПути;
	Попытка
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(Кандидат) Тогда
			КандидатВКаталогеПроекта = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + СтрокаПути;
			Если Ванесса.ФайлСуществуетКомандаСистемы(КандидатВКаталогеПроекта) Тогда
				Кандидат = КандидатВКаталогеПроекта;
			КонецЕсли;
		КонецЕсли;
		Кандидат = Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Кандидат);
	Исключение
		Кандидат = СтрокаПути;
	КонецПопытки;
	
	Возврат MCPНормализоватьПутьДляСравнения(Кандидат);
	
КонецФункции

&НаКлиенте
Функция MCPОжидаемыйКаталогФичПоВкладке(Описание)
	
	Если Описание = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Описание.Вид <> "edit" Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Описание.ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Если Ванесса.МодульРедакторТекста().ИмяФайлаСоответствуетПустойНовойРедактора(Описание.ИмяФайла) Тогда
			Возврат "";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат Описание.ИмяФайла;
	
КонецФункции

// Явно синхронизирует КаталогФич с активной вкладкой. Возвращает текст предупреждения
// или пустую строку. Повторный вызов из события ON_TAB_SELECT идемпотентен.
&НаКлиенте
Функция MCPСинхронизироватьКаталогФичСАктивнойВкладкой(Описание)
	
	Ожидаемый = MCPОжидаемыйКаталогФичПоВкладке(Описание);
	Текущий = "";
	Попытка
		Текущий = Ванесса.Объект.КаталогФич;
	Исключение
		Текущий = "";
	КонецПопытки;
	Если MCPНормализоватьПутьДляСравнения(Текущий) = MCPНормализоватьПутьДляСравнения(Ожидаемый) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Ванесса.МодульРедакторТекста().ПриСменеЗакладкиРедактора(Ванесса.VanessaTabs.current);
	Исключение
		Возврат Ванесса.Локализовать("Не удалось синхронизировать КаталогФич:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		Текущий = Ванесса.Объект.КаталогФич;
	Исключение
		Текущий = "";
	КонецПопытки;
	Если MCPНормализоватьПутьДляСравнения(Текущий) <> MCPНормализоватьПутьДляСравнения(Ожидаемый) Тогда
		Возврат Ванесса.Локализовать("КаталогФич не совпадает с активной вкладкой.");
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция MCPАктивизироватьВкладку(Запрос)
	
	Найденная = MCPНайтиВкладкуПоСелектору(Запрос, "activate_tab");
	Если НЕ Найденная.Успех Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента(Найденная.Код, Найденная.Текст);
	КонецЕсли;
	
	РазрешитьПрогон = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "allowDuringRun", Ложь);
	Если Ванесса.Объект.ИдетВыполнениеСценариев И НЕ РазрешитьПрогон Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Сценарии уже выполняются. Переключение вкладки изменит КаталогФич. Дождитесь завершения прогона."));
	КонецЕсли;
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
	КонецЕсли;
	
	Индекс = Найденная.Индекс;
	Цель = Найденная.Описание;
	КоличествоДо = MCPКоличествоВкладок();
	Предупреждения = Новый Массив;
	Если РазрешитьПрогон И Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		Предупреждения.Добавить(Ванесса.Локализовать("Вкладка активирована во время прогона: КаталогФич изменён."));
	КонецЕсли;
	
	УжеАктивна = (Индекс = КоличествоДо - 1);
	Если УжеАктивна Тогда
		ТекстПредупреждения = MCPСинхронизироватьКаталогФичСАктивнойВкладкой(Цель);
		Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
			Предупреждения.Добавить(ТекстПредупреждения);
		КонецЕсли;
	Иначе
		Попытка
			Ванесса.VanessaTabs.select(Индекс);
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Не удалось активировать вкладку:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		КонецПопытки;
		
		КоличествоПосле = MCPКоличествоВкладок();
		Текущая = Неопределено;
		Попытка
			Текущая = Ванесса.VanessaTabs.current;
		Исключение
			Текущая = Неопределено;
		КонецПопытки;
		Если КоличествоПосле <> КоличествоДо ИЛИ Текущая = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Состояние редактора изменилось во время активации вкладки."));
		КонецЕсли;
		
		ОписаниеТекущей = MCPОписаниеВкладкиБезопасно(Текущая, КоличествоПосле - 1, Истина);
		Если ОписаниеТекущей.Вид <> Цель.Вид
			ИЛИ ОписаниеТекущей.НормализованныйПуть <> Цель.НормализованныйПуть
			ИЛИ НРег(СокрЛП(ОписаниеТекущей.Заголовок)) <> НРег(СокрЛП(Цель.Заголовок)) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("После select активная вкладка не совпала с выбранной."));
		КонецЕсли;
		
		Попытка
			Ванесса.МодульРедакторТекста().ПриСменеЗакладкиРедактора(Текущая);
		Исключение
			Предупреждения.Добавить(Ванесса.Локализовать("Не удалось синхронизировать КаталогФич:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		КонецПопытки;
		
		ТекстПредупреждения = MCPСинхронизироватьКаталогФичСАктивнойВкладкой(Цель);
		Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
			Предупреждения.Добавить(ТекстПредупреждения);
		КонецЕсли;
	КонецЕсли;
	
	КаталогФич = "";
	Попытка
		КаталогФич = СокрЛП(Строка(Ванесса.Объект.КаталогФич));
	Исключение
		КаталогФич = "";
	КонецПопытки;
	Цель.Активная = Истина;
	Если ЗначениеЗаполнено(КаталогФич) И Прав(НРег(КаталогФич), 8) <> ".feature" Тогда
		Предупреждения.Добавить(Ванесса.Локализовать("КаталогФич не оканчивается на .feature."));
	КонецЕсли;
	
	MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.Активация",
		Новый Структура("Индекс, Файл, Вид, КаталогФич, УжеАктивна", Индекс, Цель.ИмяФайла, Цель.Вид, КаталогФич, УжеАктивна));
	
	Строки = Новый Массив;
	Если УжеАктивна Тогда
		Строки.Добавить("# Вкладка уже активна");
	Иначе
		Строки.Добавить("# Вкладка активирована");
	КонецЕсли;
	Строки.Добавить("");
	Строки.Добавить("- Вкладка: " + MCPСтрокаВкладкиMarkdown(Цель));
	Строки.Добавить("- Всего вкладок: " + Формат(MCPКоличествоВкладок(), "ЧГ=0; ЧН=0"));
	Строки.Добавить("- Каталог фич: " + MCPЗначениеДляMarkdown(КаталогФич));
	Если Предупреждения.Количество() = 0 Тогда
		Строки.Добавить("- Предупреждения: нет");
	Иначе
		Строки.Добавить("- Предупреждения:");
		Для Каждого ТекстПредупрежденияСтрокой Из Предупреждения Цикл
			Строки.Добавить("  - " + ТекстПредупрежденияСтрокой);
		КонецЦикла;
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

