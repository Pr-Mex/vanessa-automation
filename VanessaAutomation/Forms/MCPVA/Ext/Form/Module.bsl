// Сохраняет табличный документ в файл
&НаКлиенте
Функция СохранитьТабличныйДокументВФайл(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр file_name (обязательный)
	ИмяФайла = Строка(ЗначениеПараметраИзЗапроса(Запрос, "file_name"));
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр file_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр form_element_name (обязательный)
	ИмяЭлементаФормы = Строка(ЗначениеПараметраИзЗапроса(Запрос, "form_element_name"));
	Если НЕ ЗначениеЗаполнено(ИмяЭлементаФормы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр form_element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр format (по умолчанию 'mxl')
	Формат = Строка(ЗначениеПараметраИзЗапроса(Запрос, "format"));
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		Формат = "mxl";
	Иначе
		Формат = НРег(СокрЛП(Формат));
	КонецЕсли;
	
	// Проверка допустимого значения формата
	Если Формат <> "mxl" И Формат <> "xlsx" И Формат <> "pdf" Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение format. Допустимые значения: 'mxl', 'xlsx', 'pdf'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Получаем табличный документ из активной формы
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	Попытка
		ТабличныйДокумент = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлементаФормы, Истина,,,ДопПараметры);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	// Сохраняем табличный документ в файл
	Попытка
		// ИндексФильтра начинается с нуля
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("РасширениеФайла", Формат);
		ДопПараметры.Вставить("ИмяФайлаДляСохранения", ИмяФайла);
		Если Формат = "pdf" Тогда
			ДопПараметры.Вставить("ИндексФильтра", 2);
		ИначеЕсли Формат = "xlsx" Тогда
			ДопПараметры.Вставить("ИндексФильтра", 7);
		КонецЕсли;	
		ТабДок = Ванесса.ПолучитьТабличныйДокументTestClient(ТабличныйДокумент, ДопПараметры);
		
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"# Табличный документ %1 сохранен
			|
			|- Файл: %2
			|- Формат: %3"),ИмяЭлементаФормы, ИмяФайла,Формат);
		Возврат ТекстОтвета;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка сохранения табличного документа:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Возвращает данные указанного элемента формы
&НаКлиенте
Функция ПолучитьДанныеЭлементаФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр element_name (обязательный)
	ИмяЭлемента = Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_name"));
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Получаем элемент формы
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	Попытка
		ЭлементФормы = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Если ЭлементФормы = Неопределено Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Элемент формы '%1' не найден."), ИмяЭлемента);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Получаем данные элемента
	Попытка
		ДанныеЭлемента = Новый Структура;
		ДанныеЭлемента.Вставить("Имя", ИмяЭлемента);
		
		// Получаем заголовок элемента
		ЗаголовокЭлемента = Неопределено;
		Попытка
			ЗаголовокЭлемента = ЭлементФормы.ТекстЗаголовка;
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Заголовок", ЗаголовокЭлемента);
		
		// Получаем тип элемента
		ТипЭлемента = Неопределено;
		Попытка
			ТипЭлемента = Строка(ТипЗнч(ЭлементФормы));
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Тип", ТипЭлемента);
		
		// Получаем вид элемента
		ВидЭлемента = Неопределено;
		Попытка
			ВидЭлемента = Строка(ЭлементФормы.Вид);
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Вид", ВидЭлемента);
		
		// Получаем значение элемента
		ЗначениеЭлемента = Неопределено;
		ТекстРедактирования = Неопределено;
		Попытка
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("УдалятьПустыеСтрокиИзМакета", Ложь);
			СостояниеФормыTestClient = Ванесса.ПолучитьСостояниеЭлементаФормыTestClient(ЭлементФормы, ДопПараметры);
			Если ТипЗнч(ЭлементФормы) = Тип("ТестируемаяТаблицаФормы") Тогда
				ЗначениеЭлемента = Ванесса.ПолучитьСтрокуСТЧФормаTestClient(СостояниеФормыTestClient.ЗначениеТЧ, Неопределено);
			ИначеЕсли СостояниеФормыTestClient.Вид = ВидПоляФормы.ПолеТабличногоДокумента Тогда
				ЗначениеЭлемента = Ванесса.ПолучитьСтрокуТабличныйДокументФормаTestClient(СостояниеФормыTestClient.ТабДок);
			Иначе	
				ЗначениеЭлемента = СостояниеФормыTestClient.ПредставлениеДанных;
				Если СостояниеФормыTestClient.Свойство("ТекстРедактирования") Тогда
					ТекстРедактирования = СостояниеФормыTestClient.ТекстРедактирования;
				КонецЕсли;	
			КонецЕсли;	
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("ТекстРедактирования", ТекстРедактирования);
		ДанныеЭлемента.Вставить("Значение", ЗначениеЭлемента);
		
		Если ТипЗнч(ЭлементФормы) = Тип("ТестируемаяКнопкаФормы") Тогда
			// Получаем значение пометки
			Пометка = Неопределено;
			Попытка
				Пометка = ЭлементФормы.ТекущееПометка();
			Исключение
			КонецПопытки;
			ДанныеЭлемента.Вставить("Пометка", Пометка);
		КонецЕсли;	
		
		// Получаем представление значения
		ПредставлениеЗначения = Неопределено;
		Попытка
			ПредставлениеЗначения = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(ЭлементФормы);
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Представление", ПредставлениеЗначения);
		
		// Получаем доступность
		ДоступностьЭлемента = Неопределено;
		Попытка
			ДоступностьЭлемента = ЭлементФормы.ТекущаяДоступность();
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Доступность", ДоступностьЭлемента);
		
		// Получаем видимость
		ВидимостьЭлемента = Неопределено;
		Попытка
			ВидимостьЭлемента = ЭлементФормы.ТекущаяВидимость();
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("Видимость", ВидимостьЭлемента);
		
		// Получаем только просмотр
		ТолькоПросмотрЭлемента = Неопределено;
		Попытка
			ТолькоПросмотрЭлемента = ЭлементФормы.ТекущееТолькоПросмотр();
		Исключение
		КонецПопытки;
		ДанныеЭлемента.Вставить("ТолькоПросмотр", ТолькоПросмотрЭлемента);
		
		// Формируем результат в формате Markdown
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("# Данные элемента формы"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Основная информация"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("- Имя:") + " " + ДанныеЭлемента.Имя);
		Если ДанныеЭлемента.Заголовок <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Заголовок:") + " " + ДанныеЭлемента.Заголовок);
		КонецЕсли;
		Если ДанныеЭлемента.Вид <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Вид:") + " " + ДанныеЭлемента.Вид);
		КонецЕсли;
		Если ДанныеЭлемента.Тип <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Тип:") + " " + ДанныеЭлемента.Тип);
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Значение элемента формы"));
		Строки.Добавить("");
		Если ДанныеЭлемента.Значение <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Значение:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Значение));
		КонецЕсли;
		Если ДанныеЭлемента.Представление <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Представление:") + " " + ДанныеЭлемента.Представление);
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Состояние"));
		Строки.Добавить("");
		Если ДанныеЭлемента.Доступность <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Доступность:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Доступность));
		КонецЕсли;
		Если ДанныеЭлемента.Видимость <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Видимость:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Видимость));
		КонецЕсли;
		Если ДанныеЭлемента.ТолькоПросмотр <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- ТолькоПросмотр:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.ТолькоПросмотр));
		КонецЕсли;
		Если ДанныеЭлемента.Свойство("Пометка") И ДанныеЭлемента.Пометка <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("- Пометка:") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеЭлемента.Пометка));
		КонецЕсли;
		
		Если ТипЗнч(ЭлементФормы) = Тип("ТестируемаяТаблицаФормы") Тогда
			// Получаем значение пометки
			ТекущийРежимРедактирование = Неопределено;
			Попытка
				ТекущийРежимРедактирование = ЭлементФормы.ТекущийРежимРедактирование();
			Исключение
			КонецПопытки;
			Если ТекущийРежимРедактирование <> Неопределено Тогда
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("- Таблица в режиме редактирования:") + " " + MCPПредставлениеЗначенияДляMarkdown(ТекущийРежимРедактирование));
			КонецЕсли;	
		КонецЕсли;	
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка получения данных элемента формы:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции	

// Ищет элементы в активном окне клиента тестирования платформенным методом НайтиОбъекты (по заголовку
// и (или) по имени) и выводит родителя первого уровня и табличную часть (инструмент find_form_elements).
&НаКлиенте
Функция НайтиЭлементыФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	СтрокаПоиска = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "search_string")));
	Если НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", MCPVAСлужебныйМодуль.MCPОформитьОшибку(
			Ванесса.Локализовать("Не указан параметр search_string."),
			Ванесса.Локализовать("Передайте строку поиска; для поиска всех элементов активного окна используйте search_string='*'.")));
	КонецЕсли;
	
	ЗначениеРежима = ЗначениеПараметраИзЗапроса(Запрос, "search_by");
	РежимПоиска = НРег(СокрЛП(Строка(ЗначениеРежима)));
	Если НЕ ЗначениеЗаполнено(РежимПоиска) Тогда
		РежимПоиска = "all";
	КонецЕсли;
	Если РежимПоиска <> "all" И РежимПоиска <> "title" И РежимПоиска <> "name" Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", MCPVAСлужебныйМодуль.MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Некорректное значение параметра search_by <%1>."), Строка(ЗначениеРежима)),
			Ванесса.Локализовать("Допустимые значения: 'all' (по заголовку и по имени), 'title' (только по заголовку), 'name' (только по имени).")));
	КонецЕсли;
	
	ПределВывода = 50;
	ЗначениеПредела = MCPБезопасноеСвойство(Запрос.Аргументы, "limit");
	Если ЗначениеПредела <> "" И ЗначениеПредела <> Null И ЗначениеПредела <> Неопределено Тогда
		Попытка
			ПределВывода = Число(ЗначениеПредела);
		Исключение
			ПределВывода = -1;
		КонецПопытки;
		Если ТипЗнч(ЗначениеПредела) = Тип("Булево") ИЛИ ПределВывода <> Цел(ПределВывода) ИЛИ ПределВывода < 0 Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", MCPVAСлужебныйМодуль.MCPОформитьОшибку(
				Ванесса.Локализовать("Некорректное значение параметра limit."),
				Ванесса.Локализовать("Нужно передать целое число 0 или больше (0 - без ограничения).")));
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Ванесса.Версия8325ИлиВыше Тогда
		Возврат ОшибкаТребуемойВерсии("find_form_elements", "8.3.25");
	КонецЕсли;
	
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	Если АктивноеОкно = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не получилось определить активное окно Клиента тестирования."));
	КонецЕсли;
	
	Найденные = Неопределено;
	Попытка
		Если РежимПоиска = "name" Тогда
			Найденные = АктивноеОкно.НайтиОбъекты(,, СтрокаПоиска);
		ИначеЕсли РежимПоиска = "title" Тогда
			Найденные = АктивноеОкно.НайтиОбъекты(, СтрокаПоиска);
		Иначе
			// "all": поиск и по имени, и по заголовку; дубли убираются.
			Найденные = MCPОбъединитьНайденныеЭлементыОкна(
				АктивноеОкно.НайтиОбъекты(,, СтрокаПоиска),
				АктивноеОкно.НайтиОбъекты(, СтрокаПоиска));
		КонецЕсли;
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", MCPVAСлужебныйМодуль.MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Ошибка поиска элементов активного окна по отбору <%1>."), СтрокаПоиска),
			"",
			ТекстОшибки));
	КонецПопытки;
	
	Если Найденные = Неопределено ИЛИ Найденные.Количество() = 0 Тогда
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("По отбору <%1> элементы не найдены."), СтрокаПоиска));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Что проверить:"));
		Строки.Добавить("- " + Ванесса.Локализовать("элемент может быть на ещё не открытой закладке (странице) формы - переключите закладку (страницу) действием switch_tab;"));
		Строки.Добавить("- " + Ванесса.Локализовать("поиск выполняется только по активному окну клиента тестирования;"));
		Строки.Добавить("- " + Ванесса.Локализовать("состав формы смотрите через get_form_analysis (format='elements')."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено элементов: %1"), Найденные.Количество()));
	Строки.Добавить("");
	
	ВыведеноЭлементов = 0;
	Для Каждого ЭлементОкна Из Найденные Цикл
		
		Если ПределВывода > 0 И ВыведеноЭлементов >= ПределВывода Тогда
			Строки.Добавить("");
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Показаны первые %1 элементов. Чтобы увидеть все, увеличьте limit или уточните строку поиска."),
				ПределВывода));
			Прервать;
		КонецЕсли;
		
		Попытка
			СтрокиЭлемента = MCPСтрокиНайденногоЭлементаОкна(ЭлементОкна);
			Для Каждого СтрокаЭлемента Из СтрокиЭлемента Цикл
				Строки.Добавить(СтрокаЭлемента);
			КонецЦикла;
			ВыведеноЭлементов = ВыведеноЭлементов + 1;
		Исключение
			// Один проблемный элемент не должен ломать весь ответ.
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Строки вывода одного найденного элемента: сам элемент, родитель первого уровня и табличная часть.
&НаКлиенте
Функция MCPСтрокиНайденногоЭлементаОкна(ЭлементОкна)
	
	Строки = Новый Массив;
	Строки.Добавить("- " + MCPЗаголовокЭлементаОкна(ЭлементОкна) + " [" + MCPИмяЭлементаОкна(ЭлементОкна) + "] ("
		+ MCPОписаниеВидаЭлементаОкна(ЭлементОкна) + ")");
	
	Родитель = MCPРодительЭлементаОкна(ЭлементОкна);
	Если Родитель = Неопределено Тогда
		Строки.Добавить("  " + Ванесса.Локализовать("Родитель: не определён"));
	Иначе
		Строки.Добавить("  " + Ванесса.Локализовать("Родитель:") + " " + MCPЗаголовокЭлементаОкна(Родитель)
			+ " [" + MCPИмяЭлементаОкна(Родитель) + "] (" + Строка(ТипЗнч(Родитель)) + ")");
	КонецЕсли;
	
	Если ТипЗнч(ЭлементОкна) <> Тип("ТестируемаяТаблицаФормы") Тогда
		ТаблицаПредок = MCPТаблицаПредокЭлементаОкна(ЭлементОкна);
		Если ТаблицаПредок <> Неопределено Тогда
			Строки.Добавить("  " + Ванесса.Локализовать("Таблица:") + " " + MCPЗаголовокЭлементаОкна(ТаблицаПредок)
				+ " [" + MCPИмяЭлементаОкна(ТаблицаПредок) + "]");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

// Тип и, если есть, вид элемента окна.
&НаКлиенте
Функция MCPОписаниеВидаЭлементаОкна(ЭлементОкна)
	
	Описание = Строка(ТипЗнч(ЭлементОкна));
	Попытка
		Если ЗначениеЗаполнено(ЭлементОкна.Вид) Тогда
			Описание = Описание + ", " + Ванесса.Локализовать("Вид:") + " " + Строка(ЭлементОкна.Вид);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Описание;
	
КонецФункции

// Внутреннее имя элемента окна; у формы свойства Имя нет, там используется ИмяФормы.
&НаКлиенте
Функция MCPИмяЭлементаОкна(ЭлементОкна)
	
	Попытка
		Если ТипЗнч(ЭлементОкна) = Тип("ТестируемаяФорма") Тогда
			Возврат СокрЛП(Строка(ЭлементОкна.ИмяФормы));
		КонецЕсли;
		Возврат СокрЛП(Строка(ЭлементОкна.Имя));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Заголовок элемента окна без переводов строк и табуляций, чтобы не ломать markdown-вывод.
&НаКлиенте
Функция MCPЗаголовокЭлементаОкна(ЭлементОкна)
	
	Попытка
		Если ТипЗнч(ЭлементОкна) = Тип("ТестируемоеОкноКлиентскогоПриложения") Тогда
			Возврат СокрЛП(Строка(ЭлементОкна.Заголовок));
		КонецЕсли;
		Возврат СокрЛП(СтрЗаменить(СтрЗаменить(Строка(ЭлементОкна.ТекстЗаголовка), Символы.ПС, " "), Символы.Таб, " "));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Родитель первого уровня; у окна и формы родитель не запрашивается.
&НаКлиенте
Функция MCPРодительЭлементаОкна(ЭлементОкна)
	
	Если ТипЗнч(ЭлементОкна) = Тип("ТестируемаяФорма")
		ИЛИ ТипЗнч(ЭлементОкна) = Тип("ТестируемоеОкноКлиентскогоПриложения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат ЭлементОкна.ПолучитьРодителя();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Табличная часть, в которую вложен элемент (колонка может быть в группе или группах внутри таблицы).
&НаКлиенте
Функция MCPТаблицаПредокЭлементаОкна(ЭлементОкна)
	
	ПроверяемыйЭлемент = ЭлементОкна;
	Для Сч = 1 По 50 Цикл
		
		Попытка
			Родитель = ПроверяемыйЭлемент.ПолучитьРодителя();
		Исключение
			Прервать;
		КонецПопытки;
		
		Если Родитель = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ТипЗнч(Родитель) = Тип("ТестируемаяТаблицаФормы") Тогда
			Возврат Родитель;
		КонецЕсли;
		
		Если ТипЗнч(Родитель) = Тип("ТестируемаяФорма")
			ИЛИ ТипЗнч(Родитель) = Тип("ТестируемоеОкноКлиентскогоПриложения") Тогда
			Прервать;
		КонецЕсли;
		
		ПроверяемыйЭлемент = Родитель;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Объединяет результаты поиска по имени и по заголовку: из второго списка отбрасываются элементы,
// уже добавленные из первого; порядок - по первому появлению.
&НаКлиенте
Функция MCPОбъединитьНайденныеЭлементыОкна(НайденныеПоИмени, НайденныеПоЗаголовку)
	
	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	
	Попытка
		MCPДобавитьНайденныеЭлементы(НайденныеПоИмени, Результат, Добавленные, Ложь);
	Исключение
		// Сбой чтения свойств отдельного элемента не должен отменять весь поиск.
	КонецПопытки;
	Попытка
		MCPДобавитьНайденныеЭлементы(НайденныеПоЗаголовку, Результат, Добавленные, Истина);
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура MCPДобавитьНайденныеЭлементы(Найденные, Результат, Добавленные, ТолькоНовые = Ложь)
	
	Если Найденные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементОкна Из Найденные Цикл
		Ключ = Строка(ТипЗнч(ЭлементОкна)) + "|" + MCPИмяЭлементаОкна(ЭлементОкна) + "|" + MCPЗаголовокЭлементаОкна(ЭлементОкна);
		Если ТолькоНовые И Добавленные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Ключ, Истина);
		Результат.Добавить(ЭлементОкна);
	КонецЦикла;
	
КонецПроцедуры

// Универсальный инструмент для выполнения последовательности действий с элементами формы
&НаКлиенте
Функция ВыполнитьПоследовательностьДействийФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр actions_json (обязательный)
	ActionsJSON = Строка(ЗначениеПараметраИзЗапроса(Запрос, "actions_json"));
	Если НЕ ЗначениеЗаполнено(ActionsJSON) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр actions_json обязателен.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Парсим JSON с массивом действий
	Попытка
		МассивДействий = Ванесса.ПрочитатьОбъектJSON(ActionsJSON);
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка парсинга JSON:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецПопытки;
	
	Если ТипЗнч(МассивДействий) <> Тип("Массив") Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр actions_json должен содержать массив действий.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если МассивДействий.Количество() = 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Массив действий пуст.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Идентификатор = Запрос.Идентификатор;
	
	// Выполняем действия последовательно
	СтрокиРезультата = Новый Массив;
	СтрокиРезультата.Добавить(Ванесса.Локализовать("# Выполнение последовательности действий"));
	СтрокиРезультата.Добавить("");
	СтрокиРезультата.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Всего действий: %1"), МассивДействий.Количество()));
	СтрокиРезультата.Добавить("");
	// По одной строке на каждое выполненное действие - сводка нужна для сообщения об ошибке
	СтрокиСводки = Новый Массив;
	
	Для Сч = 0 По МассивДействий.Количество() - 1 Цикл
		Действие = МассивДействий[Сч];
		
		Если ТипЗнч(Действие) <> Тип("Структура") Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Действие %1 не является структурой."), Сч + 1);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		
		// Получаем тип действия
		ТипДействия = "";
		Если Действие.Свойство("action") Тогда
			ТипДействия = Строка(Действие.action);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТипДействия) Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В действии %1 не указан параметр action."), Сч + 1);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		
		// Формируем запрос для вызова УправлениеЭлементамиФормы
		ЗапросЭлемента = Новый Структура;
		ЗапросЭлемента.Вставить("Идентификатор", Запрос.Идентификатор);
		ЗапросЭлемента.Вставить("Аргументы", Новый Структура);
		ЗапросЭлемента.Аргументы.Вставить("action", ТипДействия);
		
		// Копируем остальные параметры
		Для Каждого КлючЗначение Из Действие Цикл
			Если КлючЗначение.Ключ <> "action" Тогда
				ЗапросЭлемента.Аргументы.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		
		// Модальный диалог перед действием: если он открыт, а текущее действие не управляет диалогом -
		// цепочка приостанавливается
		РезультатПроверкиДиалога = MCPОбработатьМодальныйДиалогВЦепочке(ТипДействия);
		Если РезультатПроверкиДиалога.Приостановить Тогда
			Возврат MCPТекстПриостановкиЦепочки(СтрокиРезультата, МассивДействий, Сч, РезультатПроверкиДиалога.ОкноМодальногоДиалога);
		КонецЕсли;
		
		// Выполняем действие; диагностика MCP должна знать, что операция идёт по вызову MCP
		Ванесса.УстановитьПризнакВыполненияОперацииMCP(Истина);
		Попытка
			РезультатДействия = УправлениеЭлементамиФормыСлужебный(ЗапросЭлемента, ДополнительныеПараметры, Истина);
		Исключение
			Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
		
		// Проверяем результат
		Если ТипЗнч(РезультатДействия) = Тип("Строка") Тогда
			// Успешное выполнение: компактная строка "N действие адрес ok". Полезная нагрузка выводится
			// следующей строкой там, где она информативна: read-данные, инструкции, предупреждения, а
			// также любые многострочные результаты (в них обычно есть дополнение к подтверждению).
			// Однострочные прозаические подтверждения сворачиваются, у set_value выбранное
			// представление уходит в суффикс строки итога.
			СтрокаИтога = MCPКомпактныйИтогДействияФормы(Сч + 1, ТипДействия, Действие) + " ok";
			СтрокаНагрузки = "";
			Если НРег(СокрЛП(ТипДействия)) = "set_value" Тогда
				СвернутыйРезультат = MCPКомпактныйРезультатУстановкиЗначения(РезультатДействия);
				Если СвернутыйРезультат.Свернуть Тогда
					СтрокаИтога = СтрокаИтога + СвернутыйРезультат.Суффикс;
				Иначе
					СтрокаНагрузки = РезультатДействия;
				КонецЕсли;
			ИначеЕсли НЕ MCPПрозаическоеПодтверждениеДействияФормы(ТипДействия) ИЛИ Найти(РезультатДействия, Символы.ПС) > 0 Тогда
				СтрокаНагрузки = РезультатДействия;
			КонецЕсли;
			СтрокиРезультата.Добавить(СтрокаИтога);
			Если ЗначениеЗаполнено(СтрокаНагрузки) Тогда
				СтрокиРезультата.Добавить(СтрокаНагрузки);
				СтрокиРезультата.Добавить("");
			КонецЕсли;
			СтрокиСводки.Добавить(СтрокаИтога);
		Иначе
			// Действие упало: если при этом открыт модальный диалог - это не ошибка, а приостановка цепочки
			// (диалог мог появиться как следствие предыдущего действия)
			РезультатПроверкиДиалога = MCPОбработатьМодальныйДиалогВЦепочке(ТипДействия);
			Если РезультатПроверкиДиалога.Приостановить Тогда
				ПричинаПаузы = MCPКомпактныйИтогДействияФормы(Сч + 1, ТипДействия, Действие) + " FAILED";
				Возврат MCPТекстПриостановкиЦепочки(СтрокиРезультата, МассивДействий, Сч, РезультатПроверкиДиалога.ОкноМодальногоДиалога, ПричинаПаузы, РезультатДействия);
			КонецЕсли;
			// Ошибка выполнения: в сообщении - по одной строке на выполненное действие,
			// полностью приводится только упавшее действие и его ошибка.
			СтрокиСообщения = Новый Массив;
			СтрокиСообщения.Добавить(Ванесса.Локализовать("# Выполнение последовательности действий"));
			СтрокиСообщения.Добавить("");
			СтрокиСообщения.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Всего действий: %1"), МассивДействий.Количество()));
			СтрокиСообщения.Добавить("");
			Для Каждого СтрокаСводки Из СтрокиСводки Цикл
				СтрокиСообщения.Добавить(СтрокаСводки);
			КонецЦикла;
			СтрокиСообщения.Добавить(MCPКомпактныйИтогДействияФормы(Сч + 1, ТипДействия, Действие) + " FAILED");
			
			//Добавляем данные об ошибке
			СтрокиСообщения.Добавить(Ванесса.ЗаписатьОбъектJSON(РезультатДействия));
			
			ТекстОшибки = Ванесса._СтрСоединить(СтрокиСообщения, Символы.ПС);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
	// Модальный диалог после последнего действия: диалог мог открыться последним действием цепочки
	РезультатПроверкиДиалога = MCPОбработатьМодальныйДиалогВЦепочке("");
	Если РезультатПроверкиДиалога.Приостановить Тогда
		Возврат MCPТекстПриостановкиЦепочки(СтрокиРезультата, МассивДействий, МассивДействий.Количество(), РезультатПроверкиДиалога.ОкноМодальногоДиалога);
	КонецЕсли;
	
	СтрокиРезультата.Добавить(Ванесса.Локализовать("# Все действия выполнены успешно"));
	Возврат Ванесса._СтрСоединить(СтрокиРезультата, Символы.ПС);
	
КонецФункции

// Компактный итог действия для отчёта цепочки: "N действие адрес" (без признака ok/FAILED).
// Адрес - главный параметр действия и его значение; примеры: "1 set_value Менеджер=Admin",
// "2 simulate_tab", "3 switch_tab ГруппаДополнительно".
&НаКлиенте
Функция MCPКомпактныйИтогДействияФормы(Номер, ТипДействия, Действие)
	
	Адрес = MCPАдресДействияФормы(Действие);
	СтрокаИтога = Строка(Номер) + " " + ТипДействия;
	Если ЗначениеЗаполнено(Адрес) Тогда
		СтрокаИтога = СтрокаИтога + " " + Адрес;
	КонецЕсли;
	Возврат СтрокаИтога;
	
КонецФункции

// Адрес действия для компактной строки: главный параметр действия, значение через "=",
// таблица дописывается в квадратных скобках. Примеры: "Менеджер=Admin", "ГруппаДополнительно",
// "ТоварыКоличество=5 [Товары]".
&НаКлиенте
Функция MCPАдресДействияФормы(Действие)
	
	ПараметрыАдреса = Новый Массив;
	ПараметрыАдреса.Добавить("element_name");
	ПараметрыАдреса.Добавить("command");
	ПараметрыАдреса.Добавить("menu_path");
	ПараметрыАдреса.Добавить("keys");
	ПараметрыАдреса.Добавить("area");
	ПараметрыАдреса.Добавить("order");
	ПараметрыАдреса.Добавить("row_criteria");
	ПараметрыАдреса.Добавить("hyperlink_title");
	ПараметрыАдреса.Добавить("date");
	ПараметрыАдреса.Добавить("direction");
	ПараметрыАдреса.Добавить("percent");
	
	Адрес = "";
	Для Каждого ИмяПараметра Из ПараметрыАдреса Цикл
		Если Действие.Свойство(ИмяПараметра) И ЗначениеЗаполнено(Действие[ИмяПараметра]) Тогда
			Адрес = MCPКраткоеЗначениеАдресаДействия(Действие[ИмяПараметра]);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Таблица = "";
	Если Действие.Свойство("table_name") И ЗначениеЗаполнено(Действие.table_name) Тогда
		Таблица = MCPКраткоеЗначениеАдресаДействия(Действие.table_name);
	КонецЕсли;
	
	// Значение печатается целиком (без обрезки): это данные, заданные вызывающей стороной.
	// Проверка на присутствие отличается от ЗначениеЗаполнено: числовой ноль - значимое значение.
	Значение = Неопределено;
	Если Действие.Свойство("value", Значение)
		И НЕ (Значение = Неопределено ИЛИ Значение = Null ИЛИ Значение = "") Тогда
		ЗначениеДляАдреса = MCPКраткоеЗначениеАдресаДействия(Значение, Ложь);
		Если ЗначениеЗаполнено(Адрес) Тогда
			Адрес = Адрес + "=" + ЗначениеДляАдреса;
		Иначе
			Адрес = ЗначениеДляАдреса;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Адрес = Таблица;
		Таблица = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Таблица) И Таблица <> Адрес Тогда
		Адрес = Адрес + " [" + Таблица + "]";
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

// Значение параметра адреса в одну строку: переводы строк и табуляции заменяются пробелами,
// длинные значения (кроме переданных с ОбрезатьДлину = Ложь) обрезаются.
&НаКлиенте
Функция MCPКраткоеЗначениеАдресаДействия(Значение, ОбрезатьДлину = Истина)
	
	Текст = СокрЛП(СтрЗаменить(СтрЗаменить(Строка(Значение), Символы.ПС, " "), Символы.Таб, " "));
	Если ОбрезатьДлину И СтрДлина(Текст) > 40 Тогда
		Текст = Лев(Текст, 40) + "...";
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

// Действия с однострочным прозаическим подтверждением, дублирующим адрес действия: в компактном
// отчёте цепочки сворачиваются в "ok". Многострочные результаты не сворачиваются (в них обычно
// есть дополнение к подтверждению) - их печатает ветка успеха ВыполнитьПоследовательностьДействийФормы.
// set_current_area здесь нет: его результат содержит фактический адрес области из платформы.
&НаКлиенте
Функция MCPПрозаическоеПодтверждениеДействияФормы(ТипДействия)
	
	Подтверждения = Новый Массив;
	Подтверждения.Добавить("simulate_tab");
	Подтверждения.Добавить("switch_tab");
	Подтверждения.Добавить("activate_column");
	Подтверждения.Добавить("start_edit_row");
	Подтверждения.Добавить("end_edit_row");
	Подтверждения.Добавить("click_button");
	Подтверждения.Добавить("click_hyperlink");
	Подтверждения.Добавить("clear_field");
	Подтверждения.Добавить("clear_message_window");
	Подтверждения.Добавить("set_checkbox");
	Подтверждения.Добавить("unset_checkbox");
	Подтверждения.Добавить("toggle_checkbox");
	Подтверждения.Добавить("set_radio_button");
	Подтверждения.Добавить("navigate_next_column");
	Подтверждения.Добавить("navigate_previous_column");
	Подтверждения.Добавить("navigate_next_row");
	Подтверждения.Добавить("navigate_previous_row");
	Подтверждения.Добавить("navigate_to_row");
	Подтверждения.Добавить("choose_row");
	Подтверждения.Добавить("goto_first_row");
	Подтверждения.Добавить("goto_last_row");
	Подтверждения.Добавить("goto_next_item");
	Подтверждения.Добавить("goto_previous_item");
	Подтверждения.Добавить("go_one_level_down");
	Подтверждения.Добавить("go_one_level_up");
	Подтверждения.Добавить("toggle_group");
	Подтверждения.Добавить("activate_header_element");
	Подтверждения.Добавить("cancel_edit");
	Подтверждения.Добавить("begin_edit_current_area");
	Подтверждения.Добавить("end_edit_current_area");
	Подтверждения.Добавить("goto_date");
	Подтверждения.Добавить("execute_choice_from_menu");
	Подтверждения.Добавить("select_row");
	
	Возврат Подтверждения.Найти(НРег(СокрЛП(ТипДействия))) <> Неопределено;
	
КонецФункции

// Результат set_value сворачивается в суффикс компактной строки, если это чистый шаблон успеха:
// "Значение 'X' было успешно установлено в поле 'Y'. Выбрано из списка: ""Z""." -> ("Z").
// Результат с предупреждением (Внимание:) или неразобранным остатком выводится полностью.
&НаКлиенте
Функция MCPКомпактныйРезультатУстановкиЗначения(РезультатДействия)
	
	Результат = Новый Структура("Свернуть, Суффикс", Ложь, "");
	
	ПрефиксСписка = "Выбрано из списка: ";
	Если Найти(РезультатДействия, "Значение '") <> 1
		ИЛИ Найти(РезультатДействия, "было успешно установлено в поле") = 0
		ИЛИ Найти(РезультатДействия, "Внимание:") > 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПозВыбрано = Найти(РезультатДействия, ПрефиксСписка);
	Если ПозВыбрано = 0 Тогда
		// Представление прочитать не удалось: результат - только базовый шаблон, он дублирует адрес
		// действия, поэтому сворачивается в пустой суффикс. Если в результате появилось что-то ещё
		// (в базовом шаблоне ровно четыре одинарные кавычки двух подстановок), он выводится полностью.
		КавычекОдинарных = СтрДлина(РезультатДействия) - СтрДлина(СтрЗаменить(РезультатДействия, "'", ""));
		Если Прав(РезультатДействия, 1) = "." И КавычекОдинарных = 4 Тогда
			Результат.Свернуть = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Фрагмент = Сред(РезультатДействия, ПозВыбрано);
	Кавычек = СтрДлина(Фрагмент) - СтрДлина(СтрЗаменить(Фрагмент, """", ""));
	// Строгий разбор: только шаблон "Выбрано из списка: ""...""." без хвостов; внутри представления
	// не должно быть кавычек (иначе шаблон не опознан и результат выводится полностью).
	Если Прав(Фрагмент, 1) <> "." ИЛИ Кавычек <> 2 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Свернуть = Истина;
	Результат.Суффикс = " (""" + Сред(Фрагмент, СтрДлина(ПрефиксСписка) + 2, СтрДлина(Фрагмент) - СтрДлина(ПрефиксСписка) - 3) + """)";
	Возврат Результат;
	
КонецФункции

// Универсальный инструмент для управления элементами формы
&НаКлиенте
Функция УправлениеЭлементамиФормы(Запрос, ДополнительныеПараметры) Экспорт
	
	Идентификатор = Запрос.Идентификатор;
	// Пока выполняется синхронный инструмент, диагностика MCP дополняет ошибки подробностями
	Ванесса.УстановитьПризнакВыполненияОперацииMCP(Истина);
	Попытка
		Результат = УправлениеЭлементамиФормыСлужебный(Запрос, ДополнительныеПараметры);
	Исключение
		Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
	Возврат Результат;
	
КонецФункции

