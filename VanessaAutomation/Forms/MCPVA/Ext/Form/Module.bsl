// Внутренняя функция для разворачивания/сворачивания группы
&НаКлиенте
Функция РазвернутьСвернутьГруппу(ИмяЭлемента, Действие)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'toggle_group' необходимо указать параметр element_name (имя группы).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Параметр value обязателен: 'expand' - развернуть, 'collapse' - свернуть
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'toggle_group' необходимо указать параметр value: 'expand' (развернуть) или 'collapse' (свернуть).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ДействиеСтрок = СокрЛП(Нрег(Действие));
	Если НЕ (ДействиеСтрок = "expand" ИЛИ ДействиеСтрок = "collapse") Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение параметра value для действия 'toggle_group'. Допустимые значения: 'expand' (развернуть), 'collapse' (свернуть).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		Если ДействиеСтрок = "expand" Тогда
			// Явное развертывание
			Ванесса.ВОткрытойФормеЯРазворачиваюГруппуСЗаголовком(ИмяЭлемента, Истина);
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Группа '%1' была развернута."), ИмяЭлемента);
		Иначе
			// Явное сворачивание
			Ванесса.ВОткрытойФормеЯСворачиваюГруппуСЗаголовком(ИмяЭлемента, Истина);
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Группа '%1' была свернута."), ИмяЭлемента);
		КонецЕсли;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка выполнения действия с группой:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для активизации элемента шапки
&НаКлиенте
Функция АктивизироватьЭлементШапки(ИмяЭлемента)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'activate_header_element' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		ТекущаяФорма1 = Ванесса.НайтиТекущуюФормуTestClient();
		Ванесса.ЯАктивизируюПоле(ИмяЭлемента, Истина);
		ТекущаяФорма2 = Ванесса.НайтиТекущуюФормуTestClient();
		Если ТекущаяФорма1.ИмяФормы = ТекущаяФорма2.ИмяФормы Тогда
			// Значит мы всё в той же форме, надо проверить текущий элемент
			ТекЭлемент = ТекущаяФорма2.ПолучитьТекущийЭлемент();
			Если ТекЭлемент.Имя <> ИмяЭлемента Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось активизировать элемент `%1`. Текущий элемент формы: `%2`"), ИмяЭлемента, ТекЭлемент.Имя);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
			КонецЕсли;
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Элемент шапки '%1' был успешно активизирован."), ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка активизации элемента шапки:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для очистки поля (шапка или таблица)
&НаКлиенте
Функция ОчиститьПоле(ИмяЭлемента, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'clear_field' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
			Если Таблица = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' не найдена."), ИмяТаблицы);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			Поле = Таблица.НайтиОбъект(,,ИмяЭлемента);
			Если Поле = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено в таблице '%2'."), ИмяЭлемента, ИмяТаблицы);
				ДополнитьОшибку_НетПоляТаблицыMCP(Таблица, ТекстОшибки);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			// Активизируем поле и очищаем его
			Поле.Активизировать();
			
			Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
				Таблица.ИзменитьСтроку();
			КонецЕсли;
			
			// Очищаем значение поля
			Поле.Очистить();
		Иначе
			// Поиск в шапке формы
			Поле = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
			Если Поле = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено."), ИмяЭлемента);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			// Очищаем значение поля
			Поле.Очистить();
		КонецЕсли;
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' было успешно очищено."), ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка очистки поля:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Получает важные данные об окружении
&НаКлиенте
Функция ПолучитьДанныеОбОкружении(Запрос, ДополнительныеПараметры) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Данные об окружении"));
	Строки.Добавить("");

	// Текущая дата и время
	Строки.Добавить(Ванесса.Локализовать("- Текущая дата и время:") + " " + Формат(ТекущаяДата(), "ДЛФ:DD"));
	Строки.Добавить("");

	СистемнаяИнформация = Новый СистемнаяИнформация;

	// Версия платформы
	Попытка
		Строки.Добавить(Ванесса.Локализовать("## Информация о платформе"));
		Строки.Добавить(Ванесса.Локализовать("- Платформа:") + " " + СистемнаяИнформация.ВерсияПриложения);
	Исключение
		Строки.Добавить(Ванесса.Локализовать("! Не удалось получить информацию об информационной базе: ") + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

	// Данные об операционной системе
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("## Операционная система"));
	Строки.Добавить(Ванесса.Локализовать("- Данные ОС:") + " " + СистемнаяИнформация.ТипПлатформы);

	// Данные о VA (обычная или Single)
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("## Vanessa Automation"));
	Если Ванесса.Объект.ВерсияПоставки = "single" Тогда
		Строки.Добавить("- Это Vanessa Automation Single");
	Иначе
		Строки.Добавить("- Это обычная Vanessa Automation");
	КонецЕсли;
	Строки.Добавить(Ванесса.Локализовать("- Версия:") + " " + Ванесса.ВерсияVanessaAutomation());

	// Информация о внешней компоненте
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("## Внешняя компонента VanessaExt"));
	Строки.Добавить(Ванесса.Локализовать("- Включено использование внешней компоненты VanessaExt:") + " " + Ванесса.Объект.ИспользоватьКомпонентуVanessaExt);

	// Информация о базе менеджера тестирования
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("## Менеджер тестирования"));
	Строки.Добавить(Ванесса.Локализовать("- Строка соединения с информационной базой:") + " " + СтрокаСоединенияИнформационнойБазы());

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

