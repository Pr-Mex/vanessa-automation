// Внутренняя функция для перехода к строке таблицы
&НаКлиенте
Функция ПереходКСтрокеТаблицы(ИмяТаблицы, RowCriteria)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'navigate_to_row' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(RowCriteria) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'navigate_to_row' необходимо указать параметр row_criteria (значение).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
		Если Таблица = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' не найдена."), ИмяТаблицы);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		ПоляТаблицы = Таблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));
		КешЗаголовковПолей = Новый Соответствие;
		Для Каждого ТекПоле Из ПоляТаблицы Цикл
			Если НЕ ЗначениеЗаполнено(ТекПоле.ТекстЗаголовка) Тогда
				Продолжить;
			КонецЕсли;
			КешЗаголовковПолей.Вставить(НРег(ТекПоле.ТекстЗаголовка), Истина);
		КонецЦикла;
		
		// Парсим row_criteria в формате "Колонка=Значение;Колонка2=Значение2"
		Отбор = Новый Структура;
		СтрокиПар = Ванесса._СтрРазделить(RowCriteria, ";");
		Для Каждого ТекСтрока Из СтрокиПар Цикл
			ТекСтрока = СокрЛП(ТекСтрока);
			Если ПустаяСтрока(ТекСтрока) Тогда
				Продолжить;
			КонецЕсли;
			Индекс = Найти(ТекСтрока, "=");
			Если Индекс > 0 Тогда
				ИмяКолонки = СокрЛП(Лев(ТекСтрока, Индекс - 1));
				ЗначениеКолонки = СокрЛП(Сред(ТекСтрока, Индекс + 1));
				Отбор.Вставить(ИмяКолонки, ЗначениеКолонки);
			КонецЕсли;
		КонецЦикла;
		
		Если Отбор.Количество() = 0 Тогда
			ТекстОшибки = Ванесса.Локализовать("Не удалось распознать параметры для перехода к строке. Формат: 'Колонка=Значение;Колонка2=Значение2'.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;
		
		ПоляКоторыхНет = Новый Массив;
		Для Каждого КлючЗначения Из Отбор Цикл
			Если КешЗаголовковПолей[НРег(КлючЗначения.Ключ)] = Неопределено Тогда
				ПоляКоторыхНет.Добавить(КлючЗначения.Ключ);
			КонецЕсли;
		КонецЦикла;
		
		Если ПоляКоторыхНет.Количество() > 0 Тогда
			Строки = Новый Массив;
			Строки.Добавить(Ванесса.Локализовать("## Для перехода к строке были указаны колонки которых нет в таблице:"));
			Для Каждого Элем Из ПоляКоторыхНет Цикл
				Строки.Добавить("  -" + Элем);
			КонецЦикла;
			
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("## Колонки, которые допустимо указывать для перехода:"));
			Для Каждого ТекПоле Из ПоляТаблицы Цикл
				Если НЕ ЗначениеЗаполнено(ТекПоле.ТекстЗаголовка) Тогда
					Продолжить;
				КонецЕсли;
				Строки.Добавить("  -" + ТекПоле.ТекстЗаголовка);
			КонецЦикла;
			
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса._СтрСоединить(Строки, Символы.ПС));
		КонецЕсли;
		
		Колонки = Новый Структура;
		Значения = Новый Структура;
		Сч = 0;
		Для Каждого КлючЗначения Из Отбор Цикл
			Сч = Сч + 1;
			Колонки.Вставить("Кол" + XMLСтрока(Сч), КлючЗначения.Ключ);
			Значения.Вставить("Кол" + XMLСтрока(Сч), КлючЗначения.Значение);
		КонецЦикла;
		
		ТабПарам = Новый Массив;
		ТабПарам.Добавить(Колонки);
		ТабПарам.Добавить(Значения);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ПолучатьЗначениеТЧ", Ложь);
		Ванесса.ВТаблицеЯПерехожуКСтроке(ИмяТаблицы, ТабПарам,,,ДопПараметры);
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В таблице '%1' выполнен переход к строке с указанными параметрами."), ИмяТаблицы);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка перехода к строке таблицы:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Ванесса.ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

