&НаКлиенте
Процедура ЗавершитьВыборШагаДляВыполненияСценарияСТекущегоШага()
	// Проверка проблем синтаксиса и сброс состояния MCP при ошибке — здесь, чтобы пользоваться процедурой ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP
	Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
	Если Проблемы.Количество() > 0 Тогда
		//Слот освобождаем до ответа: ошибка отправки не должна блокировать следующий выбор
		ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
		ИдентификаторВыбораMCP = Неопределено;
		MCPЗавершитьВызовСОшибкой(Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", ИдентификаторОшибкиMCP, Неопределено),
			"ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
		Возврат;
	КонецЕсли;
	Попытка
		MCPVAСлужебныйМодуль.ЗавершитьВыборШагаДляВыполненияСценарияСТекущегоШага(ИдентификаторВыбораMCP);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗаписатьСлужебныеДанные("ВыборШага.ОшибкаЗавершения", Новый Структура("Идентификатор", ИдентификаторВыбораMCP));
		//Если прогон всё же стартовал, ответит его оповещение: второй ответ не отправляем
		Если НЕ Ванесса.Объект.ИдетВыполнениеСценариев Тогда
			Попытка
				MCPЗавершитьВызовСОшибкой(Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", ИдентификаторВыбораMCP, Неопределено),
					"ACTION_FAILED", ТекстОшибки);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецПопытки;
	ИдентификаторВыбораMCP = Неопределено;
КонецПроцедуры

// Возвращает идентификатор строки дерева по номеру строки фичи (Неопределено, если строка не найдена).
// Номер строки в дереве из нескольких фич не уникален, поэтому принимается только строка открытой в редакторе фичи
&НаКлиенте
Функция MCPСвежийИдСтрокиПоНомеруСтрокиФичи(НомерСтрокиФичи)
	
	СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтрокиФичи);
	Если СтрокаДерева = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Если НЕ MCPСтрокаДереваВОткрытойФиче(СтрокаДерева) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Возврат СтрокаДерева.ИдСтроки;
	
КонецФункции

// Истина, если строка дерева принадлежит фиче, открытой в текущей вкладке редактора.
// Если файл строки или вкладки определить нельзя, ограничение не применяется
&НаКлиенте
Функция MCPСтрокаДереваВОткрытойФиче(СтрокаДерева)
	
	Если Ванесса.VanessaTabs = Неопределено ИЛИ Ванесса.VanessaTabs.current = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;	
	
	ПутьФичиСтроки = Ванесса.МодульДеревоТестов().ОпределитьИмяФичаФайлаПоСтрокеДерева(СтрокаДерева);
	ПутьФичиВкладки = Ванесса.VanessaTabs.current.filename;
	Если НЕ ЗначениеЗаполнено(ПутьФичиСтроки) ИЛИ НЕ ЗначениеЗаполнено(ПутьФичиВкладки) Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Возврат MCPИмяФичаФайлаБезПути(ПутьФичиСтроки) = MCPИмяФичаФайлаБезПути(ПутьФичиВкладки);
	
КонецФункции

// Имя файла без каталога в нижнем регистре: пути к одному файлу могут быть записаны по-разному
&НаКлиенте
Функция MCPИмяФичаФайлаБезПути(Путь)
	
	Части = Ванесса._СтрРазделить(СтрЗаменить(Строка(Путь), "/", "\"), "\");
	Если Части.Количество() = 0 Тогда
		Возврат НРег(Строка(Путь));
	КонецЕсли;	
	
	Возврат НРег(Части[Части.Количество() - 1]);
	
КонецФункции

// Ждёт перевода редактора к строке и запускает сценарий с текущего шага (режим reloadAndRunFromLine)
&НаКлиенте
Процедура MCPПроверитьГотовностьСтрокиЗапускаСценария()
	
	// Переиздаём позиционирование: после загрузки фичи редактор возвращает курсор к прежней позиции,
	// последний setPosition должен остаться за нами
	Попытка
		СвежийИдСтроки = MCPСвежийИдСтрокиПоНомеруСтрокиФичи(глMCPЦелевойНомерСтрокиОжидания);
		Если СвежийИдСтроки <> Неопределено Тогда
			глMCPЦелеваяИдСтрокиОжидания = СвежийИдСтроки;
		КонецЕсли;	
		Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(глMCPЦелеваяИдСтрокиОжидания, глMCPЦелевойНомерСтрокиОжидания);
		
		Если MCPСтрокаРедактораСталаТекущей(глMCPЦелеваяИдСтрокиОжидания) Тогда
			ЗавершитьВыборШагаДляВыполненияСценарияСТекущегоШага();
			Возврат;
		КонецЕсли;	
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
		ИдентификаторВыбораMCP = Неопределено;
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	глMCPПопытокОжиданияСтроки = глMCPПопытокОжиданияСтроки + 1;
	Если глMCPПопытокОжиданияСтроки < 100 Тогда
		ПодключитьОбработчикОжидания("MCPПроверитьГотовностьСтрокиЗапускаСценария", 0.1, Истина);
		Возврат;
	КонецЕсли;	
	
	ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Редактор не перешёл к строке %1 за отведённое время (текущая позиция: %2). Запуск сценария отменён."), XMLСтрока(глMCPЦелевойНомерСтрокиОжидания), MCPФактическаяПозицияКурсораРедактораСтрокой());
	ИдентификаторОшибкиMCP = ИдентификаторВыбораMCP;
	ИдентификаторВыбораMCP = Неопределено;
	ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОшибкиMCP, "ACTION_FAILED", ТекстОшибки);
	
КонецПроцедуры

// Истина, если редактор перешёл к строке: дерево синхронизировано с курсором и целевая строка стала текущей
&НаКлиенте
Функция MCPСтрокаРедактораСталаТекущей(ИдСтроки)
	
	Если ИдСтроки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если НЕ Ванесса.МодульРедакторТекста().АктивизироватьСтрокуДереваСоответствующуюVanessaEditor() Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Попытка
		ТекущиеДанныеДерева = Ванесса.Элементы.ДеревоТестов.ТекущиеДанные;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Если ТекущиеДанныеДерева = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат ТекущиеДанныеДерева.ИдСтроки = ИдСтроки;
	
КонецФункции

// Возвращает фактическую позицию курсора редактора строкой для текстов ошибок
&НаКлиенте
Функция MCPФактическаяПозицияКурсораРедактораСтрокой()
	
	Попытка
		Позиция = Ванесса.ПолучитьVanessaEditor().getPosition();
		Если Позиция = Неопределено Тогда
			Возврат Ванесса.Локализовать("не определена");
		КонецЕсли;	
		Возврат Формат(Позиция.lineNumber, "ЧГ=0");
	Исключение
		Возврат Ванесса.Локализовать("не определена");
	КонецПопытки;
	
КонецФункции

