Функция ВвестиТекстВОбластьMCP(ИмяЭлемента, Адрес, Текст)
	Если Ванесса.ТекущийTestclientЭтоWebКлиент Тогда
		Возврат ОшибкаВебКлиента("set_area_text");
	КонецЕсли;
	Попытка
		Поле = НайтиТабличныйДокументMCP(ИмяЭлемента);
		Если Поле = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
