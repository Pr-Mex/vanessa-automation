&НаКлиенте
Процедура ДополнитьОшибку_НетПоляШапкиMCP(ТекстОшибки) Экспорт
	
	Если НЕ Ванесса.ВыполняетсяВызовMCP() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка = Ванесса.Локализовать("## Поля шапки формы. Имя поля и заголовок поля:");
	Если Найти(ТекстОшибки, СтрокаЗаголовка) > 0 Тогда
		// Значит уже происходило дополнение текста ошибки.
		Возврат;
	КонецЕсли;
	
	ТекОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Если ТекОкно = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяИскомое = MCPИмяЭлементаИзТекстаОшибки(ТекстОшибки);
	ПределПолейШапки = 30;
	
	Попытка
		ТипПоля = Тип("ТестируемоеПолеФормы");
		ПоляОкна = ТекОкно.НайтиОбъекты(ТипПоля); //Будут найдены как поля шапки формы так и поля таблиц формы
		
		КешПоляТаблиц = Новый Соответствие; // Имя поля таблицы -> имя таблицы
		ТаблицыОкна = ТекОкно.НайтиОбъекты(Тип("ТестируемаяТаблицаФормы"));
		Для Каждого ТекТаблица Из ТаблицыОкна Цикл
			ПоляТаблицы = ТекТаблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));
			Для Каждого ТекПолеТаблицы Из ПоляТаблицы Цикл
				КешПоляТаблиц.Вставить(ТекПолеТаблицы.Имя, ТекТаблица.Имя);
			КонецЦикла;
		КонецЦикла;	
		
		ПоляШапки = Новый Массив;
		Для Каждого ТекПоле Из ПоляОкна Цикл
			Если КешПоляТаблиц[ТекПоле.Имя] <> Неопределено Тогда
				Продолжить; // Не выводим поля таблиц
			КонецЕсли;
			
			Если ТекПоле.Вид = ВидПоляФормы.ПолеФлажка Тогда
				Продолжить;
			КонецЕсли;	
			
			ПоляШапки.Добавить(ТекПоле);
		КонецЦикла;
		
		Строки = Новый Массив;
		
		// Если искомое имя - это поле таблицы, сообщаем об этом отдельно: для полей таблиц нужен параметр table_name.
		ИмяТаблицыИскомого = КешПоляТаблиц[ИмяИскомое];
		Если ИмяИскомое <> "" И ИмяТаблицыИскомого <> Неопределено Тогда
			Строки.Добавить("");
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Элемент <%1> есть на форме, но это поле таблицы ""%2"": для действий с ним передайте table_name."),
				ИмяИскомое, ИмяТаблицыИскомого));
		КонецЕсли;
		
		// Сначала поля, похожие на искомое имя (по имени или заголовку), затем остальные поля шапки.
		Похожие = Новый Массив;
		Остальные = Новый Массив;
		Для Каждого ТекПоле Из ПоляШапки Цикл
			Если ИмяИскомое <> "" И Найти(НРег(ТекПоле.Имя + " " + ТекПоле.ТекстЗаголовка), НРег(ИмяИскомое)) > 0 Тогда
				Похожие.Добавить(ТекПоле);
			Иначе
				Остальные.Добавить(ТекПоле);
			КонецЕсли;
		КонецЦикла;
		
		Если Похожие.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("## Поля шапки формы, похожие на <%1>. Имя поля и заголовок поля:"), ИмяИскомое));
			Для Каждого ТекПоле Из Похожие Цикл
				Строки.Добавить("- " + ТекПоле.Имя + " (" + ТекПоле.ТекстЗаголовка + ")");
			КонецЦикла;
		КонецЕсли;
		
		Показано = 0;
		Если Остальные.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить(СтрокаЗаголовка);
			Для Каждого ТекПоле Из Остальные Цикл
				Если Показано >= ПределПолейШапки Тогда
					Прервать;
				КонецЕсли;
				Строки.Добавить("- " + ТекПоле.Имя + " (" + ТекПоле.ТекстЗаголовка + ")");
				Показано = Показано + 1;
			КонецЦикла;
			
			ВсегоПолейШапки = ПоляШапки.Количество();
			Если ВсегоПолейШапки > Похожие.Количество() + Показано Тогда
				Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("...показано %1 из %2 полей шапки. Полный список: get_form_analysis (format=elements)."),
					Похожие.Количество() + Показано, ВсегоПолейШапки));
			КонецЕсли;
		КонецЕсли;
		
		Строки.Добавить("");
