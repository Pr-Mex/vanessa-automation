// Закрывает клиент тестирования по имени профиля
&НаКлиенте
Функция ЗакрытьКлиентТестирования(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр profileName (необязательный)
	ИмяПрофиля = Строка(ЗначениеПараметраИзЗапроса(Запрос, "profileName"));
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключен. Нечего закрывать.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Определяем какой профиль закрывать
	Если НЕ ЗначениеЗаполнено(ИмяПрофиля) Тогда
		// Закрываем текущий подключенный профиль
		ТекущиеДанные = Ванесса.ТекущиеДанныеКлиентаТестирования();
		Если ТекущиеДанные = Неопределено Тогда
			Возврат Ванесса.Локализовать("# Клиент тестирования не был подключен
			|
			|- Статус: не подключен
			|
			|Клиент тестирования не был подключен, поэтому закрывать нечего.");
		КонецЕсли;
		ИмяПрофиля = ТекущиеДанные.Имя;
	КонецЕсли;
	
	// Ищем профиль в таблице
	НайденныйПрофиль = Ванесса.ПолучитьСвойстваПодключенногоTestClient(ИмяПрофиля);
	
	Если НайденныйПрофиль = Неопределено Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не найдено подключенного клиента тестирования с именем профиля '%1'."), ИмяПрофиля);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Закрываем окно клиента тестирования
	Попытка
		ТекстОшибки = Неопределено;
		ТекущиеДанныеКлиентаТестирования = Ванесса.ТекущиеДанныеКлиентаТестирования();
		PID = ТекущиеДанныеКлиентаТестирования.PIDКлиентаТестирования;
		Ванесса.ЯЗакрываюTestClient(НайденныйПрофиль.Имя, ТекстОшибки);
		
		// Ожидание, что процесс завершился
		Для Сч = 1 По 100 Цикл
			ПроцессСуществует = Ванесса.ПроцессОССуществует(PID);
			Если НЕ ПроцессСуществует Тогда
				Прервать;
			КонецЕсли;
			Ванесса.sleep(1);
		КонецЦикла;
		
		Если ТекстОшибки <> Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"# Клиент тестирования закрыт
			|
			|- Профиль: %1
			|- Статус: закрыт успешно
			|
			|## Следующие шаги
			|- Используйте `manage_test_client` с `action: connect` для повторного подключения"),
			ИмяПрофиля);
		Возврат ТекстОтвета;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка закрытия клиента тестирования:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Возвращает значения реквизитов объекта связанного с формой
&НаКлиенте
Функция ПолучитьРеквизитыОбъекта(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр data_mode (по умолчанию 'all')
	РежимДанных = Строка(ЗначениеПараметраИзЗапроса(Запрос, "data_mode"));
	Если НЕ ЗначениеЗаполнено(РежимДанных) Тогда
		РежимДанных = "all";
	Иначе
		РежимДанных = НРег(СокрЛП(РежимДанных));
	КонецЕсли;
	
	// Проверка допустимого значения
	ДопустимыеРежимы = Новый Массив;
	ДопустимыеРежимы.Добавить("all");
	ДопустимыеРежимы.Добавить("attributes_only");
	ДопустимыеРежимы.Добавить("single_attribute");
	ДопустимыеРежимы.Добавить("tabular_sections_only");
	ДопустимыеРежимы.Добавить("single_tabular_section");
	
	Если ДопустимыеРежимы.Найти(РежимДанных) = Неопределено Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение data_mode. Допустимые значения: 'all', 'attributes_only', 'single_attribute', 'tabular_sections_only', 'single_tabular_section'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр attribute_name для режима single_attribute
	ИмяРеквизита = Строка(ЗначениеПараметраИзЗапроса(Запрос, "attribute_name"));
	Если РежимДанных = "single_attribute" И НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для режима data_mode='single_attribute' необходимо указать параметр attribute_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр tabular_section_name для режима single_tabular_section
	ИмяТабличнойЧасти = Строка(ЗначениеПараметраИзЗапроса(Запрос, "tabular_section_name"));
	Если РежимДанных = "single_tabular_section" И НЕ ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для режима data_mode='single_tabular_section' необходимо указать параметр tabular_section_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр only_filled (по умолчанию false - возвращать все реквизиты)
	ТолькоЗаполненные = ЗначениеПараметраИзЗапроса(Запрос, "only_filled");
	Если ТолькоЗаполненные = Неопределено Тогда
		ТолькоЗаполненные = Ложь;
	Иначе
		Попытка
			ТолькоЗаполненные = Булево(ТолькоЗаполненные);
		Исключение
			ТолькоЗаполненные = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	ТекстОшибки = Неопределено;
	ДанныеОбъекта = ДанныеОбъектаИзУказанногоОкна(АктивноеОкно.Заголовок, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Формируем результат
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Реквизиты объекта"));
	Строки.Добавить("");
	
	// Получаем реквизиты шапки
	Если РежимДанных = "all" ИЛИ РежимДанных = "attributes_only" ИЛИ РежимДанных = "single_attribute" Тогда
		Если РежимДанных = "single_attribute" Тогда
			//Получаем только указанный реквизит
			Нашли = Ложь;
			Попытка
				Для Каждого ТекРеквизит Из ДанныеОбъекта.СтандартныеРеквизиты Цикл
					Если НРег(ТекРеквизит.Имя) = НРег(ИмяРеквизита) Тогда
						ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит);
						Нашли = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				
				Если НЕ Нашли Тогда
					Для Каждого ТекРеквизит Из ДанныеОбъекта.РеквизитыШапки Цикл
						Если НРег(ТекРеквизит.Имя) = НРег(ИмяРеквизита) Тогда
							ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит);
							Нашли = Истина;
							Прервать;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;	
				
			Исключение
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Реквизит '%1' не найден в объекте.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), ИмяРеквизита);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецПопытки;
			
			Если НЕ Нашли Тогда
				ТекстОшибки = Ванесса.Локализовать("Реквизит '%1' не найден в объекте.");
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибки, ИмяРеквизита);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;	
			
		Иначе
			// Получаем все реквизиты шапки или все данные
			Строки.Добавить(Ванесса.Локализовать("## Реквизиты шапки"));
			Строки.Добавить("");
			
			Для Каждого ТекРеквизит Из ДанныеОбъекта.СтандартныеРеквизиты Цикл
				ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные);
			КонецЦикла;
			
			Для Каждого ТекРеквизит Из ДанныеОбъекта.РеквизитыШапки Цикл
				ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные);
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	// Получаем табличные части
	Если РежимДанных = "all" ИЛИ РежимДанных = "tabular_sections_only" ИЛИ РежимДанных = "single_tabular_section" Тогда
		Если РежимДанных = "single_tabular_section" Тогда
			// Получаем только указанную табличную часть
			Попытка
				
				Нашли = Ложь;
				Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
					Если НРег(ТекТабличнаяЧасть.Имя) = НРег(ИмяТабличнойЧасти) Тогда
						ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТекТабличнаяЧасть);
						Нашли = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				
			Исключение
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Табличная часть '%1' не найдена в объекте.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), ИмяТабличнойЧасти);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецПопытки;
			
			Если НЕ Нашли Тогда
				ТекстОшибки = Ванесса.Локализовать("Табличная часть '%1' не найдена в объекте.");
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибки, ИмяТабличнойЧасти);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;	
			
		Иначе
			// Получаем все табличные части или все данные
			Строки.Добавить(Ванесса.Локализовать("## Табличные части"));
			Строки.Добавить("");
			
			Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
				ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТекТабличнаяЧасть, ТолькоЗаполненные);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция ДанныеОбъектаИзУказанногоОкна(ЗаголовокОкна, ТекстОшибки)
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ДанныеРеквизитовОбъекта");
	ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ДанныеРеквизитовОбъекта.*",5);
	Если НужнаяФорма = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключен, но не найдена форма 'VAExtension_ДанныеРеквизитовОбъекта' из служебного расширения.");
		Возврат Неопределено
	КонецЕсли;	
	
	РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина);
	РеквизитЗаголовокОкна = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗаголовокОкна", Истина);
	РеквизитЗаголовокОкна.ВвестиТекст(ЗаголовокОкна);
	
	АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	
	КнопкаВыполнитьОбработку = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьОбработку");
	
	КнопкаЗакрытьФорму = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	КнопкаВыполнитьОбработку.Нажать();
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные объекта из текущего окна.");
		Возврат Неопределено
	КонецЕсли;
	
	РеквизитЗначениеДляВозврата = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеРезультат", Истина);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеДляВозврата);
	
	Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	
	Попытка
		КнопкаЗакрытьФорму.Нажать();
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("ДанныеОбъектаИзУказанногоОкна", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Данные;
КонецФункции	

&НаКлиенте
Процедура ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные = Ложь)
	ЗначениеРеквизита = ТекРеквизит.Значение;
	ТипРеквизита = ТекРеквизит.Тип;
	
	// Если установлен флаг ТолькоЗаполненные и значение пустое - пропускаем реквизит
	Если ТолькоЗаполненные И НЕ ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("## Реквизит:") + " " + ТекРеквизит.Имя);
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("- Тип:") + " " + ТипРеквизита);
	Строки.Добавить(Ванесса.Локализовать("- Значение:") + " " + MCPПредставлениеЗначенияДляMarkdown(ЗначениеРеквизита));
КонецПроцедуры

&НаКлиенте
Процедура ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТабличнаяЧасть, ТолькоЗаполненные = Ложь)
	
	Строки.Добавить(Ванесса.Локализовать("## Табличная часть: ") + ТабличнаяЧасть.Имя);
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("Количество строк: ") + Формат(ТабличнаяЧасть.ЗначениеТаблицы.Количество(), "ЧГ=0; ЧН=0"));
	Строки.Добавить("");
	
	Если ТабличнаяЧасть.ЗначениеТаблицы.Количество() > 0 Тогда
		// Получаем колонки
		
		Строки.Добавить(Ванесса.Локализовать("### Данные"));
		Строки.Добавить("");
		Для Сч = 0 По ТабличнаяЧасть.ЗначениеТаблицы.Количество() - 1 Цикл
			СтрокаТЧ = ТабличнаяЧасть.ЗначениеТаблицы[Сч];
			
			// Если установлен флаг ТолькоЗаполненные, проверяем есть ли в строке заполненные значения
			Если ТолькоЗаполненные Тогда
				ЕстьЗаполненныеЗначения = Ложь;
				Для Каждого ТекРеквизит Из СтрокаТЧ Цикл
					Если ЗначениеЗаполнено(ТекРеквизит.Значение) Тогда
						ЕстьЗаполненныеЗначения = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если НЕ ЕстьЗаполненныеЗначения Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Строки.Добавить(Ванесса.Локализовать("#### Строка ") + Формат(Сч + 1, "ЧГ=0; ЧН=0"));
			Строки.Добавить("");
			Для Каждого ТекРеквизит Из СтрокаТЧ Цикл
				ЗначениеКолонки = ТекРеквизит.Значение;
				
				// Если установлен флаг ТолькоЗаполненные и значение пустое - пропускаем колонку
				Если ТолькоЗаполненные И НЕ ЗначениеЗаполнено(ЗначениеКолонки) Тогда
					Продолжить;
				КонецЕсли;
				
				Строки.Добавить(Ванесса.Локализовать("- ") + ТекРеквизит.Имя + ": " + MCPПредставлениеЗначенияДляMarkdown(ЗначениеКолонки) + " [" + ТекРеквизит.Тип + "]");
			КонецЦикла;
			Строки.Добавить("");
		КонецЦикла;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("Табличная часть пуста."));
	КонецЕсли;
	
КонецПроцедуры

// Возвращает данные из таблицы базы данных (справочники, документы, перечисления, константы, реквизиты объекта)
&НаКлиенте
Функция ПолучитьДанныеИзТаблицыБД(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр object_type (обязательный, числовой)
	// 1 = Справочник, 2 = Документ, 3 = Перечисление, 4 = одна константа, 5 = все константы, 6 = Реквизиты объекта по навигационной ссылке
	Попытка
		ТипОбъекта = Число(ЗначениеПараметраИзЗапроса(Запрос, "object_type"));
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Параметр object_type должен быть числом. Допустимые значения: 1 = Справочник, 2 = Документ, 3 = Перечисление, 4 = одна константа, 5 = все константы, 6 = Реквизиты объекта по навигационной ссылке.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецПопытки;
	
	// Проверка допустимого значения
	Если ТипОбъекта < 1 ИЛИ ТипОбъекта > 6 Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение object_type. Допустимые значения: 1 = Справочник, 2 = Документ, 3 = Перечисление, 4 = одна константа, 5 = все константы, 6 = Реквизиты объекта по навигационной ссылке.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр object_name
	Если ТипОбъекта >= 1 И ТипОбъекта <= 4 Тогда
		ИмяОбъекта = Строка(ЗначениеПараметраИзЗапроса(Запрос, "object_name"));
		Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
			ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр object_name.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
	// Получаем параметр limit (по умолчанию 10)
	Попытка
		ЗначениеЛимит = ЗначениеПараметраИзЗапроса(Запрос, "limit");
		Если ЗначениеЛимит = Неопределено Тогда
			Лимит = 0;
		Иначе	
			Лимит = Число(ЗначениеЛимит);
		КонецЕсли;
	Исключение
		Лимит = 0;
	КонецПопытки;
	
	Если Лимит = Неопределено ИЛИ Лимит <= 0 Тогда
		Лимит = 10;
	КонецЕсли;
	
	// Получаем параметр owner (для подчиненных справочников)
	Владелец = Строка(ЗначениеПараметраИзЗапроса(Запрос, "owner"));
	
	// Получаем параметр name_filter (для отбора по наименованию)
	ОтборПоНаименованию = Строка(ЗначениеПараметраИзЗапроса(Запрос, "name_filter"));

	// Получаем параметр name_match_type (режим сравнения для name_filter).
	// Допустимые значения (без учёта регистра): "exact", "partial", "starts_with".
	// Незаполненное значение трактуется как "exact" (обратная совместимость).
	// Любое другое значение — ошибка INVALID_PARAMS.
	ВидОтбораПоНаименованию = Строка(ЗначениеПараметраИзЗапроса(Запрос, "name_match_type"));
	ВидОтбораПоНаименованию = ВРег(СокрЛП(ВидОтбораПоНаименованию));
	Если ВидОтбораПоНаименованию <> "EXACT"
			И ВидОтбораПоНаименованию <> "PARTIAL"
			И ВидОтбораПоНаименованию <> "STARTS_WITH" Тогда
		Если НЕ ЗначениеЗаполнено(ВидОтбораПоНаименованию) Тогда
			ВидОтбораПоНаименованию = "EXACT";
		Иначе
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Недопустимое значение параметра name_match_type: ""%1"". Допустимые значения: ""exact"", ""partial"", ""starts_with""."),
				Строка(ЗначениеПараметраИзЗапроса(Запрос, "name_match_type")));
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Получаем параметр навигационнаяСсылка (для object_type = 6)
	НавигационнаяСсылка = Строка(ЗначениеПараметраИзЗапроса(Запрос, "navigationLink"));
	
	// Получаем параметры даты для документов
	ДатаНачала = ЗначениеПараметраИзЗапроса(Запрос, "date_start");
	ДатаОкончания = ЗначениеПараметраИзЗапроса(Запрос, "date_end");

	// Получаем параметры диапазона для object_type = 5
	НачальныйНомер = 0;
	КонечныйНомер = 0;
	Попытка
		ЗначениеНачальногоНомера = ЗначениеПараметраИзЗапроса(Запрос, "start_number");
		Если ЗначениеНачальногоНомера <> Неопределено Тогда
			НачальныйНомер = Число(ЗначениеНачальногоНомера);
		КонецЕсли;
	Исключение
		НачальныйНомер = 0;
	КонецПопытки;

	Попытка
		ЗначениеКонечногоНомера = ЗначениеПараметраИзЗапроса(Запрос, "end_number");
		Если ЗначениеКонечногоНомера <> Неопределено Тогда
			КонечныйНомер = Число(ЗначениеКонечногоНомера);
		КонецЕсли;
	Исключение
		КонечныйНомер = 0;
	КонецПопытки;

	Если ТипОбъекта = 6 Тогда
		Если НЕ ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
			ТекстСообщения = Ванесса.Локализовать("Для object_type = 6 (Реквизиты объекта по навигационной ссылке) необходимо указать параметр навигационнаяСсылка.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Попытка
			ДатаНачала = Ванесса.ДатаИзСтрокиКомандыСистемы(ДатаНачала);
		Исключение
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось преобразовать строку <%1> в дату начала."), ДатаНачала) + Символы.ПС  + ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Попытка
			ДатаОкончания = Ванесса.ДатаИзСтрокиКомандыСистемы(ДатаОкончания);
		Исключение
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось преобразовать строку <%1> в дату окончания."), ДатаОкончания) + Символы.ПС  + ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Формируем результат в зависимости от типа объекта
	Если ТипОбъекта = 1 Тогда
		// Справочник
		Возврат ПолучитьДанныеСправочника(ИмяОбъекта, Владелец, Лимит, ОтборПоНаименованию, ВидОтбораПоНаименованию);
	ИначеЕсли ТипОбъекта = 2 Тогда
		// Документ
		Возврат ПолучитьДанныеДокумента(ИмяОбъекта, ДатаНачала, ДатаОкончания, Лимит);
	ИначеЕсли ТипОбъекта = 3 Тогда
		// Перечисление
		Возврат ПолучитьДанныеПеречисления(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = 4 Тогда
		// Константа
		Возврат ПолучитьДанныеКонстанты(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = 5 Тогда
		// Все константы
		Возврат ПолучитьВсеКонстанты(НачальныйНомер, КонечныйНомер);
	ИначеЕсли ТипОбъекта = 6 Тогда
		// Реквизиты объекта по навигационной ссылке
		Возврат ПолучитьРеквизитыОбъектаПоНавигационнойСсылке(НавигационнаяСсылка);
	КонецЕсли;
	
КонецФункции

// Возвращает данные перечисления
&НаКлиенте
Функция ПолучитьДанныеПеречисления(ИмяПеречисления)
	
	Если НЕ ЗначениеЗаполнено(ИмяПеречисления) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Перечисление' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Строки = Новый Массив;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Перечисление");
	ДопПараметры.Вставить("Вид", ИмяПеречисления);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет перечисления:") + " " + ИмяПеречисления);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Перечисление:") + " " + ИмяПеречисления);
	Строки.Добавить("");
	
	Счетчик = 0;
	Для Каждого ТекДанные Из Данные Цикл
		
		Если Лев(НРег(ТекДанные.Имя), 7) = "удалить" ИЛИ Лев(НРег(ТекДанные.Имя), 6) = "delete" Тогда
			// Значит значение устарело
			Продолжить;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
		Строки.Добавить(Ванесса.Локализовать("## Значение") + " " + Формат(Счетчик, "ЧГ=0; ЧН=0"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("- Имя:") + " " + ТекДанные.Имя);
		Если ЗначениеЗаполнено(ТекДанные.Представление) Тогда
			Строки.Добавить(Ванесса.Локализовать("- Представление для пользователя:") + " " + ТекДанные.Представление);
		Иначе	
			Строки.Добавить(Ванесса.Локализовать("- Представление для пользователя:") + " " + ТекДанные.Имя);
		КонецЕсли;
		Строки.Добавить("");
	КонецЦикла;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Возвращает данные справочника
&НаКлиенте
Функция ПолучитьДанныеСправочника(ИмяСправочника, Владелец, Лимит, ОтборПоНаименованию = Неопределено, ВидОтбораПоНаименованию = "EXACT")

	Если НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Справочник' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Справочник");
	ДопПараметры.Вставить("Вид", ИмяСправочника);
	ДопПараметры.Вставить("Владелец", Владелец);
	ДопПараметры.Вставить("Лимит", Лимит);
	Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
		ДопПараметры.Вставить("ОтборПоНаименованию", ОтборПоНаименованию);
	КонецЕсли;
	ДопПараметры.Вставить("ВидОтбораПоНаименованию", ВидОтбораПоНаименованию);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может вернуть обёртку {КоличествоЭлементов, ДанныеЭлементов}.
	// Для обратной совместимости со старым форматом (массив напрямую) поддерживаем оба варианта.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДанныеЭлементов") Тогда
		ВсегоЭлементов = Данные.КоличествоЭлементов;
		Данные = Данные.ДанныеЭлементов;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		ВсегоЭлементов = Данные.Количество();
	Иначе
		// Это Структура с ошибкой (нет объекта метаданных) - количество не вычисляем,
		// обработка ошибки будет ниже.
		ВсегоЭлементов = 0;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет справочника:") + " " + ИмяСправочника);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Справочник:") + " " + ИмяСправочника);
	Строки.Добавить(Ванесса.Локализовать("# Всего элементов в базе:") + " " + XMLСтрока(ВсегоЭлементов));
	Если ВсегоЭлементов > Данные.Количество() Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("# Возвращено первые %1 элементов (используйте параметр limit, чтобы получить больше)."),
			XMLСтрока(Данные.Количество())));
	КонецЕсли;
	Строки.Добавить("");

	Счетчик = 0;
	Для Каждого ТекСтрока Из Данные Цикл
		Счетчик = Счетчик + 1;
		
		Строки.Добавить(Ванесса.Локализовать("## Элемент") + " " + Формат(Счетчик, "ЧГ=0; ЧН=0"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("- Навигационная ссылка:") + " " + Строка(ТекСтрока.НавигационнаяСсылка));
		Строки.Добавить(Ванесса.Локализовать("- Наименование:") + " " + ТекСтрока.Наименование);
		Строки.Добавить(Ванесса.Локализовать("- Пометка удаления:") + " " + ТекСтрока.ПометкаУдаления);
		Если ТекСтрока.Свойство("Код") Тогда
			Строки.Добавить(Ванесса.Локализовать("- Код:") + " " + ТекСтрока.Код);
		КонецЕсли;
		Если ТекСтрока.Свойство("Владелец") Тогда
			Строки.Добавить(Ванесса.Локализовать("- Владелец:") + " " + Строка(ТекСтрока.Владелец));
		КонецЕсли;
		Строки.Добавить("");
	КонецЦикла;
	
	Если Счетчик = 0 Тогда
		Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не найдено ни одного элемента с Наименованием `%1`."), ОтборПоНаименованию));
		Иначе	
			Строки.Добавить(Ванесса.Локализовать("Элементов справочника не найдено."));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Возвращает данные документа
&НаКлиенте
Функция ПолучитьДанныеДокумента(ИмяДокумента, ДатаНачала, ДатаОкончания, Лимит)
	
	Если НЕ ЗначениеЗаполнено(ИмяДокумента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Документ' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Строки = Новый Массив;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Документ");
	ДопПараметры.Вставить("Вид", ИмяДокумента);
	ДопПараметры.Вставить("Лимит", Лимит);
	ДопПараметры.Вставить("ДатаНачала", ДатаНачала);
	ДопПараметры.Вставить("ДатаОкончания", ДатаОкончания);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может вернуть обёртку {КоличествоДокументов, ДанныеДокументов}.
	// Для обратной совместимости со старым форматом (массив напрямую) поддерживаем оба варианта.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДанныеДокументов") Тогда
		ВсегоДокументов = Данные.КоличествоДокументов;
		Данные = Данные.ДанныеДокументов;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		ВсегоДокументов = Данные.Количество();
	Иначе
		// Это Структура с ошибкой (нет объекта метаданных) - количество не вычисляем,
		// обработка ошибки будет ниже.
		ВсегоДокументов = 0;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет документа:") + " " + ИмяДокумента);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Документ:") + " " + ИмяДокумента);
	Строки.Добавить(Ванесса.Локализовать("# Всего документов в базе:") + " " + XMLСтрока(ВсегоДокументов));
	Если ВсегоДокументов > Данные.Количество() Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("# Возвращено первые %1 документов (используйте параметр limit или date_start/date_end, чтобы получить больше)."),
			XMLСтрока(Данные.Количество())));
	КонецЕсли;
	Строки.Добавить("");
	
	Счетчик = 0;
	Для Каждого ТекСтрока Из Данные Цикл
		Счетчик = Счетчик + 1;
		
		Строки.Добавить(Ванесса.Локализовать("## Документ") + " " + Формат(Счетчик, "ЧГ=0; ЧН=0"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("- Представление:") + " " + Строка(ТекСтрока.Ссылка));
		Строки.Добавить(Ванесса.Локализовать("- Навигационная ссылка:") + " " + Строка(ТекСтрока.НавигационнаяСсылка));
		Строки.Добавить(Ванесса.Локализовать("- Дата:") + " " + ТекСтрока.Дата);
		Если ТекСтрока.Свойство("Номер") Тогда
			Строки.Добавить(Ванесса.Локализовать("- Номер:") + " " + ТекСтрока.Номер);
		КонецЕсли;
		Строки.Добавить(Ванесса.Локализовать("- Пометка удаления:") + " " + ТекСтрока.ПометкаУдаления);
		Если ТекСтрока.Свойство("Проведен") Тогда
			Строки.Добавить(Ванесса.Локализовать("- Проведен:") + " " + ТекСтрока.Проведен);
		КонецЕсли;
		Строки.Добавить("");
	КонецЦикла;
	
	Если Счетчик = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Документы не найдены."));
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Возвращает данные константы и общее количество констант в базе клиента тестирования
&НаКлиенте
Функция ПолучитьДанныеКонстанты(ИмяКонстанты)

	Если НЕ ЗначениеЗаполнено(ИмяКонстанты) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Константа' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Константа");
	ДопПараметры.Вставить("Вид", ИмяКонстанты);

	ТекстОшибки = Неопределено;
	Ответ = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Расширение возвращает данные в обёртке {КоличествоКонстант, ДанныеКонстанты}.
	// Для обратной совместимости со старым форматом, где расширение могло вернуть
	// только структуру с данными константы, поддерживаем оба варианта.
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ДанныеКонстанты") Тогда
		Данные = Ответ.ДанныеКонстанты;
		ВсегоКонстант = Ответ.КоличествоКонстант;
	Иначе
		Данные = Ответ;
		ВсегоКонстант = Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаНетОбъектаМетаданных") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет константы:") + " " + ИмяКонстанты);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;
		// Дополнительно сообщим общее количество констант в базе.
		Если ВсегоКонстант <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(Данные.ВсеОбъекты.Количество()));
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Строки.Добавить(Ванесса.Локализовать("# Константа:") + " " + ИмяКонстанты);
	Если ВсегоКонстант <> Неопределено Тогда
		Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
	КонецЕсли;
	Строки.Добавить("");

	Если ЗначениеЗаполнено(Данные.Свойство("Значение")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Значение:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные.Значение));
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Свойство("Представление")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Представление:") + " " + Данные.Представление);
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Свойство("ТипЗначения")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Тип значения:") + " " + Данные.ТипЗначения);
	КонецЕсли;
	Строки.Добавить("");

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает значения всех констант (опционально по диапазону номеров)
&НаКлиенте
Функция ПолучитьВсеКонстанты(НачальныйНомер = 0, КонечныйНомер = 0)

	// Проверка корректности переданного диапазона (до вызова расширения).
	Если НачальныйНомер < 0 ИЛИ КонечныйНомер < 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры start_number и end_number должны быть положительными числами.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если НачальныйНомер > 0 И НачальныйНомер < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр start_number должен быть >= 1.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если КонечныйНомер > 0 И КонечныйНомер < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр end_number должен быть >= 1.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если НачальныйНомер > 0 И КонечныйНомер > 0 И НачальныйНомер > КонечныйНомер Тогда
		ТекстСообщения = Ванесса.Локализовать("НачальныйНомер не может быть больше КонечныйНомер");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "ВсеКонстанты");
	Если НачальныйНомер > 0 Тогда
		ДопПараметры.Вставить("НачальныйНомер", НачальныйНомер);
	КонецЕсли;
	Если КонечныйНомер > 0 Тогда
		ДопПараметры.Вставить("КонечныйНомер", КонечныйНомер);
	КонецЕсли;

	ТекстОшибки = Неопределено;
	Ответ = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Поддержка обёртки {КоличествоКонстант, ДанныеКонстант} от расширения.
	// Обратная совместимость: если расширение вернуло массив напрямую - работаем с ним.
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ДанныеКонстант") Тогда
		Данные = Ответ.ДанныеКонстант;
		ВсегоКонстант = Ответ.КоличествоКонстант;
	Иначе
		Данные = Ответ;
		ВсегоКонстант = Данные.Количество();
	КонецЕсли;

	// Валидация против общего количества констант (требует данных от расширения,
	// поэтому выполняется после вызова расширения, а не на этапе разбора параметров MCP)
	Если НачальныйНомер > 0 И НачальныйНомер > ВсегоКонстант Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Начальный номер (%1) превышает общее количество констант в базе (%2)."),
			XMLСтрока(НачальныйНомер), XMLСтрока(ВсегоКонстант));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ФактНачало = ?(НачальныйНомер > 0, НачальныйНомер, 1);
	ФактКонец  = ?(КонечныйНомер > 0, КонечныйНомер,  ВсегоКонстант);

	Строки.Добавить(Ванесса.Локализовать("# Значения всех констант:"));
	Строки.Добавить(Ванесса.Локализовать("- Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
	Если НачальныйНомер > 0 ИЛИ КонечныйНомер > 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("- Возвращено значений:") + " " + XMLСтрока(Данные.Количество())
			+ " (" + Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("диапазон с %1 по %2"), XMLСтрока(ФактНачало), XMLСтрока(ФактКонец)) + ")");
	Иначе
		Строки.Добавить(Ванесса.Локализовать("- Возвращено значений:") + " " + XMLСтрока(Данные.Количество()));
	КонецЕсли;
	Строки.Добавить("");

	Для Каждого ТекКонстанта Из Данные Цикл
		Строки.Добавить(" -" + Ванесса.Локализовать("Имя:") + " " + ТекКонстанта.Имя);
		Строки.Добавить(" -" + Ванесса.Локализовать("Представление:") + " " + ТекКонстанта.Представление);
		Строки.Добавить(" -" + Ванесса.Локализовать("Значение:") + " " + ТекКонстанта.Значение);
		Строки.Добавить(" -" + Ванесса.Локализовать("ТипЗначения:") + " " + ТекКонстанта.ТипЗначения);
		Строки.Добавить("");
	КонецЦикла;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции


// Возвращает реквизиты объекта по навигационной ссылке
&НаКлиенте
Функция ПолучитьРеквизитыОбъектаПоНавигационнойСсылке(НавигационнаяСсылка)
	
	Если НЕ ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр навигационнаяСсылка.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "ДанныеПоНавигационнойСсылке");
	ДопПараметры.Вставить("НавигационнаяСсылкаОбъекта", НавигационнаяСсылка);
	
	ТекстОшибки = Неопределено;
	ДанныеОбъекта = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	ТолькоЗаполненные = Ложь;
	
	Строки = Новый Массив;
	
	// Получаем все реквизиты шапки или все данные
	Строки.Добавить(Ванесса.Локализовать("## Реквизиты шапки"));
	Строки.Добавить("");
	
	Для Каждого ТекРеквизит Из ДанныеОбъекта.СтандартныеРеквизиты Цикл
		ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные);
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из ДанныеОбъекта.РеквизитыШапки Цикл
		ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные);
	КонецЦикла;
	
	// Получаем все табличные части или все данные
	Строки.Добавить(Ванесса.Локализовать("## Табличные части"));
	Строки.Добавить("");
	
	Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
		ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТекТабличнаяЧасть, ТолькоЗаполненные);
	КонецЦикла;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаКлиенте
Функция ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки)
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ПолучениеДанныхИзБазы");
	ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ПолучениеДанныхИзБазы.*",5);
	Если НужнаяФорма = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключен, но не найдена форма 'VAExtension_ПолучениеДанныхИзБазы' из служебного расширения.");
		Возврат Неопределено
	КонецЕсли;	
	
	РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина);
	РеквизитТип = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("Тип", Истина);
	РеквизитТип.ВвестиТекст(ДопПараметры.Тип);
	Если ДопПараметры.Свойство("Вид") Тогда
		РеквизитВид = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("Вид", Истина);
		РеквизитВид.ВвестиТекст(ДопПараметры.Вид);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("НавигационнаяСсылкаОбъекта") Тогда
		РеквизитНавигационнаяСсылкаОбъекта = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("НавигационнаяСсылкаОбъекта", Истина);
		РеквизитНавигационнаяСсылкаОбъекта.ВвестиТекст(ДопПараметры.НавигационнаяСсылкаОбъекта);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("Владелец") Тогда
		РеквизитИмяВладельца = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ИмяВладельца", Истина);
		РеквизитИмяВладельца.ВвестиТекст(ДопПараметры.Владелец);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("Лимит") Тогда
		РеквизитКоличествоСсылок = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КоличествоСсылок", Истина);
		РеквизитКоличествоСсылок.ВвестиТекст(XMLСтрока(ДопПараметры.Лимит));
	КонецЕсли;

	Если ДопПараметры.Свойство("НачальныйНомер") И ДопПараметры.НачальныйНомер > 0 Тогда
		РеквизитНачальныйНомер = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("НачальныйНомер", Истина);
		РеквизитНачальныйНомер.ВвестиТекст(XMLСтрока(ДопПараметры.НачальныйНомер));
	КонецЕсли;

	Если ДопПараметры.Свойство("КонечныйНомер") И ДопПараметры.КонечныйНомер > 0 Тогда
		РеквизитКонечныйНомер = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КонечныйНомер", Истина);
		РеквизитКонечныйНомер.ВвестиТекст(XMLСтрока(ДопПараметры.КонечныйНомер));
	КонецЕсли;
	
	Если ДопПараметры.Свойство("ОтборПоНаименованию") И ЗначениеЗаполнено(ДопПараметры.ОтборПоНаименованию) Тогда
		РеквизитОтборПоНаименованию = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОтборПоНаименованию", Истина);
		РеквизитОтборПоНаименованию.ВвестиТекст(ДопПараметры.ОтборПоНаименованию);
	КонецЕсли;

	// Передаём режим сравнения name_filter: exact/partial/starts_with.
	// Передаём всегда (даже если отбор пуст) — чтобы при последовательных вызовах
	// не "залипал" старый режим в реквизите формы расширения.
	Если ДопПараметры.Свойство("ВидОтбораПоНаименованию") Тогда
		РеквизитВидОтбораПоНаименованию = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ВидОтбораПоНаименованию", Истина);
		РеквизитВидОтбораПоНаименованию.ВвестиТекст(ДопПараметры.ВидОтбораПоНаименованию);
	КонецЕсли;
	
	ДанныеДат = Новый Структура;
	ПереданыДаты = Ложь;
	Если ДопПараметры.Свойство("ДатаНачала") И ЗначениеЗаполнено(ДопПараметры.ДатаНачала) Тогда
		ПереданыДаты = Истина;
		ДанныеДат.Вставить("ДатаНачала", ДопПараметры.ДатаНачала);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("ДатаОкончания") И ЗначениеЗаполнено(ДопПараметры.ДатаОкончания) Тогда
		ПереданыДаты = Истина;
		ДанныеДат.Вставить("ДатаОкончания", ДопПараметры.ДатаОкончания);
	КонецЕсли;
	
	АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Если ПереданыДаты Тогда
		РеквизитДляУстановкиПараметров = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ДляУстановкиПараметров", Истина);
		РеквизитДляУстановкиПараметров.ВвестиТекст(Ванесса.ЗаписатьОбъектJSON(ДанныеДат));
		КнопкаПолучитьПараметры = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаПолучитьПараметры");
		КнопкаПолучитьПараметры.Нажать();
	КонецЕсли;
	
	КнопкаВыполнитьОбработку = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьОбработку");
	
	КнопкаЗакрытьФорму = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	КнопкаВыполнитьОбработку.Нажать();
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные из базы данных клиента тестирования.");
		Возврат Неопределено
	КонецЕсли;
	
	РеквизитЗначениеДляВозврата = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеРезультат", Истина);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеДляВозврата);
	
	Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	
	Попытка
		КнопкаЗакрытьФорму.Нажать();
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("ДанныеИзБазыДанныхКлиентаТестирования", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Данные;
	
КонецФункции	

&НаКлиенте
Функция ПреобразоватьПроблемыПроверкиСинтаксиса(Проблемы)
	МассивПроблем = Новый Массив;
	Попытка
		Если Проблемы <> Неопределено Тогда
			Для Каждого Проблема Из Проблемы Цикл
				ПроблемаJSON = Новый Структура;
				Если ТипЗнч(Проблема) = Тип("Структура") Тогда
					ПроблемаJSON.Вставить("line", MCPБезопасноеСвойство(Проблема, "НомерСтроки"));
					ПроблемаJSON.Вставить("message", MCPБезопасноеСвойство(Проблема, "Текст"));
				ИначеЕсли ТипЗнч(Проблема) = Тип("Соответствие") Тогда
					ЗначениеСтроки = Проблема["НомерСтроки"];
					Если ЗначениеСтроки = Неопределено Тогда
						ЗначениеСтроки = Проблема["line"];
					КонецЕсли;
					ПроблемаJSON.Вставить("line", ЗначениеСтроки);
					ЗначениеТекста = Проблема["Текст"];
					Если ЗначениеТекста = Неопределено Тогда
						ЗначениеТекста = Проблема["message"];
					КонецЕсли;
					ПроблемаJSON.Вставить("message", ЗначениеТекста);
				Иначе
					ПроблемаJSON.Вставить("message", Строка(Проблема));
				КонецЕсли;
				МассивПроблем.Добавить(ПроблемаJSON);
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат МассивПроблем;
КонецФункции

&НаКлиенте
Функция ОшибкаПроверкиСинтаксиса(Проблемы)
	ТекстОшибки = Неопределено;
	ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	
	МассивПроблем = ПреобразоватьПроблемыПроверкиСинтаксиса(Проблемы);
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Обнаружены ошибки проверки синтаксиса файла '%1'"), ПутьКФайлу));
	Строки.Добавить("");

	НомерПроблемы = 0;
	Для Каждого Проблема Из МассивПроблем Цикл
		НомерПроблемы = НомерПроблемы + 1;
		СтрокаПроблемы = Строка(НомерПроблемы) + ". ";
		Если Проблема["line"] <> Неопределено Тогда
			СтрокаПроблемы = СтрокаПроблемы + Ванесса.Локализовать("Строка") + " " + Строка(Проблема["line"]) + ": ";
		КонецЕсли;
		СтрокаПроблемы = СтрокаПроблемы + MCPПредставлениеЗначенияДляMarkdown(Проблема["message"]);
		Строки.Добавить(СтрокаПроблемы);
	КонецЦикла;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция СтрокаДляОшибкиТекстМодальногоДиалога()
	Возврат Ванесса.Локализовать("Текст модального диалога:");
КонецФункции

&НаКлиенте
Процедура ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок)
	
	ПанельФункций = Неопределено;
	Попытка
		ПанельФункций = Ванесса.ПанельФункций();
	Исключение
	КонецПопытки;
	Если ПанельФункций <> Неопределено Тогда
		МассивСтрок.Добавить(Ванесса.Локализовать("В данный момент открыта панель функций. Работа с окнами и элементами форм заблокирована. Нужно вызвать инструмент `manage_command_interface`, `action=close_function_panel`"));
		Возврат;
	КонецЕсли;
	
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		ТекстСтроки = Ванесса.Локализовать("Заголовок активного окна:") + " " + АктивноеОкно.Заголовок;
		МассивСтрок.Добавить(ТекстСтроки);
		Если Ванесса.ЭтоМодальныйДиалог(АктивноеОкно) Тогда
			МассивСтрок.Добавить(Ванесса.Локализовать("Обнаружен модальный диалог."));
			ТекСообщение = Ванесса._СтрСоединить(МассивСтрок, Символы.ПС);
			Если Найти(ТекСообщение, СтрокаДляОшибкиТекстМодальногоДиалога()) = 0 Тогда
				ДобавитьВОтветИнформациюОМодальномДиалоге(МассивСтрок, АктивноеОкно);
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			CообщенияПользователю = ПолучитьСообщенияПользователюИзОкна(АктивноеОкно);
			Если CообщенияПользователю <> Неопределено Тогда
				МассивСтрок.Добавить("");
				МассивСтрок.Добавить(Ванесса.Локализовать("## В окне есть сообщения пользователю:"));
				МассивСтрок.Добавить(Ванесса._СтрСоединить(CообщенияПользователю, Символы.ПС));
			КонецЕсли;
		Исключение
			
		КонецПопытки;
		
		Попытка
			ТекущаяФорма = Ванесса.НайтиТекущуюФормуTestClient();
			ТекЭлемент = ТекущаяФорма.ПолучитьТекущийЭлемент();
			МассивСтрок.Добавить("");
			МассивСтрок.Добавить("## Активный элемент шапки формы:");
			МассивСтрок.Добавить("Имя:" + " " + ТекЭлемент.Имя);
			МассивСтрок.Добавить("Заголовок:" + " " + ТекЭлемент.ТекстЗаголовка);
			
			ТекстОткрытогоСписка = "";
			Попытка
				Ванесса.ДополнитьОшибку_ЗначениеОткрытогоСписка(ТекЭлемент, ТекстОткрытогоСписка);
			Исключение
			КонецПопытки;
		Если ЗначениеЗаполнено(ТекстОткрытогоСписка) Тогда
				МассивСтрок.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В поле `%1` не был зафиксирован выбор значения. Выполните ввод значения по строке или выбор точного значения из списка."), ТекЭлемент.Имя));
				МассивСтрок.Добавить(ТекстОткрытогоСписка);
			КонецЕсли;
		Исключение
			
		КонецПопытки;
		
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ДобавитьВСообщениеДанныеОбАктивномОкне(Строка, СделатьSleep = Ложь)
	Если СделатьSleep Тогда
		Ванесса.sleep(1);
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(Строка);
	ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
