// Проверяет, что таблица является текущим (активным) элементом открытой формы.
// Для формы активный элемент - это сама таблица; активная ячейка внутри неё значения не имеет.
&НаКлиенте
Функция ЭтоТекущаяТаблицаФормыMCP(Таблица)
	Попытка
		ТекущаяФорма = Ванесса.НайтиТекущуюФормуTestClient();
		Если ТекущаяФорма = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ТекЭлемент = ТекущаяФорма.ПолучитьТекущийЭлемент();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если ТекЭлемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Если ТипЗнч(ТекЭлемент) = Тип("ТестируемаяТаблицаФормы") Тогда
			Возврат ТекЭлемент.Имя = Таблица.Имя;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Читает режим редактирования строки таблицы.
// Возвращает структуру: Режим (Истина/Ложь/Неопределено) и ТекстОшибки (заполнен, если режим прочитать не удалось).
&НаКлиенте
Функция РежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы)
	Результат = Новый Структура("Режим, ТекстОшибки", Неопределено, "");
	Попытка
		Результат.Режим = Таблица.ТекущийРежимРедактирование();
	Исключение
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Не удалось прочитать режим редактирования таблицы '%1':"), ИмяТаблицы)
			+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		Результат.ТекстОшибки = ТекстОшибки;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Обеспечивает режим редактирования строки таблицы: при необходимости активизирует таблицу
// и ячейку (целевую или текущую), затем начинает редактирование строки. Если стартовать
// с ячейки, ввод в которую невозможен, платформенный ИзменитьСтроку молча ничего не делает,
// поэтому для действий с целевым полем активизируется именно оно. Одна попытка, без повторов и ожиданий.
// Возвращает "" при успехе или текст ошибки (с данными о состоянии таблицы) при неудаче.
&НаКлиенте
Функция ОбеспечитьРежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы, ПолеЦели = Неопределено)
	СведенияОРежиме = РежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы);
	Если СведенияОРежиме.Режим = Неопределено Тогда
		Возврат СведенияОРежиме.ТекстОшибки;
	КонецЕсли;
	Если СведенияОРежиме.Режим Тогда
		Возврат "";
	КонецЕсли;

	// Активизируем таблицу, только если она не является активным элементом формы:
	// активная ячейка внутри таблицы на уровне формы не видна, поэтому решает сам элемент.
	Если НЕ ЭтоТекущаяТаблицаФормыMCP(Таблица) Тогда
		Попытка
			Таблица.Активизировать();
		Исключение
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Не удалось активизировать таблицу '%1':"), ИмяТаблицы)
				+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат ТекстОшибки;
		КонецПопытки;
		// Активизация могла уже открыть строку на редактирование - тогда ИзменитьСтроку не нужна.
		СведенияОРежиме = РежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы);
		Если СведенияОРежиме.Режим = Неопределено Тогда
			Возврат СведенияОРежиме.ТекстОшибки;
		КонецЕсли;
		Если СведенияОРежиме.Режим Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;

	// Перед ИзменитьСтроку активизируем целевую ячейку (или текущую, если цель не задана) -
	// так же, как это делают шаги VA (сначала активация ячейки, затем ИзменитьСтроку);
	// ошибка активации не прерывает попытку.
	ЯчейкаДляСтарта = ПолеЦели;
	Если ЯчейкаДляСтарта = Неопределено Тогда
		Попытка
			ЯчейкаДляСтарта = Таблица.ПолучитьТекущийЭлемент();
		Исключение
			ЯчейкаДляСтарта = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ЯчейкаДляСтарта <> Неопределено Тогда
		Попытка
			ЯчейкаДляСтарта.Активизировать();
		Исключение
			// Не удалось активизировать ячейку - продолжаем; причина будет видна в диагностике состояния таблицы.
		КонецПопытки;
		СведенияОРежиме = РежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы);
		Если СведенияОРежиме.Режим = Неопределено Тогда
			Возврат СведенияОРежиме.ТекстОшибки;
		КонецЕсли;
		Если СведенияОРежиме.Режим Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;

	Попытка
		Таблица.ИзменитьСтроку();
	Исключение
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В таблице '%1' не удалось начать редактирование строки. Если в строке есть ячейка с незавершённым редактированием, завершите её ('end_edit_row' или 'cancel_edit') и повторите действие."), ИмяТаблицы)
			+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

	// Повторное чтение режима нужно только для обратного случая: метод отработал без исключения,
	// но таблица в режим редактирования не перешла.
	СведенияОРежиме = РежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы);
	Если СведенияОРежиме.Режим = Неопределено Тогда
		Возврат СведенияОРежиме.ТекстОшибки;
	КонецЕсли;
	Если СведенияОРежиме.Режим Тогда
		Возврат "";
	КонецЕсли;

	ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("В таблице '%1' не удалось начать редактирование строки: таблица не перешла в режим редактирования. Если в таблице нет строк, сначала добавьте строку действием 'add_row'. Если колонка, с которой начинается редактирование, не редактируется, активизируйте редактируемую колонку действием 'activate_column' и повторите."), ИмяТаблицы);
	ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
	Возврат ТекстОшибки;
КонецФункции

// Таблицы: add_row
&НаКлиенте
Функция ДобавитьСтрокуТаблицыMCP(ИмяТаблицы)
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		Таблица.Активизировать();
		Попытка
			Таблица.ДобавитьСтроку();
		Исключение
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Не удалось добавить строку в таблицу '%1':"), ИмяТаблицы)
				+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		// По соглашению "нет исключения - значит, сработало" повторное чтение режима нужно только для
		// обратного случая: платформенный метод отработал без исключения, но состояние не изменилось.
		Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Строка в таблицу '%1' добавлена, но таблица не перешла в режим редактирования строки."), ИмяТаблицы);
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В таблицу '%1' добавлена строка. Строка открыта на редактирование - заполните поля и вызовите 'end_edit_row'."), ИмяТаблицы);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Таблицы: copy_row
&НаКлиенте
Функция СкопироватьСтрокуТаблицыMCP(ИмяТаблицы)
	Если НЕ Ванесса.Версия8325ИлиВыше Тогда
		Возврат ОшибкаТребуемойВерсии("copy_row", "8.3.25");
	КонецЕсли;
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		// На платформе 8.5.1+ выделение строки недостоверно (см. обходы в КлиентТестирования) - там копирование проверяет сама платформа
		Если НЕ Ванесса.Версия851ИлиВыше И НЕ ЕстьТекущаяСтрокаТаблицыMCP(Таблица) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("В таблице '%1' нет текущей строки для копирования."), ИмяТаблицы));
		КонецЕсли;
		Таблица.Активизировать();
		Попытка
			Таблица.СкопироватьСтроку();
		Исключение
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Не удалось скопировать строку в таблице '%1':"), ИмяТаблицы)
				+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Если Ванесса.Версия851ИлиВыше Тогда
				ТекстОшибки = ТекстОшибки + Символы.ПС
					+ Ванесса.Локализовать("Если в таблице нет выделенной строки, сначала выделите её действием 'select_row'.");
			КонецЕсли;
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Строка в таблице '%1' скопирована, но таблица не перешла в режим редактирования строки."), ИмяТаблицы);
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("В таблице '%1' строка скопирована. Строка открыта на редактирование - заполните поля и вызовите 'end_edit_row'."), ИмяТаблицы);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

// Таблицы: delete_row
&НаКлиенте
Функция УдалитьСтрокуТаблицыMCP(ИмяТаблицы, ПолноеПредставление = Ложь)
	УдалённаяСтрока = Неопределено;
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		// Платформенный УдалитьСтроку() удаляет текущую строку: строку-адресат указать нельзя,
		// поэтому к нужной строке сначала переходим ('navigate_to_row').
		Если Ванесса.Версия8312ИлиВыше И Таблица.ТекущийРежимРедактирование() Тогда
			Попытка
				Таблица.ЗакончитьРедактированиеСтроки();
			Исключение
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("В таблице '%1' не удалось завершить редактирование строки перед удалением:"), ИмяТаблицы)
					+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
				ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецПопытки;
		КонецЕсли;
		Если Ванесса.Версия8312ИлиВыше И Таблица.ТекущийРежимРедактирование() Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Таблица '%1' осталась в режиме редактирования строки, удаление отменено. Завершите редактирование ('end_edit_row' или 'cancel_edit') и повторите."), ИмяТаблицы);
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		Попытка
			ВыделенныеСтроки = Таблица.ПолучитьВыделенныеСтроки();
		Исключение
			ВыделенныеСтроки = Новый Массив;
		КонецПопытки;
		Если ВыделенныеСтроки = Неопределено Тогда
			ВыделенныеСтроки = Новый Массив;
		КонецЕсли;
		Если ВыделенныеСтроки.Количество() = 0 Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("В таблице '%1' нет текущей строки для удаления."), ИмяТаблицы);
			Если Ванесса.Версия851ИлиВыше Тогда
				ТекстОшибки = ТекстОшибки + Символы.ПС
					+ Ванесса.Локализовать("Если в таблице нет выделенной строки, сначала выделите её действием 'select_row'.");
			КонецЕсли;
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		Если ВыделенныеСтроки.Количество() > 1 Тогда
			// Удаляется только текущая строка; при множественном выделении результат не определён.
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("В таблице '%1' выделено несколько строк (%2), удаление отменено: delete_row удаляет только текущую строку. Оставьте выделенной одну строку и повторите."),
				ИмяТаблицы, ВыделенныеСтроки.Количество());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		УдалённаяСтрока = ВыделенныеСтроки[0];
		Таблица.Активизировать();
		Таблица.УдалитьСтроку();
		Если ПолноеПредставление Тогда
			ПредставлениеСтроки = MCPСократитьТекстДляОтвета(MCPПредставлениеЗначенияДляMarkdown(УдалённаяСтрока), 300);
		Иначе
			ПредставлениеСтроки = MCPСводкаПоОписаниюСтроки(УдалённаяСтрока, 200);
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Из таблицы '%1' удалена строка: %2"), ИмяТаблицы,
			ПредставлениеСтроки);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецФункции

