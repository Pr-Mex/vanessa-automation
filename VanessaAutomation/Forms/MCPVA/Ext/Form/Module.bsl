&НаКлиенте
Процедура СделатьШагФичиТекущим(НомерСтроки, Идентификатор, ТекстОшибки)
	СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
	Если СтрокаДерева = Неопределено Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В строке №%1 нет шага, который можно выполнить."), XMLСтрока(НомерСтроки));
		Возврат;
	КонецЕсли;
	
	Если СтрокаДерева.Тип <> "Шаг" Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В строке №%1 нет шага, который можно выполнить. В этой строке обнаружен тип строки: %2"), XMLСтрока(НомерСтроки), СтрокаДерева.Тип);
		Возврат;
	КонецЕсли;	
	
	Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(СтрокаДерева.ИдСтроки, НомерСтроки);
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
КонецПроцедуры

&НаСервере
Функция ДвоичныеДанныеГолосСервер()
	ОбъектСервер = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектСервер.ПолучитьМакет("ОзвучкаОповещенияMCP");
КонецФункции

// Универсальный инструмент для получения реквизитов объекта связанного с формой
