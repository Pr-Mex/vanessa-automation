// Внутренняя функция для нажатия гиперссылки
&НаКлиенте
Функция НажатьГиперссылку(ИмяЭлемента, ЗаголовокГиперссылки, ИндексГиперссылки)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'click_hyperlink' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем вид элемента заранее: у надписей и декораций гиперссылок форматированной строки нет,
	// и вместо "не получилось нажать" нужна точная причина.
	ЭлементФормы = Неопределено;
	Попытка
		ДопПараметрыПоиска = Новый Структура("КоличествоПопыток", 1);
		ЭлементФормы = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина, Ложь,, ДопПараметрыПоиска);
	Исключение
		ЭлементФормы = Неопределено;
	КонецПопытки;
	
	Если ЭлементФормы = Неопределено Тогда
		Возврат ОшибкаЭлементНеНайденMCP(ИмяЭлемента);
	КонецЕсли;
	
	Если ТипЗнч(ЭлементФормы) <> Тип("ТестируемоеПолеФормы") Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPVAСлужебныйМодуль.MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Элемент '%1' есть на форме, но это %2, а не поле ввода."),
					ИмяЭлемента, MCPОписаниеВидаЭлемента(ЭлементФормы)),
				Ванесса.Локализовать("Нажать гиперссылку можно только у поля с гиперссылкой форматированной строки.")));
	КонецЕсли;
	
	ВидЭлемента = "";
	Попытка
		ВидЭлемента = Строка(ЭлементФормы.Вид);
	Исключение
	КонецПопытки;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ИндексГиперссылки = Неопределено И ЗаголовокГиперссылки = Неопределено Тогда
			// Значит это обычная гиперссылка
			Ванесса.ВОткрытойФормеЯНажимаюНаГиперссылкуСЗаголовком(ИмяЭлемента, Истина);
		ИначеЕсли ИндексГиперссылки <> Неопределено Тогда	
			// Значит это номер гиперссылки в форматированной строке.
			Ванесса.УПоляЯНажимаюГиперссылку(ИмяЭлемента, ИндексГиперссылки, Истина, Ложь);
		ИначеЕсли ЗаголовокГиперссылки <> Неопределено Тогда	
			// Значит это номер гиперссылки в форматированной строке.
			Ванесса.УПоляЯНажимаюГиперссылку(ИмяЭлемента, ЗаголовокГиперссылки, Истина, Ложь);
		КонецЕсли;	
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Гиперссылка в поле '%1' была успешно нажата."), ИмяЭлемента);
	Исключение
		ТекстШага = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ЧтоДелатьОшибки = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Проверьте представления гиперссылок: get_formatted_string_hyperlink_presentations (element_name=%1). Если гиперссылок нет, а элемент вида ""%2"" открывает форму по нажатию, то гиперссылкой он не является и нажатие через click_hyperlink к нему неприменимо."),
			ИмяЭлемента, ВидЭлемента);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPVAСлужебныйМодуль.MCPОформитьОшибку(MCPVAСлужебныйМодуль.MCPСутьОшибкиИзТекста(ТекстШага), ЧтоДелатьОшибки, MCPVAСлужебныйМодуль.MCPДеталиОшибкиИзТекста(ТекстШага)));
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для эмуляции перехода TAB
&НаКлиенте
Функция ЭмуляцияПереходаTAB(НаправлениеПерехода)
	
	Попытка
		Если НаправлениеПерехода = "previous" Тогда
			Ванесса.ЯПерехожуКПредыдущемуРеквизиту();
			Возврат Ванесса.Локализовать("Был выполнен переход к предыдущему элементу (эмуляция SHIFT+TAB).");
		Иначе
			Ванесса.ЯПерехожуКСледующемуРеквизиту();
			Возврат Ванесса.Локализовать("Был выполнен переход к следующему элементу (эмуляция TAB).");
		КонецЕсли;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка эмуляции перехода TAB:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для активизации колонки таблицы
&НаКлиенте
Функция АктивизироватьКолонкуТаблицы(ИмяТаблицы, ИмяКолонки)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'activate_column' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяКолонки) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'activate_column' необходимо указать параметр value (имя или заголовок колонки).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	Таблица = Неопределено;
	КолонкаДляПодсказки = Неопределено;
	
	Попытка
		Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
		РезультатПоиска = НайтиКолонкуТаблицыMCP(Таблица, ИмяКолонки, ИмяТаблицы, Истина, Тип("ТестируемоеПолеФормы"));
		Если РезультатПоиска.Колонка = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				ТекстОшибкиКолонкаНеНайденаMCP(Таблица, ИмяКолонки, ИмяТаблицы, РезультатПоиска, Истина));
		КонецЕсли;
		КолонкаДляПодсказки = РезультатПоиска.Колонка;
		Ванесса.ВОткрытойФормеВТЧЯАктивизируюПоле(ИмяТаблицы, РезультатПоиска.Колонка.Имя, Истина);
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Колонка '%1' в таблице '%2' была успешно активизирована."), РезультатПоиска.Колонка.Имя, ИмяТаблицы);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка активизации колонки таблицы:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		MCPДополнитьОшибкуПоСостояниюПоляMCP(КолонкаДляПодсказки, ТекстОшибки,
			Ванесса.Локализовать("Ошибка активизации колонки таблицы"),
			Ванесса.Локализовать("Колонка не принимает ввод прямо в ячейку (возможно, значение вводится через отдельный диалог или кнопку выбора). Выберите колонку, принимающую ввод, и не повторяйте действие с этой колонкой."));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для перехода к следующей колонке (TAB)
&НаКлиенте
Функция ПереходКСледующейКолонке(ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'navigate_next_column' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
		ТекЭлементТаблицы1 = Таблица.ПолучитьТекущийЭлемент();
		Ванесса.ВТаблицеЯПерехожуКСледующейЯчейке(ИмяТаблицы);
		ТекЭлементТаблицы2 = Таблица.ПолучитьТекущийЭлемент();
		Если ТекЭлементТаблицы1 <> Неопределено И ТекЭлементТаблицы1.Имя = ТекЭлементТаблицы2.Имя Тогда
			ТекстОшибки = Ванесса.Локализовать("Ошибка перехода к следующей колонке.");
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Выполнен переход к следующей колонке в таблице '%1' (эмуляция TAB)."), ИмяТаблицы);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка перехода к следующей колонке:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для перехода к предыдущей колонке (SHIFT+TAB)
&НаКлиенте
Функция ПереходКПредыдущейКолонке(ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'navigate_previous_column' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
		ТекЭлементТаблицы1 = Таблица.ПолучитьТекущийЭлемент();
		Ванесса.ВТаблицеЯПерехожуКПредыдущейЯчейке(ИмяТаблицы);
		ТекЭлементТаблицы2 = Таблица.ПолучитьТекущийЭлемент();
		Если ТекЭлементТаблицы1 <> Неопределено И ТекЭлементТаблицы1.Имя = ТекЭлементТаблицы2.Имя Тогда
			ТекстОшибки = Ванесса.Локализовать("Ошибка перехода к предыдущей колонке.");
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Выполнен переход к предыдущей колонке в таблице '%1' (эмуляция SHIFT+TAB)."), ИмяТаблицы);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка перехода к предыдущей колонке:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для начала редактирования строки
&НаКлиенте
Функция НачатьРедактированиеСтроки(ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'start_edit_row' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	Таблица = Неопределено;
	
	Попытка
		Таблица = НайтиТаблицуMCP(ИмяТаблицы);
		ТекстОшибкиРежима = ОбеспечитьРежимРедактированияСтрокиMCP(Таблица, ИмяТаблицы);
		Если ЗначениеЗаполнено(ТекстОшибкиРежима) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиРежима);
		КонецЕсли;
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В таблице '%1' строка открыта на редактирование."), ИмяТаблицы);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка начала редактирования строки:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Если Таблица <> Неопределено Тогда
			ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		КонецЕсли;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

