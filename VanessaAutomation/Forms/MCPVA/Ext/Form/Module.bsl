Функция MCPЗакрытьВкладку(Запрос)
	
	Найденная = MCPНайтиВкладкуПоСелектору(Запрос, "close_tab");
	Если НЕ Найденная.Успех Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента(Найденная.Код, Найденная.Текст);
	КонецЕсли;
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона."));
	КонецЕсли;
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
	КонецЕсли;
	
	Сохранять = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "saveChanges", Ложь);
	Описание = Найденная.Описание;
	Вкладка = Неопределено;
	Попытка
		Вкладка = Ванесса.VanessaTabs.tab(Найденная.Индекс);
	Исключение
		Вкладка = Неопределено;
	КонецПопытки;
	Если Вкладка = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Вкладка недоступна."));
	КонецЕсли;
	
	Если Сохранять Тогда
		Если Описание.Вид <> "edit" ИЛИ НЕ ЗначениеЗаполнено(Описание.ИмяФайла) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Сохранять перед закрытием можно только edit-вкладку с файлом."));
		КонецЕсли;
		Попытка
			Если Ванесса.МодульРедакторТекста().ИмяФайлаСоответствуетПустойНовойРедактора(Описание.ИмяФайла) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
					Ванесса.Локализовать("Вкладка не связана с файлом на диске."));
			КонецЕсли;
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		КонецПопытки;
		Попытка
			Ванесса.МодульРедакторТекста().СохранитьИзмененияОднойВкладкиРедактора(Вкладка);
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Не удалось сохранить вкладку:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		КонецПопытки;
		Изменена = Истина;
		Попытка
			Изменена = Ванесса.МодульРедакторТекста().ВкладкаИзмененаРедактора(Вкладка);
		Исключение
			Изменена = Истина;
		КонецПопытки;
		Если Изменена Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("После сохранения вкладка осталась изменённой."));
		КонецЕсли;
	Иначе
		Изменена = Ложь;
		Если Описание.Вид = "edit" Тогда
			Изменена = Истина;
			Попытка
				Изменена = Ванесса.МодульРедакторТекста().ВкладкаИзмененаРедактора(Вкладка);
			Исключение
				Изменена = Истина;
			КонецПопытки;
		КонецЕсли;
		Если Изменена Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Вкладка изменена. Укажите saveChanges=true или сохраните файл вручную."));
		КонецЕсли;
	КонецЕсли;
	
	КоличествоДо = MCPКоличествоВкладок();
	Попытка
		Вкладка.close();
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось закрыть вкладку:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	КоличествоПосле = MCPКоличествоВкладок();
	Если КоличествоДо > 0 И КоличествоПосле >= КоличествоДо Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Вкладка не закрылась."));
	КонецЕсли;
	Предупреждения = Новый Массив;
	Если КоличествоПосле = 0 Тогда
		Попытка
			Ванесса.МодульРедакторТекста().ОбновитьСостояниеПослеЗакрытияВкладокРедактора();
		Исключение
			Предупреждения.Добавить(Ванесса.Локализовать("Не удалось очистить состояние редактора."));
		КонецПопытки;
	Иначе
		Текущая = Неопределено;
		Попытка
			Текущая = Ванесса.VanessaTabs.current;
		Исключение
			Текущая = Неопределено;
		КонецПопытки;
		Если Текущая <> Неопределено Тогда
			Попытка
				Ванесса.МодульРедакторТекста().ПриСменеЗакладкиРедактора(Текущая);
			Исключение
				Предупреждения.Добавить(Ванесса.Локализовать("Не удалось синхронизировать КаталогФич."));
			КонецПопытки;
			ОписаниеТекущей = MCPОписаниеВкладкиБезопасно(Текущая, КоличествоПосле - 1, Истина);
			ТекстПредупреждения = MCPСинхронизироватьКаталогФичСАктивнойВкладкой(ОписаниеТекущей);
			Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
				Предупреждения.Добавить(ТекстПредупреждения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	MCPЗаписатьДиагностикуВкладокБезопасно("Вкладка.Закрытие",
		Новый Структура("Индекс, Файл, Осталось", Найденная.Индекс, Описание.ИмяФайла, КоличествоПосле));
	
	Строки = Новый Массив;
	Строки.Добавить("# Вкладка закрыта");
	Строки.Добавить("");
	Строки.Добавить("- Файл: " + MCPЗначениеДляMarkdown(Описание.ИмяФайла));
	Строки.Добавить("- Осталось вкладок: " + Формат(КоличествоПосле, "ЧГ=0; ЧН=0"));
	Если Предупреждения.Количество() > 0 Тогда
		Строки.Добавить("- Предупреждения:");
		Для Каждого ТекстПредупрежденияСтрокой Из Предупреждения Цикл
			Строки.Добавить("  - " + ТекстПредупрежденияСтрокой);
		КонецЦикла;
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Делегирует действия точек останова существующему обработчику, чтобы не дублировать
// работу с кешем редактора и участниками следующего прогона.
&НаКлиенте
Функция MCPВыполнитьДействиеТочекОстанова(Запрос, Действие)
	
	НовыйЗапрос = Новый Структура;
	НовыйЗапрос.Вставить("Идентификатор", Запрос.Идентификатор);
	Аргументы = Новый Структура;
	Аргументы.Вставить("action", Действие);
	Если Действие = "toggle" И MCPVAСлужебныйМодуль.ПараметрПрисутствуетВЗапросе(Запрос, "line") Тогда
		Аргументы.Вставить("line", MCPVAСлужебныйМодуль.ЗначениеПараметраИзЗапроса(Запрос, "line"));
	КонецЕсли;
	НовыйЗапрос.Вставить("Аргументы", Аргументы);
	Возврат УправлениеТочкамиОстанова(НовыйЗапрос, Неопределено);
	
КонецФункции

// Выбирает и делает сценарий текущим. После этого можно вызывать выполнение текущего сценария
&НаКлиенте
Функция ВыбратьСценарий(Запрос, ДополнительныеПараметры) Экспорт
	
	ИмяСценария = ЗначениеПараметраИзЗапроса(Запрос, "name");
	Если НЕ ЗначениеЗаполнено(ИмяСценария) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не указан обязательный параметр 'name'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;	
	
	// Выбор сценария перезаписывает глобальный ИД: во время загрузки это сорвало бы
	// ожидание готовности дерева и оставило загрузку без ответа
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
	КонецЕсли;
	
	СценарииФичи = Ванесса.ПолучитьИменаСценариевПоТекущейФиче();
	
	Для Каждого ТекСценарий Из СценарииФичи Цикл
		Если НРег(ТекСценарий.Имя) = НРег(ИмяСценария) Тогда
			
			ОшибкаЗанятости = НачатьВыборВРедактореMCP(Запрос);
			Если ОшибкаЗанятости <> Неопределено Тогда
				Возврат ОшибкаЗанятости;
			КонецЕсли;	
			
			Попытка
				Ванесса.СделатьСтрокуДереваТекущейПоНомеруСтрокиФичи(ТекСценарий.НомерСтрокиВФиче);
				СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(ТекСценарий.НомерСтрокиВФиче);
				Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(СтрокаДерева.ИдСтроки, ТекСценарий.НомерСтрокиВФиче);
			Исключение
				//Слот нельзя оставлять занятым: иначе выбор сценария или шага заблокирован навсегда
				ИдентификаторВыбораMCP = Неопределено;
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
					ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
			КонецПопытки;
			
			ПодключитьОбработчикОжидания("ЗавершитьВыборСценария", 0.1, Истина);
			Возврат Неопределено;
		КонецЕсли;	
	КонецЦикла;
	
	ТекстСообщения = Ванесса.Локализовать("Не найден сценарий:") + " " + ИмяСценария;
	Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	
КонецФункции

// Выбирает и делает шаг текущим. После этого можно вызывать выполнение с текущего шага
&НаКлиенте
Функция ВыбратьШаг(Запрос, ДополнительныеПараметры) Экспорт
	
	НомерСтроки = ЗначениеПараметраИзЗапроса(Запрос, "lineNumber");
	Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не указан обязательный параметр 'lineNumber'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;	
	
	// Выбор шага перезаписывает глобальный ИД: во время загрузки это сорвало бы
	// ожидание готовности дерева и оставило загрузку без ответа
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ОшибкаЗанятости = НачатьВыборВРедактореMCP(Запрос);
	Если ОшибкаЗанятости <> Неопределено Тогда
		Возврат ОшибкаЗанятости;
	КонецЕсли;	
	Попытка
		СделатьШагФичиТекущим(НомерСтроки, ИдентификаторВыбораMCP, ТекстОшибки);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ИдентификаторВыбораMCP = Неопределено;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;	
	ПодключитьОбработчикОжидания("ЗавершитьВыборШага", 0.1, Истина);
	
КонецФункции

// Занимает слот выбора в редакторе: одновременно допускается только один выбор.
// Возвращает строку ошибки либо Неопределено, если слот занят этим вызовом.
&НаКлиенте
Функция НачатьВыборВРедактореMCP(Запрос)
	
	Если ЗначениеЗаполнено(ИдентификаторВыбораMCP) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Уже выполняется выбор сценария или шага. Дождитесь ответа."));
	КонецЕсли;	
	
	Идентификатор = "";
	Попытка
		Идентификатор = Запрос.Идентификатор;
	Исключение
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось определить идентификатор запроса MCP."));
	КонецЕсли;	
	
	ИдентификаторВыбораMCP = Идентификатор;
	Возврат Неопределено;
	
КонецФункции

// Вызывается при успешном завершении загрузки фичи/фич
&НаКлиенте
Процедура ОповеститьMCP_ОЗавершенииЗагрузкиФичи(ПутьКФайлу, Тип, ДопПараметрыВызоваMCP, Повтор = Ложь) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	Идентификатор = MCPИдентификаторИзКонтекста(КонтекстMCP);
	// Совместимость: старый путь мог не передавать контекст, тогда ИД берётся из общего слота
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Попытка
			Идентификатор = Ванесса.ПолучитьИдентификаторЗадачиMCP();
		Исключение
		КонецПопытки;
		КонтекстMCP = Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", Идентификатор, Неопределено);
	КонецЕсли;
	Попытка
		MCPЗаписатьСлужебныеДанные("ЗагрузкаФичи.Оповещение", Новый Структура("Тип, Файл, ДеревоГотово, Повтор, Идентификатор",
			Тип, ПутьКФайлу, Ванесса.ФлагСценарииЗагружены, Повтор, Идентификатор));
	Исключение
		// Диагностика не должна мешать обработке оповещения
	КонецПопытки;

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа.
	// Ошибку (например, недопустимый символ XML в тексте проверяемой фичи) надо вернуть вызывающей стороне.
	Попытка

		// Ожидание уже идёт: если пришло оповещение другого вызова, сохранённый вызов нельзя оставлять без ответа
		Если глMCPДедлайнОжиданияЗагрузкиФичи <> Неопределено Тогда
			ТекущийИД = MCPИдентификаторИзКонтекста(КонтекстMCP);
			Если ЗначениеЗаполнено(ТекущийИД) И ТекущийИД <> глMCPИдентификаторЗадачиОжиданияЗагрузки Тогда
				MCPЗавершитьОжиданиеЗагрузкиФичи(Ванесса.Локализовать("Загрузка фичи не завершена: получен новый запрос MCP."), "НовыйЗапрос");
			Иначе
				// Ожидание больше не нужно: обработка продолжается по входящему оповещению.
				// Вызывать процедуру с глобалами ожидания нельзя: сброс обнулил бы фактические
				// параметры (параметры процедур в 1С передаются по ссылке)
				MCPСброситьСостояниеОжиданияЗагрузкиФичи();
			КонецЕсли;	
		КонецЕсли;

		// Гейт готовности дерева: в асинхронной ветке загрузки оповещение приходит до построения дерева,
		// и действия (позиционирование, запуск, проверки) выполняются по устаревшим данным. Ждём готовности.
		Если (Тип = "ЗагрузитьФичуДляВыполненияСценария"
			ИЛИ Тип = "ЗагрузитьФичаФайлИВыполнитьСценарии"
			ИЛИ Тип = "ВыполнитьОдинШагВФичаФайле"
			ИЛИ Тип = "СинтаксКонтроль")
			И НЕ Ванесса.ФлагСценарииЗагружены
			И глMCPДедлайнОжиданияЗагрузкиФичи = Неопределено Тогда
			глMCPИдентификаторЗадачиОжиданияЗагрузки = MCPИдентификаторИзКонтекста(КонтекстMCP);
			глMCPПутьКФайлуОжиданияЗагрузки = ПутьКФайлу;
			глMCPТипОповещенияОЗагрузке = Тип;
			глMCPДопПараметрыОжиданияЗагрузки = ДопПараметрыВызоваMCP;
			// Дедлайн по часам: тик ожидания длится около 0,16 с, число попыток временем не управляет
			глMCPДедлайнОжиданияЗагрузкиФичи = ТекущаяДата() + 60;
			ПодключитьОбработчикОжидания("MCPПовторитьОповещениеОЗагрузкеФичи", 0.1, Истина);
			Возврат;
		КонецЕсли;

		Если Тип = "СинтаксКонтроль" Тогда
			ЗавершитьПроверкуСинтаксиса(ПутьКФайлу, ДопПараметрыВызоваMCP);
		ИначеЕсли Тип = "ОткрытьФичаФайл" Тогда
			ЗавершитьОткрытиеФичаФайла(ПутьКФайлу, КонтекстMCP);
		ИначеЕсли Тип = "ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл" Тогда
			ЗавершитьОткрытьЗагрузитьИлиПерезагрузитьФичаФайл(ПутьКФайлу, ДопПараметрыВызоваMCP);
		ИначеЕсли Тип = "ВыполнитьОдинШагВФичаФайле" Тогда
			ПродолжитьВыполнениеШагаВРедакторе(ПутьКФайлу, ДопПараметрыВызоваMCP);
		ИначеЕсли Тип = "ВыполнитьСценарий" Тогда
			ПродолжитьВыполнитьСценарий1(ПутьКФайлу, ДопПараметрыВызоваMCP);
		ИначеЕсли Тип = "ЗагрузитьФичуДляВыполненияСценария" Тогда
			// Проверяем, есть ли режим после загрузки (для reloadAndRunFromLine)
			Если ДопПараметрыВызоваMCP <> Неопределено И ДопПараметрыВызоваMCP.Свойство("РежимПослеЗагрузки") Тогда
				Если ДопПараметрыВызоваMCP.РежимПослеЗагрузки = "reloadAndRunFromLine" Тогда
					MCPПодготовитьЗапускСоСтроки(ПутьКФайлу, ДопПараметрыВызоваMCP);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			Если ДопПараметрыВызоваMCP = Неопределено Тогда
				// Задача уже завершилась (состояние сброшено) — продолжать нечего
				Возврат;
			КонецЕсли;
			ПродолжитьВыполнитьСценарий2(ПутьКФайлу, ДопПараметрыВызоваMCP, "ОповещениеЗагрузки");
		ИначеЕсли Тип = "ЗагрузитьФичаФайлИВыполнитьСценарии" Тогда
			Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
			Если Проблемы.Количество() > 0 Тогда
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
				Возврат;
			КонецЕсли;
			// Пока фича загружалась, прогон мог начать другой источник: команда запуска молча ничего не сделает
			Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED",
					Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона."));
				Возврат;
			КонецЕсли;	
			// Несохранённый буфер (например, вкладку перезагружали из дисковой версии) на диск не сохраняем
			ТекстОтказаНесохранённой = MCPТекстОтказаНесохранённойВкладки(ПутьКФайлу);
			Если ЗначениеЗаполнено(ТекстОтказаНесохранённой) Тогда
				ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстОтказаНесохранённой);
				Возврат;
			КонецЕсли;	
			Ванесса.КомандаВыполнитьСценарии();
		Иначе
			ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP после загрузки фичи <%1>"), Тип);
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;	

	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка при обработке результата загрузки фичи:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		// Ошибка проверки синтаксиса не отменяет загрузку: вкладку не закрываем,
		// а фактическое состояние редактора добавляем в текст ошибки.
		Если Тип = "СинтаксКонтроль" Тогда
			Попытка
				ТекстСообщения = MCPТекстОшибкиПроверкиСинтаксисаСТечением(ТекстСообщения, ДопПараметрыВызоваMCP, ПутьКФайлу, "Исключение");
			Исключение
				// Ошибка диагностики не должна оставлять вызов MCP без ответа
				Попытка
					MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.ОшибкаДиагностики", Новый Структура("Текст", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки())));
				Исключение
				КонецПопытки;
				ТекстСообщения = ТекстСообщения + Символы.ПС + Ванесса.Локализовать("Не удалось получить состояние вкладок редактора.");
			КонецПопытки;
		КонецЕсли;	
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(MCPИдентификаторИзКонтекста(КонтекстMCP), "ACTION_FAILED", ТекстСообщения);
	КонецПопытки;

КонецПроцедуры

// Дожидается готовности дерева фич после MCP-инициированной загрузки и повторяет обработку оповещения
&НаКлиенте
Процедура MCPПовторитьОповещениеОЗагрузкеФичи()
	
	// Страховка от устаревшего тика: состояние ожидания уже сброшено другим путём
	Если глMCPДедлайнОжиданияЗагрузкиФичи = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	// Новый запрос во время ожидания обрабатывает ОповеститьMCP_ОЗавершенииЗагрузкиФичи
	// по контексту входящего оповещения: общего ИД, по которому раньше сравнивались запросы, больше нет
	
	Если НЕ Ванесса.ФлагСценарииЗагружены И ТекущаяДата() < глMCPДедлайнОжиданияЗагрузкиФичи Тогда
		ПодключитьОбработчикОжидания("MCPПовторитьОповещениеОЗагрузкеФичи", 0.1, Истина);
		Возврат;
	КонецЕсли;	
	
	Если НЕ Ванесса.ФлагСценарииЗагружены Тогда
		MCPЗавершитьОжиданиеЗагрузкиФичи(Ванесса.Локализовать("Фича не была загружена за отведённое время."), "Таймаут");
		Возврат;
	КонецЕсли;	
	
	// Повторный вход в гейт: флаг уже Истина, ожидание не запустится.
	// Состояние сбрасываем до вызова, а параметры передаём через локальные переменные:
	// сброс обнуляет глобалы, а фактические параметры связаны с ними по ссылке
	ПутьКФайлуОбработки = глMCPПутьКФайлуОжиданияЗагрузки;
	ТипОбработки = глMCPТипОповещенияОЗагрузке;
	ПараметрыОбработки = глMCPДопПараметрыОжиданияЗагрузки;
	MCPСброситьСостояниеОжиданияЗагрузкиФичи();
	ОповеститьMCP_ОЗавершенииЗагрузкиФичи(ПутьКФайлуОбработки, ТипОбработки, ПараметрыОбработки, Истина);
	
КонецПроцедуры

// Завершает сохранённый вызов загрузки фичи ошибкой и очищает состояние ожидания готовности дерева
&НаКлиенте
Процедура MCPЗавершитьОжиданиеЗагрузкиФичи(ТекстОшибки, Причина = "")

	MCPЗаписатьСлужебныеДанные("ЗагрузкаФичи.ОжиданиеПрервано", Новый Структура("Причина, Файл, Тип, Идентификатор",
		Причина, глMCPПутьКФайлуОжиданияЗагрузки, глMCPТипОповещенияОЗагрузке, глMCPИдентификаторЗадачиОжиданияЗагрузки));
	
	ТекстОшибкиИтог = ТекстОшибки;
	Если глMCPТипОповещенияОЗагрузке = "СинтаксКонтроль" Тогда
		Попытка
			// При новом запросе каталог уже мог быть переключён на его файл: не откатываем
			ТекстОшибкиИтог = MCPТекстОшибкиПроверкиСинтаксисаСТечением(ТекстОшибки, глMCPДопПараметрыОжиданияЗагрузки, глMCPПутьКФайлуОжиданияЗагрузки, Причина, Причина <> "НовыйЗапрос");
		Исключение
			// Ошибка диагностики не должна оставлять ожидающий вызов без ответа
			Попытка
				MCPЗаписатьСлужебныеДанные("СинтаксКонтроль.ОшибкаДиагностики", Новый Структура("Текст", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки())));
			Исключение
			КонецПопытки;
			ТекстОшибкиИтог = ТекстОшибки;
		КонецПопытки;
	КонецЕсли;

	// Идентификатор мог не сохраниться (ожидание без активного вызова MCP): тогда отвечать нечему
	Если ЗначениеЗаполнено(глMCPИдентификаторЗадачиОжиданияЗагрузки) Тогда
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(глMCPИдентификаторЗадачиОжиданияЗагрузки, "ACTION_FAILED", ТекстОшибкиИтог);
	КонецЕсли;	
	MCPСброситьСостояниеОжиданияЗагрузкиФичи();
	
КонецПроцедуры

// Очищает сохранённое состояние ожидания готовности дерева
&НаКлиенте
Процедура MCPСброситьСостояниеОжиданияЗагрузкиФичи()
	
	Попытка
		// Снимаем запланированный тик повторителя: иначе он сработает по уже сброшенному состоянию
		ОтключитьОбработчикОжидания("MCPПовторитьОповещениеОЗагрузкеФичи");
	Исключение
	КонецПопытки;
	
	глMCPИдентификаторЗадачиОжиданияЗагрузки = Неопределено;
	глMCPПутьКФайлуОжиданияЗагрузки = Неопределено;
	глMCPТипОповещенияОЗагрузке = Неопределено;
	глMCPДопПараметрыОжиданияЗагрузки = Неопределено;
	глMCPДедлайнОжиданияЗагрузкиФичи = Неопределено;
	
КонецПроцедуры

// Вызывается при успешном завершении выполнения одной строки фичи
&НаКлиенте
Функция ОповеститьMCP_ОУспешномЗавершенииВыполненияОднойСтрокиФичи(Тип, ДопПараметрыВызоваMCP) Экспорт
	
	Если Тип = "ВыполнитьОдинШагВФичаФайле" Тогда
		ЗавершитьУспешноеВыполнениеШагаВРедакторе(ДопПараметрыВызоваMCP);
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP после выполнения одной строки фичи <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецФункции

// Вызывается при окончании выполнения сценариев
&НаКлиенте
Функция ОповеститьMCP_ОЗавершенииВыполненияСценариев(Тип, ДопПараметрыВызоваMCP) Экспорт
	
	Если Тип = "selected" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "all" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "reloadAndRun" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "reloadAndRunFromLine" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	ИначеЕсли Тип = "fromCurrentStep" Тогда
		ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP);
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP при завершении выполнения сценариев <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецФункции

// Вызывается при ошибке при выполнении одной строки фичи
&НаКлиенте
Функция ОповеститьMCP_ОбОшибкеПриВыполненияОднойСтрокиФичи(Тип, ДопПараметрыВызоваMCP, РезультатПрохожденияШага) Экспорт
	
	Если Тип = "ВыполнитьОдинШагВФичаФайле" Тогда
		ЗавершитьВыполнениеШагаВРедактореСОшибкой(ДопПараметрыВызоваMCP, РезультатПрохожденияШага);
	Иначе
		ТекстИсключения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не известный тип оповещения MCP <%1>"), Тип);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
КонецФункции

// Вызывается при ошибке выполнения выделенного сценария
&НаКлиенте
Функция ОповеститьMCP_ОбОшибкеВыполненияВыделенногоСценария(ДопПараметрыВызоваMCP, ТекстОшибки) Экспорт
	
	// Отказ запуска должен возвращаться ошибкой, а не успешным ответом с текстом
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	
КонецФункции

// Вызывается при завершении выполнения шага строкой в MCPИнструментВыполнитьОдинШагТекстом
&НаКлиенте
Процедура ЗавершениеВыполнениеШагаИзСтроки(КонтекстMCP = Неопределено) Экспорт
	
	Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
	
	ТекстСообщения = Ванесса.Локализовать("Шаг выполнен успешно");
	Если ТипЗнч(КонтекстMCP) = Тип("Структура") Тогда
		MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстСообщения);
		Возврат;
	КонецЕсли;	
	
	// Совместимость: старый путь без контекста отвечает по общему слоту.
	// Пустой ИД не отправляем молча: иначе вызов останется без ответа и без записи в ЖР.
	Идентификатор = Ванесса.ПолучитьИдентификаторЗадачиMCP();
	КонтекстСовместимости = Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", Идентификатор, Неопределено);
	MCPЗавершитьВызовУспешно(КонтекстСовместимости, ТекстСообщения);
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
	КонецЕсли;	
	
КонецПроцедуры

