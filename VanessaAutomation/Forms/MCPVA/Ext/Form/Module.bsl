		Возврат;
	КонецЕсли;
	
	Если ТабПарам = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ТабПарам.Количество() <> 2 Тогда
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
