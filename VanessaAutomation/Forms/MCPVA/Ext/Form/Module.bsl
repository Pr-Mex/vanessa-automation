// Возвращает текст ошибки, если файл фичи не найден (принимает полный путь или путь от каталога проекта), иначе пустую строку
&НаКлиенте
Функция MCPТекстОшибкиФайлаФичиНеНайден(ПутьКФайлу)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат Ванесса.Локализовать("Не указан путь к фича файлу.");
	КонецЕсли;	
	
	Если Ванесса.ФайлСуществуетКомандаСистемы(ПутьКФайлу) Тогда
		Возврат "";
	КонецЕсли;	
	
	ПолныйПутьКФайлуВКаталогеПроекта = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + ПутьКФайлу;
	Если Не Ванесса.ЭтоLinux Тогда
		// Относительный путь мог прийти с "/": в диагностике не должно быть смеси разделителей
		ПолныйПутьКФайлуВКаталогеПроекта = СтрЗаменить(ПолныйПутьКФайлуВКаталогеПроекта, "/", "\");
	КонецЕсли;	
	Если Ванесса.ФайлСуществуетКомандаСистемы(ПолныйПутьКФайлуВКаталогеПроекта) Тогда
		Возврат "";
	КонецЕсли;	
	
	ТекстОшибки = Ванесса.Локализовать("Файл <%1> не был найден.");
	Если НЕ Ванесса.ЭтоLinux И Найти(ПутьКФайлу, ":") = 0 Тогда
		ТекстОшибки = Ванесса.Локализовать("Файл <%1> не был найден. В каталоге проекта файл <%2> тоже не был найден. Видимо был передан относительный путь, попробуйте передать полный путь к файлу.");
	КонецЕсли;	
	
	Возврат Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибки, ПутьКФайлу, ПолныйПутьКФайлуВКаталогеПроекта);
	
КонецФункции

// Разворачивает относительный путь к фича файлу или каталогу в полный путь от каталога проекта.
// Пустой путь не меняется (означает "текущий файл"); при непустом тексте ошибки возвращённый путь использовать нельзя
&НаКлиенте
Функция MCPНормализоватьПутьКФичам(ПутьКФайлу, ТекстОшибки)
	
	ТекстОшибки = "";
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат ПутьКФайлу;
	КонецЕсли;	
	
	Кандидат = ПутьКФайлу;
	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(Кандидат) Тогда
		Кандидат = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + ПутьКФайлу;
	КонецЕсли;	
	
	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(Кандидат) Тогда
		ТекстОшибки = MCPТекстОшибкиФайлаФичиНеНайден(ПутьКФайлу);
		Возврат ПутьКФайлу;
	КонецЕсли;	
	
	Попытка
		НормализованныйПуть = Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Строка(Кандидат));
	Исключение
		НормализованныйПуть = Кандидат;
	КонецПопытки;
	
	Если НЕ Ванесса.ЭтоLinux Тогда
		// Путь мог быть собран из каталога проекта ("\") и относительного пути с "/"
		НормализованныйПуть = СтрЗаменить(НормализованныйПуть, "/", "\");
	КонецЕсли;	
	
	Возврат НормализованныйПуть;
	
КонецФункции

&НаКлиенте
Процедура MCPOpenFeatureFileВРедакторе(ИмяФайла, ТипВызова, ДопПараметрыВызоваMCP = Неопределено, ИдентификаторВызова = Неопределено)
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметрыВызоваMCP);
	Если НЕ ЗначениеЗаполнено(MCPИдентификаторИзКонтекста(КонтекстMCP)) Тогда
		КонтекстMCP = Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", ИдентификаторВызова, Неопределено);
	КонецЕсли;
	
	// Загрузка фичи сбрасывает состояние прогона (ЗагрузитьФичи), поэтому во время прогона
	// инструменты, которым нужна загрузка, отказывают, а не прерывают чужой прогон.
	// Отвечаем по ИД входящего вызова, не трогая флаги ожидания: они принадлежат прогону
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		MCPОтветитьОтказомБезСбросаПрогона(ИдентификаторВызова, "ACTION_FAILED",
			Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона или вызовите stop_scenario."));
		Возврат;
	КонецЕсли;	
	
	// Единая точка всех инициаторов загрузки: не даём второй загрузке перезаписать
	// глобальный ИД, флаг и ДопПараметрыВызоваMCP первой
	Если MCPЗагрузкаФичиНеЗавершена() Тогда
		Если ЗначениеЗаполнено(ИдентификаторВызова) Тогда
			MCPОтветитьОтказомБезСбросаПрогона(ИдентификаторВызова, "ACTION_FAILED",
				Ванесса.Локализовать("Дождитесь завершения предыдущей загрузки или проверки фичи."));
		Иначе
			MCPЗаписатьСлужебныеДанные("ЗагрузкаФичи.ОтказБезИД", Новый Структура("Тип, Файл", ТипВызова, ИмяФайла));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", "Vanessa Editor отключён в настройках Vanessa Automation.");
		Возврат;
	КонецЕсли;
	
	Если Ванесса.VanessaTabs = Неопределено Тогда
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", Ванесса.Локализовать("Редактор Vanessa Editor не инициализирован."));
		Возврат;
	КонецЕсли;
	
	// Загрузка читает файл с диска и заменяет содержимое вкладки: несохранённый буфер
	// потерялся бы молча. Проверяем именно целевой файл, а не только активную вкладку
	ТекстОтказаНесохранённой = MCPТекстОтказаНесохранённойВкладки(ИмяФайла);
	Если ЗначениеЗаполнено(ТекстОтказаНесохранённой) Тогда
		MCPОтветитьОтказомБезСбросаПрогона(ИдентификаторВызова, "ACTION_FAILED", ТекстОтказаНесохранённой);
		Возврат;
	КонецЕсли;	
	
	Если ДопПараметрыВызоваMCP <> Неопределено Тогда
		// Собираем до активации: после select активной уже будет целевая вкладка
		ДопПараметрыВызоваMCP.Вставить("ВкладкаБылаОткрыта", MCPВкладкаСФайлом(ИмяФайла));
		ДопПараметрыВызоваMCP.Вставить("ВкладкаБылаОткрытаВРедакторе", MCPВкладкаСФайломВРедакторе(ИмяФайла));
	КонецЕсли;
	
	Если Ванесса.МодульРедакторТекста().СуществуетВкладкаСФайлом(ИмяФайла) Тогда
		Ванесса.МодульРедакторТекста().АктивизироватьВкладкуПоИмениФайла(ИмяФайла);
	КонецЕсли;
	
	MCPЗаписатьСлужебныеДанные("ЗагрузкаФичи.Старт", Новый Структура("Тип, Файл, Идентификатор", ТипВызова, ИмяФайла, ИдентификаторВызова));

	Ванесса.Объект.КаталогФич = ИмяФайла;
	Ванесса.УстановитьФлагОповеститьMCPСерверПослеЗагрузкиФичи(ТипВызова, ИдентификаторОтвета);
	ДопПараметры = Неопределено;
	Если ДопПараметрыВызоваMCP <> Неопределено Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ДопПараметрыВызоваMCP", ДопПараметрыВызоваMCP);
	КонецЕсли;	
	Попытка
		Ванесса.ЗагрузитьФичи(ДопПараметры);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		// Исключение до ЗагрузитьФичиПродолжение не снимает флаг загрузки: без очистки
		// редактор останется заблокированным для MCP до перезапуска
		Попытка
			Ванесса.УстановитьФлагОповеститьMCPСерверПослеЗагрузкиФичи(Неопределено);
		Исключение
		КонецПопытки;
		MCPЗаписатьСлужебныеДанные("ЗагрузкаФичи.Исключение", Новый Структура("Тип, Файл, Идентификатор, Текст",
			ТипВызова, ИмяФайла, ИдентификаторОтвета, ТекстОшибки));
		// Отвечаем здесь, не полагаясь на перехват исключения верхним уровнем MCP:
		// иначе вызов останется без ответа, хотя флаг уже снят
		ЗавершитьВызовИнструментаСОшибкойИСброситьСостояниеMCP(ИдентификаторОтвета, "ACTION_FAILED", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	// Контекст вызова вернётся в этот модуль после загрузки фичи в метод ОповеститьMCP_ОЗавершенииЗагрузкиФичи
	
КонецПроцедуры

