// Внутренняя функция для начала редактирования строки
&НаКлиенте
Функция НачатьРедактированиеСтроки(ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'start_edit_row' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
		Если Таблица = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' не найдена."), ИмяТаблицы);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		// Начало редактирования строки
		Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
			Таблица.ИзменитьСтроку();
		Иначе	
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' уже в режиме редактирования."), ИмяТаблицы);
		КонецЕсли;
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В таблице '%1' начато редактирование строки."), ИмяТаблицы);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка начала редактирования строки:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

