&НаКлиенте
Процедура ПродолжитьВыполнениеШагаВРедакторе(ПутьКФайлу, ДопПараметрыВызоваMCP)
	
	// Проверяем что файл действительно открыт
	ТекущийФайл = MCPТекущийФайлРедактора();
	Если НРег(ТекущийФайл) <> НРег(ПутьКФайлу) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не удалось активировать вкладку файла:") + " " + ПутьКФайлу;
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
	ПолныйТекст = ЭкземплярVanessaEditor.getContent();
	
	НомерСтроки = ДопПараметрыВызоваMCP.НомерСтроки;
	КоличествоСтрок = Ванесса._СтрРазделить(ПолныйТекст, Символы.ПС).Количество();
	Если НомерСтроки > КоличествоСтрок Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Строка %1 выходит за пределы файла (%2 строк): %3"),
				НомерСтроки, КоличествоСтрок, ПутьКФайлу);
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	
	СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
	Если СтрокаДерева = Неопределено Тогда
		ТекстСтроки = ЭкземплярVanessaEditor.getLineContent(НомерСтроки);
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("По строке %1 не получилось найти исполнимую строку фича файла.
		|Текст в строке: %2
		|Имя файла: %3"),
				НомерСтроки, ТекстСтроки, ПутьКФайлу);
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;	
	Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(СтрокаДерева.ИдСтроки, НомерСтроки);
	
	// Запускаем обработчик ожидания, чтобы редактор смог обновиться и перейти к нужной строке
	глДопПараметрыВызоваMCP = ДопПараметрыВызоваMCP;
	ПодключитьОбработчикОжидания("ПослеСделатьПереходКТекстуВРедакторе", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыполнитьСценарий1(ПутьКФайлу, ДопПараметрыВызоваMCP)
	
	// Обеспечить наличие активной вкладки .feature в VanessaEditor
	// (без неё КомандаВыполнитьСценарии/ВыполнитьВыделенныйСценарий молча завершаются)
	Если Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		МСПНадоОткрытьФайл = Ложь;
		Если Ванесса.VanessaTabs = Неопределено ИЛИ Ванесса.VanessaTabs.current = Неопределено Тогда
			МСПНадоОткрытьФайл = Истина;
		ИначеЕсли НЕ Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current) Тогда
			МСПНадоОткрытьФайл = Истина;
		ИначеЕсли (НРег(Ванесса.Объект.КаталогФич) <> НРег(ПутьКФайлу)) И ЗначениеЗаполнено(ПутьКФайлу) Тогда
			МСПНадоОткрытьФайл = Истина;
		КонецЕсли;
		
		Если МСПНадоОткрытьФайл Тогда
			Ванесса.Объект.КаталогФич = ПутьКФайлу;
			ФайлВРедакторе = Ванесса.Объект.КаталогФич;
			Если ЗначениеЗаполнено(ФайлВРедакторе) И Прав(НРег(СокрЛП(ФайлВРедакторе)), 8) = ".feature" Тогда
				Попытка
					MCPOpenFeatureFileВРедакторе(ФайлВРедакторе, "ЗагрузитьФичуДляВыполненияСценария")
				Исключение
					ТекстСообщения = Ванесса.Локализовать("Не удалось открыть файл в редакторе:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
					МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
					Возврат;
				КонецПопытки;
			Иначе
				ТекстСообщения = Ванесса.Локализовать("Нет активного .feature файла в редакторе. Используйте параметр filePath, или сначала загрузите фичу через load_features(path='путь/к/файлу.feature') и openFeatureFile.");
				МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПродолжитьВыполнитьСценарий2(ПутьКФайлу, ДопПараметрыВызоваMCP);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыполнитьСценарий2(ПутьКФайлу, ДопПараметрыВызоваMCP)
	
	MCPОжиданиеВыполненияСценария = Истина;
	Режим = ДопПараметрыВызоваMCP.Режим;
	
	Попытка
		
		Идентификатор = ДопПараметрыВызоваMCP.Идентификатор;
		Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
		Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Режим, ДопПараметрыВызоваMCP);
		// Вызов вернётся в ОповеститьMCP_ОЗавершенииВыполненияСценариев
		
		Если Режим = "selected" Тогда
			ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
			ПозицияVanessaEditor = ЭкземплярVanessaEditor.getPosition();
			ТекНомерСтроки = ПозицияVanessaEditor.lineNumber;
			
			СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(ТекНомерСтроки);
			Если СтрокаДерева = Неопределено Тогда
				ТекстСообщения = Ванесса.Локализовать("Не найдена строка внутреннего дерева по номеру строки фичи:") + ТекНомерСтроки;
				МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;	
			
			Ванесса.ВыполнитьВыделенныйСценарий();
		ИначеЕсли Режим = "all" Тогда
			Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
			Если Проблемы.Количество() > 0 Тогда
				МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
				Возврат;
			КонецЕсли;
			
			Ванесса.КомандаВыполнитьСценарии();
		ИначеЕсли Режим = "reloadAndRun" Тогда
			//Ванесса.ПерезагрузитьИВыполнитьДанныйСценарий();
			Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
				ТекстОшибки = Неопределено;
				ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
					Возврат;
				КонецЕсли;
			КонецЕсли;	
			
			ДопПараметрыВызоваMCP = Новый Структура;
			ДопПараметрыВызоваMCP.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
			ДопПараметрыВызоваMCP.Вставить("ЗапуститьВсеСценарииПослеЗагрузки", Истина);
			MCPOpenFeatureFileВРедакторе(ПутьКФайлу, "ЗагрузитьФичаФайлИВыполнитьСценарии", ДопПараметрыВызоваMCP);
			
		ИначеЕсли Режим = "fromCurrentStep" Тогда
			Проблемы = Ванесса.ПолучитьПроблемыПоТекущейФиче();
			Если Проблемы.Количество() > 0 Тогда
				МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ОшибкаПроверкиСинтаксиса(Проблемы));
				Возврат;
			КонецЕсли;
			
			Ванесса.ВыполнитьДанныйСценарийСТекущегоШага();
		ИначеЕсли Режим = "reloadAndRunFromLine" Тогда
			// Получаем номер строки из параметров
			НомерСтроки = ДопПараметрыВызоваMCP.НомерСтроки;
			Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
				ТекстСообщения = Ванесса.Локализовать("Для режима reloadAndRunFromLine необходимо указать параметр lineNumber.");
				МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
				Возврат;
			КонецЕсли;	
			
			// Сначала загружаем фича файл
			Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
				ТекстОшибки = Неопределено;
				ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
					Возврат;
				КонецЕсли;
			КонецЕсли;	
			
			// Сохраняем номер строки в доп параметрах для последующего использования
			ДопПараметрыЗагрузки = Новый Структура;
			ДопПараметрыЗагрузки.Вставить("ИсходныйПутьКФайлу", ПутьКФайлу);
			ДопПараметрыЗагрузки.Вставить("НомерСтроки", НомерСтроки);
			ДопПараметрыЗагрузки.Вставить("РежимПослеЗагрузки", "reloadAndRunFromLine");
			MCPOpenFeatureFileВРедакторе(ПутьКФайлу, "ЗагрузитьФичуДляВыполненияСценария", ДопПараметрыЗагрузки);
			Возврат;
		Иначе
			MCPОжиданиеВыполненияСценария = Ложь;
			ТекстСообщения = Ванесса.Локализовать("Неизвестный режим:") + " " + Режим + Ванесса.Локализовать(". Допустимые: selected, all, reloadAndRun, fromCurrentStep, reloadAndRunFromLine.");
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;
		
	Исключение
		MCPОжиданиеВыполненияСценария = Ложь;
		ТекстСообщения = Ванесса.Локализовать("Ошибка запуска:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыполненияСценария(Тип, ДопПараметрыВызоваMCP)
	
	МассивРезультатПрохожденияТестовСценария = Ванесса.ПолучитьМассивРезультатПрохожденияТестовСценария();
	БылиОшибки = Ложь;
	Для Каждого ДанныеСценария Из МассивРезультатПрохожденияТестовСценария Цикл
		Если ДанныеСценария.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(ДанныеСценария.ОписаниеОшибки) Тогда
			БылиОшибки = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	МассивСтрок = Новый Массив;
	Если БылиОшибки Тогда
		ТекстСтроки = Ванесса.Локализовать("## Результат выполнения сценариев: были ошибки");
	Иначе	
		ТекстСтроки = Ванесса.Локализовать("## Результат выполнения сценариев: все сценарии выполнены успешно");
	КонецЕсли;	
	МассивСтрок.Добавить(ТекстСтроки);
	МассивСтрок.Добавить("");
	
	НадоСнятьСкриншот = Ложь;
	
	Для Каждого ДанныеСценария Из МассивРезультатПрохожденияТестовСценария Цикл
		СтрокаСценария = Ванесса.СтрокаДереваПоИдСтроки(ДанныеСценария.ИДСтроки);
		
		ТекстСтроки = Ванесса.Локализовать("Имя сценария:" + " " + СтрокаСценария.Имя);
		МассивСтрок.Добавить(ТекстСтроки);
		Если ДанныеСценария.Свойство("Статус") Тогда
			ТекстСтроки = Ванесса.Локализовать("Результат прохождения сценария:") + " " + ДанныеСценария.Статус;
		КонецЕсли;	
		МассивСтрок.Добавить(ТекстСтроки);
		
		НомерСтрокиВФиче = Неопределено;
		
		Если ДанныеСценария.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(ДанныеСценария.ОписаниеОшибки) Тогда
			БылиОшибки = Истина;
			
			Если ДанныеСценария.Свойство("ДанныеДляФормированияJsonОбОшибке") Тогда
				СтрокаУпавшегоШага = Ванесса.СтрокаДереваПоИдСтроки(ДанныеСценария.ДанныеДляФормированияJsonОбОшибке.ИДСтрокиУпавшегоШага);
				ТекстСтроки = Ванесса.Локализовать("Текст упавшего шага:") + " " + СтрокаУпавшегоШага.Имя;
				МассивСтрок.Добавить(ТекстСтроки);
				ТекстСтроки = Ванесса.Локализовать("Статус упавшего шага:") + " " + СтрокаУпавшегоШага.Статус;
				МассивСтрок.Добавить(ТекстСтроки);
				ТекстСтроки = Ванесса.Локализовать("Номер строки упавшего шага в feature файле:") + " " + XMLСтрока(СтрокаУпавшегоШага.НомерСтрокиВФиче);
				МассивСтрок.Добавить(ТекстСтроки);
				ТекстСтроки = Ванесса.Локализовать("Текст ошибки:") + " " + ДанныеСценария.ДанныеДляФормированияJsonОбОшибке.ОписаниеОшибкиКратко;
				МассивСтрок.Добавить(ТекстСтроки);
				
				НомерСтрокиВФиче = СтрокаУпавшегоШага.НомерСтрокиВФиче;
			Иначе
				ТекстСтроки = Ванесса.Локализовать("Текст ошибки:") + " " + ДанныеСценария.ОписаниеОшибки;
				МассивСтрок.Добавить(ТекстСтроки);
			КонецЕсли;	
			
			ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
			
			МассивСтрок.Добавить("");
			МассивСтрок.Добавить("");
			
			Если НомерСтрокиВФиче <> Неопределено Тогда
				ОбновитьКешДанныхУпавшегоШагаИСказатьИИСнятьСкриншот(НомерСтрокиВФиче, МассивСтрок, НадоСнятьСкриншот);
			КонецЕсли;
			
			Если ДляШагаНадоВсегдаСниматьСкриншот(СтрокаУпавшегоШага) Тогда
				НадоСнятьСкриншот = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НадоСнятьСкриншот Тогда
		СнятьСкриншотыОконКлиентаТестированияИОтправитьИхИИДляАнализаПослеВыполненияСценария(МассивСтрок);
	КонецЕсли;
	
	МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), Ванесса._СтрСоединить(МассивСтрок, Символы.ПС));
	Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
	Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Неопределено, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПослеСделатьПереходКТекстуВРедакторе()
	НомерСтроки = глДопПараметрыВызоваMCP.НомерСтроки;
	ПутьКФайлу = глДопПараметрыВызоваMCP.ПутьКФайлу;
	
	ЭкземплярVanessaEditor = Ванесса.ПолучитьVanessaEditor();
	ТекстСтроки = ЭкземплярVanessaEditor.getLineContent(НомерСтроки);
	
	Если НЕ ЗначениеЗаполнено(ТекстСтроки) Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Строка %1 пуста в файле: %2"),
				НомерСтроки, ПутьКФайлу);
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Ванесса.УстановитьФлагОповеститьMCPСерверПослеВыполненияОднойСтрокиФичи(глДопПараметрыВызоваMCP.Тип);
	Ванесса.ВыполнитьОдинШаг();
	
	// Вызов вернётся в ОповеститьMCP_ОЗавершенииВыполненияОднойСтрокиФичи
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьУспешноеВыполнениеШагаВРедакторе(ДопПараметрыВызоваMCP)
	ТекстСообщения = Ванесса.Локализовать("Шаг в строке фича файла успешно выполнен");
	МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), ТекстСообщения);
	Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыполнениеШагаВРедактореСОшибкой(ДопПараметрыВызоваMCP, РезультатПрохожденияШага)
	ТекстСообщения = ТекстОшибкиИзОписанияОшибки(РезультатПрохожденияШага.ОписаниеОшибки);
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(ТекстСообщения);
	ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
	
	МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), Ванесса._СтрСоединить(МассивСтрок, Символы.ПС));
	Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеФичаФайлаВРедакторе(ПутьКФайлу, Запрос, ТипВызова, ДопПараметрыВызоваMCP = Неопределено)
	
	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ПутьКФайлу) Тогда
			
			ПолныйПутьКФайлуВКаталогеПроекта = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + ПутьКФайлу;
			Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ПолныйПутьКФайлуВКаталогеПроекта) Тогда
				МодульМсп_Сервер = МодульМсп_Сервер();
				ТекстОшибки = Ванесса.Локализовать("Файл <%1> не был найден.");
				Если НЕ Ванесса.ЭтоLinux И Найти(ПутьКФайлу, ":") = 0 Тогда
					ТекстОшибки = Ванесса.Локализовать("Файл <%1> не был найден. В каталоге проекта файл <%2> тоже не был найден. Видимо был передан относительный путь, попробуйте передать полный путь к файлу.");
				КонецЕсли;
				
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибки, ПутьКФайлу, ПолныйПутьКФайлуВКаталогеПроекта);
				МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Запрос.Идентификатор, "INVALID_PARAMS", ТекстОшибки);
				Возврат;
			Иначе
				ПутьКФайлу = ПолныйПутьКФайлуВКаталогеПроекта;
			КонецЕсли;	
			
		КонецЕсли;	
		ПутьКФайлу = MCPНормализоватьПутьКФичаФайлу(ПутьКФайлу);
		
		МодульМсп_Сервер = МодульМсп_Сервер();
		Идентификатор = Запрос.Идентификатор;
		Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
		МодульМсп_Сервер.УведомитьОПрогрессе(Идентификатор, 0, 3, Ванесса.Локализовать("Загрузка feature файла."));
		
		MCPOpenFeatureFileВРедакторе(ПутьКФайлу, ТипВызова, ДопПараметрыВызоваMCP);
	Иначе
		ТекстОшибки = Ванесса.Локализовать("Не передан путь к файлу.");
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Запрос.Идентификатор, "INVALID_PARAMS", ТекстОшибки);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстОшибкиИзОписанияОшибки(Знач Стр)
	СтрКраткая = Ванесса.УбратьТехническиеДанныеИзСтроки(Стр);
	Если ЗначениеЗаполнено(СтрКраткая) Тогда
		Возврат СтрКраткая;
	КонецЕсли;
	Возврат Стр;
КонецФункции	

&НаКлиенте
Процедура MCPДанныеИсследователяФормы(ИдентификаторЗапроса, ФорматВывода)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Язык", Ванесса.Объект.ЯзыкГенератораGherkin);
	ПараметрыФормы.Вставить("ТекущийTestclientЭтоWebКлиент", Ванесса.ТекущийTestclientЭтоWebКлиент);
	ПараметрыФормы.Вставить("ВладелецУникальныйИдентификатор", УникальныйИдентификатор);
	ПараметрыФормы.Вставить("MCPРежимЧтенияФормы", Истина);
	ПараметрыФормы.Вставить("MCPФорматЧтенияФормы", ФорматВывода);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("MCPИдентификаторЗапроса", ИдентификаторЗапроса);
	ДополнительныеПараметры.Вставить("MCPФорматВывода", ФорматВывода);
	
	Ванесса.УстановитьИдентификаторЗадачиMCP(ИдентификаторЗапроса);
	
	//ОписаниеОповещения = Новый ОписаниеОповещения("MCPПолученАнализФормы", ЭтаФорма, ДополнительныеПараметры);
	//ОткрытьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.ИсследовательФормы", ПараметрыФормы, Ванесса, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИсследовательФормы = ПолучитьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.ИсследовательФормы",ПараметрыФормы,Ванесса);
	Данные = ИсследовательФормы.MCPПолучитьРезультатЧтенияФормы(ПараметрыФормы);
	
	ДеревоЭлементов = "";
	ШагиТекущегоЭлемента = "";
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство("treeText") Тогда
			ДеревоЭлементов = MCPПредставлениеЗначенияДляMarkdown(Данные.treeText);
		КонецЕсли;
		Если Данные.Свойство("stepText") Тогда
			ШагиТекущегоЭлемента = MCPПредставлениеЗначенияДляMarkdown(Данные.stepText);
		КонецЕсли;
	ИначеЕсли Данные <> Неопределено Тогда
		ТекстСообщения = Ванесса.Локализовать("Ошибка чтения результата анализа формы: неожиданный тип результата") + " " + Строка(ТипЗнч(Данные));
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Анализ текущей формы"));
	Строки.Добавить("");
	
	Если ФорматВывода = "full" Тогда
		Попытка
			Ванесса.ПолучитьИзмененияФормыGherkin();
			Gherkin = Ванесса.Объект.СгенерированныйСценарий;
			Если ЗначениеЗаполнено(Gherkin) Тогда
