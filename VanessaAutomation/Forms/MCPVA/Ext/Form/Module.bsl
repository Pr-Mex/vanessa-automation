				Строки.Добавить(Ванесса.Локализовать("- Текст редактирования:") + " " + СостояниеПоля.ТекстРедактирования);
			КонецЕсли;
		Исключение
		КонецПопытки;
		ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
	КонецПопытки;

КонецПроцедуры

// Поле для подсказки по состоянию, когда объект поля не сохранён в переменной: в таблице - найденная
// колонка, в шапке - поиск по заголовку; не найдено - Неопределено (подсказки не будет).
&НаКлиенте
Функция MCPНайтиПолеДляПодсказкиПоСостояниюMCP(ИмяЭлемента, ИмяТаблицы)
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			СведенияКолонкиПодсказки = НайтиКолонкуДляДействияMCP(ИмяТаблицы, ИмяЭлемента);
			Возврат СведенияКолонкиПодсказки.Колонка;
		КонецЕсли;
		ДопПараметрыПоискаПоля = Новый Структура("КоличествоПопыток", 1);
		Возврат Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметрыПоискаПоля);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Подсказка для блока "Что делать" по состоянию поля: неактивная страница, свёрнутая группа,
// скрытое или недоступное поле, поле только для просмотра. Пустая строка - причина по состоянию
// поля не выявлена (поле видимо, доступно и не только для просмотра).
&НаКлиенте
Функция MCPПодсказкаПоСостояниюПоляMCP(Поле)
	
	Если Поле = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		
		ТолькоПросмотр = Ложь;
		Попытка
			ТолькоПросмотр = Поле.ТекущееТолькоПросмотр();
		Исключение
			ТолькоПросмотр = Ложь;
		КонецПопытки;
		Если ТолькоПросмотр Тогда
			Возврат Ванесса.Локализовать("Поле доступно только для просмотра (ТолькоПросмотр = Истина) - ввод в него невозможен. Заполняйте поле, которое принимает ввод; состояние полей проверяйте get_form_element_data.");
		КонецЕсли;
		
		ВидимостьПоля = Истина;
		Попытка
			ВидимостьПоля = Поле.ТекущаяВидимость();
		Исключение
			ВидимостьПоля = Истина;
		КонецПопытки;
		
		ДоступностьПоля = Истина;
		Попытка
			ДоступностьПоля = Поле.ТекущаяДоступность();
		Исключение
			ДоступностьПоля = Истина;
		КонецПопытки;
		
		// Обход родителей: ближайшая невидимая страница (закладка) или свёрнутая группа.
		// До 8.3.25 обход родителей недоступен - подсказки о родителях не формируются.
		ИмяСтраницы = "";
		ИмяСвернутойГруппы = "";
		Если Ванесса.Версия8325ИлиВыше Тогда
			ПроверяемыйЭлемент = Поле;
			Для Сч = 1 По 50 Цикл
				Попытка
					Родитель = ПроверяемыйЭлемент.ПолучитьРодителя();
				Исключение
					Прервать;
				КонецПопытки;
				Если Родитель = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Если ТипЗнч(Родитель) = Тип("ТестируемаяФорма")
					ИЛИ ТипЗнч(Родитель) = Тип("ТестируемоеОкноКлиентскогоПриложения") Тогда
					Прервать;
				КонецЕсли;
				Если ТипЗнч(Родитель) = Тип("ТестируемаяГруппаФормы") Тогда
					ВидГруппы = Неопределено;
					Попытка
						ВидГруппы = Родитель.Вид;
					Исключение
						ВидГруппы = Неопределено;
					КонецПопытки;
					Если НЕ ЗначениеЗаполнено(ИмяСтраницы) И ВидГруппы = ВидГруппыФормы.Страница Тогда
						ВидимостьРодителя = Истина;
						Попытка
							ВидимостьРодителя = Родитель.ТекущаяВидимость();
						Исключение
							ВидимостьРодителя = Истина;
						КонецПопытки;
						Если НЕ ВидимостьРодителя Тогда
							ИмяСтраницы = Родитель.Имя;
						КонецЕсли;
					КонецЕсли;
					// Страницы формы не сворачиваются - подсказку toggle_group для них не формируем.
					Если ВидГруппы <> Неопределено И ВидГруппы <> ВидГруппыФормы.Страница
						И Ванесса.ИсправленаОшибкаПроверкиГруппыОткрытаИлиНет Тогда
						ГруппаОткрыта = Истина;
						Попытка
							ГруппаОткрыта = Родитель.ТекущееОткрыта();
						Исключение
							ГруппаОткрыта = Истина;
						КонецПопытки;
						Если НЕ ГруппаОткрыта Тогда
							ИмяСвернутойГруппы = Родитель.Имя;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				ПроверяемыйЭлемент = Родитель;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяСтраницы) Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Поле находится на неактивной странице (закладке) формы ""%1"". Активизируйте страницу действием switch_tab (element_name = ""%1"") и повторите действие. Состав страниц и видимые элементы - get_form_analysis (format=""elements"", only_visible=true)."),
				ИмяСтраницы);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяСвернутойГруппы) Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Поле находится в свёрнутой группе ""%1"". Разверните группу действием toggle_group (element_name = ""%1"", value = ""expand"") и повторите действие."),
				ИмяСвернутойГруппы);
		КонецЕсли;
		
		Если НЕ ВидимостьПоля ИЛИ НЕ ДоступностьПоля Тогда
			Возврат Ванесса.Локализовать("Поле скрыто логикой формы (функциональные опции, условное оформление или выбранный режим заполнения) и недоступно для ввода. Найдите видимое поле-аналог: get_form_analysis (format=""elements"", only_visible=true). В формах ERP, например, даты часто задаются одним полем в подвале табличной части - если режим заполнения выбирается переключателем, смените его.");
		КонецЕсли;
		
		Возврат "";
		
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Дополняет ошибку действия подсказкой по состоянию поля: текст пересобирается по схеме
// "Ошибка/Что делать/Детали" (блоки "##" из ТекстОшибки переносятся в "Детали").
// ПрефиксОперации - локализованный префикс первой строки (например, "Ошибка ввода текста"):
// он убирается из сути; пустая строка - суть остаётся как есть.
// ТекстПоУмолчанию - подсказка на случай, когда причина по состоянию поля не выявлена
// (например, колонка не принимает ввод); пустая строка - подсказка не добавляется.
&НаКлиенте
Процедура MCPДополнитьОшибкуПоСостояниюПоляMCP(Поле, ТекстОшибки, ПрефиксОперации = "", ТекстПоУмолчанию = "")
	
	Если НЕ Ванесса.ВыполняетсяВызовMCP() Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Схема "Что делать" уже сформирована - повторно не дополняем.
	Если Найти(ТекстОшибки, Ванесса.Локализовать("Что делать:")) > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Подсказка = MCPПодсказкаПоСостояниюПоляMCP(Поле);
	Если НЕ ЗначениеЗаполнено(Подсказка) Тогда
		Подсказка = ТекстПоУмолчанию;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подсказка) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Суть = MCPVAСлужебныйМодуль.MCPСутьОшибкиИзТекста(ТекстОшибки);
		Если ЗначениеЗаполнено(ПрефиксОперации) Тогда
			ПрефиксСКвочкой = ПрефиксОперации + ":";
			Если Лев(Суть, СтрДлина(ПрефиксСКвочкой)) = ПрефиксСКвочкой Тогда
				Суть = СокрЛП(Сред(Суть, СтрДлина(ПрефиксСКвочкой) + 1));
			КонецЕсли;
		КонецЕсли;
		ТекстОшибки = MCPVAСлужебныйМодуль.MCPОформитьОшибку(
			Суть,
			Подсказка,
			MCPVAСлужебныйМодуль.MCPДеталиОшибкиИзТекста(ТекстОшибки));
	Исключение
		Ванесса.ЗаписатьЛогВЖРОшибка("MCPДополнитьОшибкуПоСостояниюПоляMCP", ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки) Экспорт
	Если НЕ Ванесса.ВыполняетсяВызовMCP() Тогда
		Возврат;
	КонецЕсли;
	
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Данные по состоянию таблицы `%1`:"), Таблица.Имя);
	Если Найти(ТекстОшибки, СтрокаЗаголовка) > 0 Тогда
		// Значит уже происходило дополнение текста ошибки.
		Возврат;
	КонецЕсли;
	
	Попытка
		ТекущийЭлементТаблицы = Таблица.ПолучитьТекущийЭлемент();
		
		Строки = Новый Массив;
		Строки.Добавить("");
		Строки.Добавить(СтрокаЗаголовка);
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("### Активный элемент формы"));
		Попытка
			ТекущаяФормаДиагностики = Ванесса.НайтиТекущуюФормуTestClient();
			Если ТекущаяФормаДиагностики = Неопределено Тогда
				Строки.Добавить(Ванесса.Локализовать("Активная форма не найдена."));
			Иначе
				АктивныйЭлементФормы = ТекущаяФормаДиагностики.ПолучитьТекущийЭлемент();
				Если АктивныйЭлементФормы = Неопределено Тогда
					Строки.Добавить(Ванесса.Локализовать("Активный элемент формы не определён."));
				Иначе
					ИмяТипаЭлемента = Строка(ТипЗнч(АктивныйЭлементФормы));
					Если ТипЗнч(АктивныйЭлементФормы) = Тип("ТестируемаяТаблицаФормы") Тогда
						ИмяТипаЭлемента = "Таблица";
					ИначеЕсли ТипЗнч(АктивныйЭлементФормы) = Тип("ТестируемоеПолеФормы") Тогда
						ИмяТипаЭлемента = "Поле";
					КонецЕсли;
					Строки.Добавить(Ванесса.Локализовать("Тип: ") + ИмяТипаЭлемента);
					Строки.Добавить(Ванесса.Локализовать("Имя: ") + АктивныйЭлементФормы.Имя);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("Не удалось определить активный элемент формы."));
		КонецПопытки;
		Строки.Добавить(Ванесса.Локализовать("### Данные активного поля"));
		Если ТекущийЭлементТаблицы = Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("В таблице нет активного поля."));
		Иначе	
			Строки.Добавить(Ванесса.Локализовать("Заголовок: " + ТекущийЭлементТаблицы.ТекстЗаголовка));
			Строки.Добавить(Ванесса.Локализовать("Имя: " + ТекущийЭлементТаблицы.Имя));
			Попытка
				Строки.Добавить(Ванесса.Локализовать("ТекстРедактирования: " + ТекущийЭлементТаблицы.ПолучитьТекстРедактирования()));
			Исключение
			КонецПопытки;
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("### Режим редактирования"));
		Строки.Добавить(Ванесса.Локализовать("Таблица находится в режиме редактирования: " + Таблица.ТекущийРежимРедактирование()));
		
		Строки.Добавить("");
		Попытка
			ВыделенныеСтроки = Таблица.ПолучитьВыделенныеСтроки();
		Исключение
			ВыделенныеСтроки = Новый Массив;
		КонецПопытки;
		Строки.Добавить(Ванесса.Локализовать("Количество выделенных строк в таблице (может не совпадать с общим количеством строк таблицы): ") + Формат(ВыделенныеСтроки.Количество(), "ЧГ=0; ЧН=0"));
		
		Если ВыделенныеСтроки.Количество() = 1 Тогда
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("### Данные активной строки"));
			ЗначениеЭлемента = Ванесса.ПолучитьСтрокуСТЧФормаTestClient(ВыделенныеСтроки, Неопределено);
			Строки.Добавить(MCPСократитьТекстДляОтвета(ЗначениеЭлемента, 300));
		Иначе	
			Попытка
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("## Колонки таблицы. Имя колонки и заголовок колонки."));
				ПоляТаблицы = Таблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));
				Для Каждого ТекПоле Из ПоляТаблицы Цикл
					Если НЕ ЗначениеЗаполнено(ТекПоле.ТекстЗаголовка) Тогда
						Продолжить;
					КонецЕсли;
					Строки.Добавить(Ванесса.Локализовать("Имя:") + " `" + ТекПоле.Имя + "`. " + Ванесса.Локализовать("Заголовок:") + " `" + ТекПоле.ТекстЗаголовка + "`");
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ТекстОткрытогоСписка = "";
		Попытка
			ДополнитьОшибку_ЗначениеОткрытогоСписка(ТекущийЭлементТаблицы, ТекстОткрытогоСписка);
		Исключение
		КонецПопытки;
		Если ЗначениеЗаполнено(ТекстОткрытогоСписка) Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В поле `%1` не был зафиксирован выбор значения. Выполните ввод значения по строке или выбор точного значения из списка."), ТекущийЭлементТаблицы.Имя));
			Строки.Добавить(ТекстОткрытогоСписка);
		КонецЕсли;
		
		ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.ПС + Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
	КонецПопытки;

КонецПроцедуры

// Перенесено из главной формы (Шаг 4 BEST_BRIDGE порция 2). Мост: ОткрытьФормуИзвестногоШага.
// Имя изменено на *Реализация, т.к. имя ВсеДоступныеШагиMCP уже занято MCP-обработчиком выше
// (привязан к строковому имени инструмента в MCPVA_Служебный). Урок 6: коллизия при инверсии.
&НаКлиенте
Функция ВсеДоступныеШагиMCPРеализация() Экспорт

	ФормаВыборИзвестногоШага = Ванесса.ОткрытьФормуИзвестногоШага(Ложь, Неопределено);
	Значение = ФормаВыборИзвестногоШага.ВсеДоступныеШагиMCP();
	ФормаВыборИзвестногоШага.Закрыть();

	Возврат Значение;

КонецФункции
&НаКлиенте
Функция ПоискШаговПоСтрокеMCP(search_name, exclude_name, search_description, exclude_description, search_type, exclude_type, limit, ТолькоЦиклы, ТолькоУсловия, КомпактныйВывод = Истина)
	МодульМсп_Сервер = МодульМсп_Сервер();
	
	Массив_search_name = MCPПодготовитьВариантыТочногоПоиска(search_name);
	Массив_exclude_name = MCPПодготовитьВариантыТочногоПоиска(exclude_name);
	Массив_search_description = MCPПодготовитьВариантыТочногоПоиска(search_description);
	Массив_exclude_description = MCPПодготовитьВариантыТочногоПоиска(exclude_description);
	Массив_search_type = MCPПодготовитьВариантыТочногоПоиска(search_type);
	Массив_exclude_type = MCPПодготовитьВариантыТочногоПоиска(exclude_type);
	
	СтрокаСообщения = Ванесса.Локализовать("Поиск шагов с отбором:
	|search_name=%1
	|exclude_name=%2
	|search_description=%3
	|exclude_description=%4
	|search_type=%5
	|exclude_type=%6
	|limit=%7");
	СтрокаСообщения = Ванесса.ПодставитьПараметрыВСтроку(СтрокаСообщения, search_name, exclude_name, search_description, exclude_description, search_type, exclude_type, limit);
	Ванесса.СообщитьПользователю(СтрокаСообщения);
	Ванесса.ЗаписатьЛогВЖРИнформация("ПоискШаговПоСтрокеMCP", СтрокаСообщения);
	
	Лимит = 20;
	Если limit <> Неопределено Тогда
		Попытка
			// 0 означает "вернуть все результаты", см. описание параметра limit
			Лимит = Число(limit);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если Лимит < 0 Тогда
		Возврат МодульМсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Параметр limit не может быть отрицательным. Используйте 0, чтобы вернуть все результаты."));
	КонецЕсли;
	
	МассивШагов = Новый Массив;
	МножествоКатегорий = Новый Соответствие;
	Счетчик = 0;
	
	Для Каждого СтрокаТаблицы Из Ванесса.ТаблицаИзвестныхStepDefinition Цикл
		
		Если ТолькоЦиклы Тогда
			Если НРег(СтрокаТаблицы.ТипШагаВДереве) <> "цикл" Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		Если ТолькоУсловия Тогда
			Если НРег(СтрокаТаблицы.ТипШагаВДереве) <> "условие" Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ТипШага) Тогда
			// Значит это служебный шаг
			Продолжить;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ОписаниеШага) Тогда
			// Значит это служебный шаг
			Продолжить;
		КонецЕсли;	
		Если Найти(НРег(СтрокаТаблицы.ТипШага), "устаревшее") Тогда
			// Значит это устаревший шаг
			Продолжить;
		КонецЕсли;	
		
		// Исключения:
		// Имя, описание, тип
		Если Массив_exclude_name.Количество() > 0 И НайденоВхождениеЗначенияВМассиве(Массив_exclude_name, НРег(СтрокаТаблицы.ПредставлениеТеста)) Тогда
			Продолжить;
		КонецЕсли;
		Если Массив_exclude_description.Количество() > 0 И НайденоВхождениеЗначенияВМассиве(Массив_exclude_description, НРег(СтрокаТаблицы.ОписаниеШага)) Тогда
			Продолжить;
		КонецЕсли;
		Если Массив_exclude_type.Количество() > 0 И НайденоВхождениеЗначенияВМассиве(Массив_exclude_type, НРег(СтрокаТаблицы.ТипШага)) Тогда
			Продолжить;
		КонецЕсли;

		НадоПродолжить = Истина;
		
		Если Массив_search_name.Количество() = 0 И Массив_search_description.Количество() = 0 И Массив_search_type.Количество() = 0 Тогда
			// Значит не нужно делать отбор
			НадоПродолжить = Ложь;
		КонецЕсли;	
		
		// Фильтр по вхождению
		// Имя, описание, тип
		Если (Массив_search_name.Количество() > 0 И НайденоВхождениеЗначенияВМассиве(Массив_search_name, НРег(СтрокаТаблицы.ПредставлениеТеста)))
			ИЛИ (Массив_search_description.Количество() > 0 И НайденоВхождениеЗначенияВМассиве(Массив_search_description, НРег(СтрокаТаблицы.ОписаниеШага)))
			ИЛИ Массив_search_type.Количество() > 0 И НайденоВхождениеЗначенияВМассиве(Массив_search_type, НРег(СтрокаТаблицы.ТипШага))
			Тогда
			НадоПродолжить = Ложь;
		КонецЕсли;
		Если НадоПродолжить Тогда
			Продолжить;
		КонецЕсли;	
		
		// Собираем категории
		Если ЗначениеЗаполнено(СтрокаТаблицы.ТипШага) Тогда
			МножествоКатегорий.Вставить(СтрокаТаблицы.ТипШага, Истина);
		КонецЕсли;
		
		// Лимит
		Счетчик = Счетчик + 1;
		Если Лимит > 0 И Счетчик > Лимит Тогда
			Продолжить; // Продолжаем считать категории, но не добавляем шаги
		КонецЕсли;
		
		ШагJSON = Новый Структура;
		ШагJSON.Вставить("name", СтрокаТаблицы.ПредставлениеТеста);
		ШагJSON.Вставить("description", СтрокаТаблицы.ОписаниеШага);
		ШагJSON.Вставить("category", СтрокаТаблицы.ТипШага);
		ШагJSON.Вставить("snippet", СтрокаТаблицы.Id);
		ШагJSON.Вставить("searchString", СтрокаТаблицы.СтрокаДляПоиска);
		ШагJSON.Вставить("sourceFile", СтрокаТаблицы.ИмяФайла);
		ШагJSON.Вставить("type", СтрокаТаблицы.ТипШага);
		
		МассивШагов.Добавить(ШагJSON);
		
	КонецЦикла;
	
	// Собираем список категорий
	МассивКатегорий = Новый Массив;
	Для Каждого КлючЗначение Из МножествоКатегорий Цикл
		МассивКатегорий.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("totalFound", Счетчик);
	Результат.Вставить("categories", МассивКатегорий);
	Результат.Вставить("steps", МассивШагов);
	Результат.Вставить("search_name", СокрЛП(search_name));
	Результат.Вставить("exclude_name", СокрЛП(exclude_name));
	Результат.Вставить("search_description", СокрЛП(search_description));
	Результат.Вставить("exclude_description", СокрЛП(exclude_description));
	Результат.Вставить("search_type", СокрЛП(search_type));
	Результат.Вставить("exclude_type", СокрЛП(exclude_type));
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("compact", КомпактныйВывод);
	
	Возврат MCPСформироватьMarkdownРезультатаПоискаШагов(Результат);
	
КонецФункции	


