// Выполняет регистрацию инструментов MCP
&НаКлиенте
Процедура ЗарегистрироватьИнструментыMCP() Экспорт
	
	ПараметрыСозданияMCP = Новый Структура;
	ПараметрыСозданияMCP.Вставить("МодульМсп_Сервер", МодульМсп_Сервер());
	ПараметрыСозданияMCP.Вставить("МодульМсп_СхемаПараметров", Вычислить("Мсп_СхемаПараметров"));

	ВызватьРегистрациюИнструментовMCP(ПараметрыСозданияMCP);

КонецПроцедуры

// Вызывает регистрацию всех инструментов MCP с переданными модулями сервера и схемы.
// Используется штатной регистрацией (client_mcp) и внешним транспортом (плагин MCPRagSearch).
&НаКлиенте
Процедура ВызватьРегистрациюИнструментовMCP(ПараметрыСозданияMCP) Экспорт

	//MCPИнструментПолучитьВсеШаги(ПараметрыСозданияMCP);
	MCPИнструментНайтиШагиПоКлючевымСловам(ПараметрыСозданияMCP);
	//MCPИнструментПолучитьТекущуюДату(ПараметрыСозданияMCP);
	MCPИнструментСостояниеVanessaAutomation(ПараметрыСозданияMCP);
	MCPИнструментСинтаксКонтроль(ПараметрыСозданияMCP);
	MCPИнструментОткрытьФичаФайл(ПараметрыСозданияMCP);
	MCPИнструментОткрытьЗагрузитьИлиПерезагрузитьФичаФайл(ПараметрыСозданияMCP);
	MCPИнструментПолучитьСостояниеРедактора(ПараметрыСозданияMCP);
	MCPИнструментВыбратьСценарий(ПараметрыСозданияMCP);
	MCPИнструментВыбратьШаг(ПараметрыСозданияMCP);
	MCPИнструментПолучитьИмяЗаголовокАктивногоОкнаИФормы(ПараметрыСозданияMCP);
	MCPИнструментПолучитьСписокВнутреннихОконКлиентаТестирования(ПараметрыСозданияMCP);
	MCPИнструментУправлениеОкномКлиентаТестирования(ПараметрыСозданияMCP);
	MCPИнструментПолучитьИнформациюОТекущейФорме(ПараметрыСозданияMCP);
	//MCPИнструментВыполнитьОдинШагТекстом(ПараметрыСозданияMCP);
	MCPИнструментВыполнитьОдинШагВФичаФайле(ПараметрыСозданияMCP);
	MCPИнструментУправлениеКлиентомТестирования(ПараметрыСозданияMCP);
	MCPИнструментВыполнитьСценарий(ПараметрыСозданияMCP);
	MCPИнструментОстановитьВыполнениеСценариев(ПараметрыСозданияMCP);
	MCPИнструментПолучитьРезультатВыполненияТестов(ПараметрыСозданияMCP);
	MCPИнструментПолучитьСписокОконКлиентаТестированияДляСнятияСкриншотов(ПараметрыСозданияMCP);
	MCPИнструментПолучитьСкриншотОкнаКлиентаТестирования(ПараметрыСозданияMCP);
	MCPИнструментУправлениеПеременными(ПараметрыСозданияMCP);
	MCPИнструментУправлениеТочкамиОстанова(ПараметрыСозданияMCP);
	MCPИнструментПолучитьПодробнуюИнформациюОШагеВСтрокеСценария(ПараметрыСозданияMCP);
	MCPИнструментПолучитьДанныеИзБазыЗнаний(ПараметрыСозданияMCP);
	MCPИнструментПолучитьДанныеОЧастоИспользуемыхШагах(ПараметрыСозданияMCP);
	MCPИнструментУправлениеКоманднымИнтерфейсом(ПараметрыСозданияMCP);
	MCPИнструментПолучитьСписокРасширений(ПараметрыСозданияMCP);
	MCPИнструментУправлениеПрофилямиКлиентовТестирования(ПараметрыСозданияMCP);
	MCPИнструментПолучитьДанныеОбОкружении(ПараметрыСозданияMCP);
	MCPИнструментГолосовыеУведомления(ПараметрыСозданияMCP);
	MCPИнструментПолучитьРеквизитыОбъекта(ПараметрыСозданияMCP);
	MCPИнструментПолучитьДанныеИзТаблицыБД(ПараметрыСозданияMCP);
	MCPИнструментСохранитьТабличныйДокументВФайл(ПараметрыСозданияMCP);
	MCPИнструментПолучитьДанныеЭлементаФормы(ПараметрыСозданияMCP);
	MCPИнструментУправлениеЭлементамиФормы(ПараметрыСозданияMCP);
	MCPИнструментВыполнитьПоследовательностьДействийФормы(ПараметрыСозданияMCP);
	MCPИнструментЗаписьДействийПользователя(ПараметрыСозданияMCP);
	MCPИнструментЗакрытьКлиентТестирования(ПараметрыСозданияMCP);
		
КонецПроцедуры

