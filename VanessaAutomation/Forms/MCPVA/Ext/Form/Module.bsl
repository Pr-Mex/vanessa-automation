&НаКлиенте
Процедура ДополнитьОшибку_НетПоляТаблицыMCP(Таблица, ТекстОшибки) Экспорт
	
	Если НЕ Ванесса.ВыполняетсяВызовMCP() Тогда
		Возврат;
	КонецЕсли;
	
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка = Ванесса.Локализовать("## Поля таблицы. Имя поля и заголовок поля:");
	Если Найти(ТекстОшибки, СтрокаЗаголовка) > 0 Тогда
		// Значит уже происходило дополнение текста ошибки.
		Возврат;
	КонецЕсли;
	
	Попытка
		ТипПоля = Тип("ТестируемоеПолеФормы");
		ПоляТаблицы = Таблица.НайтиОбъекты(ТипПоля);
		
		Строки = Новый Массив;
		Строки.Добавить("");
		Строки.Добавить(СтрокаЗаголовка);
		Для Каждого ТекПоле Из ПоляТаблицы Цикл
			
			Если ТекПоле.Вид = ВидПоляФормы.ПолеФлажка Тогда
				Продолжить; // Для флагов есть отдельный метод
			КонецЕсли;
			
			Строки.Добавить("- " + ТекПоле.Имя + " (" + ТекПоле.ТекстЗаголовка + ")");
		КонецЦикла;
		
		Строки.Добавить("");
		
		ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса._СтрСоединить(Строки);
	Исключение
		Ванесса.ЗаписатьЛогВЖРОшибка("ДополнитьОшибку_НетПоляТаблицыMCP", ОписаниеОшибки());
	КонецПопытки;
	

