&НаКлиенте
Функция УправлениеЭлементамиФормыСлужебный(Запрос, ДополнительныеПараметры, ПодавитьДанныеОбОкне = Ложь)
	// Получаем параметр action (обязательный)
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр action обязателен. ") + MCPПодсказкаПоДействиямЭлементовФормы();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Получаем параметр element_name (обязательный для большинства действий)
	ИмяЭлемента = Строка(ЗначениеПараметраИзЗапроса(Запрос, "element_name"));
	
	// Получаем параметр table_name (необязательный)
	ИмяТаблицы = Строка(ЗначениеПараметраИзЗапроса(Запрос, "table_name"));
	
	// Получаем параметр value (необязательный)
	Значение = Строка(ЗначениеПараметраИзЗапроса(Запрос, "value"));
	
	ЗначениеПереходаКСтроке = Строка(ЗначениеПараметраИзЗапроса(Запрос, "row_criteria"));
	
	// Получаем параметр hyperlink_title (необязательный)
	ЗаголовокГиперссылки = Строка(ЗначениеПараметраИзЗапроса(Запрос, "hyperlink_title"));
	Если НЕ ЗначениеЗаполнено(ЗаголовокГиперссылки) Тогда
		ЗаголовокГиперссылки = Неопределено;
	КонецЕсли;	
	
	// Получаем параметр hyperlink_index (необязательный)
	Попытка
		ИндексГиперссылки = ЗначениеПараметраИзЗапроса(Запрос, "hyperlink_index");
		Если ИндексГиперссылки <> Неопределено Тогда
			ИндексГиперссылки = Число(ИндексГиперссылки);
		КонецЕсли;
	Исключение
		ИндексГиперссылки = Неопределено;
	КонецПопытки;
	
	// Получаем параметр tab_direction (необязательный)
	НаправлениеПерехода = Строка(ЗначениеПараметраИзЗапроса(Запрос, "tab_direction"));
	Если НЕ ЗначениеЗаполнено(НаправлениеПерехода) Тогда
		НаправлениеПерехода = "next";
	КонецЕсли;
	
	// Получаем параметр exact_match (необязательный)
	ТочноеСовпадение = ЗначениеПараметраИзЗапроса(Запрос, "exact_match");
	Если ТочноеСовпадение = Неопределено Тогда
		ТочноеСовпадение = Ложь;
	Иначе
		Попытка
			ТочноеСовпадение = Булево(ТочноеСовпадение);
		Исключение
			ТочноеСовпадение = Ложь;
		КонецПопытки;
	КонецЕсли;

	// Получаем параметр full_row (необязательный, полное представление удалённой строки)
	ПолноеПредставлениеСтроки = ЗначениеПараметраИзЗапроса(Запрос, "full_row");
	Если ПолноеПредставлениеСтроки = Неопределено Тогда
		ПолноеПредставлениеСтроки = Ложь;
	Иначе
		Попытка
			ПолноеПредставлениеСтроки = Булево(ПолноеПредставлениеСтроки);
		Исключение
			ПолноеПредставлениеСтроки = Ложь;
		КонецПопытки;
	КонецЕсли;

	// Получаем параметр full (необязательный, для get_selected_rows - вернуть строку целиком)
	ПолныйТекстСтроки = ЗначениеПараметраИзЗапроса(Запрос, "full");
	Если ПолныйТекстСтроки = Неопределено Тогда
		ПолныйТекстСтроки = Ложь;
	Иначе
		Попытка
			ПолныйТекстСтроки = Булево(ПолныйТекстСтроки);
		Исключение
			ПолныйТекстСтроки = Ложь;
		КонецПопытки;
	КонецЕсли;

	// Получаем параметр expect_text (необязательный, для manage_modal_dialog - ожидаемая подстрока текста диалога)
	ОжидаемыйТекстДиалога = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "expect_text")));
	
	// Получаем параметр optional (необязательный, для manage_modal_dialog - не считать отсутствие диалога ошибкой)
	НеобязательноеДействие = ЗначениеПараметраИзЗапроса(Запрос, "optional");
	Если НеобязательноеДействие = Неопределено Тогда
		НеобязательноеДействие = Ложь;
	Иначе
		Попытка
			НеобязательноеДействие = Булево(НеобязательноеДействие);
		Исключение
			НеобязательноеДействие = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Получаем параметр max_length (необязательный, для get_selected_rows - предел длины представления строки)
	МаксимальнаяДлинаСтроки = Неопределено;
	ЗначениеМаксимальнойДлины = MCPБезопасноеСвойство(Запрос.Аргументы, "max_length");
	Если ЗначениеМаксимальнойДлины <> "" И ЗначениеМаксимальнойДлины <> Null И ЗначениеМаксимальнойДлины <> Неопределено Тогда
		Попытка
			МаксимальнаяДлинаСтроки = Число(ЗначениеМаксимальнойДлины);
		Исключение
			МаксимальнаяДлинаСтроки = Неопределено;
		КонецПопытки;
		Если МаксимальнаяДлинаСтроки = Неопределено ИЛИ МаксимальнаяДлинаСтроки < 0 Тогда
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра max_length. Нужно передать неотрицательное число.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Получаем параметр percent (необязательный, число - проценты полосы регулирования)
	Процент = Неопределено;
	ЗначениеПроцента = MCPБезопасноеСвойство(Запрос.Аргументы, "percent");
	Если ЗначениеПроцента <> "" И ЗначениеПроцента <> Null И ЗначениеПроцента <> Неопределено Тогда
		Попытка
			Процент = Число(ЗначениеПроцента);
		Исключение
			Процент = Неопределено;
		КонецПопытки;
		Если Процент = Неопределено ИЛИ ТипЗнч(ЗначениеПроцента) = Тип("Булево") Тогда
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра percent. Нужно передать число 0-100.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Получаем параметр area (необязательный, адрес/имя области табличного документа)
	АдресОбласти = Строка(ЗначениеПараметраИзЗапроса(Запрос, "area"));

	// Получаем параметр order (необязательный, имя колонки для установки порядка)
	ИмяКолонкиПорядка = Строка(ЗначениеПараметраИзЗапроса(Запрос, "order"));

	// Получаем параметр menu_path (необязательный, путь к команде меню)
	ПутьМеню = Строка(ЗначениеПараметраИзЗапроса(Запрос, "menu_path"));

	// Получаем параметр date (необязательный, строка даты для календаря)
	СтрокаДаты = Строка(ЗначениеПараметраИзЗапроса(Запрос, "date"));

	// Валидация обязательных параметров новых действий (INVALID_PARAMS до выполнения)
	Если Действие = "add_row"
		ИЛИ Действие = "copy_row"
		ИЛИ Действие = "delete_row"
		ИЛИ Действие = "go_one_level_down"
		ИЛИ Действие = "go_one_level_up"
		ИЛИ Действие = "goto_first_row"
		ИЛИ Действие = "goto_last_row"
		ИЛИ Действие = "goto_next_item"
		ИЛИ Действие = "goto_previous_item"
		ИЛИ Действие = "is_expanded"
		ИЛИ Действие = "select_all_rows"
		ИЛИ Действие = "select_row"
		ИЛИ Действие = "set_cell_text"
		ИЛИ Действие = "set_order"
		ИЛИ Действие = "switch_row_delete_mark" Тогда
		Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Для действия '%1' необходимо указать параметр table_name."), Действие));
		КонецЕсли;
	КонецЕсли;
	Если Действие = "cancel_edit"
		ИЛИ Действие = "current_opened"
		ИЛИ Действие = "decrease_value"
		ИЛИ Действие = "increase_value"
		ИЛИ Действие = "goto_value"
		ИЛИ Действие = "begin_edit_current_area"
		ИЛИ Действие = "end_edit_current_area"
		ИЛИ Действие = "get_current_area_address"
		ИЛИ Действие = "get_current_area_text"
		ИЛИ Действие = "get_doc_area_horizontal_size"
		ИЛИ Действие = "get_doc_area_vertical_size"
		ИЛИ Действие = "get_formatted_string_hyperlink_presentations"
		ИЛИ Действие = "set_area_text"
		ИЛИ Действие = "set_cell_text"
		ИЛИ Действие = "set_current_area"
		ИЛИ Действие = "goto_date" Тогда
		Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Для действия '%1' необходимо указать параметр element_name."), Действие));
		КонецЕсли;
	КонецЕсли;
	Если Действие = "set_area_text"
		ИЛИ Действие = "set_current_area" Тогда
		Если НЕ ЗначениеЗаполнено(АдресОбласти) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Для действия '%1' необходимо указать параметр area."), Действие));
		КонецЕсли;
	КонецЕсли;
	Если Действие = "set_order"
		ИЛИ Действие = "execute_choice_from_menu" Тогда
		ИмяОбязательногоПараметра = ?(Действие = "set_order", "order", "menu_path");
		ЗначениеОбязательногоПараметра = ?(Действие = "set_order", ИмяКолонкиПорядка, ПутьМеню);
		Если НЕ ЗначениеЗаполнено(ЗначениеОбязательногоПараметра) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Для действия '%1' необходимо указать параметр %2."), Действие, ИмяОбязательногоПараметра));
		КонецЕсли;
	КонецЕсли;
	Если Действие = "goto_date" И НЕ ЗначениеЗаполнено(СтрокаДаты) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Для действия 'goto_date' необходимо указать параметр date."));
	КонецЕсли;

	// Для set_cell_text/set_area_text value обязателен, но явная пустая строка допустима (очистка).
	// Наличие параметра проверяем по структуре: ЗначениеПараметраИзЗапроса возвращает "" и для отсутствующего.
	Если Действие = "set_cell_text"
		ИЛИ Действие = "set_area_text" Тогда
		ПроверяемоеЗначение = "";
		Если НЕ Запрос.Аргументы.Свойство("value", ПроверяемоеЗначение)
			ИЛИ ТипЗнч(ПроверяемоеЗначение) = Тип("Неопределено") Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Для действия '%1' необходимо указать параметр value."), Действие));
		КонецЕсли;
	КонецЕсли;

	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	Идентификатор = Запрос.Идентификатор;
	
	// Выполняем действие в зависимости от параметра action
	Если Действие = "click_button" Тогда
		Результат = НажатьКнопкуФормы(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "input_text" Тогда
		Результат = ВвестиТекстВПоле(ИмяЭлемента, Значение, ИмяТаблицы);
	ИначеЕсли Действие = "open_dropdown" Тогда
		Результат = ОткрытьВыпадающийСписок(ИмяЭлемента, ИмяТаблицы, Истина);
	ИначеЕсли Действие = "get_dropdown_state" Тогда
		Результат = ОткрытьВыпадающийСписок(ИмяЭлемента, ИмяТаблицы, Ложь);
	ИначеЕсли Действие = "select_from_dropdown" Тогда
		Результат = ВыбратьИзВыпадающегоСписка(ИмяЭлемента, Значение, ИмяТаблицы);
	ИначеЕсли Действие = "set_value" Тогда
		Результат = УстановитьЗначениеВПоле(ИмяЭлемента, Значение, ИмяТаблицы, ТочноеСовпадение);
	ИначеЕсли Действие = "open_choice_form" Тогда
		Результат = ОткрытьФормуВыбора(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "set_radio_button" Тогда
		Результат = УстановитьПереключатель(ИмяЭлемента, Значение);
	ИначеЕсли Действие = "set_checkbox" Тогда
		Результат = УстановитьФлаг(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "unset_checkbox" Тогда
		Результат = СнятьФлаг(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "toggle_checkbox" Тогда
		Результат = ПереключитьФлаг(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "click_hyperlink" Тогда
		Результат = НажатьГиперссылку(ИмяЭлемента, ЗаголовокГиперссылки, ИндексГиперссылки);
	ИначеЕсли Действие = "simulate_tab" Тогда
		Результат = ЭмуляцияПереходаTAB(НаправлениеПерехода);
	ИначеЕсли Действие = "activate_column" Тогда
		Результат = АктивизироватьКолонкуТаблицы(ИмяТаблицы, Значение);
	ИначеЕсли Действие = "navigate_next_column" Тогда
		Результат = ПереходКСледующейКолонке(ИмяТаблицы);
	ИначеЕсли Действие = "navigate_previous_column" Тогда
		Результат = ПереходКПредыдущейКолонке(ИмяТаблицы);
	ИначеЕсли Действие = "start_edit_row" Тогда
		Результат = НачатьРедактированиеСтроки(ИмяТаблицы);
	ИначеЕсли Действие = "end_edit_row" Тогда
		Результат = ЗакончитьРедактированиеСтроки(ИмяТаблицы);
	ИначеЕсли Действие = "navigate_to_row" Тогда
		Результат = ПереходКСтрокеТаблицы(ИмяТаблицы, ЗначениеПереходаКСтроке);
	ИначеЕсли Действие = "navigate_next_row" Тогда
		Результат = ПереходКСледующейСтрокеТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "navigate_previous_row" Тогда
		Результат = ПереходКПредыдущейСтрокеТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "choose_row" Тогда
		Результат = ВыбратьСтрокуТаблицы(ИмяТаблицы);
	ИначеЕсли Действие = "get_selected_rows" Тогда
		Результат = ПолучитьВыделенныеСтрокиТаблицы(ИмяТаблицы, ПолныйТекстСтроки, МаксимальнаяДлинаСтроки);
	ИначеЕсли Действие = "create_new" Тогда
		Результат = СоздатьНовый(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "switch_tab" Тогда
		Результат = ПереключитьсяНаЗакладку(ИмяЭлемента);
	ИначеЕсли Действие = "toggle_group" Тогда
		Результат = РазвернутьСвернутьГруппу(ИмяЭлемента, Значение);
	ИначеЕсли Действие = "activate_header_element" Тогда
		Результат = АктивизироватьЭлементШапки(ИмяЭлемента);
	ИначеЕсли Действие = "clear_field" Тогда
		Результат = ОчиститьПоле(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "clear_message_window" Тогда
		Результат = ОчиститьОкноСообщенийПользователю();
	ИначеЕсли Действие = "select_from_form_dropdown" Тогда
		Результат = ВыбратьИзСпискаВыбораФормы(Значение);
	ИначеЕсли Действие = "add_row" Тогда
		Результат = ДобавитьСтрокуТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "copy_row" Тогда
		Результат = СкопироватьСтрокуТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "delete_row" Тогда
		Результат = УдалитьСтрокуТаблицыMCP(ИмяТаблицы, ПолноеПредставлениеСтроки);
	ИначеЕсли Действие = "go_one_level_down" Тогда
		Результат = ПерейтиНаУровеньВнизТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "go_one_level_up" Тогда
		Результат = ПерейтиНаУровеньВверхТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "goto_first_row" Тогда
		Результат = ПерейтиКПервойСтрокеТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "goto_last_row" Тогда
		Результат = ПерейтиКПоследнейСтрокеТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "goto_next_item" Тогда
		Результат = ПерейтиКСледующемуЭлементуТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "goto_previous_item" Тогда
		Результат = ПерейтиКПредыдущемуЭлементуТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "is_expanded" Тогда
		Результат = ПолучитьРазвернутостьСтрокиMCP(ИмяТаблицы);
	ИначеЕсли Действие = "select_all_rows" Тогда
		Результат = ВыделитьВсеСтрокиТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "select_row" Тогда
		Результат = ВыделитьСтрокуТаблицыMCP(ИмяТаблицы);
	ИначеЕсли Действие = "set_cell_text" Тогда
		Результат = ВвестиТекстЯчейкиТаблицыMCP(ИмяТаблицы, ИмяЭлемента, Значение);
	ИначеЕсли Действие = "set_order" Тогда
		Результат = УстановитьПорядокТаблицыMCP(ИмяТаблицы, ИмяКолонкиПорядка);
	ИначеЕсли Действие = "switch_row_delete_mark" Тогда
		Результат = ПереключитьПометкуУдаленияMCP(ИмяТаблицы);
	ИначеЕсли Действие = "begin_edit_current_area" Тогда
		Результат = НачатьРедактированиеОбластиMCP(ИмяЭлемента);
	ИначеЕсли Действие = "end_edit_current_area" Тогда
		Результат = ЗакончитьРедактированиеОбластиMCP(ИмяЭлемента);
	ИначеЕсли Действие = "get_current_area_address" Тогда
		Результат = ПолучитьАдресОбластиMCP(ИмяЭлемента);
	ИначеЕсли Действие = "get_current_area_text" Тогда
		Результат = ПолучитьТекстОбластиMCP(ИмяЭлемента, АдресОбласти);
	ИначеЕсли Действие = "get_doc_area_horizontal_size" Тогда
		Результат = ПолучитьРазмерОбластиПоГоризонталиMCP(ИмяЭлемента);
	ИначеЕсли Действие = "get_doc_area_vertical_size" Тогда
		Результат = ПолучитьРазмерОбластиПоВертикалиMCP(ИмяЭлемента);
	ИначеЕсли Действие = "get_formatted_string_hyperlink_presentations" Тогда
		Результат = ПолучитьПредставленияГиперссылокФорматированнойСтрокиMCP(ИмяЭлемента);
	ИначеЕсли Действие = "set_area_text" Тогда
		Результат = ВвестиТекстВОбластьMCP(ИмяЭлемента, АдресОбласти, Значение);
	ИначеЕсли Действие = "set_current_area" Тогда
		Результат = УстановитьТекущуюОбластьMCP(ИмяЭлемента, АдресОбласти);
	ИначеЕсли Действие = "cancel_edit" Тогда
		Результат = ОтменитьРедактированиеЭлементаMCP(ИмяЭлемента, ИмяТаблицы);
	ИначеЕсли Действие = "current_opened" Тогда
		Результат = ПолучитьОткрытостьГруппыMCP(ИмяЭлемента);
	ИначеЕсли Действие = "goto_date" Тогда
		Результат = ПерейтиКДатеКалендаряMCP(ИмяЭлемента, СтрокаДаты);
	ИначеЕсли Действие = "decrease_value" Тогда
		Результат = УменьшитьЗначениеПоляMCP(ИмяЭлемента);
	ИначеЕсли Действие = "increase_value" Тогда
		Результат = УвеличитьЗначениеПоляMCP(ИмяЭлемента);
	ИначеЕсли Действие = "goto_value" Тогда
		Результат = ПерейтиКЗначениюПолосыMCP(ИмяЭлемента, Процент);
	ИначеЕсли Действие = "current_modified" Тогда
		Результат = ПолучитьМодифицированностьФормыMCP();
	ИначеЕсли Действие = "manage_modal_dialog" Тогда
		Результат = ОтветитьНаМодальныйДиалогMCP(ИмяЭлемента, ОжидаемыйТекстДиалога, НеобязательноеДействие);
	ИначеЕсли Действие = "execute_choice_from_menu" Тогда
		Результат = ВыполнитьВыборИзМенюMCP(ПутьМеню);
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Неизвестное действие: ") + Действие + ". " + MCPПодсказкаПоДействиямЭлементовФормы();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Если НЕ ПодавитьДанныеОбОкне Тогда
			Результат = ДобавитьВСообщениеДанныеОбАктивномОкне(Результат);
		КонецЕсли;
		Возврат Результат;
	Иначе	
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

// Инструмент manage_app: управление приложением клиента тестирования
&НаКлиенте
Функция УправлениеПриложением(Запрос, ДополнительныеПараметры) Экспорт
	Идентификатор = Запрос.Идентификатор;
	// Пока выполняется синхронный инструмент, диагностика MCP дополняет ошибки подробностями
	Ванесса.УстановитьПризнакВыполненияОперацииMCP(Истина);
	Попытка
		Результат = УправлениеПриложениемСлужебный(Запрос, ДополнительныеПараметры);
	Исключение
		Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция УправлениеПриложениемСлужебный(Запрос, ДополнительныеПараметры)
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: 'set_file_dialog_result', 'clear_file_dialog_result'."));
	КонецЕсли;
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.")
				+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	Если Действие = "set_file_dialog_result" Тогда
		ОтменаДиалога = ЗначениеПараметраИзЗапроса(Запрос, "cancel");
		Если ОтменаДиалога = Неопределено Тогда
			ОтменаДиалога = Ложь;
		Иначе
			Попытка
				ОтменаДиалога = Булево(ОтменаДиалога);
			Исключение
				ОтменаДиалога = Ложь;
			КонецПопытки;
		КонецЕсли;
		ИмяФайла = Строка(ЗначениеПараметраИзЗапроса(Запрос, "file_name"));
		Если НЕ ОтменаДиалога И НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.Локализовать("Для действия 'set_file_dialog_result' при cancel=Ложь необходимо указать параметр file_name."));
		КонецЕсли;
		ИндексФильтра = Неопределено;
		ЗначениеИндекса = MCPБезопасноеСвойство(Запрос.Аргументы, "filter_index");
		Если ЗначениеИндекса <> "" И ЗначениеИндекса <> Null И ЗначениеИндекса <> Неопределено Тогда
			Попытка
				ИндексФильтра = Число(ЗначениеИндекса);
				// В 1С нет короткого замыкания И/ИЛИ - целочисленность проверяем там, где значение уже приведено к числу
				Если ТипЗнч(ЗначениеИндекса) = Тип("Булево") ИЛИ ИндексФильтра <> Цел(ИндексФильтра) Тогда
					ИндексФильтра = Неопределено;
				КонецЕсли;
			Исключение
				ИндексФильтра = Неопределено;
			КонецПопытки;
			Если ИндексФильтра = Неопределено Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
					Ванесса.Локализовать("Некорректное значение параметра filter_index. Нужно передать целое число."));
			КонецЕсли;
			Если ИндексФильтра < 0 Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
					Ванесса.Локализовать("Параметр filter_index не может быть отрицательным."));
			КонецЕсли;
		КонецЕсли;
		Возврат УстановитьРезультатДиалогаВыбораФайлаMCP(ОтменаДиалога, ИмяФайла, ИндексФильтра);
	ИначеЕсли Действие = "clear_file_dialog_result" Тогда
		Возврат ОчиститьРезультатДиалогаВыбораФайлаMCP();
	Иначе
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Неизвестное действие: ") + Действие + ". "
				+ Ванесса.Локализовать("Допустимые: 'set_file_dialog_result', 'clear_file_dialog_result'."));
	КонецЕсли;
КонецФункции

