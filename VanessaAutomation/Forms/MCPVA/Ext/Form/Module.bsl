#Область ОписаниеПеременных

&НаКлиенте
Перем Ванесса;

&НаКлиенте
Перем глДопПараметрыВызоваMCP;

// Ожидание перехода редактора к строке: целевые координаты и счётчик попыток
&НаКлиенте
Перем глMCPЦелеваяИдСтрокиОжидания;

&НаКлиенте
Перем глMCPЦелевойНомерСтрокиОжидания;

&НаКлиенте
Перем глMCPПопытокОжиданияСтроки;

// Ожидание готовности дерева после MCP-инициированной загрузки фичи: сохранённый вызов и дедлайн
&НаКлиенте
Перем глMCPИдентификаторЗадачиОжиданияЗагрузки;

&НаКлиенте
Перем глMCPПутьКФайлуОжиданияЗагрузки;

&НаКлиенте
Перем глMCPТипОповещенияОЗагрузке;

&НаКлиенте
Перем глMCPДопПараметрыОжиданияЗагрузки;

&НаКлиенте
Перем глMCPДедлайнОжиданияЗагрузкиФичи;

&НаКлиенте
Перем MCPVAСлужебныйМодуль;

// Признак того, что выполняется асинхронный ввод текста в активное поле
&НаКлиенте
Перем ВводТекстаВыполняется;

// Момент начала ввода текста в активное поле: защита признака занятости от залипания
&НаКлиенте
Перем ВремяНачалаВводаТекста;

// Идентификатор запроса, который сейчас выполняет ввод текста
&НаКлиенте
Перем ИдентификаторВводаТекстаMCP;

// Идентификатор запроса, который выбирает сценарий или шаг
&НаКлиенте
Перем ИдентификаторВыбораMCP;

// Идентификатор запроса, снятого со слота выбора: нужен для ответа после освобождения слота
&НаКлиенте
Перем ИдентификаторОшибкиMCP;

// Ключи последних записанных диагностических событий: не пишем в ЖР на каждый опрос
&НаКлиенте
Перем глMCPПоследнийКлючВыбранногоРезультата;

&НаКлиенте
Перем глMCPПоследнийКлючНетДанных;

&НаКлиенте
Перем глMCPПоследнийКлючПрерванногоРезультата;

&НаКлиенте
Перем глMCPПоследнийКлючНесогласованногоСостояния;

&НаКлиенте
Перем глMCPПоследнийКлючНетДанныхСостояния;

// Причина остановки текущего прогона: stop_scenario или пусто (точка останова, кнопка VA)
&НаКлиенте
Перем глMCPПричинаОстановкиПрогона;

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункции

// Делает первичную инициализацию модуля.
&НаКлиенте
Функция ИнициализацияФормы(ВладелецФормы) Экспорт
	Ванесса = ВладелецФормы;
	ВводТекстаВыполняется = Ложь;
	// 0 означает, что незавершённый ввод считается устаревшим
	ВремяНачалаВводаТекста = 0;
	ПараметрыФормы = Новый Структура;
	MCPVAСлужебныйМодуль = ПолучитьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.MCPVA_Служебный",ПараметрыФормы,Ванесса);
	MCPVAСлужебныйМодуль.ИнициализацияФормы(Ванесса);
	MCPЗаписатьСлужебныеДанные("Инициализация", Новый Структура("ВерсияMCP", ВерсияMCP()));
	Возврат Истина;
КонецФункции

// Делает отключение модуля
&НаКлиенте
Функция ОтключениеМодуля() Экспорт
	MCPЗаписатьСлужебныеДанные("Отключение");
	Если MCPVAСлужебныйМодуль <> Неопределено Тогда
		MCPVAСлужебныйМодуль.ОтключениеМодуля();
		MCPVAСлужебныйМодуль = Неопределено;
	КонецЕсли;
	ВводТекстаВыполняется = Ложь;
	ВремяНачалаВводаТекста = 0;
	Ванесса = Неопределено;
КонецФункции	 

// Выполняет регистрацию инструментов MCP
&НаКлиенте
Процедура ЗарегистрироватьИнструментыMCP() Экспорт
	
	ПараметрыСозданияMCP = Новый Структура;
	ПараметрыСозданияMCP.Вставить("МодульМсп_Сервер", МодульМсп_Сервер());
	ПараметрыСозданияMCP.Вставить("МодульМсп_СхемаПараметров", Вычислить("Мсп_СхемаПараметров"));

	ВызватьРегистрациюИнструментовMCP(ПараметрыСозданияMCP);

КонецПроцедуры

// Вызывает регистрацию всех инструментов MCP с переданными модулями сервера и схемы.
// Используется штатной регистрацией (client_mcp) и внешним транспортом (плагин MCPRagSearch).
&НаКлиенте
Процедура ВызватьРегистрациюИнструментовMCP(ПараметрыСозданияMCP) Экспорт

	Инструменты = MCPVAСлужебныйМодуль.MCPОписанияИнструментов();
	Всего = Инструменты.Количество();
	Зарегистрировано = 0;
	Отключено = 0;
	Для Каждого Описание Из Инструменты Цикл
		Если Не Описание.Отключен Тогда
			MCPЗарегистрироватьИнструментПоОписанию(ПараметрыСозданияMCP, Описание);
			Зарегистрировано = Зарегистрировано + 1;
		Иначе
			Отключено = Отключено + 1;
		КонецЕсли;
	КонецЦикла;
	MCPЗаписатьСлужебныеДанные("РегистрацияИнструментов", Новый Структура("Всего, Зарегистрировано, Отключено", Всего, Зарегистрировано, Отключено));

КонецПроцедуры

// Отменяет регистрацию инструментов MCP
&НаКлиенте
Функция ОтменитьРегистрациюMCP() Экспорт
	модульМсп_РеестрКлиент = Вычислить("Мсп_РеестрКлиент");
	модульМсп_РеестрКлиент.ОтменитьРегистрациюПровайдера(ИмяПровайдера());
КонецФункции	

&НаКлиенте
Процедура ВызватьОшибкуMCP(ТекстСообщения, КонтекстMCP = Неопределено) Экспорт
	
	ИдентификаторОшибки = MCPИдентификаторИзКонтекста(КонтекстMCP);
	Если НЕ ЗначениеЗаполнено(ИдентификаторОшибки) Тогда
		ИдентификаторОшибки = Ванесса.ИдентификаторЗадачиMCP();
	КонецЕсли;	
	MCPЗаписатьСлужебныеДанные("ОтветОшибкой", Новый Структура("Код, ЕстьТекст, Идентификатор", "ACTION_FAILED", ЗначениеЗаполнено(ТекстСообщения), ИдентификаторОшибки));
	Если ЗначениеЗаполнено(ИдентификаторОшибки) Тогда
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторОшибки, "ACTION_FAILED", MCPТекстБезНедопустимыхСимволовXML(ТекстСообщения));
	Иначе
		MCPЗаписатьСлужебныеДанные("MCP.ПустойИдентификаторЗапроса", Новый Структура("Код, Текст", "ACTION_FAILED", ТекстСообщения));
	КонецЕсли;	
	// Ошибка загрузки могла ответить вызову, который ждёт готовности дерева: снимаем ожидание,
	// иначе повторитель обработает вызов ещё раз и отправит второй ответ
	Если глMCPДедлайнОжиданияЗагрузкиФичи <> Неопределено
		И ИдентификаторОшибки = глMCPИдентификаторЗадачиОжиданияЗагрузки Тогда
		MCPСброситьСостояниеОжиданияЗагрузкиФичи();
	КонецЕсли;	
КонецПроцедуры

// Обёртка над методом основной формы: защищает диагностику от сбоев и недоступной основной формы.
&НаКлиенте
Процедура MCPЗаписатьСлужебныеДанные(ИмяСобытия, Данные = Неопределено)
	Если Ванесса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Ванесса.MCPЗаписатьСлужебныеДанные(ИмяСобытия, Данные);
	Исключение
		// Диагностика не должна влиять на работу MCP
	КонецПопытки;
КонецПроцедуры

// Формирует контекст отложенного вызова: идентификатор и токен прогресса принадлежат только этому запросу.
&НаКлиенте
Функция MCPНовыйКонтекстЗапроса(Запрос) Экспорт
	
	Идентификатор = "";
	Попытка
		Идентификатор = Запрос.Идентификатор;
	Исключение
	КонецПопытки;
	
	Контекст = Новый Структура;
	Контекст.Вставить("ИдентификаторЗапроса", Идентификатор);
	Контекст.Вставить("ТокенПрогресса", MCPVAСлужебныйМодуль.ПрогрессТокенИзЗапроса(Запрос));
	Возврат Контекст;
	
КонецФункции

// Добавляет контекст запроса в структуру, которая уходит в асинхронный обработчик.
&НаКлиенте
Функция MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос) Экспорт
	
	Контекст = MCPНовыйКонтекстЗапроса(Запрос);
	ДопПараметры.Вставить("КонтекстMCP", Контекст);
	Возврат Контекст;
	
КонецФункции

// Достаёт контекст из дополнительных параметров обработчика.
// Старые поля Идентификатор и MCPИдентификаторЗапроса поддерживаются для совместимости.
&НаКлиенте
Функция MCPКонтекстИзДопПараметров(ДопПараметры) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		Если ДопПараметры.Свойство("КонтекстMCP") Тогда
			Контекст = ДопПараметры.КонтекстMCP;
			Если ТипЗнч(Контекст) = Тип("Структура") Тогда
				Возврат Контекст;
			КонецЕсли;
		КонецЕсли;
		
		Идентификатор = "";
		Если ДопПараметры.Свойство("MCPИдентификаторЗапроса") Тогда
			Идентификатор = ДопПараметры.MCPИдентификаторЗапроса;
		ИначеЕсли ДопПараметры.Свойство("Идентификатор") Тогда
			Идентификатор = ДопПараметры.Идентификатор;
		КонецЕсли;
		Возврат Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", Идентификатор, Неопределено);
	КонецЕсли;
	
	Возврат Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", "", Неопределено);
	
КонецФункции

// Возвращает идентификатор из контекста отложенного вызова.
&НаКлиенте
Функция MCPИдентификаторИзКонтекста(Контекст) Экспорт
	
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Если Контекст.Свойство("ИдентификаторЗапроса") Тогда
			Возврат Контекст.ИдентификаторЗапроса;
		КонецЕсли;
		Если Контекст.Свойство("Идентификатор") Тогда
			Возврат Контекст.Идентификатор;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Завершает отложенный вызов успешно, не используя общий слот идентификатора.
&НаКлиенте
Процедура MCPЗавершитьВызовУспешно(Контекст, Текст) Экспорт
	
	Идентификатор = MCPИдентификаторИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		MCPЗаписатьСлужебныеДанные("MCP.ПустойИдентификаторЗапроса",
			Новый Структура("Код, Текст", "", Текст));
		Возврат;
	КонецЕсли;
	МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Идентификатор,
		MCPТекстБезНедопустимыхСимволовXML(Текст));
	
КонецПроцедуры

// Завершает отложенный вызов ошибкой, не используя общий слот идентификатора.
&НаКлиенте
Процедура MCPЗавершитьВызовСОшибкой(Контекст, КодОшибки, Текст) Экспорт
	
	Идентификатор = MCPИдентификаторИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		MCPЗаписатьСлужебныеДанные("MCP.ПустойИдентификаторЗапроса",
			Новый Структура("Код, Текст", КодОшибки, Текст));
		Возврат;
	КонецЕсли;
	МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Идентификатор, КодОшибки,
		MCPТекстБезНедопустимыхСимволовXML(Текст));
	
КонецПроцедуры

// Пишет состояние вкладок редактора в ЖР, не влияя на работу MCP.
&НаКлиенте
Процедура MCPЗаписатьДиагностикуВкладокБезопасно(ИмяСобытия, Данные = Неопределено)
	Попытка
		Если НЕ Ванесса.Объект.AIЗаписыватьСлужебныеДанныеВЖР
			ИЛИ НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
			Возврат;
		КонецЕсли;
		Ванесса.МодульРедакторТекста().MCPЗаписатьДиагностикуВкладок(ИмяСобытия, Данные);
	Исключение
		// Диагностика не должна влиять на работу MCP
	КонецПопытки;
КонецПроцедуры

// Сбрасывает ключи повторов, чтобы в новом прогоне события снова попали в ЖР.
&НаКлиенте
Процедура MCPСброситьКлючиПовторов()
	глMCPПоследнийКлючВыбранногоРезультата = Неопределено;
	глMCPПоследнийКлючНетДанных = Неопределено;
	глMCPПоследнийКлючПрерванногоРезультата = Неопределено;
	глMCPПоследнийКлючНесогласованногоСостояния = Неопределено;
	глMCPПоследнийКлючНетДанныхСостояния = Неопределено;
	глMCPПричинаОстановкиПрогона = Неопределено;
КонецПроцедуры

// Возвращает причину остановки прогона для сообщений о незавершённых сценариях.
&НаКлиенте
Функция MCPТекстПричиныОстановкиПрогона()
	Если глMCPПричинаОстановкиПрогона = "stop_scenario" Тогда
		Возврат Ванесса.Локализовать("выполнение остановлено вызовом stop_scenario.");
	КонецЕсли;
	Возврат Ванесса.Локализовать("выполнение было остановлено до завершения сценария (точка останова, кнопка остановки или настройка остановки при ошибке).");
КонецФункции

// Сброс из основной формы при старте любого прогона, в том числе запущенного из интерфейса.
&НаКлиенте
Процедура СброситьКлючиПовторовДиагностики() Экспорт
	MCPСброситьКлючиПовторов();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога) Экспорт
	MCPVAСлужебныйМодуль.ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога);
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментовMCP

// Возвращает строку json со всеми доступными шагами
&НаКлиенте
Функция ВсеДоступныеШагиMCP(Запрос, ДополнительныеПараметры) Экспорт

    Возврат ВсеДоступныеШагиMCPРеализация();

КонецФункции

// Возвращает строку json с шагами, которые были найдены по строке поиска
// Пример строки поиска: кнопка|кнопки|кнопку
&НаКлиенте
Функция ПоискШаговПоСтроке(Запрос, ДополнительныеПараметры) Экспорт
	search_name = Строка(ЗначениеПараметраИзЗапроса(Запрос, "search_name"));
	exclude_name = Строка(ЗначениеПараметраИзЗапроса(Запрос, "exclude_name"));
	search_description = Строка(ЗначениеПараметраИзЗапроса(Запрос, "search_description"));
	exclude_description = Строка(ЗначениеПараметраИзЗапроса(Запрос, "exclude_description"));
	search_type = Строка(ЗначениеПараметраИзЗапроса(Запрос, "search_type"));
	exclude_type = Строка(ЗначениеПараметраИзЗапроса(Запрос, "exclude_type"));
	limit = 20;
	ЗначениеЛимита = ЗначениеПараметраИзЗапроса(Запрос, "limit");
	// MCP-клиент может передать null для неуказанных параметров, в 1С это Неопределено
	Если ЗначениеЛимита <> "" И ЗначениеЛимита <> Null И ЗначениеЛимита <> Неопределено Тогда
		Попытка
			limit = Цел(Число(ЗначениеЛимита));
		Исключение
			limit = 20;
		КонецПопытки;
	КонецЕсли;
	
	ТолькоЦиклы = ЗначениеПараметраИзЗапроса(Запрос, "loops_only");
	Если ТолькоЦиклы = Неопределено Тогда
		ТолькоЦиклы = Ложь;
	Иначе
		Попытка
			ТолькоЦиклы = Булево(ТолькоЦиклы);
		Исключение
			ТекстСообщения = Ванесса.Локализовать("Параметр loops_only передан некорректно") + Символы.ПС + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
	ТолькоУсловия = ЗначениеПараметраИзЗапроса(Запрос, "conditions_only");
	Если ТолькоУсловия = Неопределено Тогда
		ТолькоУсловия = Ложь;
	Иначе
		Попытка
			ТолькоУсловия = Булево(ТолькоУсловия);
		Исключение
			ТекстСообщения = Ванесса.Локализовать("Параметр conditions_only передан некорректно") + Символы.ПС + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецПопытки;
	КонецЕсли;	
	
	КомпактныйВывод = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "compact", Истина);

    Возврат ПоискШаговПоСтрокеMCP(search_name, exclude_name, search_description, exclude_description, search_type, exclude_type, limit, ТолькоЦиклы, ТолькоУсловия, КомпактныйВывод);
	
КонецФункции

// Возвращает строку json с шагами, которые были найдены по строке поиска
// Пример строки поиска: кнопка|кнопки|кнопку
&НаКлиенте
Функция ПолучитьИмяЗаголовокАктивногоОкнаИФормы(Запрос, ДополнительныеПараметры) Экспорт
	type = Строка(ЗначениеПараметраИзЗапроса(Запрос, "type"));
	Если type = "window_caption" ИЛИ type = "navigation_link" ИЛИ type = "form_name" ИЛИ type = "form_caption" Тогда
		
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Передано неправильное значение параметра type. Допустимые варианты: window_caption, navigation_link, form_name, form_caption");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	       
	Если type = "window_caption" Тогда
		Возврат АктивноеОкно.Заголовок;
	ИначеЕсли type = "navigation_link" Тогда
		Попытка
			НавСсылка = АктивноеОкно.НавигационнаяСсылка;
		Исключение
			ТекстСообщения = Ванесса.Локализовать("У активного окна <%1> нет навигационной ссылки.");
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(ТекстСообщения, АктивноеОкно.Заголовок);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(НавСсылка) Тогда
			ТекстСообщения = Ванесса.Локализовать("У активного окна <%1> нет навигационной ссылки.");
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(ТекстСообщения, АктивноеОкно.Заголовок);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
		КонецЕсли;	
		
		Возврат НавСсылка;
	ИначеЕсли type = "form_name" Тогда
		Попытка
			ТестируемаяФорма = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяФорма"));
			Возврат ТестируемаяФорма.ИмяФормы;
		Исключение
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	ИначеЕсли type = "form_caption" Тогда
		Попытка
			ТестируемаяФорма = АктивноеОкно.НайтиОбъект(Тип("ТестируемаяФорма"));
			Возврат ТестируемаяФорма.ТекстЗаголовка;
		Исключение
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Передано неправильное значение параметра type. Допустимые варианты: window_caption, navigation_link, form_name, form_caption");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
КонецФункции

// Возвращает информацию об элементах текущей формы
&НаКлиенте
Функция ПолучитьИнформациюОТекущейФорме(Запрос, ДополнительныеПараметры) Экспорт
	
	ФорматВывода = Строка(ЗначениеПараметраИзЗапроса(Запрос, "format"));
	Если НЕ ЗначениеЗаполнено(ФорматВывода) Тогда
		ФорматВывода = "full";
	КонецЕсли;
	
	ИмяТаблицыФормы = "";
	ЗначениеТолькоТаблицы = ЗначениеПараметраИзЗапроса(Запрос, "only_table");
	Если ТипЗнч(ЗначениеТолькоТаблицы) = Тип("Строка") Тогда
		ИмяТаблицыФормы = СокрЛП(ЗначениеТолькоТаблицы);
	КонецЕсли;
	
	ИмяГруппыФормы = "";
	ЗначениеТолькоГруппы = ЗначениеПараметраИзЗапроса(Запрос, "only_group");
	Если ТипЗнч(ЗначениеТолькоГруппы) = Тип("Строка") Тогда
		ИмяГруппыФормы = СокрЛП(ЗначениеТолькоГруппы);
	КонецЕсли;
	
	МаксГлубина = Неопределено;
	ЗначениеМаксГлубины = MCPБезопасноеСвойство(Запрос.Аргументы, "max_depth");
	Если ЗначениеМаксГлубины <> "" И ЗначениеМаксГлубины <> Null И ЗначениеМаксГлубины <> Неопределено Тогда
		Попытка
			МаксГлубина = Число(ЗначениеМаксГлубины);
		Исключение
			МаксГлубина = Неопределено;
		КонецПопытки;
		Если МаксГлубина = Неопределено ИЛИ ТипЗнч(ЗначениеМаксГлубины) = Тип("Булево") ИЛИ МаксГлубина < 1 Тогда
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра max_depth. Нужно передать целое число 1 или больше.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
	ТолькоВидимые = Ложь;
	ЗначениеТолькоВидимых = MCPБезопасноеСвойство(Запрос.Аргументы, "only_visible");
	Если ЗначениеТолькоВидимых <> "" И ЗначениеТолькоВидимых <> Null И ЗначениеТолькоВидимых <> Неопределено Тогда
		Попытка
			ТолькоВидимые = Булево(ЗначениеТолькоВидимых);
		Исключение
			ТолькоВидимые = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Компактный вывод включён по умолчанию: он не теряет данные, только короче. compact=false - прежний подробный вывод.
	Компактно = Истина;
	ЗначениеКомпактно = MCPБезопасноеСвойство(Запрос.Аргументы, "compact");
	Если ЗначениеКомпактно <> "" И ЗначениеКомпактно <> Null И ЗначениеКомпактно <> Неопределено Тогда
		Попытка
			Компактно = Булево(ЗначениеКомпактно);
		Исключение
			Компактно = Истина;
		КонецПопытки;
	КонецЕсли;
	
	// Gherkin-состояние в формате full включено по умолчанию, независимо от компактности дерева.
	ВыводитьGherkin = Истина;
	ЗначениеGherkin = MCPБезопасноеСвойство(Запрос.Аргументы, "gherkin");
	Если ЗначениеGherkin <> "" И ЗначениеGherkin <> Null И ЗначениеGherkin <> Неопределено Тогда
		Попытка
			ВыводитьGherkin = Булево(ЗначениеGherkin);
		Исключение
			ВыводитьGherkin = Истина;
		КонецПопытки;
	КонецЕсли;
	
	// Gherkin-состояние по умолчанию компактное: пустые значения скрываются, 'all' возвращает полное состояние.
	РежимGherkin = "filled";
	ЗначениеРежимаGherkin = MCPБезопасноеСвойство(Запрос.Аргументы, "gherkin_mode");
	Если ЗначениеРежимаGherkin <> "" И ЗначениеРежимаGherkin <> Null И ЗначениеРежимаGherkin <> Неопределено Тогда
		РежимGherkin = НРег(СокрЛП(Строка(ЗначениеРежимаGherkin)));
	КонецЕсли;
	Если РежимGherkin <> "all" И РежимGherkin <> "filled" И РежимGherkin <> "compact" Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр gherkin_mode должен быть 'all', 'filled' или 'compact'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Вид легенды компактного дерева: полная по умолчанию; 'short' - короче, 'none' - без легенды.
	РежимЛегенды = "full";
	ЗначениеРежимаЛегенды = MCPБезопасноеСвойство(Запрос.Аргументы, "legend");
	Если ЗначениеРежимаЛегенды <> "" И ЗначениеРежимаЛегенды <> Null И ЗначениеРежимаЛегенды <> Неопределено Тогда
		РежимЛегенды = НРег(СокрЛП(Строка(ЗначениеРежимаЛегенды)));
	КонецЕсли;
	Если РежимЛегенды <> "full" И РежимЛегенды <> "short" И РежимЛегенды <> "none" Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр legend должен быть 'full', 'short' или 'none'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Меню формы в дерево по умолчанию не включаются (include_menus=true добавляет их):
	// так ответ содержит только интерактивные элементы, а меню остаются достижимыми явным флагом.
	ВключатьМеню = Ложь;
	ЗначениеВключатьМеню = MCPБезопасноеСвойство(Запрос.Аргументы, "include_menus");
	Если ЗначениеВключатьМеню <> "" И ЗначениеВключатьМеню <> Null И ЗначениеВключатьМеню <> Неопределено Тогда
		Попытка
			ВключатьМеню = Булево(ЗначениеВключатьМеню);
		Исключение
			ВключатьМеню = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Если ФорматВывода <> "full" И ФорматВывода <> "gherkin" И ФорматВывода <> "elements" И ФорматВывода <> "messages" И ФорматВывода <> "buttons" Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр format должен быть 'full', 'gherkin' или 'elements' или 'buttons' или 'messages'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТаблицыФормы) И ФорматВывода <> "elements" И ФорматВывода <> "full" И ФорматВывода <> "buttons" Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр only_table применим только к форматам 'elements', 'full' и 'buttons': в остальных форматах данные таблиц формы не возвращаются.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТаблицыФормы) И ЗначениеЗаполнено(ИмяГруппыФормы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры only_table и only_group нельзя указывать одновременно: выберите что-то одно - таблицу формы или группу формы.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// compact и gherkin в проверке не участвуют: при форматах без дерева они просто не применяются.
	Если ЗначениеЗаполнено(ИмяГруппыФормы)
		И ФорматВывода <> "elements" И ФорматВывода <> "full" И ФорматВывода <> "buttons" Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр only_group применим только к форматам 'elements', 'full' и 'buttons': в остальных форматах дерево элементов формы не возвращается.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если (МаксГлубина <> Неопределено ИЛИ ТолькоВидимые)
		И ФорматВывода <> "elements" И ФорматВывода <> "full" Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры max_depth и only_visible применимы только к форматам 'elements' и 'full': в остальных форматах дерево элементов формы не возвращается.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Если ФорматВывода = "messages" Тогда
		CообщенияПользователю = ПолучитьСообщенияПользователюИзОкна(АктивноеОкно);
		Если CообщенияПользователю = Неопределено Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В окне <%1> нет сообщений пользователю."), АктивноеОкно.Заголовок);
		Иначе	
			ТекстСообщения = Ванесса.Локализовать("## Обнаружены сообщения пользователю:") + Символы.ПС + Ванесса._СтрСоединить(CообщенияПользователю, Символы.ПС);
			Возврат ТекстСообщения;
		КонецЕсли;	
	КонецЕсли;	
	
	КонтекстMCP = MCPНовыйКонтекстЗапроса(Запрос);
	Если ФорматВывода = "elements" Или ФорматВывода = "buttons" Или ФорматВывода = "full" Тогда
		MCPДанныеИсследователяФормы(КонтекстMCP, ФорматВывода, ИмяТаблицыФормы, ИмяГруппыФормы, МаксГлубина, ТолькоВидимые, Компактно, ВыводитьGherkin, ВключатьМеню, РежимGherkin, РежимЛегенды);
		Возврат Неопределено;
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Анализ текущей формы"));
	Строки.Добавить("");
	
	// Получаем Gherkin-состояние формы
	Если ФорматВывода = "gherkin" Тогда
		Попытка
			Ванесса.ПолучитьИзмененияФормыGherkin();
			Gherkin = Ванесса.Объект.СгенерированныйСценарий;
			Gherkin = MCPСжатьGherkinСостояниеФормы(Gherkin, РежимGherkin);
			Если ЗначениеЗаполнено(Gherkin) Тогда
				Строки.Добавить(Ванесса.Локализовать("## Gherkin-состояние формы"));
				Строки.Добавить("```gherkin");
				Строки.Добавить(Gherkin);
				Строки.Добавить("```");
				Строки.Добавить("");
			Иначе
				Строки.Добавить(Ванесса.Локализовать("## Gherkin-состояние формы"));
				Строки.Добавить(Ванесса.Локализовать("Нет данных."));
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("## Следующие шаги"));
				Если MCPКлиентТестированияПодключен() Тогда
					Строки.Добавить(Ванесса.Локализовать("- Клиент тестирования подключён, но форма не вернула Gherkin-состояние: в форме нет видимых элементов или активное окно не является формой."));
					Строки.Добавить(Ванесса.Локализовать("- Проверьте активное окно (`get_window_list_testclient`, затем `window_management` с `action: activate`) и повторите: `get_form_analysis`; дерево элементов доступно в формате `elements`"));
				Иначе
					Строки.Добавить(Ванесса.Локализовать("- Подключите клиента тестирования: `manage_test_client` с `action: connect`"));
					Строки.Добавить(Ванесса.Локализовать("- Затем повторите: `get_form_analysis`"));
				КонецЕсли;
				Строки.Добавить("");
			КонецЕсли;
		Исключение
			Строки.Добавить(Ванесса.Локализовать("## Gherkin-состояние формы"));
			Строки.Добавить(Ванесса.Локализовать("ошибка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("## Следующие шаги"));
			Если MCPКлиентТестированияПодключен() Тогда
				Строки.Добавить(Ванесса.Локализовать("- Повторите вызов: `get_form_analysis`"));
			Иначе
				Строки.Добавить(Ванесса.Локализовать("- Подключите клиента тестирования: `manage_test_client` с `action: connect`"));
				Строки.Добавить(Ванесса.Локализовать("- Затем повторите: `get_form_analysis`"));
			КонецЕсли;
			Строки.Добавить("");
		КонецПопытки;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Выполняет один шаг произвольным текстом
&НаКлиенте
Функция ВыполнитьОдинШагТекстом(Запрос, ДополнительныеПараметры) Экспорт
	
	ТекстШага = Строка(ЗначениеПараметраИзЗапроса(Запрос, "stepText"));
	Если ЗначениеЗаполнено(ТекстШага) Тогда
		ТекстШага = СокрЛП(Строка(ТекстШага));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТекстШага) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр stepText обязателен и не может быть пустым.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		ТекстСообщения = Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;
	
	Идентификатор = Запрос.Идентификатор;
	ДопПараметрыШага = Новый Структура;
	ДопПараметрыШага.Вставить("Идентификатор", Идентификатор);
	КонтекстMCP = MCPДобавитьКонтекстВДопПараметры(ДопПараметрыШага, Запрос);
	
	Попытка
		// Пока шаг выполняется, диагностика MCP дополняет ошибки подробностями
		Ванесса.УстановитьПризнакВыполненияОперацииMCP(Истина);
		Ванесса.Шаг(ТекстШага, Ложь, ДопПараметрыШага);
	Исключение
		Ванесса.УстановитьПризнакВыполненияОперацииMCP(Ложь);
		ТекстСообщения = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

