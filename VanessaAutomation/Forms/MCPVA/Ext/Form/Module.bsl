// Табличный документ: get_formatted_string_hyperlink_presentations (поля форматированной строки - без гейта вида)
&НаКлиенте
Функция ПолучитьПредставленияГиперссылокФорматированнойСтрокиMCP(ИмяЭлемента)
	Если НЕ Ванесса.Версия8325ИлиВыше Тогда
		Возврат ОшибкаТребуемойВерсии("get_formatted_string_hyperlink_presentations", "8.3.25");
	КонецЕсли;
	
	// Элемент ищем без фильтра по типу и без выброса исключения: у надписей и декораций
	// гиперссылок форматированной строки нет, и вместо "элемент не найден" нужна точная причина.
	ЭлементФормы = Неопределено;
	Попытка
		ДопПараметрыПоиска = Новый Структура("КоличествоПопыток", 1);
		ЭлементФормы = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина, Ложь,, ДопПараметрыПоиска);
	Исключение
		ЭлементФормы = Неопределено;
	КонецПопытки;
	
	Если ЭлементФормы = Неопределено Тогда
		Возврат ОшибкаЭлементНеНайденMCP(ИмяЭлемента);
	КонецЕсли;
	
	Если ТипЗнч(ЭлементФормы) <> Тип("ТестируемоеПолеФормы") Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPVAСлужебныйМодуль.MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Элемент '%1' есть на форме, но это %2, а не поле ввода."),
					ИмяЭлемента, MCPОписаниеВидаЭлемента(ЭлементФормы)),
				Ванесса.Локализовать("Гиперссылки форматированной строки есть только у полей ввода. Вид элемента и его заголовок смотрите через get_form_analysis (format=elements).")));
	КонецЕсли;
	
	Попытка
		Представления = ЭлементФормы.ПолучитьПредставленияГиперссылокФорматированнойСтроки();
		Строки = Новый Массив;
		Номер = 0;
		Для Каждого Представление Из Представления Цикл
			Строки.Добавить("" + Номер + ": " + Представление);
			Номер = Номер + 1;
		КонецЦикла;
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("У поля '%1' гиперссылок нет (список представлений пуст)."),
				ИмяЭлемента);
		КонецЕсли;
		// Представления конкатенируются после подстановки: в представлении гиперссылки может быть %1
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Представления гиперссылок поля '%1' (индексы с 0):"), ИмяЭлемента)
			+ Символы.ПС + Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		// Платформа отказывает и обычным полям ввода (без форматированной строки) — объясняем это текстом,
		// а не отдаём техническое сообщение «Неподходящий тип элемента управления».
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPVAСлужебныйМодуль.MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Не получилось получить представления гиперссылок поля '%1' (вид элемента: %2)."),
					ИмяЭлемента, MCPОписаниеВидаЭлемента(ЭлементФормы)),
				Ванесса.Локализовать("Поле ввода без форматированной строки гиперссылок не имеет: гиперссылки бывают только у полей с форматированной строкой. Вид и заголовок элемента смотрите через get_form_analysis (format=elements)."),
				MCPVAСлужебныйМодуль.MCPДеталиОшибкиИзТекста(ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()))));
	КонецПопытки;
КонецФункции

// Человекочитаемое описание вида элемента формы для текстов ошибок (Надпись, Поле надписи, Кнопка, ...).
&НаКлиенте
Функция MCPОписаниеВидаЭлемента(ЭлементФормы)
	Попытка
		Вид = ЭлементФормы.Вид;
		Если Вид <> Неопределено Тогда
			Возврат Строка(Вид);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(ЭлементФормы));
	Исключение
		Возврат Ванесса.Локализовать("элемент неизвестного вида");
	КонецПопытки;
КонецФункции

