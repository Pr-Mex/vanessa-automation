// Внутренняя функция для получения выделенных строк таблицы
&НаКлиенте
Функция ПолучитьВыделенныеСтрокиТаблицы(ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'get_selected_rows' необходимо указать параметр table_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
		Если Таблица = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' не найдена."), ИмяТаблицы);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		ВыделенныеСтроки = Таблица.ПолучитьВыделенныеСтроки();
		
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("# Данные выделенных строк таблицы '%1'") + " " + ИмяТаблицы);
		Строки.Добавить("");
		
		ЗначениеЭлемента = Ванесса.ПолучитьСтрокуСТЧФормаTestClient(ВыделенныеСтроки, Неопределено);
		Строки.Добавить(ЗначениеЭлемента);
		
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Количество выделенных строк в таблице (может не совпадать с общим количеством строк таблицы): ") + Формат(ВыделенныеСтроки.Количество(), "ЧГ=0; ЧН=0"));
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка получения данных строки таблицы:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для создания нового элемента
&НаКлиенте
Функция СоздатьНовый(ИмяЭлемента, ИмяТаблицы)
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
			Поле = Таблица.НайтиОбъект(,,ИмяЭлемента);
			Если Поле = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено в таблице '%2'."), ИмяЭлемента, ИмяТаблицы);
				ДополнитьОшибку_НетПоляТаблицыMCP(Таблица, ТекстОшибки);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			Поле.Активизировать();
			Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
				Таблица.ИзменитьСтроку();
			КонецЕсли;
			
			Ванесса.ЯНажимаюНаКнопкуСоздатьПоля(ИмяЭлемента, Истина);
		Иначе
			Ванесса.ЯНажимаюНаКнопкуСоздатьПоля(ИмяЭлемента, Истина);
		КонецЕсли;
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("У поля '%1' вызвана команда создания нового элемента."), ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка создания нового элемента:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

