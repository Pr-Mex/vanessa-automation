	КонецПопытки;
	
	ТекстОшибки = Неопределено;
	
	Попытка
		// Очищаем сообщения пользователю в активном окне
		АктивноеОкно.ЗакрытьПанельСообщенийПользователю();
		
		Возврат Ванесса.Локализовать("Окно сообщений пользователю было успешно очищено.");
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка очистки окна сообщений:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для выбора из списка выбора формы
&НаКлиенте
Функция ВыбратьИзСпискаВыбораФормы(Значение)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'select_from_form_dropdown' необходимо указать параметр value.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		
		ТекущаяФорма = Ванесса.НайтиТекущуюФормуTestClient();
		ТекущаяФорма.ВыполнитьВыборИзСписка(Значение);
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Значение '%1' было успешно выбрано из списка выбора, привязанного к форме."), Значение);
		
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка выбора из списка выбора формы:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Универсальный инструмент для управления записью действий пользователя
&НаКлиенте
Функция ЗаписьДействийПользователя(Запрос, ДополнительныеПараметры) Экспорт
	
	Идентификатор = Запрос.Идентификатор;
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
	
	// Получаем параметр action (по умолчанию 'start')
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Действие = "start";
	Иначе
		Действие = НРег(СокрЛП(Действие));
	КонецЕсли;
	
	// Проверка допустимого значения
	Если Действие <> "start" И Действие <> "stop" Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение action. Допустимые значения: 'start' (начать запись), 'stop' (остановить запись и получить шаги).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	Если Действие = "start" Тогда
		// Начинаем запись действий пользователя
		Попытка
			Ванесса.НачатьЗаписьДействийПользователяЭкспорт();
			Возврат Ванесса.Локализовать("# Запись действий начата
			|
			|- Статус: запись включена
			|
			|## Следующие шаги
			|- Выполните действия пользователя в клиенте тестирования
			|- Вызовите user_actions_recording с action='stop' для получения шагов");
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка начала записи действий:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	ИначеЕсли Действие = "stop" Тогда
		// Останавливаем запись и получаем шаги в формате Turbo Gherkin
		Попытка
			Ванесса.ЗавершитьЗаписьДействийПользователяЭкспорт();
			ТекстСценария = Ванесса.Объект.СгенерированныйСценарий;
			
			Если ЗначениеЗаполнено(ТекстСценария) Тогда
				Возврат "# Запись действий остановлена
				|
				|- Статус: запись выключена
				|
				|## Записанные шаги (Turbo Gherkin)
				|```gherkin
				|" + ТекстСценария + "
				|```";
			Иначе
				Возврат Ванесса.Локализовать("# Запись действий остановлена
				|
				|- Статус: запись выключена
				|
				|- Записанные шаги: не обнаружено действий за время записи");
			КонецЕсли;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка остановки записи действий:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

