// Сокращает текст ответа до МаксДлина символов с пометкой о полном размере.
&НаКлиенте
Функция MCPСократитьТекстДляОтвета(Текст, МаксДлина = 300)
	Текст = Строка(Текст);
	Если СтрДлина(Текст) <= МаксДлина Тогда
		Возврат Текст;
	КонецЕсли;
	Пометка = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("...обрезано (всего %1 символов)"), Формат(СтрДлина(Текст), "ЧГ=0"));
	Возврат Лев(Текст, МаксДлина) + Пометка;
КонецФункции

// Компактное представление значения для сводки по строке таблицы.
&НаКлиенте
Функция MCPКраткоеПредставлениеЗначения(Значение)
	Если Значение = Неопределено Тогда
		Возврат Ванесса.Локализовать("не указано");
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "'" + Значение + "'";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=D");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат Ванесса.Локализовать("да");
		КонецЕсли;
		Возврат Ванесса.Локализовать("нет");
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Компактная сводка по описанию строки таблицы: номер строки плюс до трёх значимых значений.
// Отбор детерминированный: приоритетные имена колонок занимают слоты по порядку,
// оставшиеся слоты добираются первыми непустыми значениями в порядке перебора описания строки.
&НаКлиенте
Функция MCPСводкаПоОписаниюСтроки(ОписаниеСтроки, МаксДлина = 200)
	Если ТипЗнч(ОписаниеСтроки) <> Тип("Соответствие") Тогда
		Возврат MCPСократитьТекстДляОтвета(Строка(ОписаниеСтроки), МаксДлина);
	КонецЕсли;
	
	ПриоритетныеГруппы = Новый Массив;
	ПриоритетныеГруппы.Добавить("НомерСтроки,N");
	ПриоритетныеГруппы.Добавить("Наименование,Номенклатура");
	ПриоритетныеГруппы.Добавить("Количество");
	ПриоритетныеГруппы.Добавить("Сумма,Цена");
	
	// Значимые (непустые) значения в порядке колонок таблицы
	Значимые = Новый Массив;
	Для Каждого КлючЗначение Из ОписаниеСтроки Цикл
		Значение = КлючЗначение.Значение;
		Если Значение = Неопределено Или Значение = Null Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") И НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Значимые.Добавить(КлючЗначение);
	КонецЦикла;
	
	ИспользованныеКлючи = Новый Соответствие;
	ПарыСводки = Новый Массив;
	Для Каждого Группа Из ПриоритетныеГруппы Цикл
		Имена = Ванесса._СтрРазделить(Группа, ",", Ложь);
		Найденное = Неопределено;
		Для Каждого ТекКлючЗначение Из Значимые Цикл
			ИмяКолонки = СокрЛП(Строка(ТекКлючЗначение.Ключ));
			Для Каждого ИмяПриоритета Из Имена Цикл
				Если НРег(ИмяКолонки) = НРег(СокрЛП(ИмяПриоритета)) Тогда
					Найденное = ТекКлючЗначение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Найденное <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найденное <> Неопределено И ИспользованныеКлючи[СокрЛП(Строка(Найденное.Ключ))] = Неопределено Тогда
			ИспользованныеКлючи.Вставить(СокрЛП(Строка(Найденное.Ключ)), Истина);
			ПарыСводки.Добавить(Найденное);
		КонецЕсли;
	КонецЦикла;
	
	// Добираем оставшиеся слоты первыми непустыми значениями в порядке колонок
	Для Каждого ТекКлючЗначение Из Значимые Цикл
		Если ПарыСводки.Количество() >= 4 Тогда
			Прервать;
		КонецЕсли;
		Если ИспользованныеКлючи[СокрЛП(Строка(ТекКлючЗначение.Ключ))] = Неопределено Тогда
			ИспользованныеКлючи.Вставить(СокрЛП(Строка(ТекКлючЗначение.Ключ)), Истина);
			ПарыСводки.Добавить(ТекКлючЗначение);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСводки = Новый Массив;
	Для Каждого ТекКлючЗначение Из ПарыСводки Цикл
		СтрокиСводки.Добавить(Строка(ТекКлючЗначение.Ключ) + "=" + MCPКраткоеПредставлениеЗначения(ТекКлючЗначение.Значение));
	КонецЦикла;
	
	Возврат MCPСократитьТекстДляОтвета(Ванесса._СтрСоединить(СтрокиСводки, ", "), МаксДлина);
КонецФункции

