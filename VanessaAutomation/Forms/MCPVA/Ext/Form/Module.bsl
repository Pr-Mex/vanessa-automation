КонецФункции

// Внутренняя функция для ввода текста в поле
&НаКлиенте
Функция ВвестиТекстВПоле(ИмяЭлемента, Значение, ИмяТаблицы)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'input_text' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'input_text' необходимо указать параметр value.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			ВыделеноБольшеОднойСтроки = Ложь;
			Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
			Попытка
				ВыделенныеСтроки = Таблица.ПолучитьВыделенныеСтроки();
				Если ВыделенныеСтроки.Количество() > 1 Тогда
					ВыделеноБольшеОднойСтроки = Истина;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			Если ВыделеноБольшеОднойСтроки Тогда
				ТекстОшибки = Ванесса.Локализовать("В таблице выделено больше одной строки. Редактирование не возможно.");
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			Ванесса.ВОткрытойФормеВТЧВПолеСЗаголовкомЯВвожуТекст(ИмяТаблицы, ИмяЭлемента, Значение, Истина, ДопПараметры);
		Иначе
			Поле = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
			Поле.ВвестиТекст(Значение);
		КонецЕсли;
		
		Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Текст '%1' был успешно введен в поле '%2'."), Значение, ИмяЭлемента);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка ввода текста:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Ванесса.ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для открытия выпадающего списка
&НаКлиенте
Функция ОткрытьВыпадающийСписок(ИмяЭлемента, ИмяТаблицы, ОткрыватьСписок)
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для действия 'open_dropdown' необходимо указать параметр element_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("КоличествоПопыток", 1);
	
	Попытка
		Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
			// Поиск в таблице
			Таблица = Ванесса.НайтиТЧПоИмени(ИмяТаблицы);
			Если Таблица = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Таблица '%1' не найдена."), ИмяТаблицы);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			Поле = Таблица.НайтиОбъект(,,ИмяЭлемента);
			Если Поле = Неопределено Тогда
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено в таблице '%2'."), ИмяЭлемента, ИмяТаблицы);
				Ванесса.ДополнитьОшибку_НетПоляТаблицыMCP(Таблица, ТекстОшибки);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;
			
			Если ОткрыватьСписок Тогда
				Поле.Активизировать();
				
				Если НЕ Таблица.ТекущийРежимРедактирование() Тогда
					Таблица.ИзменитьСтроку();
				КонецЕсли;
			КонецЕсли;
		Иначе
			Поле = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку(ИмяЭлемента, Истина,,,ДопПараметры);
		КонецЕсли;
		
		Если Поле = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Поле '%1' не найдено."), ИмяЭлемента);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		Если ОткрыватьСписок Тогда
			Если НЕ Поле.ВыпадающийСписокОткрыт() Тогда
				Поле.ОткрытьВыпадающийСписок();
			КонецЕсли;	
			Поле.ОжидатьФормированияВыпадающегоСписка();
		КонецЕсли;	
		
		Попытка
			ПредставлениеСпискаВыбора = Ванесса.ДополнитьПредставлениеСпискаВыбора(Поле.ПолучитьПредставлениеСпискаВыбора());
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Не вышло получить представление открытого списка выбора <%1>.");
			ТекстОшибки = СтрЗаменить(ТекстОшибки,"%1",ИмяЭлемента);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
		Строки = Новый Массив;
		Если ОткрыватьСписок Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Выпадающий список поля '%1' был успешно открыт."), ИмяЭлемента));
			Строки.Добавить(Ванесса.Локализовать("Содержимое списка:"));
		Иначе
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Содержимое списка '%1'."), ИмяЭлемента));
		КонецЕсли;	
		Для Каждого Элем Из ПредставлениеСпискаВыбора Цикл
			Строки.Добавить("  -" + Элем.ОтображаемыйТекст);
		КонецЦикла;	
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка открытия выпадающего списка:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Внутренняя функция для выбора из выпадающего списка
