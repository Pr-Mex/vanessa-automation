&НаКлиенте
Процедура ЗавершитьВыборСценария()
	Попытка
		MCPVAСлужебныйМодуль.ЗавершитьВыборСценария(ИдентификаторВыбораMCP);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗаписатьСлужебныеДанные("ВыборСценария.ОшибкаЗавершения", Новый Структура("Идентификатор", ИдентификаторВыбораMCP));
		Попытка
			MCPЗавершитьВызовСОшибкой(Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", ИдентификаторВыбораMCP, Неопределено),
				"ACTION_FAILED", ТекстОшибки);
		Исключение
		КонецПопытки;
	КонецПопытки;
	//Слот освобождаем в любом случае: иначе выбор заблокирован до перезапуска формы
	ИдентификаторВыбораMCP = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборШага()
	Попытка
		MCPVAСлужебныйМодуль.ЗавершитьВыборШага(ИдентификаторВыбораMCP);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗаписатьСлужебныеДанные("ВыборШага.ОшибкаЗавершения", Новый Структура("Идентификатор", ИдентификаторВыбораMCP));
		Попытка
			MCPЗавершитьВызовСОшибкой(Новый Структура("ИдентификаторЗапроса, ТокенПрогресса", ИдентификаторВыбораMCP, Неопределено),
				"ACTION_FAILED", ТекстОшибки);
