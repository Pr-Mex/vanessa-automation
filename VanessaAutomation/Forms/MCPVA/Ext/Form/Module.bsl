// Выполняет один шаг из фича файла
&НаКлиенте
Функция ВыполнитьОдинШагВФичаФайле(Запрос, ДополнительныеПараметры) Экспорт
	
	ПутьКФайлу = Строка(ЗначениеПараметраИзЗапроса(Запрос, "filePath"));
	НомерСтроки = Число(ЗначениеПараметраИзЗапроса(Запрос, "lineNumber"));
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ПутьКФайлу = Ванесса.Объект.КаталогФич;
	КонецЕсли;
	MCPЗаписатьСлужебныеДанные("Шаг.Запрос", Новый Структура("Инструмент, Идентификатор, Файл, НомерСтроки",
		"execute_feature_step", Запрос.Идентификатор, ПутьКФайлу, НомерСтроки));
	
	Если НЕ ЗначениеЗаполнено(НомерСтроки) ИЛИ НомерСтроки < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр lineNumber обязателен и должен быть >= 1.");
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"INVALID_PARAMS", Истина, Запрос.Идентификатор, ПутьКФайлу, НомерСтроки));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Попытка
		ПутьКФайлу = MCPНормализоватьПутьКФичаФайлу(ПутьКФайлу);
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка пути к фича файлу:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗаписатьСлужебныеДанные("Шаг.Отказ", Новый Структура("Код, ЕстьТекст, Идентификатор, Файл, НомерСтроки",
			"INVALID_PARAMS", Истина, Запрос.Идентификатор, ПутьКФайлу, НомерСтроки));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецПопытки;
	
	Идентификатор = Запрос.Идентификатор;
	// Во время прогона не перезаписываем глобальный ИД ожидающего вызова: иначе его отчёт
	// уйдёт не туда, а сброс флагов оставит вызов без ответа
	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		MCPОтветитьОтказомБезСбросаПрогона(Идентификатор, "ACTION_FAILED",
			Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения прогона или вызовите stop_scenario."));
		// Вызов уже завершён отказом; для асинхронного пути возвращаем Неопределено
		Возврат Неопределено;
	КонецЕсли;	
	
	// Открыть/активировать вкладку файла в редакторе
	ДопПараметрыВызоваMCP = Новый Структура;
	ДопПараметрыВызоваMCP.Вставить("ПутьКФайлу", ПутьКФайлу);
	ДопПараметрыВызоваMCP.Вставить("НомерСтроки", НомерСтроки);
	ДопПараметрыВызоваMCP.Вставить("Тип", "ВыполнитьОдинШагВФичаФайле");
	ДопПараметрыВызоваMCP.Вставить("Идентификатор", Идентификатор);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметрыВызоваMCP, Запрос);
	MCPOpenFeatureFileВРедакторе(ПутьКФайлу, "ВыполнитьОдинШагВФичаФайле", ДопПараметрыВызоваMCP, Идентификатор);
	
КонецФункции

// Получает список окон клиента тестирования для снятия скриншотов
&НаКлиенте
Функция ПолучитьСписокОконКлиентаТестированияДляСнятияСкриншотов(Запрос, ДополнительныеПараметры) Экспорт
	
	// Реальная проверка подключения клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	ProcessId = Ванесса.PIDТекущегоКлиентаТестирования();
	Если НЕ ЗначениеЗаполнено(ProcessId) Тогда
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить PID процесса клиента тестирования.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;	
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ProcessId", ProcessId);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученПолучитьСписокОконКлиентаТестированияДляВозвратаИхЗаголовков", ЭтаФорма, ДопПараметры);
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокОкон(ОписаниеОповещения, ProcessId);
	
КонецФункции

// Получает скриншот окна клиента тестирования
&НаКлиенте
Функция ПолучитьСкриншотОкнаКлиентаТестирования(Запрос, ДополнительныеПараметры) Экспорт
	
	ЗаголовокОкна = Строка(ЗначениеПараметраИзЗапроса(Запрос, "window_title"));
	ИмяФайла = Строка(ЗначениеПараметраИзЗапроса(Запрос, "file_name"));
	Если НЕ ЗначениеЗаполнено(ЗаголовокОкна) Тогда
		ТекстОшибки = Ванесса.Локализовать("Не указан обязательный параметр window_title");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Файл = Новый Файл(ИмяФайла);
		КаталогФайла = Файл.Путь;
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(КаталогФайла) Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Некорректное значение параметра file_name. Не найден каталог файла '%1'"), КаталогФайла);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;	
	КонецЕсли;	
	
	// Получаем параметр color_mode (по умолчанию 'grayscale')
	ЦветовойРежим = Строка(ЗначениеПараметраИзЗапроса(Запрос, "color_mode"));
	Если НЕ ЗначениеЗаполнено(ЦветовойРежим) Тогда
		ЦветовойРежим = "grayscale";
	Иначе
		ЦветовойРежим = НРег(СокрЛП(ЦветовойРежим));
		Если ЦветовойРежим <> "color" И ЦветовойРежим <> "grayscale" Тогда
			ТекстОшибки = Ванесса.Локализовать("Некорректное значение параметра color_mode. Допустимые значения: 'grayscale' (черно-белый) или 'color' (цветной).");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	// Реальная проверка подключения клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	ProcessId = Ванесса.PIDТекущегоКлиентаТестирования();
	Если НЕ ЗначениеЗаполнено(ProcessId) Тогда
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить PID процесса клиента тестирования.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;	
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ProcessId", ProcessId);
	ДопПараметры.Вставить("ЗаголовокОкна", ЗаголовокОкна);
	ДопПараметры.Вставить("ИмяФайла", ИмяФайла);
	ДопПараметры.Вставить("ЦветовойРежим", ЦветовойРежим);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученПолучитьСписокОконКлиентаТестированияДляСнятияСкриншотов", ЭтаФорма, ДопПараметры);
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокОкон(ОписаниеОповещения, ProcessId);
	
КонецФункции

&НаКлиенте
Процедура ПолученПолучитьСписокОконКлиентаТестированияДляСнятияСкриншотов(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	ОкнаДляСкриншотов = ПолучитьОкнаДляСкриншотов(РезультатВызова);
	
	Если ОкнаДляСкриншотов.Количество() = 0 Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("У процесса с ID=%1 не найдено окон для снятия скриншотов."), XMLСтрока(ДопПараметры.ProcessId));
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	НужноеОкно = Неопределено;
	Для Каждого ТекОкно Из ОкнаДляСкриншотов Цикл
		Если ТекОкно.ПолныеДанныеОкна.Свойство("Title") И НРег(ТекОкно.ПолныеДанныеОкна.Title) = НРег(ДопПараметры.ЗаголовокОкна) Тогда
			НужноеОкно = ТекОкно;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если НужноеОкно = Неопределено Тогда
		Если ОкнаДляСкриншотов.Количество() = 1 Тогда
			НужноеОкно = ОкнаДляСкриншотов[0];
			
			ИмяНайденногоОкна = "";
			Если НужноеОкно.ПолныеДанныеОкна.Свойство("Title") Тогда
				ИмяНайденногоОкна = НужноеОкно.ПолныеДанныеОкна.Title;
			КонецЕсли;
			
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("У процесса с ID=%1 не найдено окно с заголовком <%2>, но найдено единственное доступное окно для снятия скриншота с заголовком <%3>. Скриншот сделан для этого окна."),
				XMLСтрока(ДопПараметры.ProcessId), ДопПараметры.ЗаголовокОкна, ИмяНайденногоОкна);
			
			ДопПараметры.Вставить("НужноеОкно", НужноеОкно);
			ДопПараметры.Вставить("ОкнаДляСкриншотов", ОкнаДляСкриншотов);
			ДопПараметры.Вставить("ЭтоЕдинственноеОкно", Истина);
			ДопПараметры.Вставить("ТекстСообщенияОЕдинственномОкне", ТекстСообщения);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПолученСнимокОкнаДляВозвратаСкриншота", ЭтаФорма, ДопПараметры);
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСнимокОкна(ОписаниеОповещения,
				НужноеОкно.ПолныеДанныеОкна.window);
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("У процесса с ID=%1 не найдено окно с заголовком <%2>."), XMLСтрока(ДопПараметры.ProcessId), ДопПараметры.ЗаголовокОкна);
		Строки = Новый Массив;
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Важно. Список окон доступных для скриншота может не совпадать с внутренним списком окон клиента тестирования."));
		ДобавитьВСообщениеОкнаДоступныеДляСкриншота(Строки, ОкнаДляСкриншотов);
		ТекстСообщения = ТекстСообщения + Символы.ПС + Ванесса._СтрСоединить(Строки, Символы.ПС);
		
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Вставить("НужноеОкно", НужноеОкно);
	ДопПараметры.Вставить("ОкнаДляСкриншотов", ОкнаДляСкриншотов);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученСнимокОкнаДляВозвратаСкриншота", ЭтаФорма, ДопПараметры);
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСнимокОкна(ОписаниеОповещения,
		НужноеОкно.ПолныеДанныеОкна.window);
		
КонецПроцедуры 

&НаКлиенте
Процедура ПолученСнимокОкнаДляВозвратаСкриншота(ДвоичныеДанные, ПараметрыВызова, ДополнительныеПараметры) Экспорт
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДополнительныеПараметры);
	Если ДвоичныеДанные = Неопределено Тогда
		
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"Не удалось получить снимок экрана.
				|Проверьте настройки компоненты VanessaExt в разделе «Скриншоты».
				|Если используется клиент тестирования, попробуйте сначала активировать его окно."));
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;

	ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
		"# Скриншот клиента тестирования
		|Скриншот клиента тестирования сделан успешно."));

	ЭтоЕдинственноеОкно = Ложь;
	Если ДополнительныеПараметры.Свойство("ЭтоЕдинственноеОкно") И ДополнительныеПараметры.ЭтоЕдинственноеОкно Тогда
		ЭтоЕдинственноеОкно = Истина;
		ТекстОтвета = ТекстОтвета + Символы.ПС + ДополнительныеПараметры.ТекстСообщенияОЕдинственномОкне;
	КонецЕсли;

	Если НЕ ЭтоЕдинственноеОкно Тогда
		Строки = Новый Массив;
		Строки.Добавить(ТекстОтвета);
		ДобавитьВСообщениеОкнаДоступныеДляСкриншота(Строки, ДополнительныеПараметры.ОкнаДляСкриншотов);
		ТекстОтвета = Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	MCPОтправитьРезультатИнструментаСИзображением(ТекстОтвета, ДвоичныеДанные, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолученПолучитьСписокОконКлиентаТестированияДляВозвратаИхЗаголовков(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт
	
	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	ОкнаДляСкриншотов = ПолучитьОкнаДляСкриншотов(РезультатВызова);
	
	Если ОкнаДляСкриншотов.Количество() = 0 Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("У процесса с ID=%1 не найдено окон для снятия скриншотов."), XMLСтрока(ДопПараметры.ProcessId));
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Результат = Новый Массив;
	Результат.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Для снятия скриншотов найдено %1 окон:"), ОкнаДляСкриншотов.Количество()));
	Для Каждого ТекОкно Из ОкнаДляСкриншотов Цикл
		Если НЕ ТекОкно.ПолныеДанныеОкна.Свойство("Title") Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить("  -" + ТекОкно.ПолныеДанныеОкна.Title);
	КонецЦикла;	
	
	ТекстСообщения = Ванесса._СтрСоединить(Результат, Символы.ПС);
	MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстСообщения);

КонецПроцедуры

// Возвращает список процессов ОС (инструмент get_process_list_os)
&НаКлиенте
Функция ПолучитьСписокПроцессовОС(Запрос, ДополнительныеПараметры) Экспорт

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстСообщения = Ванесса.Локализовать("Чтобы получить список процессов нужно в Vanessa Automation включить использование внешней компоненты VanessaExt.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если Ванесса.ВнешняяКомпонентаДляСкриншотов = Неопределено
		ИЛИ ТипЗнч(Ванесса.ВнешняяКомпонентаДляСкриншотов) = Тип("Строка") Тогда
		ТекстСообщения = Ванесса.Локализовать("Внешняя компонента VanessaExt не инициализирована. Перезапустите Vanessa Automation с включённой внешней компонентой.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Only1C = ЗначениеПараметраИзЗапроса(Запрос, "only_1c") = Истина;

	Фильтр = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "filter")));

	Лимит = 100;
	ЗначениеЛимита = ЗначениеПараметраИзЗапроса(Запрос, "limit");
	// MCP-клиент может передать null для неуказанных параметров, в 1С это Неопределено
	Если ЗначениеЛимита <> "" И ЗначениеЛимита <> Null И ЗначениеЛимита <> Неопределено Тогда
		Попытка
			Лимит = Цел(Число(ЗначениеЛимита));
		Исключение
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра limit. Нужно передать число.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	Если Лимит < 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр limit не может быть отрицательным.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Only1C", Only1C);
	ДопПараметры.Вставить("Фильтр", Фильтр);
	ДопПараметры.Вставить("Лимит", Лимит);
	КонтекстMCP = MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученСписокПроцессовОС", ЭтаФорма, ДопПараметры);

	Попытка
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокПроцессов(ОписаниеОповещения, Only1C);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПолученСписокПроцессовОС(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		СписокПроцессов = Ванесса.ПрочитатьСтрокуJSON(РезультатВызова);
		Если ТипЗнч(СписокПроцессов) <> Тип("Массив") Тогда
			ТекстСообщения = Ванесса.Локализовать("Не удалось получить список процессов от внешней компоненты VanessaExt.");
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		ОтобранныеПроцессы = Новый Массив;
		Для Каждого ДанныеПроцесса Из СписокПроцессов Цикл
			Если ТипЗнч(ДанныеПроцесса) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Если ПроцессСоответствуетОтборуMCP(ДанныеПроцесса, ДопПараметры.Фильтр) Тогда
				ОтобранныеПроцессы.Добавить(ДанныеПроцесса);
			КонецЕсли;
		КонецЦикла;

		ПоказанныеПроцессы = ОтобранныеПроцессы;
		Если ДопПараметры.Лимит > 0 И ОтобранныеПроцессы.Количество() > ДопПараметры.Лимит Тогда
			ПоказанныеПроцессы = Новый Массив;
			Для Сч = 0 По ДопПараметры.Лимит - 1 Цикл
				ПоказанныеПроцессы.Добавить(ОтобранныеПроцессы[Сч]);
			КонецЦикла;
		КонецЕсли;

		ТекстОтвета = MCPСформироватьMarkdownСпискаПроцессов(ПоказанныеПроцессы, ОтобранныеПроцессы.Количество(), СписокПроцессов.Количество(), ДопПараметры);
		MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстОтвета);

	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция MCPСформироватьMarkdownСпискаПроцессов(ПоказанныеПроцессы, ВсегоНайдено, ВсегоПроцессов, ДопПараметры)

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Список процессов ОС"));
	Строки.Добавить("");
	Если ЗначениеЗаполнено(ДопПараметры.Фильтр) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено по отбору: %1 из %2. Показано: %3."), ВсегоНайдено, ВсегоПроцессов, ПоказанныеПроцессы.Количество()));
	Иначе
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено: %1. Показано: %2."), ВсегоНайдено, ПоказанныеПроцессы.Количество()));
	КонецЕсли;

	Если ДопПараметры.Only1C Тогда
		Режим = Ванесса.Локализовать("только процессы 1С (only_1c=true)");
	Иначе
		Режим = Ванесса.Локализовать("все процессы (only_1c=false)");
	КонецЕсли;
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Режим: %1."), Режим));

	Если ЗначениеЗаполнено(ДопПараметры.Фильтр) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Отбор: %1."), ДопПараметры.Фильтр));
	КонецЕсли;

	Если ПоказанныеПроцессы.Количество() = 0 Тогда
		Строки.Добавить("");
		Если ЗначениеЗаполнено(ДопПараметры.Фильтр) Тогда
			Строки.Добавить(Ванесса.Локализовать("Процессы по заданному фильтру не найдены."));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Процессы не найдены."));
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	// Колонка с датой старта выводится только если она есть у всех отобранных процессов
	ЕстьДатаСоздания = Истина;
	Для Каждого ДанныеПроцесса Из ПоказанныеПроцессы Цикл
		ДатаСоздания = Неопределено;
		Если НЕ ДанныеПроцесса.Свойство("CreationDate", ДатаСоздания)
			ИЛИ ТипЗнч(ДатаСоздания) <> Тип("Дата")
			ИЛИ НЕ ЗначениеЗаполнено(ДатаСоздания) Тогда
			ЕстьДатаСоздания = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Строки.Добавить("");
	Если ЕстьДатаСоздания Тогда
		Строки.Добавить(Ванесса.Локализовать("| PID | Запущен | Командная строка |"));
		Строки.Добавить("|-----|---------|------------------|");
	Иначе
		Строки.Добавить(Ванесса.Локализовать("| PID | Командная строка |"));
		Строки.Добавить("|-----|------------------|");
	КонецЕсли;

	Для Каждого ДанныеПроцесса Из ПоказанныеПроцессы Цикл

		PID = "";
		Если ДанныеПроцесса.Свойство("ProcessId") Тогда
			PID = Формат(ДанныеПроцесса.ProcessId, "ЧГ=; ЧН=0");
		КонецЕсли;

		КоманднаяСтрока = "";
		Если ДанныеПроцесса.Свойство("CommandLine") Тогда
			КоманднаяСтрока = Ванесса.МодульОбщегоНазначенияVA().УбратьПарольПользователяИзСтроки(ДанныеПроцесса.CommandLine);
			КоманднаяСтрока = СтрЗаменить(КоманднаяСтрока, "|", "\|");
		КонецЕсли;

		Если ЕстьДатаСоздания Тогда
			Строки.Добавить("| " + PID + " | " + Формат(ДанныеПроцесса.CreationDate, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'") + " | " + КоманднаяСтрока + " |");
		Иначе
			Строки.Добавить("| " + PID + " | " + КоманднаяСтрока + " |");
		КонецЕсли;

	КонецЦикла;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Функция ПроцессСоответствуетОтборуMCP(ДанныеПроцесса, Знач Отбор)

	Если НЕ ЗначениеЗаполнено(Отбор) Тогда
		Возврат Истина;
	КонецЕсли;

	НРегОтбор = НРег(СокрЛП(Отбор));

	Если ДанныеПроцесса.Свойство("CommandLine")
		И СтрокаСоответствуетОтборуMCP(НРег(ДанныеПроцесса.CommandLine), НРегОтбор) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ДанныеПроцесса.Свойство("Name")
		И СтрокаСоответствуетОтборуMCP(НРег(ДанныеПроцесса.Name), НРегОтбор) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ДанныеПроцесса.Свойство("ProcessId")
		И СтрокаСоответствуетОтборуMCP(НРег(Формат(ДанныеПроцесса.ProcessId, "ЧГ=; ЧН=0")), НРегОтбор) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция СтрокаСоответствуетОтборуMCP(Знач Строка, Знач Отбор)

	Если Найти(Отбор, "*") > 0 Тогда
		Возврат Ванесса.СтрокаСоответствуетШаблону(Строка, Отбор);
	КонецЕсли;
	Возврат Найти(Строка, Отбор) > 0;

КонецФункции

// Активизирует окно процесса ОС по PID или по заголовку окна (инструмент activate_process_os)
&НаКлиенте
Функция АктивизироватьПроцессОС(Запрос, ДополнительныеПараметры) Экспорт

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстСообщения = Ванесса.Локализовать("Чтобы активизировать процесс нужно в Vanessa Automation включить использование внешней компоненты VanessaExt.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если Ванесса.ВнешняяКомпонентаДляСкриншотов = Неопределено
		ИЛИ ТипЗнч(Ванесса.ВнешняяКомпонентаДляСкриншотов) = Тип("Строка") Тогда
		ТекстСообщения = Ванесса.Локализовать("Внешняя компонента VanessaExt не инициализирована. Перезапустите Vanessa Automation с включённой внешней компонентой.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	PID = Неопределено;
	ЗначениеПИД = ЗначениеПараметраИзЗапроса(Запрос, "pid");
	Если ЗначениеПИД <> "" И ЗначениеПИД <> Null И ЗначениеПИД <> Неопределено Тогда
		Попытка
			PID = Цел(Число(ЗначениеПИД));
		Исключение
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра pid. Нужно передать число.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецПопытки;
		Если PID <= 0 Тогда
			ТекстСообщения = Ванесса.Локализовать("Параметр pid должен быть положительным числом.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Имя без квалификатора Заголовок писалось бы в свойство формы, а не в локальную переменную
	ЗаголовокОкна = СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "window_title")));

	Если PID = Неопределено И НЕ ЗначениеЗаполнено(ЗаголовокОкна) Тогда
		ТекстСообщения = Ванесса.Локализовать("Нужно передать один из параметров: pid или window_title.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Если PID <> Неопределено И ЗначениеЗаполнено(ЗаголовокОкна) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры pid и window_title взаимоисключающие. Нужно передать только один из них.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("PID", PID);
	ДопПараметры.Вставить("Заголовок", ЗаголовокОкна);
	КонтекстMCP = MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	// Арность колбэка = контракт метода компоненты: НачатьВызовПолучитьСписокОкон передаёт 2 аргумента, НачатьПолучениеСписокОкон — 1
	Если PID <> Неопределено Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолученыОкнаДляАктивизацииMCP", ЭтаФорма, ДопПараметры);
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолученыОкнаДляАктивизацииMCPПоЗаголовку", ЭтаФорма, ДопПараметры);
	КонецЕсли;

	Попытка
		Если PID <> Неопределено Тогда
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокОкон(ОписаниеОповещения, PID);
		Иначе
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьПолучениеСписокОкон(ОписаниеОповещения);
		КонецЕсли;
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПолученыОкнаДляАктивизацииMCPПоЗаголовку(Результат, ДопПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		СписокОкон = Ванесса.ПрочитатьСтрокуJSON(Результат);
		Если ТипЗнч(СписокОкон) <> Тип("Массив") Тогда
			ТекстСообщения = Ванесса.Локализовать("Не удалось получить список окон от внешней компоненты VanessaExt.");
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		// Нашли процесс — повторяем запрос уже по его PID, как это делает шаг ЯАктивизируюПроцессПоЗаголовку
		НРегМаска = НРег(ДопПараметры.Заголовок);
		НайденныйPID = Неопределено;
		НайденныйЗаголовок = "";
		Для Каждого ДанныеОкна Из СписокОкон Цикл
			Если ТипЗнч(ДанныеОкна) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			ЗаголовокОкна = "";
			Если НЕ ДанныеОкна.Свойство("Title", ЗаголовокОкна)
				ИЛИ НЕ ЗначениеЗаполнено(ЗаголовокОкна) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаСоответствуетОтборуMCP(НРег(ЗаголовокОкна), НРегМаска) Тогда
				Если НЕ ДанныеОкна.Свойство("ProcessId", НайденныйPID) Тогда
					Продолжить;
				КонецЕсли;
				НайденныйЗаголовок = ЗаголовокОкна;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НайденныйPID = Неопределено Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не удалось найти процесс по заголовку окна <%1>."), ДопПараметры.Заголовок);
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		// Защита: с PID=0 компонента вернула бы все окна ОС, а не окна процесса
		Если ТипЗнч(НайденныйPID) <> Тип("Число") ИЛИ НайденныйPID <= 0 Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не удалось найти процесс по заголовку окна <%1>."), ДопПараметры.Заголовок);
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		ДопПараметрыPID = Новый Структура;
		ДопПараметрыPID.Вставить("PID", НайденныйPID);
		ДопПараметрыPID.Вставить("Заголовок", НайденныйЗаголовок);
		ДопПараметрыPID.Вставить("КонтекстMCP", КонтекстMCP);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолученыОкнаДляАктивизацииMCP", ЭтаФорма, ДопПараметрыPID);
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокОкон(ОписаниеОповещения, НайденныйPID);

	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПолученыОкнаДляАктивизацииMCP(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		СписокОкон = Ванесса.ПрочитатьСтрокуJSON(РезультатВызова);
		Если ТипЗнч(СписокОкон) <> Тип("Массив") Тогда
			ТекстСообщения = Ванесса.Локализовать("Не удалось получить список окон от внешней компоненты VanessaExt.");
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		// Режим по PID: активизируем главное окно процесса (Owner = 0), как в шаге ЯАктивизируюПроцесс
		ИДОкна = Неопределено;
		Для Каждого ДанныеОкна Из СписокОкон Цикл
			Если ТипЗнч(ДанныеОкна) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Если ДанныеОкна.Свойство("Owner") И ДанныеОкна.Owner = 0 Тогда
				ИДОкна = ДанныеОкна.Window;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ИДОкна = Неопределено Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось активизировать окно с PID <%1>. У процесса нет главного окна."), Формат(ДопПараметры.PID, "ЧГ=; ЧН=0"));
			MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;

		ДопПараметрыАктивации = Новый Структура;
		ДопПараметрыАктивации.Вставить("PID", ДопПараметры.PID);
		ДопПараметрыАктивации.Вставить("Заголовок", ДопПараметры.Заголовок);
		ДопПараметрыАктивации.Вставить("КонтекстMCP", КонтекстMCP);
		Оповещение = Новый ОписаниеОповещения("ОкноПроцессаАктивизированоMCP", ЭтаФорма, ДопПараметрыАктивации);
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовАктивироватьОкно(Оповещение, ИДОкна);

	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОкноПроцессаАктивизированоMCP(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт

	КонтекстMCP = MCPКонтекстИзДопПараметров(ДопПараметры);
	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("# Окно активизировано"));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("PID: %1."), Формат(ДопПараметры.PID, "ЧГ=; ЧН=0")));
		Если ЗначениеЗаполнено(ДопПараметры.Заголовок) Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Заголовок окна: %1."), ДопПараметры.Заголовок));
		КонецЕсли;

		ТекстСообщения = Ванесса._СтрСоединить(Строки, Символы.ПС);
		MCPЗавершитьВызовУспешно(КонтекстMCP, ТекстСообщения);

	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		MCPЗавершитьВызовСОшибкой(КонтекстMCP, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Вводит текст в активное поле эмуляцией ввода с клавиатуры (инструмент input_text_to_active_field)
&НаКлиенте
Функция ВвестиТекстВАктивноеПоле(Запрос, ДополнительныеПараметры) Экспорт

	ОшибкаКомпоненты = MCPПроверитьКомпонентуВводаТекста();
	Если ОшибкаКомпоненты <> Неопределено Тогда
		Возврат ОшибкаКомпоненты;
	КонецЕсли;

	Если Ванесса.ЭтоLinux = Истина Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Эмуляция ввода текста не работает под Linux."));
	КонецЕсли;

	Если Ванесса.Объект.ИдетВыполнениеСценариев Тогда
		ТекстСообщения = Ванесса.Локализовать("Сценарии уже выполняются. Дождитесь завершения сценариев или остановите их инструментом stop_scenario.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	// Сравнение с Истина обязательно: признак занятости может быть ещё не инициализирован,
	// а логическая операция с Неопределено роняет вызов инструмента.
	// Признак занятости может остаться от прерванного ввода: свой идентификатор ввода
	// очищается при завершении, а сам ввод ограничен 45 секундами
	ВремяВводаИстекло = Истина;
	Если ТипЗнч(ВремяНачалаВводаТекста) = Тип("Число") Тогда
		ВремяВводаИстекло = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаВводаТекста > 120000;
	КонецЕсли;

	Если ВводТекстаВыполняется = Истина
		И (НЕ ЗначениеЗаполнено(ИдентификаторВводаТекстаMCP) ИЛИ ВремяВводаИстекло) Тогда
		ВводТекстаВыполняется = Ложь;
		ИдентификаторВводаТекстаMCP = Неопределено;
	КонецЕсли;

	Если ВводТекстаВыполняется = Истина Тогда
		ТекстСообщения = Ванесса.Локализовать("Предыдущий ввод текста ещё не завершён. Дождитесь ответа инструмента.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	// MCP-клиент может передать null для неуказанного параметра, в 1С это Неопределено
	ТекстВвода = ЗначениеПараметраИзЗапроса(Запрос, "text");
	Если ТекстВвода = Null ИЛИ ТекстВвода = Неопределено Тогда
		ТекстВвода = "";
	КонецЕсли;
	ТекстВвода = Строка(ТекстВвода);

	Если СтрДлина(ТекстВвода) = 0 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Параметр text обязателен и не может быть пустым."));
	КонецЕсли;

	МаксимальнаяДлинаТекста = 1000;
	Если СтрДлина(ТекстВвода) > МаксимальнаяДлинаТекста Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Текст длиннее %1 символов. Введите текст частями или используйте manage_clipboard (action='set_text')."),
			МаксимальнаяДлинаТекста);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Задержка = 100;
	ЗначениеЗадержки = ЗначениеПараметраИзЗапроса(Запрос, "delay");
	Если ЗначениеЗадержки <> "" И ЗначениеЗадержки <> Null И ЗначениеЗадержки <> Неопределено Тогда
		Попытка
			Задержка = Цел(Число(ЗначениеЗадержки));
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Некорректное значение параметра delay. Нужно передать число."));
		КонецПопытки;
	КонецЕсли;

	Если Задержка < 0 ИЛИ Задержка > 5000 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Параметр delay должен быть числом от 0 до 5000 миллисекунд."));
	КонецЕсли;

	Если СтрДлина(ТекстВвода) * Задержка > 45000 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Текст с такой задержкой будет вводиться дольше 45 секунд. Уменьшите delay или введите текст частями."));
	КонецЕсли;

	АктивизироватьОкно = ЗначениеПараметраИзЗапроса(Запрос, "activate_window") = Истина;

	PID = Неопределено;
	ЗначениеПИД = ЗначениеПараметраИзЗапроса(Запрос, "pid");
	Если ЗначениеПИД <> "" И ЗначениеПИД <> Null И ЗначениеПИД <> Неопределено Тогда
		Попытка
			PID = Цел(Число(ЗначениеПИД));
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Некорректное значение параметра pid. Нужно передать число."));
		КонецПопытки;
		Если PID <= 0 Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Параметр pid должен быть положительным числом."));
		КонецЕсли;
	КонецЕсли;

	// Имя без квалификатора Заголовок писала бы в свойство формы, а не в локальную переменную
	ЗаголовокОкна = ЗначениеПараметраИзЗапроса(Запрос, "window_title");
	Если ЗаголовокОкна = Null ИЛИ ЗаголовокОкна = Неопределено Тогда
		ЗаголовокОкна = "";
	КонецЕсли;
	ЗаголовокОкна = СокрЛП(Строка(ЗаголовокОкна));

	Если PID <> Неопределено И ЗначениеЗаполнено(ЗаголовокОкна) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры pid и window_title взаимоисключающие. Нужно передать только один из них.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Если НЕ АктивизироватьОкно И (PID <> Неопределено ИЛИ ЗначениеЗаполнено(ЗаголовокОкна)) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры pid и window_title используются только вместе с activate_window=true. Передайте также activate_window=true.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Если АктивизироватьОкно И PID = Неопределено И НЕ ЗначениеЗаполнено(ЗаголовокОкна) Тогда
		PID = Ванесса.PIDТекущегоКлиентаТестирования();
		Если PID = Неопределено ИЛИ PID = 0 Тогда
			ТекстСообщения = Ванесса.Локализовать("Клиент тестирования не подключён. Передайте параметр pid или window_title, либо подключите клиент тестирования.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("MCPИдентификаторЗапроса", Запрос.Идентификатор);
	ДопПараметры.Вставить("Текст", ТекстВвода);
	ДопПараметры.Вставить("Задержка", Задержка);
	ДопПараметры.Вставить("PID", PID);
	ДопПараметры.Вставить("Заголовок", ЗаголовокОкна);
	ДопПараметры.Вставить("ИДОкна", Неопределено);
	ДопПараметры.Вставить("ОписаниеОкна", "");
	ДопПараметры.Вставить("АктивноеОкноПередВводом", Неопределено);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);

	ИдентификаторВводаТекстаMCP = Запрос.Идентификатор;
	ВводТекстаВыполняется = Истина;
	ВремяНачалаВводаТекста = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если АктивизироватьОкно Тогда
		Оповещение = Новый ОписаниеОповещения("ПолученыОкнаДляВводаТекста", ЭтаФорма, ДопПараметры);
		Попытка
			// Получаем все окна: нужное отбираем в колбэке по PID или по маске заголовка
			Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьПолучениеСписокОкон(Оповещение);
		Исключение
			MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
		КонецПопытки;

		Возврат Неопределено;
	КонецЕсли;

	MCPНачатьВводТекста(ДопПараметры);

	Возврат Неопределено;

КонецФункции

// Проверяет, что внешняя компонента VanessaExt включена и готова к эмуляции ввода текста
&НаКлиенте
Функция MCPПроверитьКомпонентуВводаТекста()

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстСообщения = Ванесса.Локализовать("Чтобы ввести текст в активное поле нужно в Vanessa Automation включить использование внешней компоненты VanessaExt.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если Ванесса.ВнешняяКомпонентаДляСкриншотов = Неопределено
		ИЛИ ТипЗнч(Ванесса.ВнешняяКомпонентаДляСкриншотов) = Тип("Строка") Тогда
		ТекстСообщения = Ванесса.Локализовать("Внешняя компонента VanessaExt не инициализирована. Перезапустите Vanessa Automation с включённой внешней компонентой.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Запускает асинхронный ввод текста в активное поле
&НаКлиенте
Процедура MCPНачатьВводТекста(ДопПараметры)

	// Активное окно читаем до ввода: эмуляция ввода не сообщает, куда попал текст
	ДопПараметры.АктивноеОкноПередВводом = MCPАктивноеОкноКомпоненты();

	Оповещение = Новый ОписаниеОповещения("ВводТекстаВАктивноеПолеЗавершён", ЭтаФорма, ДопПараметры);
	Попытка
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовЭмуляцияВводаТекста(Оповещение, ДопПараметры.Текст, ДопПараметры.Задержка);
	Исключение
		MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

// Возвращает дескриптор активного окна операционной системы
&НаКлиенте
Функция MCPАктивноеОкноКомпоненты()

	Значение = Неопределено;
	Попытка
		// Чтение дескриптора мгновенное, обращения к интерфейсу окна не требует
		Значение = Ванесса.ВнешняяКомпонентаДляСкриншотов.АктивноеОкно;
	Исключение
		Значение = Неопределено;
	КонецПопытки;

	Возврат Значение;

КонецФункции

&НаКлиенте
Процедура ПолученыОкнаДляВводаТекста(Результат, ДопПараметры) Экспорт

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка

		СписокОкон = Ванесса.ПрочитатьСтрокуJSON(Результат);
		Если ТипЗнч(СписокОкон) <> Тип("Массив") Тогда
			MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, Ванесса.Локализовать("Не удалось получить список окон от внешней компоненты VanessaExt."));
			Возврат;
		КонецЕсли;

		ИДОкна = Неопределено;
		ОписаниеОкна = "";
		НРегМаска = НРег(ДопПараметры.Заголовок);

		Для Каждого ДанныеОкна Из СписокОкон Цикл

			Если ТипЗнч(ДанныеОкна) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;

			ЗаголовокОкна = "";
			Если ДанныеОкна.Свойство("Title") Тогда
				ЗаголовокОкна = СокрЛП(Строка(ДанныеОкна.Title));
			КонецЕсли;

			Если ДопПараметры.PID <> Неопределено Тогда

				Если НЕ ДанныеОкна.Свойство("ProcessId") ИЛИ ДанныеОкна.ProcessId <> ДопПараметры.PID Тогда
					Продолжить;
				КонецЕсли;

				// Главное окно процесса (Owner = 0) предпочтительнее дочерних
				ГлавноеОкно = ДанныеОкна.Свойство("Owner") И ДанныеОкна.Owner = 0;
				Если ИДОкна = Неопределено ИЛИ ГлавноеОкно Тогда
					ИДОкна = ДанныеОкна.Window;
					ОписаниеОкна = ЗаголовокОкна;
					Если ГлавноеОкно Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;

				Продолжить;

			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(ЗаголовокОкна)
				ИЛИ НЕ СтрокаСоответствуетОтборуMCP(НРег(ЗаголовокОкна), НРегМаска) Тогда
				Продолжить;
			КонецЕсли;

			ИДОкна = ДанныеОкна.Window;
			ОписаниеОкна = ЗаголовокОкна;
			Прервать;

		КонецЦикла;

		Если ИДОкна = Неопределено Тогда
			Если ДопПараметры.PID <> Неопределено Тогда
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Не получилось найти окно процесса с PID <%1>."),
					Формат(ДопПараметры.PID, "ЧГ=; ЧН=0"));
			Иначе
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Не получилось найти окно по заголовку <%1>."),
					ДопПараметры.Заголовок);
			КонецЕсли;
			MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстСообщения);
			Возврат;
		КонецЕсли;

		ДопПараметры.ИДОкна = ИДОкна;
		ДопПараметры.ОписаниеОкна = ОписаниеОкна;

		Оповещение = Новый ОписаниеОповещения("ОкноДляВводаТекстаАктивизировано", ЭтаФорма, ДопПараметры);
		Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовАктивироватьОкно(Оповещение, ИДОкна);

	Исключение
		MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОкноДляВводаТекстаАктивизировано(Результат, ПараметрыВызова, ДопПараметры) Экспорт

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка
		MCPНачатьВводТекста(ДопПараметры);
	Исключение
		MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВводТекстаВАктивноеПолеЗавершён(Результат, ПараметрыВызова, ДопПараметры) Экспорт

	// Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка
		MCPЗавершитьВводТекстаУспешно(ДопПараметры, MCPОтветВводаТекста(ДопПараметры));
	Исключение
		MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

// Формирует ответ инструмента о выполненном вводе текста
&НаКлиенте
Функция MCPОтветВводаТекста(ДопПараметры)

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Ввод текста выполнен"));
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Передано символов: %1. Задержка между символами: %2 мс."),
		СтрДлина(ДопПараметры.Текст), Формат(ДопПараметры.Задержка, "ЧГ=; ЧН=0")));

	Если ДопПараметры.ИДОкна <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДопПараметры.ОписаниеОкна) Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Перед вводом выполнена попытка активизировать окно <%1> (компонента не сообщает, удалась ли активизация)."),
				ДопПараметры.ОписаниеОкна));
		Иначе
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Перед вводом выполнена попытка активизировать окно с дескриптором %1 (компонента не сообщает, удалась ли активизация)."),
				СокрЛП(Строка(ДопПараметры.ИДОкна))));
		КонецЕсли;
	КонецЕсли;

	АктивноеОкно = ДопПараметры.АктивноеОкноПередВводом;
	Если АктивноеОкно = Неопределено Тогда
		Строки.Добавить(Ванесса.Локализовать("Активное окно на момент ввода определить не удалось."));
	ИначеЕсли ДопПараметры.ИДОкна <> Неопределено И АктивноеОкно = ДопПараметры.ИДОкна Тогда
		Строки.Добавить(Ванесса.Локализовать("Активное окно на момент ввода совпадает с целевым окном."));
	ИначеЕсли ДопПараметры.ИДОкна <> Неопределено Тогда
		// Проверка несовпадения с целевым окном идёт раньше проверки главного окна клиента тестирования,
		// иначе неудачная активизация выглядела бы как нормальная ситуация
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Внимание: активное окно (дескриптор %1) не совпадает с целевым окном - текст мог уйти не в то окно."),
			СокрЛП(Строка(АктивноеОкно))));
	ИначеЕсли АктивноеОкно = Ванесса.ДескрипторОсновногоОкнаТекущегоКлиентаТестирования Тогда
		Строки.Добавить(Ванесса.Локализовать("Активное окно на момент ввода - главное окно текущего клиента тестирования."));
	Иначе
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Активное окно на момент ввода: дескриптор %1. Убедитесь, что текст ушёл в нужное окно."),
			СокрЛП(Строка(АктивноеОкно))));
	КонецЕсли;

	Строки.Добавить(Ванесса.Локализовать("Эмуляция ввода не сообщает об ошибках: проверьте значение поля (get_form_element_data)."));

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Завершает вызов инструмента ввода текста успешно
&НаКлиенте
Процедура MCPЗавершитьВводТекстаУспешно(ДопПараметры, ТекстОтвета)

	// Занятость снимаем до завершения вызова: исключение в сервере MCP не должно блокировать инструмент навсегда
	ВводТекстаВыполняется = Ложь;
	MCPЗавершитьВызовУспешно(MCPКонтекстИзДопПараметров(ДопПараметры), ТекстОтвета);
	MCPОсвободитьВводТекста(ДопПараметры);

КонецПроцедуры

// Завершает вызов инструмента ввода текста с ошибкой
&НаКлиенте
Процедура MCPЗавершитьВводТекстаСОшибкой(ДопПараметры, ТекстОшибки)

	ВводТекстаВыполняется = Ложь;
	MCPЗавершитьВызовСОшибкой(MCPКонтекстИзДопПараметров(ДопПараметры), "ACTION_FAILED", ТекстОшибки);
	MCPОсвободитьВводТекста(ДопПараметры);

КонецПроцедуры

// Снимает признак занятости и сбрасывает идентификатор задачи, если он принадлежит этому вызову
&НаКлиенте
Процедура MCPОсвободитьВводТекста(ДопПараметры)

	ВводТекстаВыполняется = Ложь;
	ИдентификаторЗапроса = "";
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("MCPИдентификаторЗапроса") Тогда
		ИдентификаторЗапроса = ДопПараметры.MCPИдентификаторЗапроса;
	КонецЕсли;
	Если ИдентификаторВводаТекстаMCP = ИдентификаторЗапроса Тогда
		ИдентификаторВводаТекстаMCP = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Возвращает список окон клиента тестирования
// После успешного получения списка внутренних окон также вызывает get_window_list_os для получения списка окон ОС
&НаКлиенте
Функция ПолучитьСписокВнутреннихОконКлиентаТестирования(Запрос, ДополнительныеПараметры) Экспорт
	
	// Реальная проверка подключения клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Попытка
		ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	МассивОкон = ТестовоеПриложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
	
	Результат = Новый Массив;
	Результат.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В клиенте тестирования найдено %1 окон:"), МассивОкон.Количество()));
	
	Для Каждого ТекОкно Из МассивОкон Цикл
		Результат.Добавить("   -" + ТекОкно.Заголовок);
	КонецЦикла;
	
	ТекстВнутреннихОкон = Ванесса._СтрСоединить(Результат, Символы.ПС);
	
	// Теперь вызываем асинхронно get_window_list_os для получения списка окон ОС
	// и объединяем результаты в обработчике
	Попытка
		ProcessId = Ванесса.PIDТекущегоКлиентаТестирования();
	Исключение
		ProcessId = Неопределено;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(ProcessId) Тогда
		// Если не удалось получить PID, возвращаем только внутренние окна
		Возврат ТекстВнутреннихОкон;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ProcessId", ProcessId);
	ДопПараметры.Вставить("ТекстВнутреннихОкон", ТекстВнутреннихОкон);
	MCPДобавитьКонтекстВДопПараметры(ДопПараметры, Запрос);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолученСписокВнутреннихОконДляОбъединенияСОкнамиОС", ЭтаФорма, ДопПараметры);
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовПолучитьСписокОкон(ОписаниеОповещения, ProcessId);
	
КонецФункции

// Обработчик для объединения результатов get_window_list_testclient и get_window_list_os
&НаКлиенте
Процедура ПолученСписокВнутреннихОконДляОбъединенияСОкнамиОС(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт
	
	ОкнаДляСкриншотов = ПолучитьОкнаДляСкриншотов(РезультатВызова);
	
	Строки = Новый Массив;
	
	// Добавляем результаты get_window_list_testclient
	Строки.Добавить(ДопПараметры.ТекстВнутреннихОкон);
	Строки.Добавить("");
	
	// Добавляем результаты get_window_list_os
	Если ОкнаДляСкриншотов.Количество() > 0 Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Окна клиента тестирования с точки зрения ОС (для снятия скриншотов) найдено %1:"), ОкнаДляСкриншотов.Количество()));
		Для Каждого ТекОкно Из ОкнаДляСкриншотов Цикл
			Если ТекОкно.ПолныеДанныеОкна.Свойство("Title") Тогда
				Строки.Добавить("   -" + ТекОкно.ПолныеДанныеОкна.Title);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("## Окна клиента тестирования с точки зрения ОС не найдены."));
	КонецЕсли;
	
	ТекстСообщения = Ванесса._СтрСоединить(Строки, Символы.ПС);
	MCPЗавершитьВызовУспешно(MCPКонтекстИзДопПараметров(ДопПараметры), ТекстСообщения);
	
КонецПроцедуры

// Универсальный инструмент для управления окнами клиента тестирования
// Поддерживает действия: activate (активизировать окно), close (закрыть окно), open_navigation (открыть навигационную ссылку)
&НаКлиенте
Функция УправлениеОкномКлиентаТестирования(Запрос, ДополнительныеПараметры) Экспорт

	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстОшибки = Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: 'activate' (активизировать окно), 'close' (закрыть окно), 'open_navigation' (открыть навигационную ссылку).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
	КонецЕсли;
	
	// Реальная проверка подключения клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Попытка
		ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Если Действие = "activate" Тогда
		// Активизировать окно по заголовку
		ЗаголовокОкна = Строка(ЗначениеПараметраИзЗапроса(Запрос, "window_title"));
		Если НЕ ЗначениеЗаполнено(ЗаголовокОкна) Тогда
			ТекстОшибки = Ванесса.Локализовать("Для действия 'activate' обязателен параметр window_title");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;	
		
		НужноеОкно = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"), ЗаголовокОкна);
		
		Если НужноеОкно = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Окно с заголовком <%1> не найдено."), ЗаголовокОкна);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецЕсли;	
		
		Попытка
			НужноеОкно.Активизировать();
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Не получилось активизировать указанное окно.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецПопытки;
		
		// Платформа может не выдать ошибку, но не переключить окно - проверяем фактически активное окно
		ЗаголовокНужногоОкна = НРег(СокрЛП(Строка(НужноеОкно.Заголовок)));
		Активировалось = Ложь;
		Для Сч = 1 По 3 Цикл
			// Первая активизация выполнена до цикла
			Если Сч > 1 Тогда
				Попытка
					НужноеОкно.Активизировать();
				Исключение
				КонецПопытки;
			КонецЕсли;
			Попытка
				АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
				Активировалось = АктивноеОкно <> Неопределено
					И НРег(СокрЛП(Строка(АктивноеОкно.Заголовок))) = ЗаголовокНужногоОкна;
			Исключение
				Активировалось = Ложь;
			КонецПопытки;
			Если Активировалось Тогда
				Прервать;
			КонецЕсли;
			Ванесса.sleep(1);
		КонецЦикла;
		
		Если НЕ Активировалось Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Окно <%1> не удалось сделать активным. Активизируйте главное окно клиента и повторите действие."),
				ЗаголовокОкна);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецЕсли;
		
		// Сбрасываем кэш активного окна, иначе дальнейшие действия могут выполняться в прежнем окне
		Ванесса.ОбработатьСменуАктивногоОкна();
		
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Окно <%1> было успешно активизировано."), ЗаголовокОкна);
		Возврат ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстСообщения);
		
	ИначеЕсли Действие = "close" Тогда
		// Закрыть окно по заголовку (часть заголовка - маской *)
		ЗаголовокОкна = Строка(ЗначениеПараметраИзЗапроса(Запрос, "window_title"));
		Если НЕ ЗначениеЗаполнено(ЗаголовокОкна) Тогда
			ТекстОшибки = Ванесса.Локализовать("Для действия 'close' обязателен параметр window_title");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;	
		
		НужноеОкно = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"), ЗаголовокОкна);
		
		Если НужноеОкно = Неопределено Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Окно с заголовком <%1> не найдено."), ЗаголовокОкна);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецЕсли;	
		
		Попытка
			НужноеОкно.Закрыть();
			Ванесса.sleep(1);
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Не получилось закрыть указанное окно.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецПопытки;
		
		НужноеОкно = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"), ЗаголовокОкна);
		Если НужноеОкно = Неопределено Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Окно <%1> было успешно закрыто."), ЗаголовокОкна);
			Возврат ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстСообщения);
		Иначе	
			ТекстОшибки = Ванесса.Локализовать("Не получилось закрыть указанное окно. Команда на закрытие окна была отправлена, но окно все ещё открыто.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецЕсли;
		
	ИначеЕсли Действие = "open_navigation" Тогда
		// Открыть навигационную ссылку
		НавигационнаяСсылка = Строка(ЗначениеПараметраИзЗапроса(Запрос, "navigation_link"));
		Если НЕ ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
			ТекстОшибки = Ванесса.Локализовать("Для действия 'open_navigation' обязателен параметр navigation_link");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;	
		
		Попытка
			Ванесса.ОткрытьНавигационнуюСсылку(НавигационнаяСсылка);
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Не получилось открыть навигационную ссылку: ") + НавигационнаяСсылка + ". " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстОшибки));
		КонецПопытки;
		
		// Пауза и получение активного окна, чтобы дождаться когда сработает команда
		Ванесса.sleep(1);
		Попытка
			АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Исключение
		КонецПопытки;
		
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Команда открытия навигационной ссылки <%1> была выполнена."), НавигационнаяСсылка);
		Возврат ДобавитьВСообщениеДанныеОбАктивномОкне(ТекстСообщения, Истина);
	Иначе
		ТекстОшибки = Ванесса.Локализовать("Неизвестное действие: ") + Действие + ". " + Ванесса.Локализовать("Допустимые: 'activate', 'close', 'open_navigation'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
	КонецЕсли;
	
КонецФункции

// Отличает отсутствующую переменную от переменной со значением Неопределено.
&НаКлиенте
Функция MCPПеременнаяЕстьВКонтексте(Контекст, ИмяПеременной)
	
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = Неопределено;
	Возврат Контекст.Свойство(ИмяПеременной, Значение);
	
КонецФункции

// Добавляет, читает и удаляет переменные контекста и глобального контекста
&НаКлиенте
Функция УправлениеПеременными(Запрос, ДополнительныеПараметры) Экспорт
	
	Действие = НРег(MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Действие = "get";
	КонецЕсли;
	
	ИмяПеременной = MCPVAСлужебныйМодуль.СтрокаПараметраИзЗапроса(Запрос, "name");
	ПеременнаяГлобальная = MCPVAСлужебныйМодуль.БулевПараметрИзЗапроса(Запрос, "is_global", Ложь);
	
	ОбъектКонтекст = Ванесса.ОбъектКонтекст;
	ОбъектКонтекстСохраняемый = Ванесса.ОбъектКонтекстСохраняемый;
	
	Если Действие = "get" Тогда
		// Если имя указано — одна переменная, иначе — все
		Если ЗначениеЗаполнено(ИмяПеременной) Тогда
			Контекст = ?(ПеременнаяГлобальная, ОбъектКонтекстСохраняемый, ОбъектКонтекст);
			ИмяКонтекста = ?(ПеременнаяГлобальная, "$$var$$", "$var$");
			Если НЕ MCPПеременнаяЕстьВКонтексте(Контекст, ИмяПеременной) Тогда
				Строки = Новый Массив;
				Строки.Добавить(Ванесса.Локализовать("# Переменная не найдена"));
				Строки.Добавить("");
				Строки.Добавить(Ванесса.Локализовать("- Имя:") + " " + ИмяПеременной);
				Строки.Добавить(Ванесса.Локализовать("- Контекст:") + " " + ИмяКонтекста);
				Если MCPПеременнаяЕстьВКонтексте(?(ПеременнаяГлобальная, ОбъектКонтекст, ОбъектКонтекстСохраняемый), ИмяПеременной) Тогда
					Строки.Добавить(Ванесса.Локализовать("Переменная есть в другом контексте:") + " " + ?(ПеременнаяГлобальная, "$var$", "$$var$$") + ".");
				КонецЕсли;
				Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
			КонецЕсли;
			
			Значение = MCPБезопасноеСвойство(Контекст, ИмяПеременной);
			ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Переменная: %1
				|
				|- Значение: %2
				|- Контекст: %3"),
				ИмяПеременной,
				MCPПредставлениеЗначенияДляMarkdown(Значение),
				ИмяКонтекста);
			Возврат ТекстОтвета;
		Иначе
			// Все переменные — формируем Markdown
			Строки = Новый Массив;
			Строки.Добавить("# Переменные контекста");
			Строки.Добавить("");
			
			КоличествоПеременных = 0;
			
			Если ОбъектКонтекст <> Неопределено И ТипЗнч(ОбъектКонтекст) = Тип("Структура") Тогда
				Строки.Добавить("## Контекст ($var$)");
				Для Каждого КлючЗначение Из ОбъектКонтекст Цикл
				Если Ванесса.ЭтоСлужебнаяПеременнаяКонтекста(КлючЗначение.Ключ) Тогда
						Продолжить;
					КонецЕсли;
					Строки.Добавить("- `" + КлючЗначение.Ключ + "` = " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
					КоличествоПеременных = КоличествоПеременных + 1;
				КонецЦикла;
			КонецЕсли;
			
			Если ОбъектКонтекстСохраняемый <> Неопределено И ТипЗнч(ОбъектКонтекстСохраняемый) = Тип("Структура") Тогда
				Строки.Добавить("");
				Строки.Добавить("## Сохраняемый контекст ($$var$$)");
				Для Каждого КлючЗначение Из ОбъектКонтекстСохраняемый Цикл
					Если Ванесса.ЭтоСлужебнаяПеременнаяКонтекста(КлючЗначение.Ключ) Тогда
						Продолжить;
					КонецЕсли;
					Строки.Добавить("- `" + КлючЗначение.Ключ + "` = " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
					КоличествоПеременных = КоличествоПеременных + 1;
				КонецЦикла;
			КонецЕсли;
			
			Если КоличествоПеременных = 0 Тогда
				Строки.Добавить(Ванесса.Локализовать("Переменных нет."));
			КонецЕсли;
			
			Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
		КонецЕсли;
		
	ИначеЕсли Действие = "set" Тогда
		Если Не ЗначениеЗаполнено(ИмяПеременной) Тогда
			ТекстОшибки = Ванесса.Локализовать("Параметр name обязателен для action=set.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;
		
		// Пустая строка — допустимое значение; отсутствие параметра и null — нет
		Если НЕ ПараметрПрисутствуетВЗапросе(Запрос, "value") Тогда
			ТекстОшибки = Ванесса.Локализовать("Параметр value обязателен для action=set. Пустая строка допустима.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;
		ЗначениеДляПроверки = ЗначениеПараметраИзЗапроса(Запрос, "value");
		Если ЗначениеДляПроверки = Null ИЛИ ЗначениеДляПроверки = Неопределено Тогда
			ТекстОшибки = Ванесса.Локализовать("Параметр value обязателен для action=set. Пустая строка допустима, null — нет.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;
		ЗначениеПеременнойПараметр = Строка(ЗначениеДляПроверки);
		
		Попытка
			Если ПеременнаяГлобальная Тогда
				ОбъектКонтекстСохраняемый.Вставить(ИмяПеременной, ЗначениеПеременнойПараметр);
			Иначе
				ОбъектКонтекст.Вставить(ИмяПеременной, ЗначениеПеременнойПараметр);
			КонецЕсли;	
			ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Переменная установлена
				|
				|- Имя: %1
				|- Значение: %2"),
				ИмяПеременной,
				MCPПредставлениеЗначенияДляMarkdown(ЗначениеПеременнойПараметр));
			Возврат ТекстОтвета;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка установки переменной:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
	ИначеЕсли Действие = "delete" Тогда
		Если Не ЗначениеЗаполнено(ИмяПеременной) Тогда
			ТекстОшибки = Ванесса.Локализовать("Параметр name обязателен для action=delete.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
		КонецЕсли;
		
		Контекст = ?(ПеременнаяГлобальная, ОбъектКонтекстСохраняемый, ОбъектКонтекст);
		ИмяКонтекста = ?(ПеременнаяГлобальная, "$$var$$", "$var$");
		Если НЕ MCPПеременнаяЕстьВКонтексте(Контекст, ИмяПеременной) Тогда
			Строки = Новый Массив;
			Строки.Добавить(Ванесса.Локализовать("# Переменная не найдена"));
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("- Имя:") + " " + ИмяПеременной);
			Строки.Добавить(Ванесса.Локализовать("- Контекст:") + " " + ИмяКонтекста);
			Если MCPПеременнаяЕстьВКонтексте(?(ПеременнаяГлобальная, ОбъектКонтекст, ОбъектКонтекстСохраняемый), ИмяПеременной) Тогда
				Строки.Добавить(Ванесса.Локализовать("Переменная есть в другом контексте:") + " " + ?(ПеременнаяГлобальная, "$var$", "$$var$$") + ". Измените is_global, чтобы удалить её.");
			КонецЕсли;
			Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
		КонецЕсли;
		
		Попытка
			Контекст.Удалить(ИмяПеременной);
			ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Переменная удалена
				|
				|- Имя: %1
				|- Контекст: %2"),
				ИмяПеременной,
				ИмяКонтекста);
			Возврат ТекстОтвета;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка удаления:")+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		
	Иначе
		ТекстОшибки = Ванесса.Локализовать("Неизвестное действие:") + " " + Действие + Ванесса.Локализовать(". Допустимые: get, set, delete.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
	КонецЕсли;
	
	
	Возврат Ванесса.Локализовать("Окно было успешно активизировано.");
	
КонецФункции

