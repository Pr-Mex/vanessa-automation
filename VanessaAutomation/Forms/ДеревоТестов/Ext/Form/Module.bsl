// ОпределитьИдИсполняемойСтрокиДерева
&НаКлиенте
Функция ОпределитьИдИсполняемойСтрокиДерева(СтрокаДерева, НужнаяСтрока) Экспорт
	ТекСтрока = СтрокаДерева;
	
	Если Ванесса.ЭтуСтрокуМожноИсполнить(ТекСтрока) Тогда
		НужнаяСтрока = ТекСтрока;
		Возврат ТекСтрока.ИдСтроки;
	КонецЕсли;	 
	
	Пока Истина Цикл
		ЭлементыДерева = ТекСтрока.ПолучитьЭлементы();
		Если ЭлементыДерева.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;	 
		
		ТекСтрока = Неопределено;
		Для Каждого ПромСтрокаДерева Из ЭлементыДерева Цикл
			Если ПромСтрокаДерева.СтрокаПараметровШагаВВидеТаблицы Тогда
				Продолжить;
			КонецЕсли;	 
			
			Если ПустаяСтрока(ПромСтрокаДерева.Имя) Тогда
				Продолжить;
			КонецЕсли;	 
			
			ТекСтрока = ПромСтрокаДерева;
			
			Прервать;
		КонецЦикла;	 
		
		Если ТекСтрока = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;	 
		
		Если Ванесса.ЭтуСтрокуМожноИсполнить(ТекСтрока) Тогда
			НужнаяСтрока = ТекСтрока;
			Возврат ТекСтрока.ИдСтроки;
		КонецЕсли;	 
	КонецЦикла;	
	
КонецФункции	

#КонецОбласти

#Область ПеренесённыеИзГлавнойФормы

// ЭтуСтрокуМожноИсполнитьИлиВНейЕстьПодчиненныеИсполняемыеСтроки
&НаКлиенте
Функция ЭтуСтрокуМожноИсполнитьИлиВНейЕстьПодчиненныеИсполняемыеСтроки(СтрокаДерева) Экспорт
	Если СтрокаДерева.Тип = "Сценарий" Тогда
		Возврат Истина;
	КонецЕсли;	 
	
	Если СтрокаДерева.Тип = "Шаг" Тогда
		Возврат Истина;
	КонецЕсли;	 
	
	Если СтрокаДерева.Тип = "Область" Тогда
		Возврат Истина;
	КонецЕсли;	 
	
	Если СтрокаДерева.Тип = "ШагСценарий" Тогда
		Возврат Истина;
	КонецЕсли;	 
	
	Возврат Ложь;
КонецФункции	

// ПолучитьИменаСценариевПоТекущейФичеРекурсивно
&НаКлиенте
Процедура ПолучитьИменаСценариевПоТекущейФичеРекурсивно(Результат, СтрокаДерева) Экспорт
	
	Для Каждого ТекСтрока Из СтрокаДерева.ПолучитьЭлементы() Цикл
		Если ТекСтрока.Тип = "Сценарий" Тогда
			Структура = Новый Структура;
			Структура.Вставить("Имя", ТекСтрока.Имя);
			Структура.Вставить("НомерСтрокиВФиче", ТекСтрока.НомерСтрокиВФиче);
			Результат.Добавить(Структура);
		КонецЕсли;
		ПолучитьИменаСценариевПоТекущейФичеРекурсивно(Результат, ТекСтрока);
	
	КонецЦикла;
	
КонецПроцедуры

