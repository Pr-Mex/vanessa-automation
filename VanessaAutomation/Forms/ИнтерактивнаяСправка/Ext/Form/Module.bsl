// ОбработкаДляСеансаВрежимеОбучения
&НаКлиенте
Процедура ОбработкаДляСеансаВрежимеОбучения() Экспорт
	
	Если НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		Возврат;
	КонецЕсли;	 
	
	Если Ванесса.Элементы.ГруппаДереваФайлов.Видимость Тогда
		Ванесса.VanessaEditorПоказатьСкрытьДеревоКаталогов(Неопределено);
	КонецЕсли;	 
	Если Ванесса.Элементы.ГруппаGit.Видимость Тогда
		Ванесса.VanessaEditorПоказатьСкрытьДеревоGit(Неопределено);
	КонецЕсли;	 
	
	Ванесса.АктивизироватьСтраницуЗапускТестов();
	
	Если Ванесса.Объект.СоздаватьИнструкциюВидео Тогда
		Ванесса.ВключитьВыключитьЗаписьВидео(Неопределено);
	КонецЕсли;	 
	Если Ванесса.Объект.ОзвучиватьВыполнениеСценария Тогда
		Ванесса.ВключитьВыключитьОзвучиваниеВыполненияСценария(Неопределено);
	КонецЕсли;
	
	Если Ванесса.Объект.ПодсвечиватьКликМышкиВБраузереVanessaExt Тогда
		Ванесса.Объект.ПодсвечиватьКликМышкиВБраузереVanessaExt = Ложь;
	КонецЕсли;	 
	
	Ванесса.ТемаРедактораVanessaEditorПриИзменении(Неопределено);
	
КонецПроцедуры 

// НайтиФичаФайлыУроковДляОбработки
&НаКлиенте
Функция НайтиФичаФайлыУроковДляОбработки() Экспорт
	
	Результат = Новый Массив;
	
	КаталогПоиска = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + "training\features";
	
	СписокКаталогов = Новый СписокЗначений;
	СписокФайлов    = Новый СписокЗначений;
	Ванесса.НайтиФайлыКомандаСистемы(КаталогПоиска, СписокКаталогов, СписокФайлов, Истина, "*.feature");
	
	СписокФайлов.СортироватьПоПредставлению();
	
	Для Каждого Элем Из СписокФайлов Цикл
		
		ТекФайл = Элем.Значение;
		
		Если Найти(СтрЗаменить(НРег(ТекФайл.ПолноеИмя), "/", "\"), "\features\примеры\") > 0 Тогда
			Продолжить;
		КонецЕсли;	 
		
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ТекФайл.ПолноеИмя, "UTF-8");
		ТекстФайла = Текст.Прочитать();
		Текст.Закрыть();
		
		Если Найти(ТекстФайла, "@lessons") = 0 Тогда
			Продолжить;
		КонецЕсли;	 
		
		Результат.Добавить(ТекФайл.ПолноеИмя);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

#КонецОбласти
#КонецОбласти
