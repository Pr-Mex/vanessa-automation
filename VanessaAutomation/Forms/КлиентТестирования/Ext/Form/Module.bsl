&НаКлиенте
Функция ТекущиеДанныеКлиентаТестирования() Экспорт
	
	ТекущиеДанные = Ванесса.Элементы.ДанныеКлиентовТестирования.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Возврат ТекущиеДанные;
	КонецЕсли;	
	
	Если ТипЗнч(Ванесса.ОбъектКонтекстСохраняемый) = Тип("Структура") Тогда
		Если Ванесса.ОбъектКонтекстСохраняемый.Свойство("ТекущийПрофильTestClient") Тогда
			ИмяТекПрофиля = Ванесса.ОбъектКонтекстСохраняемый.ТекущийПрофильTestClient;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Имя", ИмяТекПрофиля);
			НайденныеСтроки = Ванесса.ДанныеКлиентовТестирования.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() > 0 Тогда
				Возврат НайденныеСтроки[0]; 
			КонецЕсли;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Синоним", ИмяТекПрофиля);
			НайденныеСтроки = Ванесса.ДанныеКлиентовТестирования.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() > 0 Тогда
				Возврат НайденныеСтроки[0]; 
			КонецЕсли;	 
		КонецЕсли;	 
	КонецЕсли;	 
	
	Если ТекущиеДанные = Неопределено Тогда
		Если Ванесса.ДанныеКлиентовТестирования.Количество() > 0 Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ЭтотКлиент", Истина);
			
			НайденныеСтроки = Ванесса.ДанныеКлиентовТестирования.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ДанныеЗапускаКлиентаТестирования = НайденныеСтроки[0];
				Ванесса.Элементы.ДанныеКлиентовТестирования.ТекущаяСтрока = ДанныеЗапускаКлиентаТестирования.ПолучитьИдентификатор();
				ТекущиеДанные = Ванесса.Элементы.ДанныеКлиентовТестирования.ТекущиеДанные;
			КонецЕсли;	
		КонецЕсли;	 
	КонецЕсли;	 
	
	Возврат ТекущиеДанные;
КонецФункции

