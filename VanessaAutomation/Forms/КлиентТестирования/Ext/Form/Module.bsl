// Активизирует закладку
&НаКлиенте
Процедура АктивизироватьЗакладку(ПолеЗакладка) Экспорт
	Если НЕ Ванесса.НужноЭмулироватьДействияМышки() Тогда
		ПолеЗакладка.Активизировать();
		Возврат;
	КонецЕсли;	
	
	Если Ванесса.МодульРаботаСБраузером().ЭмуляцияДвиженияМышкиКомпонентаВБраузере() Тогда
		Ванесса.МодульРаботаСБраузером().КликПоЗакладкеБраузер(ПолеЗакладка);
	ИначеЕсли Ванесса.ЭмуляцияДвиженияМышкиКомпонентаUIAutomation() Тогда
		Ванесса.МодульUIAutomation().КликПоЗакладкеUIAutomation(ПолеЗакладка);
	Иначе	
		Ванесса.КликЛевойКнопкойМышкиПоСгенерированнойКартинке(ПолеЗакладка.ТекстЗаголовка, "MainForm");
	КонецЕсли;	 
	
КонецПроцедуры 

// Перемещает курсор к флагу
&НаКлиенте
Процедура ПереместитьКурсорКФлагу(ПолеРеквизит) Экспорт
	Если НЕ Ванесса.НужноЭмулироватьДействияМышки() Тогда
		Возврат;
	КонецЕсли;	 
	
	Если Ванесса.МодульРаботаСБраузером().ЭмуляцияДвиженияМышкиКомпонентаВБраузере() Тогда
		Ванесса.МодульРаботаСБраузером().КликПоФлагуБраузер(ПолеРеквизит);
		Ванесса.МодульРаботаСБраузером().АнимацияКлика(ПолеРеквизит);
	ИначеЕсли Ванесса.ЭмуляцияДвиженияМышкиКомпонентаUIAutomation() Тогда
		Ванесса.МодульUIAutomation().КликПоФлагуUIAutomation(ПолеРеквизит);
		Ванесса.МодульРаботаСБраузером().АнимацияКлика(ПолеРеквизит);
	Иначе	
		Ванесса.ПереместитьКурсорМышкиПоСгенерированнойКартинке(ПолеРеквизит.ТекстЗаголовка + ":", "MainForm");
	КонецЕсли;	 
КонецПроцедуры 

// Выбирает значение переключателя
&НаКлиенте
Процедура ВыбратьЗначениеПереключателя(ПолеРеквизит, Значение) Экспорт
	Если НЕ Ванесса.НужноЭмулироватьДействияМышки() Тогда
		Ванесса.ВыбратьВариантПереключателя(ПолеРеквизит, Значение);
		Возврат;
	КонецЕсли;	
	
	Если Ванесса.МодульРаботаСБраузером().ЭмуляцияДвиженияМышкиКомпонентаВБраузере() Тогда
		Ванесса.МодульРаботаСБраузером().КликПоПереключателюБраузер(ПолеРеквизит, Значение);
		Ванесса.МодульРаботаСБраузером().АнимацияКлика(ПолеРеквизит);
		Ванесса.ВыбратьВариантПереключателя(ПолеРеквизит, Значение);
	ИначеЕсли Ванесса.ЭмуляцияДвиженияМышкиКомпонентаUIAutomation() Тогда
