&НаКлиенте
Процедура НачатьЗаписьДействийПользователяЭкспорт() Экспорт
	Если Ванесса.ИдетЗаписьДействийПользователя Тогда
		Ванесса.ЗавершитьЗаписьДействийПользователяКнопка();
		Возврат;
	КонецЕсли;	 
	
	ТекущиеДанные = ТекущиеДанныеКлиентаТестирования();
	
	Если ТекущиеДанные = Неопределено Тогда
		ВызватьИсключение Ванесса.Локализовать("Не найден Клиент тестирования для подключения.");
	КонецЕсли;	 
	
	Если ТекущиеДанные.ТипКлиента = "Web" Тогда
		ВызватьИсключение Ванесса.Локализовать("Web клиент не поддерживает запись действий пользователя.");
	КонецЕсли;	 
	
	Если НЕ Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		Ванесса.ТекущийЭлемент = Ванесса.Элементы.РаботасUI;
	КонецЕсли;	 
	Ванесса.ИдетЗаписьДействийПользователя = Истина;
	Ванесса.НачатьЗаписьДействийПользователя();
	Ванесса.УправлениеВидимостьюЗаписиДействийПользователя("НачатьЗапись");
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаписьДействийПользователяЭкспорт() Экспорт
	Ванесса.ИдетЗаписьДействийПользователя = Ложь;
	ЗавершитьЗаписьДействийПользователя();
	Ванесса.УправлениеВидимостьюЗаписиДействийПользователя("ЗавершитьЗапись");
	Если Ванесса.НужноПоказатьОкноОстановкиЗаписиДействийПользователя() Тогда
		Ванесса.ЗакрытьОкноОстановкиЗаписиДействийПользователя();
	КонецЕсли;	 
КонецПроцедуры

