Функция ЯЗакрываюСеансTESTCLIENT() Экспорт
	
	ОбработатьСменуАктивногоОкна();	
	
	Попытка
		ВыполнитьПроверкуСерверныхВызововВОбработчикахСобытий();
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
	Попытка
		Ванесса.КонтекстСохраняемый.ГлавноеОкноТестируемого.Закрыть();
		ТекстСообщения = Ванесса.ПолучитьТекстСообщенияПользователю("Закрытие клиента тестирования.");
		
		Если Ванесса.КонтекстСохраняемый.Свойство("ТекущийПрофильTestClient") Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + Ванесса.Локализовать("Имя:") + " " + Ванесса.КонтекстСохраняемый.ТекущийПрофильTestClient;
		КонецЕсли;	
		
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
		Ванесса.ЗаписатьЛогВЖРИнформация("ЗакрытиеКлиентаТестирования", ТекстСообщения);
	Исключение
		Ванесса.КонтекстСохраняемый.Вставить("ГлавноеОкноТестируемого",Неопределено);
	КонецПопытки;
	Ванесса.КонтекстСохраняемый.ГлавноеОкноТестируемого = Неопределено;

	//чтобы успели появиться диалоги о закрытии
	Ванесса.sleep(1);
	
	// Закрытие платформенного-бспшного окна "Завершить работу"
	Попытка
		ИскомаяКнопка = Ванесса.КонтекстСохраняемый.ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Завершить работу");
		Если ИскомаяКнопка <> Неопределено Тогда
			ИскомаяКнопка.Нажать();
		КонецЕсли;
	Исключение
		//
	КонецПопытки;
	
	Попытка
		Ванесса.КонтекстСохраняемый.ТестовоеПриложение.РазорватьСоединение();
	Исключение
		//	
	КонецПопытки;
	
	Если Ванесса.Объект.ЗакрыватьКлиентТестированияПринудительно
		И Ванесса.КонтекстСохраняемый.Свойство("ТекущийПрофильTestClient")
		Тогда
		Попытка
			СвойстваTestClient = ПолучитьДанныеКлиентаТестирования(Ванесса.КонтекстСохраняемый.ТекущийПрофильTestClient);
			Если СвойстваTestClient.PIDКлиентаТестирования <> 0 И СвойстваTestClient.ТипКлиента = "Тонкий" Тогда
				//Компоненту использовать нельзя, т.к. для неё нужно вызывать асинхронный метод, а этот код может выполняться синхронно при закрытии сеанса VA
				ТекДат = ТекущаяДата();
				МаксДата = ТекДат + Ванесса.Объект.ТаймаутПередПринудительнымЗакрытиемКлиентаТестирования;
				Ванесса.ЗаписатьЛогВЖРИнформация("ЗакрытиеКлиентаТестирования",
					Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Ожидание закрытия процесса с pid <%1> до <%2>."), СвойстваTestClient.PIDКлиентаТестирования, МаксДата));
				ПроцессОССуществует = Истина;
				Пока ТекущаяДата() < МаксДата Цикл
					ПроцессОССуществует = Ванесса.МодульОбщегоНазначенияVA().ПроцессОССуществует(СвойстваTestClient.PIDКлиентаТестирования);
					Если НЕ ПроцессОССуществует Тогда
						Прервать;
					КонецЕсли;	 
					
					Ванесса.sleep(1);
				КонецЦикла;
				
				Если ПроцессОССуществует Тогда
					Массив = Новый Массив;
					Массив.Добавить(СвойстваTestClient.PIDКлиентаТестирования);
					Попытка
						Ванесса.ЗаписатьЛогВЖРИнформация("ЗакрытиеКлиентаТестирования",
							Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Принудительное завершение процесса клиента тестирования с pid <%1>."), СвойстваTestClient.PIDКлиентаТестирования));
						Ванесса.ЗавершитьСеансыОСПринудительно(Массив);
						Ванесса.sleep(3);
					Исключение
						Ванесса.ЗаписатьЛогВЖРОшибка("ЗакрытиеКлиентаТестирования", ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
				
				ПроцессОССуществует = Ванесса.МодульОбщегоНазначенияVA().ПроцессОССуществует(СвойстваTestClient.PIDКлиентаТестирования);
				Если ПроцессОССуществует Тогда
					Ванесса.ЗаписатьЛогВЖРИнформация("ЗакрытиеКлиентаТестирования",
						Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Процесс с pid <%1> всё ещё существует."), СвойстваTestClient.PIDКлиентаТестирования));
				Иначе	
					Ванесса.ЗаписатьЛогВЖРИнформация("ЗакрытиеКлиентаТестирования",
						Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Процесс с pid <%1> не обнаружен."), СвойстваTestClient.PIDКлиентаТестирования));
				КонецЕсли;	
				
			КонецЕсли;	 
		Исключение
			Ванесса.ЗаписатьЛогВЖРОшибка("ЗакрытиеКлиентаТестирования", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;	 
	
	ОбновитьДанныеКлиентовТестированияПослеОтключенияКлиентаТестирования();
	
КонецФункции

