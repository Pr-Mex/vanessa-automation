				ВызватьИсключение ТекстСообщения;
			КонецЕсли;	 
			
			ОткрытьКнопкуВыбораБраузер(Поле);
			
			ПолучилосьАктивизировать = Ложь;
			Поле.Активизировать();
			ПолучилосьАктивизировать = Истина;
			Поле.Выбрать();
		Исключение
			СтрокаОшибки = ОписаниеОшибки();
			Если ПолучилосьАктивизировать И 
				 ЭтоСтрокаОшибкиНедоступныйПользователюЭлементУправленияНеМожетВыполнятьИнтерактивныеДействия(СтрокаОшибки)
			Тогда
				 БылаОшибка = Ложь;
			Иначе	 
				БылаОшибка = Истина;
				Если СчетчикПопыток < КоличествоПопыток Тогда
					Ванесса.Sleep(1);
				КонецЕсли;	 
			КонецЕсли;	 
			ЗапомнитьАктивноеОкно(Неопределено);
		КонецПопытки;
		
		Если НЕ БылаОшибка Тогда
			Прервать;
		КонецЕсли;	 
	КонецЦикла;
	
	Если БылаОшибка Тогда
		ВызватьИсключение СтрокаОшибки;
	КонецЕсли;	 
