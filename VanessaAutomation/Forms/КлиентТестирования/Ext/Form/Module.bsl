&НаКлиенте

Процедура УстановитьРезультатДиалогаВыбораФайла(Результат, ИмяФайла, ИндексФильтра) Экспорт

	
	Если Ванесса.ИдетВыполнениеСценариев() Тогда
		СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaAutomation();
		Данные = Новый Структура;
		Данные.Вставить("ИмяФичи", СостояниеVanessaAutomation.ТекущаяФича.Имя);
		Данные.Вставить("ИмяФайлаФичи", СостояниеVanessaAutomation.ТекущаяФича.ПолныйПуть);
		Данные.Вставить("ИмяСценария", СостояниеVanessaAutomation.ТекущийСценарий.Имя);
		Данные.Вставить("ИмяШага", СостояниеVanessaAutomation.ТекущийШаг.Имя);
		Данные.Вставить("НомерСтрокиФичи", СостояниеVanessaAutomation.ТекущийШаг.НомерСтрокиФичи);
		Данные.Вставить("РезультатВыбораФайла", Результат);
		Данные.Вставить("ИмяФайла", ИмяФайла);
		Данные.Вставить("ИндексФильтра", ИндексФильтра);
		
		Ванесса.ЗаписатьЛогВЖРИнформация("УстановитьРезультатДиалогаВыбораФайла", Ванесса.ЗаписатьОбъектJSON(Данные));
	КонецЕсли;		
	
	Если Ванесса.Версия8325ИлиВыше Тогда
		Ванесса.ОбъектКонтекстСохраняемый.ТестовоеПриложение.ОчиститьРезультатДиалогаВыбораФайла();
	КонецЕсли;	
	
	Если ИндексФильтра = Неопределено Тогда
		Ванесса.ОбъектКонтекстСохраняемый.ТестовоеПриложение.УстановитьРезультатДиалогаВыбораФайла(Результат, ИмяФайла);
	Иначе	
		Ванесса.ОбъектКонтекстСохраняемый.ТестовоеПриложение.УстановитьРезультатДиалогаВыбораФайла(Результат, ИмяФайла, ИндексФильтра);
	КонецЕсли;	
	

КонецПроцедуры


&НаКлиенте

Процедура ДополнитьДанныеОбОшибкеКогдаПолеВСвернутыхГруппах(ПолеРеквизит, СтрокаОшибки) Экспорт

	Попытка
		Если Найти(НРег(СтрокаОшибки), "невидимый пользователю элемент управления не может выполнять интерактивные действия") > 0 Тогда
			Если Ванесса.Версия8325ИлиВыше И ПолеРеквизит <> Неопределено Тогда
				ТекРодитель = ПолеРеквизит.ПолучитьРодителя();
				Пока Истина Цикл
					Если ТипЗнч(ТекРодитель) = Тип("ТестируемоеОкноКлиентскогоПриложения") Тогда
						Прервать;
					КонецЕсли;	
					
					Если ТекРодитель = Неопределено Тогда
						Прервать;
					КонецЕсли;
					
					Если ТипЗнч(ТекРодитель) = Тип("ТестируемаяГруппаФормы") Тогда
						Если Ванесса.ИсправленаОшибкаПроверкиГруппыОткрытаИлиНет И НЕ ТекРодитель.ТекущееОткрыта() Тогда
							СтрокаГруппы = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Элемет формы <%1> находится в свернутой группе <%2>. Сначала необходимо развернуть группу."),
								ПолеРеквизит.Имя + " (" + ПолеРеквизит.ТекстЗаголовка + ")", ТекРодитель.Имя + " (" + ТекРодитель.ТекстЗаголовка + ")");
							СтрокаОшибки = СтрокаОшибки + Символы.ПС + СтрокаГруппы;
						КонецЕсли;
					КонецЕсли;
					
					ТекРодитель = ТекРодитель.ПолучитьРодителя();
					
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры


