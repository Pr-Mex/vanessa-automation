// ВывестиВСообщениеТекстОшибки
&НаКлиенте
Функция ВывестиВСообщениеТекстОшибки(ДанныеОшибки, ТекстОшибкиTestClientБезФорматирования = "") Экспорт
	Если ТипЗнч(ДанныеОшибки) = Тип("ИнформацияОбОшибке") Тогда
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ДанныеОшибки); 
	Иначе	
		ПредставлениеОшибки = ДанныеОшибки; 
	КонецЕсли;	 
	
	ТекстОшибкиTestClientБезФорматирования = ПредставлениеОшибки;
	
	Отступ = "                ";
	Стр = "";
	МассивСтрок = Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(ПредставлениеОшибки, Символы.ПС);
	Для Каждого Элем Из МассивСтрок Цикл
		Стр = Стр + Отступ + Элем + Символы.ПС;
	КонецЦикла;	 
	
	Возврат Стр;
КонецФункции	 

// ТекстОшибкиЧерезДанныеОкнаОшибки
&НаКлиенте
Функция ТекстОшибкиЧерезДанныеОкнаОшибки() Экспорт
	Если НЕ Ванесса.НадоПолучатьДанныеОшибкиИзАктивногоОкнаКлиентаТестирования() Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Попытка
		АктивноеОкно  = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Кнопка = АктивноеОкно.НайтиОбъект(,,"OpenReport");
		Если Кнопка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;	
		Кнопка.Нажать();
		Ванесса.Sleep(1);
		АктивноеОкно  = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Поле = АктивноеОкно.НайтиОбъект(,,"SendErrorInfoDecoration");
		Если Поле = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;	
		Поле.НажатьНаГиперссылкуВФорматированнойСтроке(0);
		Ванесса.Sleep(1);
		АктивноеОкно  = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Поле = АктивноеОкно.НайтиОбъект(,,"Str");
		Если Поле = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;	
		Возврат Поле.ПолучитьОтображаемыйТекст();
	Исключение
		Ванесса.ЗаписатьЛогВЖРОшибка("ТекстОшибкиЧерезДанныеОкнаОшибки", ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции	

// ПоказатьТекстОшибки
&НаКлиенте
Процедура ПоказатьТекстОшибки(ТекстОшибки, ПроизвольныеЗначения, НомерСтрокиДерева, ДопПараметры = Неопределено) Экспорт
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КаталогИнструментов", Ванесса.Объект.КаталогИнструментов);
	ПараметрыФормы.Вставить("ТекстОшибки", ТекстОшибки);
	ПараметрыФормы.Вставить("ДанныеОшибки", ПроизвольныеЗначения);
	ПараметрыФормы.Вставить("НомерСтрокиДерева", НомерСтрокиДерева);
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("ВозможнаАктуализацияШагаВРедакторе") Тогда
		ПараметрыФормы.Вставить("ВозможнаАктуализацияШагаВРедакторе", ДопПараметры.ВозможнаАктуализацияШагаВРедакторе);
	КонецЕсли;	
	ОткрытьФорму(Ванесса.ПолучитьИмяОбработкиVA() + ".Форма.ДеталиОшибки", ПараметрыФормы, Ванесса);
КонецПроцедуры 


&НаКлиенте
Функция ПолучитьАктивноеОкноИзКонтекста() Экспорт
	Если Ванесса.ОбъектКонтекст.Свойство("АктивноеОкно") Тогда
		Если Ванесса.ОбъектКонтекст.АктивноеОкно <> Неопределено Тогда
			Возврат Ванесса.ОбъектКонтекст.АктивноеОкно;
		КонецЕсли;
	КонецЕсли;

	Возврат Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
КонецФункции


// ДанныеКлиентовТестированияПослеУдаления
&НаКлиенте
Процедура ДанныеКлиентовТестированияПослеУдаления(Элемент) Экспорт
	
	Если Ванесса.ДанныеКлиентовТестирования.Количество() = 0 Тогда
		Ванесса.СообщитьПользователю(Ванесса.Локализовать("Должна оставаться строка подключения текущего клиента"));
		Ванесса.ЗаполнитьДанныеТекущейИнфобазы();
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ЭтотКлиент", Истина);
	
	НайденныеСтроки = Ванесса.ДанныеКлиентовТестирования.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Ванесса.СообщитьПользователю(Ванесса.Локализовать("Данные по основному подключению Клиента тестирования перезаполнены."));
		Ванесса.ЗаполнитьДанныеТекущейИнфобазы();
	КонецЕсли;
	
КонецПроцедуры

// ОткрытьНавигационнуюСсылку
&НаКлиенте
Процедура ОткрытьНавигационнуюСсылку(Стр) Экспорт
	
	Стр = Ванесса.ПолучитьЗначениеИзКонтекстаЕслиЭтоВозможно(Стр);
	КоличествоПопыток = Ванесса.ЗначениеКоличествоПопытокВыполненияДействия();
	ОписаниеОшибки = "";
	Для Ккк = 1 По КоличествоПопыток Цикл
		Попытка
			АктивноеОкно = Ванесса.ПолучитьГлавноеОкноИзТестовоеПриложение();
			АктивноеОкно.ВыполнитьКоманду(Стр);
			Ванесса.ОбработатьСменуАктивногоОкна();
			Возврат;
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			Ванесса.Sleep(1);
		КонецПопытки;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Ванесса.ЗаписатьЛогВЖРИнформация("ОткрытьНавигационнуюСсылку", ОписаниеОшибки);
	КонецЕсли;
	
	ТекАктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Если ТекАктивноеОкно <> Неопределено И Ванесса.ЭтоМодальныйДиалог(ТекАктивноеОкно) Тогда
		
		ТекстПредупреждения = Ванесса.ПолучитьТекстПредупреждения();
		ТекстСообщения = Ванесса.Локализовать("Открыт модальный диалог, поэтому нет возможности открыть навигационную ссылку <%1>");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Стр);
		ТекстСообщения = ТекстСообщения + Символы.ПС + Ванесса.Локализовать("Текст модального окна:");
		ОписаниеОшибки = ТекстСообщения + Символы.ПС + ТекстПредупреждения;
		
	КонецЕсли;	

	ВызватьИсключение ОписаниеОшибки;
	
КонецПроцедуры

// ЭтоПолеДатыКлиентаТестирования
&НаКлиенте
