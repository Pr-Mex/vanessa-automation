#КонецОбласти

#Область TeamCity

&НаКлиенте
Процедура ВывестиЛогTeamCity(Знач СтрокаСценария, Знач ТекущийФичаФайл) Экспорт
	
	Если Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск Тогда
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Ложь;
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоГруппы, "$Tag", Ванесса.НастройкиTeamCity.IDПотока); 
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;         
	
	Если Ванесса.НастройкиTeamCity.ТекущийФичаФайл = "" Тогда
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	ИначеЕсли НЕ Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл Тогда
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;
	
	Ванесса.НастройкиTeamCity.ТекущийСценарий = СтрокаСценария.Имя;
	
	ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоТеста, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
	Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	
	Т2 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДлительностьТеста = Т2 - Ванесса.ПараметрыСтатистикаВыполненияТестов._ПрогрессТ1;
	
	Если СтрокаСценария.ТекстОшибки = "" Тогда
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеТеста, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$TotalMilliseconds", ДлительностьТеста);
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	Иначе
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОшибкаТеста, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$_", ЭкранированиеСообщенияTeamCity(СтрокаСценария.ТекстОшибки));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;
	
	Если Ванесса.МассивРезультатПрохожденияТестовСценария.Количество() = Ванесса.МассивСценариевДляВыполнения.Количество() Тогда 
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Истина;
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеГруппы, "$Tag", Ванесса.НастройкиTeamCity.IDПотока); 
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьТестTeamCity(СтрокаСценария) Экспорт
	
	Файл = Новый Файл(Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].ПолныйПутьКФиче);
	ТекущийФичаФайл = Файл.ИмяБезРасширения;
	Если Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск Тогда
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Ложь;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоГруппы);
	КонецЕсли;
	
	Если Ванесса.НастройкиTeamCity.ТекущийФичаФайл = "" Тогда
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла);
	ИначеЕсли НЕ Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл Тогда
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла);
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла);
	КонецЕсли;

	Ванесса.НастройкиTeamCity.ТекущийСценарий = СтрокаСценария.Имя;
	ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоТеста);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьТестTeamCity(СтрокаСценария, РезультатПрохожденияТестовСценария) Экспорт
	Т2 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если РезультатПрохожденияТестовСценария.Свойство("ВремяНачала")
		И РезультатПрохожденияТестовСценария.ВремяНачала <> Неопределено
		И РезультатПрохожденияТестовСценария.Свойство("ВремяОкончания")
		И РезультатПрохожденияТестовСценария.ВремяОкончания <> Неопределено Тогда
		Ванесса.НастройкиTeamCity.ДлительностьТеста = РезультатПрохожденияТестовСценария.ВремяОкончания - РезультатПрохожденияТестовСценария.ВремяНачала;
	Иначе
		Ванесса.НастройкиTeamCity.ДлительностьТеста = 0;
	КонецЕсли;
	
	ТекстОшибкиTeamCity = СтрокаСценария.ТекстОшибки;
	Если (ТекстОшибкиTeamCity = "" ИЛИ ТекстОшибкиTeamCity = Неопределено)
		И Ванесса.Объект.КоличествоПопытокВыполненияСценария > 1
		И ТипЗнч(РезультатПрохожденияТестовСценария) = Тип("Структура")
		И РезультатПрохожденияТестовСценария.Свойство("Статус")
		И РезультатПрохожденияТестовСценария.Статус = "Failed"
		И РезультатПрохожденияТестовСценария.Свойство("ОшибкаВПроцедуреСценария")
		И РезультатПрохожденияТестовСценария.ОшибкаВПроцедуреСценария = Истина
		И РезультатПрохожденияТестовСценария.Свойство("ОписаниеОшибки") Тогда
		ТекстОшибкиTeamCity = РезультатПрохожденияТестовСценария.ОписаниеОшибки;
	КонецЕсли;
	
	Если ТекстОшибкиTeamCity = "" ИЛИ ТекстОшибкиTeamCity = Неопределено Тогда
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеТеста);
	Иначе
		Ванесса.НастройкиTeamCity.ТекстОшибки = ТекстОшибкиTeamCity;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОшибкаТеста);  
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеТеста);
		Ванесса.НастройкиTeamCity.ТекстОшибки = "";
	КонецЕсли;
	
	Ванесса.НастройкиTeamCity.ДлительностьТеста = 0;
	
	Если Ванесса.МассивРезультатПрохожденияТестовСценария.Количество() = Ванесса.МассивСценариевДляВыполнения.Количество() Тогда 
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Истина;
		
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла);
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеГруппы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭкранированиеСообщенияTeamCity(Стр) Экспорт
	Стр = СтрЗаменить(Стр, "|", "||");
	Стр = СтрЗаменить(Стр, "'", "|'");
	Стр = СтрЗаменить(Стр, "[", "|[");
	Стр = СтрЗаменить(Стр, "]", "|]");
	Стр = СтрЗаменить(Стр, Символы.ВК, "|r");
	Стр = СтрЗаменить(Стр, Символы.ПС, "|n");
	Возврат Стр;
КонецФункции

&НаКлиенте
Функция ПодготовитьСообщениеTeamCity(Знач ТекстСообщения) Экспорт
	
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$Tag$", Ванесса.НастройкиTeamCity.IDПотока);
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile$", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл)); 
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest$", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$TotalMilliseconds$", Формат(Ванесса.НастройкиTeamCity.ДлительностьТеста, "ЧГ="));
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$Details$", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекстОшибки));
	Возврат ТекстСообщения;             
	
КонецФункции

&НаКлиенте
Процедура ВывестиВКонсольTeamCity(Знач Стр) Экспорт
	Стр = ПодготовитьСообщениеTeamCity(Стр);  
	Если Ванесса.Объект.ИспользоватьКомпонентуVanessaExt И Ванесса.ВнешняяКомпонентаДляСкриншотов <> Неопределено И НЕ Ванесса.ЗапрещеныСинхронныеВызовы Тогда
		Ванесса.ВнешняяКомпонентаДляСкриншотов.ВывестиВКонсоль(Стр + Символы.ПС, 866);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Allure

&НаКлиенте
Функция ПолучитьКаталогОтчетаAllure() Экспорт
	Если ЗначениеЗаполнено(Ванесса.Объект.КаталогВыгрузкиAllureБазовый) Тогда
		Возврат Ванесса.ДополнитьСлешВПуть(Ванесса.ДополнитьСлешВПуть(Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Ванесса.Объект.КаталогВыгрузкиAllureБазовый))
		+ СокрЛП(Ванесса.УбратьВсеЗапрещенныеСимволыИзИмениФайла(Лев(Ванесса.Объект.ИмяТекущейСборки, 40))));
	КонецЕсли;
	
	Возврат Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогВыгрузкиAllure);
	
КонецФункции	

#КонецОбласти

#Область ПеренесённыеИзГлавнойФормы

// ВывестиСтатистикуКлиентКоротко
&НаКлиенте
Процедура ВывестиСтатистикуКлиентКоротко() Экспорт
	Поз = Найти(Ванесса.Элементы.Статистика.Заголовок, ",");
	Если Поз > 0 Тогда
		Стр = Лев(Ванесса.Элементы.Статистика.Заголовок, Поз - 1);
		ДанныеСтроки = Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(Стр, "/");
		Если ДанныеСтроки.Количество() = 3 Тогда
			ОбщаяСтатистикаПоФиче = "" + Формат(ДанныеСтроки[0], "ЧГ=; ЧН=0") + "/" 
				+ Формат(ДанныеСтроки[1], "ЧГ=; ЧН=0") + "/" 
				+ Формат(ДанныеСтроки[2], "ЧГ=; ЧН=0");
			ОбщаяСтатистикаПоФиче = Новый ФорматированнаяСтрока(ОбщаяСтатистикаПоФиче, Новый Шрифт(, , Истина));
			Ванесса.Элементы.Статистика.Заголовок = ОбщаяСтатистикаПоФиче;
		КонецЕсли;	 
	КонецЕсли;	 
КонецПроцедуры 

// Статистика_ЗафиксироватьСтатус
&НаКлиенте
Процедура Статистика_ЗафиксироватьСтатус(Статус) Экспорт
	
	Если Статус = "Success" Тогда
		
			Статистика_ЗафиксироватьУспех();
		
	ИначеЕсли СтатусСценарияСоответствуетВыполненСОшибкой(Статус) Тогда
		
			Статистика_ЗафиксироватьОшибка();
		
	ИначеЕсли Статус = "Pending" Тогда
		
			Статистика_ЗафиксироватьПропуск();
		
	КонецЕсли;
	
КонецПроцедуры

// НастройкиTeamCity
&НаКлиенте
Функция НастройкиTeamCity() Экспорт
	
	Структура = Новый Структура();
	
	Структура.Вставить("Используется", Ложь);
	Структура.Вставить("ЭтоПервыйЗапуск", Истина);
	Структура.Вставить("IDПотока", "");
	Структура.Вставить("ТекущийФичаФайл", "");
	Структура.Вставить("ТекущийСценарий", "");
	Структура.Вставить("ДлительностьТеста", 0);
	Структура.Вставить("ТекстОшибки", "");
	
	Шаблоны = Новый Структура;
	Шаблоны.Вставить("НачалоГруппы", "##teamcity[flowStarted flowId='$Tag$']");
	Шаблоны.Вставить("ОкончаниеГруппы", "##teamcity[flowFinished flowId='$Tag$']");  
	
	Шаблоны.Вставить("НачалоФичаФайла", "##teamcity[testSuiteStarted name='$Tag$.$CurrentFeatureFile$' flowId='$Tag$']");
	Шаблоны.Вставить("ОкончаниеФичаФайла", "##teamcity[testSuiteFinished name='$Tag$.$CurrentFeatureFile$' flowId='$Tag$']");    
	
	Шаблоны.Вставить("НачалоТеста", "##teamcity[testStarted name='$Tag$.$CurrentTest$' flowId='$Tag$']");
	Шаблоны.Вставить("ОшибкаТестаНаСравнение", "##teamcity[testFailed type='comparisonFailure' name='$Tag$.$CurrentTest$' details='$Details$' flowId='$Tag$' expected='$expected$' actual='$actual$']");
	Шаблоны.Вставить("ОшибкаТеста", "##teamcity[testFailed name='$Tag$.$CurrentTest$' details='$Details$' flowId='$Tag$']");
	Шаблоны.Вставить("ВыводСообщенияВГруппу", "##teamcity[testStdOut name='$Tag$.$CurrentTest$' out='$line$' flowId='$Tag$']");
	Шаблоны.Вставить("ОкончаниеТеста", "##teamcity[testFinished name='$Tag$.$CurrentTest$' duration='$TotalMilliseconds$' flowId='$Tag$']");

	Структура.Вставить("Шаблоны", Шаблоны);
	Возврат Структура;
КонецФункции        

#КонецОбласти

#Область ПеренесённыеИзГлавнойФормы

// СтатусПредыдущегоСценария
&НаКлиенте
Функция СтатусПредыдущегоСценария() Экспорт
	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaAutomation();
	
	Если СостояниеVanessaAutomation.ТекущийСценарий.ИдСценария >= 1 Тогда
		РезультатПрохожденияТестовСценария = Ванесса.ПолучитьРезультатПрохожденияТестовСценарияПоНомеруСценария(СостояниеVanessaAutomation.ТекущийСценарий.ИдСценария-1);
		Возврат РезультатПрохожденияТестовСценария.Статус;
	Иначе
		Возврат "Success"; 
	КонецЕсли;	 
	
КонецФункции	  

// СтатусСценарияСоответствуетВыполненСОшибкой
&НаКлиенте
Функция СтатусСценарияСоответствуетВыполненСОшибкой(СтрокаСтатус) Экспорт
	
	Если СтрокаСтатус = "Failed" ИЛИ СтрокаСтатус = "Broken" Тогда
		Возврат Истина;
	КонецЕсли;	 
	
	Возврат Ложь;
	
КонецФункции	 

#КонецОбласти

#Область ПеренесённыеИзГлавнойФормы

// ДобавитьШагиВРезультатПрохожденияТестовШаговКоторыеНеВыполнялись
&НаКлиенте
Процедура ДобавитьШагиВРезультатПрохожденияТестовШаговКоторыеНеВыполнялись(Шаги, ТекИД, РезультатПрохожденияТестовШагов) Экспорт
	Ид = ТекИД;
	Пока Истина Цикл
		Ид = Ид + 1;
		Если Шаги.Количество() < (Ид + 1) Тогда
			Прервать;
		КонецЕсли;	 
		
		ТекШаг = Шаги[Ид];
		
		РезультатПрохожденияШага = Новый Структура;
		РезультатПрохожденияШага.Вставить("Имя", ТекШаг.Имя);
		РезультатПрохожденияШага.Вставить("ВремяНачала", ТекущаяУниверсальнаяДатаВМиллисекундах());
		РезультатПрохожденияШага.Вставить("ВремяОкончания", ТекущаяУниверсальнаяДатаВМиллисекундах());
		РезультатПрохожденияШага.Вставить("ОписаниеОшибки", "Пропущен");
		РезультатПрохожденияШага.Вставить("Статус", "Skipped");
		РезультатПрохожденияШага.Вставить("ИДСтроки", ТекШаг.СтрокаШага);
		Если ТекШаг.Свойство("ЭтоШагКонтекста") И ТекШаг.ЭтоШагКонтекста Тогда
			РезультатПрохожденияШага.Вставить("ЭтоШагКонтекста", Истина);
		Иначе
			РезультатПрохожденияШага.Вставить("ЭтоШагКонтекста", Ложь);
		КонецЕсли;	
		
		РезультатПрохожденияТестовШагов.Добавить(РезультатПрохожденияШага);
		
	КонецЦикла;
КонецПроцедуры

// ОбработатьПеременныеДляСохраненияВШаг
&НаКлиенте
Процедура ОбработатьПеременныеДляСохраненияВШаг(РезультатПрохожденияШага, ТекШаг) Экспорт
	
	РезультатПрохожденияШага.Вставить("ПеременныеДляСохраненияВШаг", ТекШаг.ПеременныеДляСохраненияВШаг);
	ТекШаг.Удалить("ПеременныеДляСохраненияВШаг");
	
	Если ТекШаг.Свойство("ЕстьПеременныеТаблицыПеременных") Тогда
		РезультатПрохожденияШага.Вставить("ЕстьПеременныеТаблицыПеременных", ТекШаг.ЕстьПеременныеТаблицыПеременных);
	КонецЕсли;
	
	Если ТекШаг.Свойство("ЗначенияИзТаблицыПеременных") Тогда
		РезультатПрохожденияШага.Вставить("ЗначенияИзТаблицыПеременных", ТекШаг.ЗначенияИзТаблицыПеременных);
	КонецЕсли;

КонецПроцедуры

// ПрикрепитьДанныеОСостоянииАктивнойФормы
&НаКлиенте
Функция ПрикрепитьДанныеОСостоянииАктивнойФормы(ТабДок, СтрокаСценария, Расширение, ДопОписаниеОшибки) Экспорт
	#Если НЕ ВебКлиент Тогда

	Если ПустаяСтрока(ДопОписаниеОшибки) Тогда
		ДопОписание = "";
	Иначе
		ДопОписание = "_" + ДопОписаниеОшибки;
	КонецЕсли;

	Если Расширение = "mxl" Тогда

		ИмяФайла = ПолучитьИмяВременногоФайла("mxl");
		ТабДок.НачатьЗапись(,ИмяФайла,ТипФайлаТабличногоДокумента.MXL);
		Возврат Новый Структура("ИмяФайла,Расширение,Представление",ИмяФайла,"mxl",Ванесса.Локализовать("СостояниеАктивнойФормы") + ДопОписание + ".mxl");

	ИначеЕсли Расширение = "html" Тогда

		ИмяФайла = ПолучитьИмяВременногоФайла("html");
		ТабДок.НачатьЗапись(,ИмяФайла,ТипФайлаТабличногоДокумента.HTML5);
		Возврат Новый Структура("ИмяФайла,Расширение,Представление",ИмяФайла,"html",Ванесса.Локализовать("СостояниеАктивнойФормы") + ДопОписание + ".html");

	ИначеЕсли Расширение = "xlsx" Тогда

		ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
		Ванесса.ПривестиРазмерСтрокВМакетеВСоответствиеСТребованиямиФорматаXlsx(ТабДок);
		ТабДок.НачатьЗапись(,ИмяФайла,ТипФайлаТабличногоДокумента.XLSX);
		Возврат Новый Структура("ИмяФайла,Расширение,Представление",ИмяФайла,"xlsx",Ванесса.Локализовать("СостояниеАктивнойФормы") + ДопОписание + ".xlsx");

	КонецЕсли;

	#КонецЕсли
КонецФункции

