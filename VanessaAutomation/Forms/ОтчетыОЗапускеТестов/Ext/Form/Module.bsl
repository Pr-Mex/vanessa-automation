&НаКлиенте
Функция КТекущемуШагуНужноДобавлятьФайлыДляРасследованияОшибки() Экспорт

	ДанныеШагаСценария = Ванесса.ДанныеШагаСценария();
	Если ДанныеШагаСценария = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ Ванесса.ИдетВыполнениеСценариев() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ДанныеШагаСценария.Свойство("ЭтоОбычныйШагОбернутыйВУсловие") И ДанныеШагаСценария.ЭтоОбычныйШагОбернутыйВУсловие Тогда
		// Для шагов условий такое делать не надо
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПрикрепитьМакетКСценарию(Макет, Имя) Экспорт
	Если Ванесса.ТекИД_СценарияВМассиве > Ванесса.МассивСценариевДляВыполнения.Количество() - 1 Тогда
		ВызватьИсключение Ванесса.Локализовать("Не вышло получить строку сценария.");
	КонецЕсли;

	ИДСтрокиСценария = Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].СтрокаДерева;
	Ванесса.ОбновитьКешДанныхФормыЕслиЭтоНеобходимо(Неопределено, ИДСтрокиСценария, Истина);
	СтрокаСценария   = Ванесса.ПолучитьСтрокуСценарияИзДанныхФормы(ИДСтрокиСценария);

	Если СтрокаСценария = Неопределено Тогда
		ВызватьИсключение Ванесса.Локализовать("Не вышло получить строку сценария.");
	КонецЕсли;

	Если СтрокаСценария.ПроизвольныеЗначения = Неопределено Тогда
		СтрокаСценария.ПроизвольныеЗначения = Новый Структура;
	КонецЕсли;

	ПроизвольныеЗначения = СтрокаСценария.ПроизвольныеЗначения;
	Если Не ПроизвольныеЗначения.Свойство("ПрикрепленныеМакеты") Тогда
		ПроизвольныеЗначения.Вставить("ПрикрепленныеМакеты", Новый Соответствие);
	КонецЕсли;

	ПрикрепленныеМакеты = ПроизвольныеЗначения.ПрикрепленныеМакеты;
	ПрикрепленныеМакеты.Вставить(Имя, Новый Структура("Макет,Имя", Макет, Имя));
КонецПроцедуры

