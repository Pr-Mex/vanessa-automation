	Ванесса.ПараметрыСтатистикаВыполненияТестов.Вставить("ВыполненоПропуск",	0);

	Ванесса.ПараметрыСтатистикаВыполненияТестов.Вставить("_ПрогрессТ1",				ТекущаяУниверсальнаяДатаВМиллисекундах());
	Ванесса.ПараметрыСтатистикаВыполненияТестов.Вставить("_ПрогрессПредЗначение",	0);


КонецПроцедуры

&НаКлиенте
Процедура Статистика_ЗафиксироватьУспех() Экспорт

	Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоУспех = Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоУспех + 1;

КонецПроцедуры

&НаКлиенте
Процедура Статистика_ЗафиксироватьОшибка() Экспорт

	Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоОшибка = Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоОшибка + 1;

КонецПроцедуры

&НаКлиенте
Процедура Статистика_ЗафиксироватьПропуск() Экспорт

	Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоПропуск = Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоПропуск + 1;

КонецПроцедуры

&НаКлиенте
Функция ОписаниеТекущегоСостояниеВыполненияТестов(ИдСценария) Экспорт

	ПроцентВыполнения	= 0;
	ПроцентУспех		= 0;
	ПроцентОшибок		= 0;
	ВсегоСценариев		= Ванесса.МассивСценариевДляВыполнения.Количество();
	ТекВыполнено		= Ванесса.МассивРезультатПрохожденияТестовСценария.Количество() - 1; // Исключаем текущий сценарий

	Если ВсегоСценариев > 0 Тогда

		ПроцентВыполнения = Цел(ИдСценария / ВсегоСценариев * 100);

	КонецЕсли;

	Если ТекВыполнено > 0 Тогда

		ПроцентУспех	= Цел(Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоУспех / ТекВыполнено * 100);
		ПроцентОшибок	= Цел(Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоОшибка / ТекВыполнено * 100);

	КонецЕсли;

	ШаблонТекстСообщения =
	"Stage: %1%
	|------------
	|Total:   %2
	|Current: %3
	|Success: %4 (%5%)
	|Error:   %6 (%7%)
	|Skipped: %8
	|------------
	|Time: %9
	|------------";

	ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(ШаблонТекстСообщения
													, ПроцентВыполнения
													, ВсегоСценариев
													, ТекВыполнено
													, Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоУспех
													, ПроцентУспех
													, Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоОшибка
													, ПроцентОшибок
													, Ванесса.ПараметрыСтатистикаВыполненияТестов.ВыполненоПропуск
													, Статистика_ВывестиВремяВыполнения(?(ВсегоСценариев = 0, 0, ТекВыполнено / ВсегоСценариев)));

	Возврат ТекстСообщения;

КонецФункции

&НаКлиенте
Функция Статистика_ВывестиВремяВыполнения(КоэфВыполнения)

	Т2 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДельтаТ = Т2 - Ванесса.ПараметрыСтатистикаВыполненияТестов._ПрогрессТ1;

	Ванесса.ПараметрыСтатистикаВыполненияТестов._ПрогрессПредЗначение = Т2;

	ПрошлоСекунд			= Окр(ДельтаТ * 0.001);
	Если КоэфВыполнения = 0 Тогда

		ОсталосьСекунд = 86400;

	Иначе

		ВсегоТ					= ДельтаТ / КоэфВыполнения;
		ОсталосьТ 				= ВсегоТ - ДельтаТ;
		ОсталосьСекунд 			= Окр(ОсталосьТ * 0.001);

	КонецЕсли;



	Возврат Ванесса.ПодставитьПараметрыВСтроку("spend: ~%1 to end: ~%2"
										, Ванесса.МодульОбщегоНазначенияVA().ПолучитьВремя(ПрошлоСекунд)
										, Ванесса.МодульОбщегоНазначенияVA().ПолучитьВремя(ОсталосьСекунд));

КонецФункции

#КонецОбласти
