#Область TeamCity

&НаКлиенте
Процедура ВывестиЛогTeamCity(Знач СтрокаСценария, Знач ТекущийФичаФайл) Экспорт
	
	Если Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск Тогда
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Ложь;
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоГруппы, "$Tag", Ванесса.НастройкиTeamCity.IDПотока); 
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;         
	
	Если Ванесса.НастройкиTeamCity.ТекущийФичаФайл = "" Тогда
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	ИначеЕсли НЕ Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл Тогда
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;
	
	Ванесса.НастройкиTeamCity.ТекущийСценарий = СтрокаСценария.Имя;
	
	ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.НачалоТеста, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
	Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	
	Т2 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДлительностьТеста = Т2 - Ванесса.ПараметрыСтатистикаВыполненияТестов._ПрогрессТ1;
	
	Если СтрокаСценария.ТекстОшибки = "" Тогда
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеТеста, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$TotalMilliseconds", ДлительностьТеста);
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	Иначе
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОшибкаТеста, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$_", ЭкранированиеСообщенияTeamCity(СтрокаСценария.ТекстОшибки));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;
	
	Если Ванесса.МассивРезультатПрохожденияТестовСценария.Количество() = Ванесса.МассивСценариевДляВыполнения.Количество() Тогда 
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Истина;
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла, "$Tag", Ванесса.НастройкиTeamCity.IDПотока);  
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл));
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
		
		ТекстСообщения = СтрЗаменить(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеГруппы, "$Tag", Ванесса.НастройкиTeamCity.IDПотока); 
		Ванесса.ЗаписатьСтрокуВТекстовыйЛогИлиКонсоль(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьТестTeamCity(СтрокаСценария) Экспорт
	
	Файл = Новый Файл(Ванесса.МассивСценариевДляВыполнения[Ванесса.ТекИД_СценарияВМассиве].ПолныйПутьКФиче);
	ТекущийФичаФайл = Файл.ИмяБезРасширения;
	Если Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск Тогда
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Ложь;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоГруппы);
	КонецЕсли;
	
	Если Ванесса.НастройкиTeamCity.ТекущийФичаФайл = "" Тогда
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла);
	ИначеЕсли НЕ Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл Тогда
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла);
		Ванесса.НастройкиTeamCity.ТекущийФичаФайл = ТекущийФичаФайл;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоФичаФайла);
	КонецЕсли;

	Ванесса.НастройкиTeamCity.ТекущийСценарий = СтрокаСценария.Имя;
	ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.НачалоТеста);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьТестTeamCity(СтрокаСценария, РезультатПрохожденияТестовСценария) Экспорт
	Т2 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если РезультатПрохожденияТестовСценария.Свойство("ВремяНачала")
		И РезультатПрохожденияТестовСценария.ВремяНачала <> Неопределено
		И РезультатПрохожденияТестовСценария.Свойство("ВремяОкончания")
		И РезультатПрохожденияТестовСценария.ВремяОкончания <> Неопределено Тогда
		Ванесса.НастройкиTeamCity.ДлительностьТеста = РезультатПрохожденияТестовСценария.ВремяОкончания - РезультатПрохожденияТестовСценария.ВремяНачала;
	Иначе
		Ванесса.НастройкиTeamCity.ДлительностьТеста = 0;
	КонецЕсли;
	
	Если СтрокаСценария.ТекстОшибки = "" Тогда
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеТеста);
	Иначе
		Ванесса.НастройкиTeamCity.ТекстОшибки = СтрокаСценария.ТекстОшибки;
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОшибкаТеста);  
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеТеста);
		Ванесса.НастройкиTeamCity.ТекстОшибки = "";
	КонецЕсли;
	
	Ванесса.НастройкиTeamCity.ДлительностьТеста = 0;
	
	Если Ванесса.МассивРезультатПрохожденияТестовСценария.Количество() = Ванесса.МассивСценариевДляВыполнения.Количество() Тогда 
		Ванесса.НастройкиTeamCity.ЭтоПервыйЗапуск = Истина;
		
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеФичаФайла);
		ВывестиВКонсольTeamCity(Ванесса.НастройкиTeamCity.Шаблоны.ОкончаниеГруппы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭкранированиеСообщенияTeamCity(Стр) Экспорт
	Стр = СтрЗаменить(Стр, "|", "||");
	Стр = СтрЗаменить(Стр, "'", "|'");
	Стр = СтрЗаменить(Стр, "[", "|[");
	Стр = СтрЗаменить(Стр, "]", "|]");
	Стр = СтрЗаменить(Стр, Символы.ВК, "|r");
	Стр = СтрЗаменить(Стр, Символы.ПС, "|n");
	Возврат Стр;
КонецФункции

&НаКлиенте
Функция ПодготовитьСообщениеTeamCity(Знач ТекстСообщения) Экспорт
	
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$Tag$", Ванесса.НастройкиTeamCity.IDПотока);
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentFeatureFile$", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийФичаФайл)); 
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$CurrentTest$", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекущийСценарий));
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$TotalMilliseconds$", Формат(Ванесса.НастройкиTeamCity.ДлительностьТеста, "ЧГ="));
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "$Details$", ЭкранированиеСообщенияTeamCity(Ванесса.НастройкиTeamCity.ТекстОшибки));
	Возврат ТекстСообщения;             
	
КонецФункции

&НаКлиенте
Процедура ВывестиВКонсольTeamCity(Знач Стр) Экспорт
	Стр = ПодготовитьСообщениеTeamCity(Стр);  
	Если Ванесса.Объект.ИспользоватьКомпонентуVanessaExt И Ванесса.ВнешняяКомпонентаДляСкриншотов <> Неопределено И НЕ Ванесса.ЗапрещеныСинхронныеВызовы Тогда
		Ванесса.ВнешняяКомпонентаДляСкриншотов.ВывестиВКонсоль(Стр + Символы.ПС, 866);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Allure

&НаКлиенте
Функция ПолучитьКаталогОтчетаAllure() Экспорт
	Если ЗначениеЗаполнено(Ванесса.Объект.КаталогВыгрузкиAllureБазовый) Тогда
		Возврат Ванесса.ДополнитьСлешВПуть(Ванесса.ДополнитьСлешВПуть(Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Ванесса.Объект.КаталогВыгрузкиAllureБазовый))
		+ СокрЛП(Ванесса.УбратьВсеЗапрещенныеСимволыИзИмениФайла(Лев(Ванесса.Объект.ИмяТекущейСборки, 40))));
	КонецЕсли;
	
	Возврат Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогВыгрузкиAllure);
	
КонецФункции	

#КонецОбласти

#Область СППР

&НаСервереБезКонтекста
Функция ПодставитьПараметрыВСтрокуСервер(Знач Стр, Парам1 = Неопределено,
                                             Парам2 = Неопределено,
                                             Парам3 = Неопределено,
                                             Парам4 = Неопределено,
                                             Парам5 = Неопределено,
                                             Парам6 = Неопределено,
                                             Парам7 = Неопределено)
											 
											 
	Если Парам1 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%1",Парам1);
	КонецЕсли;	 											 
	Если Парам2 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%2",Парам2);
	КонецЕсли;	 											 
	Если Парам3 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%3",Парам3);
	КонецЕсли;	 											 
	Если Парам4 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%4",Парам4);
	КонецЕсли;	 											 
	Если Парам5 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%5",Парам5);
	КонецЕсли;	 											 
	Если Парам6 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%6",Парам6);
	КонецЕсли;	 											 
	Если Парам7 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр,"%7",Парам7);
	КонецЕсли;	 											 
	
	Возврат Стр;
КонецФункции	 

// Возвращает многострочную строку по переданному массиву. Для замены СтрСоединить.
&НаКлиентеНаСервереБезКонтекста
Функция МассивВСтрокуНаСервереБезКонтекста(Знач Массив, Знач Символ = Неопределено,
	Знач ЕстьПоддержкаФункцияРазложитьСтрокуВМассивПодстрок = Ложь) Экспорт
	
	Если Символ = Неопределено Тогда
		Символ = Символы.ПС;
	КонецЕсли;
	
	Если ЕстьПоддержкаФункцияРазложитьСтрокуВМассивПодстрок Тогда
		Возврат Вычислить("СтрСоединить(Массив, Символ)"); 
	КонецЕсли;
	
	Стр = "";
	Для Ккк = 0 По Массив.Количество() - 1 Цикл
		Стр = Стр + Массив[Ккк];
		Если Ккк < Массив.Количество() - 1 Тогда
			Стр = Стр + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Стр;
КонецФункции

