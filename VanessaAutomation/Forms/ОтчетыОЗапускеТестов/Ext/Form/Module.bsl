	Шаблоны = Новый Структура;
	Шаблоны.Вставить("НачалоГруппы", "##teamcity[flowStarted flowId='$Tag$']");
	Шаблоны.Вставить("ОкончаниеГруппы", "##teamcity[flowFinished flowId='$Tag$']");  
	
