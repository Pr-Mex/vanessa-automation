#КонецОбласти

#Область БазовыеХелперыИMarkdown

&НаКлиенте
Функция ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра) Экспорт

	Аргументы = Неопределено;
	Попытка
		Аргументы = Запрос.Аргументы;
	Исключение
		Возврат "";
	КонецПопытки;
	Если Аргументы = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(ИмяПараметра, Результат);
	Иначе
		Попытка
			Результат = Аргументы[ИмяПараметра];
		Исключение
			Результат = "";
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отличает отсутствующий параметр от переданного пустого значения.
&НаКлиенте
Функция ПараметрПрисутствуетВЗапросе(Запрос, ИмяПараметра) Экспорт

	Аргументы = Неопределено;
	Попытка
		Аргументы = Запрос.Аргументы;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если Аргументы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Возврат Аргументы.Свойство(ИмяПараметра);
	КонецЕсли;

	// Соответствие по отсутствующему ключу возвращает Неопределено без исключения
	Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из Аргументы Цикл
			Если КлючЗначение.Ключ = ИмяПараметра Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Значение = Аргументы[ИмяПараметра];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Строковое значение параметра запроса: Неопределено и Null дают пустую строку,
// иначе они превратились бы в отбор по литералам "Неопределено"/"Null".
// Возвращает значение без внешних пробелов.
&НаКлиенте
Функция СтрокаПараметраИзЗапроса(Запрос, ИмяПараметра) Экспорт
	
	Значение = ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

// Читает булев параметр запроса.
// Допустимы булево и строки true/false, истина/ложь (без учёта регистра).
// Если параметр не указан (в том числе Неопределено или Null), возвращает значение по умолчанию.
// Для значений других типов и нераспознанных строк выбрасывает исключение.
&НаКлиенте
Функция БулевПараметрИзЗапроса(Запрос, ИмяПараметра, ЗначениеПоУмолчанию = Ложь) Экспорт

	Если НЕ ПараметрПрисутствуетВЗапросе(Запрос, ИмяПараметра) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = ЗначениеПараметраИзЗапроса(Запрос, ИмяПараметра);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ТекстЗначения = НРег(СокрЛП(Значение));
		Если ТекстЗначения = "true" ИЛИ ТекстЗначения = "истина" Тогда
			Возврат Истина;
		ИначеЕсли ТекстЗначения = "false" ИЛИ ТекстЗначения = "ложь" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Параметр %1 должен иметь булево значение (true/false или истина/ложь). Получено: %2."),
		ИмяПараметра,
		Строка(Значение));
	ВызватьИсключение ТекстОшибки;

КонецФункции

// Возвращает хвост навигационной ссылки команды: общий префикс "e1cib/command/" сокращается.
// Если префикса в ссылке нет - ссылка возвращается целиком.
&НаКлиенте
Функция ХвостНавигационнойСсылкиКоманды(НавигационнаяСсылка) Экспорт
	
	Ссылка = Строка(НавигационнаяСсылка);
	Префикс = "e1cib/command/";
	Если Лев(Ссылка, СтрДлина(Префикс)) = Префикс Тогда
		Возврат Сред(Ссылка, СтрДлина(Префикс) + 1);
	КонецЕсли;
	Возврат Ссылка;
	
КонецФункции

// Формирует компактную строку команды панели функций: "* Имя команды" или "* Имя команды => хвост навигационной ссылки".
&НаКлиенте
Функция СтрокаКомандыПанелиФункций(Элемент, ВозвращатьСсылки = Ложь) Экспорт
	
	СтрокаКоманды = "* " + Элемент.ТекстЗаголовка;
	Если ВозвращатьСсылки И ЗначениеЗаполнено(Элемент.НавигационнаяСсылка) Тогда
		СтрокаКоманды = СтрокаКоманды + " => " + ХвостНавигационнойСсылкиКоманды(Элемент.НавигационнаяСсылка);
	КонецЕсли;
	Возврат СтрокаКоманды;
	
КонецФункции

// Дата из строки параметра периода (date_start / date_end инструмента get_table_data).
// Поддерживаются форматы: "ДД.ММ.ГГГГ[ чч:мм[:сс]]", "ГГГГ-ММ-ДД[ чч:мм[:сс]]" (в том числе с разделителем T),
// а также форматы, которые понимает ДатаИзСтрокиКомандыСистемы (например, "ММ/ДД/ГГГГ чч:мм:сс").
// Если время не указано: для начала периода берётся 00:00:00, для окончания - 23:59:59.
// Если строку разобрать не удалось, возвращает Неопределено.
&НаКлиенте
Функция MCPДатаИзСтрокиПериода(ТекстДаты, ЭтоОкончаниеПериода = Ложь) Экспорт
	
	Текст = СокрЛП(Строка(ТекстДаты));
	Результат = Неопределено;
	
	Попытка
		Год = 0;
		Месяц = 0;
		День = 0;
		Остаток = "";
		Распознан = Ложь;
		
		Если СтрДлина(Текст) >= 10 И Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-" Тогда
			// ГГГГ-ММ-ДД
			Год = Число(Лев(Текст, 4));
			Месяц = Число(Сред(Текст, 6, 2));
			День = Число(Сред(Текст, 9, 2));
			Остаток = СокрЛП(Сред(Текст, 11));
			Распознан = Истина;
		ИначеЕсли СтрДлина(Текст) >= 10 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
			// ДД.ММ.ГГГГ
			День = Число(Лев(Текст, 2));
			Месяц = Число(Сред(Текст, 4, 2));
			Год = Число(Сред(Текст, 7, 4));
			Остаток = СокрЛП(Сред(Текст, 11));
			Распознан = Истина;
		КонецЕсли;
		
		Если Распознан Тогда
			Часы = 0;
			Минуты = 0;
			Секунды = 0;
			ЕстьВремя = Ложь;
			
			Если Лев(Остаток, 1) = "T" ИЛИ Лев(Остаток, 1) = "t" Тогда
				Остаток = СокрЛП(Сред(Остаток, 2));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Остаток) Тогда
				ЧастиВремени = Ванесса._СтрРазделить(Остаток, ":", Истина);
				Если ЧастиВремени.Количество() >= 2 И ЧастиВремени.Количество() <= 3 Тогда
					Часы = Число(ЧастиВремени[0]);
					Минуты = Число(ЧастиВремени[1]);
					Если ЧастиВремени.Количество() = 3 Тогда
						Секунды = Число(ЧастиВремени[2]);
					КонецЕсли;
					ЕстьВремя = Истина;
				Иначе
					Распознан = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если Распознан Тогда
				ДатаПериода = Дата(Год, Месяц, День, Часы, Минуты, Секунды);
				Если Год(ДатаПериода) = Год И Месяц(ДатаПериода) = Месяц И День(ДатаПериода) = День Тогда
					Если НЕ ЕстьВремя И ЭтоОкончаниеПериода Тогда
						ДатаПериода = Дата(Год, Месяц, День, 23, 59, 59);
					КонецЕсли;
					Результат = ДатаПериода;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		// Поддержка форматов, которые понимает штатный разбор строки команды системы.
		Попытка
			Результат = Ванесса.ДатаИзСтрокиКомандыСистемы(Текст);
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPБезопасноеСвойство(ИсходнаяСтруктура, ИмяСвойства) Экспорт
	
	Если ТипЗнч(ИсходнаяСтруктура) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ИсходнаяСтруктура.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Собирает текст ошибки в едином порядке: суть -> что делать -> детали.
// Детали могут быть большими (список значений, состояние формы): при обрезке ответа средой
// суть и рекомендация сохраняются, теряется только хвост деталей.
&НаКлиенте
Функция MCPОформитьОшибку(Суть, ЧтоДелать = "", Детали = "") Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("Ошибка:") + " " + СокрЛП(Строка(Суть)));
	Если ЗначениеЗаполнено(ЧтоДелать) Тогда
		Строки.Добавить(Ванесса.Локализовать("Что делать:") + " " + СокрЛП(Строка(ЧтоДелать)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Детали) Тогда
		Строки.Добавить(Ванесса.Локализовать("Детали:"));
		Строки.Добавить(Строка(Детали));
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Первая строка текста ошибки шага - её суть (например, "Не получилось сделать выбор в поле <X> значения <Y>.").
&НаКлиенте
Функция MCPСутьОшибкиИзТекста(Текст) Экспорт
	
	Части = Ванесса._СтрРазделить(Строка(Текст), Символы.ПС);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Части[0]);
	
КонецФункции

// Всё, что идёт после первой строки текста ошибки шага - её детали (список значений, пояснения шага).
&НаКлиенте
Функция MCPДеталиОшибкиИзТекста(Текст) Экспорт
	
	Части = Ванесса._СтрРазделить(Строка(Текст), Символы.ПС);
	Если Части.Количество() <= 1 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Новый Массив;
	Для Сч = 1 По Части.Количество() - 1 Цикл
		Остаток.Добавить(Части[Сч]);
	КонецЦикла;
	Возврат Ванесса._СтрСоединить(Остаток, Символы.ПС);
	
КонецФункции

// Возвращает токен прогресса клиента из _meta.progressToken запроса (спецификация MCP); кит кладёт его в Запрос.Контекст.progressToken.
// Неопределено, если клиент не передал токен (прогресс слать нельзя) или контекст недоступен.
&НаКлиенте
Функция ПрогрессТокенИзЗапроса(Запрос) Экспорт

	Токен = Неопределено;
	Попытка
		Контекст = Запрос.Контекст;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("progressToken", Токен);
	ИначеЕсли ТипЗнч(Контекст) = Тип("Соответствие") Тогда
		Токен = Контекст.Получить("progressToken");
	КонецЕсли;

	Если Токен = Null Тогда
		Токен = Неопределено;
	КонецЕсли;

	Возврат Токен;

КонецФункции

&НаКлиенте
Функция MCPСформироватьMarkdownСостоянияVA(Данные) Экспорт
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Состояние Vanessa Automation"));
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("- Выполнение сценариев:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["isRunning"]));
	ИдПрогонаСостояния = MCPБезопасноеСвойство(Данные, "runId");
	Если ЗначениеЗаполнено(ИдПрогонаСостояния) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Идентификатор прогона:") + " " + MCPПредставлениеЗначенияДляMarkdown(ИдПрогонаСостояния));
	КонецЕсли;	
	КлиентТестированияПодключен = Данные["testClientConnected"];
	Строки.Добавить(Ванесса.Локализовать("- Клиент тестирования подключён:") + " " + MCPПредставлениеЗначенияДляMarkdown(КлиентТестированияПодключен));
	Строки.Добавить(Ванесса.Локализовать("- Включена запись действий пользователя:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["ВключенаЗаписьДействийПользователя"]));
	Если Данные["testClientConnected"] Тогда
		Строки.Добавить(Ванесса.Локализовать("  " + "- Имя профиля клиента тестирования:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["ИмяПрофиляКлиентаТестирования"]));
	КонецЕсли;	
	Строки.Добавить(Ванесса.Локализовать("- Каталог фич:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["featureDirectory"]));
	Строки.Добавить(Ванесса.Локализовать("- Каталог проекта:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["КаталогПроекта"]));
	Строки.Добавить("");

	Строки.Добавить(Ванесса.Локализовать("## Текущая фича (по данным прогона)"));
	Строки.Добавить(MCPСформироватьMarkdownРазделСвойств(Данные["currentFeature"]));
	Строки.Добавить("");

	Строки.Добавить(Ванесса.Локализовать("## Текущий сценарий (по данным прогона)"));
	Строки.Добавить(MCPСформироватьMarkdownСценарийСостояния(Данные["currentScenario"]));
	Строки.Добавить("");

	Строки.Добавить(Ванесса.Локализовать("## Текущий шаг (по данным прогона)"));
	Строки.Добавить(MCPСформироватьMarkdownРазделСвойств(Данные["currentStep"]));
	
	// Подсказки, если ничего не загружено
	ФичаПуста = Данные["currentFeature"] = Неопределено
		ИЛИ (ТипЗнч(Данные["currentFeature"]) = Тип("Структура")
			И (НЕ Данные["currentFeature"].Свойство("name")
				ИЛИ Данные["currentFeature"]["name"] = Неопределено
				ИЛИ СокрЛП(Строка(Данные["currentFeature"]["name"])) = ""));
	СценарийПуст = Данные["currentScenario"] = Неопределено
		ИЛИ (ТипЗнч(Данные["currentScenario"]) = Тип("Структура")
			И (НЕ Данные["currentScenario"].Свойство("name")
				ИЛИ Данные["currentScenario"]["name"] = Неопределено
				ИЛИ СокрЛП(Строка(Данные["currentScenario"]["name"])) = ""));
	Если НЕ Данные["isRunning"] И НЕ (ФичаПуста И СценарийПуст) Тогда
		// После останова данные прогона остаются в движке: без пометки Running у шага читается
		// как «шаг выполняется прямо сейчас», хотя прогон уже не идёт
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Прогон сейчас не выполняется: разделы выше показывают данные последнего прогона."));
		ТекущийШаг = Данные["currentStep"];
		Если ТипЗнч(ТекущийШаг) = Тип("Структура")
			И ТекущийШаг.Свойство("status")
			И Строка(ТекущийШаг["status"]) = "Running" Тогда
			Строки.Добавить(Ванесса.Локализовать("Шаг не завершён: прогон был прерван на этом шаге."));
		КонецЕсли;	
	КонецЕсли;	
	Если ФичаПуста И СценарийПуст Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Данные прогона отсутствуют: фича, сценарий и шаг появятся здесь после запуска сценариев."));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Следующие шаги"));
		Строки.Добавить(Ванесса.Локализовать("- Загрузите фичи: `load_features`"));
		Если КлиентТестированияПодключен <> Истина Тогда
			Строки.Добавить(Ванесса.Локализовать("- Подключите клиента тестирования: `manage_test_client` с `action: connect`"));
		КонецЕсли;
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Компактный результат сценария для состояния: один блок технических данных и подробности ошибки в details.
// Сырой результат движка не меняется, поэтому отчёты и get_test_results работают как раньше.
&НаКлиенте
Функция MCPКраткийРезультатСценария(Результат) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Краткий = Новый Структура;
	Краткий.Вставить("status", MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Результат, "Статус")));
	Краткий.Вставить("startedAt", MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Результат, "ДатаНачала")));
	Краткий.Вставить("finishedAt", MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Результат, "ДатаОкончания")));
	
	ВремяНачала = MCPБезопасноеСвойство(Результат, "ВремяНачала");
	ВремяОкончания = MCPБезопасноеСвойство(Результат, "ВремяОкончания");
	Если ТипЗнч(ВремяНачала) = Тип("Число") И ТипЗнч(ВремяОкончания) = Тип("Число") Тогда
		Краткий.Вставить("durationMs", ВремяОкончания - ВремяНачала);
	КонецЕсли;
	
	Шаги = MCPБезопасноеСвойство(Результат, "РезультатПрохожденияТестовШагов");
	УпавшийШаг = MCPПервыйУпавшийШаг(Шаги);
	Краткий.Вставить("failedStep", MCPКраткоеОписаниеШага(УпавшийШаг));
	
	// Движок может оставить данные ошибки от падения, обработанного Попытка/Исключение.
	// При итоговом Success они не относятся к результату.
	УспешныйРезультат = НРег(MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Результат, "Статус"))) = "success";
	Если УспешныйРезультат Тогда
		ИсточникОшибки = "";
	Иначе
		ИсточникОшибки = MCPИсточникОшибкиСценария(Результат, УпавшийШаг);
	КонецЕсли;
	ТекстОшибки = MCPОбрезатьТехническиеДанные(ИсточникОшибки);
	Краткий.Вставить("error", ТекстОшибки);
	
	ТехническиеДанные = MCPВыделитьТехническиеДанныеИзСтроки(ИсточникОшибки);
	Если ЗначениеЗаполнено(ТехническиеДанные) Тогда
		Краткий.Вставить("technicalData", ТехническиеДанные);
	КонецЕсли;
	
	Если НЕ УспешныйРезультат Тогда
		Подробности = MCPОбрезатьТехническиеДанные(MCPПодробностиОшибкиИзРезультата(Результат));
		Если ЗначениеЗаполнено(Подробности)
			И СокрЛП(Подробности) <> СокрЛП(ТекстОшибки) Тогда
			Краткий.Вставить("details", Подробности);
		КонецЕсли;
	КонецЕсли;
	
	Краткий.Вставить("steps", MCPКраткиеШагиСценария(Шаги));
	Краткий.Вставить("counters", MCPСчетчикиСтатусовШагов(Шаги));
	
	Возврат Краткий;
	
КонецФункции

&НаКлиенте
Функция MCPСформироватьMarkdownСценарийСостояния(ДанныеСценария) Экспорт
	
	Если ТипЗнч(ДанныеСценария) <> Тип("Структура") Тогда
		Возврат MCPСформироватьMarkdownРазделСвойств(ДанныеСценария);
	КонецЕсли;
	
	Строки = Новый Массив;
	Для Каждого КлючЗначение Из ДанныеСценария Цикл
		Если КлючЗначение.Ключ = "result" Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("- " + КлючЗначение.Ключ + ": " + MCPЭкранироватьMarkdownМногострочный(MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение), Ложь));
	КонецЦикла;
	
	Результат = MCPБезопасноеСвойство(ДанныеСценария, "result");
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("Данные отсутствуют.");
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	СтатусРезультата = MCPБезопасноеСвойство(Результат, "status");
	Если НЕ ЗначениеЗаполнено(СтатусРезультата) Тогда
		СтатусРезультата = Неопределено;
	КонецЕсли;
	Строки.Добавить("- Результат, статус: " + MCPПредставлениеЗначенияДляMarkdown(СтатусРезультата));
	Если ЗначениеЗаполнено(MCPБезопасноеСвойство(Результат, "startedAt")) Тогда
		Строки.Добавить("- Начало: " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Результат, "startedAt")));
	КонецЕсли;
	Если ЗначениеЗаполнено(MCPБезопасноеСвойство(Результат, "finishedAt")) Тогда
		Строки.Добавить("- Окончание: " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Результат, "finishedAt")));
	КонецЕсли;
	Если MCPБезопасноеСвойство(Результат, "durationMs") <> Неопределено Тогда
		Строки.Добавить("- Длительность, мс: " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Результат, "durationMs")));
	КонецЕсли;
	
	УпавшийШаг = MCPБезопасноеСвойство(Результат, "failedStep");
	Если ТипЗнч(УпавшийШаг) = Тип("Структура") Тогда
		ТекстУпавшегоШага = "- Упавший шаг: " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "name"))
			+ Ванесса.Локализовать(" (строка") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "lineNumber"))
			+ ", " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "status"))
			+ ", id=" + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "id")) + ")";
		Если MCPБезопасноеСвойство(УпавшийШаг, "isSubScenarioStep") = Истина Тогда
			ТекстУпавшегоШага = ТекстУпавшегоШага
				+ Ванесса.Локализовать(", файл:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "stepFile"))
				+ Ванесса.Локализовать(", строка вызова:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "subScenarioCallLine"))
				+ " (id=" + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(УпавшийШаг, "callId")) + ")";
		КонецЕсли;
		Строки.Добавить(ТекстУпавшегоШага);
	КонецЕсли;
	
	ТекстОшибки = MCPБезопасноеСвойство(Результат, "error");
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Строки.Добавить("- Ошибка:");
		MCPДобавитьМногострочныйТекст(Строки, ТекстОшибки, "  ");
	КонецЕсли;
	
	ТехническиеДанные = MCPБезопасноеСвойство(Результат, "technicalData");
	Если ЗначениеЗаполнено(ТехническиеДанные) Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("### Технические данные"));
		MCPДобавитьМногострочныйТекст(Строки, ТехническиеДанные, "");
	КонецЕсли;
	
	Подробности = MCPБезопасноеСвойство(Результат, "details");
	Если ЗначениеЗаполнено(Подробности) Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("### Подробности ошибки"));
		MCPДобавитьМногострочныйТекст(Строки, Подробности, "");
	КонецЕсли;
	
	Шаги = MCPБезопасноеСвойство(Результат, "steps");
	Если ТипЗнч(Шаги) = Тип("Массив") И Шаги.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("### Шаги"));
		Для Каждого Шаг Из Шаги Цикл
			СтрокаШага = "- " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Шаг, "lineNumber"))
				+ ". [" + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Шаг, "status")) + "] "
				+ MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Шаг, "name"));
			Длительность = MCPБезопасноеСвойство(Шаг, "durationMs");
			Если Длительность <> Неопределено Тогда
				СтрокаШага = СтрокаШага + Ванесса.Локализовать(", мс:") + " " + MCPПредставлениеЗначенияДляMarkdown(Длительность);
			КонецЕсли;
			Если MCPБезопасноеСвойство(Шаг, "isSubScenarioStep") = Истина Тогда
				СтрокаШага = СтрокаШага
					+ Ванесса.Локализовать(", файл:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Шаг, "stepFile"))
					+ Ванесса.Локализовать(", вызов:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Шаг, "subScenarioCallLine"))
					+ " (id=" + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Шаг, "callId")) + ")";
			КонецЕсли;
			ИдШага = MCPБезопасноеСвойство(Шаг, "id");
			Если ЗначениеЗаполнено(ИдШага) Тогда
				СтрокаШага = СтрокаШага + ", id: " + MCPПредставлениеЗначенияДляMarkdown(ИдШага);
			КонецЕсли;
			Строки.Добавить(СтрокаШага);
			ОшибкаШага = MCPБезопасноеСвойство(Шаг, "error");
			Если ЗначениеЗаполнено(ОшибкаШага) И СокрЛП(ОшибкаШага) <> СокрЛП(ТекстОшибки) Тогда
				MCPДобавитьМногострочныйТекст(Строки, ОшибкаШага, "    ");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Счетчики = MCPБезопасноеСвойство(Результат, "counters");
	Если ТипЗнч(Счетчики) = Тип("Структура") Тогда
		Части = Новый Массив;
		Для Каждого КлючЗначение Из Счетчики Цикл
			Части.Добавить(КлючЗначение.Ключ + "=" + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
		КонецЦикла;
		Если Части.Количество() > 0 Тогда
			Строки.Добавить("");
			Строки.Добавить("- Шаги по статусам: " + Ванесса._СтрСоединить(Части, ", "));
		КонецЕсли;
	КонецЕсли;
	
	Если Строки.Количество() = 0 Тогда
		Возврат Ванесса.Локализовать("Данные отсутствуют.");
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция MCPЭкранироватьMarkdownСтроку(Стр) Экспорт
	Позиция = 1;
	Длина = СтрДлина(Стр);
	Пока Позиция <= Длина И (Сред(Стр, Позиция, 1) = " " ИЛИ Сред(Стр, Позиция, 1) = Символы.Таб) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция <= Длина И Сред(Стр, Позиция, 1) = "#" Тогда
		Возврат Лев(Стр, Позиция - 1) + "\" + Сред(Стр, Позиция);
	КонецЕсли;
	Возврат Стр;
КонецФункции

&НаКлиенте
Функция MCPЭкранироватьMarkdownМногострочный(Текст, ЭкранироватьПервуюСтроку = Истина) Экспорт
	Строки = Новый Массив;
	Номер = 0;
	Для Каждого СтрокаТекста Из Ванесса._СтрРазделить(Строка(Текст), Символы.ПС) Цикл
		Номер = Номер + 1;
		Если Номер = 1 И НЕ ЭкранироватьПервуюСтроку Тогда
			Строки.Добавить(СтрокаТекста);
		Иначе
			Строки.Добавить(MCPЭкранироватьMarkdownСтроку(СтрокаТекста));
		КонецЕсли;	
	КонецЦикла;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаКлиенте
Процедура MCPДобавитьМногострочныйТекст(Строки, Текст, Отступ)
	Для Каждого СтрокаТекста Из Ванесса._СтрРазделить(Строка(Текст), Символы.ПС) Цикл
		Строки.Добавить(Отступ + MCPЭкранироватьMarkdownСтроку(СтрокаТекста));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция MCPСтрокаИлиПустая(Значение) Экспорт
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

&НаКлиенте
Функция MCPПервыйУпавшийШаг(Шаги) Экспорт
	
	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ИскомыйСтатус Из Ванесса._СтрРазделить("Failed,Broken", ",") Цикл
		Для Каждого Шаг Из Шаги Цикл
			// Обработанное секцией Попытка/Исключение падение не считается упавшим шагом:
			// движок исключает такие записи при расчёте статуса сценария.
			Если MCPБезопасноеСвойство(Шаг, "ШагУпалВСекцииПопыткаИсключение") = Истина Тогда
				Продолжить;
			КонецЕсли;
			Если MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Шаг, "Статус")) = ИскомыйСтатус Тогда
				Возврат Шаг;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция MCPКраткоеОписаниеШага(Шаг) Экспорт
	
	Если ТипЗнч(Шаг) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Краткий = Новый Структура;
	Краткий.Вставить("name", MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Шаг, "Имя")));
	Краткий.Вставить("lineNumber", MCPБезопасноеСвойство(Шаг, "НомерСтрокиВФиче"));
	Краткий.Вставить("id", MCPБезопасноеСвойство(Шаг, "ИДСтроки"));
	Краткий.Вставить("stepFile", MCPБезопасноеСвойство(Шаг, "ФайлШага"));
	Краткий.Вставить("isSubScenarioStep", MCPБезопасноеСвойство(Шаг, "ЭтоШагПодсценария"));
	Краткий.Вставить("subScenarioCallLine", MCPБезопасноеСвойство(Шаг, "СтрокаШагаПодсценарияФичи"));
	Краткий.Вставить("callId", MCPБезопасноеСвойство(Шаг, "ИдСтрокиШагаПодсценария"));
	Краткий.Вставить("status", MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Шаг, "Статус")));
	ЗначениеОшибки = MCPБезопасноеСвойство(Шаг, "ОписаниеОшибки");
	Если ТипЗнч(ЗначениеОшибки) <> Тип("Строка") Тогда
		ЗначениеОшибки = "";
	КонецЕсли;
	Краткий.Вставить("error", MCPОбрезатьТехническиеДанные(ЗначениеОшибки));
	Возврат Краткий;
	
КонецФункции

&НаКлиенте
Функция MCPИсточникОшибкиСценария(Результат, УпавшийШаг) Экспорт
	
	Если ТипЗнч(УпавшийШаг) = Тип("Структура") Тогда
		ОшибкаШага = MCPСтрокаИлиПустая(MCPБезопасноеСвойство(УпавшийШаг, "ОписаниеОшибки"));
		Если ЗначениеЗаполнено(ОшибкаШага) Тогда
			Возврат ОшибкаШага;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеJson = MCPБезопасноеСвойство(Результат, "ДанныеДляФормированияJsonОбОшибке");
	ОшибкаJson = MCPСтрокаИлиПустая(MCPБезопасноеСвойство(ДанныеJson, "ТекстОшибки"));
	Если ЗначениеЗаполнено(ОшибкаJson) Тогда
		Возврат ОшибкаJson;
	КонецЕсли;
	
	Возврат MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Результат, "ОписаниеОшибки"));
	
КонецФункции

&НаКлиенте
Функция MCPПодробностиОшибкиИзРезультата(Результат) Экспорт
	
	ДанныеJson = MCPБезопасноеСвойство(Результат, "ДанныеДляФормированияJsonОбОшибке");
	Подробности = MCPСтрокаИлиПустая(MCPБезопасноеСвойство(ДанныеJson, "ПодробноеПредставлениеОшибки"));
	Если НЕ ЗначениеЗаполнено(Подробности) Тогда
		Подробности = MCPСтрокаИлиПустая(MCPБезопасноеСвойство(ДанныеJson, "ИнфоОбОшибке"));
	КонецЕсли;
	Возврат Подробности;
	
КонецФункции

&НаКлиенте
Функция MCPМаркерТехническихДанных()
	Возврат Символы.ПС + Символы.ПС + Ванесса.Локализовать("Технические данные") + ":";
КонецФункции

// Обрезает текст по тому же маркеру, по которому MCPВыделитьТехническиеДанныеИзСтроки
// отделяет блок технических данных: error и technicalData относятся к одному блоку.
&НаКлиенте
Функция MCPОбрезатьТехническиеДанные(Знач Стр) Экспорт
	
	Если ТипЗнч(Стр) <> Тип("Строка") ИЛИ ПустаяСтрока(Стр) Тогда
		Возврат "";
	КонецЕсли;
	
	Искомое = MCPМаркерТехническихДанных();
	Поз = Ванесса._СтрНайти(Стр, Искомое);
	Если Поз > 0 Тогда
		Стр = Лев(Стр, Поз - 1);
	КонецЕсли;
	Возврат СокрЛП(Стр);
	
КонецФункции

// Политика — первое вхождение маркера: так же обрезает текст ошибки MCPОбрезатьТехническиеДанные,
// поэтому error и technicalData относятся к одному и тому же блоку.
&НаКлиенте
Функция MCPВыделитьТехническиеДанныеИзСтроки(Знач Стр) Экспорт
	
	Если ТипЗнч(Стр) <> Тип("Строка") ИЛИ ПустаяСтрока(Стр) Тогда
		Возврат "";
	КонецЕсли;
	
	Искомое = MCPМаркерТехническихДанных();
	Поз = Ванесса._СтрНайти(Стр, Искомое);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Тело = Сред(Стр, Поз + СтрДлина(Искомое));
	Пока Истина Цикл
		ПервыйСимвол = Лев(Тело, 1);
		Если ПервыйСимвол = Символы.ПС ИЛИ ПервыйСимвол = Символы.ВК Тогда
			Тело = Сред(Тело, 2);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(Тело);
	
КонецФункции

&НаКлиенте
Функция MCPКраткиеШагиСценария(Шаги) Экспорт
	
	Результат = Новый Массив;
	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Шаг Из Шаги Цикл
		Если ТипЗнч(Шаг) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Краткий = MCPКраткоеОписаниеШага(Шаг);
		ВремяНачала = MCPБезопасноеСвойство(Шаг, "ВремяНачала");
		ВремяОкончания = MCPБезопасноеСвойство(Шаг, "ВремяОкончания");
		Если ТипЗнч(ВремяНачала) = Тип("Число") И ТипЗнч(ВремяОкончания) = Тип("Число") Тогда
			Краткий.Вставить("durationMs", ВремяОкончания - ВремяНачала);
		КонецЕсли;
		Результат.Добавить(Краткий);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPСчетчикиСтатусовШагов(Шаги) Экспорт
	
	Счетчики = Новый Структура("total,success,failed,broken,pending,running,skipped,other", 0, 0, 0, 0, 0, 0, 0, 0);
	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат Счетчики;
	КонецЕсли;
	
	Для Каждого Шаг Из Шаги Цикл
		Счетчики.total = Счетчики.total + 1;
		Статус = НРег(MCPСтрокаИлиПустая(MCPБезопасноеСвойство(Шаг, "Статус")));
		Если Статус = "success" Тогда
			Счетчики.success = Счетчики.success + 1;
		ИначеЕсли Статус = "failed" Тогда
			Счетчики.failed = Счетчики.failed + 1;
		ИначеЕсли Статус = "broken" Тогда
			Счетчики.broken = Счетчики.broken + 1;
		ИначеЕсли Статус = "pending" Тогда
			Счетчики.pending = Счетчики.pending + 1;
		ИначеЕсли Статус = "running" Тогда
			Счетчики.running = Счетчики.running + 1;
		ИначеЕсли Статус = "skipped" Тогда
			Счетчики.skipped = Счетчики.skipped + 1;
		Иначе
			Счетчики.other = Счетчики.other + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Счетчики;
	
КонецФункции

&НаКлиенте
Функция MCPПредставлениеЗначенияДляMarkdown(Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат Ванесса.Локализовать("не указано");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат Ванесса.Локализовать("да");
		КонецЕсли;
		Возврат Ванесса.Локализовать("нет");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;

		Строки = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Строки.Добавить(MCPПредставлениеЗначенияДляMarkdown(Элемент));
		КонецЦикла;
		Возврат Ванесса._СтрСоединить(Строки, ", ");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Строки = Новый Массив;
		Для Каждого КлючЗначение Из Значение Цикл
			Строки.Добавить(КлючЗначение.Ключ + ": " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
		КонецЦикла;
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, "; ");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Строки = Новый Массив;
		Для Каждого КлючЗначение Из Значение Цикл
			Строки.Добавить(MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Ключ) + ": " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
		КонецЦикла;
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, "; ");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Строки = Новый Массив;
		Для Каждого ЭлементСписка Из Значение Цикл
			// В элементах списка значений параметров шага лежит структура {Значение, Тип}.
			ЗначениеЭлемента = ЭлементСписка.Значение;
			Если ТипЗнч(ЗначениеЭлемента) = Тип("Структура") Тогда
				Если ЗначениеЭлемента.Свойство("Значение") Тогда
					Представление = MCPПредставлениеЗначенияДляMarkdown(ЗначениеЭлемента.Значение);
					Если ЗначениеЭлемента.Свойство("Тип") Тогда
						ТипЗначения = ЗначениеЭлемента.Тип;
						Если ЗначениеЗаполнено(ТипЗначения) Тогда
							Представление = Представление + " (" + ТипЗначения + ")";
						КонецЕсли;
					КонецЕсли;
					Строки.Добавить(Представление);
				Иначе
					Строки.Добавить(MCPПредставлениеЗначенияДляMarkdown(ЗначениеЭлемента));
				КонецЕсли;
			Иначе
				Строки.Добавить(MCPПредставлениеЗначенияДляMarkdown(ЗначениеЭлемента));
			КонецЕсли;
		КонецЦикла;
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, "; ");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

&НаКлиенте
Функция MCPСформироватьMarkdownРазделСвойств(ДанныеРаздела) Экспорт
	Если ДанныеРаздела = Неопределено Тогда
		Возврат Ванесса.Локализовать("Данные отсутствуют.");
	КонецЕсли;

	Если ТипЗнч(ДанныеРаздела) <> Тип("Структура") Тогда
		Возврат MCPПредставлениеЗначенияДляMarkdown(ДанныеРаздела);
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого КлючЗначение Из ДанныеРаздела Цикл
		Строки.Добавить("- " + КлючЗначение.Ключ + ": " + MCPЭкранироватьMarkdownМногострочный(MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение), Ложь));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат Ванесса.Локализовать("Данные отсутствуют.");
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

