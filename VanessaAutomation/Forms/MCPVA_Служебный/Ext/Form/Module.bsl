		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	Заголовок = "";
	Если ТипМетаданных = "ВсеСправочники" Тогда
		Заголовок = Ванесса.Локализовать("# Справочники в базе клиента тестирования");
