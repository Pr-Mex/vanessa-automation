		|- другие параметры в зависимости от действия
		|
		|При возникновении ошибки выполнение прерывается.
		|Требует подключённого клиента тестирования.",
		"ВыполнитьПоследовательностьДействийФормы", Ложь, Ложь);
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("actions_json", "string", "JSON-строка с массивом действий для последовательного выполнения. Формат: [{""action"": ""..."", ...}, ...]. Обязательный параметр.", Истина));
	Инструменты.Добавить(Инстр);

	// 39. user_actions_recording
	Инстр = MCPНовоеОписаниеИнструмента("user_actions_recording",
		"Управляет записью действий пользователя в клиенте тестирования.
