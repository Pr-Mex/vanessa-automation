&НаКлиенте
Функция MCPСформироватьMarkdownСостоянияVA(Данные) Экспорт
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Состояние Vanessa Automation"));
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("- Выполнение сценариев:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["isRunning"]));
	КлиентТестированияПодключен = Данные["testClientConnected"];
	Строки.Добавить(Ванесса.Локализовать("- Клиент тестирования подключен:") + " " + MCPПредставлениеЗначенияДляMarkdown(КлиентТестированияПодключен));
	Строки.Добавить(Ванесса.Локализовать("- Включена запись действий пользователя:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["ВключенаЗаписьДействийПользователя"]));
	Если Данные["testClientConnected"] Тогда
		Строки.Добавить(Ванесса.Локализовать("  " + "- Имя профиля клиента тестирования:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["ИмяПрофиляКлиентаТестирования"]));
	КонецЕсли;	
	Строки.Добавить(Ванесса.Локализовать("- Каталог фич:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["featureDirectory"]));
	Строки.Добавить(Ванесса.Локализовать("- Каталог проекта:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["КаталогПроекта"]));
	Строки.Добавить("");

	Строки.Добавить(Ванесса.Локализовать("## Текущая фича"));
	Строки.Добавить(MCPСформироватьMarkdownРазделСвойств(Данные["currentFeature"]));
	Строки.Добавить("");

	Строки.Добавить(Ванесса.Локализовать("## Текущий сценарий"));
	Строки.Добавить(MCPСформироватьMarkdownРазделСвойств(Данные["currentScenario"]));
	Строки.Добавить("");

	Строки.Добавить(Ванесса.Локализовать("## Текущий шаг"));
	Строки.Добавить(MCPСформироватьMarkdownРазделСвойств(Данные["currentStep"]));
	
	// Подсказки, если ничего не загружено
	ФичаПуста = Данные["currentFeature"] = Неопределено
		ИЛИ (ТипЗнч(Данные["currentFeature"]) = Тип("Структура")
			И (НЕ Данные["currentFeature"].Свойство("name")
				ИЛИ Данные["currentFeature"]["name"] = Неопределено
				ИЛИ СокрЛП(Строка(Данные["currentFeature"]["name"])) = ""));
	СценарийПуст = Данные["currentScenario"] = Неопределено
		ИЛИ (ТипЗнч(Данные["currentScenario"]) = Тип("Структура")
			И (НЕ Данные["currentScenario"].Свойство("name")
				ИЛИ Данные["currentScenario"]["name"] = Неопределено
				ИЛИ СокрЛП(Строка(Данные["currentScenario"]["name"])) = ""));
	Если ФичаПуста И СценарийПуст Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("## Следующие шаги"));
		Строки.Добавить(Ванесса.Локализовать("- Загрузите фичи: `load_features`"));
		Если КлиентТестированияПодключен <> Истина Тогда
			Строки.Добавить(Ванесса.Локализовать("- Подключите клиента тестирования: `manage_test_client` с `action: connect`"));
		КонецЕсли;
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Функция MCPПредставлениеЗначенияДляMarkdown(Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат Ванесса.Локализовать("не указано");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат Ванесса.Локализовать("да");
		КонецЕсли;
		Возврат Ванесса.Локализовать("нет");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;

		Строки = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Строки.Добавить(MCPПредставлениеЗначенияДляMarkdown(Элемент));
		КонецЦикла;
		Возврат Ванесса._СтрСоединить(Строки, ", ");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Строки = Новый Массив;
		Для Каждого КлючЗначение Из Значение Цикл
			Строки.Добавить(КлючЗначение.Ключ + ": " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
		КонецЦикла;
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, "; ");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Строки = Новый Массив;
		Для Каждого КлючЗначение Из Значение Цикл
			Строки.Добавить(MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Ключ) + ": " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
		КонецЦикла;
		Если Строки.Количество() = 0 Тогда
			Возврат Ванесса.Локализовать("не указано");
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, "; ");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

&НаКлиенте
Функция MCPСформироватьMarkdownРазделСвойств(ДанныеРаздела) Экспорт
	Если ДанныеРаздела = Неопределено Тогда
		Возврат Ванесса.Локализовать("Данные отсутствуют.");
	КонецЕсли;

	Если ТипЗнч(ДанныеРаздела) <> Тип("Структура") Тогда
		Возврат MCPПредставлениеЗначенияДляMarkdown(ДанныеРаздела);
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого КлючЗначение Из ДанныеРаздела Цикл
		Строки.Добавить("- " + КлючЗначение.Ключ + ": " + MCPПредставлениеЗначенияДляMarkdown(КлючЗначение.Значение));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат Ванесса.Локализовать("Данные отсутствуют.");
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Функция MCPПодготовитьВариантыТочногоПоиска(ТекстЗапроса) Экспорт
	ВариантыЗапроса = Новый Массив;
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат ВариантыЗапроса;
	КонецЕсли;

	Для Каждого ЧастьЗапроса Из Ванесса._СтрРазделить(ТекстЗапроса, "|") Цикл
		НормализованнаяЧасть = НРег(СокрЛП(Строка(ЧастьЗапроса)));
		Если ЗначениеЗаполнено(НормализованнаяЧасть) Тогда
			ВариантыЗапроса.Добавить(НормализованнаяЧасть);
		КонецЕсли;
	КонецЦикла;

	Возврат ВариантыЗапроса;

КонецФункции

&НаКлиенте
Функция НайденоВхождениеЗначенияВМассиве(Массив, Значение) Экспорт
	
	Для Каждого Стр Из Массив Цикл
		Если Найти(Значение, Стр) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции	

&НаКлиенте
Функция MCPСформироватьMarkdownРезультатаПоискаШагов(Данные) Экспорт
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Найденные шаги Vanessa Automation"));
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("- Поисковый запрос по представлению шагов:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["search_name"]));
	Строки.Добавить(Ванесса.Локализовать("- Поисковый запрос по исключению в представлении шагов:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["exclude_name"]));
	Строки.Добавить(Ванесса.Локализовать("- Поисковый запрос по описанию шагов:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["search_description"]));
	Строки.Добавить(Ванесса.Локализовать("- Поисковый запрос по исключению в описании шагов:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["exclude_description"]));
	Строки.Добавить(Ванесса.Локализовать("- Поисковый запрос по типу шагов:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["search_type"]));
	Строки.Добавить(Ванесса.Локализовать("- Поисковый запрос по исключению в типе шагов:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["exclude_type"]));
	Строки.Добавить(Ванесса.Локализовать("- Лимит:") + " " + MCPПредставлениеЛимитаДляMarkdown(Данные["limit"]));
	Строки.Добавить(Ванесса.Локализовать("- Всего найдено:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["totalFound"]));
	Строки.Добавить(Ванесса.Локализовать("- Показано:") + " " + Строка(Данные["steps"].Количество()));
	Строки.Добавить(Ванесса.Локализовать("- Категории:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные["categories"]));
	Строки.Добавить(Ванесса.Локализовать("- Примечание: поиск выполняется по полному точному совпадению без учета регистра. Для поиска альтернатив используйте разделитель '|', например 'первая часть|вторая часть'. Семантическая обработка не используется."));
	Строки.Добавить("");

	Если Данные["steps"].Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Совпадения не найдены."));
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Поиск выполнен с указанными выше параметрами."));
		Строки.Добавить(Ванесса.Локализовать("Если ожидался другой результат, проверьте поисковый запрос, категорию и область поиска."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	НомерШага = 0;
	Для Каждого Шаг Из Данные["steps"] Цикл
		НомерШага = НомерШага + 1;
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## %1. %2"), Строка(НомерШага), MCPПредставлениеЗначенияДляMarkdown(Шаг["name"]))); 
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("- Категория:") + " " + MCPПредставлениеЗначенияДляMarkdown(Шаг["category"]));
		Строки.Добавить(Ванесса.Локализовать("- Описание:") + " " + MCPПредставлениеЗначенияДляMarkdown(Шаг["description"]));
		Строки.Добавить(Ванесса.Локализовать("- Сниппет: `") + MCPПредставлениеЗначенияДляMarkdown(Шаг["snippet"]) + "`");
		Строки.Добавить(Ванесса.Локализовать("- Тип: `") + MCPПредставлениеЗначенияДляMarkdown(Шаг["type"]) + "`");
		//Строки.Добавить(Ванесса.Локализовать("- Строка поиска:") + " " + MCPПредставлениеЗначенияДляMarkdown(Шаг["searchString"]));
		//Строки.Добавить(Ванесса.Локализовать("- Исходный файл:") + " " + MCPПредставлениеЗначенияДляMarkdown(Шаг["sourceFile"]));
		Строки.Добавить("");
	КонецЦикла;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

