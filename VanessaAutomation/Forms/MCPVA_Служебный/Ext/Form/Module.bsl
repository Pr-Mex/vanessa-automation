	КонецЕсли;
	ДопПараметры.Вставить("ВидОтбораПоНаименованию", ВидОтбораПоНаименованию);
	ДопПараметры.Вставить("ОтборПоРеквизитам", ОтборПоРеквизитам);

	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Расширение может вернуть обёртку {КоличествоЭлементов, НайденоЭлементов, ДанныеЭлементов}.
	// Для обратной совместимости со старым форматом (массив напрямую) поддерживаем оба варианта.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДанныеЭлементов") Тогда
		ВсегоЭлементов = Данные.КоличествоЭлементов;
		НайденоЭлементов = ВсегоЭлементов;
		Если Данные.Свойство("НайденоЭлементов") Тогда
			НайденоЭлементов = Данные.НайденоЭлементов;
		КонецЕсли;
		Данные = Данные.ДанныеЭлементов;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		ВсегоЭлементов = Данные.Количество();
		НайденоЭлементов = ВсегоЭлементов;
	Иначе
		// Это Структура с ошибкой (нет объекта метаданных) - количество не вычисляем,
		// обработка ошибки будет ниже.
		ВсегоЭлементов = 0;
		НайденоЭлементов = 0;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет плана видов характеристик:") + " " + ИмяПВХ);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Строки.Добавить(Ванесса.Локализовать("# План видов характеристик:") + " " + ИмяПВХ);
	Строки.Добавить(Ванесса.Локализовать("# Всего элементов в базе:") + " " + XMLСтрока(ВсегоЭлементов));
	Если НайденоЭлементов <> ВсегоЭлементов Тогда
		Строки.Добавить(Ванесса.Локализовать("# Найдено с учётом отбора:") + " " + XMLСтрока(НайденоЭлементов));
	КонецЕсли;
	Если НайденоЭлементов > Данные.Количество() Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("# Возвращено первые %1 элементов из %2. Чтобы получить больше, увеличьте параметр limit (0 - без ограничения) или уточните отбор."),
			XMLСтрока(Данные.Количество()), XMLСтрока(НайденоЭлементов)));
	КонецЕсли;
	Строки.Добавить("");

	MCPВывестиЭлементыСправочникаВMarkdown(Строки, Данные);

	Если Данные.Количество() = 0 Тогда
		ПрименённыеОтборы = Новый Массив;
		Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
			ПрименённыеОтборы.Добавить("Наименование = " + ОтборПоНаименованию);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборПоРеквизитам) Тогда
			ПрименённыеОтборы.Добавить("filter: " + СтрЗаменить(ОтборПоРеквизитам, Символы.ПС, "; "));
		КонецЕсли;
		Если ПрименённыеОтборы.Количество() > 0 Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("По заданному отбору (%1) элементов не найдено."),
				Ванесса._СтрСоединить(ПрименённыеОтборы, ", ")));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Элементов плана видов характеристик не найдено."));
		КонецЕсли;
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает список объектов метаданных (все справочники, все документы и т.д.)
&НаКлиенте
Функция ПолучитьСписокОбъектовМетаданных(ТипМетаданных) Экспорт

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", ТипМетаданных);

	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Имя без квалификатора Заголовок писало бы в свойство формы, а не в локальную переменную
	ЗаголовокРаздела = "";
	Если ТипМетаданных = "ВсеСправочники" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Справочники в базе клиента тестирования");
	ИначеЕсли ТипМетаданных = "ВсеДокументы" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Документы в базе клиента тестирования");
	ИначеЕсли ТипМетаданных = "ВсеПеречисления" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Перечисления в базе клиента тестирования");
	ИначеЕсли ТипМетаданных = "ВсеПланыВидовХарактеристик" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Планы видов характеристик в базе клиента тестирования");
	КонецЕсли;

	Строки.Добавить(ЗаголовокРаздела);
	Строки.Добавить(Ванесса.Локализовать("# Всего объектов:") + " " + XMLСтрока(Данные.Количество()));
	Строки.Добавить("");

	Для Каждого ТекИмя Из Данные Цикл
		Если Лев(НРег(ТекИмя), 7) = "удалить" ИЛИ Лев(НРег(ТекИмя), 6) = "delete" Тогда
			// Значит значение устарело
			Продолжить;
		КонецЕсли;
		Строки.Добавить("- " + ТекИмя);
	КонецЦикла;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает данные документа
&НаКлиенте
Функция ПолучитьДанныеДокумента(ИмяДокумента, ДатаНачала, ДатаОкончания, Лимит, ОтборПоРеквизитам = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяДокумента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Документ' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Строки = Новый Массив;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Документ");
	ДопПараметры.Вставить("Вид", ИмяДокумента);
	ДопПараметры.Вставить("Лимит", Лимит);
	ДопПараметры.Вставить("ДатаНачала", ДатаНачала);
	ДопПараметры.Вставить("ДатаОкончания", ДатаОкончания);
	ДопПараметры.Вставить("ОтборПоРеквизитам", ОтборПоРеквизитам);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может вернуть обёртку {КоличествоДокументов, НайденоДокументов, ДанныеДокументов}.
	// Для обратной совместимости со старым форматом (массив напрямую) поддерживаем оба варианта.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДанныеДокументов") Тогда
		ВсегоДокументов = Данные.КоличествоДокументов;
		НайденоДокументов = ВсегоДокументов;
		Если Данные.Свойство("НайденоДокументов") Тогда
			НайденоДокументов = Данные.НайденоДокументов;
		КонецЕсли;
		Данные = Данные.ДанныеДокументов;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		ВсегоДокументов = Данные.Количество();
		НайденоДокументов = ВсегоДокументов;
	Иначе
		// Это Структура с ошибкой (нет объекта метаданных) - количество не вычисляем,
		// обработка ошибки будет ниже.
		ВсегоДокументов = 0;
		НайденоДокументов = 0;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет документа:") + " " + ИмяДокумента);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Документ:") + " " + ИмяДокумента);
	Строки.Добавить(Ванесса.Локализовать("# Всего документов в базе:") + " " + XMLСтрока(ВсегоДокументов));
	Если НайденоДокументов <> ВсегоДокументов Тогда
		Строки.Добавить(Ванесса.Локализовать("# Найдено с учётом отбора:") + " " + XMLСтрока(НайденоДокументов));
	КонецЕсли;
	Если НайденоДокументов > Данные.Количество() Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("# Возвращено первые %1 документов из %2. Чтобы получить больше, увеличьте параметр limit (0 - без ограничения) или уточните date_start/date_end и filter."),
			XMLСтрока(Данные.Количество()), XMLСтрока(НайденоДокументов)));
	КонецЕсли;
	Строки.Добавить("");
	
	MCPВывестиДокументыВMarkdown(Строки, Данные);
	
	Если Данные.Количество() = 0 Тогда
		ПрименённыеОтборы = Новый Массив;
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
			ПрименённыеОтборы.Добавить("Дата >= " + Строка(ДатаНачала));
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаОкончания) Тогда
			ПрименённыеОтборы.Добавить("Дата <= " + Строка(ДатаОкончания));
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборПоРеквизитам) Тогда
			ПрименённыеОтборы.Добавить("filter: " + СтрЗаменить(ОтборПоРеквизитам, Символы.ПС, "; "));
		КонецЕсли;
		Если ПрименённыеОтборы.Количество() > 0 Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("По заданному отбору (%1) документов не найдено."),
				Ванесса._СтрСоединить(ПрименённыеОтборы, ", ")));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Документы не найдены."));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Возвращает данные константы и общее количество констант в базе клиента тестирования
&НаКлиенте
Функция ПолучитьДанныеКонстанты(ИмяКонстанты) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяКонстанты) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Константа' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Константа");
	ДопПараметры.Вставить("Вид", ИмяКонстанты);

	ТекстОшибки = Неопределено;
	Ответ = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Расширение возвращает данные в обёртке {КоличествоКонстант, ДанныеКонстанты}.
	// Для обратной совместимости со старым форматом, где расширение могло вернуть
	// только структуру с данными константы, поддерживаем оба варианта.
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ДанныеКонстанты") Тогда
		Данные = Ответ.ДанныеКонстанты;
		ВсегоКонстант = Ответ.КоличествоКонстант;
	Иначе
		Данные = Ответ;
		ВсегоКонстант = Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаНетОбъектаМетаданных") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет константы:") + " " + ИмяКонстанты);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;
		// Дополнительно сообщим общее количество констант в базе.
		Если ВсегоКонстант <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(Данные.ВсеОбъекты.Количество()));
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Строки.Добавить(Ванесса.Локализовать("# Константа:") + " " + ИмяКонстанты);
	Если ВсегоКонстант <> Неопределено Тогда
		Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
	КонецЕсли;
	Строки.Добавить("");

	Если ЗначениеЗаполнено(Данные.Свойство("Значение")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Значение:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные.Значение));
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Свойство("Представление")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Представление:") + " " + Данные.Представление);
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Свойство("ТипЗначения")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Тип значения:") + " " + Данные.ТипЗначения);
	КонецЕсли;
	Строки.Добавить("");

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает значения всех констант (опционально по диапазону номеров)
&НаКлиенте
Функция ПолучитьВсеКонстанты(НачальныйНомер = 0, КонечныйНомер = 0) Экспорт

	// Проверка корректности переданного диапазона (до вызова расширения).
	Если НачальныйНомер < 0 ИЛИ КонечныйНомер < 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры start_number и end_number должны быть положительными числами.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если НачальныйНомер > 0 И НачальныйНомер < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр start_number должен быть >= 1.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если КонечныйНомер > 0 И КонечныйНомер < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр end_number должен быть >= 1.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если НачальныйНомер > 0 И КонечныйНомер > 0 И НачальныйНомер > КонечныйНомер Тогда
		ТекстСообщения = Ванесса.Локализовать("НачальныйНомер не может быть больше КонечныйНомер");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "ВсеКонстанты");
	Если НачальныйНомер > 0 Тогда
		ДопПараметры.Вставить("НачальныйНомер", НачальныйНомер);
	КонецЕсли;
	Если КонечныйНомер > 0 Тогда
		ДопПараметры.Вставить("КонечныйНомер", КонечныйНомер);
	КонецЕсли;

	ТекстОшибки = Неопределено;
	Ответ = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Поддержка обёртки {КоличествоКонстант, ДанныеКонстант} от расширения.
	// Обратная совместимость: если расширение вернуло массив напрямую - работаем с ним.
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ДанныеКонстант") Тогда
		Данные = Ответ.ДанныеКонстант;
		ВсегоКонстант = Ответ.КоличествоКонстант;
	Иначе
		Данные = Ответ;
		ВсегоКонстант = Данные.Количество();
	КонецЕсли;

	// Валидация против общего количества констант (требует данных от расширения,
	// поэтому выполняется после вызова расширения, а не на этапе разбора параметров MCP)
	Если НачальныйНомер > 0 И НачальныйНомер > ВсегоКонстант Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Начальный номер (%1) превышает общее количество констант в базе (%2)."),
			XMLСтрока(НачальныйНомер), XMLСтрока(ВсегоКонстант));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ФактНачало = ?(НачальныйНомер > 0, НачальныйНомер, 1);
	ФактКонец  = ?(КонечныйНомер > 0, КонечныйНомер,  ВсегоКонстант);

	Строки.Добавить(Ванесса.Локализовать("# Значения всех констант:"));
	Строки.Добавить(Ванесса.Локализовать("- Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
	Если НачальныйНомер > 0 ИЛИ КонечныйНомер > 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("- Возвращено значений:") + " " + XMLСтрока(Данные.Количество())
			+ " (" + Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("диапазон с %1 по %2"), XMLСтрока(ФактНачало), XMLСтрока(ФактКонец)) + ")");
	Иначе
		Строки.Добавить(Ванесса.Локализовать("- Возвращено значений:") + " " + XMLСтрока(Данные.Количество()));
	КонецЕсли;
	Строки.Добавить("");

	MCPВывестиКонстантыВMarkdown(Строки, Данные);

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает реквизиты объекта по навигационной ссылке.
// Режимы вывода - как у get_object_attributes: data_mode, attribute_name, tabular_section_name, only_filled.
&НаКлиенте
Функция ПолучитьРеквизитыОбъектаПоНавигационнойСсылке(НавигационнаяСсылка, РежимДанных = "attributes_only", ИмяРеквизита = "", ИмяТабличнойЧасти = "", ТолькоЗаполненные = Истина, ДобавитьЗаголовок = Ложь, ПараметрыОтбора = Неопределено, ПараметрыСтрок = Неопределено, Формат = "markdown") Экспорт
	
	Если НЕ ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр navigationLink.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "ДанныеПоНавигационнойСсылке");
	ДопПараметры.Вставить("НавигационнаяСсылкаОбъекта", НавигационнаяСсылка);
	ДопПараметры.Вставить("ПараметрыОтбора", ПараметрыОтбора);
	
	ТекстОшибки = Неопределено;
	ДанныеОбъекта = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может не вернуть данные объекта (конверт ошибки или сбой разбора):
	// без структуры объекта читать её поля нельзя.
	Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") ИЛИ НЕ ДанныеОбъекта.Свойство("СтандартныеРеквизиты") Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Не вышло получить данные объекта из текущего окна."));
	КонецЕсли;

	MCPЗаполнитьМетаданныеОтбораСтрок(ДанныеОбъекта, ПараметрыСтрок);
	ТекстОшибки = "";
	Если НЕ MCPПроверитьПрименениеОтбораСтрок(ДанныеОбъекта, ПараметрыСтрок, ИмяТабличнойЧасти, ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	Если Формат = "json" Тогда
		Возврат MCPОтветРеквизитовОбъектаJSON(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные);
	КонецЕсли;
	Возврат СформироватьMarkdownРеквизитовОбъекта(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные, ДобавитьЗаголовок);
КонецФункции

&НаКлиенте
Функция ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки) Экспорт
	// Активное окно до открытия служебной формы: после её закрытия фокус возвращаем ему.
	ОкноДляВозвратаФокуса = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ПолучениеДанныхИзБазы");
	ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ПолучениеДанныхИзБазы.*",5);
	Если НужнаяФорма = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключён, но не найдена форма 'VAExtension_ПолучениеДанныхИзБазы' из служебного расширения.");
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		Возврат Неопределено
	КонецЕсли;	
	
	// Поля служебной формы ищем в самой найденной форме: активным окном остаётся форма пользователя,
	// поэтому поиск «в активном окне» поля служебной формы не находит.
	ДопПараметрыПоиска = Новый Структура("КонтейнерДляПоиска", НужнаяФорма);

	РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитТип = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("Тип", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитТип.ВвестиТекст(ДопПараметры.Тип);
	Если ДопПараметры.Свойство("Вид") Тогда
		РеквизитВид = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("Вид", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитВид.ВвестиТекст(ДопПараметры.Вид);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("НавигационнаяСсылкаОбъекта") Тогда
		РеквизитНавигационнаяСсылкаОбъекта = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("НавигационнаяСсылкаОбъекта", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитНавигационнаяСсылкаОбъекта.ВвестиТекст(ДопПараметры.НавигационнаяСсылкаОбъекта);
	КонецЕсли;
	
	// Передаём владельца всегда (даже пустой) — иначе "залипнет" владелец предыдущего вызова.
	ЗначениеВладельца = "";
	Если ДопПараметры.Свойство("Владелец") Тогда
		ЗначениеВладельца = ДопПараметры.Владелец;
	КонецЕсли;
	РеквизитИмяВладельца = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ИмяВладельца", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитИмяВладельца.ВвестиТекст(ЗначениеВладельца);
	
	Если ДопПараметры.Свойство("Лимит") Тогда
		РеквизитКоличествоСсылок = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КоличествоСсылок", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитКоличествоСсылок.ВвестиТекст(XMLСтрока(ДопПараметры.Лимит));
	КонецЕсли;

	Если ДопПараметры.Свойство("НачальныйНомер") И ДопПараметры.НачальныйНомер > 0 Тогда
		РеквизитНачальныйНомер = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("НачальныйНомер", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитНачальныйНомер.ВвестиТекст(XMLСтрока(ДопПараметры.НачальныйНомер));
	КонецЕсли;

	Если ДопПараметры.Свойство("КонечныйНомер") И ДопПараметры.КонечныйНомер > 0 Тогда
		РеквизитКонечныйНомер = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КонечныйНомер", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитКонечныйНомер.ВвестиТекст(XMLСтрока(ДопПараметры.КонечныйНомер));
	КонецЕсли;
	
	// Передаём отбор всегда (даже пустой) — иначе "залипнет" отбор предыдущего вызова.
	ЗначениеОтбораПоНаименованию = "";
	Если ДопПараметры.Свойство("ОтборПоНаименованию") И ЗначениеЗаполнено(ДопПараметры.ОтборПоНаименованию) Тогда
		ЗначениеОтбораПоНаименованию = ДопПараметры.ОтборПоНаименованию;
	КонецЕсли;
	РеквизитОтборПоНаименованию = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОтборПоНаименованию", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитОтборПоНаименованию.ВвестиТекст(ЗначениеОтбораПоНаименованию);

	// Передаём режим сравнения name_filter: exact/partial/starts_with.
	// Передаём всегда (даже если отбор пуст) — чтобы при последовательных вызовах
	// не "залипал" старый режим в реквизите формы расширения.
	Если ДопПараметры.Свойство("ВидОтбораПоНаименованию") Тогда
		РеквизитВидОтбораПоНаименованию = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ВидОтбораПоНаименованию", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитВидОтбораПоНаименованию.ВвестиТекст(ДопПараметры.ВидОтбораПоНаименованию);
	КонецЕсли;
	
	ДанныеДат = Новый Структура;
	ПереданыДаты = Ложь;
	Если ДопПараметры.Свойство("ДатаНачала") И ЗначениеЗаполнено(ДопПараметры.ДатаНачала) Тогда
		ПереданыДаты = Истина;
		ДанныеДат.Вставить("ДатаНачала", ДопПараметры.ДатаНачала);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("ДатаОкончания") И ЗначениеЗаполнено(ДопПараметры.ДатаОкончания) Тогда
		ПереданыДаты = Истина;
		ДанныеДат.Вставить("ДатаОкончания", ДопПараметры.ДатаОкончания);
	КонецЕсли;
	
	Если НЕ ПереданыДаты Тогда
		// Сбрасываем даты предыдущего вызова пустыми датами — иначе они "залипнут"
		// в реквизитах формы расширения и неявно ограничат выборку документов.
		ДанныеДат.Вставить("ДатаНачала", Дата(1, 1, 1));
		ДанныеДат.Вставить("ДатаОкончания", Дата(1, 1, 1));
	КонецЕсли;

	// Отбор по реквизитам передаём всегда (даже пустой) — иначе "залипнет" отбор предыдущего вызова.
	ЗначениеОтбораПоРеквизитам = "";
	Если ДопПараметры.Свойство("ОтборПоРеквизитам") Тогда
		ЗначениеОтбораПоРеквизитам = ДопПараметры.ОтборПоРеквизитам;
	КонецЕсли;
	ДанныеДат.Вставить("ОтборПоРеквизитам", ЗначениеОтбораПоРеквизитам);

	РеквизитДляУстановкиПараметров = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ДляУстановкиПараметров", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитДляУстановкиПараметров.ВвестиТекст(Ванесса.ЗаписатьОбъектJSON(ДанныеДат));
	КнопкаПолучитьПараметры = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаПолучитьПараметры");
	КнопкаПолучитьПараметры.Нажать();
	
	КнопкаВыполнитьОбработку = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьОбработку");
	
	КнопкаЗакрытьФорму = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	ПараметрыОтбора = Неопределено;
	Если ДопПараметры.Свойство("ПараметрыОтбора") Тогда
		ПараметрыОтбора = ДопПараметры.ПараметрыОтбора;
	КонецЕсли;
	Если НЕ MCPУстановитьПараметрыОтбораВСлужебнойФорме(НужнаяФорма, ДопПараметрыПоиска, ПараметрыОтбора, ТекстОшибки) Тогда
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		Возврат Неопределено
	КонецЕсли;
	
	КнопкаВыполнитьОбработку.Нажать();
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные из базы данных клиента тестирования.");
		Возврат Неопределено
	КонецЕсли;

	РеквизитЗначениеДляВозврата = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеРезультат", Истина, Истина, , ДопПараметрыПоиска);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеДляВозврата);

	// Закрываем служебную форму до разбора результата: если разбор упадёт, форма не останется
	// открытой и реквизиты фильтров не "залипнут" в ней до следующего вызова.
	ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
	ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);

	Если НЕ ЗначениеЗаполнено(ПредставлениеРезультата) Тогда
		ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension вернуло пустой результат без текста ошибки.")
			+ Символы.ПС + Ванесса.Локализовать("Возможные причины: ошибка на стороне клиента тестирования или устаревшая версия расширения VAExtension без передачи текста ошибки. Обновите расширение VAExtension в клиенте тестирования.");
		Возврат Неопределено
	КонецЕсли;

	Попытка
		Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не получилось разобрать JSON результата расширения VAExtension.")
			+ Символы.ПС + ОписаниеОшибки()
			+ Символы.ПС + Ванесса.Локализовать("Первые 1000 символов результата:")
			+ Символы.ПС + Лев(ПредставлениеРезультата, 1000);
		Возврат Неопределено
	КонецПопытки;

	// Расширение сообщает об ошибке конвертом {"ОшибкаВыполнения": "<текст>"} — показываем текст как есть.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаВыполнения") Тогда
		ТекстОшибки = Данные.ОшибкаВыполнения;
		Возврат Неопределено
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Закрывает служебную форму VAExtension_ПолучениеДанныхИзБазы, игнорируя ошибки нажатия.
&НаКлиенте
Процедура ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму)

	Если КнопкаЗакрытьФорму = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КнопкаЗакрытьФорму.Нажать();
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("ДанныеИзБазыДанныхКлиентаТестирования", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СкриншотыИПрочее

// Выполняет голосовое уведомление
&НаКлиенте
Функция ГолосовыеУведомления(Запрос, ДополнительныеПараметры) Экспорт

	ТипУведомления = Строка(ЗначениеПараметраИзЗапроса(Запрос, "notification_type"));

	Если НЕ ЗначениеЗаполнено(ТипУведомления) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр notification_type обязателен. Допустимые значения: 'task_completed', 'decision_required', 'task_cannot_be_completed', 'error_occurred'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	// Получаем параметр языка озвучки (по умолчанию 'ru')
	Язык = Строка(ЗначениеПараметраИзЗапроса(Запрос, "language"));
	Если НЕ ЗначениеЗаполнено(Язык) Тогда
		Язык = "ru";
	Иначе
		Язык = НРег(СокрЛП(Язык));
		Если Язык <> "ru" И Язык <> "en" Тогда
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра language. Допустимые значения: 'ru' (русский), 'en' (английский).");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Проверяем допустимое значение
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить("task_completed");
	ДопустимыеТипы.Добавить("decision_required");
	ДопустимыеТипы.Добавить("task_cannot_be_completed");
	ДопустимыеТипы.Добавить("error_occurred");

	Если ДопустимыеТипы.Найти(ТипУведомления) = Неопределено Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение notification_type. Допустимые значения: 'task_completed', 'decision_required', 'task_cannot_be_completed', 'error_occurred'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Если Ванесса.ЭтоLinux Тогда
		ТекстСообщения = Ванесса.Локализовать("Голосовое уведомление не работает под linux.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстСообщения = Ванесса.Локализовать("Чтобы была возможность выполнить голосовое уведомление нужно в Vanessa Automation включить использование внешней компоненты VanessaExt.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если КаталогСФайламиОзвучки = Неопределено Тогда
		ДвоичныеДанныеГолос = ДвоичныеДанныеГолосСервер();
		ЧтениеZipФайла = Новый ЧтениеZipФайла(ДвоичныеДанныеГолос.ОткрытьПотокДляЧтения());
		ВременныйКаталог = ПолучитьИмяВременногоФайла("");
		Ванесса.СоздатьКаталогКомандаСистемы(ВременныйКаталог);
		ЧтениеZipФайла.ИзвлечьВсе(ВременныйКаталог);
		КаталогСФайламиОзвучки = ВременныйКаталог;
	КонецЕсли;

	ИмяФайла = ТипУведомления + "_" + Язык + ".mp3";
	ПолноеИмяФайла = КаталогСФайламиОзвучки + "\" + ИмяФайла;
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовВоспроизвестиМедиа(Ванесса.ОписаниеПустогоОбработчика(3), ПолноеИмяФайла, ПолноеИмяФайла);

	// Формируем ответ в формате Markdown
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Голосовое уведомление выполнено"));
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Синтезирует переданный текст и произносит его пользователю (инструмент speak_text)
&НаКлиенте
Функция ПроизнестиТекст(Запрос, ДополнительныеПараметры) Экспорт
	
	ЗначениеТекста = ЗначениеПараметраИзЗапроса(Запрос, "text");
	Если ТипЗнч(ЗначениеТекста) <> Тип("Массив") Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Параметр text должен быть массивом строк."));
	КонецЕсли;
	
	Если ЗначениеТекста.Количество() = 0 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Параметр text обязателен и не может быть пустым массивом."));
	КонецЕсли;
	
	БезВоспроизведения = (ЗначениеПараметраИзЗапроса(Запрос, "no_play") = Истина);
	
	//wait проверяется по типу: молчаливое приведение "true" к Ложь отключило бы уведомление
	ЖдатьЗавершения = Ложь;
	Если ПараметрПрисутствуетВЗапросе(Запрос, "wait") Тогда
		ЗначениеЖдать = ЗначениеПараметраИзЗапроса(Запрос, "wait");
		Если ТипЗнч(ЗначениеЖдать) <> Тип("Булево") Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				Ванесса.Локализовать("Параметр wait должен быть булевым."));
		КонецЕсли;
		ЖдатьЗавершения = ЗначениеЖдать И НЕ БезВоспроизведения;
	КонецЕсли;
	
	Тексты = Новый Массив;
	СуммарнаяДлина = 0;
	МаксимальнаяДлинаТекста = 500;
	Для Сч = 0 По ЗначениеТекста.Количество() - 1 Цикл
		ЭлементТекста = ЗначениеТекста[Сч];
		Если ТипЗнч(ЭлементТекста) <> Тип("Строка") Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Элемент text[%1] должен быть строкой."), Сч + 1);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		ТекстСтроки = СокрЛП(ЭлементТекста);
		Если ПустаяСтрока(ТекстСтроки) Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Элемент text[%1] пуст."), Сч + 1);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		Если СтрДлина(ТекстСтроки) > МаксимальнаяДлинаТекста Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Элемент text[%1] длиннее %2 символов. Разбейте фразу на части."),
				Сч + 1, МаксимальнаяДлинаТекста);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
		СуммарнаяДлина = СуммарнаяДлина + СтрДлина(ТекстСтроки);
		Тексты.Добавить(ТекстСтроки);
	КонецЦикла;
	
	Если НЕ БезВоспроизведения И Тексты.Количество() <> 1 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("При no_play=false массив text должен содержать ровно одну фразу."));
	КонецЕсли;
	
	Если БезВоспроизведения И Тексты.Количество() > 100 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("За один вызов можно синтезировать не больше 100 фраз."));
	КонецЕсли;
	Если БезВоспроизведения И Тексты.Количество() <= 10 И СуммарнаяДлина > 5000 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Суммарная длина фраз при синхронном синтезе не должна превышать 5000 символов."));
	КонецЕсли;
	Если БезВоспроизведения И Тексты.Количество() > 10 И СуммарнаяДлина > 50000 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Суммарная длина фраз в пакете не должна превышать 50000 символов."));
	КонецЕсли;
	
	ТекстПредпосылки = Ванесса.ПроверитьПредпосылкиОзвучкиMCP();
	Если ЗначениеЗаполнено(ТекстПредпосылки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстПредпосылки);
	КонецЕсли;
	
	//Синтез не занимает плеер, поэтому в режиме без воспроизведения проверка занятости не нужна
	Если БезВоспроизведения Тогда
		Если Тексты.Количество() > 10 Тогда
			Возврат НачатьПакетСинтезаMCP(Запрос, Тексты);
		КонецЕсли;
		Возврат MCPСинтезироватьПакетСинхронноMCP(Тексты);
	КонецЕсли;
	
	ТекстРечи = Тексты[0];
	ИдентификаторЗапроса = "";
	Попытка
		ИдентификаторЗапроса = Запрос.Идентификатор;
	Исключение
	КонецПопытки;
	
	//Без ИД ответ некуда отправить: отказываем сразу, иначе вызов зависнет до таймаута клиента
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		MCPЗаписатьСлужебныеДанныеБезопасно("MCP.ПустойИдентификаторЗапроса",
			Новый Структура("Инструмент, Причина", "speak_text", "НетИдентификатораЗапроса"));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось определить идентификатор запроса MCP."));
	КонецЕсли;
	
	ПодготовитьОжиданиеОзвучкиMCPКНовомуВызову();
	
	Если ЖдатьЗавершения И ОжиданиеОзвучкиMCP <> Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Уже есть активное ожидание завершения фразы."));
	КонецЕсли;
	
	Если ЗапускОзвучкиMCPВПроцессе = Истина Тогда
		Если ТипЗнч(ВремяУстановкиФлагаОзвучкиMCP) = Тип("Дата")
			И ТекущаяДата() - ВремяУстановкиФлагаОзвучкиMCP > 30 Тогда
			MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ЗависшийФлагЗапуска");
			ЗапускОзвучкиMCPВПроцессе = Ложь;
			ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
		Иначе
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.Локализовать("Уже выполняется проверка или запуск озвучки."));
		КонецЕсли;
	КонецЕсли;
	
	ЗапускОзвучкиMCPВПроцессе = Истина;
	ВремяУстановкиФлагаОзвучкиMCP = ТекущаяДата();
	
	//Синхронный запуск плеера не занимает UI, но проверка занятости может быть асинхронной
	Если ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP) Тогда
		//Watchdog мог не подключиться: устаревшее состояние очищаем сами, иначе плеер занят навсегда
		Если ТипЗнч(Ванесса.ВремяСтартаОзвучкиMCP) = Тип("Дата")
			И ТекущаяДата() - Ванесса.ВремяСтартаОзвучкиMCP > 600 Тогда
			ИДУстаревшейОзвучки = Ванесса.ИДОзвучкиMCP;
			MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.УстаревшееСостояние",
				Новый Структура("ИДОзвучки, Секунд", ИДУстаревшейОзвучки, ТекущаяДата() - Ванесса.ВремяСтартаОзвучкиMCP));
			Ванесса.ОчиститьСостояниеОзвучкиMCP();
			Ванесса.ОшибкаСтартаОзвучкиMCP = Ванесса.Локализовать("Превышено время воспроизведения фразы.");
			Ванесса.ИДОзвучкиОшибкиСтартаMCP = ИДУстаревшейОзвучки;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP) Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Текст", ТекстРечи);
		ДопПараметры.Вставить("MCPИдентификаторЗапроса", ИдентификаторЗапроса);
		ДопПараметры.Вставить("Ждать", ЖдатьЗавершения);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроизнестиТекстПроверкаОзвучкиЗавершена", ЭтаФорма, ДопПараметры);
		Попытка
			Ванесса.НачатьПроверкуОзвучкиMCP(ОписаниеОповещения);
		Исключение
			ЗапускОзвучкиMCPВПроцессе = Ложь;
			ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Ванесса.ПроизнестиТекстMCP(ТекстРечи, Ложь);
	Исключение
		ЗапускОзвучкиMCPВПроцессе = Ложь;
		ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	ЗапускОзвучкиMCPВПроцессе = Ложь;
	ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
	
	Если ЖдатьЗавершения Тогда
		НачатьОжиданиеОзвучкиMCP(ИдентификаторЗапроса, ТекстРечи);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат MCPОтветОзвучкиТекста(ТекстРечи, Ложь);
	
КонецФункции

// Синтезирует небольшой пакет фраз синхронно, с дедупликацией
&НаКлиенте
Функция MCPСинтезироватьПакетСинхронноMCP(Тексты) Экспорт
	
	Результаты = Новый Массив;
	Уникальные = Новый Соответствие;
	
	Для Каждого Текст Из Тексты Цикл
		Если Уникальные.Получить(Текст) <> Неопределено Тогда
			Результаты.Добавить(Новый Структура("Текст, Статус, Время, Успех, Дубликат",
				Текст, Ванесса.Локализовать("Пропущен (дубликат)"), 0, Истина, Истина));
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(Текст, Истина);
		
		ТекстПредпосылки = Ванесса.ПроверитьПредпосылкиОзвучкиMCP();
		Если ЗначениеЗаполнено(ТекстПредпосылки) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстПредпосылки);
		КонецЕсли;
		
		Начало = ТекущаяДата();
		Попытка
			Ванесса.ПроизнестиТекстMCP(Текст, Истина);
			Статус = Ванесса.Локализовать("Синтезировано");
			Успех = Истина;
		Исключение
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			ТекстПредпосылки = Ванесса.ПроверитьПредпосылкиОзвучкиMCP();
			Если ЗначениеЗаполнено(ТекстПредпосылки) Тогда
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстПредпосылки);
			КонецЕсли;
			Статус = Ванесса.Локализовать("Ошибка:") + " " + ТекстОшибки;
			Успех = Ложь;
		КонецПопытки;
		
		Результаты.Добавить(Новый Структура("Текст, Статус, Время, Успех, Дубликат",
			Текст, Статус, ТекущаяДата() - Начало, Успех, Ложь));
	КонецЦикла;
	
	Возврат MCPОтветОзвучкиТекстов(Результаты, Ванесса.Объект.ЗаписьВидеоКэшироватьФайлыTTS);
	
КонецФункции

// Запускает пакетный синтез: по одной фразе между тиками обработчика
&НаКлиенте
Функция НачатьПакетСинтезаMCP(Запрос, Тексты) Экспорт
	
	Если ПакетСинтезаMCP <> Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Уже выполняется пакетный синтез."));
	КонецЕсли;
	
	ИдентификаторЗапроса = "";
	Попытка
		ИдентификаторЗапроса = Запрос.Идентификатор;
	Исключение
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось определить идентификатор запроса MCP."));
	КонецЕсли;
	
	ПакетСинтезаMCP = Новый Структура;
	ПакетСинтезаMCP.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ПакетСинтезаMCP.Вставить("Тексты", Тексты);
	//Повторяющиеся фразы синтезируются один раз, в результатах отмечаются как дубликаты
	Уникальные = Новый Соответствие;
	План = Новый Массив;
	Для Каждого Текст Из Тексты Цикл
		Если Уникальные.Получить(Текст) <> Неопределено Тогда
			План.Добавить(Новый Структура("Текст, Дубликат", Текст, Истина));
		Иначе
			Уникальные.Вставить(Текст, Истина);
			План.Добавить(Новый Структура("Текст, Дубликат", Текст, Ложь));
		КонецЕсли;
	КонецЦикла;
	ПакетСинтезаMCP.Вставить("План", План);
	ПакетСинтезаMCP.Вставить("Индекс", -1);
	ПакетСинтезаMCP.Вставить("Результаты", Новый Массив);
	ПакетСинтезаMCP.Вставить("ТокенПрогресса", ПрогрессТокенИзЗапроса(Запрос));
	ПакетСинтезаMCP.Вставить("Начало", ТекущаяДата());
	
	Попытка
		ПодключитьОбработчикОжидания("ПродолжитьПакетСинтезаMCP", 1, Ложь);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ПакетСинтезаMCP = Неопределено;
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Попытка
		ПодключитьОбработчикОжидания("ПроверитьТаймаутПакетаСинтезаMCP", 600, Истина);
	Исключение
		MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ОбработчикWatchdogНеПодключен");
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

// Продолжает пакетный синтез одной фразой за тик
&НаКлиенте
Процедура ПродолжитьПакетСинтезаMCP() Экспорт
	
	Если ПакетСинтезаMCP = Неопределено Тогда
		ОтключитьОбработчикОжиданияБезопасно("ПродолжитьПакетСинтезаMCP");
		Возврат;
	КонецЕсли;
	Если Ванесса = Неопределено Тогда
		ПакетСинтезаMCP = Неопределено;
		ОтключитьОбработчикОжиданияБезопасно("ПродолжитьПакетСинтезаMCP");
		Возврат;
	КонецЕсли;
	Если ТекущаяДата() - ПакетСинтезаMCP.Начало > 600 Тогда
		ЗавершитьПакетСинтезаMCP("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось завершить пакетный синтез: превышено время ожидания."));
		Возврат;
	КонецЕсли;
	
	ПакетСинтезаMCP.Индекс = ПакетСинтезаMCP.Индекс + 1;
	Если ПакетСинтезаMCP.Индекс >= ПакетСинтезаMCP.План.Количество() Тогда
		ЗавершитьПакетСинтезаMCP("", "");
		Возврат;
	КонецЕсли;
	
	ЭлементПлана = ПакетСинтезаMCP.План[ПакетСинтезаMCP.Индекс];
	Текст = ЭлементПлана.Текст;
	Если ЭлементПлана.Дубликат Тогда
		ПакетСинтезаMCP.Результаты.Добавить(Новый Структура("Текст, Статус, Время, Успех, Дубликат",
			Текст, Ванесса.Локализовать("Пропущен (дубликат)"), 0, Истина, Истина));
		MCPУведомитьОПрогрессеПакетаСинтезаMCP(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Пропущен дубликат фразы %1 из %2"),
			ПакетСинтезаMCP.Индекс + 1, ПакетСинтезаMCP.Тексты.Количество()));
		Возврат;
	КонецЕсли;
	
	ТекстПредпосылки = Ванесса.ПроверитьПредпосылкиОзвучкиMCP();
	Если ЗначениеЗаполнено(ТекстПредпосылки) Тогда
		ЗавершитьПакетСинтезаMCP("ACTION_FAILED", ТекстПредпосылки);
		Возврат;
	КонецЕсли;
	
	Начало = ТекущаяДата();
	Попытка
		Ванесса.ПроизнестиТекстMCP(Текст, Истина);
		Статус = Ванесса.Локализовать("Синтезировано");
		Успех = Истина;
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ТекстПредпосылки = Ванесса.ПроверитьПредпосылкиОзвучкиMCP();
		Если ЗначениеЗаполнено(ТекстПредпосылки) Тогда
			ЗавершитьПакетСинтезаMCP("ACTION_FAILED", ТекстПредпосылки);
			Возврат;
		КонецЕсли;
		Статус = Ванесса.Локализовать("Ошибка:") + " " + ТекстОшибки;
		Успех = Ложь;
	КонецПопытки;
	
	ПакетСинтезаMCP.Результаты.Добавить(Новый Структура("Текст, Статус, Время, Успех, Дубликат",
		Текст, Статус, ТекущаяДата() - Начало, Успех, Ложь));
	
	MCPУведомитьОПрогрессеПакетаСинтезаMCP(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Синтез фразы %1 из %2"),
		ПакетСинтезаMCP.Индекс + 1, ПакетСинтезаMCP.Тексты.Количество()));
	
КонецПроцедуры

// Отправляет прогресс пакетного синтеза, если клиент передал токен прогресса
&НаКлиенте
Процедура MCPУведомитьОПрогрессеПакетаСинтезаMCP(ТекстСообщения)
	
	Если ПакетСинтезаMCP = Неопределено
		ИЛИ ТипЗнч(ПакетСинтезаMCP.ТокенПрогресса) = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;
	Попытка
		МодульМсп_Сервер().УведомитьОПрогрессе(
			ПакетСинтезаMCP.ТокенПрогресса,
			ПакетСинтезаMCP.Индекс + 1,
			ПакетСинтезаMCP.Тексты.Количество(),
			ТекстСообщения);
	Исключение
		MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ОшибкаПрогресса");
	КонецПопытки;
	
КонецПроцедуры

// Завершает пакетный синтез и отправляет ровно один ответ
&НаКлиенте
Процедура ЗавершитьПакетСинтезаMCP(КодОшибки, ТекстОшибки) Экспорт
	
	Если ПакетСинтезаMCP = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЗапроса = ПакетСинтезаMCP.ИдентификаторЗапроса;
	Результаты = ПакетСинтезаMCP.Результаты;
	ПакетСинтезаMCP = Неопределено;
	
	ОтключитьОбработчикОжиданияБезопасно("ПродолжитьПакетСинтезаMCP");
	ОтключитьОбработчикОжиданияБезопасно("ПроверитьТаймаутПакетаСинтезаMCP");
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ПустойИдентификаторЗапроса");
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ПустаяСтрока(КодОшибки) Тогда
			ТекстОтвета = MCPОтветОзвучкиТекстов(Результаты, Ванесса.Объект.ЗаписьВидеоКэшироватьФайлыTTS);
			МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(ИдентификаторЗапроса, ТекстОтвета);
		Иначе
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, КодОшибки, ТекстОшибки);
		КонецЕсли;
	Исключение
		MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ОшибкаОтправкиОтвета");
	КонецПопытки;
	
КонецПроцедуры

// Watchdog пакетного синтеза: отдельный таймер страхует потерю основного обработчика
&НаКлиенте
Процедура ПроверитьТаймаутПакетаСинтезаMCP() Экспорт
	
	Если ПакетСинтезаMCP = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Ванесса = Неопределено Тогда
		ПакетСинтезаMCP = Неопределено;
		ОтключитьОбработчикОжиданияБезопасно("ПродолжитьПакетСинтезаMCP");
		Возврат;
	КонецЕсли;
	
	Если ТекущаяДата() - ПакетСинтезаMCP.Начало >= 600 Тогда
		ЗавершитьПакетСинтезаMCP("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось завершить пакетный синтез: превышено время ожидания."));
	Иначе
		Попытка
			ПодключитьОбработчикОжидания("ПроверитьТаймаутПакетаСинтезаMCP", 600, Истина);
		Исключение
			MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ОбработчикWatchdogНеПодключен");
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Формирует ответ по массиву синтезированных фраз
&НаКлиенте
Функция MCPОтветОзвучкиТекстов(Результаты, КешированиеВключено = Ложь) Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Результаты синтеза"));
	Строки.Добавить("");
	Строки.Добавить(Ванесса.Локализовать("| # | Фраза | Статус | Время, с |"));
	Строки.Добавить("|---|-------|--------|----------|");
	
	Успешно = 0;
	СОшибками = 0;
	Дубликатов = 0;
	Номер = 0;
	Для Каждого Результат Из Результаты Цикл
		Номер = Номер + 1;
		Если Результат.Дубликат Тогда
			Дубликатов = Дубликатов + 1;
		ИначеЕсли Результат.Успех Тогда
			Успешно = Успешно + 1;
		Иначе
			СОшибками = СОшибками + 1;
		КонецЕсли;
		
		ТекстФразы = Результат.Текст;
		Если СтрДлина(ТекстФразы) > 40 Тогда
			ТекстФразы = Лев(ТекстФразы, 40) + "...";
		КонецЕсли;
		ТекстФразы = СтрЗаменить(ТекстФразы, "|", "\|");
		ТекстФразы = СтрЗаменить(ТекстФразы, Символы.ПС, " ");
		ТекстФразы = СтрЗаменить(ТекстФразы, Символы.ВК, " ");
		Статус = СтрЗаменить(Результат.Статус, "|", "\|");
		Статус = СтрЗаменить(Статус, Символы.ПС, " ");
		
		Строки.Добавить("| " + Номер + " | " + ТекстФразы + " | " + Статус + " | "
			+ Формат(Результат.Время, "ЧДЦ=2; ЧН=0") + " |");
	КонецЦикла;
	
	Строки.Добавить("");
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("Успешно: %1, с ошибками: %2, дубликатов: %3."),
		Успешно, СОшибками, Дубликатов));
	Если НЕ КешированиеВключено Тогда
		Строки.Добавить(Ванесса.Локализовать("Кеширование озвучки отключено в настройках, кеш не прогрет."));
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Формирует ответ инструмента speak_text для одной фразы
&НаКлиенте
Функция MCPОтветОзвучкиТекста(ТекстРечи, БезВоспроизведения = Ложь)
	
	Строки = Новый Массив;
	Если БезВоспроизведения Тогда
		Строки.Добавить(Ванесса.Локализовать("# Текст синтезирован без воспроизведения"));
		Если Ванесса.Объект.ЗаписьВидеоКэшироватьФайлыTTS Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Фраза длиной %1 символов сохранена в кеш озвучки. Повторный вызов с этим же текстом получит озвучку из кеша."),
				СтрДлина(ТекстРечи)));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Кеширование озвучки отключено в настройках, файл в кеш не сохранён."));
		КонецЕсли;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("# Текст передан на озвучку"));
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Запущено воспроизведение фразы длиной %1 символов. Повторный speak_text во время звучания вернёт ошибку; другие инструменты доступны."),
			СтрДлина(ТекстРечи)));
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Завершает асинхронную проверку занятости движка озвучки и запускает озвучку текста
&НаКлиенте
Процедура ПроизнестиТекстПроверкаОзвучкиЗавершена(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт
	
	ИдентификаторЗапроса = "";
	ТекстРечи = "";
	ЖдатьЗавершения = Ложь;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ДопПараметры.Свойство("MCPИдентификаторЗапроса", ИдентификаторЗапроса);
		ДопПараметры.Свойство("Текст", ТекстРечи);
		ДопПараметры.Свойство("Ждать", ЖдатьЗавершения);
	КонецЕсли;
	
	//Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка
		
		Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
			ЗапускОзвучкиMCPВПроцессе = Ложь;
			ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
			MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ПустойИдентификаторЗапроса");
			Возврат;
		КонецЕсли;
		Если ПустаяСтрока(ТекстРечи) Тогда
			ЗапускОзвучкиMCPВПроцессе = Ложь;
			ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "INVALID_PARAMS",
				Ванесса.Локализовать("Параметр text обязателен и не может быть пустым."));
			Возврат;
		КонецЕсли;
		
		Если РезультатВызова = Неопределено Тогда
			ЗапускОзвучкиMCPВПроцессе = Ложь;
			ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED",
				Ванесса.Локализовать("Состояние озвучки не определено. Повторите вызов."));
			Возврат;
		КонецЕсли;
		
		//Фраза могла закончиться, пока шла асинхронная проверка: тогда состояние уже сброшено событием MEDIA_FINISHED
		Если РезультатВызова = Истина И ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP) Тогда
			ЗапускОзвучкиMCPВПроцессе = Ложь;
			ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Предыдущая фраза ещё произносится: <%1>. Дождитесь окончания озвучки и повторите вызов."),
				Ванесса.ТекстОзвучкиMCP);
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED", ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		Ванесса.ОчиститьСостояниеОзвучкиMCP();
		Ванесса.ПроизнестиТекстMCP(ТекстРечи, Ложь);
		ЗапускОзвучкиMCPВПроцессе = Ложь;
		ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
		
		Если ЖдатьЗавершения Тогда
			НачатьОжиданиеОзвучкиMCP(ИдентификаторЗапроса, ТекстРечи);
			Возврат;
		КонецЕсли;
		
		МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(ИдентификаторЗапроса, MCPОтветОзвучкиТекста(ТекстРечи));
		
	Исключение
		ЗапускОзвучкиMCPВПроцессе = Ложь;
		ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Готовит состояние ожидания к новому вызову: завершает устаревшее ожидание
&НаКлиенте
Процедура ПодготовитьОжиданиеОзвучкиMCPКНовомуВызову()
	
	Если ОжиданиеОзвучкиMCP = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ванесса.ОшибкаСтартаОзвучкиMCP)
		И Ванесса.ИДОзвучкиОшибкиСтартаMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
		ТекстОшибкиСтарта = Ванесса.ОшибкаСтартаОзвучкиMCP;
		Ванесса.ОшибкаСтартаОзвучкиMCP = Неопределено;
		Ванесса.ИДОзвучкиОшибкиСтартаMCP = Неопределено;
		ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED", ТекстОшибкиСтарта);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP)
		ИЛИ Ванесса.ИДОзвучкиMCP <> ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
		ЗавершитьОжиданиеОзвучкиMCP("", "");
	КонецЕсли;
	
КонецПроцедуры

// Начинает ожидание окончания фразы и оставляет запрос MCP открытым
&НаКлиенте
Процедура НачатьОжиданиеОзвучкиMCP(ИдентификаторЗапроса, ТекстРечи)
	
	Если ОжиданиеОзвучкиMCP <> Неопределено Тогда
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED",
			Ванесса.Локализовать("Уже есть активное ожидание завершения фразы."));
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP) Тогда
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED",
			Ванесса.Локализовать("Не удалось определить состояние запущенной озвучки."));
		Возврат;
	КонецЕсли;
	
	ОжиданиеОзвучкиMCP = Новый Структура;
	ОжиданиеОзвучкиMCP.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ОжиданиеОзвучкиMCP.Вставить("ИДОзвучки", Ванесса.ИДОзвучкиMCP);
	ОжиданиеОзвучкиMCP.Вставить("Текст", ТекстРечи);
	ОжиданиеОзвучкиMCP.Вставить("Начало", ТекущаяДата());
	ОжиданиеОзвучкиMCP.Вставить("ТаймаутСекунд", 600);
	ОжиданиеОзвучкиMCP.Вставить("ДиагностическийСрокСекунд", 10);
	ОжиданиеОзвучкиMCP.Вставить("НеудачныхПроверок", 0);
	ОжиданиеОзвучкиMCP.Вставить("ДиагностикаЗаписана", Ложь);
	ОжиданиеОзвучкиMCP.Вставить("ПроверкаВПолёте", Ложь);
	
	Попытка
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеОзвучкиMCP", 1, Ложь);
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ОжиданиеОзвучкиMCP = Неопределено;
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Опрашивает состояние плеера и завершает ожидание
&НаКлиенте
Процедура ПроверитьЗавершениеОзвучкиMCP() Экспорт
	
	Если ОжиданиеОзвучкиMCP = Неопределено Тогда
		ОтключитьОбработчикОжиданияБезопасно("ПроверитьЗавершениеОзвучкиMCP");
		Возврат;
	КонецЕсли;
	Если Ванесса = Неопределено Тогда
		ОжиданиеОзвучкиMCP = Неопределено;
		ОтключитьОбработчикОжиданияБезопасно("ПроверитьЗавершениеОзвучкиMCP");
		Возврат;
	КонецЕсли;
	
	//Таймаут не должен зависеть от проверки старта B1a
	Если ТекущаяДата() - ОжиданиеОзвучкиMCP.Начало >= ОжиданиеОзвучкиMCP.ТаймаутСекунд Тогда
		//Очищаем плеер, иначе следующая фраза навсегда увидит его занятым
		Если ЗначениеЗаполнено(ОжиданиеОзвучкиMCP.ИДОзвучки)
			И Ванесса.ИДОзвучкиMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
			Ванесса.ОчиститьСостояниеОзвучкиMCP();
		КонецЕсли;
		ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось дождаться окончания озвучки: превышено время ожидания."));
		Возврат;
	КонецЕсли;
	
	Если Ванесса.ИДОзвучкиПроверкиСтартаMCP <> ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
		Если ТекущаяДата() - ОжиданиеОзвучкиMCP.Начало < ОжиданиеОзвучкиMCP.ДиагностическийСрокСекунд Тогда
			Возврат;
		КонецЕсли;
		Если НЕ ОжиданиеОзвучкиMCP.ДиагностикаЗаписана Тогда
			MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ПроверкаСтартаНеВыполнена");
			ОжиданиеОзвучкиMCP.ДиагностикаЗаписана = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ванесса.ОшибкаСтартаОзвучкиMCP)
		И Ванесса.ИДОзвучкиОшибкиСтартаMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
		ТекстОшибкиСтарта = Ванесса.ОшибкаСтартаОзвучкиMCP;
		Ванесса.ОшибкаСтартаОзвучкиMCP = Неопределено;
		Ванесса.ИДОзвучкиОшибкиСтартаMCP = Неопределено;
		ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED", ТекстОшибкиСтарта);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP)
		ИЛИ Ванесса.ИДОзвучкиMCP <> ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
		ЗавершитьОжиданиеОзвучкиMCP("", "");
		Возврат;
	КонецЕсли;
	
	Если ОжиданиеОзвучкиMCP.ПроверкаВПолёте Тогда
		Возврат;
	КонецЕсли;
	ОжиданиеОзвучкиMCP.ПроверкаВПолёте = Истина;
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИДОзвучки", ОжиданиеОзвучкиMCP.ИДОзвучки);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПроверкаЗавершенияОзвучкиMCPЗавершена", ЭтаФорма, ПараметрыПроверки);
	Попытка
		Ванесса.НачатьПроверкуОзвучкиMCP(ОписаниеОповещения);
	Исключение
		Если ОжиданиеОзвучкиMCP <> Неопределено Тогда
			ОжиданиеОзвучкиMCP.ПроверкаВПолёте = Ложь;
		КонецЕсли;
		ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
КонецПроцедуры

// Обрабатывает результат асинхронной проверки состояния плеера
&НаКлиенте
Процедура ПроверкаЗавершенияОзвучкиMCPЗавершена(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт
	
	Попытка
		Если ОжиданиеОзвучкиMCP = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если Ванесса = Неопределено Тогда
			ОжиданиеОзвучкиMCP = Неопределено;
			Возврат;
		КонецЕсли;
		
		ИДОзвучкиПроверки = Неопределено;
		Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
			ДопПараметры.Свойство("ИДОзвучки", ИДОзвучкиПроверки);
		КонецЕсли;
		//Ответ устаревшей проверки: не трогаем новое ожидание
		Если ИДОзвучкиПроверки <> ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
			Возврат;
		КонецЕсли;
		
		ОжиданиеОзвучкиMCP.ПроверкаВПолёте = Ложь;
		
		Если ЗначениеЗаполнено(Ванесса.ОшибкаСтартаОзвучкиMCP)
			И Ванесса.ИДОзвучкиОшибкиСтартаMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
			ТекстОшибкиСтарта = Ванесса.ОшибкаСтартаОзвучкиMCP;
			Ванесса.ОшибкаСтартаОзвучкиMCP = Неопределено;
			Ванесса.ИДОзвучкиОшибкиСтартаMCP = Неопределено;
			ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED", ТекстОшибкиСтарта);
			Возврат;
		КонецЕсли;
		
		Если РезультатВызова = Истина
			И Ванесса.ИДОзвучкиMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
			ОжиданиеОзвучкиMCP.НеудачныхПроверок = 0;
			Возврат;
		КонецЕсли;
		
		Если РезультатВызова = Неопределено Тогда
			ОжиданиеОзвучкиMCP.НеудачныхПроверок = ОжиданиеОзвучкиMCP.НеудачныхПроверок + 1;
			Если ОжиданиеОзвучкиMCP.НеудачныхПроверок >= 3 Тогда
				ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED",
					Ванесса.Локализовать("Не удалось проверить состояние озвучки."));
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если РезультатВызова = Ложь
			И Ванесса.ИДОзвучкиMCP = ОжиданиеОзвучкиMCP.ИДОзвучки
			И Ванесса.ИДОзвучкиСтартПодтвержденMCP <> ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
			Ванесса.ОчиститьСостояниеОзвучкиMCP();
			ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED",
				Ванесса.Локализовать("Не удалось подтвердить старт озвучки."));
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP)
			ИЛИ Ванесса.ИДОзвучкиMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
			Если Ванесса.ИДОзвучкиMCP = ОжиданиеОзвучкиMCP.ИДОзвучки Тогда
				Ванесса.ОчиститьСостояниеОзвучкиMCP();
			КонецЕсли;
			ЗавершитьОжиданиеОзвучкиMCP("", "");
		КонецЕсли;
	Исключение
		Если ОжиданиеОзвучкиMCP <> Неопределено Тогда
			ОжиданиеОзвучкиMCP.ПроверкаВПолёте = Ложь;
		КонецЕсли;
		ЗавершитьОжиданиеОзвучкиMCP("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
КонецПроцедуры

// Завершает ожидание и отправляет ровно один ответ
&НаКлиенте
Процедура ЗавершитьОжиданиеОзвучкиMCP(КодОшибки, ТекстОшибки) Экспорт
	
	Если ОжиданиеОзвучкиMCP = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЗапроса = ОжиданиеОзвучкиMCP.ИдентификаторЗапроса;
	ОжиданиеОзвучкиMCP = Неопределено;
	ОтключитьОбработчикОжиданияБезопасно("ПроверитьЗавершениеОзвучкиMCP");
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ПустойИдентификаторЗапроса");
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ПустаяСтрока(КодОшибки) Тогда
			ТекстУспеха = "Фраза завершена.";
			Если Ванесса <> Неопределено Тогда
				ТекстУспеха = Ванесса.Локализовать(ТекстУспеха);
			КонецЕсли;
			МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(ИдентификаторЗапроса, ТекстУспеха);
		Иначе
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, КодОшибки, ТекстОшибки);
		КонецЕсли;
	Исключение
		MCPЗаписатьСлужебныеДанныеБезопасно("ОзвучкаТекстаMCP.ОшибкаОтправкиОтвета");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбработчикОжиданияБезопасно(ИмяОбработчика)
	
	Попытка
