КонецФункции

&НаКлиенте
Функция MCPКолонкиЖурналаРегистрацииИзСтроки(Значение, ТекстОшибки)
	
	Текст = НРег(MCPСтрокаПараметраЖурналаРегистрации(Значение));
	Если Текст = "" Тогда
		Колонки = Новый Массив;
		Колонки.Добавить("date");
		Колонки.Добавить("level");
		Колонки.Добавить("event");
		Колонки.Добавить("comment");
		Колонки.Добавить("user");
		Колонки.Добавить("computer");
		Колонки.Добавить("session");
		Колонки.Добавить("metadata");
		Возврат Колонки;
	КонецЕсли;
	
	Допустимые = MCPВсеКолонкиЖурналаРегистрации();
	Результат = Новый Массив;
	
	Если Текст = "all" Тогда
		Результат = Допустимые;
	Иначе
		Части = Ванесса._СтрРазделить(Текст, "|", Истина);
		Для Каждого Часть Из Части Цикл
			Имя = СокрЛП(Часть);
			Если Имя = "" Тогда
				Продолжить;
			КонецЕсли;
			Если Имя = "all" Тогда
				ТекстОшибки = MCPОформитьОшибку(
					Ванесса.Локализовать("Значение ""all"" в параметре columns нельзя указывать вместе с другими колонками."),
					Ванесса.Локализовать("Передайте либо columns=all, либо перечисление конкретных колонок."));
				Возврат Неопределено;
			КонецЕсли;
			Если Результат.Найти(Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Допустимые.Найти(Имя) = Неопределено Тогда
				ТекстОшибки = MCPОформитьОшибку(
					Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Неизвестная колонка журнала регистрации: ""%1""."), Имя),
					Ванесса.Локализовать("Допустимые колонки:") + " " + Ванесса._СтрСоединить(Допустимые, ", ") + "; all - все колонки.");
				Возврат Неопределено;
			КонецЕсли;
			Результат.Добавить(Имя);
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.Локализовать("Не выбрано ни одной колонки журнала регистрации."),
			Ванесса.Локализовать("Перечислите нужные колонки через '|' или передайте columns=all."));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPЭтоИзвестныйУровеньЖурналаРегистрации(Значение)
	
	Ключ = НРег(СокрЛП(Строка(Значение)));
	Возврат Ключ = "информация" ИЛИ Ключ = "information"
		ИЛИ Ключ = "ошибка" ИЛИ Ключ = "error"
		ИЛИ Ключ = "предупреждение" ИЛИ Ключ = "warning"
		ИЛИ Ключ = "примечание" ИЛИ Ключ = "note";
	
КонецФункции

&НаКлиенте
Функция MCPЭтоИзвестныйСтатусТранзакцииЖурналаРегистрации(Значение)
	
	Ключ = НРег(СокрЛП(Строка(Значение)));
	Возврат Ключ = "зафиксирована" ИЛИ Ключ = "committed"
		ИЛИ Ключ = "отменена" ИЛИ Ключ = "rolledback"
		ИЛИ Ключ = "незавершена" ИЛИ Ключ = "unfinished"
		ИЛИ Ключ = "неттранзакции" ИЛИ Ключ = "notapplicable";
	
КонецФункции

// Читает журнал регистрации базы клиента тестирования через обработку расширения VAExtension.
// Возвращает структуру результата или Неопределено; при ошибке заполняет ТекстОшибки.
&НаКлиенте
Функция MCPДанныеЖурналаРегистрацииКлиентаТестирования(Параметры, ТекстОшибки) Экспорт
	
	ТекстОшибки = "";
	ПараметрыJSON = Ванесса.ЗаписатьОбъектJSON(Параметры);
	
	ОкноДляВозвратаФокуса = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	КнопкаЗакрытьФорму = Неопределено;
	РеквизитВыражениеВычислено = Неопределено;
	
	// Открытие формы, ввод параметров и нажатие кнопки могут упасть (например, если в базе клиента
	// нет расширения VAExtension 1.40): форму в этом случае нужно закрыть, а фокус - вернуть.
	Попытка
		Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ЖурналРегистрации");
		ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
		НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ЖурналРегистрации.*",5);
		Если НужнаяФорма = Неопределено Тогда
			ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключён, но не найдена форма 'VAExtension_ЖурналРегистрации' из служебного расширения.")
				+ Символы.ПС + Ванесса.Локализовать("Установите или обновите расширение VAExtension до версии 1.40 в базе клиента тестирования.");
			ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
			Возврат Неопределено;
		КонецЕсли;
		
		ДопПараметрыПоиска = Новый Структура("КонтейнерДляПоиска", НужнаяФорма);
		
		РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитДляУстановкиПараметров = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ДляУстановкиПараметров", Истина, Истина, , ДопПараметрыПоиска);
		КнопкаВыполнитьОбработку = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьОбработку");
		КнопкаЗакрытьФорму = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
		
		РеквизитДляУстановкиПараметров.ВвестиТекст(ПараметрыJSON);
		КнопкаВыполнитьОбработку.Нажать();
	Исключение
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		ТекстОшибки = Ванесса.Локализовать("Не удалось открыть обработку VAExtension_ЖурналРегистрации в базе клиента тестирования.")
			+ Символы.ПС + Ванесса.Локализовать("Проверьте, что в базе клиента установлено расширение VAExtension версии 1.40 или выше.")
			+ Символы.ПС + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ТекстИсключенияФормы = "";
		РеквизитТекстИсключения = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ТекстИсключения", Истина, Истина, , ДопПараметрыПоиска);
		Если РеквизитТекстИсключения <> Неопределено Тогда
			ТекстИсключенияФормы = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитТекстИсключения);
		КонецЕсли;
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные журнала регистрации из базы клиента тестирования.");
		Если ЗначениеЗаполнено(ТекстИсключенияФормы) Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + ТекстИсключенияФормы;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитЗначениеРезультат = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеРезультат", Истина, Истина, , ДопПараметрыПоиска);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеРезультат);
	
	// Закрываем служебную форму до разбора результата: при ошибке разбора форма не останется открытой.
	ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
	ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
	
	Если НЕ ЗначениеЗаполнено(ПредставлениеРезультата) Тогда
		ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension вернуло пустой результат без текста ошибки.")
			+ Символы.ПС + Ванесса.Локализовать("Возможные причины: ошибка на стороне клиента тестирования или устаревшая версия расширения VAExtension без передачи текста ошибки. Обновите расширение VAExtension в клиенте тестирования.");
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не получилось разобрать JSON результата расширения VAExtension.")
			+ Символы.ПС + ОписаниеОшибки()
			+ Символы.ПС + Ванесса.Локализовать("Первые 1000 символов результата:")
			+ Символы.ПС + Лев(ПредставлениеРезультата, 1000);
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаВыполнения") Тогда
		ТекстОшибки = Данные.ОшибкаВыполнения;
		Если Данные.Свойство("ПодробностиОшибки") И ЗначениеЗаполнено(Данные.ПодробностиОшибки) Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + Данные.ПодробностиОшибки;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Данные) <> Тип("Структура") ИЛИ НЕ Данные.Свойство("Строки") Тогда
		ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension вернуло неожиданный формат результата.")
			+ Символы.ПС + Ванесса.Локализовать("Обновите расширение VAExtension в клиенте тестирования до версии 1.40.");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

&НаКлиенте
Функция MCPЗаголовкиКолонокЖурналаРегистрации()
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("date", Ванесса.Локализовать("Дата"));
	Заголовки.Вставить("level", Ванесса.Локализовать("Уровень"));
	Заголовки.Вставить("event", Ванесса.Локализовать("Событие"));
	Заголовки.Вставить("event_presentation", Ванесса.Локализовать("Представление события"));
	Заголовки.Вставить("comment", Ванесса.Локализовать("Комментарий"));
	Заголовки.Вставить("metadata", Ванесса.Локализовать("Метаданные"));
	Заголовки.Вставить("metadata_presentation", Ванесса.Локализовать("Представление метаданных"));
	Заголовки.Вставить("data", Ванесса.Локализовать("Данные"));
	Заголовки.Вставить("data_presentation", Ванесса.Локализовать("Представление данных"));
	Заголовки.Вставить("user", Ванесса.Локализовать("Пользователь"));
	Заголовки.Вставить("user_name", Ванесса.Локализовать("Имя пользователя"));
	Заголовки.Вставить("computer", Ванесса.Локализовать("Компьютер"));
	Заголовки.Вставить("application", Ванесса.Локализовать("Имя приложения"));
	Заголовки.Вставить("application_presentation", Ванесса.Локализовать("Представление приложения"));
	Заголовки.Вставить("connection", Ванесса.Локализовать("Соединение"));
	Заголовки.Вставить("session", Ванесса.Локализовать("Сеанс"));
	Заголовки.Вставить("server", Ванесса.Локализовать("Рабочий сервер"));
	Заголовки.Вставить("port", Ванесса.Локализовать("Основной IP-порт"));
	Заголовки.Вставить("sync_port", Ванесса.Локализовать("Вспомогательный IP-порт"));
	Заголовки.Вставить("transaction", Ванесса.Локализовать("Транзакция"));
	Заголовки.Вставить("transaction_status", Ванесса.Локализовать("Статус транзакции"));
	Возврат Заголовки;
	
КонецФункции

// Собирает ответ инструмента: markdown или json, при необходимости - в файл.
&НаКлиенте
Функция MCPОтветЖурналаРегистрации(Данные, Параметры, ИмяИнструмента, ИмяБазы) Экспорт
	
	Шапка = MCPШапкаОтветаЖурналаРегистрации(Данные, ИмяИнструмента, ИмяБазы);
	ФорматВывода = Параметры.ФорматВывода;
	ПутьФайла = Параметры.ПутьФайлаВывода;
	
	Если ФорматВывода = "json" Тогда
		ТелоОтвета = MCPТелоОтветаЖурналаРегистрацииJSON(Данные, ИмяИнструмента, ИмяБазы);
	Иначе
		ТелоОтвета = MCPТелоОтветаЖурналаРегистрацииMarkdown(Данные);
	КонецЕсли;
	
	Если ПутьФайла = "" Тогда
		Возврат Ванесса._СтрСоединить(Шапка, Символы.ПС) + Символы.ПС + ТелоОтвета;
	КонецЕсли;
	
	// В markdown-файл пишется ответ вместе с шапкой, иначе по файлу не понять, из какой он базы; JSON-файл должен остаться валидным JSON.
	ТекстФайла = ?(ФорматВывода = "json", ТелоОтвета, Ванесса._СтрСоединить(Шапка, Символы.ПС) + Символы.ПС + ТелоОтвета);
	
	ТекстОшибкиЗаписи = MCPЗаписатьТекстВФайлЖурналаРегистрации(ПутьФайла, ТекстФайла);
	Если ТекстОшибкиЗаписи <> "" Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не удалось записать ответ в файл <%1>."), ПутьФайла),
				Ванесса.Локализовать("Проверьте, что каталог существует и доступен на запись для пользователя, от имени которого работает Vanessa Automation."),
				ТекстОшибкиЗаписи));
	КонецЕсли;
	
	ФайлРезультата = Новый Файл(ПутьФайла);
	Превью = MCPПревьюТекстаЖурналаРегистрации(ТекстФайла, 10, 1200);
	
	Шапка.Добавить("");
	Шапка.Добавить(Ванесса.Локализовать("# Ответ записан в файл"));
	Шапка.Добавить("");
	Шапка.Добавить("- " + Ванесса.Локализовать("Файл:") + " " + ПутьФайла);
	Шапка.Добавить("- " + Ванесса.Локализовать("Формат:") + " " + ФорматВывода);
	Шапка.Добавить("- " + Ванесса.Локализовать("Размер файла:") + " " + XMLСтрока(ФайлРезультата.Размер()) + " " + Ванесса.Локализовать("байт"));
	Шапка.Добавить("");
	Шапка.Добавить(Ванесса.Локализовать("Превью (первые строки):"));
	Шапка.Добавить("");
	Шапка.Добавить(Превью);
	
	Возврат Ванесса._СтрСоединить(Шапка, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция MCPШапкаОтветаЖурналаРегистрации(Данные, ИмяИнструмента, ИмяБазы)
	
	Счётчики = Данные.Счётчики;
	ПараметрыРезультата = Данные.Параметры;
	
	Строки = Новый Массив;
	Строки.Добавить("# " + Ванесса.Локализовать("Журнал регистрации") + ": " + ИмяБазы);
	Строки.Добавить("");
	Строки.Добавить("- " + Ванесса.Локализовать("Инструмент:") + " " + ИмяИнструмента);
	Строки.Добавить("- " + Ванесса.Локализовать("Период:") + " " + ПараметрыРезультата.ДатаНачала + " — " + ПараметрыРезультата.ДатаОкончания);
	Строки.Добавить("- " + Ванесса.Локализовать("Колонки:") + " " + Ванесса._СтрСоединить(ПараметрыРезультата.Колонки, ", "));
	Строки.Добавить("- " + Ванесса.Локализовать("Порядок вывода:") + " " + ПараметрыРезультата.ПорядокВывода);
	Строки.Добавить("- " + Ванесса.Локализовать("Язык имён журнала регистрации:") + " " + Счётчики.ЯзыкЖурналаРегистрации);
	Строки.Добавить("- " + Ванесса.Локализовать("Прочитано платформой:") + " " + Формат(Счётчики.ПрочитаноПлатформой, "ЧГ=0; ЧН=0")
		+ "; " + Ванесса.Локализовать("отобрано после фильтра:") + " " + Формат(Счётчики.ОтобраноПослеФильтра, "ЧГ=0; ЧН=0")
		+ "; " + Ванесса.Локализовать("показано:") + " " + Формат(Счётчики.Показано, "ЧГ=0; ЧН=0")
		+ " (" + Ванесса.Локализовать("лимит") + " " + Формат(ПараметрыРезультата.Лимит, "ЧГ=0; ЧН=0")
		+ ", " + Ванесса.Локализовать("бюджет сканирования") + " " + Формат(ПараметрыРезультата.БюджетСканирования, "ЧГ=0; ЧН=0") + ")");
	
	Если Счётчики.ЛимитДостигнут Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Отобрано больше, чем limit: показаны только самые свежие строки. Сузьте период или увеличьте limit."));
	КонецЕсли;
	Если Счётчики.БюджетСканированияДостигнут Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Достигнут бюджет сканирования: более старые события не прочитаны. Сузьте период, ослабьте отбор или увеличьте scan_limit."));
	КонецЕсли;
	Если Счётчики.МинДатаСтроки <> "" И (Счётчики.ЛимитДостигнут ИЛИ Счётчики.БюджетСканированияДостигнут) Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Для продолжения выборки передайте date_end =") + " " + Счётчики.МинДатаСтроки
			+ " (" + Ванесса.Локализовать("на границе секунды возможны повторы строк") + ")");
	КонецЕсли;
	Если Счётчики.Свойство("ОбрезаноЗначенийДанных") И Счётчики.ОбрезаноЗначенийДанных > 0 Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Значения колонки data обрезаны:") + " " + Формат(Счётчики.ОбрезаноЗначенийДанных, "ЧГ=0"));
	КонецЕсли;
	
	Если ТипЗнч(Данные.Предупреждения) = Тип("Массив") Тогда
		Для Каждого Предупреждение Из Данные.Предупреждения Цикл
			Строки.Добавить("- " + Ванесса.Локализовать("Внимание:") + " " + Предупреждение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

&НаКлиенте
Функция MCPТелоОтветаЖурналаРегистрацииMarkdown(Данные)
	
	Строки = Новый Массив;
	ЛогическиеКолонки = Данные.Параметры.Колонки;
	Заголовки = MCPЗаголовкиКолонокЖурналаРегистрации();
	
	Если Данные.Строки.Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("За указанный период событий, удовлетворяющих отбору, не найдено."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	ИменаКолонок = Новый Массив;
	Для Каждого ЛогическоеИмя Из ЛогическиеКолонки Цикл
		Заголовок = Заголовки.Получить(ЛогическоеИмя);
		Если Заголовок = Неопределено Тогда
			Заголовок = ЛогическоеИмя;
		КонецЕсли;
		ИменаКолонок.Добавить(Заголовок);
	КонецЦикла;
	
	ЗначенияСтрок = Новый Массив;
	Для Каждого СтрокаДанных Из Данные.Строки Цикл
		Значения = Новый Массив;
		Для Каждого ЛогическоеИмя Из ЛогическиеКолонки Цикл
			Значение = Неопределено;
			Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
				СтрокаДанных.Свойство(ЛогическоеИмя, Значение);
			КонецЕсли;
			Значения.Добавить(Значение);
		КонецЦикла;
		ЗначенияСтрок.Добавить(Значения);
	КонецЦикла;
	
	MCPВывестиТаблицуЗначенийВMarkdown(Строки, ИменаКолонок, Неопределено, ЗначенияСтрок);
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция MCPТелоОтветаЖурналаРегистрацииJSON(Данные, ИмяИнструмента, ИмяБазы)
	
	Результат = Новый Структура;
	Результат.Вставить("Инструмент", ИмяИнструмента);
	Результат.Вставить("База", ИмяБазы);
	Результат.Вставить("Параметры", Данные.Параметры);
	Результат.Вставить("Счётчики", Данные.Счётчики);
	Результат.Вставить("Предупреждения", Данные.Предупреждения);
	Результат.Вставить("Строки", Данные.Строки);
	Возврат Ванесса.ЗаписатьОбъектJSON(Результат);
	
КонецФункции

// Превью ограничивается и по строкам, и по символам: у JSON нет переводов строк,
// поэтому ограничение по строкам его не сокращает.
&НаКлиенте
Функция MCPПревьюТекстаЖурналаРегистрации(Текст, МаксимумСтрок, МаксимумСимволов = 0)
	
	Части = Ванесса._СтрРазделить(Строка(Текст), Символы.ПС);
	Превью = Новый Массив;
	ДлинаПревью = 0;
	Обрезано = Ложь;
	Для Инд = 0 По Части.Количество() - 1 Цикл
		Если Инд >= МаксимумСтрок Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Если МаксимумСимволов > 0 И ДлинаПревью + СтрДлина(Части[Инд]) > МаксимумСимволов Тогда
			Превью.Добавить(Лев(Части[Инд], МаксимумСимволов - ДлинаПревью));
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Превью.Добавить(Части[Инд]);
		ДлинаПревью = ДлинаПревью + СтрДлина(Части[Инд]);
	КонецЦикла;
	Если Обрезано Тогда
		Превью.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("...обрезано (всего %1 строк)"), Формат(Части.Количество(), "ЧГ=0")));
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Превью, Символы.ПС);
	
КонецФункции

// Записывает текст в файл UTF-8. Возвращает пустую строку при успехе, иначе текст ошибки.
&НаКлиенте
Функция MCPЗаписатьТекстВФайлЖурналаРегистрации(ПутьКФайлу, Текст)
	
	Запись = Неопределено;
	Попытка
		// Файл создаётся заново (перезапись), затем в него дозаписывается текст в UTF-8:
		// при дозаписи в существующий файл UTF-8 пишется без BOM.
		Запись = Новый ЗаписьТекста(ПутьКФайлу, "Windows-1251", , Ложь);
		Запись.Закрыть();
		Запись = Неопределено;
		Запись = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8", , Истина, Символы.ПС);
		Запись.Записать(Текст);
		Запись.Закрыть();
		Запись = Неопределено;
		Возврат "";
	Исключение
		Попытка
			Если Запись <> Неопределено Тогда
				Запись.Закрыть();
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

// Читает журнал регистрации базы менеджера тестирования (та база, где запущена VA).
// Алгоритм повторяет обработку расширения VAExtension_ЖурналРегистрации: общей библиотеки
// для менеджера и клиента нет, поэтому чтение продублировано.
&НаСервереБезКонтекста
Функция MCPДанныеЖурналаРегистрацииМенеджера(Параметры) Экспорт
	
	ЭтоАнглийскийВариант = MCPЭтоАнглийскийВариантЖурналаРегистрацииСервер();
	ИменаКолонок = MCPИменаКолонокЖурналаРегистрацииСервер(ЭтоАнглийскийВариант);
	
	ПроверкиОтбора = Новый Структура;
	ПроверкиОтбора.Вставить("СистемныеИменаСобытий", Новый Массив);
	ПроверкиОтбора.Вставить("ЗначенияСобытий", Новый Массив);
	ПроверкиОтбора.Вставить("ВидСравненияСобытий", Параметры.ВидСравненияСобытия);
	ПроверкиОтбора.Вставить("ЗначениеКомментария", "");
	ПроверкиОтбора.Вставить("ВидСравненияКомментария", Параметры.ВидСравненияКомментария);
	
	Предупреждения = Новый Массив;
	Отбор = MCPОтборЖурналаРегистрацииСервер(Параметры, ПроверкиОтбора);
	КолонкиЧтения = MCPКолонкиЧтенияЖурналаРегистрацииСервер(Параметры, ПроверкиОтбора, ИменаКолонок);
	СтрокаКолонокЧтения = MCPСтрокаКолонокЧтенияЖурналаРегистрацииСервер(КолонкиЧтения);
	
	Счётчики = Новый Структура;
	Счётчики.Вставить("ПрочитаноПлатформой", 0);
	Счётчики.Вставить("ОбрезаноЗначенийДанных", 0);
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("ДатаСортировки", Новый ОписаниеТипов("Дата"));
	Для Каждого ЛогическоеИмя Из Параметры.Колонки Цикл
		ТаблицаРезультата.Колонки.Добавить(ЛогическоеИмя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	КешПользователей = Новый Соответствие;
	
	ЕстьПостфильтры = (ПроверкиОтбора.ЗначенияСобытий.Количество() > 0)
		ИЛИ (ПроверкиОтбора.ЗначениеКомментария <> "");
	
	Лимит = Параметры.Лимит;
	Бюджет = Параметры.БюджетСканирования;
	
	Порция = ?(ЕстьПостфильтры, 500, Лимит);
	Если Порция > Бюджет Тогда
		Порция = Бюджет;
	КонецЕсли;
	Если Порция < 1 Тогда
		Порция = 1;
	КонецЕсли;
	
	Курсор = Параметры.ДатаОкончания;
	ПериодИсчерпан = Ложь;
	БюджетОбрезалЧтение = Ложь;
	ЛимитДостигнут = Ложь;
	СекундаРазрыва = Неопределено;
	КурсорПредыдущейПорции = Неопределено;
	РазмерПредыдущейПорции = 0;
	
	Пока Счётчики.ПрочитаноПлатформой < Бюджет Цикл
		
		ОстатокБюджета = Бюджет - Счётчики.ПрочитаноПлатформой;
		Запрос = ?(Порция < ОстатокБюджета, Порция, ОстатокБюджета);
		Если Запрос < 1 Тогда
			Прервать;
		КонецЕсли;
		
		Отбор.ДатаОкончания = Курсор;
		ТаблицаПорции = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(ТаблицаПорции, Отбор, СтрокаКолонокЧтения, , Запрос);
		
		// Повторное чтение диапазона с большим окном возвращает прежние строки и добавляет более старые.
		// Уже обработанные строки пропускаем; с какой стороны они в таблице, определяем по датам краёв.
		ПропуститьСтрок = 0;
		ПропускВКонце = Ложь;
		Если КурсорПредыдущейПорции <> Неопределено И КурсорПредыдущейПорции = Курсор Тогда
			ПропуститьСтрок = ?(РазмерПредыдущейПорции < ТаблицаПорции.Количество(), РазмерПредыдущейПорции, ТаблицаПорции.Количество());
			ПропускВКонце = MCPПорядокПоВозрастаниюЖурналаРегистрацииСервер(ТаблицаПорции, ИменаКолонок);
		КонецЕсли;
		Счётчики.ПрочитаноПлатформой = Счётчики.ПрочитаноПлатформой + ТаблицаПорции.Количество() - ПропуститьСтрок;
		MCPДобавитьПодходящиеСтрокиЖурналаРегистрацииСервер(Параметры, ПроверкиОтбора, ИменаКолонок, КолонкиЧтения,
			ТаблицаПорции, ПропуститьСтрок, ПропускВКонце, ТаблицаРезультата, КешПользователей, Счётчики);
		КурсорПредыдущейПорции = Курсор;
		РазмерПредыдущейПорции = ТаблицаПорции.Количество();
		
		Если ТаблицаПорции.Количество() < Запрос Тогда
			// Прочитан весь диапазон [ДатаНачала, Курсор]: более старых событий с таким отбором нет.
			ПериодИсчерпан = Истина;
			Прервать;
		КонецЕсли;
		
		Если ТаблицаРезультата.Количество() >= Лимит Тогда
			ЛимитДостигнут = Истина;
			Прервать;
		КонецЕсли;
		
		Если Порция < ОстатокБюджета Тогда
			// Окно чтения заполнено: расширяем его, чтобы заглянуть глубже в прошлое.
			Порция = Порция * 2;
			Если Порция > ОстатокБюджета Тогда
				Порция = ОстатокБюджета;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		// Расширять окно некуда: сдвигаем конец периода на секунду назад.
		// Часть событий самой старой секунды окна могла не попасть в выборку — сообщаем об этом.
		МинимальнаяДатаПорции = MCPМинимальнаяДатаТаблицыЖурналаРегистрацииСервер(ТаблицаПорции, ИменаКолонок);
		Если МинимальнаяДатаПорции = Неопределено ИЛИ МинимальнаяДатаПорции <= Параметры.ДатаНачала Тогда
			ПериодИсчерпан = Истина;
			Прервать;
		КонецЕсли;
		БюджетОбрезалЧтение = Истина;
		СекундаРазрыва = МинимальнаяДатаПорции;
		Курсор = МинимальнаяДатаПорции - 1;
		
	КонецЦикла;
	
	Если ЛимитДостигнут ИЛИ ПериодИсчерпан Тогда
		БюджетОбрезалЧтение = Ложь;
	КонецЕсли;
	Если БюджетОбрезалЧтение Тогда
		Предупреждения.Добавить(
			"Бюджет сканирования (" + Формат(Бюджет, "ЧГ=0") + ") израсходован, в периоде есть ещё события: более старые события не прочитаны. "
			+ "Увеличьте scan_limit или сузьте период и отбор.");
	КонецЕсли;
	Если СекундаРазрыва <> Неопределено Тогда
		Предупреждения.Добавить("Часть событий секунды " + Формат(СекундаРазрыва, "ДЛФ=DT")
			+ " могла не попасть в выборку: конец периода чтения сдвигался на секунду назад.");
	КонецЕсли;
	
	ТаблицаРезультата.Сортировать("ДатаСортировки Убыв");
	Показано = ТаблицаРезультата.Количество();
	Если Показано > Лимит Тогда
		Показано = Лимит;
	КонецЕсли;
	
	СтрокиРезультата = Новый Массив;
	Для Инд = 0 По Показано - 1 Цикл
		ИндексВТаблице = ?(Параметры.ПорядокВывода = "asc", Показано - 1 - Инд, Инд);
		СтрокаТаблицы = ТаблицаРезультата[ИндексВТаблице];
		СтрокаРезультата = Новый Структура;
		Для Каждого ЛогическоеИмя Из Параметры.Колонки Цикл
			СтрокаРезультата.Вставить(ЛогическоеИмя, СтрокаТаблицы[ЛогическоеИмя]);
		КонецЦикла;
		СтрокиРезультата.Добавить(СтрокаРезультата);
	КонецЦикла;
	
	МинимальнаяДатаСтроки = "";
	Если Показано > 0 Тогда
		МинимальнаяДатаСтроки = Формат(ТаблицаРезультата[Показано - 1].ДатаСортировки, "ДЛФ=DT");
	КонецЕсли;
	
	СчётчикиРезультата = Новый Структура;
	СчётчикиРезультата.Вставить("ПрочитаноПлатформой", Счётчики.ПрочитаноПлатформой);
	СчётчикиРезультата.Вставить("ОтобраноПослеФильтра", ТаблицаРезультата.Количество());
	СчётчикиРезультата.Вставить("Показано", Показано);
	СчётчикиРезультата.Вставить("ЛимитДостигнут", ТаблицаРезультата.Количество() > Показано ИЛИ ЛимитДостигнут);
	СчётчикиРезультата.Вставить("БюджетСканированияДостигнут", БюджетОбрезалЧтение);
	СчётчикиРезультата.Вставить("МинДатаСтроки", МинимальнаяДатаСтроки);
	СчётчикиРезультата.Вставить("ЯзыкЖурналаРегистрации", ?(ЭтоАнглийскийВариант, "en", "ru"));
	СчётчикиРезультата.Вставить("ОбрезаноЗначенийДанных", Счётчики.ОбрезаноЗначенийДанных);
	
	ПараметрыРезультата = Новый Структура;
	ПараметрыРезультата.Вставить("ДатаНачала", Формат(Параметры.ДатаНачала, "ДЛФ=DT"));
	ПараметрыРезультата.Вставить("ДатаОкончания", Формат(Параметры.ДатаОкончания, "ДЛФ=DT"));
	ПараметрыРезультата.Вставить("Колонки", Параметры.Колонки);
	ПараметрыРезультата.Вставить("Лимит", Лимит);
	ПараметрыРезультата.Вставить("БюджетСканирования", Бюджет);
	ПараметрыРезультата.Вставить("ПорядокВывода", Параметры.ПорядокВывода);
	
	Результат = Новый Структура;
	Результат.Вставить("Строки", СтрокиРезультата);
	Результат.Вставить("Счётчики", СчётчикиРезультата);
	Результат.Вставить("Предупреждения", Предупреждения);
	Результат.Вставить("Параметры", ПараметрыРезультата);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
