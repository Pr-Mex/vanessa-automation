Функция MCPСтрокиСостоянияВкладок(Состояние) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("## Вкладки редактора"));

	Если MCPБезопасноеСвойство(Состояние, "editorStateAvailable") <> Истина Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Состояние вкладок редактора недоступно."));
		ТекстОшибки = MCPБезопасноеСвойство(Состояние, "editorStateError");
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Строки.Добавить("- " + Ванесса.Локализовать("Ошибка:") + " " + MCPЭкранироватьMarkdownМногострочный(MCPПредставлениеЗначенияДляMarkdown(ТекстОшибки), Ложь));
		КонецЕсли;
		Возврат Строки;
	КонецЕсли;

	ТекстОшибки = MCPБезопасноеСвойство(Состояние, "editorStateError");
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Предупреждение:") + " " + MCPЭкранироватьMarkdownМногострочный(MCPПредставлениеЗначенияДляMarkdown(ТекстОшибки), Ложь));
	КонецЕсли;
	АктивнаяВкладкаИзменилась = MCPБезопасноеСвойство(Состояние, "activeTabChanged") = Истина;
	Строки.Добавить("- " + Ванесса.Локализовать("Активная вкладка изменилась:") + " " + MCPПредставлениеЗначенияДляMarkdown(АктивнаяВкладкаИзменилась));
	Строки.Добавить("- " + Ванесса.Локализовать("Было:") + " " + MCPИмяВкладкиДляMarkdown(
		MCPБезопасноеСвойство(Состояние, "previousActiveTab"),
		MCPБезопасноеСвойство(Состояние, "previousActiveTabTitle"),
		MCPБезопасноеСвойство(Состояние, "previousActiveTabType")));
	Строки.Добавить("- " + Ванесса.Локализовать("Стало:") + " " + MCPИмяВкладкиДляMarkdown(
		MCPБезопасноеСвойство(Состояние, "currentActiveTab"),
		MCPБезопасноеСвойство(Состояние, "currentActiveTabTitle"),
		MCPБезопасноеСвойство(Состояние, "currentActiveTabType")));
	Строки.Добавить("- " + Ванесса.Локализовать("Проверяемый файл активен:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Состояние, "checkedFileIsActive")));
	Строки.Добавить("- " + Ванесса.Локализовать("Файл был открыт до проверки:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Состояние, "fileWasAlreadyOpen")));
	Строки.Добавить("- " + Ванесса.Локализовать("Новая edit-вкладка проверяемого файла:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Состояние, "newTabOpened")));
	Если MCPБезопасноеСвойство(Состояние, "duplicateTabSuspected") = Истина Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("ВНИМАНИЕ: возможно, открыта вторая edit-вкладка того же файла (различается написание пути)."));
	КонецЕсли;
	ТекущийФайлФич = MCPБезопасноеСвойство(Состояние, "currentFeatureFile");
	Если НЕ ЗначениеЗаполнено(ТекущийФайлФич) Тогда
		ТекущийФайлФич = Ванесса.Локализовать("не указано");
	КонецЕсли;
	Строки.Добавить("- " + Ванесса.Локализовать("Текущий файл фич:") + " " + MCPПредставлениеЗначенияДляMarkdown(ТекущийФайлФич));
	Строки.Добавить("- " + Ванесса.Локализовать("Каталог совпадает с проверяемым файлом:") + " " + MCPПредставлениеЗначенияДляMarkdown(MCPБезопасноеСвойство(Состояние, "catalogMatchesCheckedFile")));
	Возврат Строки;

КонецФункции

