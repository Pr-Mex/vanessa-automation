&НаКлиенте
Функция MCPИмяВкладкиДляMarkdown(ИмяФайла, Заголовок, Вид) Экспорт

	Имя = "";
	Если ИмяФайла <> Неопределено Тогда
		Имя = СокрЛП(Строка(ИмяФайла));
	КонецЕсли;
	ЗаголовокВкладки = "";
	Если Заголовок <> Неопределено Тогда
		ЗаголовокВкладки = СокрЛП(Строка(Заголовок));
	КонецЕсли;
	ВидВкладки = "";
	Если Вид <> Неопределено Тогда
		ВидВкладки = СокрЛП(Строка(Вид));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ванесса.Локализовать("нет активной вкладки");
	КонецЕсли;
	Представление = Имя;
	Если Найти(НРег(Имя), "memory:") = 1 И ЗначениеЗаполнено(ЗаголовокВкладки) Тогда
		Представление = ЗаголовокВкладки + " (" + Имя + ")";
	КонецЕсли;
	Если ВидВкладки = "diff" Тогда
		Представление = Представление + " (diff)";
	КонецЕсли;
	Возврат Представление;

