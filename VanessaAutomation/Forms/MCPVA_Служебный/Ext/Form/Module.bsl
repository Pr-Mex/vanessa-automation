// Хендлер инструмента get_event_log_manager: читает журнал регистрации базы менеджера тестирования.
&НаКлиенте
Функция ПолучитьЖурналРегистрацииМенеджера(Запрос, ДополнительныеПараметры) Экспорт
	
	ТекстОшибки = "";
	ПараметрыЖР = MCPПараметрыЖурналаРегистрацииИзЗапроса(Запрос, ТекстОшибки);
	Если ПараметрыЖР = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
	КонецЕсли;
	
	Попытка
		Данные = MCPДанныеЖурналаРегистрацииМенеджера(ПараметрыЖР);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPОформитьОшибку(
				Ванесса.Локализовать("Не удалось прочитать журнал регистрации базы менеджера тестирования."),
				Ванесса.Локализовать("Проверьте корректность параметров отбора (полное имя объекта метаданных, ссылка в data, уровень, статус транзакции) и право ЖурналРегистрации (EventLog) у пользователя, от имени которого запущена Vanessa Automation."),
				ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки())));
	КонецПопытки;
	
	Возврат MCPОтветЖурналаРегистрации(Данные, ПараметрыЖР, "get_event_log_manager",
		Ванесса.Локализовать("база менеджера тестирования"));
	
КонецФункции

// Хендлер инструмента get_event_log_test_client: читает журнал регистрации базы клиента тестирования.
&НаКлиенте
Функция ПолучитьЖурналРегистрацииКлиентаТестирования(Запрос, ДополнительныеПараметры) Экспорт
	
	ТекстОшибки = "";
	ПараметрыЖР = MCPПараметрыЖурналаРегистрацииИзЗапроса(Запрос, ТекстОшибки);
	Если ПараметрыЖР = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибки);
	КонецЕсли;
	
	Попытка
		Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.")
			+ " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	Данные = MCPДанныеЖурналаРегистрацииКлиентаТестирования(ПараметрыЖР, ТекстОшибки);
	Если Данные = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	Возврат MCPОтветЖурналаРегистрации(Данные, ПараметрыЖР, "get_event_log_test_client",
		Ванесса.Локализовать("база клиента тестирования"));
	
КонецФункции

// Разбирает и проверяет параметры инструментов чтения ЖР. Возвращает структуру параметров
// или Неопределено; при ошибке заполняет ТекстОшибки.
&НаКлиенте
Функция MCPПараметрыЖурналаРегистрацииИзЗапроса(Запрос, ТекстОшибки) Экспорт
	
	ТекстОшибки = "";
	ПараметрыЖР = Новый Структура;
	
	ДатаНачала = ЗначениеПараметраИзЗапроса(Запрос, "date_start");
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачалаРазобранная = MCPДатаИзСтрокиПериода(ДатаНачала, Ложь);
		Если ДатаНачалаРазобранная = Неопределено Тогда
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось преобразовать строку <%1> в дату начала периода."), Строка(ДатаНачала)),
				Ванесса.Локализовать("Форматы даты: ""ДД.ММ.ГГГГ"", ""ДД.ММ.ГГГГ чч:мм:сс"", ""ГГГГ-ММ-ДД"", ""ГГГГ-ММ-ДД чч:мм:сс"". Пример: date_start=01.06.2024 10:00:00"));
			Возврат Неопределено;
		КонецЕсли;
		ПараметрыЖР.Вставить("ДатаНачала", ДатаНачалаРазобранная);
	КонецЕсли;
	
	ДатаОкончания = ЗначениеПараметраИзЗапроса(Запрос, "date_end");
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончанияРазобранная = MCPДатаИзСтрокиПериода(ДатаОкончания, Истина);
		Если ДатаОкончанияРазобранная = Неопределено Тогда
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось преобразовать строку <%1> в дату окончания периода."), Строка(ДатаОкончания)),
				Ванесса.Локализовать("Форматы даты: ""ДД.ММ.ГГГГ"", ""ДД.ММ.ГГГГ чч:мм:сс"", ""ГГГГ-ММ-ДД"", ""ГГГГ-ММ-ДД чч:мм:сс"". Если время не указано, берётся конец дня (23:59:59)."));
			Возврат Неопределено;
		КонецЕсли;
		ПараметрыЖР.Вставить("ДатаОкончания", ДатаОкончанияРазобранная);
	КонецЕсли;
	
	ПараметрыЖР.Вставить("Событие", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "event")));
	
	ВидСравненияСобытия = НРег(MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "event_match_type")));
	Если ВидСравненияСобытия = "" Тогда
		ВидСравненияСобытия = "exact";
	КонецЕсли;
	Если ВидСравненияСобытия <> "exact" И ВидСравненияСобытия <> "partial" И ВидСравненияСобытия <> "starts_with" Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Недопустимое значение параметра event_match_type: ""%1""."), ВидСравненияСобытия),
			Ванесса.Локализовать("Допустимые значения: ""exact"", ""partial"", ""starts_with""."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("ВидСравненияСобытия", ВидСравненияСобытия);
	
	ПараметрыЖР.Вставить("Комментарий", MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "comment")));
	
	ВидСравненияКомментария = НРег(MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "comment_match_type")));
	Если ВидСравненияКомментария = "" Тогда
		ВидСравненияКомментария = "exact";
	КонецЕсли;
	Если ВидСравненияКомментария <> "exact" И ВидСравненияКомментария <> "partial" И ВидСравненияКомментария <> "starts_with" Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Недопустимое значение параметра comment_match_type: ""%1""."), ВидСравненияКомментария),
			Ванесса.Локализовать("Допустимые значения: ""exact"", ""partial"", ""starts_with""."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("ВидСравненияКомментария", ВидСравненияКомментария);
	
	Уровни = MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "level"));
	Для Каждого ИмяУровня Из Уровни Цикл
		Если НЕ MCPЭтоИзвестныйУровеньЖурналаРегистрации(ИмяУровня) Тогда
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Неизвестный уровень журнала регистрации: ""%1""."), ИмяУровня),
				Ванесса.Локализовать("Допустимые значения: Информация, Ошибка, Предупреждение, Примечание (Information, Error, Warning, Note)."));
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	ПараметрыЖР.Вставить("Уровень", Уровни);
	
	СтатусыТранзакций = MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "transaction_status"));
	Для Каждого ИмяСтатуса Из СтатусыТранзакций Цикл
		Если НЕ MCPЭтоИзвестныйСтатусТранзакцииЖурналаРегистрации(ИмяСтатуса) Тогда
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Неизвестный статус транзакции: ""%1""."), ИмяСтатуса),
				Ванесса.Локализовать("Допустимые значения: Зафиксирована, Отменена, НеЗавершена, НетТранзакции (Committed, RolledBack, Unfinished, NotApplicable)."));
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	ПараметрыЖР.Вставить("СтатусТранзакции", СтатусыТранзакций);
	
	ПараметрыЖР.Вставить("Пользователь", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "user")));
	ПараметрыЖР.Вставить("Компьютер", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "computer")));
	ПараметрыЖР.Вставить("ИмяПриложения", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "application")));
	ПараметрыЖР.Вставить("Метаданные", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "metadata")));
	ПараметрыЖР.Вставить("РабочийСервер", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "server")));
	ПараметрыЖР.Вставить("Транзакция", MCPСписокСтрокЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "transaction")));
	
	ЧислаСеанс = MCPЧислаИзСпискаЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "session"), "session", ТекстОшибки);
	Если ЧислаСеанс = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("Сеанс", ЧислаСеанс);
	
	ЧислаПортов = MCPЧислаИзСпискаЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "port"), "port", ТекстОшибки);
	Если ЧислаПортов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("ОсновнойIPПорт", ЧислаПортов);
	
	ЧислаВспомогательныхПортов = MCPЧислаИзСпискаЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "sync_port"), "sync_port", ТекстОшибки);
	Если ЧислаВспомогательныхПортов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("ВспомогательныйIPПорт", ЧислаВспомогательныхПортов);
	
	ПараметрыЖР.Вставить("Данные", MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "data")));
	ПараметрыЖР.Вставить("ПредставлениеДанных", MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "data_presentation")));
	
	Лимит = 100;
	ЗначениеЛимита = MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "limit"));
	Если ЗначениеЛимита <> "" Тогда
		Попытка
			Лимит = Цел(Число(ЗначениеЛимита));
		Исключение
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр limit должен быть числом, получено ""%1""."), ЗначениеЛимита));
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Лимит < 1 ИЛИ Лимит > 1000 Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр limit вне допустимого диапазона: %1."), Формат(Лимит, "ЧГ=0; ЧН=0")),
			Ванесса.Локализовать("Допустимый диапазон: от 1 до 1000. Значение 0 недопустимо."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("Лимит", Лимит);
	
	БюджетСканирования = 1000;
	ЗначениеБюджета = MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "scan_limit"));
	Если ЗначениеБюджета <> "" Тогда
		Попытка
			БюджетСканирования = Цел(Число(ЗначениеБюджета));
		Исключение
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр scan_limit должен быть числом, получено ""%1""."), ЗначениеБюджета));
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если БюджетСканирования < 1 ИЛИ БюджетСканирования > 20000 Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр scan_limit вне допустимого диапазона: %1."), Формат(БюджетСканирования, "ЧГ=0; ЧН=0")),
			Ванесса.Локализовать("Допустимый диапазон: от 1 до 20000."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("БюджетСканирования", БюджетСканирования);
	
	ПорядокВывода = НРег(MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "display_order")));
	Если ПорядокВывода = "" Тогда
		ПорядокВывода = "desc";
	КонецЕсли;
	Если ПорядокВывода <> "desc" И ПорядокВывода <> "asc" Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Недопустимое значение параметра display_order: ""%1""."), ПорядокВывода),
			Ванесса.Локализовать("Допустимые значения: ""desc"" (по умолчанию), ""asc""."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("ПорядокВывода", ПорядокВывода);
	
	Колонки = MCPКолонкиЖурналаРегистрацииИзСтроки(ЗначениеПараметраИзЗапроса(Запрос, "columns"), ТекстОшибки);
	Если Колонки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("Колонки", Колонки);
	
	МаксимальнаяДлинаДанных = 300;
	ЗначениеДлины = MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "data_max_length"));
	Если ЗначениеДлины <> "" Тогда
		Попытка
			МаксимальнаяДлинаДанных = Цел(Число(ЗначениеДлины));
		Исключение
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Параметр data_max_length должен быть числом, получено ""%1""."), ЗначениеДлины));
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если МаксимальнаяДлинаДанных < 0 Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.Локализовать("Параметр data_max_length не может быть отрицательным."),
			Ванесса.Локализовать("Укажите 0 для вывода значения без обрезки."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("МаксимальнаяДлинаДанных", МаксимальнаяДлинаДанных);
	
	ПараметрыЖР.Вставить("ПутьФайлаВывода", MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "output_file")));
	
	ФорматВывода = НРег(MCPСтрокаПараметраЖурналаРегистрации(ЗначениеПараметраИзЗапроса(Запрос, "output_format")));
	Если ФорматВывода = "" Тогда
		ФорматВывода = "markdown";
	КонецЕсли;
	Если ФорматВывода <> "markdown" И ФорматВывода <> "json" Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Недопустимое значение параметра output_format: ""%1""."), ФорматВывода),
			Ванесса.Локализовать("Допустимые значения: ""markdown"" (по умолчанию), ""json""."));
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыЖР.Вставить("ФорматВывода", ФорматВывода);
	
	Если ФорматВывода = "json" И ПараметрыЖР.ПутьФайлаВывода = "" Тогда
		ТекстОшибки = MCPОформитьОшибку(
			Ванесса.Локализовать("Формат json требует параметр output_file."),
			Ванесса.Локализовать("Укажите output_file - путь к файлу на компьютере, где работает Vanessa Automation, либо используйте output_format=markdown."));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПараметрыЖР;
	
КонецФункции

// Строковое значение параметра запроса: Неопределено и Null дают пустую строку,
// иначе они превратились бы в отбор по литералам "Неопределено"/"Null".
&НаКлиенте
Функция MCPСтрокаПараметраЖурналаРегистрации(Значение)
	
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

&НаКлиенте
Функция MCPСписокСтрокЖурналаРегистрации(Значение)
	
	Результат = Новый Массив;
	Текст = MCPСтрокаПараметраЖурналаРегистрации(Значение);
	Если Текст = "" Тогда
		Возврат Результат;
	КонецЕсли;
	Части = Ванесса._СтрРазделить(Текст, "|", Истина);
	Для Каждого Часть Из Части Цикл
		Токен = СокрЛП(Часть);
		Если Токен <> "" Тогда
			Результат.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPЧислаИзСпискаЖурналаРегистрации(Значение, ИмяПараметра, ТекстОшибки)
	
	Результат = Новый Массив;
	Текст = MCPСтрокаПараметраЖурналаРегистрации(Значение);
	Если Текст = "" Тогда
		Возврат Результат;
	КонецЕсли;
	Части = Ванесса._СтрРазделить(Текст, "|", Истина);
	Для Каждого Часть Из Части Цикл
		Токен = СокрЛП(Часть);
		Если Токен = "" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Результат.Добавить(Цел(Число(Токен)));
		Исключение
			ТекстОшибки = MCPОформитьОшибку(
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Значение <%1> параметра %2 должно быть числом."), Токен, ИмяПараметра));
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPВсеКолонкиЖурналаРегистрации()
	
