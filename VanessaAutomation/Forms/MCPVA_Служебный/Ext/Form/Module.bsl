&НаКлиенте
Функция ПолучитьСтрокуДляПоискаШагаПоСнипету(Снипет) Экспорт
	
	Поз = Найти(Снипет, "(");
	Если Поз > 0 Тогда
		Возврат НРег(Лев(Снипет, Поз - 1));
	КонецЕсли;
	
	Возврат НРег(Снипет);
	
КонецФункции

// Универсальный инструмент для управления записью действий пользователя
&НаКлиенте
Функция ЗаписьДействийПользователя(Запрос, ДополнительныеПараметры) Экспорт
	
	Идентификатор = Запрос.Идентификатор;
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
	
	// Получаем параметр action (по умолчанию 'start')
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Действие = "start";
	Иначе
		Действие = НРег(СокрЛП(Действие));
	КонецЕсли;
	
	// Проверка допустимого значения
	Если Действие <> "start" И Действие <> "stop" Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение action. Допустимые значения: 'start' (начать запись), 'stop' (остановить запись и получить шаги).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	Если Действие = "start" Тогда
		// Начинаем запись действий пользователя
		Попытка
			Ванесса.НачатьЗаписьДействийПользователяЭкспорт();
			Возврат Ванесса.Локализовать("# Запись действий начата
			|
			|- Статус: запись включена
			|
			|## Следующие шаги
			|- Выполните действия пользователя в клиенте тестирования
			|- Вызовите user_actions_recording с action='stop' для получения шагов");
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка начала записи действий:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	ИначеЕсли Действие = "stop" Тогда
		// Останавливаем запись и получаем шаги в формате Turbo Gherkin
		Попытка
			Ванесса.ЗавершитьЗаписьДействийПользователяЭкспорт();
			ТекстСценария = Ванесса.Объект.СгенерированныйСценарий;
			
			Если ЗначениеЗаполнено(ТекстСценария) Тогда
				Возврат "# Запись действий остановлена
				|
				|- Статус: запись выключена
				|
				|## Записанные шаги (Turbo Gherkin)
				|```gherkin
				|" + ТекстСценария + "
				|```";
			Иначе
				Возврат Ванесса.Локализовать("# Запись действий остановлена
				|
				|- Статус: запись выключена
				|
				|- Записанные шаги: не обнаружено действий за время записи");
			КонецЕсли;
		Исключение
			ТекстОшибки = Ванесса.Локализовать("Ошибка остановки записи действий:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки) Экспорт
	
	Если Ванесса.Объект.ИспользоватьРедакторVanessaEditor Тогда
		// Значит в редакторе должен быть открыт фича файл
		Если НЕ Ванесса.ЭтоВкладкаEdit(Ванесса.VanessaTabs.current) Тогда
			// Значит файл не открыт
			ТекстТекстОшибки = Ванесса.Локализовать("Нельзя перезагрузить текущий фича файл, т.к. в редакторе нет открытого файла.");
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Ванесса.Объект.КаталогФич;
		
КонецФункции

&НаКлиенте
Процедура СделатьШагФичиТекущим(НомерСтроки, Идентификатор, ТекстОшибки) Экспорт
	СтрокаДерева = Ванесса.СтрокаДереваПоНомеруСтрокиФичи(НомерСтроки);
	Если СтрокаДерева = Неопределено Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В строке №%1 нет шага, который можно выполнить."), XMLСтрока(НомерСтроки));
		Возврат;
	КонецЕсли;
	
	Если СтрокаДерева.Тип <> "Шаг" Тогда
		ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В строке №%1 нет шага, который можно выполнить. В этой строке обнаружен тип строки: %2"), XMLСтрока(НомерСтроки), СтрокаДерева.Тип);
		Возврат;
	КонецЕсли;	
	
	Ванесса.МодульРедакторТекста().АктивизироватьСтрокуРедактораПоИдСтрокиИНомеруСтрокиФичи(СтрокаДерева.ИдСтроки, НомерСтроки);
	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
КонецПроцедуры

&НаСервере
Функция ДвоичныеДанныеГолосСервер() Экспорт
	ОбъектСервер = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектСервер.ПолучитьМакет("ОзвучкаОповещенияMCP");
КонецФункции

// Закрывает клиент тестирования по имени профиля
&НаКлиенте
Функция ЗакрытьКлиентТестирования(Запрос, ДополнительныеПараметры) Экспорт
	
	// Получаем параметр profileName (необязательный)
	ИмяПрофиля = Строка(ЗначениеПараметраИзЗапроса(Запрос, "profileName"));
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключен. Нечего закрывать.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Определяем какой профиль закрывать
	Если НЕ ЗначениеЗаполнено(ИмяПрофиля) Тогда
		// Закрываем текущий подключенный профиль
		ТекущиеДанные = Ванесса.ТекущиеДанныеКлиентаТестирования();
		Если ТекущиеДанные = Неопределено Тогда
			Возврат Ванесса.Локализовать("# Клиент тестирования не был подключен
			|
			|- Статус: не подключен
			|
			|Клиент тестирования не был подключен, поэтому закрывать нечего.");
		КонецЕсли;
		ИмяПрофиля = ТекущиеДанные.Имя;
	КонецЕсли;
	
	// Ищем профиль в таблице
	НайденныйПрофиль = Ванесса.ПолучитьСвойстваПодключенногоTestClient(ИмяПрофиля);
	
	Если НайденныйПрофиль = Неопределено Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не найдено подключенного клиента тестирования с именем профиля '%1'."), ИмяПрофиля);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Закрываем окно клиента тестирования
	Попытка
		ТекстОшибки = Неопределено;
		// PID берём по имени закрываемого профиля, а не у текущего подключенного профиля:
		// закрываемый профиль может не быть активным, и тогда ожидали бы завершения чужого процесса
		ДанныеЗакрываемогоПрофиля = Ванесса.ПолучитьДанныеКлиентаТестирования(НайденныйПрофиль.Имя);
		PID = ДанныеЗакрываемогоПрофиля.PIDКлиентаТестирования;
		Ванесса.ЯЗакрываюTestClient(НайденныйПрофиль.Имя, ТекстОшибки);
		
		Если ТекстОшибки <> Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		// Ожидание, что процесс завершился. У web-клиента PID не определяется, ожидать нечего
		ПроцессСуществует = Ложь;
		Если PID > 0 Тогда
			Для Сч = 1 По 100 Цикл
				ПроцессСуществует = Ванесса.ПроцессОССуществует(PID);
				Если НЕ ПроцессСуществует Тогда
					Прервать;
				КонецЕсли;
				Ванесса.sleep(1);
			КонецЦикла;
		КонецЕсли;
		
		Если ПроцессСуществует Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"Процесс клиента тестирования (PID: %1) не завершился после закрытия профиля '%2'. Возможно, потребуется завершить его вручную."),
				PID, ИмяПрофиля);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
		КонецЕсли;
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"# Клиент тестирования закрыт
			|
			|- Профиль: %1
			|- Статус: закрыт успешно
			|
			|## Следующие шаги
			|- Используйте `manage_test_client` с `action: connect` для повторного подключения"),
			ИмяПрофиля);
		Возврат ТекстОтвета;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка закрытия клиента тестирования:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПреобразоватьПроблемыПроверкиСинтаксиса(Проблемы) Экспорт
	МассивПроблем = Новый Массив;
	Попытка
		Если Проблемы <> Неопределено Тогда
			Для Каждого Проблема Из Проблемы Цикл
				ПроблемаJSON = Новый Структура;
				Если ТипЗнч(Проблема) = Тип("Структура") Тогда
					ПроблемаJSON.Вставить("line", MCPБезопасноеСвойство(Проблема, "НомерСтроки"));
					ПроблемаJSON.Вставить("message", MCPБезопасноеСвойство(Проблема, "Текст"));
					ПроблемаJSON.Вставить("file", MCPБезопасноеСвойство(Проблема, "ИмяФайлаФичи"));
				ИначеЕсли ТипЗнч(Проблема) = Тип("Соответствие") Тогда
					ЗначениеСтроки = Проблема["НомерСтроки"];
					Если ЗначениеСтроки = Неопределено Тогда
						ЗначениеСтроки = Проблема["line"];
					КонецЕсли;
					ПроблемаJSON.Вставить("line", ЗначениеСтроки);
					ЗначениеТекста = Проблема["Текст"];
					Если ЗначениеТекста = Неопределено Тогда
						ЗначениеТекста = Проблема["message"];
					КонецЕсли;
					ПроблемаJSON.Вставить("message", ЗначениеТекста);
					ПроблемаJSON.Вставить("file", Проблема["ИмяФайлаФичи"]);
				Иначе
					ПроблемаJSON.Вставить("line", Неопределено);
					ПроблемаJSON.Вставить("message", Строка(Проблема));
					ПроблемаJSON.Вставить("file", Неопределено);
				КонецЕсли;
				МассивПроблем.Добавить(ПроблемаJSON);
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат МассивПроблем;
КонецФункции

&НаКлиенте
Функция ОшибкаПроверкиСинтаксиса(Проблемы) Экспорт
	ТекстОшибки = Неопределено;
	ПутьКФайлу = ПутьКФайлуИзТекущегоФайлаВРедакторе(ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	
	МассивПроблем = ПреобразоватьПроблемыПроверкиСинтаксиса(Проблемы);
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Обнаружены ошибки проверки синтаксиса файла '%1'"), ПутьКФайлу));
	Строки.Добавить("");

	НомерПроблемы = 0;
	Для Каждого Проблема Из МассивПроблем Цикл
		НомерПроблемы = НомерПроблемы + 1;
		СтрокаПроблемы = Строка(НомерПроблемы) + ". ";
		Если Проблема["line"] <> Неопределено Тогда
			СтрокаПроблемы = СтрокаПроблемы + Ванесса.Локализовать("Строка") + " " + Строка(Проблема["line"]) + ": ";
		КонецЕсли;
		СтрокаПроблемы = СтрокаПроблемы + MCPПредставлениеЗначенияДляMarkdown(Проблема["message"]);
		Строки.Добавить(СтрокаПроблемы);
		Если ЗначениеЗаполнено(Проблема["file"]) Тогда
			Строки.Добавить("  " + Ванесса.Локализовать("Имя feature файла где возникла эта ошибка:") + " " + MCPПредставлениеЗначенияДляMarkdown(Проблема["file"]));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Процедура ОбновитьКешДанныхУпавшегоШагаИСказатьИИСнятьСкриншот(НомерСтрокиВФиче, МассивСтрок, НадоСнятьСкриншот) Экспорт
	Если КешДанныхУпавшегоШага = Неопределено Тогда
		КешДанныхУпавшегоШага = Новый Структура;
	КонецЕсли;
	
	Если НЕ КешДанныхУпавшегоШага.Свойство("НомерСтрокиУпавшегоШага") Тогда
		КешДанныхУпавшегоШага.Вставить("НомерСтрокиУпавшегоШага", НомерСтрокиВФиче);
		КешДанныхУпавшегоШага.Вставить("КоличествоПадений", 1);
	Иначе
		Если КешДанныхУпавшегоШага.НомерСтрокиУпавшегоШага = НомерСтрокиВФиче Тогда
			КешДанныхУпавшегоШага.КоличествоПадений = КешДанныхУпавшегоШага.КоличествоПадений + 1;
		Иначе	
			КешДанныхУпавшегоШага.Вставить("НомерСтрокиУпавшегоШага", НомерСтрокиВФиче);
			КешДанныхУпавшегоШага.Вставить("КоличествоПадений", 1);
		КонецЕсли;
	КонецЕсли;
	
	Если КешДанныхУпавшегоШага.КоличествоПадений >= ПорогКоличествоОшибокШагаКогдаНадоСнятьСкриншот() Тогда
		// Значит надо снять скриншот активного окна
		НадоСнятьСкриншот = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьСкриншотыОконКлиентаТестированияИОтправитьИхИИДляАнализаПослеВыполненияСценария(МассивСтрок) Экспорт
	
	КаталогДляСкриншотов = ПолучитьКаталогДляСкриншотов();
   	ФайлыСкриншотовДляАнализа = Новый Массив;
	Если КаталогДляСкриншотов <> Неопределено Тогда
		
		Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(КаталогДляСкриншотов) Тогда
			Ванесса.СоздатьКаталогКомандаСистемы(КаталогДляСкриншотов);
		КонецЕсли;
		
		// Реальная проверка подключения клиента тестирования
		Попытка
			АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Исключение
			Возврат;
		КонецПопытки;
		
		ProcessId = Ванесса.PIDТекущегоКлиентаТестирования();
		Если НЕ ЗначениеЗаполнено(ProcessId) Тогда
			Возврат;
		КонецЕсли;	
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ProcessId", ProcessId);
		Попытка
			РезультатВызова = Ванесса.ВнешняяКомпонентаДляСкриншотов.ПолучитьСписокОкон(ProcessId);
			ОкнаДляСкриншотов = ПолучитьОкнаДляСкриншотов(РезультатВызова);
		Исключение
			ОкнаДляСкриншотов = Новый Массив;
		КонецПопытки;
		Если ОкнаДляСкриншотов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого ТекОкно Из ОкнаДляСкриншотов Цикл
			Попытка
				ДвоичныеДанныеИзображения = Ванесса.ВнешняяКомпонентаДляСкриншотов.ПолучитьСнимокОкна(ТекОкно.ПолныеДанныеОкна.window);
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ЦветовойРежим", "grayscale");
				ДополнительныеПараметры.Вставить("ИмяФайла", Ванесса.ДополнитьСлешВПуть(КаталогДляСкриншотов) + XMLСтрока(ТекущаяУниверсальнаяДатаВМиллисекундах()) + ".png");
				ИмяФайла = ПолучитьФайлКартинкиИзДвоичныхДанных(ДвоичныеДанныеИзображения, ДополнительныеПараметры);
				ФайлыСкриншотовДляАнализа.Добавить(ИмяФайла);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Если ФайлыСкриншотовДляАнализа.Количество() > 0 Тогда
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить(Ванесса.Локализовать("## Чтобы понять причину ошибки прочитай файлы скриншотов клиента тестирования:"));
		Для Каждого ТекИмяФайла Из ФайлыСкриншотовДляАнализа Цикл
			МассивСтрок.Добавить("  -" + ТекИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьФайлКартинкиИзДвоичныхДанных(ДвоичныеДанныеИзображения, ДополнительныеПараметры) Экспорт
	//Обработка картинки для уменьшения размера передаваемых данных
	Картинка = Новый Картинка(ДвоичныеДанныеИзображения);
	//Картинка.Записать("c:\temp\Исходная.png");
	
	// Получаем режим обработки изображения из дополнительных параметров
	ЦветовойРежим = "grayscale"; // по умолчанию
	Если ДополнительныеПараметры.Свойство("ЦветовойРежим") Тогда
		ЦветовойРежим = ДополнительныеПараметры.ЦветовойРежим;
	КонецЕсли;
	
	ИмяФайла = ДополнительныеПараметры.ИмяФайла;
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла("png");
	КонецЕсли;
	
	Если ЦветовойРежим = "grayscale" Тогда
		ОбработаннаяКартинка = ОбработаннаяКартинкаСервер(Картинка);
		ОбработаннаяКартинка.Записать(ИмяФайла);
	Иначе	
		Картинка.Записать(ИмяФайла);
	КонецЕсли;
	
	Возврат ИмяФайла;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКаталогДляСкриншотов() Экспорт
	ПутьКФайлу = Ванесса.Объект.КаталогФич;
	
	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ПутьКФайлу) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ванесса.ЭтоКаталогКомандаСистемы(Ванесса.Объект.КаталогФич) Тогда
		Возврат Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогФич) + "png";
	Иначе
		Файл = Новый Файл(Ванесса.Объект.КаталогФич);
		Возврат Ванесса.ДополнитьСлешВПуть(Файл.Путь) + "png";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПорогКоличествоОшибокШагаКогдаНадоСнятьСкриншот() Экспорт
	Возврат 2;
КонецФункции

&НаКлиенте
Функция ДляШагаНадоВсегдаСниматьСкриншот(СтрокаУпавшегоШага) Экспорт
	НРегСтрокаРеальнойПроцедуры = НРег(СтрокаУпавшегоШага.СтрокаРеальнойПроцедуры);
	Если НРегСтрокаРеальнойПроцедуры = "втаблицеколичествострок" Тогда
		Возврат Истина;
	ИначеЕсли НРегСтрокаРеальнойПроцедуры = "втаблицеяперехожукстроке" Тогда
		Возврат Истина;
	ИначеЕсли НРегСтрокаРеальнойПроцедуры = "яждузакрытияокнавтечениесекунд" Тогда
		Возврат Истина;
	ИначеЕсли НРегСтрокаРеальнойПроцедуры = "втаблицеяперехожукследующейстроке" Тогда
		Возврат Истина;
	ИначеЕсли НРегСтрокаРеальнойПроцедуры = "втаблицеяперехожукследующейстроке" Тогда
		Возврат Истина;
	ИначеЕсли НРегСтрокаРеальнойПроцедуры = "втаблицеяперехожукпредыдущейстроке" Тогда
		Возврат Истина;
	КонецЕсли;
	
	
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ДобавитьВСообщениеОкнаДоступныеДляСкриншота(Строки, ОкнаДляСкриншотов) Экспорт
	Строки.Добавить(Ванесса.Локализовать("## Окна клиента тестирования доступные для снятия скриншота:"));
	Для Каждого ТекОкно Из ОкнаДляСкриншотов Цикл
		Если НЕ ТекОкно.ПолныеДанныеОкна.Свойство("Title") Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("  -" + ТекОкно.ПолныеДанныеОкна.Title);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область КомандныйИнтерфейсИПрочее

// Управляет клиентом тестирования: подключение / отключение.
&НаКлиенте
Функция УправлениеКлиентомТестирования(Запрос, ДополнительныеПараметры) Экспорт

	Действие = НРег(СокрЛП(Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"))));

	Если Действие = "connect" Тогда
		Возврат УправлениеКлиентомТестирования_Подключить(Запрос);
	ИначеЕсли Действие = "disconnect" Тогда
		Возврат УправлениеКлиентомТестирования_Отключить(Запрос);
	Иначе
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"Неизвестное значение параметра action: '%1'. Допустимые значения: 'connect', 'disconnect'."),
			Действие);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция УправлениеКлиентомТестирования_Подключить(Запрос) Экспорт

	ИмяПрофиля = Строка(ЗначениеПараметраИзЗапроса(Запрос, "profileName"));
	Если Не ЗначениеЗаполнено(ИмяПрофиля) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для action='connect' параметр profileName обязателен.") + Символы.ПС + Символы.ПС + MCPСписокДоступныхПрофилей();
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Попытка
		Идентификатор = Запрос.Идентификатор;
		Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
		Результат = Ванесса.ПодключитьПрофильTestClientПоИмени(ИмяПрофиля);

		Если Результат Тогда
			ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Подключение клиента тестирования
				|
				|- Статус: подключен
				|- Профиль: %1
				|
				|## Следующие шаги
				|- Получите состояние формы: `get_form_analysis`
				|- Выполните шаг: `execute_feature_step`"),
				ИмяПрофиля);
		Иначе
			ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
				"# Подключение клиента тестирования
				|
				|- Статус: не удалось подключить
				|- Профиль: %1"),
				ИмяПрофиля)
				+ Символы.ПС + Символы.ПС
				+ MCPСписокДоступныхПрофилей()
				+ Символы.ПС + Символы.ПС
				+ Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
					"## Возможные причины
					|- Профиль с именем '%1' не найден в настройках
					|- Тестовое приложение не запущено
					|- Настройки подключения некорректны"),
					ИмяПрофиля);
		КонецЕсли;

		//MCPОтправитьРезультатИнструмента(ИдентификаторЗапроса, ТекстОтвета);
		МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), ТекстОтвета);
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		Возврат Неопределено;
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка подключения клиента тестирования:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()) + Символы.ПС + Символы.ПС + MCPСписокДоступныхПрофилей();
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция УправлениеКлиентомТестирования_Отключить(Запрос) Экспорт

	Попытка
		Идентификатор = Запрос.Идентификатор;
		Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
		ТекущиеДанныеКлиентаТестирования = Ванесса.ТекущиеДанныеКлиентаТестирования();
		Если ТекущиеДанныеКлиентаТестирования = Неопределено Тогда
			ТекстСообщения = Ванесса.Локализовать("Не найдены данные клиента тестирования");
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		ИмяПрофиля = ТекущиеДанныеКлиентаТестирования.Имя;
		
		Если НЕ ТекущиеДанныеКлиентаТестирования.Подключен Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Текущий профиль клиента тестирования <%1> не подключен"), ИмяПрофиля);
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		Ванесса.РазорватьСоединениеTestClient();
		
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("# Клиент тестирования <%1> успешно отключен"), ИмяПрофиля);			
		МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), ТекстОтвета);
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		Возврат Неопределено;
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Ошибка подключения клиента тестирования:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()) + Символы.ПС + Символы.ПС + MCPСписокДоступныхПрофилей();
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Получает список расширений, установленных в базе
&НаКлиенте
Функция ПолучитьСписокРасширений(Запрос, ДополнительныеПараметры) Экспорт
	
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Попытка
		// Получаем данные расширений с сервера
		ТекстОшибки = Неопределено;
		МассивДанныхРасширений = ПолучитьДанныеРасширенийКлиент(ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;
		
		// Формируем массив строк на клиенте
		Строки = СформироватьМассивСтрокРасширений(МассивДанныхРасширений);
		
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
		
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка получения списка расширений:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Универсальный инструмент для работы с таблицей профилей клиентов тестирования
&НаКлиенте
Функция УправлениеПрофилямиКлиентовТестирования(Запрос, ДополнительныеПараметры) Экспорт
	
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: 'get_list', 'add', 'edit'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если Действие = "get_list" Тогда
		Возврат ПолучитьСписокПрофилейКлиентовТестирования();
	ИначеЕсли Действие = "add" Тогда
		Возврат ДобавитьПрофильКлиентаТестирования(Запрос);
	ИначеЕсли Действие = "edit" Тогда
		Возврат РедактироватьПрофильКлиентаТестирования(Запрос);
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Неизвестное действие:") + " " + Действие + ". " + Ванесса.Локализовать("Допустимые: 'get_list', 'add', 'edit'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
КонецФункции

// Получает список профилей клиентов тестирования
&НаКлиенте
Функция ПолучитьСписокПрофилейКлиентовТестирования() Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Список профилей клиентов тестирования"));
	Строки.Добавить("");
	
	Если Ванесса.ДанныеКлиентовТестирования.Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Профили не настроены. Добавьте профиль на вкладке 'Клиенты тестирования' в настройках VA."));
	Иначе
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Найдено профилей: %1"), Ванесса.ДанныеКлиентовТестирования.Количество()));
		Строки.Добавить("");
		Для Каждого СтрокаПрофиля Из Ванесса.ДанныеКлиентовТестирования Цикл
			Строки.Добавить(Ванесса.Локализовать("## Профиль: ") + СтрокаПрофиля.Имя);
			Строки.Добавить("");
			Строки.Добавить(Ванесса.Локализовать("| Свойство | Значение |"));
			Строки.Добавить(Ванесса.Локализовать("|----------|----------|"));
			Строки.Добавить(Ванесса.Локализовать("| Имя |") + " " + СтрокаПрофиля.Имя + " |");
			Строки.Добавить(Ванесса.Локализовать("| Синоним |") + " " + СтрокаПрофиля.Синоним + " |");
			Строки.Добавить(Ванесса.Локализовать("| Строка подключения |") + " " + СтрокаПрофиля.ПутьКИнфобазе + " |");
			Строки.Добавить(Ванесса.Локализовать("| Дополнительные параметры |") + " " + СтрокаПрофиля.ДопПараметры + " |");
			Строки.Добавить(Ванесса.Локализовать("| Тип клиента |") + " " + СтрокаПрофиля.ТипКлиента + " |");
			Строки.Добавить(Ванесса.Локализовать("| Имя компьютера |") + " " + СтрокаПрофиля.ИмяКомпьютера + " |");
			Строки.Добавить(Ванесса.Локализовать("| Дескриптор окна |") + " " + СтрокаПрофиля.ДескрипторОкна + " |");
			Строки.Добавить(Ванесса.Локализовать("| PID |") + " " + СтрокаПрофиля.PIDКлиентаТестирования + " |");
			СтатусПодключения = ?(СтрокаПрофиля.Подключен,Ванесса.Локализовать("✅ подключен"),Ванесса.Локализовать("❌ не подключен"));
			Строки.Добавить(Ванесса.Локализовать("| Статус |") + " " + СтатусПодключения + " |");
			Строки.Добавить("");
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Добавляет профиль клиента тестирования
&НаКлиенте
Функция ДобавитьПрофильКлиентаТестирования(Запрос) Экспорт
	
	ИмяПрофиля = Строка(ЗначениеПараметраИзЗапроса(Запрос, "name"));
	Если НЕ ЗначениеЗаполнено(ИмяПрофиля) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр name обязателен для добавления профиля.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем, нет ли уже профиля с таким именем
	Для Каждого СтрокаПрофиля Из Ванесса.ДанныеКлиентовТестирования Цикл
		Если НРег(СтрокаПрофиля.Имя) = НРег(ИмяПрофиля) ИЛИ НРег(СтрокаПрофиля.Синоним) = НРег(ИмяПрофиля) Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Профиль с именем '%1' уже существует."), ИмяПрофиля);
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		// Создаем новую строку в таблице профилей
		НоваяСтрока = Ванесса.ДанныеКлиентовТестирования.Добавить();
		НоваяСтрока.Имя = ИмяПрофиля;
		НоваяСтрока.Синоним = Строка(ЗначениеПараметраИзЗапроса(Запрос, "synonym"));
		НоваяСтрока.ПутьКИнфобазе = Строка(ЗначениеПараметраИзЗапроса(Запрос, "infobase_path"));
		НоваяСтрока.ДопПараметры = Строка(ЗначениеПараметраИзЗапроса(Запрос, "additional_parameters"));
		НоваяСтрока.ТипКлиента = Строка(ЗначениеПараметраИзЗапроса(Запрос, "client_type"));
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ТипКлиента) Тогда
			НоваяСтрока.ТипКлиента = "Тонкий";
		Иначе
			ДопустимыеТипыКлиента = Новый Массив;
			ДопустимыеТипыКлиента.Добавить("Тонкий");
			ДопустимыеТипыКлиента.Добавить("Толстый");
			ДопустимыеТипыКлиента.Добавить("Web");
			ДопустимыеТипыКлиента.Добавить("МобильныйКлиент");
			ДопустимыеТипыКлиента.Добавить("МобильноеПриложение");
			ДопустимыеТипыКлиента.Добавить("МобильныйКлиентАвтономный");
			ДопустимыеТипыКлиента.Добавить("ОбычноеПриложение");
			Если ДопустимыеТипыКлиента.Найти(НоваяСтрока.ТипКлиента) = Неопределено Тогда
				ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Недопустимое значение параметра client_type: '%1'. Допустимые значения: 'Тонкий', 'Толстый', 'Web', 'МобильныйКлиент', 'МобильноеПриложение', 'МобильныйКлиентАвтономный', 'ОбычноеПриложение'."),
					НоваяСтрока.ТипКлиента);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.ИмяКомпьютера = Строка(ЗначениеПараметраИзЗапроса(Запрос, "computer_name"));
		НоваяСтрока.Подключен = Ложь;
		
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"# Профиль добавлен
			|
			|- Имя: %1
			|- Синоним: %2
			|
			|## Следующие шаги
			|- Используйте `manage_test_client` с `action: connect` для подключения профиля"),
			ИмяПрофиля,
			НоваяСтрока.Синоним);
		Возврат ТекстОтвета;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка добавления профиля:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

// Редактирует профиль клиента тестирования
&НаКлиенте
Функция РедактироватьПрофильКлиентаТестирования(Запрос) Экспорт
	
	ИмяПрофиля = Строка(ЗначениеПараметраИзЗапроса(Запрос, "name"));
	Если НЕ ЗначениеЗаполнено(ИмяПрофиля) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр name обязателен для редактирования профиля.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Ищем профиль с таким именем
	НайденныйПрофиль = Неопределено;
	Для Каждого СтрокаПрофиля Из Ванесса.ДанныеКлиентовТестирования Цикл
		Если НРег(СтрокаПрофиля.Имя) = НРег(ИмяПрофиля) ИЛИ НРег(СтрокаПрофиля.Синоним) = НРег(ИмяПрофиля)  Тогда
			НайденныйПрофиль = СтрокаПрофиля;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденныйПрофиль = Неопределено Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Профиль с именем '%1' не найден."), ИмяПрофиля);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;
	
	Попытка
		// Обновляем поля профиля
		ЗначениеСиноним = ЗначениеПараметраИзЗапроса(Запрос, "synonym");
		Если ЗначениеЗаполнено(ЗначениеСиноним) Тогда
			НайденныйПрофиль.Синоним = ЗначениеСиноним;
		КонецЕсли;
		
		ЗначениеПуть = ЗначениеПараметраИзЗапроса(Запрос, "infobase_path");
		Если ЗначениеЗаполнено(ЗначениеПуть) Тогда
			НайденныйПрофиль.ПутьКИнфобазе = ЗначениеПуть;
		КонецЕсли;
		
		ЗначениеДопПараметры = ЗначениеПараметраИзЗапроса(Запрос, "additional_parameters");
		Если ЗначениеЗаполнено(ЗначениеДопПараметры) Тогда
			НайденныйПрофиль.ДопПараметры = ЗначениеДопПараметры;
		КонецЕсли;
		
		ЗначениеТипКлиента = ЗначениеПараметраИзЗапроса(Запрос, "client_type");
		Если ЗначениеЗаполнено(ЗначениеТипКлиента) Тогда
			НайденныйПрофиль.ТипКлиента = ЗначениеТипКлиента;
		КонецЕсли;
		
		ЗначениеИмяКомпьютера = ЗначениеПараметраИзЗапроса(Запрос, "computer_name");
		Если ЗначениеЗаполнено(ЗначениеИмяКомпьютера) Тогда
			НайденныйПрофиль.ИмяКомпьютера = ЗначениеИмяКомпьютера;
		КонецЕсли;
		
		ТекстОтвета = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
			"# Профиль отредактирован
			|
			|- Имя: %1
			|- Синоним: %2
			|
			|## Следующие шаги
			|- Используйте `manage_test_client` с `action: connect` для подключения профиля"),
			НайденныйПрофиль.Имя,
			НайденныйПрофиль.Синоним);
		Возврат ТекстОтвета;
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Ошибка редактирования профиля:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеРасширенийКлиент(ТекстОшибки) Экспорт
	// Нельзя получать данные по расширениям напрямую из базы менеджера тестирования, т.к. он мог долго не перезапускаться и данные (возможно) могут отличаться от данных клиента тестирования.
	Возврат ПолучитьДанныеРасширенийСПомощьюРасширенияVAExtension(ТекстОшибки);
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеРасширенийСПомощьюРасширенияVAExtension(ТекстОшибки) Экспорт
	
	Текст = "
	|Результат = Новый Массив;
	|
	|Данные = РасширенияКонфигурации.Получить();
	|Для Каждого ТекРасширение Из Данные Цикл
	|	ДанныеРасширения = Новый Структура;
	|	ДанныеРасширения.Вставить(""Имя"", ТекРасширение.Имя);
	|	ДанныеРасширения.Вставить(""Версия"", ТекРасширение.Версия);
	|	ДанныеРасширения.Вставить(""Назначение"", Строка(ТекРасширение.Назначение));
	|	ДанныеРасширения.Вставить(""ОбластьДействия"", Строка(ТекРасширение.ОбластьДействия));
	|	ДанныеРасширения.Вставить(""Активно"", ТекРасширение.Активно);
	|	ДанныеРасширения.Вставить(""БезопасныйРежим"", Строка(ТекРасширение.БезопасныйРежим));
	|	ДанныеРасширения.Вставить(""ЗащитаОтОпасныхДействий"", Строка(ТекРасширение.ЗащитаОтОпасныхДействий));
	|	
	|	Результат.Добавить(ДанныеРасширения);
	|	
	|	ЗаписьJSON = Новый ЗаписьJSON;
	|	ЗаписьJSON.УстановитьСтроку();
	|	ЗаписатьJSON(ЗаписьJSON, Результат);
	|	ЗначениеДляВозврата = ЗаписьJSON.Закрыть();
	|	
	|КонецЦикла;
	|";
	
	// Активное окно до открытия служебной формы: после её закрытия фокус возвращаем ему.
	ОкноДляВозвратаФокуса = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ВыполнитьПроизвольныйКод");
	ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ВыполнитьПроизвольныйКод.*",5);
	Если НужнаяФорма = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключен, но не найдена форма 'VAExtension_ВыполнитьПроизвольныйКод' из служебного расширения.");
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		Возврат Неопределено
	КонецЕсли;	
	
	// Поля служебной формы ищем в самой найденной форме: активным окном остаётся форма пользователя,
	// поэтому поиск «в активном окне» поля служебной формы не находит.
	ДопПараметрыПоиска = Новый Структура("КонтейнерДляПоиска", НужнаяФорма);
	РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ВыражениеВычислено", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитКодДляВыполнения = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КодДляВыполнения", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитКодДляВыполнения.ВвестиТекст(Текст);
	
	КнопкаВыполнитьКод = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьКодСервер");
	
	КнопкаЗакрытьФорму = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	КнопкаВыполнитьКод.Нажать();
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		ТекстОшибки = Ванесса.Локализовать("Не получилось выполнить код для получения списка расширений на стороне клиента тестирования.");
		Возврат Неопределено
	КонецЕсли;
	
	РеквизитЗначениеДляВозврата = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеДляВозврата", Истина, Истина, , ДопПараметрыПоиска);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеДляВозврата);
	
	Данные = Неопределено;
	Попытка
		Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("ПолучениеДанныхРасширений", ОписаниеОшибки());
	КонецПопытки;
	
	ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
	ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);

	Если Данные = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Не получилось прочитать список расширений, полученный от клиента тестирования.");
	КонецЕсли;

	Возврат Данные;
	
КонецФункции

// Формирует массив строк для вывода информации о расширениях
&НаКлиенте
Функция СформироватьМассивСтрокРасширений(МассивДанныхРасширений) Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Список расширений, установленных в базе"));
	Строки.Добавить("");
	
	КоличествоРасширений = 0;
	Для Каждого ДанныеРасширения Из МассивДанныхРасширений Цикл
		КоличествоРасширений = КоличествоРасширений + 1;
		Строки.Добавить(Ванесса.Локализовать("## ") + КоличествоРасширений + ". " + ДанныеРасширения.Имя);
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("| Свойство | Значение |"));
		Строки.Добавить(Ванесса.Локализовать("|----------|----------|"));
		Строки.Добавить(Ванесса.Локализовать("| Имя |") + " " + ДанныеРасширения.Имя + " |");
		Строки.Добавить(Ванесса.Локализовать("| Версия |") + " " + ДанныеРасширения.Версия + " |");
		Строки.Добавить(Ванесса.Локализовать("| Назначение |") + " " + ДанныеРасширения.Назначение + " |");
		Строки.Добавить(Ванесса.Локализовать("| Активно |") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеРасширения.Активно) + " |");
		Строки.Добавить(Ванесса.Локализовать("| Безопасный режим |") + " " + MCPПредставлениеЗначенияДляMarkdown(ДанныеРасширения.БезопасныйРежим) + " |");
		//Строки.Добавить(Ванесса.Локализовать("| Область действия |") + " " + ДанныеРасширения.ОбластьДействия + " |");
		Строки.Добавить("");
	КонецЦикла;
	
	Если КоличествоРасширений = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Расширения не найдены."));
		Строки.Добавить("");
	Иначе
		Строки.Добавить(Ванесса.Локализовать("## Итого:") + " " + КоличествоРасширений + " " + Ванесса.Локализовать("расширений"));
		Строки.Добавить("");
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

// Универсальный инструмент для управления командным интерфейсом
// Поддерживает действия: get_section_panel, get_function_panel, click_section_panel, click_function_panel, close_function_panel, get_all
&НаКлиенте
Функция УправлениеКоманднымИнтерфейсом(Запрос, ДополнительныеПараметры) Экспорт
	
	Действие = Строка(ЗначениеПараметраИзЗапроса(Запрос, "action"));
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр action обязателен. Допустимые значения: 'get_section_panel', 'get_function_panel', 'click_section_panel', 'click_function_panel', 'close_function_panel', 'get_all'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверка подключения клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	Если Действие = "get_section_panel" Тогда
		Возврат ПолучитьПанельРазделов(Запрос);
	ИначеЕсли Действие = "get_function_panel" Тогда
		Возврат ПолучитьПанельФункций(Запрос);
	ИначеЕсли Действие = "click_section_panel" Тогда
		Возврат НажатьКнопкуПанелиРазделов(Запрос);
	ИначеЕсли Действие = "click_function_panel" Тогда
		Возврат НажатьКнопкуПанелиФункций(Запрос);
	ИначеЕсли Действие = "close_function_panel" Тогда
		Возврат ЗакрытьПанельФункций();
	ИначеЕсли Действие = "get_all" Тогда
		Возврат ПолучитьВесьКомандныйИнтерфейс(Запрос);
	Иначе
		ТекстСообщения = Ванесса.Локализовать("Неизвестное действие:") + " " + Действие + ". " + Ванесса.Локализовать("Допустимые: 'get_section_panel', 'get_function_panel', 'click_section_panel', 'click_function_panel', 'close_function_panel', 'get_all'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
КонецФункции

// Закрывает панель функций, если она открыта.
// Если панель функций не была открыта - возвращает соответствующее сообщение.
&НаКлиенте
Функция ЗакрытьПанельФункций() Экспорт
	// Закрывает панель функций, если она открыта.
	// Если панель функций не была открыта - возвращает информацию об этом.
	
	// Проверяем, открыта ли панель функций
	Попытка
		ПанельФункций = Ванесса.ПанельФункций();
	Исключение
		// Если не удалось получить панель функций - значит она не открыта
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("Панель функций не была открыта."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецПопытки;
	
	Если ПанельФункций = Неопределено Тогда
		// Панель функций не активна
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("Панель функций не была открыта."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	// Панель функций открыта - нажимаем на тот же раздел, чтобы закрыть панель функций
	Попытка
		ПанельРазделов = Ванесса.ПанельРазделов();
		Если ПанельРазделов <> Неопределено Тогда
			СписокКоманд = ПанельРазделов.НайтиОбъекты();
			Если СписокКоманд.Количество() = 0 Тогда
				ТекстОшибки = Ванесса.Локализовать("Не удалось закрыть панель функций, т.к. в панели разделов нет команд.");
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			ИначеЕсли СписокКоманд.Количество() = 1 Тогда
				// Нажимаем на единственную команду панели разделов, чтобы закрыть панель функций
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("КоличествоПопыток", 1);
				Ванесса.ВПанелиРазделовЯВыбираю(СписокКоманд[0].ТекстЗаголовка, ДопПараметры);
			Иначе
				// Делаем два клика по первой команде и два клика по второй
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("КоличествоПопыток", 1);
				Ванесса.ВПанелиРазделовЯВыбираю(СписокКоманд[0].ТекстЗаголовка, ДопПараметры);
				Ванесса.ВПанелиРазделовЯВыбираю(СписокКоманд[0].ТекстЗаголовка, ДопПараметры);
				
				Ванесса.ВПанелиРазделовЯВыбираю(СписокКоманд[1].ТекстЗаголовка, ДопПараметры);
				Ванесса.ВПанелиРазделовЯВыбираю(СписокКоманд[1].ТекстЗаголовка, ДопПараметры);
			КонецЕсли;
		КонецЕсли;
		
		Строки = Новый Массив;
		Строки.Добавить(Ванесса.Локализовать("Панель функций была успешно закрыта."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не удалось закрыть панель функций:") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
КонецФункции	

// Получает панель разделов (внутренняя реализация)
&НаКлиенте
Функция ПолучитьПанельРазделов(Запрос) Экспорт
	
	ПанельРазделов = Ванесса.ПанельРазделов();
	Если ПанельРазделов = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Панель разделов пуста или недоступна."));
	КонецЕсли;
	СписокКоманд = ПанельРазделов.НайтиОбъекты();
	
	// Markdown формат
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Панель разделов"));
	Строки.Добавить("");
	
	Если СписокКоманд.Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Панель разделов пуста."));
	Иначе
		Для Каждого Команда Из СписокКоманд Цикл
			Строки.Добавить(Ванесса.Локализовать("- Команда:") + " " + Команда.ТекстЗаголовка);
			//Если ЗначениеЗаполнено(Команда.НавигационнаяСсылка) Тогда
			//	Строки.Добавить("  " + "- НавигационнаяСсылка:" + " " + Команда.НавигационнаяСсылка);
			//КонецЕсли;
			// Навигационные ссылки не добавляются для панели разделов, т.к. для них не работает переход по навигационной ссылке
			Строки.Добавить("");
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Получает весь командный интерфейс (панель разделов + панель функций для каждого раздела)
&НаКлиенте
Функция ПолучитьВесьКомандныйИнтерфейс(Запрос) Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Весь командный интерфейс"));
	Строки.Добавить("");
	
	// Получаем панель разделов
	ПанельРазделов = Ванесса.ПанельРазделов();
	Если ПанельРазделов = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Панель разделов пуста или недоступна."));
	КонецЕсли;
	
	СписокКоманд = ПанельРазделов.НайтиОбъекты();
	
	Если СписокКоманд.Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Панель разделов пуста."));
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	// Для каждой команды панели разделов получаем панель функций
	Команда = Неопределено;
	Для Каждого Команда Из СписокКоманд Цикл
		Строки.Добавить(Ванесса.Локализовать("## Раздел: ") + Команда.ТекстЗаголовка);
		Строки.Добавить("");
		
		// Нажимаем на команду панели разделов
		Попытка
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("КоличествоПопыток", 1);
			Ванесса.ВПанелиРазделовЯВыбираю(Команда.ТекстЗаголовка, ДопПараметры);
			
			// Получаем панель функций
			ПанельФункций = Ванесса.ПанельФункций();
			
			Если ПанельФункций <> Неопределено Тогда
				ДанныеПанели = ДанныеПанелиФункций(ПанельФункций);
				ЭлементыБезГруппы = ДанныеПанели.ЭлементыБезГруппы;
				КешГрупп = ДанныеПанели.КешГрупп;
				
				// Элементы без группы
				Если ЭлементыБезГруппы.Количество() > 0 Тогда
					Строки.Добавить(Ванесса.Локализовать("### Команды"));
					Строки.Добавить("");
					Для Каждого Элем Из ЭлементыБезГруппы Цикл
						Строки.Добавить("- `" + Элем.ТекстЗаголовка + "`");
						Если ЗначениеЗаполнено(Элем.НавигационнаяСсылка) Тогда
							Строки.Добавить("  - Навигационная ссылка: " + Элем.НавигационнаяСсылка);
						КонецЕсли;
						Строки.Добавить("");
					КонецЦикла;
				КонецЕсли;
				
				// Группы
				Для Каждого КлючЗначение Из КешГрупп Цикл
					Строки.Добавить(Ванесса.Локализовать("### Группа: `") + КлючЗначение.Ключ + "`");
					Строки.Добавить("");
					ДанныеГруппы = КлючЗначение.Значение;
					Для Каждого Элем Из ДанныеГруппы Цикл
						Строки.Добавить("- `" + Элем.ТекстЗаголовка + "`");
						Если ЗначениеЗаполнено(Элем.НавигационнаяСсылка) Тогда
							Строки.Добавить("  - Навигационная ссылка: " + Элем.НавигационнаяСсылка);
						КонецЕсли;
						Строки.Добавить("");
					КонецЦикла;
				КонецЦикла;
				
				Если ЭлементыБезГруппы.Количество() = 0 И КешГрупп.Количество() = 0 Тогда
					Строки.Добавить(Ванесса.Локализовать("Панель функций пуста."));
					Строки.Добавить("");
				КонецЕсли;
			Иначе
				Строки.Добавить(Ванесса.Локализовать("Панель функций пуста или недоступна."));
				Строки.Добавить("");
			КонецЕсли;
			
		Исключение
			Строки.Добавить(Ванесса.Локализовать("Ошибка получения панели функций: ") + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
			Строки.Добавить("");
		КонецПопытки;
	КонецЦикла;
	
	Если Команда <> Неопределено Тогда
		// Значит надо нажать на последнюю команду ещё раз, чтобы закрыть панель разделов
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("КоличествоПопыток", 1);
		Ванесса.ВПанелиРазделовЯВыбираю(Команда.ТекстЗаголовка, ДопПараметры);
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Получает панель функций (внутренняя реализация)
&НаКлиенте
Функция ПолучитьПанельФункций(Запрос) Экспорт
	
	ПанельФункций = Ванесса.ПанельФункций();
	
	Если ПанельФункций = Неопределено Тогда
		Возврат Ванесса.Локализовать("Панель функций пуста или недоступна. Возможно, не выбран раздел в панели разделов. Либо повторное нажатие на одну и туже команду панели разделов скрыло панель функций.");
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Панель функций"));
	Строки.Добавить("");
	
	ТекстОшибки = Неопределено;
	ДобавитьВМассивСтрокДанныеПанелиФункций(Строки, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;	
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Нажимает кнопку панели разделов (внутренняя реализация)
&НаКлиенте
Функция НажатьКнопкуПанелиРазделов(Запрос) Экспорт
	
	Команда = Строка(ЗначениеПараметраИзЗапроса(Запрос, "command"));
	Если НЕ ЗначениеЗаполнено(Команда) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр command обязателен для действия click_section_panel.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ВозвратФункции = ЗначениеПараметраИзЗапроса(Запрос, "returnFunctionPanel");
	Если НЕ ЗначениеЗаполнено(ВозвратФункции) Тогда
		ВозвратФункции = Ложь;
	Иначе
		Попытка
			ВозвратФункции = Булево(ВозвратФункции);
		Исключение
			ВозвратФункции = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Получаем панель разделов
	ПанельРазделов = Ванесса.ПанельРазделов();
	
	Если ПанельРазделов = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Панель разделов пуста или недоступна."));
	КонецЕсли;
	
	// Ищем и нажимаем кнопку
	Попытка
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("КоличествоПопыток", 1);
		Ванесса.ВПанелиРазделовЯВыбираю(Команда, ДопПараметры);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не удалось нажать на команду панели разделов.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	// Формируем ответ
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("# Команда панели разделов нажата: %1"), Команда));
	Строки.Добавить("");
	
	Если ВозвратФункции Тогда
		ТекстОшибки = Неопределено;
		ДобавитьВМассивСтрокДанныеПанелиФункций(Строки, ТекстОшибки);
		// Возврат панели разделов в предыдущее состояние
		Ванесса.ВПанелиРазделовЯВыбираю(Команда, ДопПараметры);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВМассивСтрокДанныеПанелиФункций(Строки, ТекстОшибки) Экспорт
	Строки.Добавить(Ванесса.Локализовать("## Панель функций"));
	Строки.Добавить("");
	БылиЭлементы = Ложь;
	// Получаем панель функций после нажатия
	Попытка
		ПанельФункций = Ванесса.ПанельФункций();
		Если ПанельФункций <> Неопределено Тогда
			
			ДанныеПанелиФункций = ДанныеПанелиФункций(ПанельФункций);
			ЭлементыБезГруппы = ДанныеПанелиФункций.ЭлементыБезГруппы;
			КешГрупп = ДанныеПанелиФункций.КешГрупп;
			
			Если ЭлементыБезГруппы.Количество() > 0 Тогда
				Для Каждого Элем Из ЭлементыБезГруппы Цикл
					Строки.Добавить("- `" + Элем.ТекстЗаголовка + "`");
					БылиЭлементы = Истина;
				КонецЦикла;
				Строки.Добавить("");
			КонецЕсли;
			
			Для Каждого КлючЗначение Из КешГрупп Цикл
				Строки.Добавить(Ванесса.Локализовать("# Группа `") + КлючЗначение.Ключ + "`");
				ДанныеГруппы = КлючЗначение.Значение;
				Для Каждого Элем Из ДанныеГруппы Цикл
					Строки.Добавить("* `" + Элем.ТекстЗаголовка + "`");
				Строки.Добавить("  " + "- Навигационная ссылка:" + " " + Элем.НавигационнаяСсылка);
					Строки.Добавить("");
					БылиЭлементы = Истина;
				КонецЦикла;	
			КонецЦикла;	
			
		КонецЕсли;
		
		Если НЕ БылиЭлементы Тогда
			Строки.Добавить(Ванесса.Локализовать("Панель функций пуста."));
		КонецЕсли;	
		
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не удалось нажать на команду панели функций.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ДанныеПанелиФункций(ПанельФункций) Экспорт
	
	ЭлементыБезГруппы = Новый Массив;
	КешГрупп = Новый Соответствие;

	Результат = Новый Структура;
	Результат.Вставить("ЭлементыБезГруппы", ЭлементыБезГруппы);
	Результат.Вставить("КешГрупп", КешГрупп);
	
	СписокКомандФункций = ПанельФункций.НайтиОбъекты();
	Если СписокКомандФункций.Количество() = 0 Тогда
	Иначе
		КешНавигационныхССылок = Новый Соответствие;
		
		Для Каждого КомандаФункции Из СписокКомандФункций Цикл
			Если ТипЗнч(КомандаФункции) = Тип("ТестируемаяГруппаКомандногоИнтерфейса") Тогда
				Если КешГрупп[КомандаФункции.ТекстЗаголовка] = Неопределено Тогда
					ДанныеГруппы = Новый Массив;
					КешГрупп.Вставить(КомандаФункции.ТекстЗаголовка, ДанныеГруппы);
				КонецЕсли;
				
				ДанныеГруппы = КешГрупп[КомандаФункции.ТекстЗаголовка];
				
				ЭлементыГруппы = КомандаФункции.НайтиОбъекты();
				Для Каждого Элем Из ЭлементыГруппы Цикл
					Если ЗначениеЗаполнено(Элем.НавигационнаяСсылка) Тогда
						Если КешНавигационныхССылок[Элем.НавигационнаяСсылка] <> Неопределено Тогда
							Продолжить;
						КонецЕсли;
						КешНавигационныхССылок.Вставить(Элем.НавигационнаяСсылка, Элем);
					КонецЕсли;	
					ДанныеГруппы.Добавить(Элем);
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла;
		
		// собираем элемены без группы
		Для Каждого КомандаФункции Из СписокКомандФункций Цикл
			Если ТипЗнч(КомандаФункции) = Тип("ТестируемаяГруппаКомандногоИнтерфейса") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КомандаФункции.НавигационнаяСсылка) Тогда
				Если КешНавигационныхССылок[КомандаФункции.НавигационнаяСсылка] <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;	
			
			ЭлементыБезГруппы.Добавить(КомандаФункции);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Нажимает кнопку панели функций (внутренняя реализация)
&НаКлиенте
Функция НажатьКнопкуПанелиФункций(Запрос) Экспорт
	
	Команда = Строка(ЗначениеПараметраИзЗапроса(Запрос, "command"));
	Если НЕ ЗначениеЗаполнено(Команда) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр command обязателен для действия click_function_panel.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Группа = Строка(ЗначениеПараметраИзЗапроса(Запрос, "group"));
	
	// Получаем панель функций
	ПанельФункций = Неопределено;
	Попытка
		ПанельФункций = Ванесса.ПанельФункций();
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не удалось получить панель функций.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		ТекстОшибки = ТекстОшибки + Символы.ПС + Ванесса.Локализовать("Сначала надо нажать на кнопку панели разделов.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецПопытки;
	
	Если ПанельФункций = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Панель функций пуста или недоступна. Возможно, не выбран раздел в панели разделов."));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Группа) Тогда
		//Ищем группу
		
		ЭлементыГруппа = ПанельФункций.НайтиОбъекты(Тип("ТестируемаяГруппаКомандногоИнтерфейса"),Группа);
		Если ЭлементыГруппа.Количество() = 0 Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В панели функций не найдена группа '%1'"), Группа));
		КонецЕсли;
		
				Если ЭлементыГруппа.Количество() > 1 Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В панели функций найдено %1 групп с заголовком '%2'"), XMLСтрока(ЭлементыГруппа.Количество()), Группа));
		КонецЕсли;
		
		ЭлементФункция = ЭлементыГруппа[0].НайтиОбъект(,Команда);
		Если ЭлементФункция = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В панели функций в группе '%1' не найдена команда '%2'"), Группа, Команда));
		КонецЕсли;
		
		Попытка
			ЭлементФункция.Нажать();
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В панели функций не получилось нажать на команду '%1'"), Команда)) + Символы.ПС + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		КонецПопытки;
		
	Иначе	
		ЭлементФункция = ПанельФункций.НайтиОбъект(,Команда);
		Если ЭлементФункция = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В панели функций не найдена команда '%1'"), Команда));
		КонецЕсли;
		
		Попытка
			ЭлементФункция.Нажать();
		Исключение
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В панели функций не получилось нажать на команду '%1'"), Команда)) + Символы.ПС + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;	
	
	Ванесса.sleep(1);
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("# Команда панели функций нажата: %1"), Команда));
	Ванесса.sleep(1);
	ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
	Возврат Ванесса._СтрСоединить(МассивСтрок, Символы.ПС);

КонецФункции

&НаКлиенте
Функция MCPСписокДоступныхПрофилей() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("## Доступные профили"));

	Если Ванесса.ДанныеКлиентовТестирования.Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Профили не настроены. Добавьте профиль на вкладке «Клиенты тестирования» в настройках VA."));
	Иначе
		Для Каждого СтрокаПрофиля Из Ванесса.ДанныеКлиентовТестирования Цикл
			Статус = "";
			Если СтрокаПрофиля.Подключен Тогда
				Статус = " " + Ванесса.Локализовать("✅ подключен");
			КонецЕсли;
			Строки.Добавить("- `" + СтрокаПрофиля.Имя + "`" + Статус);
			Строки.Добавить("  " + Ванесса.Локализовать("Синоним:") + " " + СтрокаПрофиля.Синоним);
			Строки.Добавить("  " + Ванесса.Локализовать("Строка подключения к базе:") + " " + СтрокаПрофиля.ПутьКИнфобазе);
			Строки.Добавить("  " + Ванесса.Локализовать("Дополнительные параметры подключения:") + " " + СтрокаПрофиля.ДопПараметры);
			Строки.Добавить("  " + Ванесса.Локализовать("Тип клиента:") + " " + СтрокаПрофиля.ТипКлиента);
			Строки.Добавить("  " + Ванесса.Локализовать("Имя компьютера:") + " " + СтрокаПрофиля.ИмяКомпьютера);
			Строки.Добавить("  " + Ванесса.Локализовать("Дескриптор окна:") + " " + СтрокаПрофиля.ДескрипторОкна);
			Строки.Добавить("  " + Ванесса.Локализовать("PID:") + " " + СтрокаПрофиля.PIDКлиентаТестирования);
		КонецЦикла;
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
