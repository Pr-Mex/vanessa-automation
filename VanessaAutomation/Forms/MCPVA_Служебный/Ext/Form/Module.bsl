		КонецЕсли;
		Если ПрименённыеОтборы.Количество() > 0 Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("По заданному отбору (%1) элементов не найдено."),
				Ванесса._СтрСоединить(ПрименённыеОтборы, ", ")));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Элементов плана видов характеристик не найдено."));
		КонецЕсли;
	КонецЕсли;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает список объектов метаданных (все справочники, все документы и т.д.)
&НаКлиенте
Функция ПолучитьСписокОбъектовМетаданных(ТипМетаданных) Экспорт

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", ТипМетаданных);

	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Имя без квалификатора Заголовок писало бы в свойство формы, а не в локальную переменную
	ЗаголовокРаздела = "";
	Если ТипМетаданных = "ВсеСправочники" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Справочники в базе клиента тестирования");
	ИначеЕсли ТипМетаданных = "ВсеДокументы" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Документы в базе клиента тестирования");
	ИначеЕсли ТипМетаданных = "ВсеПеречисления" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Перечисления в базе клиента тестирования");
	ИначеЕсли ТипМетаданных = "ВсеПланыВидовХарактеристик" Тогда
		ЗаголовокРаздела = Ванесса.Локализовать("# Планы видов характеристик в базе клиента тестирования");
	КонецЕсли;

	Строки.Добавить(ЗаголовокРаздела);
	Строки.Добавить(Ванесса.Локализовать("# Всего объектов:") + " " + XMLСтрока(Данные.Количество()));
	Строки.Добавить("");

	Для Каждого ТекИмя Из Данные Цикл
		Если Лев(НРег(ТекИмя), 7) = "удалить" ИЛИ Лев(НРег(ТекИмя), 6) = "delete" Тогда
			// Значит значение устарело
			Продолжить;
		КонецЕсли;
		Строки.Добавить("- " + ТекИмя);
	КонецЦикла;

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает данные документа
&НаКлиенте
Функция ПолучитьДанныеДокумента(ИмяДокумента, ДатаНачала, ДатаОкончания, Лимит, ОтборПоРеквизитам = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяДокумента) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Документ' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Строки = Новый Массив;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Документ");
	ДопПараметры.Вставить("Вид", ИмяДокумента);
	ДопПараметры.Вставить("Лимит", Лимит);
	ДопПараметры.Вставить("ДатаНачала", ДатаНачала);
	ДопПараметры.Вставить("ДатаОкончания", ДатаОкончания);
	ДопПараметры.Вставить("ОтборПоРеквизитам", ОтборПоРеквизитам);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может вернуть обёртку {КоличествоДокументов, НайденоДокументов, ДанныеДокументов}.
	// Для обратной совместимости со старым форматом (массив напрямую) поддерживаем оба варианта.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДанныеДокументов") Тогда
		ВсегоДокументов = Данные.КоличествоДокументов;
		НайденоДокументов = ВсегоДокументов;
		Если Данные.Свойство("НайденоДокументов") Тогда
			НайденоДокументов = Данные.НайденоДокументов;
		КонецЕсли;
		Данные = Данные.ДанныеДокументов;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		ВсегоДокументов = Данные.Количество();
		НайденоДокументов = ВсегоДокументов;
	Иначе
		// Это Структура с ошибкой (нет объекта метаданных) - количество не вычисляем,
		// обработка ошибки будет ниже.
		ВсегоДокументов = 0;
		НайденоДокументов = 0;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет документа:") + " " + ИмяДокумента);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Документ:") + " " + ИмяДокумента);
	Строки.Добавить(Ванесса.Локализовать("# Всего документов в базе:") + " " + XMLСтрока(ВсегоДокументов));
	Если НайденоДокументов <> ВсегоДокументов Тогда
		Строки.Добавить(Ванесса.Локализовать("# Найдено с учётом отбора:") + " " + XMLСтрока(НайденоДокументов));
	КонецЕсли;
	Если НайденоДокументов > Данные.Количество() Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("# Возвращено первые %1 документов из %2. Чтобы получить больше, увеличьте параметр limit (0 - без ограничения) или уточните date_start/date_end и filter."),
			XMLСтрока(Данные.Количество()), XMLСтрока(НайденоДокументов)));
	КонецЕсли;
	Строки.Добавить("");
	
	MCPВывестиДокументыВMarkdown(Строки, Данные);
	
	Если Данные.Количество() = 0 Тогда
		ПрименённыеОтборы = Новый Массив;
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
			ПрименённыеОтборы.Добавить("Дата >= " + Строка(ДатаНачала));
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаОкончания) Тогда
			ПрименённыеОтборы.Добавить("Дата <= " + Строка(ДатаОкончания));
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборПоРеквизитам) Тогда
			ПрименённыеОтборы.Добавить("filter: " + СтрЗаменить(ОтборПоРеквизитам, Символы.ПС, "; "));
		КонецЕсли;
		Если ПрименённыеОтборы.Количество() > 0 Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("По заданному отбору (%1) документов не найдено."),
				Ванесса._СтрСоединить(ПрименённыеОтборы, ", ")));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Документы не найдены."));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Возвращает данные константы и общее количество констант в базе клиента тестирования
&НаКлиенте
Функция ПолучитьДанныеКонстанты(ИмяКонстанты) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяКонстанты) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Константа' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Константа");
	ДопПараметры.Вставить("Вид", ИмяКонстанты);

	ТекстОшибки = Неопределено;
	Ответ = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Расширение возвращает данные в обёртке {КоличествоКонстант, ДанныеКонстанты}.
	// Для обратной совместимости со старым форматом, где расширение могло вернуть
	// только структуру с данными константы, поддерживаем оба варианта.
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ДанныеКонстанты") Тогда
		Данные = Ответ.ДанныеКонстанты;
		ВсегоКонстант = Ответ.КоличествоКонстант;
	Иначе
		Данные = Ответ;
		ВсегоКонстант = Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаНетОбъектаМетаданных") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет константы:") + " " + ИмяКонстанты);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;
		// Дополнительно сообщим общее количество констант в базе.
		Если ВсегоКонстант <> Неопределено Тогда
			Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(Данные.ВсеОбъекты.Количество()));
		КонецЕсли;
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Строки.Добавить(Ванесса.Локализовать("# Константа:") + " " + ИмяКонстанты);
	Если ВсегоКонстант <> Неопределено Тогда
		Строки.Добавить(Ванесса.Локализовать("# Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
	КонецЕсли;
	Строки.Добавить("");

	Если ЗначениеЗаполнено(Данные.Свойство("Значение")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Значение:") + " " + MCPПредставлениеЗначенияДляMarkdown(Данные.Значение));
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Свойство("Представление")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Представление:") + " " + Данные.Представление);
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Свойство("ТипЗначения")) Тогда
		Строки.Добавить(Ванесса.Локализовать("- Тип значения:") + " " + Данные.ТипЗначения);
	КонецЕсли;
	Строки.Добавить("");

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает значения всех констант (опционально по диапазону номеров)
&НаКлиенте
Функция ПолучитьВсеКонстанты(НачальныйНомер = 0, КонечныйНомер = 0) Экспорт

	// Проверка корректности переданного диапазона (до вызова расширения).
	Если НачальныйНомер < 0 ИЛИ КонечныйНомер < 0 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры start_number и end_number должны быть положительными числами.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если НачальныйНомер > 0 И НачальныйНомер < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр start_number должен быть >= 1.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если КонечныйНомер > 0 И КонечныйНомер < 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр end_number должен быть >= 1.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	Если НачальныйНомер > 0 И КонечныйНомер > 0 И НачальныйНомер > КонечныйНомер Тогда
		ТекстСообщения = Ванесса.Локализовать("НачальныйНомер не может быть больше КонечныйНомер");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "ВсеКонстанты");
	Если НачальныйНомер > 0 Тогда
		ДопПараметры.Вставить("НачальныйНомер", НачальныйНомер);
	КонецЕсли;
	Если КонечныйНомер > 0 Тогда
		ДопПараметры.Вставить("КонечныйНомер", КонечныйНомер);
	КонецЕсли;

	ТекстОшибки = Неопределено;
	Ответ = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	// Поддержка обёртки {КоличествоКонстант, ДанныеКонстант} от расширения.
	// Обратная совместимость: если расширение вернуло массив напрямую - работаем с ним.
	Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("ДанныеКонстант") Тогда
		Данные = Ответ.ДанныеКонстант;
		ВсегоКонстант = Ответ.КоличествоКонстант;
	Иначе
		Данные = Ответ;
		ВсегоКонстант = Данные.Количество();
	КонецЕсли;

	// Валидация против общего количества констант (требует данных от расширения,
	// поэтому выполняется после вызова расширения, а не на этапе разбора параметров MCP)
	Если НачальныйНомер > 0 И НачальныйНомер > ВсегоКонстант Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Начальный номер (%1) превышает общее количество констант в базе (%2)."),
			XMLСтрока(НачальныйНомер), XMLСтрока(ВсегоКонстант));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	ФактНачало = ?(НачальныйНомер > 0, НачальныйНомер, 1);
	ФактКонец  = ?(КонечныйНомер > 0, КонечныйНомер,  ВсегоКонстант);

	Строки.Добавить(Ванесса.Локализовать("# Значения всех констант:"));
	Строки.Добавить(Ванесса.Локализовать("- Всего констант в базе:") + " " + XMLСтрока(ВсегоКонстант));
	Если НачальныйНомер > 0 ИЛИ КонечныйНомер > 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("- Возвращено значений:") + " " + XMLСтрока(Данные.Количество())
			+ " (" + Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("диапазон с %1 по %2"), XMLСтрока(ФактНачало), XMLСтрока(ФактКонец)) + ")");
	Иначе
		Строки.Добавить(Ванесса.Локализовать("- Возвращено значений:") + " " + XMLСтрока(Данные.Количество()));
	КонецЕсли;
	Строки.Добавить("");

	MCPВывестиКонстантыВMarkdown(Строки, Данные);

	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает реквизиты объекта по навигационной ссылке.
// Режимы вывода - как у get_object_attributes: data_mode, attribute_name, tabular_section_name, only_filled.
&НаКлиенте
Функция ПолучитьРеквизитыОбъектаПоНавигационнойСсылке(НавигационнаяСсылка, РежимДанных = "all", ИмяРеквизита = "", ИмяТабличнойЧасти = "", ТолькоЗаполненные = Ложь, ДобавитьЗаголовок = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
		ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр навигационнаяСсылка.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "ДанныеПоНавигационнойСсылке");
	ДопПараметры.Вставить("НавигационнаяСсылкаОбъекта", НавигационнаяСсылка);
	
	ТекстОшибки = Неопределено;
	ДанныеОбъекта = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может не вернуть данные объекта (конверт ошибки или сбой разбора):
	// без структуры объекта читать её поля нельзя.
	Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") ИЛИ НЕ ДанныеОбъекта.Свойство("СтандартныеРеквизиты") Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Не вышло получить данные объекта из текущего окна."));
	КонецЕсли;

	Возврат СформироватьMarkdownРеквизитовОбъекта(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные, ДобавитьЗаголовок);
КонецФункции

&НаКлиенте
Функция ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки) Экспорт
	// Активное окно до открытия служебной формы: после её закрытия фокус возвращаем ему.
	ОкноДляВозвратаФокуса = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ПолучениеДанныхИзБазы");
	ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ПолучениеДанныхИзБазы.*",5);
	Если НужнаяФорма = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключен, но не найдена форма 'VAExtension_ПолучениеДанныхИзБазы' из служебного расширения.");
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		Возврат Неопределено
	КонецЕсли;	
	
	// Поля служебной формы ищем в самой найденной форме: активным окном остаётся форма пользователя,
	// поэтому поиск «в активном окне» поля служебной формы не находит.
	ДопПараметрыПоиска = Новый Структура("КонтейнерДляПоиска", НужнаяФорма);

	РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитТип = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("Тип", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитТип.ВвестиТекст(ДопПараметры.Тип);
	Если ДопПараметры.Свойство("Вид") Тогда
		РеквизитВид = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("Вид", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитВид.ВвестиТекст(ДопПараметры.Вид);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("НавигационнаяСсылкаОбъекта") Тогда
		РеквизитНавигационнаяСсылкаОбъекта = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("НавигационнаяСсылкаОбъекта", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитНавигационнаяСсылкаОбъекта.ВвестиТекст(ДопПараметры.НавигационнаяСсылкаОбъекта);
	КонецЕсли;
	
	// Передаём владельца всегда (даже пустой) — иначе "залипнет" владелец предыдущего вызова.
	ЗначениеВладельца = "";
	Если ДопПараметры.Свойство("Владелец") Тогда
		ЗначениеВладельца = ДопПараметры.Владелец;
	КонецЕсли;
	РеквизитИмяВладельца = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ИмяВладельца", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитИмяВладельца.ВвестиТекст(ЗначениеВладельца);
	
	Если ДопПараметры.Свойство("Лимит") Тогда
		РеквизитКоличествоСсылок = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КоличествоСсылок", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитКоличествоСсылок.ВвестиТекст(XMLСтрока(ДопПараметры.Лимит));
	КонецЕсли;

	Если ДопПараметры.Свойство("НачальныйНомер") И ДопПараметры.НачальныйНомер > 0 Тогда
		РеквизитНачальныйНомер = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("НачальныйНомер", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитНачальныйНомер.ВвестиТекст(XMLСтрока(ДопПараметры.НачальныйНомер));
	КонецЕсли;

	Если ДопПараметры.Свойство("КонечныйНомер") И ДопПараметры.КонечныйНомер > 0 Тогда
		РеквизитКонечныйНомер = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("КонечныйНомер", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитКонечныйНомер.ВвестиТекст(XMLСтрока(ДопПараметры.КонечныйНомер));
	КонецЕсли;
	
	// Передаём отбор всегда (даже пустой) — иначе "залипнет" отбор предыдущего вызова.
	ЗначениеОтбораПоНаименованию = "";
	Если ДопПараметры.Свойство("ОтборПоНаименованию") И ЗначениеЗаполнено(ДопПараметры.ОтборПоНаименованию) Тогда
		ЗначениеОтбораПоНаименованию = ДопПараметры.ОтборПоНаименованию;
	КонецЕсли;
	РеквизитОтборПоНаименованию = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОтборПоНаименованию", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитОтборПоНаименованию.ВвестиТекст(ЗначениеОтбораПоНаименованию);

	// Передаём режим сравнения name_filter: exact/partial/starts_with.
	// Передаём всегда (даже если отбор пуст) — чтобы при последовательных вызовах
	// не "залипал" старый режим в реквизите формы расширения.
	Если ДопПараметры.Свойство("ВидОтбораПоНаименованию") Тогда
		РеквизитВидОтбораПоНаименованию = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ВидОтбораПоНаименованию", Истина, Истина, , ДопПараметрыПоиска);
		РеквизитВидОтбораПоНаименованию.ВвестиТекст(ДопПараметры.ВидОтбораПоНаименованию);
	КонецЕсли;
	
	ДанныеДат = Новый Структура;
	ПереданыДаты = Ложь;
	Если ДопПараметры.Свойство("ДатаНачала") И ЗначениеЗаполнено(ДопПараметры.ДатаНачала) Тогда
		ПереданыДаты = Истина;
		ДанныеДат.Вставить("ДатаНачала", ДопПараметры.ДатаНачала);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("ДатаОкончания") И ЗначениеЗаполнено(ДопПараметры.ДатаОкончания) Тогда
		ПереданыДаты = Истина;
		ДанныеДат.Вставить("ДатаОкончания", ДопПараметры.ДатаОкончания);
	КонецЕсли;
	
	Если НЕ ПереданыДаты Тогда
		// Сбрасываем даты предыдущего вызова пустыми датами — иначе они "залипнут"
		// в реквизитах формы расширения и неявно ограничат выборку документов.
		ДанныеДат.Вставить("ДатаНачала", Дата(1, 1, 1));
		ДанныеДат.Вставить("ДатаОкончания", Дата(1, 1, 1));
	КонецЕсли;

	// Отбор по реквизитам передаём всегда (даже пустой) — иначе "залипнет" отбор предыдущего вызова.
	ЗначениеОтбораПоРеквизитам = "";
	Если ДопПараметры.Свойство("ОтборПоРеквизитам") Тогда
		ЗначениеОтбораПоРеквизитам = ДопПараметры.ОтборПоРеквизитам;
	КонецЕсли;
	ДанныеДат.Вставить("ОтборПоРеквизитам", ЗначениеОтбораПоРеквизитам);

	РеквизитДляУстановкиПараметров = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ДляУстановкиПараметров", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитДляУстановкиПараметров.ВвестиТекст(Ванесса.ЗаписатьОбъектJSON(ДанныеДат));
	КнопкаПолучитьПараметры = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаПолучитьПараметры");
	КнопкаПолучитьПараметры.Нажать();
	
	КнопкаВыполнитьОбработку = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьОбработку");
	
	КнопкаЗакрытьФорму = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	КнопкаВыполнитьОбработку.Нажать();
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные из базы данных клиента тестирования.");
		Возврат Неопределено
	КонецЕсли;

	РеквизитЗначениеДляВозврата = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеРезультат", Истина, Истина, , ДопПараметрыПоиска);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеДляВозврата);

	// Закрываем служебную форму до разбора результата: если разбор упадёт, форма не останется
	// открытой и реквизиты фильтров не "залипнут" в ней до следующего вызова.
	ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
	ВернутьФокусОкнуОбъекта(ОкноДляВозвратаФокуса);

	Если НЕ ЗначениеЗаполнено(ПредставлениеРезультата) Тогда
		ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension вернуло пустой результат без текста ошибки.")
			+ Символы.ПС + Ванесса.Локализовать("Возможные причины: ошибка на стороне клиента тестирования или устаревшая версия расширения VAExtension без передачи текста ошибки. Обновите расширение VAExtension в клиенте тестирования.");
		Возврат Неопределено
	КонецЕсли;

	Попытка
		Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	Исключение
		ТекстОшибки = Ванесса.Локализовать("Не получилось разобрать JSON результата расширения VAExtension.")
			+ Символы.ПС + ОписаниеОшибки()
			+ Символы.ПС + Ванесса.Локализовать("Первые 1000 символов результата:")
			+ Символы.ПС + Лев(ПредставлениеРезультата, 1000);
		Возврат Неопределено
	КонецПопытки;

	// Расширение сообщает об ошибке конвертом {"ОшибкаВыполнения": "<текст>"} — показываем текст как есть.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаВыполнения") Тогда
		ТекстОшибки = Данные.ОшибкаВыполнения;
		Возврат Неопределено
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Закрывает служебную форму VAExtension_ПолучениеДанныхИзБазы, игнорируя ошибки нажатия.
&НаКлиенте
Процедура ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму)

	Если КнопкаЗакрытьФорму = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КнопкаЗакрытьФорму.Нажать();
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("ДанныеИзБазыДанныхКлиентаТестирования", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СкриншотыИПрочее

// Выполняет голосовое уведомление
&НаКлиенте
Функция ГолосовыеУведомления(Запрос, ДополнительныеПараметры) Экспорт

	ТипУведомления = Строка(ЗначениеПараметраИзЗапроса(Запрос, "notification_type"));

	Если НЕ ЗначениеЗаполнено(ТипУведомления) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр notification_type обязателен. Допустимые значения: 'task_completed', 'decision_required', 'task_cannot_be_completed', 'error_occurred'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	// Получаем параметр языка озвучки (по умолчанию 'ru')
	Язык = Строка(ЗначениеПараметраИзЗапроса(Запрос, "language"));
	Если НЕ ЗначениеЗаполнено(Язык) Тогда
		Язык = "ru";
	Иначе
		Язык = НРег(СокрЛП(Язык));
		Если Язык <> "ru" И Язык <> "en" Тогда
			ТекстСообщения = Ванесса.Локализовать("Некорректное значение параметра language. Допустимые значения: 'ru' (русский), 'en' (английский).");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Проверяем допустимое значение
	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить("task_completed");
	ДопустимыеТипы.Добавить("decision_required");
	ДопустимыеТипы.Добавить("task_cannot_be_completed");
	ДопустимыеТипы.Добавить("error_occurred");

	Если ДопустимыеТипы.Найти(ТипУведомления) = Неопределено Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение notification_type. Допустимые значения: 'task_completed', 'decision_required', 'task_cannot_be_completed', 'error_occurred'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Если Ванесса.ЭтоLinux Тогда
		ТекстСообщения = Ванесса.Локализовать("Голосовое уведомление не работает под linux.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если НЕ Ванесса.Объект.ИспользоватьКомпонентуVanessaExt Тогда
		ТекстСообщения = Ванесса.Локализовать("Чтобы была возможность выполнить голосовое уведомление нужно в Vanessa Automation включить использование внешней компоненты VanessaExt.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения);
	КонецЕсли;

	Если КаталогСФайламиОзвучки = Неопределено Тогда
		ДвоичныеДанныеГолос = ДвоичныеДанныеГолосСервер();
		ЧтениеZipФайла = Новый ЧтениеZipФайла(ДвоичныеДанныеГолос.ОткрытьПотокДляЧтения());
		ВременныйКаталог = ПолучитьИмяВременногоФайла("");
		Ванесса.СоздатьКаталогКомандаСистемы(ВременныйКаталог);
		ЧтениеZipФайла.ИзвлечьВсе(ВременныйКаталог);
		КаталогСФайламиОзвучки = ВременныйКаталог;
	КонецЕсли;

	ИмяФайла = ТипУведомления + "_" + Язык + ".mp3";
	ПолноеИмяФайла = КаталогСФайламиОзвучки + "\" + ИмяФайла;
	Ванесса.ВнешняяКомпонентаДляСкриншотов.НачатьВызовВоспроизвестиМедиа(Ванесса.ОписаниеПустогоОбработчика(3), ПолноеИмяФайла, ПолноеИмяФайла);

	// Формируем ответ в формате Markdown
	Строки = Новый Массив;
	Строки.Добавить(Ванесса.Локализовать("# Голосовое уведомление выполнено"));
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Синтезирует переданный текст и произносит его пользователю (инструмент speak_text)
&НаКлиенте
Функция ПроизнестиТекст(Запрос, ДополнительныеПараметры) Экспорт
	
	//MCP-клиент может передать null для неуказанного параметра, в 1С это Неопределено
	ТекстРечи = ЗначениеПараметраИзЗапроса(Запрос, "text");
	Если ТекстРечи = Null ИЛИ ТекстРечи = Неопределено Тогда
		ТекстРечи = "";
	КонецЕсли;
	ТекстРечи = СокрЛП(Строка(ТекстРечи));
	
	БезВоспроизведения = (ЗначениеПараметраИзЗапроса(Запрос, "no_play") = Истина);
	
	Если ПустаяСтрока(ТекстРечи) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Параметр text обязателен и не может быть пустым."));
	КонецЕсли;
	
	МаксимальнаяДлинаТекста = 500;
	Если СтрДлина(ТекстРечи) > МаксимальнаяДлинаТекста Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Текст длиннее %1 символов. Разбейте фразу на несколько вызовов."),
			МаксимальнаяДлинаТекста);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если Ванесса.ЭтоLinux Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Произнесение текста не работает под Linux."));
	КонецЕсли;
	
	//Синтез не занимает плеер, поэтому в режиме без воспроизведения проверка занятости не нужна
	Если ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP) И НЕ БезВоспроизведения Тогда
		
		//Проверяем занятость асинхронно: синхронный вызов компоненты запрещён в режиме запрета синхронных вызовов
		Ванесса.УстановитьИдентификаторЗадачиMCP(Запрос.Идентификатор);
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Текст", ТекстРечи);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроизнестиТекстПроверкаОзвучкиЗавершена", ЭтаФорма, ДопПараметры);
		Попытка
			Ванесса.НачатьПроверкуОзвучкиMCP(ОписаниеОповещения);
		Исключение
			ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ПолучитьИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
			Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		КонецПопытки;
		Возврат Неопределено;
		
	КонецЕсли;
	
	Попытка
		Ванесса.ПроизнестиТекстMCP(ТекстРечи, БезВоспроизведения);
	Исключение
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	Возврат MCPОтветОзвучкиТекста(ТекстРечи, БезВоспроизведения);
	
КонецФункции

// Формирует ответ инструмента speak_text
&НаКлиенте
Функция MCPОтветОзвучкиТекста(ТекстРечи, БезВоспроизведения = Ложь)
	
	Строки = Новый Массив;
	Если БезВоспроизведения Тогда
		Строки.Добавить(Ванесса.Локализовать("# Текст синтезирован без воспроизведения"));
		Если Ванесса.Объект.ЗаписьВидеоКэшироватьФайлыTTS Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Фраза длиной %1 символов сохранена в кеш озвучки. Повторный вызов с этим же текстом получит озвучку из кеша."),
				СтрДлина(ТекстРечи)));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Кеширование озвучки отключено в настройках, файл в кеш не сохранён."));
		КонецЕсли;
	Иначе
		Строки.Добавить(Ванесса.Локализовать("# Текст передан на озвучку"));
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Запущено воспроизведение фразы длиной %1 символов. Пока фраза звучит, повторный вызов инструмента вернёт ошибку."),
			СтрДлина(ТекстРечи)));
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Завершает асинхронную проверку занятости движка озвучки и запускает озвучку текста
&НаКлиенте
Процедура ПроизнестиТекстПроверкаОзвучкиЗавершена(РезультатВызова, ПараметрыВызова, ДопПараметры) Экспорт
	
	//Всё тело в Попытка: необработанное исключение в колбэке оставит запрос MCP без ответа
	Попытка
		
		//Фраза могла закончиться, пока шла асинхронная проверка: тогда состояние уже сброшено событием MEDIA_FINISHED
		Если РезультатВызова = Истина И ЗначениеЗаполнено(Ванесса.ИДОзвучкиMCP) Тогда
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Предыдущая фраза ещё произносится: <%1>. Дождитесь окончания озвучки и повторите вызов."),
				Ванесса.ТекстОзвучкиMCP);
			МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ПолучитьИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
			Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
			Возврат;
		КонецЕсли;
		
		Ванесса.ОчиститьСостояниеОзвучкиMCP();
		Ванесса.ПроизнестиТекстMCP(ДопПараметры.Текст);
		МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), MCPОтветОзвучкиТекста(ДопПараметры.Текст));
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ПолучитьИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстОшибки);
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОкнаДляСкриншотов(РезультатВызова) Экспорт
	
	ДанныеОкон = Ванесса.ПрочитатьСтрокуJSON(РезультатВызова);
	ОкнаДляСкриншотов = Новый Массив;
	Если ТипЗнч(ДанныеОкон) = Тип("Массив") Тогда
		Для каждого ДанныеОкна из ДанныеОкон Цикл
			Если НЕ ДанныеОкна.Свойство("Title") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Ванесса.ЭтоОкноНеДляСнятияСкриншотов(ДанныеОкна) Тогда
				Ванесса.ЗаписатьЛогВЖРИнформация("СнятиеСкриншота.ОкноПропущено.Class", Ванесса.ЗаписатьОбъектJSON(ДанныеОкна));
				Продолжить;
			КонецЕсли;
			
			Если ДанныеОкна.Свойство("Types") И Ванесса.ОкноДанногоТипаНеДляСнятияСкриншотов(ДанныеОкна.Types) Тогда
				Ванесса.ЗаписатьЛогВЖРИнформация("СнятиеСкриншота.ОкноПропущено.Types", Ванесса.ЗаписатьОбъектJSON(ДанныеОкна));
				Продолжить;
			КонецЕсли;	
			
			ДанныеОкнаОтвет = Новый Структура;
			ДанныеОкнаОтвет.Вставить("ПолныеДанныеОкна", ДанныеОкна);
			ОкнаДляСкриншотов.Добавить(ДанныеОкнаОтвет);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ОкнаДляСкриншотов;
	
КонецФункции

// Отправка результата инструмента с текстом и изображением
&НаКлиенте
Процедура MCPОтправитьРезультатИнструментаСИзображением(Текст, ДвоичныеДанныеИзображения, ДополнительныеПараметры, MimeТип = "image/png") Экспорт
	
	// Изображение в base64
	Если ДвоичныеДанныеИзображения <> Неопределено Тогда
		ИмяФайла = ПолучитьФайлКартинкиИзДвоичныхДанных(ДвоичныеДанныеИзображения, ДополнительныеПараметры);
		
		ТекстСообщения = Текст + Символы.ПС + Ванесса.Локализовать("Скриншот окна записан в файл:") + " " + ИмяФайла;
		МодульМсп_Сервер().ЗавершитьВызовИнструментаУспешно(Ванесса.ПолучитьИдентификаторЗадачиMCP(), ТекстСообщения);
		Ванесса.УстановитьИдентификаторЗадачиMCP(Неопределено);
		Возврат;
	Иначе	
		ТекстСообщения = Ванесса.Локализовать("Не вышло получить скриншот окна.");
		МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(Ванесса.ИдентификаторЗадачиMCP(), "ACTION_FAILED", ТекстСообщения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработаннаяКартинкаСервер(Картинка) Экспорт
	
	ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
	ОбрабатываемаяКартинка.УстановитьФормат(ФорматКартинки.PNG);
	ОбрабатываемаяКартинка.УстановитьГлубинуЦвета(Вычислить("ГлубинаЦвета.БитНаПиксел8"));
	ОбрабатываемаяКартинка.ПреобразоватьВОттенкиСерого();
	
	Возврат ОбрабатываемаяКартинка.ПолучитьКартинку();
КонецФункции

