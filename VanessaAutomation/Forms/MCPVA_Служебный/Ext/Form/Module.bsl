&НаКлиенте
Функция MCPНормализоватьПутьКФичаФайлу(Путь) Экспорт
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение Ванесса.Локализовать("Не указан путь к .feature файлу.");
	КонецЕсли;
	
	НормализованныйПуть = Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Строка(Путь));
	Если Не ЗначениеЗаполнено(НормализованныйПуть) Тогда
		ВызватьИсключение Ванесса.Локализовать("Не удалось определить путь к .feature файлу.");
	КонецЕсли;
	
	Если Прав(НРег(СокрЛП(НормализованныйПуть)), 8) <> ".feature" Тогда
		ВызватьИсключение Ванесса.Локализовать("Ожидался файл с расширением .feature:") + " " + НормализованныйПуть;
	КонецЕсли;
	
	Если Не Ванесса.ФайлСуществуетКомандаСистемы(НормализованныйПуть) Тогда
		// Путь мог быть указан от каталога проекта: такие пути принимают инструменты запуска,
		// а ядро относительные пути не разворачивает
		Кандидат = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + Путь;
		Если Не Ванесса.ФайлСуществуетКомандаСистемы(Кандидат) Тогда
			ВызватьИсключение Ванесса.Локализовать("Файл не найден:") + " " + НормализованныйПуть;
		КонецЕсли;
		НормализованныйПуть = Ванесса.ПреобразоватьПутьСТочкамиКНормальномуПути(Строка(Кандидат));
	КонецЕсли;
	
	Если НЕ Ванесса.ЭтоLinux Тогда
		// Смешанные разделители в путях сообщений выглядят как дефект: приводим к разделителю ОС
		НормализованныйПуть = СтрЗаменить(НормализованныйПуть, "/", "\");
	КонецЕсли;	
	
	Если Ванесса.ЭтоКаталогКомандаСистемы(НормализованныйПуть) Тогда
		ВызватьИсключение Ванесса.Локализовать("Ожидался путь к .feature файлу, а не к каталогу:") + " " + НормализованныйПуть;
	КонецЕсли;
	
	Возврат НормализованныйПуть;
	
КонецФункции

