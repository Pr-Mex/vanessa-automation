	Колонки.Добавить("data_presentation");
	Колонки.Добавить("user");
	Колонки.Добавить("user_name");
	Колонки.Добавить("computer");
	Колонки.Добавить("application");
	Колонки.Добавить("application_presentation");
	Колонки.Добавить("connection");
