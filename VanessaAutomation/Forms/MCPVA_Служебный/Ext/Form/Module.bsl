#КонецОбласти

#Область ДанныеОбАктивномОкне

&НаКлиенте
Процедура ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога) Экспорт
	Попытка
		ТекстМодальногоДиалога = Ванесса.ПолучитьТекстПредупреждения();
		Строки.Добавить("");
		Строки.Добавить(СтрокаДляОшибкиТекстМодальногоДиалога());
		Строки.Добавить(ТекстМодальногоДиалога);
	Исключение
	КонецПопытки;
	
	КнопкиМодальногоДиалога = Новый Массив;
	Попытка
		КнопкиМодальногоДиалога = ОкноМодальногоДиалога.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы"));
	Исключение
	КонецПопытки;
	РезультатКнопки = Новый Массив;
	Для Каждого ТекКнопка Из КнопкиМодальногоДиалога Цикл
		Если НЕ ТекКнопка.ТекущаяВидимость() Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатКнопки.Добавить(ТекКнопка);
	КонецЦикла;
	
	Если РезультатКнопки.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Кнопки модального диалога:"));
		Для Каждого ТекКнопка Из РезультатКнопки Цикл
			Строки.Добавить("  -" + ТекКнопка.Имя + " (" + ТекКнопка.ТекстЗаголовка + ")");
		КонецЦикла;	
	КонецЕсли;
	
	Строки.Добавить("");
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСообщенияПользователюИзОкна(ПараметрОкно) Экспорт
	
	CообщенияПользователю = Неопределено;
	Попытка
		CообщенияПользователю = ПараметрОкно.ПолучитьТекстыСообщенийПользователю();
	Исключение
	КонецПопытки;
	
	Возврат CообщенияПользователю;
	
КонецФункции

&НаКлиенте
Функция СтрокаДляОшибкиТекстМодальногоДиалога() Экспорт
	Возврат Ванесса.Локализовать("Текст модального диалога:");
КонецФункции

&НаКлиенте
Процедура ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок) Экспорт
	
	ПанельФункций = Неопределено;
	Попытка
		ПанельФункций = Ванесса.ПанельФункций();
	Исключение
	КонецПопытки;
	Если ПанельФункций <> Неопределено Тогда
		МассивСтрок.Добавить(Ванесса.Локализовать("В данный момент открыта панель функций. Работа с окнами и элементами форм заблокирована. Нужно вызвать инструмент `manage_command_interface`, `action=close_function_panel`"));
		Возврат;
	КонецЕсли;
	
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		ТекстСтроки = Ванесса.Локализовать("Заголовок активного окна:") + " " + АктивноеОкно.Заголовок;
		МассивСтрок.Добавить(ТекстСтроки);
		Если Ванесса.ЭтоМодальныйДиалог(АктивноеОкно) Тогда
			МассивСтрок.Добавить(Ванесса.Локализовать("Обнаружен модальный диалог."));
			ТекСообщение = Ванесса._СтрСоединить(МассивСтрок, Символы.ПС);
			Если Найти(ТекСообщение, СтрокаДляОшибкиТекстМодальногоДиалога()) = 0 Тогда
				ДобавитьВОтветИнформациюОМодальномДиалоге(МассивСтрок, АктивноеОкно);
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			CообщенияПользователю = ПолучитьСообщенияПользователюИзОкна(АктивноеОкно);
			Если CообщенияПользователю <> Неопределено Тогда
				МассивСтрок.Добавить("");
				МассивСтрок.Добавить(Ванесса.Локализовать("## В окне есть сообщения пользователю:"));
				МассивСтрок.Добавить(Ванесса._СтрСоединить(CообщенияПользователю, Символы.ПС));
			КонецЕсли;
		Исключение
			
		КонецПопытки;
		
		Попытка
			ТекущаяФорма = Ванесса.НайтиТекущуюФормуTestClient();
			ТекЭлемент = ТекущаяФорма.ПолучитьТекущийЭлемент();
			МассивСтрок.Добавить("");
			МассивСтрок.Добавить("## Активный элемент шапки формы:");
			МассивСтрок.Добавить("Имя:" + " " + ТекЭлемент.Имя);
			МассивСтрок.Добавить("Заголовок:" + " " + ТекЭлемент.ТекстЗаголовка);
			
			ТекстОткрытогоСписка = "";
			Попытка
				Ванесса.ДополнитьОшибку_ЗначениеОткрытогоСписка(ТекЭлемент, ТекстОткрытогоСписка);
			Исключение
			КонецПопытки;
		Если ЗначениеЗаполнено(ТекстОткрытогоСписка) Тогда
				МассивСтрок.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("В поле `%1` не был зафиксирован выбор значения. Выполните ввод значения по строке или выбор точного значения из списка."), ТекЭлемент.Имя));
				МассивСтрок.Добавить(ТекстОткрытогоСписка);
			КонецЕсли;
		Исключение
			
		КонецПопытки;
		
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ДобавитьВСообщениеДанныеОбАктивномОкне(Строка, СделатьSleep = Ложь) Экспорт
	Если СделатьSleep Тогда
		Ванесса.sleep(1);
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(Строка);
	ДобавитьВМассивСтрокДанныеОбАктивномОкне(МассивСтрок);
	Возврат Ванесса._СтрСоединить(МассивСтрок, Символы.ПС);
КонецФункции

// Нужно, чтобы сработали обработчики в форме, чтобы после нажатия на кнопку получить правильное активное окно
&НаКлиенте
Функция ПослеНажатияНаКнопкуНадоСделатьПаузу(ИмяКнопки) Экспорт
	ИмяКнопки_НРег = НРег(ИмяКнопки);
	Если Найти(ИмяКнопки_НРег, "записать") > 0 Тогда
		Возврат Истина;
	ИначеЕсли Найти(ИмяКнопки_НРег, "провести") > 0 Тогда
		Возврат Истина;
	ИначеЕсли Найти(ИмяКнопки_НРег, "save") > 0 Тогда
		Возврат Истина;
	ИначеЕсли Найти(ИмяКнопки_НРег, "post") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
