	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("hyperlink_index", "number", "Индекс гиперссылки (начиная с 1) для нажатия. Используется для действия click_hyperlink, когда в поле несколько гиперссылок. Необязательный параметр."));
