// Возвращает общий модуль из расширения MCP
// Если установлен внешний фасад (альтернативный MCP транспорт, плагин MCPRagSearch) - возвращает его.
&НаКлиенте
Функция МодульМсп_Сервер() Экспорт
	Если ВнешнийФасадМсп <> Неопределено Тогда
		Возврат ВнешнийФасадМсп;
	КонецЕсли;
	Возврат Вычислить("Мсп_Сервер");
КонецФункции

// Устанавливает внешний фасад Мсп_Сервер (Неопределено - вернуться к штатному модулю расширения).
&НаКлиенте
Процедура УстановитьВнешнийФасадМсп(Фасад) Экспорт
	ВнешнийФасадМсп = Фасад;
КонецПроцедуры

// Возвращает признак того, что сервер MCP расширения client_mcp запущен.
// Если модули расширения недоступны (расширение не установлено) - Ложь.
&НаКлиенте
Функция MCPСерверЗапущен() Экспорт
	Попытка
		МодульТранспорта = Вычислить("Мсп_ТранспортСерверКлиент");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Попытка
		Возврат МодульТранспорта.СерверЗапущен();
	Исключение
		Ванесса.ЗаписатьЛогВЖРОшибка("VanessaAutomation.MCPСерверЗапущен", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Запускает сервер MCP расширения client_mcp, если он ещё не запущен.
// Возвращает Истина, если запуск инициирован (запуск асинхронный - итог проверяется чтением статуса).
// Если внешний плагин установил свой MCP-транспорт (фасад) или модули расширения недоступны -
// ничего не делает и возвращает Ложь. Поведение описано в описании настройки ЗапускатьСерверMCPПриЗапускеVA.
&НаКлиенте
Функция ЗапуститьСерверMCPЕслиНеЗапущен(Порт) Экспорт
	
	Если ВнешнийФасадМсп <> Неопределено Тогда
		MCPЗаписатьСлужебныеДанныеБезопасно("Сервер.ВнешнийФасад", Новый Структура("Порт", Порт));
		Возврат Ложь;
	КонецЕсли;
	
	Если MCPСерверЗапущен() Тогда
		MCPЗаписатьСлужебныеДанныеБезопасно("Сервер.УжеЗапущен", Новый Структура("Порт", Порт));
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		МодульСервера = Вычислить("Мсп_Сервер");
	Исключение
		// Модуль недоступен (например, установлен только wt_mcp_adapter): молча ничего не делаем.
		MCPЗаписатьСлужебныеДанныеБезопасно("Сервер.МодульНедоступен", Новый Структура("Порт", Порт));
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		// Асинх Функция расширения вызывается без Ждать (fire-and-forget): ошибки запуска
		// сервера логирует расширение, сбой подключения внешней компоненты оно перевыбрасывает.
		МодульСервера.ЗапуститьСервер(Порт);
	Исключение
		MCPЗаписатьСлужебныеДанныеБезопасно("Сервер.ОшибкаЗапуска", Новый Структура("Порт, ЕстьТекст", Порт, Истина));
		Ванесса.ЗаписатьЛогВЖРОшибка("VanessaAutomation.ЗапуститьСерверMCP", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	MCPЗаписатьСлужебныеДанныеБезопасно("Сервер.Запуск", Новый Структура("Порт", Порт));
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область БДМетаданныеИБазаЗнаний

// Получает информацию из базы знаний
&НаКлиенте
Функция ПолучитьДанныеИзБазыЗнаний(Запрос, ДополнительныеПараметры) Экспорт
	
	ФорматОтвета = ЗначениеПараметраИзЗапроса(Запрос, "format");
	СтрокаПоиска = СокрЛП(ЗначениеПараметраИзЗапроса(Запрос, "search_string"));
	
	// Номера вопросов: строка с номерами, диапазонами и перечислениями ("12", "10-15", "7,12,20-22").
	// Числовое значение тоже принимаем - раньше параметр был числом.
	ЗначениеНомеровВопроса = ЗначениеПараметраИзЗапроса(Запрос, "question_number");
	Если ЗначениеНомеровВопроса = Неопределено ИЛИ ЗначениеНомеровВопроса = Null Тогда
		СтрокаНомеровВопроса = "";
	ИначеЕсли ТипЗнч(ЗначениеНомеровВопроса) = Тип("Число") Тогда
		СтрокаНомеровВопроса = Формат(ЗначениеНомеровВопроса, "ЧГ=0; ЧН=0");
	Иначе
		СтрокаНомеровВопроса = СокрЛП(Строка(ЗначениеНомеровВопроса));
	КонецЕсли;
	
	// Путь к файлу для format='save_to_file' указывает вызывающая сторона.
	ЗначениеПутиКФайлу = ЗначениеПараметраИзЗапроса(Запрос, "file_path");
	Если ЗначениеПутиКФайлу = Неопределено ИЛИ ЗначениеПутиКФайлу = Null Тогда
		ПутьКФайлу = "";
	Иначе
		ПутьКФайлу = СокрЛП(Строка(ЗначениеПутиКФайлу));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФорматОтвета) Тогда
		ТекстСообщения = Ванесса.Локализовать("Не указан обязательный параметр 'format'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ФорматОтвета <> "short_info"
		И ФорматОтвета <> "questions_only"
		И ФорматОтвета <> "questions"
		И ФорматОтвета <> "one_question"
		И ФорматОтвета <> "question_search"
		И ФорматОтвета <> "answers_search"
		И ФорматОтвета <> "all"
		И ФорматОтвета <> "save_to_file"
		Тогда
		ТекстСообщения = Ванесса.Локализовать("Передано недопустимое значение параметра 'format'");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ФорматОтвета = "save_to_file" И НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для format='save_to_file' нужно передать параметр 'file_path' - путь к файлу, в который будет записана база знаний.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если глКешБазыЗнаний = Неопределено Тогда
		глКешБазыЗнаний = ПолныйТекстБазыЗнанийСервер();
	КонецЕсли;
	
	Возврат ДанныеИзБазыЗнанийКлиент(ФорматОтвета, СтрокаНомеровВопроса, СтрокаПоиска, ПутьКФайлу);
	
КонецФункции

// Получает информацию о статистике использования шагов
&НаКлиенте
Функция ПолучитьДанныеОЧастоИспользуемыхШагах(Запрос, ДополнительныеПараметры) Экспорт
	
	ЗначениеКоличества = ЗначениеПараметраИзЗапроса(Запрос, "limit");
	Если ЗначениеКоличества = Неопределено ИЛИ ЗначениеКоличества = Null ИЛИ ЗначениеКоличества = "" Тогда
		Количество = 20;
	Иначе
		Попытка
			Количество = Цел(Число(ЗначениеКоличества));
		Исключение
			Количество = 20;
		КонецПопытки;
	КонецЕсли;
	Если Количество < 0 Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Параметр limit не может быть отрицательным. Используйте 0, чтобы вернуть все результаты."));
	КонецЕсли;
	
	КомпактныйВывод = БулевПараметрИзЗапроса(Запрос, "compact", Истина);

	Если глЧастоИспользуемыеШаги = Неопределено Тогда
		глЧастоИспользуемыеШаги = ПолучитьДанныеМакетаЧастоИспользуемыеШаги();
	КонецЕсли;
	
	Возврат ДанныеОЧастоИспользуемыхШагах(Количество, КомпактныйВывод);
	
КонецФункции

&НаСервере
Функция ПолныйТекстБазыЗнанийСервер() Экспорт
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектНаСервере.ПолучитьМакет("БазаЗнанийДляMCP").ПолучитьТекст();
	
КонецФункции

&НаКлиенте
Функция ДанныеИзБазыЗнанийКлиент(ФорматОтвета, НомерВопроса, СтрокаПоиска, ПутьКФайлу = "") Экспорт
	
	// НомерВопроса - строка с номерами/диапазонами вопросов: "12", "10-15", "7,12,20-22".
	Если ФорматОтвета = "all" Тогда
		// Ответ может быть обрезан клиентом, поэтому в начале ответа указывается размер данных.
		Возврат Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("## Вся база знаний одним текстом. %1. Если символов в полученном тексте меньше, чем указано в скобках, ответ обрезан MCP-клиентом: сохраните базу в файл (format='save_to_file', параметр file_path) или читайте её порциями (format='questions').%2%3"),
			MCPПодписьРазмераДанных(глКешБазыЗнаний, MCPРазмерБазыЗнанийБайт()), Символы.ПС, глКешБазыЗнаний);
	ИначеЕсли ФорматОтвета = "short_info" Тогда
		Возврат КороткаяИнформацияОБазеЗнаний();
	ИначеЕсли ФорматОтвета = "questions_only" Тогда
		Возврат ТолькоВопросыИзБазыЗнанийСНомерами();
	ИначеЕсли ФорматОтвета = "questions" Тогда
		Возврат ПолучитьОтветыНаВопросыПоНомерам(НомерВопроса);
	ИначеЕсли ФорматОтвета = "one_question" Тогда
		Возврат ПолучитьОтветНаОдинВопрос(НомерВопроса);
	ИначеЕсли ФорматОтвета = "question_search" Тогда
		Возврат ПоискПоВопросам(СтрокаПоиска);
	ИначеЕсли ФорматОтвета = "answers_search" Тогда
		Возврат ПоискПоОтветам(СтрокаПоиска);
	ИначеЕсли ФорматОтвета = "save_to_file" Тогда
		Возврат СохранитьБазуЗнанийВФайл(ПутьКФайлу);
	Иначе
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Ванесса.Локализовать("Передано недопустимое значение параметра 'format'"));
	КонецЕсли;	
	
КонецФункции

// Разбирает строку номеров вопросов: "12", "10-15", "7,12,20-22", "5, 8-10".
// Возвращает структуру: Номера (массив чисел по возрастанию) и Ошибка (текст ошибки или "").
&НаКлиенте
Функция MCPРазобратьНомераВопросов(СтрокаНомеров, ВсегоВопросов) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Номера", Новый Массив);
	Результат.Вставить("Ошибка", "");
	
	Текст = СокрЛП(Строка(СтрокаНомеров));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Результат.Ошибка = Ванесса.Локализовать("Не указан параметр 'question_number'. Передайте номер, диапазон или перечисление номеров: '12', '10-15', '7,12,20-22'.");
		Возврат Результат;
	КонецЕсли;
	
	НаборНомеров = Новый Соответствие;
	Части = Ванесса._СтрРазделить(Текст, ",", Истина);
	Для Каждого ТекЧасть Из Части Цикл
		ТекЧасть = СокрЛП(ТекЧасть);
		Если НЕ ЗначениеЗаполнено(ТекЧасть) Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияДефиса = Найти(ТекЧасть, "-");
		Если ПозицияДефиса > 1 И ПозицияДефиса < СтрДлина(ТекЧасть) Тогда
			// Диапазон вида "10-15"
			НачалоДиапазона = MCPЦелоеЧислоИлиНеопределено(Лев(ТекЧасть, ПозицияДефиса - 1));
			КонецДиапазона = MCPЦелоеЧислоИлиНеопределено(Сред(ТекЧасть, ПозицияДефиса + 1));
			Если НачалоДиапазона = Неопределено ИЛИ КонецДиапазона = Неопределено Тогда
				Результат.Ошибка = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Не получилось разобрать диапазон номеров вопросов ""%1""."),
					ТекЧасть) + " " + Ванесса.Локализовать("Пример: '10-15' или '7,12,20-22'.");
				Возврат Результат;
			КонецЕсли;
			Если НачалоДиапазона > КонецДиапазона Тогда
				Результат.Ошибка = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("В диапазоне ""%1"" начало больше конца."),
					ТекЧасть);
				Возврат Результат;
			КонецЕсли;
			Для Номер = НачалоДиапазона По КонецДиапазона Цикл
				НаборНомеров.Вставить(Номер, Истина);
			КонецЦикла;
		Иначе
			Номер = MCPЦелоеЧислоИлиНеопределено(ТекЧасть);
			Если Номер = Неопределено Тогда
				Результат.Ошибка = Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Не получилось разобрать номер вопроса ""%1""."),
					ТекЧасть) + " " + Ванесса.Локализовать("Номера - целые числа, диапазон задаётся через дефис, перечисление - через запятую: '10-15', '7,12,20-22'.");
				Возврат Результат;
			КонецЕсли;
			НаборНомеров.Вставить(Номер, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если НаборНомеров.Количество() = 0 Тогда
		Результат.Ошибка = Ванесса.Локализовать("Не удалось разобрать номера вопросов. Примеры: '12', '10-15', '7,12,20-22'.");
		Возврат Результат;
	КонецЕсли;
	
	Для Номер = 1 По ВсегоВопросов Цикл
		Если НаборНомеров[Номер] <> Неопределено Тогда
			Результат.Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	
	// Номера, которых нет в базе знаний.
	Для Каждого ТекНомер Из НаборНомеров Цикл
		Если ТекНомер.Ключ < 1 ИЛИ ТекНомер.Ключ > ВсегоВопросов Тогда
			Результат.Ошибка = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("В базе знаний %1 вопросов, а запрошен номер %2."),
				XMLСтрока(ВсегоВопросов), XMLСтрока(ТекНомер.Ключ));
			Результат.Номера = Новый Массив;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPЦелоеЧислоИлиНеопределено(Знач Текст)
	
	Текст = СокрЛП(Строка(Текст));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Сч = 1 По СтрДлина(Текст) Цикл
		Если Найти("0123456789", Сред(Текст, Сч, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Число(Текст);
	
КонецФункции

// Ответы на вопросы по номерам/диапазонам: позволяет читать базу знаний порциями.
&НаКлиенте
Функция ПолучитьОтветыНаВопросыПоНомерам(СтрокаНомеров) Экспорт
	
	Вопросы = ПолучитьМассивВопросов();
	
	Разбор = MCPРазобратьНомераВопросов(СтрокаНомеров, Вопросы.Количество());
	Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Разбор.Ошибка);
	КонецЕсли;
	
	Номера = Разбор.Номера;
	
	Результат = Новый Массив;
	Для Каждого ТекНомер Из Номера Цикл
		ТекВопрос = Вопросы[ТекНомер - 1];
		Результат.Добавить("");
		Результат.Добавить("### " + ТекВопрос.ТекстВопросаБезОбработки);
		Для Каждого Стр Из ТекВопрос.Ответ Цикл
			Результат.Добавить(Стр);
		КонецЦикла;
	КонецЦикла;
	
	// Подсказка о следующей порции, если прочитана не вся база знаний.
	МаксимальныйНомер = Номера[Номера.Количество() - 1];
	Если МаксимальныйНомер < Вопросы.Количество() Тогда
		СледующийКонец = МаксимальныйНомер + 20;
		Если СледующийКонец > Вопросы.Количество() Тогда
			СледующийКонец = Вопросы.Количество();
		КонецЕсли;
		Результат.Добавить("");
		Результат.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("## Следующая порция: format='questions', question_number='%1-%2'."),
			XMLСтрока(МаксимальныйНомер + 1), XMLСтрока(СледующийКонец)));
	КонецЕсли;
	
	ТелоОтвета = Ванесса._СтрСоединить(Результат, Символы.ПС);
	ТекстЗаголовка = Ванесса.ПодставитьПараметрыВСтроку(
		Ванесса.Локализовать("## Ответы на вопросы: %1 шт. Всего вопросов в базе знаний: %2. %3"),
		XMLСтрока(Номера.Количество()), XMLСтрока(Вопросы.Количество()), MCPПодписьРазмераДанных(ТелоОтвета));
	
	Возврат ТекстЗаголовка + Символы.ПС + ТелоОтвета;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОтветНаОдинВопрос(НомерВопроса) Экспорт
	
	Вопросы = ПолучитьМассивВопросов();
	
	Разбор = MCPРазобратьНомераВопросов(НомерВопроса, Вопросы.Количество());
	Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", Разбор.Ошибка);
	КонецЕсли;
	
	Если Разбор.Номера.Количество() <> 1 Тогда
		ТекстСообщения = Ванесса.Локализовать("Для format='one_question' нужно передать ровно один номер вопроса. Для нескольких номеров или диапазона используйте format='questions'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	ТекВопрос = Вопросы[Разбор.Номера[0] - 1];
	Результат = Новый Массив;
	Результат.Добавить(ТекВопрос.ТекстВопросаБезОбработки);
	Для Каждого Стр Из ТекВопрос.Ответ Цикл
		Результат.Добавить(Стр);
	КонецЦикла;	
	
	ТелоОтвета = Ванесса._СтрСоединить(Результат, Символы.ПС);
	ТекстЗаголовка = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Ответ на вопрос №%1. %2"),
		XMLСтрока(Разбор.Номера[0]), MCPПодписьРазмераДанных(ТелоОтвета));
	
	Возврат ТекстЗаголовка + Символы.ПС + ТелоОтвета;

КонецФункции

&НаКлиенте
Функция КороткаяИнформацияОБазеЗнаний() Экспорт
	
	Вопросы = ПолучитьМассивВопросов();
	КолВопросов = Вопросы.Количество();
	
	Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Количество вопросов: %1, размер базы знаний: %2 символов (%3 байт UTF-8)"),
		XMLСтрока(КолВопросов), XMLСтрока(СтрДлина(глКешБазыЗнаний)), XMLСтрока(MCPРазмерБазыЗнанийБайт()));
	
КонецФункции

&НаКлиенте
Функция ТолькоВопросыИзБазыЗнанийСНомерами() Экспорт
	
	Вопросы = ПолучитьМассивВопросов();
	КолВопросов = Вопросы.Количество();
	
	Результат = Новый Массив;
	Для Каждого ТекВопрос Из Вопросы Цикл
		Результат.Добавить(xmlСтрока(ТекВопрос.Номер) + ". " + ТекВопрос.Текст);
	КонецЦикла;	
	
	ТелоОтвета = Ванесса._СтрСоединить(Результат, Символы.ПС);
	ТекстЗаголовка = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Количество вопросов: %1. %2"),
		XMLСтрока(КолВопросов), MCPПодписьРазмераДанных(ТелоОтвета));
	
	Возврат ТекстЗаголовка + Символы.ПС + ТелоОтвета;
	
КонецФункции

&НаКлиенте
Функция ПолучитьМассивВопросов() Экспорт
	
	Если глКешВопросов <> Неопределено Тогда
		Возврат глКешВопросов;
	КонецЕсли;	
	
	Вопросы = Новый Массив;
	
	СтрокаПоиска = ПолучитьСтрокуПоискаВопрос();
	КолВопросов = 0;
	МассивСтрок = Ванесса._СтрРазделить(глКешБазыЗнаний, Символы.ПС);
	Для Сч = 0 По МассивСтрок.Количество()-1 Цикл
		Стр_нрег = НРег(МассивСтрок[Сч]);
		
		Поз = Найти(Стр_нрег, СтрокаПоиска);
		Если Поз = 1 Тогда
			ТекстВопроса = СокрЛП(Сред(МассивСтрок[Сч], СтрДлина(СтрокаПоиска) + 1));
			КолВопросов = КолВопросов + 1;
			ДанныеВопроса = Новый Структура;
			ДанныеВопроса.Вставить("Номер", КолВопросов);
			ДанныеВопроса.Вставить("Текст", ТекстВопроса);
			ДанныеВопроса.Вставить("ТекстВопросаБезОбработки", МассивСтрок[Сч]);
			ДанныеВопроса.Вставить("НомерСтроки", Сч + 1); //Номер строки с которой начинается ответ
			ДанныеВопроса.Вставить("Ответ", Новый Массив);
			Вопросы.Добавить(ДанныеВопроса);
		КонецЕсли;	
	КонецЦикла;
	
	ДлинныйРазделитель = ДлинныйРазделитель();
	
	Для Каждого ТекВопрос Из Вопросы Цикл
		НомерСтроки = ТекВопрос.НомерСтроки - 1;
		Пока Истина Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > МассивСтрок.Количество() - 1 Тогда
				// Значит кончился файл
				Прервать;
			КонецЕсли;	
			Стр = МассивСтрок[НомерСтроки];
			
			Если Лев(НРег(СокрЛ(Стр)), СтрДлина(СтрокаПоиска)) = СтрокаПоиска Тогда
				// Значит найден следующий вопрос
				Прервать;
			ИначеЕсли Найти(НРег(Стр), ДлинныйРазделитель) > 0 Тогда
				// Значит найден разделитель
				Прервать;
			КонецЕсли;
			
			ТекВопрос.Ответ.Добавить(Стр);
		КонецЦикла;
	КонецЦикла;
	
	глКешВопросов = Вопросы;
	
	Возврат Вопросы;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуПоискаВопрос() Экспорт
	Возврат НРег(Ванесса.Локализовать("Вопрос:"));
КонецФункции	

&НаКлиенте
Функция ПоискПоВопросам(СтрокаПоиска) Экспорт
	Если НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не корректно указан параметр 'search_string'."));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Массив_СтрокаПоиска = MCPПодготовитьВариантыТочногоПоиска(СтрокаПоиска);
	
	Вопросы = ПолучитьМассивВопросов();
	
	Результат = Новый Массив;
	КоличествоНайденных = 0;
	
	Для Каждого ТекВопрос Из Вопросы Цикл
		
		Если НайденоВхождениеЗначенияВМассиве(Массив_СтрокаПоиска, НРег(ТекВопрос.Текст)) Тогда
			Результат.Добавить("Вопрос №" + xmlСтрока(ТекВопрос.Номер));
			Результат.Добавить(ТекВопрос.Текст);
			Результат.Добавить("");
			КоличествоНайденных = КоличествоНайденных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ТелоОтвета = Ванесса._СтрСоединить(Результат, Символы.ПС);
	ТекстЗаголовка = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Результат поиска по вопросам. Найдено вопросов: %1. %2"),
		XMLСтрока(КоличествоНайденных), MCPПодписьРазмераДанных(ТелоОтвета));
	
	Возврат ТекстЗаголовка + Символы.ПС + ТелоОтвета;
	
КонецФункции

&НаКлиенте
Функция ПоискПоОтветам(СтрокаПоиска) Экспорт
	Если НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не корректно указан параметр 'search_string'."));
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Массив_СтрокаПоиска = MCPПодготовитьВариантыТочногоПоиска(СтрокаПоиска);
	
	Вопросы = ПолучитьМассивВопросов();
	
	Результат = Новый Массив;
	
	НайденныеВопросы = Новый Массив;
	
	Для Каждого ТекВопрос Из Вопросы Цикл
		
		Для Каждого СтрокаОтвета Из ТекВопрос.Ответ Цикл
			Если НайденоВхождениеЗначенияВМассиве(Массив_СтрокаПоиска, НРег(СтрокаОтвета)) Тогда
				НайденныеВопросы.Добавить(ТекВопрос);
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		
	КонецЦикла;
	
	Для Каждого ТекВопрос Из НайденныеВопросы Цикл
		Результат.Добавить("Вопрос №" + xmlСтрока(ТекВопрос.Номер));
		Результат.Добавить(ТекВопрос.ТекстВопросаБезОбработки);
		Для Каждого Стр Из ТекВопрос.Ответ Цикл
			Результат.Добавить(Стр);
		КонецЦикла;	
		Результат.Добавить("");
		Результат.Добавить("");
		Результат.Добавить("");
	КонецЦикла;	
	
	ТелоОтвета = Ванесса._СтрСоединить(Результат, Символы.ПС);
	ТекстЗаголовка = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("## Результат поиска по ответам. Найдено вопросов: %1. %2"),
		XMLСтрока(НайденныеВопросы.Количество()), MCPПодписьРазмераДанных(ТелоОтвета));
	
	Возврат ТекстЗаголовка + Символы.ПС + ТелоОтвета;
	
КонецФункции

&НаКлиенте
Функция ДлинныйРазделитель() Экспорт
	Возврат "-------------------------------------------------------------------------------------------------------------";
КонецФункции	

// Оценка размера текста в байтах UTF-8 (по кодовым точкам: 1, 2, 3 или 4 байта на символ).
&НаКлиенте
Функция MCPРазмерТекстаВБайтахUTF8(Текст) Экспорт
	
	Размер = 0;
	ДлинаТекста = СтрДлина(Текст);
	Для Сч = 1 По ДлинаТекста Цикл
		Код = КодСимвола(Текст, Сч);
		Если Код < 128 Тогда
			Размер = Размер + 1;
		ИначеЕсли Код < 2048 Тогда
			Размер = Размер + 2;
		ИначеЕсли Код < 65536 Тогда
			// Суррогатная половина символа вне BMP: 2 байта (пара дает 4 байта).
			Если Код >= 55296 И Код <= 57343 Тогда
				Размер = Размер + 2;
			Иначе
				Размер = Размер + 3;
			КонецЕсли;
		Иначе
			Размер = Размер + 4;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Размер;
	
КонецФункции

// Размер базы знаний в байтах UTF-8. Считается один раз и кэшируется.
&НаКлиенте
Функция MCPРазмерБазыЗнанийБайт() Экспорт
	Если глРазмерБазыЗнанийБайт = Неопределено Тогда
		глРазмерБазыЗнанийБайт = MCPРазмерТекстаВБайтахUTF8(глКешБазыЗнаний);
	КонецЕсли;
	Возврат глРазмерБазыЗнанийБайт;
КонецФункции

// Строка с размером переданных данных (тела ответа, без служебного заголовка) для заголовка ответа. Если РазмерБайт не передан - считается по тексту.
&НаКлиенте
Функция MCPПодписьРазмераДанных(Текст, РазмерБайт = Неопределено) Экспорт
	Если РазмерБайт = Неопределено Тогда
		РазмерБайт = MCPРазмерТекстаВБайтахUTF8(Текст);
	КонецЕсли;
	Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Размер данных: %1 байт (%2 символов)"),
		XMLСтрока(РазмерБайт), XMLСтрока(СтрДлина(Текст)));
КонецФункции

// Записывает всю базу знаний в текстовый файл в кодировке UTF-8. Путь к файлу указывает вызывающая сторона.
&НаКлиенте
Функция СохранитьБазуЗнанийВФайл(ПутьКФайлу) Экспорт
	
	Запись = Неопределено;
	Попытка
		// Предварительное создание файла: при записи в существующий файл UTF-8 идет без BOM.
		Запись = Новый ЗаписьТекста(ПутьКФайлу, "Windows-1251", , Ложь);
		Запись.Закрыть();
		Запись = Неопределено;
		Запись = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8", , Истина, Символы.ПС);
		Запись.Записать(глКешБазыЗнаний);
		Запись.Закрыть();
		Запись = Неопределено;
		ФайлБазыЗнаний = Новый Файл(ПутьКФайлу);
		РазмерФайла = ФайлБазыЗнаний.Размер();
	Исключение
		Попытка
			Если Запись <> Неопределено Тогда
				Запись.Закрыть();
			КонецЕсли;
		Исключение
		КонецПопытки;
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не удалось записать базу знаний в файл '%1'."), ПутьКФайлу);
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстСообщения + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()));
	КонецПопытки;
	
	Вопросы = ПолучитьМассивВопросов();
	
	Возврат Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать(
		"# База знаний сохранена в файл
		|
		|- Файл: %1
		|- Размер файла: %2 байт
		|- Вопросов: %3"), ПутьКФайлу, XMLСтрока(РазмерФайла), XMLСтрока(Вопросы.Количество()));
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеМакетаЧастоИспользуемыеШаги() Экспорт
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектНаСервере.ПолучитьМакет("ЧастоИспользуемыеШаги").ПолучитьТекст();
КонецФункции	

&НаКлиенте
Функция ДанныеОЧастоИспользуемыхШагах(КоличествоВывод, КомпактныйВывод = Истина) Экспорт
	
	ШагиИзМассиваСнипетов = ШагиИзМассиваСнипетов();
	
	КоличествоВыводФактическое = КоличествоВывод;
	Если КоличествоВыводФактическое <= 0 ИЛИ КоличествоВыводФактическое > ШагиИзМассиваСнипетов.Количество() Тогда
		КоличествоВыводФактическое = ШагиИзМассиваСнипетов.Количество();
	КонецЕсли;

	Результат = Новый Массив;
	Результат.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("# Всего в статистике %1 шагов"),XMLСтрока(ШагиИзМассиваСнипетов.Количество())));
	Результат.Добавить(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("# Вывожу данные по %1 шагов"),XMLСтрока(КоличествоВыводФактическое)));
	Результат.Добавить("");
	Если КомпактныйВывод Тогда
		Результат.Добавить(Ванесса.Локализовать("- Режим вывода: компактный (без полных описаний). Для описаний используйте compact=false."));
		Результат.Добавить("");
	КонецЕсли;
	
	Счетчик = 0;
	Для Каждого ТекШаг Из ШагиИзМассиваСнипетов Цикл
		Счетчик = Счетчик + 1;
		
		Если КоличествоВывод > 0 И Счетчик > КоличествоВывод Тогда
			Прервать;
		КонецЕсли;
		
		Если КомпактныйВывод Тогда
			Результат.Добавить(Формат(Счетчик, "ЧГ=0; ЧН=0") + ". " + ТекШаг.Имя + " — " + ТекШаг.Тип + " — " + Ванесса.Локализовать("Сниппет: `") + ТекШаг.СтрокаДляПоиска + "`");
		Иначе
			Результат.Добавить(Ванесса.Локализовать("## Номер шага:") + " " + XMLСтрока(Счетчик));
			Результат.Добавить(Ванесса.Локализовать("## Тип:") + " " + ТекШаг.Тип);
			Результат.Добавить(Ванесса.Локализовать("## Представление шага:") + Символы.ПС + ТекШаг.Имя);
			Результат.Добавить(Ванесса.Локализовать("## Описание:") + Символы.ПС + ТекШаг.Описание);
			Результат.Добавить("");
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Ванесса._СтрСоединить(Результат, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция ШагиИзМассиваСнипетов() Экспорт
	МассивСнипетов = Ванесса._СтрРазделить(глЧастоИспользуемыеШаги, Символы.ПС);
	
	Кеш = Новый Соответствие;
	Для Каждого СтрокаТаблицаИзвестныхStepDefinition Из Ванесса.ТаблицаИзвестныхStepDefinition Цикл
		ДанныеШага = Новый Структура;
		ДанныеШага.Вставить("Имя", СтрокаТаблицаИзвестныхStepDefinition.ПредставлениеТеста);
		ДанныеШага.Вставить("Описание", СтрокаТаблицаИзвестныхStepDefinition.ОписаниеШага);
		ДанныеШага.Вставить("Тип", СтрокаТаблицаИзвестныхStepDefinition.ТипШага);
		ДанныеШага.Вставить("СтрокаДляПоиска", СтрокаТаблицаИзвестныхStepDefinition.СтрокаДляПоиска);
		
		Кеш.Вставить(НРег(СтрокаТаблицаИзвестныхStepDefinition.СтрокаДляПоиска), ДанныеШага);
	КонецЦикла;	
	
	Результат = Новый Массив;
	Для Каждого ТекСнипет Из МассивСнипетов Цикл
		ДанныеШага = Кеш[ТекСнипет];
		Если ДанныеШага = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(ДанныеШага);
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция MCPВсегоСтрокТабличнойЧасти(ТабличнаяЧасть)
	
	Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Свойство("ВсегоСтрок") Тогда
		Возврат Число(ТабличнаяЧасть.ВсегоСтрок);
	КонецЕсли;
	Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Свойство("ЗначениеТаблицы") Тогда
		Возврат ТабличнаяЧасть.ЗначениеТаблицы.Количество();
	КонецЕсли;
	Возврат 0;
	
КонецФункции

&НаКлиенте
Функция MCPОтборСтрокТабличнойЧастиЗадан(ТабличнаяЧасть)
	
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ТабличнаяЧасть.Свойство("ОтборСтрокЗадан") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТабличнаяЧасть.ОтборСтрокЗадан = Истина;
	
КонецФункции

&НаКлиенте
Функция MCPЗапрошеноСтрокИзТабличнойЧасти(ТабличнаяЧасть)
	
	Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Свойство("ЗапрошеноСтрок") Тогда
		Возврат Число(ТабличнаяЧасть.ЗапрошеноСтрок);
	КонецЕсли;
	Возврат MCPВсегоСтрокТабличнойЧасти(ТабличнаяЧасть);
	
КонецФункции

&НаКлиенте
Функция MCPВнеДиапазонаИзТабличнойЧасти(ТабличнаяЧасть)
	
	Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Свойство("ВнеДиапазона") Тогда
		Возврат ТабличнаяЧасть.ВнеДиапазона;
	КонецЕсли;
	Возврат Новый Массив;
	
КонецФункции

&НаКлиенте
Функция MCPЗапрошенныеСтрокиИзТабличнойЧасти(ТабличнаяЧасть)
	
	Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Свойство("ЗапрошенныеСтроки") Тогда
		Возврат Строка(ТабличнаяЧасть.ЗапрошенныеСтроки);
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция MCPПокрытиеИзТабличнойЧасти(ТабличнаяЧасть)
	
	Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Свойство("Покрытие") Тогда
		Возврат Строка(ТабличнаяЧасть.Покрытие);
	КонецЕсли;
	Возврат ?(MCPОтборСтрокТабличнойЧастиЗадан(ТабличнаяЧасть), "requested_rows", "all_rows");
	
КонецФункции

&НаКлиенте
Процедура MCPУстановитьСвойство(Структура, Имя, Значение)
	
	Если Структура.Свойство(Имя) Тогда
		Структура[Имя] = Значение;
	Иначе
		Структура.Вставить(Имя, Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура MCPЗаполнитьМетаданныеОтбораСтрок(ДанныеОбъекта, ПараметрыСтрок) Экспорт
	
	Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") ИЛИ НЕ ДанныеОбъекта.Свойство("ТабличныеЧасти") Тогда
		Возврат;
	КонецЕсли;
	
	ОтборЗадан = Ложь;
	Если ПараметрыСтрок <> Неопределено Тогда
		Если ПараметрыСтрок.Свойство("Задан") Тогда
			ОтборЗадан = ПараметрыСтрок.Задан = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
		ВсегоСтрок = MCPВсегоСтрокТабличнойЧасти(ТекТабличнаяЧасть);
		Если ОтборЗадан Тогда
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "Покрытие", "requested_rows");
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "ЗапрошеноСтрок", MCPКоличествоЗапрошенныхСтрок(ПараметрыСтрок));
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "ВнеДиапазона", MCPВнеДиапазона(ПараметрыСтрок, ВсегоСтрок));
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "ЗапрошенныеСтроки", MCPТекстОтбораСтрок(ПараметрыСтрок));
		Иначе
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "Покрытие", "all_rows");
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "ЗапрошеноСтрок", ВсегоСтрок);
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "ВнеДиапазона", Новый Массив);
			MCPУстановитьСвойство(ТекТабличнаяЧасть, "ЗапрошенныеСтроки", "");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что расширение действительно применило запрошенный отбор строк.
// Если JSON в ПараметрыОтбора не разобрался, форма расширения молча возвращает все строки,
// а метаданные ответа при этом утверждают, что отбор применён. Такой ответ отдавать нельзя.
&НаКлиенте
Функция MCPПроверитьПрименениеОтбораСтрок(ДанныеОбъекта, ПараметрыСтрок, ИмяТабличнойЧасти, ТекстОшибки)
	
	Если ПараметрыСтрок = Неопределено
			ИЛИ НЕ ПараметрыСтрок.Свойство("Задан")
			ИЛИ ПараметрыСтрок.Задан <> Истина Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") ИЛИ НЕ ДанныеОбъекта.Свойство("ТабличныеЧасти") Тогда
		ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension не вернуло данные табличной части для отбора строк.");
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
		Если НРег(СокрЛП(ТекТабличнаяЧасть.Имя)) <> НРег(СокрЛП(ИмяТабличнойЧасти)) Тогда
			Продолжить;
		КонецЕсли;
		Если MCPОтборСтрокТабличнойЧастиЗадан(ТекТабличнаяЧасть) Тогда
			Возврат Истина;
		КонецЕсли;
		ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension не применило отбор строк: значение поля ПараметрыОтбора не разобрано. Обновите расширение VAExtension до версии 1.43 или повторите вызов без row_numbers и row_ranges.");
		Возврат Ложь;
	КонецЦикла;
	
	ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension не вернуло запрошенную табличную часть. Проверьте значение tabular_section_name.");
	Возврат Ложь;
	
КонецФункции

// Признак того, что строка табличной части содержит хоть одно содержательное значение.
// НомерСтроки заполнен у любой строки, поэтому его не учитываем. Числа расширение передаёт
// строками ("0"), для них ЗначениеЗаполнено вернуло бы Истина, поэтому проверяем само число.
// Пустые дата и булево тоже не делают строку содержательной.
&НаКлиенте
Функция MCPСтрокаТабличнойЧастиЗаполнена(СтрокаТЧ)
	
	Для Каждого ТекРеквизит Из СтрокаТЧ Цикл
		ИмяРеквизита = "";
		Если ТекРеквизит.Свойство("Имя") Тогда
			ИмяРеквизита = ВРег(СокрЛП(Строка(ТекРеквизит.Имя)));
		КонецЕсли;
		Если ИмяРеквизита = "НОМЕРСТРОКИ" Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ТекРеквизит.Свойство("Значение") Тогда
			Значение = ТекРеквизит.Значение;
		КонецЕсли;
		Если Значение = Неопределено ИЛИ Значение = Null Тогда
			Продолжить;
		КонецЕсли;
		Тип = "";
		Если ТекРеквизит.Свойство("Тип") Тогда
			Тип = СокрЛП(Строка(ТекРеквизит.Тип));
		КонецЕсли;
		
		Если Тип = "Число" Тогда
			Попытка
				Если Число(Значение) <> 0 Тогда
					Возврат Истина;
				КонецЕсли;
			Исключение
				Если ЗначениеЗаполнено(Значение) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецПопытки;
		ИначеЕсли Тип = "Булево" Тогда
			Если Значение = Истина Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли Тип = "Дата" Тогда
			// От JSON дата приходит строкой; пустая дата — "0001-01-01T00:00:00".
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				Если ЗначениеЗаполнено(Значение) Тогда
					Возврат Истина;
				КонецЕсли;
			Иначе
				ЗначениеСтрокой = СокрЛП(Строка(Значение));
				Если ЗначениеЗаполнено(ЗначениеСтрокой) И Лев(ЗначениеСтрокой, 10) <> "0001-01-01" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Готовит строки и колонки табличной части для Markdown и JSON. Номера строк берутся
// из расширения (исходные позиции в объекте), а не перенумеровываются после отбора.
&НаКлиенте
Функция MCPПодготовитьДанныеТабличнойЧасти(ТабличнаяЧасть, ТолькоЗаполненные) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИменаКолонок", Новый Массив);
	Результат.Вставить("ТипыКолонок", Новый Соответствие);
	Результат.Вставить("ЗначенияСтрок", Новый Массив);
	Результат.Вставить("НомераСтрок", Новый Массив);
	Результат.Вставить("СтрокОтфильтровано", 0);
	Результат.Вставить("СтрокСериализовано", 0);
	
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ ТабличнаяЧасть.Свойство("ЗначениеТаблицы") Тогда
		Возврат Результат;
	КонецЕсли;
	ЗначениеТаблицы = ТабличнаяЧасть.ЗначениеТаблицы;
	Если ТипЗнч(ЗначениеТаблицы) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.СтрокСериализовано = ЗначениеТаблицы.Количество();
	
	// Имена колонок - объединение по всем строкам: набор реквизитов в строке может отличаться.
	ИменаКолонок = Результат.ИменаКолонок;
	ЕстьКолонка = Новый Соответствие;
	Для Каждого СтрокаТЧ Из ЗначениеТаблицы Цикл
		Для Каждого ТекРеквизит Из СтрокаТЧ Цикл
			Если ЕстьКолонка.Получить(ТекРеквизит.Имя) = Неопределено Тогда
				ЕстьКолонка.Вставить(ТекРеквизит.Имя, Истина);
				ИменаКолонок.Добавить(ТекРеквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	НомераИзРасширения = Неопределено;
	Если ТабличнаяЧасть.Свойство("НомераСтрок") Тогда
		Если ТипЗнч(ТабличнаяЧасть.НомераСтрок) = Тип("Массив")
				И ТабличнаяЧасть.НомераСтрок.Количество() = ЗначениеТаблицы.Количество() Тогда
			НомераИзРасширения = ТабличнаяЧасть.НомераСтрок;
		КонецЕсли;
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого СтрокаТЧ Из ЗначениеТаблицы Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если ТолькоЗаполненные Тогда
			Если НЕ MCPСтрокаТабличнойЧастиЗаполнена(СтрокаТЧ) Тогда
				Результат.СтрокОтфильтровано = Результат.СтрокОтфильтровано + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЗначенияПоИмени = Новый Соответствие;
		Для Каждого ТекРеквизит Из СтрокаТЧ Цикл
			ЗначенияПоИмени.Вставить(ТекРеквизит.Имя, ТекРеквизит.Значение);
		КонецЦикла;
		ЗначенияСтроки = Новый Массив;
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			ЗначенияСтроки.Добавить(ЗначенияПоИмени.Получить(ИмяКолонки));
		КонецЦикла;
		
		Результат.ЗначенияСтрок.Добавить(ЗначенияСтроки);
		Если НомераИзРасширения = Неопределено Тогда
			Результат.НомераСтрок.Добавить(Формат(НомерСтроки, "ЧГ=0; ЧН=0"));
		Иначе
			Результат.НомераСтрок.Добавить(Формат(НомераИзРасширения[НомерСтроки - 1], "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;
	
	Результат.ТипыКолонок = MCPТипыКолонокТаблицы(ЗначениеТаблицы, ИменаКолонок);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPСписокСтрокИлиПрочерк(Массив)
	
	Если Массив = Неопределено ИЛИ Массив.Количество() = 0 Тогда
		Возврат "—";
	КонецЕсли;
	Возврат Ванесса._СтрСоединить(Массив, ", ");
	
КонецФункции

&НаКлиенте
Функция MCPОтветРеквизитовОбъектаJSON(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные) Экспорт
	
	Если РежимДанных = "single_attribute" Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("format='json' не поддерживается для data_mode='single_attribute'. Используйте Markdown, data_mode='attributes_only' для реквизита шапки или data_mode='single_tabular_section' для колонки табличной части."));
	КонецЕсли;
	
	СтандартныеРеквизиты = Новый Массив;
	Если ДанныеОбъекта.Свойство("СтандартныеРеквизиты") Тогда
		СтандартныеРеквизиты = ДанныеОбъекта.СтандартныеРеквизиты;
	КонецЕсли;
	РеквизитыШапки = Новый Массив;
	Если ДанныеОбъекта.Свойство("РеквизитыШапки") Тогда
		РеквизитыШапки = ДанныеОбъекта.РеквизитыШапки;
	КонецЕсли;
	ТабличныеЧасти = Новый Массив;
	Если ДанныеОбъекта.Свойство("ТабличныеЧасти") Тогда
		Если ТипЗнч(ДанныеОбъекта.ТабличныеЧасти) = Тип("Массив") Тогда
			ТабличныеЧасти = ДанныеОбъекта.ТабличныеЧасти;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("schemaVersion", "1.1");
	Результат.Вставить("dataMode", РежимДанных);
	
	Если РежимДанных = "all" ИЛИ РежимДанных = "attributes_only" Тогда
		Результат.Вставить("standardAttributes", MCPРеквизитыВJSON(СтандартныеРеквизиты, ТолькоЗаполненные));
		Результат.Вставить("attributes", MCPРеквизитыВJSON(РеквизитыШапки, ТолькоЗаполненные));
	КонецЕсли;
	
	Если РежимДанных = "all" ИЛИ РежимДанных = "tabular_sections_only" ИЛИ РежимДанных = "single_tabular_section" Тогда
		ТолькоЗаполненныеДляТаблиц = ?(РежимДанных = "single_tabular_section", Ложь, ТолькоЗаполненные);
		ТабличныеЧастиJSON = Новый Массив;
		Для Каждого ТекТабличнаяЧасть Из ТабличныеЧасти Цикл
			Если РежимДанных = "single_tabular_section"
					И НРег(СокрЛП(ТекТабличнаяЧасть.Имя)) <> НРег(СокрЛП(ИмяТабличнойЧасти)) Тогда
				Продолжить;
			КонецЕсли;
			ТабличныеЧастиJSON.Добавить(MCPТабличнаяЧастьВJSON(ТекТабличнаяЧасть, ТолькоЗаполненныеДляТаблиц));
		КонецЦикла;
		
		Если РежимДанных = "single_tabular_section" И ТабличныеЧастиJSON.Количество() = 0 Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
				Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Табличная часть '%1' не найдена в объекте."), ИмяТабличнойЧасти));
		КонецЕсли;
		
		Результат.Вставить("tabularSections", ТабличныеЧастиJSON);
	КонецЕсли;
	
	ТекстJSON = MCPТекстJSONРеквизитов(Результат);
	Если НЕ ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			Ванесса.Локализовать("Не удалось сформировать JSON-ответ."));
	КонецЕсли;
	Возврат ТекстJSON;
	
КонецФункции

&НаКлиенте
Функция MCPРеквизитыВJSON(Реквизиты, ТолькоЗаполненные = Ложь)
	
	Результат = Новый Массив;
	Если Реквизиты = Неопределено ИЛИ ТипЗнч(Реквизиты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТекРеквизит Из Реквизиты Цикл
		Имя = "";
		Тип = "";
		Значение = "";
		Если ТекРеквизит.Свойство("Имя") Тогда
			Имя = ТекРеквизит.Имя;
		КонецЕсли;
		Если ТекРеквизит.Свойство("Тип") Тогда
			Тип = ТекРеквизит.Тип;
		КонецЕсли;
		Если ТекРеквизит.Свойство("Значение") Тогда
			Значение = ТекРеквизит.Значение;
		КонецЕсли;
		Если ТолькоЗаполненные И НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("name", Имя);
		Элемент.Вставить("type", Тип);
		Элемент.Вставить("value", Значение);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPТабличнаяЧастьВJSON(ТабличнаяЧасть, ТолькоЗаполненные)
	
	Подготовка = MCPПодготовитьДанныеТабличнойЧасти(ТабличнаяЧасть, ТолькоЗаполненные);
	ВсегоСтрок = MCPВсегоСтрокТабличнойЧасти(ТабличнаяЧасть);
	СтрокВозвращено = Подготовка.ЗначенияСтрок.Количество();
	ВнеДиапазона = MCPВнеДиапазонаИзТабличнойЧасти(ТабличнаяЧасть);
	
	Результат = Новый Структура;
	Результат.Вставить("name", ТабличнаяЧасть.Имя);
	Результат.Вставить("totalRows", ВсегоСтрок);
	Результат.Вставить("requestedRows", MCPЗапрошеноСтрокИзТабличнойЧасти(ТабличнаяЧасть));
	Результат.Вставить("rowsSerialized", Подготовка.СтрокСериализовано);
	Результат.Вставить("rowsReturned", СтрокВозвращено);
	Результат.Вставить("rowsFilteredOut", Подготовка.СтрокОтфильтровано);
	Результат.Вставить("outOfRange", ВнеДиапазона);
	Результат.Вставить("requested", MCPЗапрошенныеСтрокиИзТабличнойЧасти(ТабличнаяЧасть));
	Результат.Вставить("coverage", MCPПокрытиеИзТабличнойЧасти(ТабличнаяЧасть));
	Результат.Вставить("complete", (СтрокВозвращено = ВсегоСтрок) И (ВнеДиапазона.Количество() = 0));
	Результат.Вставить("truncated", Ложь);
	Результат.Вставить("columns", MCPКолонкиВJSON(Подготовка.ИменаКолонок, Подготовка.ТипыКолонок));
	Результат.Вставить("rows", MCPСтрокиВJSON(Подготовка.ИменаКолонок, Подготовка.ЗначенияСтрок, Подготовка.НомераСтрок));
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPКолонкиВJSON(ИменаКолонок, ТипыКолонок)
	
	Результат = Новый Массив;
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ТипКолонки = ТипыКолонок.Получить(ИмяКолонки);
		Если ТипКолонки = Неопределено Тогда
			ТипКолонки = "";
		КонецЕсли;
		Результат.Добавить(Новый Структура("name, type", ИмяКолонки, ТипКолонки));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPСтрокиВJSON(ИменаКолонок, ЗначенияСтрок, НомераСтрок)
	
	Результат = Новый Массив;
	Для Инд = 0 По ЗначенияСтрок.Количество() - 1 Цикл
		ЗначенияСтроки = Новый Структура;
		Для ИндКолонки = 0 По ИменаКолонок.Количество() - 1 Цикл
			Значение = Неопределено;
			Если ИндКолонки < ЗначенияСтрок[Инд].Количество() Тогда
				Значение = ЗначенияСтрок[Инд][ИндКолонки];
			КонецЕсли;
			ЗначенияСтроки.Вставить(ИменаКолонок[ИндКолонки], Значение);
		КонецЦикла;
		
		НомерСтроки = Инд + 1;
		Если Инд < НомераСтрок.Количество() Тогда
			Попытка
				НомерСтроки = Число(НомераСтрок[Инд]);
			Исключение
				НомерСтроки = Инд + 1;
			КонецПопытки;
		КонецЕсли;
		
		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("number", НомерСтроки);
		СтрокаJSON.Вставить("values", ЗначенияСтроки);
		Результат.Добавить(СтрокаJSON);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPДанныеДляJSONРеквизитов(Данные)
	
	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) = Тип("Null") Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") ИЛИ ТипЗнч(Данные) = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(MCPДанныеДляJSONРеквизитов(Элемент));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") ИЛИ ТипЗнч(Данные) = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, MCPДанныеДляJSONРеквизитов(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") ИЛИ ТипЗнч(Данные) = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(Строка(КлючИЗначение.Ключ), MCPДанныеДляJSONРеквизитов(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Данные;
	
КонецФункции

&НаКлиенте
Функция MCPТекстJSONРеквизитов(Данные)
	
	Попытка
		Возврат Ванесса.ЗаписатьОбъектJSON(MCPДанныеДляJSONРеквизитов(Данные));
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("MCP.Реквизиты.JSONОшибка", ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Формирует Markdown с реквизитами объекта. Используется и для данных открытой формы,
// и для данных, прочитанных по навигационной ссылке.
&НаКлиенте
Функция СформироватьMarkdownРеквизитовОбъекта(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные, ДобавитьЗаголовок = Истина)
	Строки = Новый Массив;
	Если ДобавитьЗаголовок Тогда
		Строки.Добавить(Ванесса.Локализовать("# Реквизиты объекта"));
		Строки.Добавить("");
	КонецЕсли;
	
	// Получаем реквизиты шапки
	Если РежимДанных = "all" ИЛИ РежимДанных = "attributes_only" ИЛИ РежимДанных = "single_attribute" Тогда
		Если РежимДанных = "single_attribute" Тогда
			//Получаем только указанный реквизит
			Нашли = Ложь;
			ТабличнаяЧастьРеквизита = Неопределено;
			Попытка
				Для Каждого ТекРеквизит Из ДанныеОбъекта.СтандартныеРеквизиты Цикл
					Если НРег(ТекРеквизит.Имя) = НРег(ИмяРеквизита) Тогда
						ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит);
						Нашли = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				
				Если НЕ Нашли Тогда
					Для Каждого ТекРеквизит Из ДанныеОбъекта.РеквизитыШапки Цикл
						Если НРег(ТекРеквизит.Имя) = НРег(ИмяРеквизита) Тогда
							ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит);
							Нашли = Истина;
							Прервать;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;	
				
				// В шапке реквизита не оказалось: возможно, это колонка табличной части.
				// Колонки видны у табличных частей, в которых есть хотя бы одна строка.
				Если НЕ Нашли Тогда
					Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
						Если ТекТабличнаяЧасть.ЗначениеТаблицы.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						Для Каждого ТекКолонка Из ТекТабличнаяЧасть.ЗначениеТаблицы[0] Цикл
							Если НРег(ТекКолонка.Имя) = НРег(ИмяРеквизита) Тогда
								ТабличнаяЧастьРеквизита = ТекТабличнаяЧасть;
								Нашли = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если Нашли Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;	
				
			Исключение
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Реквизит '%1' не найден в объекте.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), ИмяРеквизита);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецПопытки;
			
			Если Нашли И ТабличнаяЧастьРеквизита <> Неопределено Тогда
				// Реквизит - колонка табличной части: возвращаем содержимое первой строки.
				Строки.Добавить(Ванесса.Локализовать("## Реквизит: ") + ИмяРеквизита);
				Строки.Добавить("");
				Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Это колонка табличной части ""%1"". Всего строк: %2, показана первая строка."),
					ТабличнаяЧастьРеквизита.Имя, Формат(ТабличнаяЧастьРеквизита.ЗначениеТаблицы.Количество(), "ЧГ=0; ЧН=0")));
				Строки.Добавить("");
				ИменаКолонок = Новый Массив;
				ЗначенияСтроки = Новый Массив;
				Для Каждого ТекКолонка Из ТабличнаяЧастьРеквизита.ЗначениеТаблицы[0] Цикл
					ИменаКолонок.Добавить(ТекКолонка.Имя);
					ЗначенияСтроки.Добавить(ТекКолонка.Значение);
				КонецЦикла;
				ЗначенияСтрок = Новый Массив;
				ЗначенияСтрок.Добавить(ЗначенияСтроки);
				
				MCPВывестиТаблицуЗначенийВMarkdown(Строки, ИменаКолонок,
					MCPТипыКолонокТаблицы(ТабличнаяЧастьРеквизита.ЗначениеТаблицы, ИменаКолонок), ЗначенияСтрок);
				
				Строки.Добавить("");
				Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
					Ванесса.Локализовать("Чтобы получить все строки табличной части, вызовите инструмент с data_mode='single_tabular_section' и tabular_section_name='%1'."),
					ТабличнаяЧастьРеквизита.Имя));
			ИначеЕсли НЕ Нашли Тогда
				СтрокиДеталей = Новый Массив;
				СтрокиДеталей.Добавить(Ванесса.Локализовать("Табличные части объекта:"));
				Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
					СтрокиДеталей.Добавить("- " + ТекТабличнаяЧасть.Имя);
				КонецЦикла;
				СтрокиДеталей.Добавить("");
				СтрокиДеталей.Добавить(Ванесса.Локализовать("Реквизиты с похожими именами:"));
				ЕстьПохожие = Ложь;
				Для Каждого ТекРеквизит Из ДанныеОбъекта.СтандартныеРеквизиты Цикл
					Если Найти(НРег(ТекРеквизит.Имя), НРег(ИмяРеквизита)) > 0 Тогда
						СтрокиДеталей.Добавить("- " + ТекРеквизит.Имя);
						ЕстьПохожие = Истина;
					КонецЕсли;
				КонецЦикла;
				Для Каждого ТекРеквизит Из ДанныеОбъекта.РеквизитыШапки Цикл
					Если Найти(НРег(ТекРеквизит.Имя), НРег(ИмяРеквизита)) > 0 Тогда
						СтрокиДеталей.Добавить("- " + ТекРеквизит.Имя);
						ЕстьПохожие = Истина;
					КонецЕсли;
				КонецЦикла;
				Если НЕ ЕстьПохожие Тогда
					СтрокиДеталей.Добавить(Ванесса.Локализовать("- не найдено"));
				КонецЕсли;
				ТекстОшибки = MCPОформитьОшибку(
					Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Реквизит '%1' не найден ни среди реквизитов шапки, ни среди колонок табличных частей."), ИмяРеквизита),
					Ванесса.Локализовать("Проверьте имя реквизита. Колонки табличной части без строк в data_mode не видны: их состав смотрите через get_form_analysis (format='elements', only_table='<имя таблицы>')."),
					Ванесса._СтрСоединить(СтрокиДеталей, Символы.ПС));
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;	
			
		Иначе
			// Получаем все реквизиты шапки или все данные
			Строки.Добавить(Ванесса.Локализовать("## Реквизиты шапки"));
			Строки.Добавить("");
			
			Для Каждого ТекРеквизит Из ДанныеОбъекта.СтандартныеРеквизиты Цикл
				ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные);
			КонецЦикла;
			
			Для Каждого ТекРеквизит Из ДанныеОбъекта.РеквизитыШапки Цикл
				ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные);
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	// Получаем табличные части
	Если РежимДанных = "all" ИЛИ РежимДанных = "tabular_sections_only" ИЛИ РежимДанных = "single_tabular_section" Тогда
		Если РежимДанных = "single_tabular_section" Тогда
			// Получаем только указанную табличную часть
			Попытка
				
				Нашли = Ложь;
				Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
					Если НРег(ТекТабличнаяЧасть.Имя) = НРег(ИмяТабличнойЧасти) Тогда
						ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТекТабличнаяЧасть);
						Нашли = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				
			Исключение
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Табличная часть '%1' не найдена в объекте.") + " " + ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки()), ИмяТабличнойЧасти);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецПопытки;
			
			Если НЕ Нашли Тогда
				ТекстОшибки = Ванесса.Локализовать("Табличная часть '%1' не найдена в объекте.");
				ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(ТекстОшибки, ИмяТабличнойЧасти);
				Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
			КонецЕсли;	
			
		Иначе
			// Получаем все табличные части или все данные
			Строки.Добавить(Ванесса.Локализовать("## Табличные части"));
			Строки.Добавить("");
			
			Для Каждого ТекТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
				ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТекТабличнаяЧасть, ТолькоЗаполненные);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Читает и проверяет параметры режима чтения реквизитов: data_mode, attribute_name, tabular_section_name.
// Возвращает структуру (РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти) или Неопределено,
// в этом случае ТекстОшибки содержит готовый текст ошибки INVALID_PARAMS.
&НаКлиенте
Функция MCPПроверитьПараметрыЧтенияРеквизитов(Запрос, ТекстОшибки)
	
	// Режим data_mode (по умолчанию 'attributes_only' - только реквизиты шапки).
	// РежимДанныхЗадан различает "параметр не передан" и явное значение: по нему вызывающая
	// сторона отличает применение режима по умолчанию от явно переданного параметра.
	ЗначениеРежимаДанных = ЗначениеПараметраИзЗапроса(Запрос, "data_mode");
	РежимДанныхЗадан = НЕ (ЗначениеРежимаДанных = Неопределено ИЛИ ЗначениеРежимаДанных = Null ИЛИ ЗначениеРежимаДанных = "");
	РежимДанных = "attributes_only";
	Если РежимДанныхЗадан Тогда
		РежимДанных = НРег(СокрЛП(Строка(ЗначениеРежимаДанных)));
	КонецЕсли;
	
	// Проверка допустимого значения
	ДопустимыеРежимы = Новый Массив;
	ДопустимыеРежимы.Добавить("all");
	ДопустимыеРежимы.Добавить("attributes_only");
	ДопустимыеРежимы.Добавить("single_attribute");
	ДопустимыеРежимы.Добавить("tabular_sections_only");
	ДопустимыеРежимы.Добавить("single_tabular_section");
	
	Если ДопустимыеРежимы.Найти(РежимДанных) = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Недопустимое значение data_mode. Допустимые значения: 'all', 'attributes_only', 'single_attribute', 'tabular_sections_only', 'single_tabular_section'.");
		Возврат Неопределено;
	КонецЕсли;
	
	// Параметр attribute_name для режима single_attribute
	ИмяРеквизита = Строка(ЗначениеПараметраИзЗапроса(Запрос, "attribute_name"));
	Если РежимДанных = "single_attribute" И НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ТекстОшибки = Ванесса.Локализовать("Для режима data_mode='single_attribute' необходимо указать параметр attribute_name.");
		Возврат Неопределено;
	КонецЕсли;
	
	// Параметр tabular_section_name для режима single_tabular_section
	ИмяТабличнойЧасти = Строка(ЗначениеПараметраИзЗапроса(Запрос, "tabular_section_name"));
	Если РежимДанных = "single_tabular_section" И НЕ ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ТекстОшибки = Ванесса.Локализовать("Для режима data_mode='single_tabular_section' необходимо указать параметр tabular_section_name.");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, РежимДанныхЗадан", РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, РежимДанныхЗадан);
	
КонецФункции

// Разбирает row_numbers/row_ranges. Возвращает структуру с нормализованными
// строками для расширения и массивами для расчёта метаданных.
&НаКлиенте
Функция MCPРазобратьОтборСтрок(Запрос, РежимДанных, ИмяТабличнойЧасти, ТекстОшибки)
	
	Результат = Новый Структура;
	Результат.Вставить("Задан", Ложь);
	Результат.Вставить("Номера", Новый Массив);
	Результат.Вставить("Интервалы", Новый Массив);
	Результат.Вставить("НомераСтрок", "");
	Результат.Вставить("ДиапазоныСтрок", "");
	
	ЗначениеНомеров = ЗначениеПараметраИзЗапроса(Запрос, "row_numbers");
	Если ЗначениеНомеров = Неопределено ИЛИ ЗначениеНомеров = Null Тогда
		НомераТекст = "";
	Иначе
		НомераТекст = СокрЛП(Строка(ЗначениеНомеров));
	КонецЕсли;
	ЗначениеДиапазонов = ЗначениеПараметраИзЗапроса(Запрос, "row_ranges");
	Если ЗначениеДиапазонов = Неопределено ИЛИ ЗначениеДиапазонов = Null Тогда
		ДиапазоныТекст = "";
	Иначе
		ДиапазоныТекст = СокрЛП(Строка(ЗначениеДиапазонов));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НомераТекст) И НЕ ЗначениеЗаполнено(ДиапазоныТекст) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если РежимДанных <> "single_tabular_section" ИЛИ НЕ ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ТекстОшибки = Ванесса.Локализовать("Параметры row_numbers и row_ranges можно использовать только с data_mode='single_tabular_section' и заполненным tabular_section_name.");
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрДлина(НомераТекст) > 10000 ИЛИ СтрДлина(ДиапазоныТекст) > 10000 Тогда
		ТекстОшибки = Ванесса.Локализовать("Слишком длинное значение row_numbers или row_ranges. Максимум 10000 символов.");
		Возврат Неопределено;
	КонецЕсли;
	
	ЧастиНомеров = Ванесса._СтрРазделить(НомераТекст, ",", Истина);
	ЧастиДиапазонов = Ванесса._СтрРазделить(ДиапазоныТекст, ",", Истина);
	Если ЧастиНомеров.Количество() + ЧастиДиапазонов.Количество() > 1000 Тогда
		ТекстОшибки = Ванесса.Локализовать("Слишком много элементов в row_numbers и row_ranges. Максимум 1000.");
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Часть Из ЧастиНомеров Цикл
		Часть = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(Часть) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ MCPЭтоНатуральноеЧисло(Часть) Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Некорректный номер строки в row_numbers: ""%1"". Ожидается положительное целое число не более чем из 12 цифр."), Часть);
			Возврат Неопределено;
		КонецЕсли;
		Номер = Число(Часть);
		Если Результат.Номера.Найти(Номер) = Неопределено Тогда
			Результат.Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	MCPОтсортироватьЧисла(Результат.Номера);
	
	Для Каждого Часть Из ЧастиДиапазонов Цикл
		Часть = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(Часть) Тогда
			Продолжить;
		КонецЕсли;
		ПозицияДефиса = Ванесса._СтрНайти(Часть, "-");
		Если ПозицияДефиса = 0 Тогда
			ЛеваяЧасть = Часть;
			ПраваяЧасть = Часть;
		Иначе
			ЛеваяЧасть = СокрЛП(Лев(Часть, ПозицияДефиса - 1));
			ПраваяЧасть = СокрЛП(Сред(Часть, ПозицияДефиса + 1));
		КонецЕсли;
		Если НЕ MCPЭтоНатуральноеЧисло(ЛеваяЧасть) ИЛИ НЕ MCPЭтоНатуральноеЧисло(ПраваяЧасть) Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Некорректный диапазон строк в row_ranges: ""%1"". Ожидается N или N-M, где N и M - положительные целые не более чем из 12 цифр."), Часть);
			Возврат Неопределено;
		КонецЕсли;
		Начало = Число(ЛеваяЧасть);
		Конец = Число(ПраваяЧасть);
		Если Начало > Конец Тогда
			ТекстОшибки = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Начало диапазона больше конца в row_ranges: ""%1""."), Часть);
			Возврат Неопределено;
		КонецЕсли;
		Результат.Интервалы.Добавить(Новый Структура("Начало, Конец", Начало, Конец));
	КонецЦикла;
	
	MCPОбъединитьИнтервалы(Результат.Интервалы);
	Результат.Задан = Результат.Номера.Количество() > 0 ИЛИ Результат.Интервалы.Количество() > 0;
	Если НЕ Результат.Задан Тогда
		ТекстОшибки = Ванесса.Локализовать("В row_numbers и row_ranges не задано ни одного корректного номера строки.");
		Возврат Неопределено;
	КонецЕсли;
	Результат.НомераСтрок = MCPСоединитьЧислаЧерезЗапятую(Результат.Номера);
	Результат.ДиапазоныСтрок = MCPСоединитьИнтервалыЧерезЗапятую(Результат.Интервалы);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция MCPЭтоНатуральноеЧисло(Текст) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Ограничение длины защищает Число() от переполнения на экзотическом вводе.
	Если СтрДлина(Текст) > 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	КодНоль = КодСимвола("0");
	КодДевять = КодСимвола("9");
	Для Инд = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Инд);
		Если Код < КодНоль ИЛИ Код > КодДевять Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Текст) > 0;
	
КонецФункции

&НаКлиенте
Процедура MCPОтсортироватьЧисла(Числа)
	
	Если Числа.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	Для Инд = 1 По Числа.Количество() - 1 Цикл
		Текущий = Числа[Инд];
		Позиция = Инд - 1;
		Пока Позиция >= 0 Цикл
			Если Числа[Позиция] <= Текущий Тогда
				Прервать;
			КонецЕсли;
			Числа[Позиция + 1] = Числа[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Числа[Позиция + 1] = Текущий;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура MCPОбъединитьИнтервалы(Интервалы)
	
	Если Интервалы.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Для Инд = 1 По Интервалы.Количество() - 1 Цикл
		Текущий = Интервалы[Инд];
		Позиция = Инд - 1;
		Пока Позиция >= 0 Цикл
			Если Интервалы[Позиция].Начало <= Текущий.Начало Тогда
				Прервать;
			КонецЕсли;
			Интервалы[Позиция + 1] = Интервалы[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Интервалы[Позиция + 1] = Текущий;
	КонецЦикла;
	
	Объединённые = Новый Массив;
	Для Каждого Интервал Из Интервалы Цикл
		Если Объединённые.Количество() = 0 Тогда
			Объединённые.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Интервал.Конец));
			Продолжить;
		КонецЕсли;
		Последний = Объединённые[Объединённые.Количество() - 1];
		Если Интервал.Начало <= Последний.Конец + 1 Тогда
			Если Интервал.Конец > Последний.Конец Тогда
				Последний.Конец = Интервал.Конец;
			КонецЕсли;
		Иначе
			Объединённые.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Интервал.Конец));
		КонецЕсли;
	КонецЦикла;
	
	Интервалы.Очистить();
	Для Каждого Интервал Из Объединённые Цикл
		Интервалы.Добавить(Интервал);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция MCPНомерВходитВИнтервалы(Номер, Интервалы)
	
	Для Каждого Интервал Из Интервалы Цикл
		Если Номер >= Интервал.Начало И Номер <= Интервал.Конец Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция MCPКоличествоЗапрошенныхСтрок(ПараметрыСтрок)
	
	Количество = 0;
	Для Каждого Интервал Из ПараметрыСтрок.Интервалы Цикл
		Количество = Количество + Интервал.Конец - Интервал.Начало + 1;
	КонецЦикла;
	Для Каждого Номер Из ПараметрыСтрок.Номера Цикл
		Если НЕ MCPНомерВходитВИнтервалы(Номер, ПараметрыСтрок.Интервалы) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

&НаКлиенте
Функция MCPВнеДиапазона(ПараметрыСтрок, ВсегоСтрок)
	
	Результат = Новый Массив;
	Для Каждого Номер Из ПараметрыСтрок.Номера Цикл
		Если Номер > ВсегоСтрок Тогда
			Результат.Добавить(Формат(Номер, "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Интервал Из ПараметрыСтрок.Интервалы Цикл
		Если Интервал.Начало > ВсегоСтрок Тогда
			Результат.Добавить(Формат(Интервал.Начало, "ЧГ=0; ЧН=0") + "-" + Формат(Интервал.Конец, "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Текст отбора для метаданных requested. Номера и диапазоны объединяем в один набор
// интервалов: иначе комбинация row_numbers='1,3' и row_ranges='2-4' давала бы "1,3,2-4"
// вместо нормализованного "1-4".
&НаКлиенте
Функция MCPТекстОтбораСтрок(ПараметрыСтрок)
	
	Интервалы = Новый Массив;
	Если ПараметрыСтрок.Свойство("Номера") Тогда
		Для Каждого Номер Из ПараметрыСтрок.Номера Цикл
			Интервалы.Добавить(Новый Структура("Начало, Конец", Номер, Номер));
		КонецЦикла;
	КонецЕсли;
	Если ПараметрыСтрок.Свойство("Интервалы") Тогда
		Для Каждого Интервал Из ПараметрыСтрок.Интервалы Цикл
			Интервалы.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Интервал.Конец));
		КонецЦикла;
	КонецЕсли;
	MCPОбъединитьИнтервалы(Интервалы);
	Возврат MCPСоединитьИнтервалыЧерезЗапятую(Интервалы);
	
КонецФункции

&НаКлиенте
Функция MCPСоединитьЧислаЧерезЗапятую(Числа)
	
	Части = Новый Массив;
	Для Каждого ТекЧисло Из Числа Цикл
		Части.Добавить(Формат(ТекЧисло, "ЧГ=0; ЧН=0"));
	КонецЦикла;
	Возврат Ванесса._СтрСоединить(Части, ",");
	
КонецФункции

&НаКлиенте
Функция MCPСоединитьИнтервалыЧерезЗапятую(Интервалы)
	
	Части = Новый Массив;
	Для Каждого Интервал Из Интервалы Цикл
		Если Интервал.Начало = Интервал.Конец Тогда
			Части.Добавить(Формат(Интервал.Начало, "ЧГ=0; ЧН=0"));
		Иначе
			Части.Добавить(Формат(Интервал.Начало, "ЧГ=0; ЧН=0") + "-" + Формат(Интервал.Конец, "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;
	Возврат Ванесса._СтрСоединить(Части, ",");
	
КонецФункции

// Возвращает значения реквизитов объекта связанного с формой
&НаКлиенте
Функция ПолучитьРеквизитыОбъекта(Запрос, ДополнительныеПараметры) Экспорт
	
	ТекстОшибкиПараметров = "";
	ПараметрыЧтения = MCPПроверитьПараметрыЧтенияРеквизитов(Запрос, ТекстОшибкиПараметров);
	Если ПараметрыЧтения = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиПараметров);
	КонецЕсли;
	РежимДанных = ПараметрыЧтения.РежимДанных;
	ИмяРеквизита = ПараметрыЧтения.ИмяРеквизита;
	ИмяТабличнойЧасти = ПараметрыЧтения.ИмяТабличнойЧасти;
	
	// Получаем параметр only_filled (по умолчанию true - только заполненные реквизиты)
	ТолькоЗаполненные = ЗначениеПараметраИзЗапроса(Запрос, "only_filled");
	Если ТолькоЗаполненные = Неопределено ИЛИ ТолькоЗаполненные = Null ИЛИ ТолькоЗаполненные = "" Тогда
		ТолькоЗаполненные = Истина;
	Иначе
		Попытка
			ТолькоЗаполненные = Булево(ТолькоЗаполненные);
		Исключение
			ТолькоЗаполненные = Истина;
		КонецПопытки;
	КонецЕсли;
	
	// Формат ответа: Markdown (по умолчанию) или JSON.
	ЗначениеФормата = ЗначениеПараметраИзЗапроса(Запрос, "format");
	Если ЗначениеФормата = Неопределено ИЛИ ЗначениеФормата = Null Тогда
		Формат = "markdown";
	Иначе
		Формат = НРег(СокрЛП(Строка(ЗначениеФормата)));
		Если НЕ ЗначениеЗаполнено(Формат) Тогда
			Формат = "markdown";
		КонецЕсли;
	КонецЕсли;
	Если Формат <> "markdown" И Формат <> "json" Тогда
		ТекстОшибкиПараметров = Ванесса.Локализовать("Недопустимое значение format. Допустимые значения: 'markdown', 'json'.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиПараметров);
	КонецЕсли;
	Если Формат = "json" И РежимДанных = "single_attribute" Тогда
		ТекстОшибкиПараметров = Ванесса.Локализовать("format='json' не поддерживается для data_mode='single_attribute'. Используйте Markdown, data_mode='attributes_only' для реквизита шапки или data_mode='single_tabular_section' для колонки табличной части.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиПараметров);
	КонецЕсли;
	
	// Отбор строк табличной части (row_numbers/row_ranges). Разбирается только здесь:
	// get_table_data эти параметры не поддерживает и явно отклоняет их.
	ПараметрыСтрок = MCPРазобратьОтборСтрок(Запрос, РежимДанных, ИмяТабличнойЧасти, ТекстОшибкиПараметров);
	Если ПараметрыСтрок = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиПараметров);
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИмяТабличнойЧасти", ?(РежимДанных = "single_tabular_section", ИмяТабличнойЧасти, ""));
	ПараметрыОтбора.Вставить("НомераСтрок", ПараметрыСтрок.НомераСтрок);
	ПараметрыОтбора.Вставить("ДиапазоныСтрок", ПараметрыСтрок.ДиапазоныСтрок);
	ПараметрыОтбора.Вставить("ОтборСтрокЗадан", ПараметрыСтрок.Задан);
	ПараметрыОтбора.Вставить("БезТабличныхЧастей", РежимДанных = "attributes_only");
	
	// Если передана навигационная ссылка, объект читается из базы: открытая форма не нужна,
	// а режимы data_mode/attribute_name/tabular_section_name/only_filled применяются к прочитанным данным.
	НавигационнаяСсылка = Строка(ЗначениеПараметраИзЗапроса(Запрос, "navigationLink"));
	Если ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
		Возврат ПолучитьРеквизитыОбъектаПоНавигационнойСсылке(
			НавигационнаяСсылка, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные,
			Истина, ПараметрыОтбора, ПараметрыСтрок, Формат);
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	ТекстОшибки = Неопределено;
	КодОшибки = "";
	ДанныеОбъекта = ДанныеОбъектаИзУказанногоОкна(АктивноеОкно.Заголовок, ТекстОшибки, ПараметрыОтбора, КодОшибки);
	// Следующий вызов инструмента ищет окно по активному: возвращаем фокус окну,
	// из которого прочитаны данные, - иначе он прочитает другой объект или не найдёт окно.
	ВернутьФокусОкнуОбъекта(АктивноеОкно);
	
	// Старое расширение не умеет отбор строк. Это отдельная причина, её нельзя
	// маскировать подсказкой про форму списка.
	Если КодОшибки = "OLD_EXTENSION" Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPОформитьОшибку(
				MCPСутьОшибкиИзТекста(ТекстОшибки),
				Ванесса.Локализовать("Отбор строк поддерживает расширение VAExtension версии 1.43 и выше. Обновите расширение VAExtension в клиенте тестирования или вызовите инструмент без row_numbers и row_ranges."),
				MCPДеталиОшибкиИзТекста(ТекстОшибки)));
	КонецЕсли;
	
	// Расширение может не вернуть данные объекта (конверт ошибки или сбой разбора):
	// без структуры объекта читать её поля нельзя.
	Если НЕ ЗначениеЗаполнено(ТекстОшибки)
			И (ТипЗнч(ДанныеОбъекта) <> Тип("Структура") ИЛИ НЕ ДанныеОбъекта.Свойство("СтандартныеРеквизиты")) Тогда
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные объекта из текущего окна.");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED",
			MCPОформитьОшибку(
				MCPСутьОшибкиИзТекста(ТекстОшибки),
				Ванесса.Локализовать("Инструмент читает реквизиты объекта только у форм объектов (Справочник, Документ, План видов характеристик и т.п.). Если открыта форма списка, передайте navigationLink (ссылку возвращает get_table_data) - реквизиты будут прочитаны из базы по ссылке; также подойдут get_table_data (object_type + object_name) или get_form_analysis."),
				MCPДеталиОшибкиИзТекста(ТекстОшибки)));
	КонецЕсли;
	
	MCPЗаполнитьМетаданныеОтбораСтрок(ДанныеОбъекта, ПараметрыСтрок);
	ТекстОшибки = "";
	Если НЕ MCPПроверитьПрименениеОтбораСтрок(ДанныеОбъекта, ПараметрыСтрок, ИмяТабличнойЧасти, ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Формируем результат
	Если Формат = "json" Тогда
		Возврат MCPОтветРеквизитовОбъектаJSON(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные);
	КонецЕсли;
	Возврат СформироватьMarkdownРеквизитовОбъекта(ДанныеОбъекта, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные);
	
КонецФункции

&НаКлиенте
Функция MCPУстановитьПараметрыОтбораВСлужебнойФорме(НужнаяФорма, ДопПараметрыПоиска, ПараметрыОтбора, ТекстОшибки) Экспорт
	
	Реквизит = Неопределено;
	Попытка
		Реквизит = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ПараметрыОтбора", Истина, Истина, , ДопПараметрыПоиска);
	Исключение
		Реквизит = Неопределено;
	КонецПопытки;
	
	ОтборЗадан = Ложь;
	Если ПараметрыОтбора <> Неопределено Тогда
		Если ПараметрыОтбора.Свойство("ОтборСтрокЗадан") Тогда
			ОтборЗадан = ПараметрыОтбора.ОтборСтрокЗадан = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Старое расширение не умеет отбор строк: без отбора работаем как раньше,
	// с отбором - сообщаем, что нужно обновить VAExtension.
	Если Реквизит = Неопределено Тогда
		Если ОтборЗадан Тогда
			ТекстОшибки = Ванесса.Локализовать("Расширение VAExtension не поддерживает отбор строк (нет поля ПараметрыОтбора). Обновите расширение VAExtension до версии 1.43 или выше.");
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыJSON = "{}";
	Если ПараметрыОтбора <> Неопределено Тогда
		ПараметрыJSON = MCPЗаписатьОбъектJSONВОднуСтроку(ПараметрыОтбора);
	КонецЕсли;
	Реквизит.ВвестиТекст(ПараметрыJSON);
	Возврат Истина;
	
КонецФункции

// JSON для ввода в однострочное поле формы (ПараметрыОтбора служебных форм расширения).
// Глобальный ЗаписатьJSON форматирует вывод переводами строк, а многострочный текст,
// введённый в однострочное поле, не доходит до реквизита формы: отбор молча игнорируется
// (в форме данных объекта) или падает на разборе JSON (при чтении по навигационной ссылке).
// ПереносСтрокJSON.Нет отключает форматирование штатными параметрами записи JSON.
&НаКлиенте
Функция MCPЗаписатьОбъектJSONВОднуСтроку(Данные)
	
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаКлиенте
Функция ДанныеОбъектаИзУказанногоОкна(ЗаголовокОкна, ТекстОшибки, ПараметрыОтбора = Неопределено, КодОшибки = "") Экспорт
	Ванесса.ОткрытьНавигационнуюСсылку("e1cib/app/Обработка.VAExtension_ДанныеРеквизитовОбъекта");
	ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
	НужнаяФорма = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемаяФорма"),, "*.VAExtension_ДанныеРеквизитовОбъекта.*",5);
	Если НужнаяФорма = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Клиент тестирования подключён, но не найдена форма 'VAExtension_ДанныеРеквизитовОбъекта' из служебного расширения.");
		Возврат Неопределено
	КонецЕсли;	
	
	// Поля служебной формы ищем в самой найденной форме: активным окном остаётся форма пользователя,
	// поэтому поиск «в активном окне» поля служебной формы не находит.
	ДопПараметрыПоиска = Новый Структура("КонтейнерДляПоиска", НужнаяФорма);
	РеквизитВыражениеВычислено = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ОбработкаВыполнена", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитЗаголовокОкна = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗаголовокОкна", Истина, Истина, , ДопПараметрыПоиска);
	РеквизитЗаголовокОкна.ВвестиТекст(ЗаголовокОкна);
	
	КнопкаВыполнитьОбработку = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ФормаВыполнитьОбработку");
	
	КнопкаЗакрытьФорму = НужнаяФорма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"),,"ЗакрытьФорму");
	
	Если НЕ MCPУстановитьПараметрыОтбораВСлужебнойФорме(НужнаяФорма, ДопПараметрыПоиска, ПараметрыОтбора, ТекстОшибки) Тогда
		КодОшибки = "OLD_EXTENSION";
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		Возврат Неопределено
	КонецЕсли;
	
	КнопкаВыполнитьОбработку.Нажать();
	
	БылаОшибка = Истина;
	Ванесса.ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено);
	
	Если БылаОшибка Тогда
		ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные объекта из текущего окна.");
		Возврат Неопределено
	КонецЕсли;
	
	РеквизитЗначениеДляВозврата = Ванесса.НайтиРеквизитОткрытойФормыПоЗаголовку("ЗначениеРезультат", Истина, Истина, , ДопПараметрыПоиска);
	ПредставлениеРезультата = Ванесса.ПолучитьПредставлениеДанныхЭлементаФормы(РеквизитЗначениеДляВозврата);
	
	Данные = Неопределено;
	Попытка
		Данные = Ванесса.ПрочитатьОбъектJSON(ПредставлениеРезультата);
	Исключение
		Ванесса.ЗаписатьЛогВЖРИнформация("ДанныеОбъектаИзУказанногоОкна", ОписаниеОшибки());
	КонецПопытки;
	
	ЗакрытьФормуПолученияДанных(КнопкаЗакрытьФорму);

	// Расширение возвращает ошибку конвертом {"ОшибкаВыполнения": "..."}.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ОшибкаВыполнения") Тогда
		ТекстОшибки = Данные.ОшибкаВыполнения;
		Возврат Неопределено
	КонецЕсли;

	Если Данные = Неопределено Тогда
		ТекстОшибки = Ванесса.Локализовать("Не вышло получить данные объекта из текущего окна.");
		Возврат Неопределено
	КонецЕсли;

	Возврат Данные;
КонецФункции	

// Возвращает фокус окну, из которого читались данные: после служебной формы активным может
// стать другое окно, и следующий вызов прочитает чужой объект. Активизируем, только если
// это окно не активно. ОкнуОбъекта - окно, полученное в начале вызова инструмента.
&НаКлиенте
Процедура ВернутьФокусОкнуОбъекта(Знач ОкнуОбъекта) Экспорт
	
	Попытка
		Если ОкнуОбъекта = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗаголовокОкна = Строка(ОкнуОбъекта.Заголовок);
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
		Если АктивноеОкно <> Неопределено
				И НРег(СокрЛП(Строка(АктивноеОкно.Заголовок))) = НРег(СокрЛП(Строка(ЗаголовокОкна))) Тогда
			Возврат;
		КонецЕсли;
		
		ЗаголовокНужногоОкна = НРег(СокрЛП(ЗаголовокОкна));
		
		// Платформа может не переключить окно без ошибки - проверяем фактически активное окно
		Для Сч = 1 По 3 Цикл
			Попытка
				ОкнуОбъекта.Активизировать();
			Исключение
				// Ссылка на окно могла устареть - ищем по заголовку
				ТестовоеПриложение = Ванесса.ПолучитьТестовоеПриложение();
				ОкнуОбъекта = ТестовоеПриложение.НайтиОбъект(Тип("ТестируемоеОкноКлиентскогоПриложения"), ЗаголовокОкна);
				Если ОкнуОбъекта = Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецПопытки;
			Попытка
				АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
				Активировалось = АктивноеОкно <> Неопределено И НРег(СокрЛП(Строка(АктивноеОкно.Заголовок))) = ЗаголовокНужногоОкна;
			Исключение
				Активировалось = Ложь;
			КонецПопытки;
			Если Активировалось Тогда
				// Сбрасываем кэш активного окна, иначе дальнейшие действия пойдут в прежнем окне
				Ванесса.ОбработатьСменуАктивногоОкна();
				Возврат;
			КонецЕсли;
			Ванесса.sleep(1);
		КонецЦикла;
		// Активизировать не удалось: следующий вызов инструмента может не найти окно объекта
		Ванесса.ЗаписатьЛогВЖРИнформация("ВернутьФокусОкнуОбъекта", "Не удалось активизировать окно: " + ЗаголовокОкна);
	Исключение
		// Окно могло быть закрыто - данные уже прочитаны, ошибку инструмента не выдаём
		Ванесса.ЗаписатьЛогВЖРИнформация("ВернутьФокусОкнуОбъекта", ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРеквизитКВыводуВMarkdown(Строки, ТекРеквизит, ТолькоЗаполненные = Ложь) Экспорт
	ЗначениеРеквизита = ТекРеквизит.Значение;
	ТипРеквизита = ТекРеквизит.Тип;
	
	// Если установлен флаг ТолькоЗаполненные и значение пустое - пропускаем реквизит
	Если ТолькоЗаполненные И НЕ ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	Строки.Добавить("- " + ТекРеквизит.Имя + " (" + ТипРеквизита + "): " + MCPПредставлениеЗначенияДляMarkdown(ЗначениеРеквизита));
КонецПроцедуры

&НаКлиенте
Процедура MCPВывестиМетаданныеОтбораСтрокВMarkdown(Строки, ТабличнаяЧасть, СтрокВозвращено, СтрокОтфильтровано)
	
	ВсегоСтрок = MCPВсегоСтрокТабличнойЧасти(ТабличнаяЧасть);
	Если НЕ MCPОтборСтрокТабличнойЧастиЗадан(ТабличнаяЧасть) Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("## Табличная часть: %1 (строк: %2)"),
			ТабличнаяЧасть.Имя, Формат(ВсегоСтрок, "ЧГ=0; ЧН=0")));
		Строки.Добавить("");
		Возврат;
	КонецЕсли;
	
	Покрытие = MCPПокрытиеИзТабличнойЧасти(ТабличнаяЧасть);
	Строки.Добавить(Ванесса.Локализовать("## Табличная часть: ") + ТабличнаяЧасть.Имя);
	Строки.Добавить("");
	Строки.Добавить("- " + Ванесса.Локализовать("Всего строк:") + " " + Формат(ВсегоСтрок, "ЧГ=0; ЧН=0"));
	Строки.Добавить("- " + Ванесса.Локализовать("Запрошено строк:") + " "
		+ Формат(MCPЗапрошеноСтрокИзТабличнойЧасти(ТабличнаяЧасть), "ЧГ=0; ЧН=0")
		+ ?(ЗначениеЗаполнено(MCPЗапрошенныеСтрокиИзТабличнойЧасти(ТабличнаяЧасть)),
			" (" + MCPЗапрошенныеСтрокиИзТабличнойЧасти(ТабличнаяЧасть) + ")", ""));
	Строки.Добавить("- " + Ванесса.Локализовать("Возвращено строк:") + " " + Формат(СтрокВозвращено, "ЧГ=0; ЧН=0"));
	ВнеДиапазона = MCPВнеДиапазонаИзТабличнойЧасти(ТабличнаяЧасть);
	Строки.Добавить("- " + Ванесса.Локализовать("Вне диапазона:") + " " + MCPСписокСтрокИлиПрочерк(ВнеДиапазона));
	Неполно = СтрокВозвращено < ВсегоСтрок ИЛИ ВнеДиапазона.Количество() > 0;
	Строки.Добавить("- " + Ванесса.Локализовать("Покрытие:") + " "
		+ ?(Покрытие = "requested_rows", Ванесса.Локализовать("запрошенные строки"), Ванесса.Локализовать("все строки")));
	Строки.Добавить("- " + Ванесса.Локализовать("Признак неполноты:") + " "
		+ ?(Неполно, Ванесса.Локализовать("да (возвращены не все строки)"), Ванесса.Локализовать("нет")));
	Если СтрокОтфильтровано > 0 Тогда
		Строки.Добавить("- " + Ванесса.Локализовать("Отфильтровано only_filled:") + " "
			+ Формат(СтрокОтфильтровано, "ЧГ=0; ЧН=0"));
	КонецЕсли;
	Строки.Добавить("");
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиРеквизитыТабличнойЧастиВMarkdown(Строки, ТабличнаяЧасть, ТолькоЗаполненные = Ложь) Экспорт
	
	ВсегоСтрок = MCPВсегоСтрокТабличнойЧасти(ТабличнаяЧасть);
	Если ВсегоСтрок = 0 Тогда
		MCPВывестиМетаданныеОтбораСтрокВMarkdown(Строки, ТабличнаяЧасть, 0, 0);
		Если MCPОтборСтрокТабличнойЧастиЗадан(ТабличнаяЧасть) Тогда
			Строки.Добавить(Ванесса.Локализовать("По заданному отбору строк нет."));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Табличная часть пуста."));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Подготовка = MCPПодготовитьДанныеТабличнойЧасти(ТабличнаяЧасть, ТолькоЗаполненные);
	СтрокВозвращено = Подготовка.ЗначенияСтрок.Количество();
	MCPВывестиМетаданныеОтбораСтрокВMarkdown(Строки, ТабличнаяЧасть, СтрокВозвращено, Подготовка.СтрокОтфильтровано);
	
	// При отборе строк таблица может быть непустой, но не содержать запрошенных строк.
	Если СтрокВозвращено = 0 Тогда
		Если MCPОтборСтрокТабличнойЧастиЗадан(ТабличнаяЧасть) Тогда
			Строки.Добавить(Ванесса.Локализовать("По заданному отбору строк нет."));
		Иначе
			Строки.Добавить(Ванесса.Локализовать("Нет строк с заполненными значениями."));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Подготовка.ИменаКолонок.Количество() = 0 Тогда
		Строки.Добавить(Ванесса.Локализовать("Нет доступных колонок."));
		Возврат;
	КонецЕсли;
	
	MCPВывестиТаблицуЗначенийВMarkdown(Строки, Подготовка.ИменаКолонок, Подготовка.ТипыКолонок, Подготовка.ЗначенияСтрок, Подготовка.НомераСтрок);
	
КонецПроцедуры

// Типы значений по колонкам таблицы: разные типы одной колонки объединяются через запятую.
// Пустые ячейки (тип "Неопределено") в шапке не показываются - пустота видна по прочеркам;
// если заполненных значений в колонке нет совсем, печатается "Неопределено".
&НаКлиенте
Функция MCPТипыКолонокТаблицы(ЗначениеТаблицы, ИменаКолонок) Экспорт
	
	ТипыПоКолонкам = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ЗначениеТаблицы Цикл
		Для Каждого ТекКолонка Из СтрокаТаблицы Цикл
			СписокТипов = ТипыПоКолонкам.Получить(ТекКолонка.Имя);
			Если СписокТипов = Неопределено Тогда
				СписокТипов = Новый Массив;
				ТипыПоКолонкам.Вставить(ТекКолонка.Имя, СписокТипов);
			КонецЕсли;
			Если ТекКолонка.Тип = "Неопределено" Тогда
				Продолжить;
			КонецЕсли;
			Если СписокТипов.Найти(ТекКолонка.Тип) = Неопределено Тогда
				СписокТипов.Добавить(ТекКолонка.Тип);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТипыКолонок = Новый Соответствие;
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		СписокТипов = ТипыПоКолонкам.Получить(ИмяКолонки);
		Если СписокТипов = Неопределено Тогда
			СписокТипов = Новый Массив;
		КонецЕсли;
		Если СписокТипов.Количество() = 0 Тогда
			СписокТипов.Добавить("Неопределено");
		КонецЕсли;
		ТипыКолонок.Вставить(ИмяКолонки, Ванесса._СтрСоединить(СписокТипов, ", "));
	КонецЦикла;
	
	Возврат ТипыКолонок;
	
КонецФункции

// Представление значения для ячейки таблицы: пустое значение - прочерк, остальные экранируются
&НаКлиенте
Функция MCPПредставлениеЯчейкиТаблицы(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат "—";
	КонецЕсли;
	
	Представление = MCPПредставлениеЗначенияДляMarkdown(Значение);
	Если НЕ ЗначениеЗаполнено(Представление) Тогда
		Возврат "—";
	КонецЕсли;
	
	Возврат MCPЭкранироватьЯчейкуMarkdown(Представление);
	
КонецФункции

// Экранирует значение для ячейки Markdown: переводы строк и табуляции - пробелом, "|" - "\|"
&НаКлиенте
Функция MCPЭкранироватьЯчейкуMarkdown(Текст) Экспорт
	
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, "|", "\|");
	
	Возврат СокрЛП(Текст);
	
КонецФункции

// Выводит таблицу в формате Markdown. Типы колонок печатаются в шапке, пустые значения - прочерком.
// При большом числе колонок используется свёрнутый построчный формат "Колонка=Значение".
// ЗначенияСтрок - массив строк, каждая строка - массив значений в порядке ИменаКолонок.
// НомераСтрок - необязательный массив номеров строк исходной таблицы: печатаются колонкой "#"
// (в свёрнутом формате - префиксом строки), по ним видно, какие строки пропущены.
&НаКлиенте
Процедура MCPВывестиТаблицуЗначенийВMarkdown(Строки, ИменаКолонок, ТипыКолонок, ЗначенияСтрок, НомераСтрок = Неопределено) Экспорт
	
	Если ЗначенияСтрок.Количество() = 0 ИЛИ ИменаКолонок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Номера должны соответствовать строкам: иначе печатаем порядковые номера
	Если НомераСтрок <> Неопределено И НомераСтрок.Количество() <> ЗначенияСтрок.Количество() Тогда
		НомераСтрок = Неопределено;
	КонецЕсли;
	
	// Представления ячеек не зависят от формата вывода - готовим их один раз
	ПредставленияСтрок = Новый Массив;
	Для Каждого ЗначенияСтроки Из ЗначенияСтрок Цикл
		Представления = Новый Массив;
		Для Инд = 0 По ИменаКолонок.Количество() - 1 Цикл
			// Строка короче шапки - оставшиеся ячейки печатаем прочерком
			Если Инд < ЗначенияСтроки.Количество() Тогда
				Представления.Добавить(MCPПредставлениеЯчейкиТаблицы(ЗначенияСтроки[Инд]));
			Иначе
				Представления.Добавить("—");
			КонецЕсли;
		КонецЦикла;
		ПредставленияСтрок.Добавить(Представления);
	КонецЦикла;
	
	// Тип колонки печатается в шапке - в значениях он не повторяется
	Заголовки = Новый Массив;
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ТипКолонки = "";
		Если ТипыКолонок <> Неопределено Тогда
			ТипКолонки = ТипыКолонок.Получить(ИмяКолонки);
			Если ТипКолонки = Неопределено Тогда
				ТипКолонки = "";
			КонецЕсли;
		КонецЕсли;
		Заголовки.Добавить(MCPЭкранироватьЯчейкуMarkdown(ИмяКолонки) + ?(ТипКолонки = "", "", " (" + ТипКолонки + ")"));
	КонецЦикла;
	
	Если ИменаКолонок.Количество() > 12 Тогда
		// Широкая таблица: колонки объявляются один раз, строка выводится как "Колонка=Значение".
		// Номер строки печатается префиксом, отдельной колонкой не объявляется
		Строки.Добавить(Ванесса.Локализовать("Колонки:") + " " + Ванесса._СтрСоединить(Заголовки, "; "));
		Строки.Добавить("");
		НомерСтроки = 0;
		Для Каждого Представления Из ПредставленияСтрок Цикл
			НомерСтроки = НомерСтроки + 1;
			ЗначенияЯчеек = Новый Массив;
			Для Инд = 0 По ИменаКолонок.Количество() - 1 Цикл
				ЗначенияЯчеек.Добавить(ИменаКолонок[Инд] + "=" + Представления[Инд]);
			КонецЦикла;
			Если НомераСтрок = Неопределено Тогда
				ПрефиксСтроки = Формат(НомерСтроки, "ЧГ=0; ЧН=0");
			Иначе
				ПрефиксСтроки = НомераСтрок[НомерСтроки - 1];
			КонецЕсли;
			Строки.Добавить(ПрефиксСтроки + ". " + Ванесса._СтрСоединить(ЗначенияЯчеек, "; "));
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если НомераСтрок <> Неопределено Тогда
		Заголовки.Вставить(0, "#");
	КонецЕсли;
	Строки.Добавить("| " + Ванесса._СтрСоединить(Заголовки, " | ") + " |");
	Разделители = Новый Массив;
	Для Инд = 0 По Заголовки.Количество() - 1 Цикл
		Разделители.Добавить("---");
	КонецЦикла;
	Строки.Добавить("| " + Ванесса._СтрСоединить(Разделители, " | ") + " |");
	
	НомерСтроки = 0;
	Для Каждого Представления Из ПредставленияСтрок Цикл
		НомерСтроки = НомерСтроки + 1;
		Ячейки = Новый Массив;
		Если НомераСтрок <> Неопределено Тогда
			Ячейки.Добавить(НомераСтрок[НомерСтроки - 1]);
		КонецЕсли;
		Для Каждого Ячейка Из Представления Цикл
			Ячейки.Добавить(Ячейка);
		КонецЦикла;
		Строки.Добавить("| " + Ванесса._СтрСоединить(Ячейки, " | ") + " |");
	КонецЦикла;
	
КонецПроцедуры

// Выводит элементы справочника (или плана видов характеристик) одной таблицей.
// Состав колонок - объединение по всем элементам: набор полей зависит от вида объекта.
&НаКлиенте
Процедура MCPВывестиЭлементыСправочникаВMarkdown(Строки, Данные) Экспорт
	
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьНаименование = Ложь;
	ЕстьКод = Ложь;
	ЕстьВладелец = Ложь;
	Для Каждого ТекСтрока Из Данные Цикл
		Если ТекСтрока.Свойство("Наименование") Тогда
			ЕстьНаименование = Истина;
		КонецЕсли;
		Если ТекСтрока.Свойство("Код") Тогда
			ЕстьКод = Истина;
		КонецЕсли;
		Если ТекСтрока.Свойство("Владелец") Тогда
			ЕстьВладелец = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить("#");
	ИменаКолонок.Добавить(Ванесса.Локализовать("Навигационная ссылка"));
	Если ЕстьНаименование Тогда
		ИменаКолонок.Добавить(Ванесса.Локализовать("Наименование"));
	КонецЕсли;
	ИменаКолонок.Добавить(Ванесса.Локализовать("Пометка удаления"));
	Если ЕстьКод Тогда
		ИменаКолонок.Добавить(Ванесса.Локализовать("Код"));
	КонецЕсли;
	Если ЕстьВладелец Тогда
		ИменаКолонок.Добавить(Ванесса.Локализовать("Владелец"));
	КонецЕсли;
	
	ЗначенияСтрок = Новый Массив;
	Счетчик = 0;
	Для Каждого ТекСтрока Из Данные Цикл
		Счетчик = Счетчик + 1;
		ЗначенияСтроки = Новый Массив;
		ЗначенияСтроки.Добавить(Формат(Счетчик, "ЧГ=0; ЧН=0"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "НавигационнаяСсылка"));
		Если ЕстьНаименование Тогда
			ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Наименование"));
		КонецЕсли;
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "ПометкаУдаления"));
		Если ЕстьКод Тогда
			ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Код"));
		КонецЕсли;
		Если ЕстьВладелец Тогда
			ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Владелец"));
		КонецЕсли;
		ЗначенияСтрок.Добавить(ЗначенияСтроки);
	КонецЦикла;
	
	MCPВывестиТаблицуЗначенийВMarkdown(Строки, ИменаКолонок, Неопределено, ЗначенияСтрок);
	
КонецПроцедуры

// Выводит документы одной таблицей. Состав колонок - объединение по всем документам.
&НаКлиенте
Процедура MCPВывестиДокументыВMarkdown(Строки, Данные) Экспорт
	
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьНомер = Ложь;
	ЕстьПроведен = Ложь;
	Для Каждого ТекСтрока Из Данные Цикл
		Если ТекСтрока.Свойство("Номер") Тогда
			ЕстьНомер = Истина;
		КонецЕсли;
		Если ТекСтрока.Свойство("Проведен") Тогда
			ЕстьПроведен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить("#");
	ИменаКолонок.Добавить(Ванесса.Локализовать("Представление"));
	ИменаКолонок.Добавить(Ванесса.Локализовать("Навигационная ссылка"));
	ИменаКолонок.Добавить(Ванесса.Локализовать("Дата"));
	Если ЕстьНомер Тогда
		ИменаКолонок.Добавить(Ванесса.Локализовать("Номер"));
	КонецЕсли;
	ИменаКолонок.Добавить(Ванесса.Локализовать("Пометка удаления"));
	Если ЕстьПроведен Тогда
		ИменаКолонок.Добавить(Ванесса.Локализовать("Проведен"));
	КонецЕсли;
	
	ЗначенияСтрок = Новый Массив;
	Счетчик = 0;
	Для Каждого ТекСтрока Из Данные Цикл
		Счетчик = Счетчик + 1;
		ЗначенияСтроки = Новый Массив;
		ЗначенияСтроки.Добавить(Формат(Счетчик, "ЧГ=0; ЧН=0"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Ссылка"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "НавигационнаяСсылка"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Дата"));
		Если ЕстьНомер Тогда
			ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Номер"));
		КонецЕсли;
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "ПометкаУдаления"));
		Если ЕстьПроведен Тогда
			ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекСтрока, "Проведен"));
		КонецЕсли;
		ЗначенияСтрок.Добавить(ЗначенияСтроки);
	КонецЦикла;
	
	MCPВывестиТаблицуЗначенийВMarkdown(Строки, ИменаКолонок, Неопределено, ЗначенияСтрок);
	
КонецПроцедуры

// Выводит значения всех констант одной таблицей. Номера строк не печатаются:
// порядковый номер в ответе не совпадает с номером константы для start_number/end_number.
&НаКлиенте
Процедура MCPВывестиКонстантыВMarkdown(Строки, Данные) Экспорт
	
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить(Ванесса.Локализовать("Имя"));
	ИменаКолонок.Добавить(Ванесса.Локализовать("Представление"));
	ИменаКолонок.Добавить(Ванесса.Локализовать("Значение"));
	ИменаКолонок.Добавить(Ванесса.Локализовать("Тип значения"));
	
	ЗначенияСтрок = Новый Массив;
	Для Каждого ТекКонстанта Из Данные Цикл
		ЗначенияСтроки = Новый Массив;
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекКонстанта, "Имя"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекКонстанта, "Представление"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекКонстанта, "Значение"));
		ЗначенияСтроки.Добавить(MCPБезопасноеСвойство(ТекКонстанта, "ТипЗначения"));
		ЗначенияСтрок.Добавить(ЗначенияСтроки);
	КонецЦикла;
	
	MCPВывестиТаблицуЗначенийВMarkdown(Строки, ИменаКолонок, Неопределено, ЗначенияСтрок);
	
КонецПроцедуры

// Возвращает данные из таблицы базы данных (справочники, документы, перечисления, константы, реквизиты объекта)
&НаКлиенте
Функция ПолучитьДанныеИзТаблицыБД(Запрос, ДополнительныеПараметры) Экспорт
	
	// Новые параметры чтения больших табличных частей относятся только к get_object_attributes:
	// молча игнорировать их в get_table_data нельзя.
	Если ЗначениеЗаполнено(ЗначениеПараметраИзЗапроса(Запрос, "row_numbers"))
			ИЛИ ЗначениеЗаполнено(ЗначениеПараметраИзЗапроса(Запрос, "row_ranges"))
			ИЛИ ЗначениеЗаполнено(ЗначениеПараметраИзЗапроса(Запрос, "format")) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
			Ванесса.Локализовать("Параметры row_numbers, row_ranges и format поддерживаются только инструментом get_object_attributes. get_table_data их не поддерживает."));
	КонецЕсли;
	
	// Получаем параметр object_type (обязательный, числовой)
	// 1 = Справочник, 2 = Документ, 3 = Перечисление, 4 = одна константа, 5 = все константы, 6 = Реквизиты объекта по навигационной ссылке
	Попытка
		ТипОбъекта = Число(ЗначениеПараметраИзЗапроса(Запрос, "object_type"));
	Исключение
		ТекстСообщения = Ванесса.Локализовать("Параметр object_type должен быть числом. Допустимые значения: 1 = Справочник, 2 = Документ, 3 = Перечисление, 4 = одна константа, 5 = все константы, 6 = Реквизиты объекта по навигационной ссылке, 7 = План видов характеристик, 8 = все справочники, 9 = все документы, 10 = все перечисления, 11 = все планы видов характеристик.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецПопытки;
	
	// Проверка допустимого значения
	Если ТипОбъекта < 1 ИЛИ ТипОбъекта > 11 Тогда
		ТекстСообщения = Ванесса.Локализовать("Недопустимое значение object_type. Допустимые значения: 1 = Справочник, 2 = Документ, 3 = Перечисление, 4 = одна константа, 5 = все константы, 6 = Реквизиты объекта по навигационной ссылке, 7 = План видов характеристик, 8 = все справочники, 9 = все документы, 10 = все перечисления, 11 = все планы видов характеристик.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	// Получаем параметр object_name
	Если (ТипОбъекта >= 1 И ТипОбъекта <= 4) ИЛИ ТипОбъекта = 7 Тогда
		ИмяОбъекта = Строка(ЗначениеПараметраИзЗапроса(Запрос, "object_name"));
		Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
			ТекстСообщения = Ванесса.Локализовать("Необходимо указать параметр object_name.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
	// Получаем параметр limit (по умолчанию 10)
	Попытка
		ЗначениеЛимит = ЗначениеПараметраИзЗапроса(Запрос, "limit");
		Если ЗначениеЛимит = Неопределено Тогда
			Лимит = 0;
		Иначе	
			Лимит = Число(ЗначениеЛимит);
		КонецЕсли;
	Исключение
		Лимит = 0;
	КонецПопытки;
	
	Если Лимит = Неопределено ИЛИ Лимит <= 0 Тогда
		Лимит = 10;
	КонецЕсли;
	
	// Получаем параметр owner (для подчиненных справочников)
	Владелец = Строка(ЗначениеПараметраИзЗапроса(Запрос, "owner"));
	
	// Получаем параметр name_filter (для отбора по наименованию)
	ОтборПоНаименованию = Строка(ЗначениеПараметраИзЗапроса(Запрос, "name_filter"));

	// Получаем параметр name_match_type (режим сравнения для name_filter).
	// Допустимые значения (без учёта регистра): "exact", "partial", "starts_with".
	// Незаполненное значение трактуется как "exact" (обратная совместимость).
	// Любое другое значение — ошибка INVALID_PARAMS.
	ВидОтбораПоНаименованию = Строка(ЗначениеПараметраИзЗапроса(Запрос, "name_match_type"));
	ВидОтбораПоНаименованию = ВРег(СокрЛП(ВидОтбораПоНаименованию));
	Если ВидОтбораПоНаименованию <> "EXACT"
			И ВидОтбораПоНаименованию <> "PARTIAL"
			И ВидОтбораПоНаименованию <> "STARTS_WITH" Тогда
		Если НЕ ЗначениеЗаполнено(ВидОтбораПоНаименованию) Тогда
			ВидОтбораПоНаименованию = "EXACT";
		Иначе
			ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("Недопустимое значение параметра name_match_type: ""%1"". Допустимые значения: ""exact"", ""partial"", ""starts_with""."),
				Строка(ЗначениеПараметраИзЗапроса(Запрос, "name_match_type")));
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	// Получаем параметр navigationLink (для object_type = 6)
	НавигационнаяСсылка = Строка(ЗначениеПараметраИзЗапроса(Запрос, "navigationLink"));
	
	// Получаем параметр only_filled (для object_type = 6; по умолчанию true - только заполненные реквизиты).
	// ТолькоЗаполненныеЗадано различает "параметр не передан" и явное значение: только явный параметр
	// при object_type <> 6 считается ошибкой.
	ЗначениеТолькоЗаполненные = ЗначениеПараметраИзЗапроса(Запрос, "only_filled");
	ТолькоЗаполненныеЗадано = НЕ (ЗначениеТолькоЗаполненные = Неопределено ИЛИ ЗначениеТолькоЗаполненные = Null ИЛИ ЗначениеТолькоЗаполненные = "");
	ТолькоЗаполненные = Истина;
	Если ТолькоЗаполненныеЗадано Тогда
		Попытка
			ТолькоЗаполненные = Булево(ЗначениеТолькоЗаполненные);
		Исключение
			ТолькоЗаполненные = Истина;
		КонецПопытки;
	КонецЕсли;
	
	// Получаем параметры даты для документов
	ДатаНачала = ЗначениеПараметраИзЗапроса(Запрос, "date_start");
	ДатаОкончания = ЗначениеПараметраИзЗапроса(Запрос, "date_end");

	// Получаем параметр filter (отбор по реквизитам объекта, по одному условию в строке)
	ОтборПоРеквизитам = Строка(ЗначениеПараметраИзЗапроса(Запрос, "filter"));

	// Получаем параметры диапазона для object_type = 5
	НачальныйНомер = 0;
	КонечныйНомер = 0;
	Попытка
		ЗначениеНачальногоНомера = ЗначениеПараметраИзЗапроса(Запрос, "start_number");
		Если ЗначениеНачальногоНомера <> Неопределено Тогда
			НачальныйНомер = Число(ЗначениеНачальногоНомера);
		КонецЕсли;
	Исключение
		НачальныйНомер = 0;
	КонецПопытки;

	Попытка
		ЗначениеКонечногоНомера = ЗначениеПараметраИзЗапроса(Запрос, "end_number");
		Если ЗначениеКонечногоНомера <> Неопределено Тогда
			КонечныйНомер = Число(ЗначениеКонечногоНомера);
		КонецЕсли;
	Исключение
		КонечныйНомер = 0;
	КонецПопытки;

	// Параметры режима чтения реквизитов (data_mode/attribute_name/tabular_section_name/only_filled).
	ТекстОшибкиПараметров = "";
	ПараметрыЧтения = MCPПроверитьПараметрыЧтенияРеквизитов(Запрос, ТекстОшибкиПараметров);
	Если ПараметрыЧтения = Неопределено Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстОшибкиПараметров);
	КонецЕсли;
	РежимДанных = ПараметрыЧтения.РежимДанных;
	ИмяРеквизита = ПараметрыЧтения.ИмяРеквизита;
	ИмяТабличнойЧасти = ПараметрыЧтения.ИмяТабличнойЧасти;
	
	Если ТипОбъекта = 6 Тогда
		Если НЕ ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
			ТекстСообщения = Ванесса.Локализовать("Для object_type = 6 (Реквизиты объекта по навигационной ссылке) необходимо указать параметр navigationLink.");
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
		КонецЕсли;
	// Совместимость: при object_type <> 6 явные прежние значения по умолчанию (data_mode = "all",
	// only_filled = false) ошибкой не считаются - параметры просто не применяются.
	ИначеЕсли ПараметрыЧтения.РежимДанныхЗадан И ПараметрыЧтения.РежимДанных <> "all" ИЛИ ЗначениеЗаполнено(ИмяРеквизита) ИЛИ ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметры режима (data_mode, attribute_name, tabular_section_name) применяются только при чтении реквизитов по навигационной ссылке (object_type = 6); для открытой формы используйте get_object_attributes.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	ИначеЕсли ТолькоЗаполненныеЗадано И ТолькоЗаполненные Тогда
		ТекстСообщения = Ванесса.Локализовать("Параметр only_filled применим только к object_type = 6 (реквизиты объекта по навигационной ссылке).");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачалаРазобранная = MCPДатаИзСтрокиПериода(ДатаНачала, Ложь);
		Если ДатаНачалаРазобранная = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				MCPОформитьОшибку(
					Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось преобразовать строку <%1> в дату начала."), ДатаНачала),
					Ванесса.Локализовать("Форматы даты: ""ДД.ММ.ГГГГ"", ""ДД.ММ.ГГГГ чч:мм:сс"", ""ГГГГ-ММ-ДД"", ""ГГГГ-ММ-ДД чч:мм:сс"". Пример: date_start=01.06.2024")));
		КонецЕсли;
		ДатаНачала = ДатаНачалаРазобранная;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончанияРазобранная = MCPДатаИзСтрокиПериода(ДатаОкончания, Истина);
		Если ДатаОкончанияРазобранная = Неопределено Тогда
			Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS",
				MCPОформитьОшибку(
					Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Не получилось преобразовать строку <%1> в дату окончания."), ДатаОкончания),
					Ванесса.Локализовать("Форматы даты: ""ДД.ММ.ГГГГ"", ""ДД.ММ.ГГГГ чч:мм:сс"", ""ГГГГ-ММ-ДД"", ""ГГГГ-ММ-ДД чч:мм:сс"". Если время не указано, берётся конец дня (23:59:59). Пример: date_end=30.06.2024")));
		КонецЕсли;
		ДатаОкончания = ДатаОкончанияРазобранная;
	КонецЕсли;
	
	// Проверяем подключение клиента тестирования
	Попытка
		АктивноеОкно = Ванесса.ПолучитьАктивноеОкноИзТестовоеПриложение();
	Исключение
		ТекстОшибки = ТекстОшибкиИзОписанияОшибки(ОписаниеОшибки());
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", Ванесса.Локализовать("Клиент тестирования не подключён. Сначала вызовите `manage_test_client` с `action: connect` и нужным `profileName`.") + " " + ТекстОшибки);
	КонецПопытки;
	
	// Формируем результат в зависимости от типа объекта
	Если ТипОбъекта = 1 Тогда
		// Справочник
		Возврат ПолучитьДанныеСправочника(ИмяОбъекта, Владелец, Лимит, ОтборПоНаименованию, ВидОтбораПоНаименованию, ОтборПоРеквизитам);
	ИначеЕсли ТипОбъекта = 2 Тогда
		// Документ
		Возврат ПолучитьДанныеДокумента(ИмяОбъекта, ДатаНачала, ДатаОкончания, Лимит, ОтборПоРеквизитам);
	ИначеЕсли ТипОбъекта = 3 Тогда
		// Перечисление
		Возврат ПолучитьДанныеПеречисления(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = 4 Тогда
		// Константа
		Возврат ПолучитьДанныеКонстанты(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = 5 Тогда
		// Все константы
		Возврат ПолучитьВсеКонстанты(НачальныйНомер, КонечныйНомер);
	ИначеЕсли ТипОбъекта = 6 Тогда
		// Реквизиты объекта по навигационной ссылке
		ПараметрыОтбораБД = Новый Структура;
		ПараметрыОтбораБД.Вставить("ИмяТабличнойЧасти", ?(РежимДанных = "single_tabular_section", ИмяТабличнойЧасти, ""));
		ПараметрыОтбораБД.Вставить("НомераСтрок", "");
		ПараметрыОтбораБД.Вставить("ДиапазоныСтрок", "");
		ПараметрыОтбораБД.Вставить("ОтборСтрокЗадан", Ложь);
		ПараметрыОтбораБД.Вставить("БезТабличныхЧастей", РежимДанных = "attributes_only");
		Возврат ПолучитьРеквизитыОбъектаПоНавигационнойСсылке(
			НавигационнаяСсылка, РежимДанных, ИмяРеквизита, ИмяТабличнойЧасти, ТолькоЗаполненные,
			Ложь, ПараметрыОтбораБД, Неопределено, "markdown");
	ИначеЕсли ТипОбъекта = 7 Тогда
		// План видов характеристик
		Возврат ПолучитьДанныеПланаВидовХарактеристик(ИмяОбъекта, Лимит, ОтборПоНаименованию, ВидОтбораПоНаименованию, ОтборПоРеквизитам);
	ИначеЕсли ТипОбъекта = 8 Тогда
		// Все справочники
		Возврат ПолучитьСписокОбъектовМетаданных("ВсеСправочники");
	ИначеЕсли ТипОбъекта = 9 Тогда
		// Все документы
		Возврат ПолучитьСписокОбъектовМетаданных("ВсеДокументы");
	ИначеЕсли ТипОбъекта = 10 Тогда
		// Все перечисления
		Возврат ПолучитьСписокОбъектовМетаданных("ВсеПеречисления");
	ИначеЕсли ТипОбъекта = 11 Тогда
		// Все планы видов характеристик
		Возврат ПолучитьСписокОбъектовМетаданных("ВсеПланыВидовХарактеристик");
	КонецЕсли;
	
КонецФункции

// Возвращает данные перечисления
&НаКлиенте
Функция ПолучитьДанныеПеречисления(ИмяПеречисления) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяПеречисления) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Перечисление' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;
	
	Строки = Новый Массив;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Перечисление");
	ДопПараметры.Вставить("Вид", ИмяПеречисления);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет перечисления:") + " " + ИмяПеречисления);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Перечисление:") + " " + ИмяПеречисления);
	Строки.Добавить("");
	
	Счетчик = 0;
	Для Каждого ТекДанные Из Данные Цикл
		
		Если Лев(НРег(ТекДанные.Имя), 7) = "удалить" ИЛИ Лев(НРег(ТекДанные.Имя), 6) = "delete" Тогда
			// Значит значение устарело
			Продолжить;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
		СтрокаЗначения = Формат(Счетчик, "ЧГ=0; ЧН=0") + ". " + ТекДанные.Имя;
		// Представление печатаем только когда оно отличается от имени
		Если ЗначениеЗаполнено(ТекДанные.Представление) И ТекДанные.Представление <> ТекДанные.Имя Тогда
			СтрокаЗначения = СтрокаЗначения + " — " + ТекДанные.Представление;
		КонецЕсли;
		Строки.Добавить(СтрокаЗначения);
	КонецЦикла;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Возвращает данные справочника
&НаКлиенте
Функция ПолучитьДанныеСправочника(ИмяСправочника, Владелец, Лимит, ОтборПоНаименованию = Неопределено, ВидОтбораПоНаименованию = "EXACT", ОтборПоРеквизитам = "") Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
		ТекстСообщения = Ванесса.Локализовать("Для типа объекта 'Справочник' необходимо указать параметр object_name.");
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("INVALID_PARAMS", ТекстСообщения);
	КонецЕсли;

	Строки = Новый Массив;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Тип", "Справочник");
	ДопПараметры.Вставить("Вид", ИмяСправочника);
	ДопПараметры.Вставить("Владелец", Владелец);
	ДопПараметры.Вставить("Лимит", Лимит);
	ДопПараметры.Вставить("ОтборПоРеквизитам", ОтборПоРеквизитам);
	Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
		ДопПараметры.Вставить("ОтборПоНаименованию", ОтборПоНаименованию);
	КонецЕсли;
	ДопПараметры.Вставить("ВидОтбораПоНаименованию", ВидОтбораПоНаименованию);
	
	ТекстОшибки = Неопределено;
	Данные = ДанныеИзБазыДанныхКлиентаТестирования(ДопПараметры, ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат МодульМсп_Сервер().ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;
	
	// Расширение может вернуть обёртку {КоличествоЭлементов, НайденоЭлементов, ДанныеЭлементов}.
	// Для обратной совместимости со старым форматом (массив напрямую) поддерживаем оба варианта.
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДанныеЭлементов") Тогда
		ВсегоЭлементов = Данные.КоличествоЭлементов;
		НайденоЭлементов = ВсегоЭлементов;
		Если Данные.Свойство("НайденоЭлементов") Тогда
			НайденоЭлементов = Данные.НайденоЭлементов;
		КонецЕсли;
		Данные = Данные.ДанныеЭлементов;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		ВсегоЭлементов = Данные.Количество();
		НайденоЭлементов = ВсегоЭлементов;
	Иначе
		// Это Структура с ошибкой (нет объекта метаданных) - количество не вычисляем,
		// обработка ошибки будет ниже.
		ВсегоЭлементов = 0;
		НайденоЭлементов = 0;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ОшибкаНетОбъектаМетаданных = Данные.ОшибкаНетОбъектаМетаданных;
		Строки.Добавить(Ванесса.Локализовать("# В базе клиента тестирования нет справочника:") + " " + ИмяСправочника);
		Строки.Добавить(Ванесса.Локализовать("# Доступные значения:"));
		Для Каждого ТекИмяОМ Из Данные.ВсеОбъекты Цикл
			Если Лев(НРег(ТекИмяОМ), 7) = "удалить" ИЛИ Лев(НРег(ТекИмяОМ), 6) = "delete" Тогда
				// Значит значение устарело
				Продолжить;
			КонецЕсли;
			Строки.Добавить("  - " + ТекИмяОМ);
		КонецЦикла;	
		Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(Ванесса.Локализовать("# Справочник:") + " " + ИмяСправочника);
	Строки.Добавить(Ванесса.Локализовать("# Всего элементов в базе:") + " " + XMLСтрока(ВсегоЭлементов));
	Если НайденоЭлементов <> ВсегоЭлементов Тогда
		Строки.Добавить(Ванесса.Локализовать("# Найдено с учётом отбора:") + " " + XMLСтрока(НайденоЭлементов));
	КонецЕсли;
	Если НайденоЭлементов > Данные.Количество() Тогда
		Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("# Возвращено первые %1 элементов из %2. Чтобы получить больше, увеличьте параметр limit (0 - без ограничения) или уточните отбор."),
			XMLСтрока(Данные.Количество()), XMLСтрока(НайденоЭлементов)));
	КонецЕсли;
	Строки.Добавить("");

	MCPВывестиЭлементыСправочникаВMarkdown(Строки, Данные);
	
	Если Данные.Количество() = 0 Тогда
		ПрименённыеОтборы = Новый Массив;
		Если ЗначениеЗаполнено(ОтборПоНаименованию) Тогда
			ПрименённыеОтборы.Добавить("Наименование = " + ОтборПоНаименованию);
		КонецЕсли;
		Если ЗначениеЗаполнено(Владелец) Тогда
			ПрименённыеОтборы.Добавить("Владелец = " + Владелец);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборПоРеквизитам) Тогда
			ПрименённыеОтборы.Добавить("filter: " + СтрЗаменить(ОтборПоРеквизитам, Символы.ПС, "; "));
		КонецЕсли;
		Если ПрименённыеОтборы.Количество() > 0 Тогда
			Строки.Добавить(Ванесса.ПодставитьПараметрыВСтроку(
				Ванесса.Локализовать("По заданному отбору (%1) элементов не найдено."),
				Ванесса._СтрСоединить(ПрименённыеОтборы, ", ")));
		Иначе	
			Строки.Добавить(Ванесса.Локализовать("Элементов справочника не найдено."));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ванесса._СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает данные плана видов характеристик
