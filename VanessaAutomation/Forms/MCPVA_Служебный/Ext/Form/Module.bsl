#Область ОписаниеПеременных

&НаКлиенте
Перем Ванесса;

&НаКлиенте
Перем ВнешнийФасадМсп;

&НаКлиенте
Перем КешДанныхУпавшегоШага;

&НаКлиенте
Перем глКешБазыЗнаний, глКешВопросов, глЧастоИспользуемыеШаги;

&НаКлиенте
Перем глРазмерБазыЗнанийБайт;

&НаКлиенте
Перем КаталогСФайламиОзвучки;

&НаКлиенте
Перем ЗапускОзвучкиMCPВПроцессе;

&НаКлиенте
Перем ВремяУстановкиФлагаОзвучкиMCP;

&НаКлиенте
Перем ОжиданиеОзвучкиMCP;

&НаКлиенте
Перем ПакетСинтезаMCP;

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункции

// Делает первичную инициализацию модуля.
&НаКлиенте
Функция ИнициализацияФормы(ВанессаПараметр) Экспорт
	Ванесса = ВанессаПараметр;
	Возврат Истина;
КонецФункции

// Делает отключение модуля
&НаКлиенте
Функция ОтключениеМодуля() Экспорт

	ЗавершитьОжиданиеОзвучкиMCPПриОтключении();
	ЗавершитьПакетСинтезаMCPПриОтключении();
	ЗапускОзвучкиMCPВПроцессе = Ложь;
	ВремяУстановкиФлагаОзвучкиMCP = Неопределено;
	Ванесса = Неопределено;
	КешДанныхУпавшегоШага = Неопределено;
	глКешБазыЗнаний = Неопределено;
	глКешВопросов = Неопределено;
	глРазмерБазыЗнанийБайт = Неопределено;
	глЧастоИспользуемыеШаги = Неопределено;
	КаталогСФайламиОзвучки = Неопределено;
	
КонецФункции	 

// Записывает служебные данные MCP в ЖР, если основная форма ещё доступна.
&НаКлиенте
Процедура MCPЗаписатьСлужебныеДанныеБезопасно(ИмяСобытия, Данные = Неопределено) Экспорт

	Если Ванесса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Ванесса.MCPЗаписатьСлужебныеДанные(ИмяСобытия, Данные);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОписанияИнструментов

// Создаёт структуру описания свойства параметра инструмента MCP.
&НаКлиенте
Функция MCPНовоеСвойствоОписания(Имя, Тип, Описание, Обязательный = Ложь)

	Свойство = Новый Структура;
	Свойство.Вставить("Имя", Имя);
	Свойство.Вставить("Тип", Тип);
	Свойство.Вставить("Описание", Описание);
	Свойство.Вставить("Обязательный", Обязательный);
	Возврат Свойство;

КонецФункции

// Создаёт структуру описания инструмента MCP.
// Асинхронный: Истина/Ложь — передаётся как 5-й параметр НовыйИнструмент; Неопределено — параметр не передаётся.
&НаКлиенте
Функция MCPНовоеОписаниеИнструмента(Имя, Описание, Хендлер, Асинхронный = Неопределено, Отключен = Ложь)

	Инструмент = Новый Структура;
	Инструмент.Вставить("Имя", Имя);
	Инструмент.Вставить("Описание", Описание);
	Инструмент.Вставить("Хендлер", Хендлер);
	Инструмент.Вставить("Асинхронный", Асинхронный);
	Инструмент.Вставить("Отключен", Отключен);
	Инструмент.Вставить("Свойства", Новый Массив);
	Возврат Инструмент;

КонецФункции

// Добавляет инструменту чтения журнала регистрации общий набор свойств (контракт одинаков
// для базы менеджера и базы клиента тестирования).
&НаКлиенте
Процедура MCPДобавитьСвойстваЖурналаРегистрации(Инстр, КраткоОписания = Ложь)

	// Полный текст параметров нужен инструменту базы менеджера. У второго инструмента журнала
	// (база клиента тестирования) тяжёлые тексты не дублируются: схема отправляется в каждом
	// запросе, а поведение параметров у обоих инструментов одинаковое.
	Если КраткоОписания Тогда
		MCPДобавитьСвойстваЖурналаРегистрацииКратко(Инстр);
		Возврат;
	КонецЕсли;

	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("date_start", "string",
		"Начало периода. Форматы: ""ДД.ММ.ГГГГ"", ""ДД.ММ.ГГГГ чч:мм[:сс]"", ""ГГГГ-ММ-ДД"", ""ГГГГ-ММ-ДД чч:мм[:сс]"". Если время не указано, берётся начало дня (00:00:00). По умолчанию - час назад от текущего времени целевой базы."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("date_end", "string",
		"Конец периода (включая указанную секунду). Форматы те же, что у date_start; если время не указано, берётся конец дня (23:59:59). По умолчанию - текущее время целевой базы."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("event", "string",
		"Событие: системное имя (например, _$Data$_.Update) или представление (например, ""Данные. Изменение""); несколько значений - через '|'. По умолчанию - все события."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("event_match_type", "string",
		"Как сравнивать event: 'exact' (по умолчанию; системные имена отбирает платформа, представления - в целевой базе), 'partial' или 'starts_with' (отбор в целевой базе)."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("comment", "string",
		"Комментарий события. Несколько значений через '|' не поддерживаются - передавайте один комментарий."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("comment_match_type", "string",
		"Как сравнивать comment: 'exact' (по умолчанию), 'partial' или 'starts_with' (отбор в целевой базе)."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("level", "string",
		"Уровень события: Информация, Ошибка, Предупреждение, Примечание (или Information, Error, Warning, Note); несколько значений - через '|'. Неизвестное значение - ошибка INVALID_PARAMS."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("user", "string",
		"Пользователь (имя пользователя информационной базы); несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("computer", "string",
		"Компьютер; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("application", "string",
		"Имя приложения; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("metadata", "string",
		"Полное имя объекта метаданных на языке целевой базы (например, ""Документ.РеализацияТоваровУслуг""); несколько значений - через '|'. Неизвестное имя - ошибка ACTION_FAILED."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("data", "string",
		"Ссылка в колонке ""Данные"": навигационная ссылка вида e1cib/data/... (её возвращают инструменты VA) либо строка ЗначениеВСтрокуВнутр."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("data_presentation", "string",
		"Представление данных (колонка ""ПредставлениеДанных"")."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("session", "integer",
		"Номер сеанса; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("server", "string",
		"Рабочий сервер; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("port", "integer",
		"Номер основного IP-порта рабочего процесса; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("sync_port", "integer",
		"Номер вспомогательного IP-порта рабочего процесса; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("transaction", "string",
		"Идентификатор транзакции; несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("transaction_status", "string",
		"Статус транзакции: Зафиксирована, Отменена, НеЗавершена, НетТранзакции (или Committed, RolledBack, Unfinished, NotApplicable); несколько значений - через '|'."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("limit", "number",
		"Сколько строк вернуть. По умолчанию 100, максимум 1000. Возвращаются самые свежие события, удовлетворяющие отбору. Значение 0 недопустимо."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("scan_limit", "number",
		"Бюджет сканирования: сколько событий разрешено прочитать из журнала (по умолчанию 1000, максимум 20000). Если бюджет оборвал чтение, в ответе будет признак достижения бюджета и предупреждение о непрочитанных событиях."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("display_order", "string",
		"Порядок вывода строк: 'desc' (по умолчанию, от новых к старым) или 'asc'. На состав выборки не влияет."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("columns", "string",
		"Колонки ответа через '|'. Доступные логические имена: date, level, event, event_presentation, comment, metadata, metadata_presentation, data, data_presentation, user (имя пользователя по идентификатору), user_name, computer, application, application_presentation, connection, session, server, port, sync_port, transaction, transaction_status. Значение 'all' - все колонки. По умолчанию: date|level|event|comment|user|computer|session|metadata. Тяжёлая колонка data в набор по умолчанию не входит. Неизвестное имя - ошибка INVALID_PARAMS."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("data_max_length", "number",
		"Обрезка значения колонки data в символах (по умолчанию 300, 0 - без обрезки). Действует, только если колонка data запрошена."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("output_file", "string",
		"Путь к файлу на компьютере, где работает Vanessa Automation: полный ответ (markdown или json) записывается в файл, существующий файл перезаписывается, в ответе MCP остаются шапка со счётчиками, путь, размер и превью. Необязательный."));
	Инстр.Свойства.Добавить(MCPНовоеСвойствоОписания("output_format", "string",
		"Формат ответа и файла: 'markdown' (по умолчанию) или 'json'. Формат 'json' требует output_file."));

КонецПроцедуры

