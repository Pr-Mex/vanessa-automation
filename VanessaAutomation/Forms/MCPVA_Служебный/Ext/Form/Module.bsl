#Область ДанныеОбАктивномОкне

&НаКлиенте
Процедура ДобавитьВОтветИнформациюОМодальномДиалоге(Строки, ОкноМодальногоДиалога) Экспорт
	// Текст читаем из переданного окна диалога: без окна текст может прийти из другого окна
	ТекстМодальногоДиалога = "";
	Попытка
		ТекстМодальногоДиалога = Ванесса.ТекстПредупреждения(ОкноМодальногоДиалога);
	Исключение
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(ТекстМодальногоДиалога) Тогда
		Попытка
			ТекстМодальногоДиалога = Ванесса.ПолучитьТекстПредупреждения();
		Исключение
			ТекстМодальногоДиалога = "";
		КонецПопытки;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстМодальногоДиалога) Тогда
		Строки.Добавить("");
		Строки.Добавить(СтрокаДляОшибкиТекстМодальногоДиалога());
		Строки.Добавить(MCPЭкранироватьMarkdownМногострочный(ТекстМодальногоДиалога));
	КонецЕсли;
	
	КнопкиМодальногоДиалога = Новый Массив;
	Попытка
		КнопкиМодальногоДиалога = ОкноМодальногоДиалога.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы"));
	Исключение
	КонецПопытки;
	// Заголовки кнопок собираем строками сразу: окно может закрыться после поиска
	РезультатКнопки = Новый Массив;
	Для Каждого ТекКнопка Из КнопкиМодальногоДиалога Цикл
		Попытка
			Если ТекКнопка.ТекущаяВидимость() Тогда
				РезультатКнопки.Добавить(ТекКнопка.Имя + " (" + ТекКнопка.ТекстЗаголовка + ")");
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Если РезультатКнопки.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(Ванесса.Локализовать("Кнопки модального диалога:"));
		Для Каждого ТекстКнопки Из РезультатКнопки Цикл
			Строки.Добавить("  -" + MCPЭкранироватьMarkdownМногострочный(ТекстКнопки, Ложь));
		КонецЦикла;	
	КонецЕсли;
	
	Строки.Добавить("");
	
КонецПроцедуры

