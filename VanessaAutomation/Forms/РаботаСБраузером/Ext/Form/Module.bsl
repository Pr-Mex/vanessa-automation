// Выполняет JS, парсит координаты, пересчёт масштаба.
&НаКлиенте
Процедура КоординатыЭлементаJavaScript(Элемент, ТекстJavaScript, X, Y) Экспорт
	#Если НЕ ВебКлиент Тогда

	КоординатыЭлемента = ВыполнитьJavaScriptБраузерСлужебный(ТекстJavaScript);

	Попытка
		СтрокаКоординаты = КоординатыЭлемента.result.result.value;
	Исключение
		СтрокаКоординаты = "";
	КонецПопытки;

	Если СтрокаКоординаты = Неопределено И НЕ Ванесса.Объект.ИгнорироватьОшибкиПоискаЭлементовВБраузере Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Не вышло получить координаты элемента <%1> в браузере: %2."),
			Элемент.ТекстЗаголовка,
			СтрокаКоординаты
		);
		Попытка
			ТекстСообщения = ТекстСообщения + Символы.ПС + КоординатыЭлемента.result.exceptionDetails.exception.description;
		Исключение
		КонецПопытки;
		Ванесса.ЗаписатьЛогВЖРОшибка("КоординатыЭлементаJavaScript", ТекстСообщения);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(СтрокаКоординаты);
		ДанныеКоординат = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ДанныеКоординат = Неопределено;
	КонецПопытки;

	Если ДанныеКоординат = Неопределено И НЕ Ванесса.Объект.ИгнорироватьОшибкиПоискаЭлементовВБраузере Тогда
		ТекстСообщения = Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Не вышло получить координаты элемента <%1> в браузере: %2."),
			Элемент.ТекстЗаголовка,
			СтрокаКоординаты
		);
		Попытка
			ТекстСообщения = ТекстСообщения + Символы.ПС + КоординатыЭлемента.result.exceptionDetails.exception.description;
		Исключение
		КонецПопытки;
		Ванесса.ЗаписатьЛогВЖРОшибка("КоординатыЭлементаJavaScript", ТекстСообщения);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;

	Если ДанныеКоординат <> Неопределено Тогда
		Ванесса.ПересчитатьДанныеКоординатСУчетомМасштабирования(ДанныеКоординат, X, Y);
	КонецЕсли;

	#КонецЕсли
КонецПроцедуры

