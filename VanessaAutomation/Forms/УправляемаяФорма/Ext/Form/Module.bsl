Функция ПрочитатьФайлВТабличныйДокументНаСервере(ИмяФайла)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	МаксКолПопыток = 30;
	ПолучилосьПрочитатьМакет = Ложь;
	ТекстОшибки = Неопределено;
	
	Для КолПопыток = 1 По МаксКолПопыток Цикл
		Попытка
			ТабличныйДокумент.Прочитать(ИмяФайла);
			ПолучилосьПрочитатьМакет = Истина;
			Прервать;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			SleepOnServer(1);
		КонецПопытки;
	КонецЦикла;
	
	Если НЕ ПолучилосьПрочитатьМакет Тогда
		ЗаписатьЛогВЖРОшибкаСервер("ПрочитатьФайлВТабличныйДокументНаСервере", ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьФлагСортировкиИзНастроекДымовыхТестов(НастройкиИзФайла) Экспорт
	
	Если Не НастройкиИзФайла.Свойство("ДымовыеТесты") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЦелевоеИмя = "ДымовыеТестыСортироватьДокументыПоДатеУбыв";
	ТаблицаИменКлючей = ИменаКлючейОбщихНастроек();
	
	Для Каждого Элемент Из НастройкиИзФайла.ДымовыеТесты Цикл
		КлючНРег = НРег(Элемент.Ключ);
		
		Для Каждого Стр Из ТаблицаИменКлючей Цикл
			Если Стр.ИмяRU = ЦелевоеИмя И 
			   (НРег(Стр.ИмяRU) = КлючНРег Или НРег(Стр.ИмяEn) = КлючНРег) Тогда
				
				Значение = Элемент.Значение;
				
				// Обработка булева/числа/строки
				Если ТипЗнч(Значение) = Тип("Булево") Тогда
					Возврат Значение;
				ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
					Возврат (Значение <> 0); // 1 → Истина, 0 → Ложь
				ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
					Стр = НРег(СокрЛП(Значение));
					Если Стр = "истина" Или Стр = "true" Или Стр = "1" Тогда
						Возврат Истина;
					Иначе
						Возврат Ложь;
					КонецЕсли;
				Иначе
					Возврат Ложь;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Ложь; // значение по умолчанию
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьДатуИзНастроекДымовыхТестов(НастройкиИзФайла) Экспорт
	
	Если Не НастройкиИзФайла.Свойство("ДымовыеТесты") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЦелевоеИмя = "ДымовыеТестыНачальнаяДатаДляПодбораДокументов";
	ТаблицаИменКлючей = ИменаКлючейОбщихНастроек();
	
	Для Каждого Элемент Из НастройкиИзФайла.ДымовыеТесты Цикл
		КлючНРег = НРег(Элемент.Ключ);
				
        Для Каждого Стр Из ТаблицаИменКлючей Цикл
			Если Стр.ИмяRU = ЦелевоеИмя И (НРег(Стр.ИмяRU) = КлючНРег Или НРег(Стр.ИмяEn) = КлючНРег) Тогда 
				Значение = Элемент.Значение;
				Если Значение = Неопределено Или ПустаяСтрока(СокрЛП(Значение)) Тогда
					Возврат Неопределено;
				ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
					Возврат Значение;
				ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
					Возврат ПреобразоватьСтрокуВДату(СокрЛП(Значение));
				Иначе
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Неопределено;	
КонецФункции
