&НаКлиенте
Процедура ПоискСообщенийПользователюДляКоторыхНеУказанПеревод(Команда)
	
	Строки = Новый Соответствие;
	
	СтрокиПоиска = Новый Массив;
	СтрокиПоиска.Добавить("Локализовать(""");
	СтрокиПоиска.Добавить("ПолучитьТекстСообщенияПользователю(""");
	
	Путь = Объект.КаталогИнструментов;
	
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение Локализовать("Не заполнен служебный параметр КаталогИнструментов.");
	КонецЕсли;	
	
	Файлы = НайтиФайлы(Путь, "*.bsl", Истина);
	Для Каждого Файл Из Файлы Цикл
		
		Если Найти(Файл.ПолноеИмя, "ПомощникПеревода") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(Файл.ПолноеИмя, "UTF-8");
		ТекстФайла = Текст.Прочитать();
		Текст.Закрыть();
		
		Нашли = Ложь;
		МассивСтрок = _СтрРазделить(ТекстФайла, Символы.ПС);
		Для Сч = 0 По МассивСтрок.Количество()-1 Цикл
			Стр = МассивСтрок[Сч];
			Если Лев(СокрЛ(Стр),2) = "//" Тогда
				Продолжить;
			КонецЕсли;	
			Для Каждого СтрокаПоиска Из СтрокиПоиска Цикл
				Пока Найти(Стр, СтрокаПоиска) > 0 Цикл
					Поз = Найти(Стр, СтрокаПоиска);
					Нашли = Истина;
					Стр = Сред(Стр, Поз + СтрДлина(СтрокаПоиска));
					
					// Поиск закрывающей кавычки с учетом многострочных строк и экранированных кавычек
					ПозЗакрывающейКавычки = 0;
					ДлинаСтроки = СтрДлина(Стр);
					Для Индекс = 1 По ДлинаСтроки Цикл
						Символ = Сред(Стр, Индекс, 1);
						Если Символ = """" Тогда
							// Проверяем, не является ли эта кавычка экранированной (удвоенной)
							Если Индекс < ДлинаСтроки И Сред(Стр, Индекс + 1, 1) = """" Тогда
								// Это экранированная кавычка, пропускаем обе
								Индекс = Индекс + 1;
							Иначе
								// Это закрывающая кавычка
								ПозЗакрывающейКавычки = Индекс;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					// Если закрывающей кавычки нет на текущей строке, ищем продолжение в следующих строках
					Если ПозЗакрывающейКавычки = 0 Тогда
						// Это может быть многострочная строка, ищем продолжение
						СчПродолжение = Сч + 1;
						БуферСтроки = Стр; // Буфер для накопления многострочной строки
						Пока ПозЗакрывающейКавычки = 0 И СчПродолжение < МассивСтрок.Количество() Цикл
							СледСтр = МассивСтрок[СчПродолжение];
							// Проверяем, является ли следующая строка продолжением (начинается с "|" или содержит "|" после пробелов)
							СледСтрСокр = СокрЛП(СледСтр);
							Если Лев(СледСтрСокр, 1) = "|" Тогда
								// Это продолжение многострочной строки
								// Добавляем содержимое строки продолжения (без символа "|" и пробелов после него)
								БуферСтроки = БуферСтроки + Символы.ПС + СледСтрСокр;
								
								// Ищем закрывающую кавычку в буфере с учетом экранирования
								ДлинаБуфера = СтрДлина(БуферСтроки);
								Для Индекс = 1 По ДлинаБуфера Цикл
									Символ = Сред(БуферСтроки, Индекс, 1);
									Если Символ = """" Тогда
										// Проверяем, не является ли эта кавычка экранированной (удвоенной)
										Если Индекс < ДлинаБуфера И Сред(БуферСтроки, Индекс + 1, 1) = """" Тогда
											// Это экранированная кавычка, пропускаем обе
											Индекс = Индекс + 1;
										Иначе
											// Это закрывающая кавычка
											ПозЗакрывающейКавычки = Индекс;
											Прервать;
										КонецЕсли;
									КонецЕсли;
								КонецЦикла;
								
								СчПродолжение = СчПродолжение + 1;
							Иначе
								// Не является продолжением, прекращаем поиск
								Прервать;
							КонецЕсли;	
						КонецЦикла;	
						
						// Если нашли закрывающую кавычку, извлекаем строку из буфера
						Если ПозЗакрывающейКавычки > 0 Тогда
							Стр = Лев(БуферСтроки, ПозЗакрывающейКавычки - 1);
						КонецЕсли;
					Иначе
						// Закрывающая кавычка найдена на текущей строке
						Стр = Лев(Стр, ПозЗакрывающейКавычки - 1);
					КонецЕсли;	
					
					// Замена экранированных кавычек "" на одинарные "
					Стр = СтрЗаменить(Стр, """""", """");
					
					Если ЗначениеЗаполнено(СокрЛП(Стр)) Тогда
						Если СокрЛП(Стр) <> Стр Тогда
							СообщитьПользователю(Локализовать("У строки локализации не должно быть пробелов слева и справа:") + Символы.ПС + Стр + Символы.ПС + Файл.ПолноеИмя + Символы.ПС);
						КонецЕсли;
						
						Если Стр <> """);" Тогда
							Строки.Вставить(СокрЛП(Стр), Истина);
						КонецЕсли;
						
					КонецЕсли;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
		
	КонецЦикла;
	
	ПодключитьБиблиотекуСообщенийПользователю(Истина);
	ДанныеПеревода = МодульСообщенийПользователю.ДанныеПереводаСообщенийЯзыка(Объект.ВерсияПоставки, ЭтаФорма, "en");
	
	Проблемы = Новый СписокЗначений;
	Для Каждого Элем Из Строки Цикл
		Если ДанныеПеревода[Элем.Ключ] = Неопределено Тогда
			Проблемы.Добавить(Элем.Ключ);
		КонецЕсли;	
	КонецЦикла;	
	
	Если Проблемы.Количество() > 0 Тогда
		Проблемы.СортироватьПоЗначению();
		СообщитьПользователю(Локализовать("Не найден перевод для строк:") + Символы.ПС + ЗаписатьОбъектJSON(Проблемы.ВыгрузитьЗначения()));
	КонецЕсли;	
	
КонецПроцедуры

