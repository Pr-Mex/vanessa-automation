	Результат = Новый Массив;
	
	КоличествоСценариев = 0;
	ПолучитьПроблемыПоТекущейФичеРекурсивно(Результат, Объект.ДеревоТестов, КоличествоСценариев);
	Если КоличествоСценариев = 0 Тогда
		Структура = Новый Структура;
		ТекстСообщения = Локализовать("В feature файле нет сценариев.");
		Структура.Вставить("Текст", ТекстСообщения);
		Результат.Добавить(Структура);
	КонецЕсли;	
	
	Возврат Результат;
	
