&НаКлиенте
Процедура ВыгрузитьПеременныеЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    
    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат; 
	КонецЕсли;
    
    ИмяФайла = ВыбранныеФайлы[0];
    
    ЧистыйЛокальныйКонтекст = ПолучитьСериализуемуюКопию(ОбъектКонтекст);
    ЧистыйГлобальныйКонтекст = ПолучитьСериализуемуюКопию(ОбъектКонтекстСохраняемый);
    
    ДД = МодульОбщегоНазначенияVA.ВыгрузитьКонтекстыНаКлиенте(ЧистыйЛокальныйКонтекст, ЧистыйГлобальныйКонтекст);
	ДД.Записать(ИмяФайла);
    
    Сообщить("Контекст переменных успешно выгружен в файл: " + ИмяФайла);
    
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСериализуемуюКопию(Источник)
    
    Если Источник = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ТипИсточника = ТипЗнч(Источник);
    
	Если ТипИсточника = Тип("Строка")
		ИЛИ ТипИсточника = Тип("Число")
		ИЛИ ТипИсточника = Тип("Булево")
		ИЛИ ТипИсточника = Тип("Дата")
		ИЛИ ТипИсточника = Тип("Неопределено")
		ИЛИ ТипИсточника = Тип("Null") Тогда
        Возврат Источник;
    КонецЕсли;
    
    Если ТипИсточника = Тип("Структура") Тогда
        Копия = Новый Структура;
        Для Каждого Элемент Из Источник Цикл
            Если СлужебныеПеременныеКонтекста.Получить(Элемент.Ключ) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Копия.Вставить(Элемент.Ключ, ПолучитьСериализуемуюКопию(Элемент.Значение));
        КонецЦикла;
        Возврат Копия;
    ИначеЕсли ТипИсточника = Тип("Соответствие") Тогда
        Копия = Новый Соответствие;
        Для Каждого Элемент Из Источник Цикл
            Ключ = Элемент.Ключ;
            Пропустить = Ложь;
            Если ТипЗнч(Ключ) = Тип("Строка") И СлужебныеПеременныеКонтекста.Получить(Ключ) <> Неопределено Тогда
                Пропустить = Истина;
            КонецЕсли;
            Если Пропустить Тогда
                Продолжить;
            КонецЕсли;
            Копия.Вставить(Ключ, ПолучитьСериализуемуюКопию(Элемент.Значение));
        КонецЦикла;
        Возврат Копия;
    ИначеЕсли ТипИсточника = Тип("Массив") Тогда
        Копия = Новый Массив;
        Для Каждого Элемент Из Источник Цикл
            Копия.Добавить(ПолучитьСериализуемуюКопию(Элемент));
        КонецЦикла;
        Возврат Копия;
    КонецЕсли;
    
    Возврат "<Несериализуемый тип: " + Строка(ТипИсточника) + ">";
    
КонецФункции
&НаКлиенте
Процедура ЗагрузитьПеременные()
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок = "Выберите файл для загрузки контекста переменных";
    Диалог.Фильтр = "json файлы (*.json)|*.json";
    
    ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьПеременныеЗавершение", ЭтаФорма);
    Диалог.Показать(ОписаниеОповещения);
    
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПеременныеЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    
    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    ИмяФайла = ВыбранныеФайлы[0];
    
    ЗагруженныеКонтексты = МодульСерверныеВызовы.ЗагрузитьКонтекстыСКлиентаКлиент(ИмяФайла);
    
    Если ЗагруженныеКонтексты = Неопределено Тогда
        Сообщить("Не удалось загрузить контекст из файла.");
        Возврат;
    КонецЕсли;

    Если ЗагруженныеКонтексты.Свойство("ЛокальныйКонтекст") Тогда
        МодульОбщегоНазначенияVA.ОбновитьКонтекст(ОбъектКонтекст, ЗагруженныеКонтексты.ЛокальныйКонтекст);
    КонецЕсли;
    
    Если ЗагруженныеКонтексты.Свойство("ГлобальныйКонтекст") Тогда
        МодульОбщегоНазначенияVA.ОбновитьКонтекст(ОбъектКонтекстСохраняемый, ЗагруженныеКонтексты.ГлобальныйКонтекст);
    КонецЕсли;

    ОбновитьЗначенияВТаблоПеременных();
    
    Сообщить("Контекст переменных успешно обновлен из файла: " + ИмяФайла);
    
КонецПроцедуры
&НаКлиенте
Процедура ВыгрузитьВСистемуОтката() 
    
    ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьВСистемуОтката_ПослеВвода", ЭтаФорма);
    
    ПоказатьВводСтроки(ОписаниеОповещения, "", "Введите наименование для сохранения контекста:");
    
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВСистемуОтката_ПослеВвода(ВведенноеИмя, ДополнительныеПараметры) Экспорт
    
    Если ВведенноеИмя = Неопределено ИЛИ ПустаяСтрока(ВведенноеИмя) Тогда
        Сообщить("Сохранение отменено.");
        Возврат;
    КонецЕсли;
    
    ИмяЗаписи = ВведенноеИмя;
    
    ЧистыйЛокальныйКонтекст = ПолучитьСериализуемуюКопию(ОбъектКонтекст);
    ЧистыйГлобальныйКонтекст = ПолучитьСериализуемуюКопию(ОбъектКонтекстСохраняемый);
    
    МодульСерверныеВызовы.ВыгрузитьКонтекстыВРегистрОткатаНаСервереКлиент(ИмяЗаписи, ЧистыйЛокальныйКонтекст, ЧистыйГлобальныйКонтекст);
    
    Сообщить("Контекст успешно выгружен в систему отката с именем '" + ИмяЗаписи + "'.");
    
КонецПроцедуры
&НаКлиенте
Процедура ЗагрузитьИзСистемыОтката() 
      
      СписокВерсий = МодульСерверныеВызовы.ПолучитьСписокСохраненныхКонтекстовССервераКлиент();
      
      Если СписокВерсий.Количество() = 0 Тогда
          Сообщить("Нет ни одной сохраненной версии для загрузки.");
          Возврат;
      КонецЕсли;
      
      СписокДляВыбора = Новый СписокЗначений;
      Для Каждого ЭлементСписка Из СписокВерсий Цикл
          Представление = ЭлементСписка.Наименование + " (" + Формат(ЭлементСписка.Период, "ДФ=dd.MM.yyyy' 'В=HH:mm:ss") + ")";
          Значение = Новый Структура("Наименование, Период", ЭлементСписка.Наименование, ЭлементСписка.Период);
          СписокДляВыбора.Добавить(Значение, Представление);
	  КонецЦикла;
	  ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.ТаблоПеременныхЗакрытьТаблоПеременных;
	  ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьИзСистемыОтката_ПослеВыбора", ЭтаФорма );
      
      ПоказатьВыборИзСписка(ОписаниеОповещения, СписокДляВыбора);
КонецПроцедуры	  
&НаКлиенте
Процедура ЗагрузитьИзСистемыОтката_ПослеВыбора(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

      Если ВыбранныйЭлемент = Неопределено Тогда
          Сообщить("Загрузка отменена.");
          Возврат;
      КонецЕсли;

      КлючЗаписи = ВыбранныйЭлемент.Значение;

      ЗагруженныеКонтексты = МодульСерверныеВызовы.ЗагрузитьКонтекстыИзРегистраОткатаССервераКлиент(КлючЗаписи);

      Если ЗагруженныеКонтексты = Неопределено Тогда
          Сообщить("Не удалось загрузить выбранную версию.");
          Возврат;
      КонецЕсли;

      Если ЗагруженныеКонтексты.Свойство("ЛокальныйКонтекст") Тогда
          МодульОбщегоНазначенияVA.ОбновитьКонтекст(ОбъектКонтекст, ЗагруженныеКонтексты.ЛокальныйКонтекст);
      КонецЕсли;

      Если ЗагруженныеКонтексты.Свойство("ГлобальныйКонтекст") Тогда
          МодульОбщегоНазначенияVA.ОбновитьКонтекст(ОбъектКонтекстСохраняемый, ЗагруженныеКонтексты.ГлобальныйКонтекст);
      КонецЕсли;

      ОбновитьЗначенияВТаблоПеременных();

      Сообщить("Контекст '" + ВыбранныйЭлемент.Представление + "' успешно загружен и обновлен.");

КонецПроцедуры
&НаКлиенте
Процедура ОбновитьЗначенияВТаблоПеременных() Экспорт
	Если НЕ Элементы.ГруппаПросмотрПеременных.Видимость Тогда
		Возврат;
	КонецЕсли;	 
	
	ТекИсточникДанных = Неопределено;
	ТекИмя = Неопределено;
	Если Элементы.ТаблоПеременных.ТекущиеДанные <> Неопределено Тогда
		ТекИсточникДанных = Элементы.ТаблоПеременных.ТекущиеДанные.ИсточникДанных;
		ТекИмя = Элементы.ТаблоПеременных.ТекущиеДанные.Имя;
	КонецЕсли;	 
	
	СтрокиТаблоПеременных = ТаблоПеременных.ПолучитьЭлементы();
	СтрокиТаблоПеременных.Очистить();
	
	// Контекст
	СписокЗначенийКонтекст = Новый СписокЗначений;
	Если ТипЗнч(ОбъектКонтекст) = Тип("Структура") Тогда
		Для Каждого Элем Из ОбъектКонтекст Цикл
			СписокЗначенийКонтекст.Добавить(Элем.Ключ);
		КонецЦикла;	 
	КонецЕсли;	 
	СписокЗначенийКонтекст.СортироватьПоЗначению();
	
	СтрокаТаблоПеременных = СтрокиТаблоПеременных.Добавить();	
	СтрокаТаблоПеременных.Имя = Локализовать("Контекст");
	СтрокаТаблоПеременных.СлужебнаяСтрока = Истина;
	
	СтрокиКонтекст = СтрокаТаблоПеременных.ПолучитьЭлементы();
	Для Каждого Элем Из СписокЗначенийКонтекст Цикл
		Если НЕ ПоказыватьСлужебныеПеременные Тогда
			
			Если ЭтоСлужебнаяПеременнаяКонтекста(Элем.Значение) Тогда
				Продолжить;
			КонецЕсли;	 
			
		КонецЕсли;	 
		
		МодульОбщегоНазначенияVA.ВывестиПеременнуюВТаблоПеременных(СтрокиКонтекст, Элем.Значение, ОбъектКонтекст[Элем.Значение], "Контекст");
		
	КонецЦикла;	 
	
	
	
	
	// КонтекстСохраняемый
	СписокЗначенийКонтекст = Новый СписокЗначений;
	Попытка
	Для Каждого Элем Из ОбъектКонтекстСохраняемый Цикл
		СписокЗначенийКонтекст.Добавить(Элем.Ключ);
	КонецЦикла;
	Исключение
	КонецПопытки;	 
	СписокЗначенийКонтекст.СортироватьПоЗначению();
	
	СтрокаТаблоПеременных = СтрокиТаблоПеременных.Добавить();	
	СтрокаТаблоПеременных.Имя = Локализовать("Контекст глобальный");
	СтрокаТаблоПеременных.СлужебнаяСтрока = Истина;
	
	СтрокиКонтекстСохраняемый = СтрокаТаблоПеременных.ПолучитьЭлементы();
	Для Каждого Элем Из СписокЗначенийКонтекст Цикл
		
		Если НЕ ПоказыватьСлужебныеПеременные Тогда
			Если ЭтоСлужебнаяПеременнаяКонтекста(Элем.Значение) Тогда
				Продолжить;
			КонецЕсли;	 
		КонецЕсли;	 
		
		МодульОбщегоНазначенияVA.ВывестиПеременнуюВТаблоПеременных(СтрокиКонтекстСохраняемый, Элем.Значение, ОбъектКонтекстСохраняемый[Элем.Значение], "КонтекстСохраняемый");
		
	КонецЦикла;	 
	
	ЭлементыТабло = ТаблоПеременных.ПолучитьЭлементы();
	СтрокаТабло = МодульОбщегоНазначенияVA.НайтиСтрокуТаблоИмяИсточник(ЭлементыТабло, ТекИмя, ТекИсточникДанных);
	Если СтрокаТабло <> Неопределено Тогда
		Элементы.ТаблоПеременных.ТекущаяСтрока = СтрокаТабло.ПолучитьИдентификатор();
	КонецЕсли;	 
	
	ПодключитьОбработчикОжидания("РазвернутьСвернутьСтрокиТаблоПеременных", 0.1, Истина);
КонецПроцедуры 
&НаКлиенте
Процедура НайтиСтрокуТаблоРекурсивно(ЭлементыТабло, Имя, ИсточникДанных, НужнаяСтрока) Экспорт
