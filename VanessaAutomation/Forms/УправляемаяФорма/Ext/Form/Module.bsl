	Возврат ПреобразоватьТабличныйДокументВМассив(Макет, ДопПараметры);
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьФайлМакетаВМассивСервер(Знач ДанныеМакета, ДопПараметры)
	// У параметра ДопПараметры специально нет "Знач", т.к. может происходить возврат значения в структуре

	Если ТипЗнч(ДанныеМакета) = Тип("ДвоичныеДанные") Тогда
		
		Попытка
			
			ТД = ТабличныйДокументИзДвоичныхДанныхПоток(ДанныеМакета);
			
		Исключение
			
			ЗаписатьЛогВЖРОшибкаСервер("ПреобразоватьФайлМакетаВМассивСервер", ОписаниеОшибки());
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
			
			ДанныеМакета.Записать(ИмяВременногоФайла);
			
			ТД = ПрочитатьФайлВТабличныйДокументНаСервере(ИмяВременногоФайла);
			
			Попытка
				УдалитьФайлы(ИмяВременногоФайла);
			Исключение
			КонецПопытки;
		КонецПопытки;
		
		Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("РезультатТабличныйДокумент") Тогда
			ДопПараметры.РезультатТабличныйДокумент = ТД;
		КонецЕсли;	
		
		Возврат ПреобразоватьТабличныйДокументВМассив(ТД, ДопПараметры); 
	Иначе
		Возврат ПреобразоватьТабличныйДокументВМассив(ДанныеМакета, ДопПараметры); 
	КонецЕсли;	 
	
КонецФункции	

// Клиентская обёртка над серверным ПреобразоватьФайлМакетаВМассивСервер (кросс-форменный вызов серверного невозможен — урок 33).
