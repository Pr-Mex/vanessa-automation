Функция РасширениеУстановленоСрвер(ИмяРасширения)
	
	Попытка
		УстановленныеРасширения = Вычислить("РасширенияКонфигурации").Получить();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Если УстановленныеРасширения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаРасширений = РазложитьСтрокуВМассивПодстрок(ИмяРасширения, ";", Ложь);

	Для Каждого Расширение Из УстановленныеРасширения Цикл
		Для Каждого ТекущееИмяРасширения Из ИменаРасширений Цикл
			Если НРег(Расширение.Имя) = НРег(СокрЛП(ТекущееИмяРасширения)) И Расширение.Активно Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
