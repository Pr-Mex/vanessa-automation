			Элементы.ТаблоПеременных.Свернуть(ИдентификаторСтроки);
		КонецЦикла;	 
		
		Для Каждого ПодчиненнаяСтрока Из СтрокиТаблоПеременных[1].ПолучитьЭлементы() Цикл
			ИдентификаторСтроки = ПодчиненнаяСтрока.ПолучитьИдентификатор();
			Элементы.ТаблоПеременных.Свернуть(ИдентификаторСтроки);
		КонецЦикла;	 
		
	КонецЕсли;	 
