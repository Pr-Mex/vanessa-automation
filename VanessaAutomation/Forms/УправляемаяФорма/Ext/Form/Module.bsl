	МодульОбщегоНазначенияVA.ПроверкаЭтоШагПроверкиОкнаИПроблемаССимволомЗвездочка(ТекСтрока, Результат);
КонецПроцедуры
&НаКлиенте
Процедура ОповеститьMCPСерверОВыполненииШага(МассивСценариев, ИД_СценарияВМассиве, ИД_ШагаВМассиве)
	
	ВсегоШагов = 0;
	НомерШага = 0;
	ИдСценария = -1;
	Для Каждого ТекСценарий Из МассивСценариев Цикл
		ИдСценария = ИдСценария + 1;
		ВсегоШагов = ВсегоШагов + ТекСценарий.Шаги.Количество();
		Если ИдСценария = ИД_СценарияВМассиве Тогда
			Продолжить;
		КонецЕсли;	
		НомерШага = НомерШага + ТекСценарий.Шаги.Количество();
	КонецЦикла;
	
	НомерШага = НомерШага + ИД_ШагаВМассиве + 1;
	
	МодульMCPVA.МодульМсп_Сервер().УведомитьОПрогрессе(ИдентификаторЗадачиMCP(), НомерШага, ВсегоШагов, Локализовать("Выполнение шага сценария."));

