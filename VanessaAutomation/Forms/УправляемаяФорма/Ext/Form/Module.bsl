	КонецЕсли;
	
	ОпределениеВерсииПлатформы();
	
	Если ПустаяСтрока(VanessaEditorURL) И Версия851ИлиВыше Тогда
		Возврат;
	КонецЕсли;	
	
	МодульРедакторТекста.ИнициализироватьVanessaEditorКлиент();
	
	Если ВыполнитьПослеОткрытияФормы2 Тогда
		ВыполнитьПослеОткрытияФормы2 = Ложь;
		ПослеОткрытияФормы2();
	КонецЕсли;	
	
	Если ВыполнитьИнициализироватьVanessaEditorКлиент2 Тогда
		ВыполнитьИнициализироватьVanessaEditorКлиент2 = Ложь;
		МодульРедакторТекста.ИнициализироватьVanessaEditorКлиент2();
	КонецЕсли;	
	
