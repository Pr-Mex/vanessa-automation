				ШагУточ.Вставить("ИгнорироватьШагВАвтоинструкции",Ложь);
			ИначеЕсли ТекущийШаг.Свойство("ПоследнийВГруппеШагов") и ТекущийШаг.ПоследнийВГруппеШагов тогда
				// Последний шаг в группе создает скриншоты, значит не будем игнорировать
				ШагУточ.Вставить("ИгнорироватьШагВАвтоинструкции",Ложь);
			Иначе	
				ШагУточ.Вставить("ИгнорироватьШагВАвтоинструкции",Истина);
			КонецЕсли;
		Иначе	
			//ШагУточ.Вставить("ИгнорироватьШагВАвтоинструкции",Неопределено);  //+++ ЦВ_ПР 22.10.2025  Оставим как было в исходном Шаге Без значения
		КонецЕсли;
	ИначеЕсли ТекущийШаг.ИгнорироватьШагВАвтоинструкции = Неопределено тогда
