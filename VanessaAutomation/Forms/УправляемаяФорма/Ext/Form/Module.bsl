//+++ ЦВ_ПР 24.06.2025 Обработка строки Текста с учетом переменных и фигурных скобок
&НаКлиенте
Функция ОбработкаДопТекста (знач СтрокаДопТекста) экспорт
	Если СтрокаДопТекста = Неопределено или Не ЗначениеЗаполнено(СтрокаДопТекста) Тогда
		Возврат "";
	КонецЕсли;  
	Если ТипЗнч(СтрокаДопТекста)<> Тип("Строка")Тогда
		Возврат "";
	КонецЕсли;   
	
	СтрДоп = СтрЗаменить(СтрокаДопТекста, "|", "");
	СтрДоп = СокрЛП(СтрЗаменить(СтрДоп, "'", ""));
	Если Найти(СтрДоп, "$") > 0 Тогда
		ВТаблицахИспользовалисьПеременные = Истина;
	КонецЕсли;	 
	СтрДоп = МодульОбщегоНазначенияVA.ПолучитьЗначениеИзКонтекстаЕслиЭтоВозможно(СтрДоп, Ложь);
	Если Найти(СтрДоп,"$") > 0 Тогда
		СтрДоп = ПодставитьПеременныеВСтроку(СтрДоп);
	КонецЕсли; 
	Если Найти(СтрДоп, "{") > 0 Тогда
 		ДанныеПоПростымПеременным = 0; // Из ДанныеПоПростымПеременнымПоТекущемуСценарию() может вернуться Неопределено, поэтому инициалиция нулём
		ДанныеПоПеременныхВТаблицах = 0; // Тоже самое
		Если МассивСценариевДляВыполнения[ТекИД_СценарияВМассиве].ЕстьСекцияПеременные ИЛИ Объект.ВычислятьВыраженияВФигурныхСкобках Тогда
			СтрДоп = ВычислитьИнлайнВыражениеЕслиЭтоВозможно(СтрДоп, ДанныеПоПростымПеременным, ДанныеПоПеременныхВТаблицах, МассивСценариевДляВыполнения[ТекИД_СценарияВМассиве].ЕстьСекцияПеременные);
		КонецЕсли;  
	КонецЕсли;
	СтрокаДопТекста = СтрДоп;
	Возврат СтрокаДопТекста;
КонецФункции
//--- ЦВ_ПР 24.06.2025				

&НаКлиенте
Процедура ДобавитьСтрокуКакТекст(ДокументHTML, УзелРодитель, Стр, ЭтоШагБезСкриншота) Экспорт
