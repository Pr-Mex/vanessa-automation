			// подменяется свойства первого и последнего шага в группе [проверить, чтобы не поменялся на иной].
            ШагУточ.Вставить("ИгнорироватьШагВАвтоинструкции",Ложь); 
			ШагУточ.Вставить("ВнутриГруппыКотораяРаботаетКакОдинШаг",Ложь);
			ШагУточ.Вставить("ПервыйВГруппеШагов",Истина); 
