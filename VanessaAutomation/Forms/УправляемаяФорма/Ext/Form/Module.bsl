&НаКлиенте
Процедура ПолучитьПроблемыПоТекущейФичеРекурсивно(Результат, СтрокаДерева, КоличествоСценариев)
	
	ПредыдущийСнипет = Неопределено;
	Для Каждого ТекСтрока Из СтрокаДерева.ПолучитьЭлементы() Цикл
		Если ТекСтрока.Тип = "Шаг" Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.СтрокаРеальнойПроцедуры) Тогда
				Структура = Новый Структура;
				Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
				ТекстСообщения = Локализовать("Шаг не найден в библиотеке известных шагов: %1");
				ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.Имя);
				Структура.Вставить("Текст", ТекстСообщения);
				Результат.Добавить(Структура);
			Иначе
				ПроверкаЭтоШагПроверкиОкнаИПроблемаССимволомЗвездочка(ТекСтрока, Результат);
				
				// Проверка запрещённой последовательности:
				// "ВПанелиРазделовЯВыбираю" сразу перед "ВПанелиФункцийЯВыбираю"
				ТекСнипетНРег = НРег(ПолучитьИмяСнипетаБезПараметров(ТекСтрока.Снипет));
				Если ТекСнипетНРег = "впанелифункцийявыбираю"
					И ПредыдущийСнипет = "впанелиразделовявыбираю" Тогда
					
					Структура = Новый Структура;
					Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
					ТекстСообщения = Локализовать("В строке `%1` шаг ""ВПанелиФункцийЯВыбираю"" идёт сразу после шага ""ВПанелиРазделовЯВыбираю"".
					|Это ошибка. Вместо этих двух шагов вызать один шаг:
					|И В командном интерфейсе я выбираю 'КнопкаПанелиРазделов' 'КнопкаПанелиФункций'
					|Параметры надо заполнить из ваших шагов.");
					ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, XMLСтрока(ТекСтрока.НомерСтрокиВФиче));
					Структура.Вставить("Текст", ТекстСообщения);
					Результат.Добавить(Структура);
				КонецЕсли;
				ПредыдущийСнипет = ТекСнипетНРег;
			КонецЕсли;
			
		ИначеЕсли ТекСтрока.Тип = "Область" Тогда
			
			ЭлементыСтроки = ТекСтрока.ПолучитьЭлементы();
			Если ЭлементыСтроки.Количество() = 0 Тогда
				Структура = Новый Структура;
				Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
				ТекстСообщения = Локализовать("Обнаружена пустая группа шагов `%1` в тексте сценария. Пустых групп быть не должно. Чтобы шаги принадлежали группе - нужно задать им отступы так, чтобы они были в группе.");
				ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.Имя);
				Структура.Вставить("Текст", ТекстСообщения);
				Результат.Добавить(Структура);
				Продолжить;
			КонецЕсли;
			
			Если СокрЛП(НРег(ТекСтрока.Имя)) = "конецесли" Тогда
				Структура = Новый Структура;
				Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
				ТекстСообщения = Локализовать("В синтаксисте Turbo Gherkin нельзя использовать оператор `КонецЕсли`. Границы тела условия определяются как в языке python по отступам.");
				Структура.Вставить("Текст", ТекстСообщения);
				Результат.Добавить(Структура);
			ИначеЕсли СокрЛП(НРег(ТекСтрока.Имя)) = "конецикла" Тогда
				Структура = Новый Структура;
				Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
				ТекстСообщения = Локализовать("В синтаксисте Turbo Gherkin нельзя использовать оператор `КонецЦикла`. Границы тела цикла определяются как в языке python по отступам.");
				Структура.Вставить("Текст", ТекстСообщения);
				Результат.Добавить(Структура);
			ИначеЕсли СокрЛП(НРег(ТекСтрока.Имя)) = "иначе" Тогда
				ЭлементыРодителя = ТекСтрока.ПолучитьРодителя().ПолучитьЭлементы();
				КолИначе = 0;
				Для Каждого Элем Из ЭлементыРодителя Цикл
					Если НРег(Элем.Имя) = "иначе" Тогда
						КолИначе = КолИначе + 1;
						Если КолИначе > 1 Тогда
							Структура = Новый Структура;
							Структура.Вставить("НомерСтроки", Элем.НомерСтрокиВФиче);
							ТекстСообщения = Локализовать("Ошибка в строке `%1`. Используется ключевое слово Иначе, повторно в одном условии.");
							ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, XMLСтрока(Элем.НомерСтрокиВФиче));
							Структура.Вставить("Текст", ТекстСообщения);
							Результат.Добавить(Структура);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли НЕ ЗначениеЗаполнено(ТекСтрока.ДопТип) И Лев(СокрЛП(ТекСтрока.Имя), 1) <> "*" Тогда
				// значит это группа шагов, которая сделана не по правилам
				
				ЕстьТакойШаг = Ложь;
				Попытка
					ДанныеШагаИзСтроки = МодульПарсерФич.ПолучитьДанныеШагаИзСтроки(ТекСтрока.Имя);
					
					Если НРег(ДанныеШагаИзСтроки.Имя) = НРег(ДанныеШагаИзСтроки.СнипетБезПараметров) Тогда
						// Значит шаг сосоит из одного слова, например, <И>, <Если> и т.д.
						Структура = Новый Структура;
						Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
						ТекстСообщения = Локализовать("Ошибка в строке `%1`. Шаг не может состоять только из одного ключевого слова `%2`.");
						ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, XMLСтрока(ТекСтрока.НомерСтрокиВФиче), ДанныеШагаИзСтроки.Имя);
						Структура.Вставить("Текст", ТекстСообщения);
						Результат.Добавить(Структура);
						Продолжить;
					КонецЕсли;
					
					ДанныеОтбора = Новый Структура;
					ДанныеОтбора.Вставить("СтрокаДляПоиска", НРег(ДанныеШагаИзСтроки.СнипетБезПараметров));
					СтрокиТаблицаИзвестныхStepDefinition = ТаблицаИзвестныхStepDefinition.НайтиСтроки(ДанныеОтбора);
					Если СтрокиТаблицаИзвестныхStepDefinition.Количество() = 1 Тогда
						ЕстьТакойШаг = Истина;
					КонецЕсли;
				Исключение
				КонецПопытки;
				
				Если ЕстьТакойШаг Тогда
					Структура = Новый Структура;
					Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
					ТекстСообщения = Локализовать("В строке `%1` обнаружена попытка использовать шаг как группу шагов. Это ошибка. Проверьте отступы в строках следующих за строкой `%1`.");
					ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, XMLСтрока(ТекСтрока.НомерСтрокиВФиче));
					Структура.Вставить("Текст", ТекстСообщения);
					Результат.Добавить(Структура);
				Иначе
					Структура = Новый Структура;
					Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
					ТекстСообщения = Локализовать("Если в строке `%1` предполагалось использовать группу шагов, то имя группы шагов должно начинаться с символа `*`, а обнаружено `%2`." + Символы.ПС + "Если в строке `%1` предполагалось использовать обычный шаг, условие или цикл, то такого шага не существует.");
					ТекстСообщения = ПодставитьПараметрыВСтроку(ТекстСообщения, XMLСтрока(ТекСтрока.НомерСтрокиВФиче), ТекСтрока.Имя);
					Структура.Вставить("Текст", ТекстСообщения);
					Результат.Добавить(Структура);
				КонецЕсли;
				
			КонецЕсли;
		ИначеЕсли ТекСтрока.Тип = "Сценарий" И ТекСтрока.ДопТип <> "Контекст" Тогда
			КоличествоСценариев = КоличествоСценариев + 1;
		КонецЕсли;
		
		ПолучитьПроблемыПоТекущейФичеРекурсивно(Результат, ТекСтрока, КоличествоСценариев);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИмяСнипетаБезПараметров(Снипет)

    Результат = "";
    Если НЕ ЗначениеЗаполнено(Снипет) Тогда
        Возврат Результат;
    КонецЕсли;

    Поз = Найти(Снипет, "(");
    Если Поз > 0 Тогда
        Результат = Лев(Снипет, Поз - 1);
    Иначе
        Результат = Снипет;
    КонецЕсли;

    Возврат СокрЛП(Результат);

КонецФункции

