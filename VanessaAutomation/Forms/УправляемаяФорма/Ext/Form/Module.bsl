&НаКлиентеНаСервереБезКонтекста
Функция ПреобразоватьСтрокуВДату(Знач Стр)
	НачСтр = Стр;
	
	Год   = 0;
	Год2000 = 2000;
	Век = 100;
	Месяц = 0;
	День  = 0;
	
	Поз  = Найти(Стр, ".");
	День = Число(Лев(Стр, Поз - 1));
	Стр = Сред(Стр, Поз + 1);
	
	Поз   = Найти(Стр, ".");
	Месяц = Число(Лев(Стр, Поз - 1));
	Стр   = Сред(Стр, Поз + 1);
	
	Год   = Число(Стр);
	Если СтрДлина(Стр) = 2 И Год < Век Тогда
		Год = Год + Год2000;
	КонецЕсли;
	
	Возврат Дата(Год, Месяц, День);
КонецФункции

