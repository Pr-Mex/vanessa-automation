&НаКлиенте
Процедура ОбновитьСлужебнуюСтруктуруГлобальныеЗначенияШагов()
	СостояниеVA = ПолучитьСостояниеVanessaAutomation();
	ИдШага = СостояниеVA.ТекущийШаг.ИдСтроки;
	ИдШагаСОшибкой = Неопределено;
	Если ИдШага <> Неопределено Тогда
		Если ГлобальныеЗначенияШагов.Свойство("ИдШагаСОшибкой") Тогда
			ИдШагаСОшибкой = ГлобальныеЗначенияШагов.ИдШагаСОшибкой;
		КонецЕсли;	
	КонецЕсли;
	
	Если ИдШагаСОшибкой <> Неопределено И ИдШагаСОшибкой <> ИдШага Тогда
		ГлобальныеЗначенияШагов = Новый Структура;
	КонецЕсли;
	
	ГлобальныеЗначенияШагов.Вставить("ИдШагаСОшибкой", ИдШага);
	
КонецПроцедуры

