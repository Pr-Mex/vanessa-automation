	Иначе	
		СтрокаПоиска = КаталогПрограммы + "1cv8c.exe";
		СтрокаПоиска_d = КаталогПрограммы + "1cv8cd.exe";
		СтрокаПоиска_t = КаталогПрограммы + "1cv8ct.exe";
	КонецЕсли;	
	Если ФайлСуществуетКомандаСистемы(СтрокаПоиска) Тогда
	ИначеЕсли ФайлСуществуетКомандаСистемы(СтрокаПоиска_d) Тогда
		ИмяИсполняемогоФайлаТонкийКлиент = "1cv8cd";
		ИмяИсполняемогоФайлаТолстыйКлиент = "1cv8d";
	ИначеЕсли ФайлСуществуетКомандаСистемы(СтрокаПоиска_t) Тогда
		ИмяИсполняемогоФайлаТонкийКлиент = "1cv8ct";
		ИмяИсполняемогоФайлаТолстыйКлиент = "1cv8t";
	КонецЕсли;	
	
