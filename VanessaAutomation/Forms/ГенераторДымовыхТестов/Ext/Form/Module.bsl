&НаСервереБезКонтекста
Процедура ДобавитьТекстРасширенныеДействия(Текст, Задание, ОбъектМетаданных, Группа = Ложь)
	
	Если ПроверитьВМассивеИсключений(Задание.Исключения, ОбъектМетаданных.Имя, Задание.ТипТеста, ?(Группа, "Группа", "Элемент")) Тогда
		Возврат;
	КонецЕсли;

	Отбор = ОтборПодбораЭлемента(Задание, ОбъектМетаданных);
	
	Если Задание.ТипТеста = "Запись" ИЛИ Задание.ТипТеста = "Копирование" Тогда
		
		Если Группа Тогда
			Отбор.ТолькоГруппы = Истина;
		ИначеЕсли ЕстьГруппы(Задание.Вид, ОбъектМетаданных) Тогда
			// Сначала сценарий для группы, затем для элемента.
			ДобавитьТекстРасширенныеДействия(Текст, Задание, ОбъектМетаданных, Истина);
			Отбор.КромеГрупп = Истина;
		КонецЕсли;
		
	ИначеЕсли Задание.ТипТеста = "ВводНаОсновании" Тогда
		
		// Проверим, есть ли объекты для ввода на основании
		ПодчиненныеОбъекты = Задание.ВводНаОсновании.НайтиСтроки(Новый Структура("Основание", ОбъектМетаданных));
		Если ПодчиненныеОбъекты.Количество() = 0 Тогда
			// Нет объектов, которые вводятся на основании
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Задание.ТипТеста = "Печать" Тогда
		
		КомандыПечати = КомандыПечатиОбъекта(Задание.Вид, ОбъектМетаданных);
		Если КомандыПечати.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
			
	КонецЕсли;
	
	// У групп нет команд печати и ввода на основании: печать и ввод на основании проверяются на элементе.
	Если (Задание.ТипТеста = "ВводНаОсновании" ИЛИ Задание.ТипТеста = "Печать")
		И ЕстьГруппы(Задание.Вид, ОбъектМетаданных) Тогда
		Отбор.КромеГрупп = Истина;
	КонецЕсли;
	
	Если Задание.ТолькоВведенныеОбъекты
		И Не ЕстьЭлементПодОтбор(Задание.Вид.ИмяТипа, ОбъектМетаданных.Имя, Отбор) Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеОбъекта = ПредставлениеОбъектаВСценарии(Задание, ОбъектМетаданных, Группа);
	
	ДобавитьТекстПоискаЭлемента(Текст, Задание, ОбъектМетаданных, Группа, Отбор, ПредставлениеОбъекта);
	
	Если Задание.ТипТеста = "Копирование" Тогда
		ДобавитьТекстКопирования(Текст, Задание, ОбъектМетаданных, Группа, ПредставлениеОбъекта);
	ИначеЕсли Задание.ТипТеста = "Запись" Тогда
		ДобавитьТекстЗаписи(Текст, Задание, ОбъектМетаданных, ПредставлениеОбъекта);
	ИначеЕсли Задание.ТипТеста = "ВводНаОсновании" Тогда
		ДобавитьТекстВводаНаОсновании(Текст, Задание, ОбъектМетаданных, ПодчиненныеОбъекты, ПредставлениеОбъекта);
	ИначеЕсли Задание.ТипТеста = "Печать" Тогда
		ДобавитьТекстПечати(Текст, Задание, ОбъектМетаданных, КомандыПечати, ПредставлениеОбъекта);
	КонецЕсли;
	
	ДобавитьТекстПропускаБезДанных(Текст, Задание, Отбор, ПредставлениеОбъекта);
	
КонецПроцедуры

// Как объект называется в текстах сценария: «группы справочника Номенклатура».
&НаСервереБезКонтекста
Функция ПредставлениеОбъектаВСценарии(Задание, ОбъектМетаданных, Группа)
	
	Если Задание.ЯзыкШагов = "ru" Тогда
		Возврат ?(Группа, "группы ", "") + Задание.Вид.ВРодительномПадеже + " " + ОбъектМетаданных.Имя;
	КонецЕсли;
	
	Возврат ?(Группа, "group ", "") + Задание.ПредставлениеВида + " " + ОбъектМетаданных.Имя;
	
КонецФункции

// Начало сценария: заголовок, подбор существующего элемента запросом и открытие его формы.
&НаСервереБезКонтекста
Процедура ДобавитьТекстПоискаЭлемента(Текст, Задание, ОбъектМетаданных, Группа, Отбор, ПредставлениеОбъекта)
	
	ТекстУсловие = ТекстУсловияОтбора(Отбор, Задание.ЯзыкШагов);
	ТекстСортировка = ТекстСортировкиОтбора(Отбор, Задание.ЯзыкШагов);
	
	Если Задание.ЯзыкШагов = "ru" Тогда

		// Подготавливаем строку установки параметра (только если дата задана)
		СтрокаУстановкиПараметра = "";
		Если ЗначениеЗаполнено(Отбор.НачальнаяДата) Тогда
			// представим дату как литерал вида '2025-04-07T00:00:00'
			ЛитералДаты = Формат(Отбор.НачальнаяДата, "ДФ=yyyy-MM-ddTHH:mm:ss");

			СтрокаУстановкиПараметра =
			"
		    |           	Запрос.УстановитьПараметр(""ДымовыеТестыНачальнаяДатаДляПодбораДокументов"", Дата('" + ЛитералДаты + "'));";
		КонецЕсли;
		
		Текст.ДобавитьСтроку("
		|Сценарий: " + Задание.ТипТеста + " элемента " + ?(Группа, "группы ", "") + Задание.Вид.ВРодительномПадеже + " """ + ОбъектМетаданных.Синоним + """ (" + ОбъектМетаданных.Имя + ")
		|
		|	* Ищем ссылку на существующий элемент
		|		И я выполняю код встроенного языка на сервере
		|		""""""bsl
		|			Объект.ЗначениеНаСервере = НЕОПРЕДЕЛЕНО;
		|			Запрос = Новый Запрос(
		|				""ВЫБРАТЬ ПЕРВЫЕ 1
		|				|	ТекДанныеИсточник.Ссылка КАК Ссылка
		|				|ИЗ
		|				|	" + Задание.Вид.ИмяТипа + "." + ОбъектМетаданных.Имя + " КАК ТекДанныеИсточник
		|				|ГДЕ
		|				|	НЕ ТекДанныеИсточник.ПометкаУдаления
		|				|	" + ТекстУсловие + ТекстСортировка + """);" + СтрокаУстановкиПараметра + "
		|			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
		|			Если ВыборкаЗапроса.Следующий() Тогда
		|				Объект.ЗначениеНаСервере = ПолучитьНавигационнуюСсылку(ВыборкаЗапроса.Ссылка);
		|			КонецЕсли;
		|		""""""
		|		И Я запоминаю значение выражения 'Объект.ЗначениеНаСервере' в переменную 'НавигационнаяСсылка'
		|
		|	Если 'ЗначениеЗаполнено($НавигационнаяСсылка$)' Тогда
		|
		|		* Отрываем форму существующего элемента
		|			И Я открываю навигационную ссылку '$НавигационнаяСсылка$'
		|			Если появилось предупреждение Тогда
		|				Тогда я вызываю исключение ""Не удалось открыть существующий элемент " + ПредставлениеОбъекта + """" + "
		|			Если имя текущей формы ""ErrorWindow"" Тогда
		|				Тогда я вызываю исключение ""Не удалось открыть существующий элемент " + ПредставлениеОбъекта + """" + "
		|			И я запоминаю имя формы в переменную 'ИмяФормы'");
		
	Иначе

		// Подготавливаем строку установки параметра (только если дата задана)
		СтрокаУстановкиПараметра = "";
		Если ЗначениеЗаполнено(Отбор.НачальнаяДата) Тогда
			ЛитералДаты = Формат(Отбор.НачальнаяДата, "ДФ=yyyy-MM-ddTHH:mm:ss");
			СтрокаУстановкиПараметра =
			"
		    |           | 'Query.SetParameter(""ДымовыеТестыНачальнаяДатаДляПодбораДокументов"", Date('" + ЛитералДаты + "'));' |";
		КонецЕсли;
		
		ТекстЗапросаНаАнглийском = "SELECT TOP 1 CurrentDataSource.Ref AS Ref FROM " + Задание.Вид.ИмяТипаEn + "." + ОбъектМетаданных.Имя + " AS CurrentDataSource WHERE Not CurrentDataSource.DeletionMark " + ТекстУсловие + ТекстСортировка;
		
		Текст.ДобавитьСтроку("
		|Scenario: " + Задание.ПредставлениеТипаТеста + " item " + ?(Группа, "group ", "") + Задание.ПредставлениеВида + " """ + ОбъектМетаданных.Синоним + """ (" + ОбъектМетаданных.Имя + ")
		|
		|	* Search for a link to an existing item
		|		And I execute 1C:Enterprise script at server 
		|			| 'Объект.ЗначениеНаСервере = Undefined;'			|
		|			| 'Query = Новый Query;'								|
		|			| 'Query.Text = """ + ТекстЗапросаНаАнглийском + """;'	|" + СтрокаУстановкиПараметра + "
		|			| 'QueryResult = Query.Execute();'						|
		|			| 'Selection = QueryResult.Select();'					|
		|			| 'While Selection.Next() Do'							|
		|			| 'Объект.ЗначениеНаСервере = GetURL(Selection.Ref);'	|
		|			| 'EndDo;'												|
		|		And I save 'Объект.ЗначениеНаСервере' in 'НавигационнаяСсылка' variable 
		|
		|	If 'ValueIsFilled($НавигационнаяСсылка$)' then
		|
		|		* Open form of an existing item
		|			Given I open hyperlink '$НавигационнаяСсылка$'
		|			If the warning is displayed then
		|				Then I raise ""Could not open existing item " + ПредставлениеОбъекта + """ exception" + "
		|			If current form name is ""ErrorWindow"" Then
		|				Then I raise ""Could not open existing item " + ПредставлениеОбъекта + """ exception" + "
		|			And I save form header as 'ЗаголовокФормы' variable");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьТекстКопирования(Текст, Задание, ОбъектМетаданных, Группа, ПредставлениеОбъекта)
	
	ПредставлениеФормаЗаписать = ПредставлениеВариантаВстроенногоЯзыка("ФормаЗаписать", Задание.ВариантВстроенногоЯзыка);

	Если Задание.ЯзыкШагов = "ru" Тогда
		Если Группа Тогда
			ШагКопирования = "И я копирую группу объекта через команду формы '" + Задание.Вид.ИмяТипа + "." + ОбъектМетаданных.Имя + "'";
		Иначе
			ШагКопирования = "И я копирую элемент объекта через команду формы '" + Задание.Вид.ИмяТипа + "." + ОбъектМетаданных.Имя + "'";
		КонецЕсли;
		Текст.ДобавитьСтроку("
		|		* Создаем новый элемент копированием
		|			Когда открылась форма с именем '$ИмяФормы$'
		|			" + ШагКопирования + "
		|			Если появилось предупреждение Тогда
		|				Тогда я вызываю исключение ""Не удалось скопировать существующий элемент " + ПредставлениеОбъекта + """" + "
		|			Если имя текущей формы ""ErrorWindow"" Тогда
		|				Тогда я вызываю исключение ""Не удалось скопировать существующий элемент " + ПредставлениеОбъекта + """" + "
		|			И я запоминаю имя формы в переменную 'ИмяФормы'" + Символы.ПС
		+ ТекстНажатияКнопки("ru", "Записываем новый элемент", ПредставлениеФормаЗаписать,
			"Не удалось записать новый элемент " + ПредставлениеОбъекта));
	Иначе
		Если Группа Тогда
			ШагКопирования = "And I copy the object group via the form command '" + Задание.Вид.ИмяТипаEn + "." + ОбъектМетаданных.Имя + "'";
		Иначе
			ШагКопирования = "And I copy the object element via the form command '" + Задание.Вид.ИмяТипаEn + "." + ОбъектМетаданных.Имя + "'";
		КонецЕсли;
		Текст.ДобавитьСтроку("
		|		* Create a new item by copying
		|			Then '$ЗаголовокФормы$' window is opened
		|			" + ШагКопирования + "
		|			If the warning is displayed then
		|				Then I raise ""Failed to copy an existing item " + ПредставлениеОбъекта  + """ exception" + "
		|			If current form name is ""ErrorWindow"" Then
		|				Then I raise ""Failed to copy an existing item " + ПредставлениеОбъекта  + """ exception" + "
		|			And I save form header as 'ЗаголовокФормы'  variable
		|
		|		* Save a new item
		|			Then '$ЗаголовокФормы$' window is opened
		|			If '" + ПредставлениеФормаЗаписать + "'attribute is present on the form Then
		|				And I click the button named '" + ПредставлениеФормаЗаписать + "'
		|				If the warning is displayed then
		|					Then I raise ""Failed to save new item " + ПредставлениеОбъекта + """ exception" + "
		|				If current form name is ""ErrorWindow"" Then
		|					Then I raise ""Failed to save new item " + ПредставлениеОбъекта + """ exception");
	КонецЕсли;
	
КонецПроцедуры

// Записать, перечитать, пометить на удаление и снять пометку; затем «Записать и закрыть»
// у справочников и планов или проведение у проводимых документов.
&НаСервереБезКонтекста
Процедура ДобавитьТекстЗаписи(Текст, Задание, ОбъектМетаданных, ПредставлениеОбъекта)
	
	Язык = Задание.ЯзыкШагов;
	ЭтоRU = Язык = "ru";
	Вариант = Задание.ВариантВстроенногоЯзыка;
	КнопкаПометкиУдаления = ПредставлениеВариантаВстроенногоЯзыка("ФормаУстановитьПометкуУдаления", Вариант);
	ОкноВопроса = ПредставлениеВариантаВстроенногоЯзыка("1С:Предприятие", Вариант);
	
	Блоки = Новый Массив;
	Блоки.Добавить(ТекстНажатияКнопки(Язык,
		?(ЭтоRU, "Записываем существующий элемент", "Save an existing item"),
		ПредставлениеВариантаВстроенногоЯзыка("ФормаЗаписать", Вариант),
		?(ЭтоRU, "Не удалось записать существующий элемент ", "Failed to save an existing item ") + ПредставлениеОбъекта));
	Блоки.Добавить(ТекстНажатияКнопки(Язык,
		?(ЭтоRU, "Пересчитаем существующий элемент", "Reread an existing item"),
		ПредставлениеВариантаВстроенногоЯзыка("ФормаПеречитать", Вариант),
		?(ЭтоRU, "Не удалось перечитать существующий элемент ", "Failed to Reread an existing item ") + ПредставлениеОбъекта));
	Блоки.Добавить(ТекстНажатияКнопкиСПодтверждением(Язык,
		?(ЭтоRU, "Помечаем на удаление существующий элемент", "Mark to delete an existing item"),
		КнопкаПометкиУдаления, ОкноВопроса,
		?(ЭтоRU, "Не удалось пометить на удаление элемент ", "Failed to Mark to delete an existing item ") + ПредставлениеОбъекта));
	Блоки.Добавить(ТекстНажатияКнопкиСПодтверждением(Язык,
		?(ЭтоRU, "Снимаем пометку на удаление с существующего элемента", "Unmark to delete an existing item"),
		КнопкаПометкиУдаления, ОкноВопроса,
		?(ЭтоRU, "Не удалось снять пометку на удаление с элемента ", "Failed to Unmark to delete an existing item ") + ПредставлениеОбъекта));
	Текст.ДобавитьСтроку(СоединитьБлоки(Блоки));
	
	Блоки = Новый Массив;
	Если Задание.Вид.ИмяТипа <> "Документ" Тогда
		Блоки.Добавить(ТекстНажатияКнопкиЗакрытияФормы(Язык,
			?(ЭтоRU, "Запишем и закроем существующий элемент", "Save and close an existing element"),
			ПредставлениеВариантаВстроенногоЯзыка("ФормаЗаписатьИЗакрыть", Вариант),
			?(ЭтоRU, "Не удалось записать и закрыть элемент ", "Failed to Save and close an existing element ") + ПредставлениеОбъекта));
	ИначеЕсли ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		Блоки.Добавить(ТекстНажатияКнопки(Язык,
			?(ЭтоRU, "Проведем документ", "Posting document"),
			ПредставлениеВариантаВстроенногоЯзыка("ФормаПровести", Вариант),
			?(ЭтоRU, "Не удалось провести элемент ", "Failed to Posting document ") + ПредставлениеОбъекта));
		Блоки.Добавить(ТекстНажатияКнопки(Язык,
			?(ЭтоRU, "Отменим проведение документа", "Cancel Posting the document"),
			ПредставлениеВариантаВстроенногоЯзыка("ФормаОтменаПроведения", Вариант),
			?(ЭтоRU, "Не удалось отменить проведение ", "Failed to Cancel Posting the document ") + ПредставлениеОбъекта));
		Блоки.Добавить(ТекстНажатияКнопкиЗакрытияФормы(Язык,
			?(ЭтоRU, "Проведем и закроем документ", "Posting and close the document"),
			ПредставлениеВариантаВстроенногоЯзыка("ФормаПровестиИЗакрыть", Вариант),
			?(ЭтоRU, "Не удалось провести и закрыть элемент ", "Failed to Posting and close the document ") + ПредставлениеОбъекта));
	КонецЕсли;
	
	Если Блоки.Количество() > 0 Тогда
		Текст.ДобавитьСтроку(СоединитьБлоки(Блоки));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьТекстВводаНаОсновании(Текст, Задание, ОбъектМетаданных, ПодчиненныеОбъекты, ПредставлениеОбъекта)
	
	Для Каждого ПодчиненныйОбъект Из ПодчиненныеОбъекты Цикл
		
		Если ПроверитьВМассивеИсключений(Задание.Исключения, ОбъектМетаданных.Имя, Задание.ТипТеста, ПодчиненныйОбъект.ВводитсяИмя) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКоманды = "Форма" + ПодчиненныйОбъект.ВводитсяВид + ПодчиненныйОбъект.ВводитсяИмя + "СоздатьНаОсновании";
		ИмяГруппы = ПодчиненныйОбъект.ВводитсяВид + " " + ПодчиненныйОбъект.ВводитсяИмя;
		
		Если Задание.ЯзыкШагов = "ru" Тогда
			Текст.ДобавитьСтроку("
			|		* Введем на основании " + ИмяГруппы + "
			|			Когда открылась форма с именем '$ИмяФормы$'
			|			Если элемент формы с именем '" + ИмяКоманды + "' присутствует на форме Тогда
			|				И я нажимаю на кнопку с именем '" + ИмяКоманды + "'
			|				Если появилось предупреждение Тогда
			|					Тогда я вызываю исключение ""Не удалось ввести " + ИмяГруппы + " на основании " + ПредставлениеОбъекта + """" + "
			|				Если имя текущей формы ""ErrorWindow"" Тогда
			|					Тогда я вызываю исключение ""Не удалось ввести " + ИмяГруппы + " на основании " + ПредставлениеОбъекта + """" + "
			|				Тогда открылось окно '* (создание)'
			|				И Я закрываю окно '* (создание)'");
		Иначе
			
			ИмяГруппы = Задание.ПредставлениеВида + " " + ПодчиненныйОбъект.ВводитсяИмя;
			ПредставлениеОкноСоздания = ПредставлениеВариантаВстроенногоЯзыка("создание", Задание.ВариантВстроенногоЯзыка);
			
			Текст.ДобавитьСтроку("
			|		* Generate " + ИмяГруппы + "
			|			Then '$ЗаголовокФормы$' window is opened
			|			If '" + ИмяКоманды + "' attribute is present on the form Then 
			|				And I click the button named '" + ИмяКоманды + "'
			|				If the warning is displayed then
			|					Then I raise ""Failed to Generate " + ИмяГруппы + " based on " + ПредставлениеОбъекта + """ exception" + " 
			|				If current form name is ""ErrorWindow"" Then
			|					Then I raise ""Failed to Generate " + ИмяГруппы + " based on " + ПредставлениеОбъекта + """ exception" + "
			|				Then '* (" + ПредставлениеОкноСоздания + ")' window is opened
			|				And I close '* (" + ПредставлениеОкноСоздания + ")'  window");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьТекстПечати(Текст, Задание, ОбъектМетаданных, КомандыПечати, ПредставлениеОбъекта)
	
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		
		Если ПроверитьВМассивеИсключений(Задание.Исключения, ОбъектМетаданных.Имя, Задание.ТипТеста, КомандаПечати.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКоманды1 = "ПодменюПечатьОбычное_" + КомандаПечати.Идентификатор;
		ИмяКоманды2 = "ПодменюПечатьОбычное__" + КомандаПечати.Идентификатор; // В новых версиях БСП 3.1.10 и выше будет "__", вместо "_"
		ИмяГруппы = """" + СтрЗаменить(КомандаПечати.Представление, """", """""") + """";
		// В тексте исключения название в «ёлочках»: кавычки "…" и '…' VA разбирает как параметры шага.
		ИмяФормыВСообщении = "«" + СтрЗаменить(СтрЗаменить(КомандаПечати.Представление, """", ""), "'", "") + "»";
		
		Если Задание.ЯзыкШагов = "ru" Тогда
			ТекстШагов = НСтр("ru = '
                                   |		* Вывод на печать формы ""%1""
                                   |			Когда открылась форма с именем ''$ИмяФормы$''
                                   |			И Я запоминаю в переменную ""ИмяКомандыПечатнойФормы"" значение """"
                                   |			Если элемент формы с именем ''%2'' присутствует на форме Тогда
                                   |				И Я запоминаю в переменную ""ИмяКомандыПечатнойФормы"" значение ""%2""
                                   |			ИначеЕсли элемент формы с именем ''%3'' присутствует на форме Тогда
                                   |				И Я запоминаю в переменную ""ИмяКомандыПечатнойФормы"" значение ""%3""		
                                   |
                                   |			Если ''ЗначениеЗаполнено($ИмяКомандыПечатнойФормы$)'' Тогда
                                   |				И я нажимаю на кнопку с именем ''$ИмяКомандыПечатнойФормы$''
                                   |				Если появилось предупреждение Тогда
                                   |					Тогда я вызываю исключение ""Не удалось вывести на печать форму %5 %4""
                                   |				Если имя текущей формы ""ErrorWindow"" Тогда
                                   |					Тогда я вызываю исключение ""Не удалось вывести на печать форму %5 %4""
                                   |				Тогда открылось окно ''*''
                                   |				И Пауза 2
                                   |				И Я закрываю окно ''*'''");
			
			ТекстШагов = _СтрШаблон(ТекстШагов, ИмяГруппы, ИмяКоманды1, ИмяКоманды2, ПредставлениеОбъекта, ИмяФормыВСообщении);
			Текст.ДобавитьСтроку(ТекстШагов);
		Иначе
			Текст.ДобавитьСтроку("
			|		* Print the form " + ИмяГруппы + "
			|			Then '$ЗаголовокФормы$'  window is opened
			|			And I save """" value to ""ИмяКомандыПечатнойФормы"" variable
			|			If '" + ИмяКоманды1 + "' attribute is present on the form Then
			|				And I save """ + ИмяКоманды1 + """ value to ""ИмяКомандыПечатнойФормы"" variable
			|			ElseIf '" + ИмяКоманды2 + "' attribute is present on the form Then
			|				And I save """ + ИмяКоманды2 + """ value to ""ИмяКомандыПечатнойФормы"" variable
			|
			|			If 'ValueIsFilled($ИмяКомандыПечатнойФормы$)' Then
			|				And I click the button named '$ИмяКомандыПечатнойФормы$'
			|				If the warning is displayed then
			|					Then I raise ""Failed to print form " + ИмяФормыВСообщении + " " + ПредставлениеОбъекта + """ exception" + " 
			|				If current form name is ""ErrorWindow"" Then
			|					Then I raise ""Failed to print form " + ИмяФормыВСообщении + " " + ПредставлениеОбъекта + """ exception" + "
			|				Then '*'  window is opened
			|				And I close '*' window");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьТекстПропускаБезДанных(Текст, Задание, Отбор, ПредставлениеОбъекта)
	
	// Подходящего элемента нет: сценарий ничего не проверил бы и был бы зелёным. Пропускаем его явно,
	// с причиной — отбором запроса подбора. Кавычек в тексте нет: VA разбирает их как параметры шага.
	ЭтоRU = Задание.ЯзыкШагов = "ru";
	ОписаниеОтбора = ПредставлениеОтбора(Отбор, Задание.ЯзыкШагов);
	
	Если ЭтоRU Тогда
		Текст.ДобавитьСтроку("
		|	Иначе
		|		И обратите внимание ""Нет данных для проверки " + ПредставлениеОбъекта + " (отбор: " + ОписаниеОтбора + ")""
		|		Тогда я останавливаю выполнение сценария ""Skipped""
		|");
	Иначе
		Текст.ДобавитьСтроку("
		|	Else
		|		And note ""No data to check " + ПредставлениеОбъекта + " (filter: " + ОписаниеОтбора + ")""
		|		Then I stop script execution ""Skipped""
		|");
	КонецЕсли;
	
КонецПроцедуры

// Команды печати объекта из подсистемы печати БСП.
&НаСервереБезКонтекста
Функция КомандыПечатиОбъекта(Вид, ОбъектМетаданных)
	
	КомандыПечати = Новый ТаблицаЗначений;
	Попытка
		Выполнить("
		|КомандыПечати = УправлениеПечатью.СоздатьКоллекциюКомандПечати();
		|" + Вид.ИмяВида + "." + ОбъектМетаданных.Имя + ".ДобавитьКомандыПечати(КомандыПечати);");
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		// Нет БСП или менеджер объекта не добавляет команды печати — печатать нечего.
	КонецПопытки;
	
	Возврат КомандыПечати;
	
КонецФункции

#Область БлокиШагов

// Блок шагов: нажать кнопку формы, если она есть; предупреждение или окно ошибки — исключение.
&НаСервереБезКонтекста
Функция ТекстНажатияКнопки(Язык, Заголовок, ИмяКнопки, ТекстОшибки)
	
	Если Язык = "ru" Тогда
		Возврат "
		|		* " + Заголовок + "
		|			Когда открылась форма с именем '$ИмяФормы$'
		|			Если элемент формы с именем '" + ИмяКнопки + "' присутствует на форме Тогда
		|				И я нажимаю на кнопку с именем '" + ИмяКнопки + "'
		|				Если появилось предупреждение Тогда
		|					Тогда я вызываю исключение """ + ТекстОшибки + """
		|				Если имя текущей формы ""ErrorWindow"" Тогда
		|					Тогда я вызываю исключение """ + ТекстОшибки + """";
	КонецЕсли;
	
	Возврат "
	|		* " + Заголовок + "
	|			Then '$ЗаголовокФормы$' window is opened
	|			If '" + ИмяКнопки + "' attribute is present on the form Then
	|				And I click the button named '" + ИмяКнопки + "'
	|				If the warning is displayed then
	|					Then I raise """ + ТекстОшибки + """ exception
	|				If current form name is ""ErrorWindow"" Then
	|					Then I raise """ + ТекстОшибки + """ exception";
	
КонецФункции

// То же, но после нажатия платформа задает вопрос — отвечаем первой кнопкой.
&НаСервереБезКонтекста
Функция ТекстНажатияКнопкиСПодтверждением(Язык, Заголовок, ИмяКнопки, ЗаголовокВопроса, ТекстОшибки)
	
	Если Язык = "ru" Тогда
		Возврат "
		|		* " + Заголовок + "
		|			Когда открылась форма с именем '$ИмяФормы$'
		|			Если элемент формы с именем '" + ИмяКнопки + "' присутствует на форме Тогда
		|				И я нажимаю на кнопку с именем '" + ИмяКнопки + "'
		|				Если открылось окно '" + ЗаголовокВопроса + "' Тогда
		|					И я нажимаю на кнопку с именем 'Button0'
		|				Если появилось предупреждение Тогда
		|					Тогда я вызываю исключение """ + ТекстОшибки + """
		|				Если имя текущей формы ""ErrorWindow"" Тогда
		|					Тогда я вызываю исключение """ + ТекстОшибки + """";
	КонецЕсли;
	
	Возврат "
	|		* " + Заголовок + "
	|			Then '$ЗаголовокФормы$' window is opened
	|			If '" + ИмяКнопки + "' attribute is present on the form Then
	|				And I click the button named '" + ИмяКнопки + "'
	|				If '" + ЗаголовокВопроса + "' window is opened then
	|					And I click the button named 'Button0'
	|				If the warning is displayed then
	|					Then I raise """ + ТекстОшибки + """ exception
	|				If current form name is ""ErrorWindow"" Then
	|					Then I raise """ + ТекстОшибки + """ exception";
	
КонецФункции

// Кнопка закрывает форму («Записать и закрыть», «Провести и закрыть»): имя текущей формы
// после нее не проверить, окно ошибки ловит «появилось предупреждение».
&НаСервереБезКонтекста
Функция ТекстНажатияКнопкиЗакрытияФормы(Язык, Заголовок, ИмяКнопки, ТекстОшибки)
	
	Если Язык = "ru" Тогда
		Возврат "
		|		* " + Заголовок + "
		|			Когда открылась форма с именем '$ИмяФормы$'
		|			Если элемент формы с именем '" + ИмяКнопки + "' присутствует на форме Тогда
		|				И я нажимаю на кнопку с именем '" + ИмяКнопки + "'
		|				Если появилось предупреждение Тогда
		|					Тогда я вызываю исключение """ + ТекстОшибки + """";
	КонецЕсли;
	
	Возврат "
	|		* " + Заголовок + "
	|			Then '$ЗаголовокФормы$' window is opened
	|			If '" + ИмяКнопки + "' attribute is present on the form Then
	|				And I click the button named '" + ИмяКнопки + "'
	|				If the warning is displayed then
	|					Then I raise """ + ТекстОшибки + """ exception";
	
КонецФункции

// Блоки шагов через пустую строку.
&НаСервереБезКонтекста
Функция СоединитьБлоки(Блоки)
	
	Результат = "";
	Для Каждого Блок Из Блоки Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", Символы.ПС) + Блок;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция ЭтоНетестируемыйОбъектПоИмени(ИмяОбъектаМетаданных, ВидОбъектаМетаданных)
	
	Результат = Ложь;
	Если Лев(ИмяОбъектаМетаданных, 7) = "Удалить" Тогда
		Результат = Истина;
	ИначеЕсли ВидОбъектаМетаданных = "Справочники"
		И (Прав(ИмяОбъектаМетаданных, 19) = "ПрисоединенныеФайлы") Тогда
		Результат = Истина;
	ИначеЕсли ВидОбъектаМетаданных = "Отчеты"
		И (Лев(ИмяОбъектаМетаданных, 29) = "РегламентированноеУведомление"
			Или Лев(ИмяОбъектаМетаданных, 23) = "РегламентированныйОтчет") Тогда
		Результат = Истина;
	ИначеЕсли ВидОбъектаМетаданных = "Обработки"
		И (Лев(ИмяОбъектаМетаданных, 6) = "Панель") Тогда
		Результат = Истина;
	ИначеЕсли ВидОбъектаМетаданных = "РегистрыСведений"
		И (Лев(ИмяОбъектаМетаданных, 17) = "СведенияРеглОтчет") Тогда
		Результат = Истина;
	Иначе
		// Без обработки.
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеВариантаВстроенногоЯзыка(ИмяЗначения, ВариантВстроенногоЯзыка)
	
	СоответствиеПредставление = Новый Соответствие;

	Если ВариантВстроенногоЯзыка = "English" Тогда
		СоответствиеПредставление.Вставить("ФормаЗаписать", "FormWrite");
		СоответствиеПредставление.Вставить("ФормаЗаписатьИЗакрыть", "FormWriteAndClose");
		СоответствиеПредставление.Вставить("ФормаПровести", "FormPost");
		СоответствиеПредставление.Вставить("ФормаПровестиИЗакрыть", "FormPostAndClose");
		СоответствиеПредставление.Вставить("ФормаОтменаПроведения", "FormUndoPosting");
		СоответствиеПредставление.Вставить("ФормаПеречитать", "FormReread");
		СоответствиеПредставление.Вставить("ФормаУстановитьПометкуУдаления", "FormSetDeletionMark");
		СоответствиеПредставление.Вставить("создание", "create");
		СоответствиеПредставление.Вставить("1С:Предприятие", "1C:Enterprise");
	Иначе
		СоответствиеПредставление.Вставить("ФормаЗаписать", "ФормаЗаписать");
		СоответствиеПредставление.Вставить("ФормаЗаписатьИЗакрыть", "ФормаЗаписатьИЗакрыть");
		СоответствиеПредставление.Вставить("ФормаПровести", "ФормаПровести");
		СоответствиеПредставление.Вставить("ФормаПровестиИЗакрыть", "ФормаПровестиИЗакрыть");
		СоответствиеПредставление.Вставить("ФормаОтменаПроведения", "ФормаОтменаПроведения");
		СоответствиеПредставление.Вставить("ФормаПеречитать", "ФормаПеречитать");
		СоответствиеПредставление.Вставить("ФормаУстановитьПометкуУдаления", "ФормаУстановитьПометкуУдаления");
		СоответствиеПредставление.Вставить("создание", "создание");
		СоответствиеПредставление.Вставить("1С:Предприятие", "1С:Предприятие");
	КонецЕсли;
	
	Возврат СоответствиеПредставление.Получить(ИмяЗначения);

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьВИсключенияхСтрока(МассивИсключений, СтрокаПоиска)
	
	Если Не ЗначениеЗаполнено(МассивИсключений) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	ЕстьВИсключениях = Не (МассивИсключений.Найти(СтрокаПоиска) = Неопределено
		И МассивИсключений.Найти(СтрокаПоиска + ".") = Неопределено);
	
	Возврат ЕстьВИсключениях;

КонецФункции

