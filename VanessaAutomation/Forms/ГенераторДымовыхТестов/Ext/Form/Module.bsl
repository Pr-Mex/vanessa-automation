#Область ГенерацияТекстовДымовыхТестов

#Область ПодборЭлемента

// Какой существующий элемент подбирается для проверки. Порядок полей — порядок условий в запросе.
//
// Возвращаемое значение:
//  Структура:
//   * ТолькоПроведенные - Булево
//   * НеПредопределенные - Булево
//   * НачальнаяДата - Дата, Неопределено - элемент не раньше этой даты
//   * ТолькоГруппы - Булево
//   * КромеГрупп - Булево
//   * ПоУбываниюДаты - Булево - подбирается самый поздний документ
//
&НаСервереБезКонтекста
Функция НовыйОтборЭлемента()
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТолькоПроведенные", Ложь);
	Отбор.Вставить("НеПредопределенные", Ложь);
	Отбор.Вставить("НачальнаяДата", Неопределено);
	Отбор.Вставить("ТолькоГруппы", Ложь);
	Отбор.Вставить("КромеГрупп", Ложь);
	Отбор.Вставить("ПоУбываниюДаты", Ложь);
	
	Возврат Отбор;
	
КонецФункции

// Отбор существующего элемента, который проверяют сценарии записи, копирования, ввода на основании и печати.
&НаСервереБезКонтекста
Функция ОтборПодбораЭлемента(Задание, ОбъектМетаданных)
	
	Отбор = НовыйОтборЭлемента();
	
	Если Задание.Вид.ИмяТипа = "Документ" Тогда
		Отбор.ТолькоПроведенные = ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
		Если ЗначениеЗаполнено(Задание.НачальнаяДатаДокументов) Тогда
			Отбор.НачальнаяДата = Задание.НачальнаяДатаДокументов;
		КонецЕсли;
		Отбор.ПоУбываниюДаты = Задание.СортироватьДокументыПоУбыванию;
	Иначе
		Отбор.НеПредопределенные = Задание.Вид.ЕстьПредопределенные;
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции

// Группы отдельно от элементов: у групп своя форма, нет печати и ввода на основании.
&НаСервереБезКонтекста
Функция ЕстьГруппы(Вид, ОбъектМетаданных)
	
	Если Вид.ИмяВида = "Справочники" Тогда
		Возврат ОбъектМетаданных.Иерархический
			И ОбъектМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	ИначеЕсли Вид.ИмяВида = "ПланыВидовХарактеристик" Тогда
		Возврат ОбъектМетаданных.Иерархический;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Условия отбора для текста запроса после «НЕ ПометкаУдаления» на языке шагов.
&НаСервереБезКонтекста
Функция ТекстУсловияОтбора(Отбор, Язык)
	
	ЭтоRU = Язык = "ru";
	Текст = "";
	
	Если Отбор.ТолькоПроведенные Тогда
		Текст = ?(ЭтоRU, "И ТекДанныеИсточник.Проведен", "And CurrentDataSource.Posted");
	ИначеЕсли Отбор.НеПредопределенные Тогда
		Текст = ?(ЭтоRU, "И НЕ ТекДанныеИсточник.Предопределенный", "And Not CurrentDataSource.Predefined");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.НачальнаяДата) Тогда
		Текст = Текст + ?(ЭтоRU,
			" И ТекДанныеИсточник.Дата >= &ДымовыеТестыНачальнаяДатаДляПодбораДокументов",
			" And CurrentDataSource.Date >= &ДымовыеТестыНачальнаяДатаДляПодбораДокументов");
	КонецЕсли;
	
	Если Отбор.ТолькоГруппы Тогда
		Текст = Текст + ?(ЭтоRU, " И ТекДанныеИсточник.ЭтоГруппа", " And CurrentDataSource.IsFolder");
	ИначеЕсли Отбор.КромеГрупп Тогда
		Текст = Текст + ?(ЭтоRU, " И НЕ ТекДанныеИсточник.ЭтоГруппа", " And Not CurrentDataSource.IsFolder");
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Сортировка для текста запроса. Русский вариант вставляется в многострочный запрос внутри фичи.
&НаСервереБезКонтекста
Функция ТекстСортировкиОтбора(Отбор, Язык)
	
	Если Не Отбор.ПоУбываниюДаты Тогда
		Возврат "";
	ИначеЕсли Язык = "ru" Тогда
		Возврат "
		|				|УПОРЯДОЧИТЬ ПО
		|				|	ТекДанныеИсточник.Дата УБЫВ";
	Иначе
		Возврат " ORDER BY CurrentDataSource.Date DESC";
	КонецЕсли;
	
КонецФункции

// Отбор словами — для причины пропуска сценария. Без кавычек: VA разбирает их как параметры шага.
&НаСервереБезКонтекста
Функция ПредставлениеОтбора(Отбор, Язык)
	
	ЭтоRU = Язык = "ru";
	
	Условия = Новый Массив;
	Условия.Добавить(?(ЭтоRU, "не помеченные на удаление", "not marked for deletion"));
	Если Отбор.НеПредопределенные Тогда
		Условия.Добавить(?(ЭтоRU, "не предопределённые", "not predefined"));
	КонецЕсли;
	Если Отбор.ТолькоПроведенные Тогда
		Условия.Добавить(?(ЭтоRU, "проведённые", "posted"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.НачальнаяДата) Тогда
		ДатаОтбора = Формат(Отбор.НачальнаяДата, "ДФ=dd.MM.yyyy");
		Условия.Добавить(?(ЭтоRU, "с датой не ранее " + ДатаОтбора, "date from " + ДатаОтбора));
	КонецЕсли;
	Если Отбор.КромеГрупп Тогда
		Условия.Добавить(?(ЭтоRU, "кроме групп", "except folders"));
	ИначеЕсли Отбор.ТолькоГруппы Тогда
		Условия.Добавить(?(ЭтоRU, "только группы", "folders only"));
	КонецЕсли;
	
	Представление = "";
	Для Каждого Условие Из Условия Цикл
		Представление = Представление + ?(ПустаяСтрока(Представление), "", ", ") + Условие;
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции

// Есть ли в базе элемент объекта под отбор.
//
// Параметры:
//  ИмяТипа - Строка - "Справочник"
//  ИмяОбъекта - Строка - "Номенклатура"
//  Отбор - см. НовыйОтборЭлемента
//
&НаСервереБезКонтекста
Функция ЕстьЭлементПодОтбор(ИмяТипа, ИмяОбъекта, Отбор)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТекДанныеИсточник.Ссылка КАК Ссылка
		|ИЗ
		|	" + ИмяТипа + "." + ИмяОбъекта + " КАК ТекДанныеИсточник
		|ГДЕ
		|	НЕ ТекДанныеИсточник.ПометкаУдаления
		|	" + ТекстУсловияОтбора(Отбор, "ru"));
	
	Если ЗначениеЗаполнено(Отбор.НачальнаяДата) Тогда
		Запрос.УстановитьПараметр("ДымовыеТестыНачальнаяДатаДляПодбораДокументов", Отбор.НачальнаяДата);
	КонецЕсли;
	
	Возврат Не Запрос.Выполнить().Пустой(); // BSLLS:CreateQueryInCycle-off
	
КонецФункции

#КонецОбласти


// Тексты фича-файлов вида метаданных по выбранным типам тестов — один серверный вызов на вид.
//
// Параметры:
//  Контекст - см. НовыйКонтекстГенерации
//  ИмяВида - Строка
//  ТипыТестов - Массив из Строка - имена типов тестов
//  НомерВида - Строка - первые цифры имени файла
//  Исключения - Массив из Строка
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяФайла - Строка
//   * Текст - ТекстовыйДокумент
//
&НаСервереБезКонтекста
Функция СформироватьФайлыВида(Знач Контекст, Знач ИмяВида, Знач ТипыТестов, Знач НомерВида, Знач Исключения)
	
	Файлы = Новый Массив;
	
	Для Каждого ИмяТипаТеста Из ТипыТестов Цикл
		
		Задание = НовоеЗадание(Контекст, ИмяВида, ИмяТипаТеста, НомерВида, Исключения);
		Если ИмяТипаТеста = "ВводНаОсновании" Тогда
			Задание.ВводНаОсновании = ТаблицаВводаНаОсновании(Задание.Вид);
		КонецЕсли;
		
		Текст = СформироватьТекстФайлаПоОбъектамМетаданных(Задание);
		Если Текст.КоличествоСтрок() > 0 Тогда
			Файлы.Добавить(Новый Структура("ИмяФайла, Текст", Задание.ИмяФайла, Текст));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Файлы;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьТекстФайлаПоОбъектамМетаданных(Задание)
	
	Текст = Новый ТекстовыйДокумент;
		
	Для Каждого ОбъектМетаданных Из Метаданные[Задание.Вид.ИмяВида] Цикл
		
		Имя = ОбъектМетаданных.Имя;
		
		// Фильтр по нетестируемым объектам
		Если ЭтоНетестируемыйОбъектПоИмени(Имя, Задание.Вид.ИмяВида) Тогда
			Продолжить;
		КонецЕсли;
		
		// Фильтр по объектам, изменнным относительно конфигурации поставщика
		Если НЕ ПустаяСтрока(Задание.ТекстСравнения) Тогда
			Если _СтрНайти(Задание.ТекстСравнения, Задание.Вид.ИмяТипа + "." + Имя) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СформироватьТекстПоОбъектуМетаданных(Текст, Задание, ОбъектМетаданных);
		
	КонецЦикла;
	
	// Добавим заголовок, если есть хоть один сценарий
	Если Текст.КоличествоСтрок() > 0 Тогда
		
		СформироватьТекстЗаголовкаФайла(Задание, Текст);
		
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СформироватьТекстЗаголовкаФайла(Задание, Текст)

	ТекстВставить = "";
	
	Если Задание.ЯзыкШагов = "ru" Тогда
		ТекстВставить = "
		|#language: ru
		|
		|@tree
		|@SmokeTest
		|
		|Функциональность: Дымовые тесты - " + Задание.ПредставлениеВида + " - " + Задание.ПредставлениеТипаТеста + "
		|# Конфигурация: " + Метаданные.Синоним + "
		|# Версия: " + Метаданные.Версия + "
		|
		|Контекст:
		|	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
		|	И Я закрыл все окна клиентского приложения";
	Иначе
		// english
		ТекстВставить =  "
		|#language: en
		|
		|@tree
		|@SmokeTest
		|
		|Feature: Smoke tests - " + Задание.ПредставлениеВида + " - " + Задание.ПредставлениеТипаТеста + "
		|# Configuration " + Метаданные.Синоним + "
		|# Version: " + Метаданные.Версия + "
		|
		|Background:
		|	Given I launch TestClient opening script or connect the existing one
		|	And I close all client application windows";
	КонецЕсли;
	
	Если Текст.КоличествоСтрок() > 0 Тогда
		Текст.ВставитьСтроку(1, ТекстВставить);
	Иначе
		Текст.ДобавитьСтроку(ТекстВставить);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СформироватьТекстПоОбъектуМетаданных(Текст, Задание, ОбъектМетаданных)

	// Открытие формы списка
	Если Задание.ТипТеста = "ФормаСписка" Тогда
		
		Если НЕ Задание.Вид.ИмяФормыСписка = "" И НЕ ОбъектМетаданных[Задание.Вид.ИмяФормыСписка] = Неопределено Тогда
			ДобавитьТекстОткрытияФормыСписка(Текст, Задание, ОбъектМетаданных);
		КонецЕсли;
		
	ИначеЕсли Задание.ТипТеста = "ФормаОбъекта" Тогда
		
		Если НЕ Задание.Вид.ИмяФормыОбъекта = "" И НЕ ОбъектМетаданных[Задание.Вид.ИмяФормыОбъекта] = Неопределено Тогда
			ДобавитьТекстОткрытияФормыНового(Текст, Задание, ОбъектМетаданных);
		КонецЕсли;
		
	Иначе
		
		ДобавитьТекстРасширенныеДействия(Текст, Задание, ОбъектМетаданных);
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТаблицаВводаНаОсновании(Вид)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Основание");
	Таблица.Колонки.Добавить("ВводитсяВид");
	Таблица.Колонки.Добавить("ВводитсяИмя");
	
	Для Каждого ОбъектМетаданных Из Метаданные[Вид.ИмяВида] Цикл
		
		Для Каждого Основание Из ОбъектМетаданных.ВводитсяНаОсновании Цикл
			
			НСтрока = Таблица.Добавить();
			НСтрока.Основание = Основание;
			НСтрока.ВводитсяВид = Вид.ИмяТипа;
			НСтрока.ВводитсяИмя = ОбъектМетаданных.Имя;
			
		КонецЦикла;
			
	КонецЦикла;
	
	Таблица.Индексы.Добавить("Основание");
	
	Возврат Таблица;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьВМассивеИсключений(МассивИсключений, Имя, ТипТеста, ДопУсловие = "")
	
	Если Не ЗначениеЗаполнено(МассивИсключений) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверяем целый объект
	СтрокаПоиска = Имя;
	Если ЕстьВИсключенияхСтрока(МассивИсключений, СтрокаПоиска) Тогда
		// Весь объект добавлен в исключение
		Возврат Истина;
	КонецЕсли;
	
	Если ТипТеста <> "ФормаСписка" Тогда
		// Все прочие действия проверяем на исключение формы объекта
		СтрокаПоиска = Имя + ".ФормаОбъекта";
		Если ЕстьВИсключенияхСтрока(МассивИсключений, СтрокаПоиска) Тогда
			// В исключение добавлена вся форма объекта
			Возврат Истина;
		КонецЕсли;
		
		СтрокаПоиска = Имя + ".ObjectForm";
		Если ЕстьВИсключенияхСтрока(МассивИсключений, СтрокаПоиска) Тогда
			// В исключение добавлена вся форма объекта
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипТеста) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверяем выполнение базового условия
	СтрокаПоиска = Имя + "." + ТипТеста;
	Если ЕстьВИсключенияхСтрока(МассивИсключений, СтрокаПоиска) Тогда
		// В исключение добавлен весь тип теста для объекта
		Возврат Истина;
	КонецЕсли;
	
	СтрокаПоиска = Имя + "." + ОписаниеТипаТеста(ТипТеста).ИмяEn;
	Если ЕстьВИсключенияхСтрока(МассивИсключений, СтрокаПоиска) Тогда
		// В исключение добавлен весь тип теста для объекта
		Возврат Истина;
	КонецЕсли;
	
	// Проверяем выполнение дополнительного условия
	Если НЕ ПустаяСтрока(ДопУсловие) Тогда
		СтрокаПоиска = Имя + "." + ТипТеста + "." + ДопУсловие;
		Если НЕ МассивИсключений.Найти(СтрокаПоиска) = Неопределено Тогда
			// В исключение добавлено конкретное дополение для типа теста для объекта
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
