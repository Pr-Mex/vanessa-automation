// Описание вида метаданных с пустыми необязательными полями.
//
// Параметры:
//  ИмяВида - Строка - имя коллекции в Метаданные: "Справочники"
//  ИмяВидаEn - Строка - английское имя коллекции для имён файлов: "Catalogs"
//  ИмяТипа - Строка - имя типа в полном имени объекта: "Справочник"
//  ИмяТипаEn - Строка - то же на английском: "Catalog"
//
// Возвращаемое значение:
//  Структура
//
&НаКлиентеНаСервереБезКонтекста
Функция НовыйВидМетаданных(ИмяВида, ИмяВидаEn, ИмяТипа, ИмяТипаEn)
	
	Вид = Новый Структура;
	Вид.Вставить("ИмяВида", ИмяВида);
	Вид.Вставить("ИмяВидаEn", ИмяВидаEn);
	Вид.Вставить("ИмяТипа", ИмяТипа);
	Вид.Вставить("ИмяТипаEn", ИмяТипаEn);
	Вид.Вставить("Представление", "");
	Вид.Вставить("ПредставлениеEn", "");
	Вид.Вставить("ВРодительномПадеже", "");
	Вид.Вставить("Картинка", Неопределено);
	Вид.Вставить("Приоритет", 0);
	Вид.Вставить("ИмяФормыОбъекта", "");
	Вид.Вставить("ИмяФормыСписка", "");
	Вид.Вставить("Ссылочный", Ложь);
	Вид.Вставить("ЕстьПредопределенные", Ложь);
	Вид.Вставить("ДопустимыеТипыТестов", Новый Массив);
	Вид.Вставить("ТипыТестовПоУмолчанию", Новый Массив);
	Вид.Вставить("ШагОткрытияСпискаEn", "");
	Вид.Вставить("ШагОткрытияФормыEn", "");
	
	Возврат Вид;
	
КонецФункции

