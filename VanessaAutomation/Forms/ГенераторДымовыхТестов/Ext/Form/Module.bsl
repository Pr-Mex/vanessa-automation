// Обёртка для эмуляции СтрШаблон (8.2: встроенный недоступен).
//
// Параметры:
//  Стр - Строка - шаблон с подстановками %1 - %9
//  Парам1 - Произвольный - значение для %1
//  Парам2 - Произвольный - значение для %2
//  Парам3 - Произвольный - значение для %3
//  Парам4 - Произвольный - значение для %4
//  Парам5 - Произвольный - значение для %5
//  Парам6 - Произвольный - значение для %6
//  Парам7 - Произвольный - значение для %7
//  Парам8 - Произвольный - значение для %8
//  Парам9 - Произвольный - значение для %9
//
// Возвращаемое значение:
//  Строка - шаблон с подставленными значениями
//
&НаКлиентеНаСервереБезКонтекста
Функция _СтрШаблон(Знач Стр, Парам1 = Неопределено, Парам2 = Неопределено, Парам3 = Неопределено, Парам4 = Неопределено, Парам5 = Неопределено, Парам6 = Неопределено, Парам7 = Неопределено, Парам8 = Неопределено, Парам9 = Неопределено)
	Если Парам1 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%1", Парам1);
	КонецЕсли;
	Если Парам2 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%2", Парам2);
	КонецЕсли;
	Если Парам3 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%3", Парам3);
	КонецЕсли;
	Если Парам4 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%4", Парам4);
	КонецЕсли;
	Если Парам5 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%5", Парам5);
	КонецЕсли;
	Если Парам6 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%6", Парам6);
	КонецЕсли;
	Если Парам7 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%7", Парам7);
	КонецЕсли;
	Если Парам8 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%8", Парам8);
	КонецЕсли;
	Если Парам9 <> Неопределено Тогда
		Стр = СтрЗаменить(Стр, "%9", Парам9);
	КонецЕсли;
	Возврат Стр;
КонецФункции

// Обёртка для эмуляции СтрНайти (8.2: встроенный недоступен).
//
// Параметры:
//  Стр - Строка - строка, в которой ищем
//  Подстрока - Строка - искомая подстрока
//
// Возвращаемое значение:
//  Число - позиция первого вхождения, 0 - не найдено
//
&НаКлиентеНаСервереБезКонтекста
Функция _СтрНайти(Стр, Подстрока)
	Возврат Найти(Стр, Подстрока); // BSLLS:DeprecatedFind-off
КонецФункции

// Обёртка для эмуляции СтрРазделить (8.2: встроенный недоступен).
//
// Параметры:
//  Строка - Строка - разделяемая строка
//  Разделитель - Строка - разделитель
//  ПропускатьПустыеСтроки - Булево, Неопределено - не включать пустые части;
//                           Неопределено - Истина для разделителя-пробела, иначе Ложь
//
// Возвращаемое значение:
//  Массив из Строка - части строки
//
&НаКлиентеНаСервереБезКонтекста
Функция _СтрРазделить(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено)
	Результат = Новый Массив;
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = (Разделитель = " ");
		Если ПустаяСтрока(Строка) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Позиция = _СтрНайти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = _СтрНайти(Строка, Разделитель);
	КонецЦикла;
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

