// ГлубокоеКопирование
&НаКлиенте
Функция ГлубокоеКопирование(Значение, ЗаменаПеременных = Ложь, ИсключитьЗамену = "") Экспорт
	// Реквизит "ЗаменаПеременных" добавлен по причине "Исчезновения Контекста" в обработке "РаботаСВидео" при формировании имени файла вставляемой картинки
 	Если Значение = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ТипЗначения = ТипЗнч(Значение);
    
    // Обрабатываем массивы
    Если ТипЗначения = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Результат.Добавить(ГлубокоеКопирование(Элемент, ЗаменаПеременных));
        КонецЦикла;
    
    // Обрабатываем соответствия
    ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
        Результат = Новый Соответствие;
        Для Каждого КлючИЗначение Из Значение Цикл
            Результат.Вставить(
                ГлубокоеКопирование(КлючИЗначение.Ключ, ЗаменаПеременных),
                ГлубокоеКопирование(КлючИЗначение.Значение, ЗаменаПеременных)
            );
        КонецЦикла;
    
    // Обрабатываем структуры
    ИначеЕсли ТипЗначения = Тип("Структура") Тогда
        Результат = Новый Структура;
        Для Каждого КлючИЗначение Из Значение Цикл
            Результат.Вставить(
                КлючИЗначение.Ключ,
                ГлубокоеКопирование(КлючИЗначение.Значение, ЗаменаПеременных)
            );
        КонецЦикла;
    
    // Обрабатываем списки значений
    ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
        Результат = Новый СписокЗначений;
        Для Каждого Элемент Из Значение Цикл
            НовыйЭлемент = Результат.Добавить();
            НовыйЭлемент.Значение = ГлубокоеКопирование(Элемент.Значение, ЗаменаПеременных);
            НовыйЭлемент.Представление = ГлубокоеКопирование(Элемент.Представление, ЗаменаПеременных);
        КонецЦикла;
    
    // Обрабатываем деревья значений (упрощенная версия) (Ошибка вылетает - разобрать нужно ли?)
	//ИначеЕсли ТипЗначения = Тип("ДеревоЗначений") Тогда 
	//    Попытка
	//        Результат = Новый ДеревоЗначений;
	//    Исключение
	//        // Если тип недоступен, возвращаем оригинал (или можно сгенерировать ошибку)
	//        Возврат Значение;
	//    КонецПопытки;

	//    Для Каждого Колонка Из Значение.Колонки Цикл
	//        Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	//    КонецЦикла;
	//    
	//    Для Каждого СтрокаИсточник Из Значение.Строки Цикл
	//        ЗаполнитьСтрокуДерева(СтрокаИсточник, Результат.Строки.Добавить(), ЗаменаПеременных);
	//    КонецЦикла;
	//
    // Обрабатываем строки с заменой переменных через ОбработкаДопТекста()
    ИначеЕсли ТипЗначения = Тип("Строка") И ЗаменаПеременных Тогда
        Возврат Ванесса.ОбработкаДопТекста(Значение);
    
    // Все остальные типы (включая строки без замены переменных)
    Иначе
        Возврат Значение;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

// КаталогИнструментовИзПутиКФреймворку
&НаКлиенте
Функция КаталогИнструментовИзПутиКФреймворку(ИмяФайла = Неопределено) Экспорт
	Если ИмяФайла = Неопределено Тогда
		ПутьКОбработке = Ванесса.ПолучитьПутьКОбработкеКлиент();
	Иначе
		ПутьКОбработке = ИмяФайла;
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(ПутьКОбработке) Тогда
		Путь = Ванесса.КаталогИзИмениФайлаКлиент(ПутьКОбработке);
		Если Прав(Путь, 1) = "/" Тогда
			Стр = Лев(Стр, СтрДлина(Стр) - 1);
		ИначеЕсли Прав(Путь, 1) = "\" Тогда
			Стр = Лев(Стр, СтрДлина(Стр) - 1);
		КонецЕсли;	 
		
		Возврат Путь;
	КонецЕсли;	
	
	Возврат ""; 
