// ДобавитьПараметрКWeb
&НаКлиенте
Процедура ДобавитьПараметрКWeb(Стр, ИмяПараметра, Значение = Неопределено) Экспорт
	Стр = Стр + ?(Найти(Стр, "?") = 0, "?", "&") + ИмяПараметра;
	Если Значение <> Неопределено Тогда
		Стр = Стр + "=" + Ванесса.ПреобразоватьПараметрДляWeb(Значение);
	КонецЕсли;
КонецПроцедуры

// ПолучитьЗначениеПоРанееСобраннойИнформации
&НаКлиенте
Функция ПолучитьЗначениеПоРанееСобраннойИнформации(ДополнительныеПараметры, ИмяПараметра, ЗначениеПараметра) Экспорт
	МассивДействий = ДополнительныеПараметры.МассивДействий;
	Для каждого Элем Из МассивДействий Цикл
		Если Элем.ИмяПараметра = ИмяПараметра Тогда
			Возврат Элем[ЗначениеПараметра];
		КонецЕсли;	 
	КонецЦикла;
КонецФункции	

// ДобавитьДействиеВМассивАсинхронныхСобытий
&НаКлиенте
Процедура ДобавитьДействиеВМассивАсинхронныхСобытий(Массив, Путь, ИмяПараметра, ТипПараметра) Экспорт
	
	СтруктураФайла = Новый Структура;
	СтруктураФайла.Вставить("ИмяФайла", Путь);
	СтруктураФайла.Вставить("ИмяПараметра", ИмяПараметра);
	СтруктураФайла.Вставить("ТипПараметра", ТипПараметра);
	
	Массив.Добавить(СтруктураФайла);
	
КонецПроцедуры

// ТекущийШагЭтоШагКонтекста
&НаКлиенте
Функция ТекущийШагЭтоШагКонтекста() Экспорт
	СостояниеVA = Ванесса.ПолучитьСостояниеVanessaAutomation();
	
	Если СостояниеVA.ТекущийШаг.Свойство("ЭтоШагКонтекста") И СостояниеVA.ТекущийШаг.ЭтоШагКонтекста Тогда
		Возврат Истина;
	КонецЕсли;	 
	
	Возврат Ложь;
КонецФункции	 

