// Выполняет команду системы, при этом на экране не будет показано окно cmd
// Использует WshShell.
//
// Параметры:
//  СтрокаКоманды		 - Строка - выполняемая команда
//  ЖдатьОкончания		 - Число  - флаг ожидания окончания выполнения команды:
//
// Возвращаемое значение:
//   - Результат выполнения скрипта. 0 - если не было ошибок.
//
&НаКлиенте
Функция ВыполнитьКомандуОСБезПоказаЧерногоОкна(Знач ТекстКоманды, ЖдатьОкончания = -1) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
	//ТекстКоманды = СтрЗаменить(ТекстКоманды, "%", "%%");
	// Строку выше пришлось закомментировать, т.к. с ней не корректно работает команда под windows: echo %appdata%
	// Пользователю нужно самому следить за количеством спецсимволов в команде системы
	
	Если Ванесса.Объект.DebugLog Тогда
		ЗаписатьЛогВТекстИнформация("ВыполнитьКомандуОСБезПоказаЧерногоОкна", ТекстКоманды);
	КонецЕсли;	
	
	Если ЭтоLinuxКлиент() Тогда
		
		Если Найти(СокрЛП(ТекстКоманды), "start """"") > 0 Тогда
			ТекстКоманды = СтрЗаменить(СокрЛП(ТекстКоманды), "start """" ", "");
			Если Прав(СокрЛП(ТекстКоманды), 1) <> "&" Тогда
				ТекстКоманды = ТекстКоманды + " &";
			КонецЕсли;	
		КонецЕсли;	
		
		КомандаСистемы(ТекстКоманды);
		Возврат 0;
		
	КонецЕсли;
		
	// если ЖдатьОкончания = -1, тогда будет ожидание окончания работы приложения
	
	ИмяВременногоФайлаКоманды = ПолучитьИмяВременногоФайла("bat");
	Если Ванесса <> Неопределено И ЗначениеЗаполнено(Ванесса.Объект.КаталогВременныхФайлов) Тогда
		Файл = Новый Файл(ИмяВременногоФайлаКоманды);
		ИмяВременногоФайлаКоманды = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогВременныхФайлов) + Файл.Имя;
	КонецЕсли;	
	
	// эти две строки нужны для записи файла без BOM - начало
	ЗТ = Новый ЗаписьТекста(ИмяВременногоФайлаКоманды, КодировкаТекста.ANSI, , Ложь); 
	ЗТ.Закрыть();
	// эти две строки нужны для записи файла без BOM - окончание
	
	ЗТ = Новый ЗаписьТекста(ИмяВременногоФайлаКоманды, КодировкаТекста.UTF8, , Истина); 
	Если ЭтоWindowsXP = Неопределено Тогда
		СистемнаяИнформация = Новый СистемнаяИнформация;
		ЭтоWindowsXP = ЭтоWindowsXP(СистемнаяИнформация);
	КонецЕсли;	 
	Если НЕ ЭтоWindowsXP Тогда
		ЗТ.ЗаписатьСтроку("chcp 65001"); 
	КонецЕсли;	 
	ЗТ.ЗаписатьСтроку(ТекстКоманды); 
	ЗТ.Закрыть();
	
	Если WshShell = Неопределено Тогда
		WshShell = ПолучитьWshShell();
		// Далее переменная WshShell будет закеширована, чтобы не создавать ComObject каждый раз
	КонецЕсли;	 
	Рез = WshShell.Run("""" + ИмяВременногоФайлаКоманды + """", 0, ЖдатьОкончания);
	
	Если Ванесса <> Неопределено Тогда
		// При запуске автотестов у этой переменной может быть заменено значение в основной форме
		ЗапрещеныСинхронныеВызовы = Ванесса.ЗапрещеныСинхронныеВызовы;
	КонецЕсли;
	
	Если ЖдатьОкончания = -1 И НЕ ЗапрещеныСинхронныеВызовы Тогда
		// иначе удалять нельзя
		Попытка
			УдалитьФайлыКомандаСистемы(ИмяВременногоФайлаКоманды);
		Исключение
			ЗаписатьЛогВЖРОшибка("VanessaAutomation.УдалениеВременногоФайла", ПодставитьПараметрыВСтроку(
				Локализовать("Не получилось удалить файл %1"),
				ИмяВременногоФайлаКоманды
			));
		КонецПопытки;
	КонецЕсли;	 
	
	Возврат Рез;
	
	#КонецЕсли
КонецФункции	

// Преобразует иерархическую структуру параметров запуска в плоскую
&НаКлиенте
Процедура УстановитьПлоскуюСтрутуруПараметровЗапуска(СтруктураОбщихНастроек) Экспорт
	ПлоскаяСтрутураПараметровЗапуска = Новый Структура;
	
	Для Каждого КлючЗначение Из СтруктураОбщихНастроек Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			Для Каждого Элем Из КлючЗначение.Значение Цикл
				Если ТипЗнч(Элем.Значение) = Тип("Структура") Тогда
					ВызватьИсключение "" + Элем.Ключ + " имеет тип структура.";
				КонецЕсли;	
				ПлоскаяСтрутураПараметровЗапуска.Вставить(Элем.Ключ, Элем.Значение);
			КонецЦикла;	
		Иначе
			ПлоскаяСтрутураПараметровЗапуска.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

// Удалить. Настройки
//
&НаКлиенте
Функция СтруктураПараметровЗапуска() Экспорт
	
	Если ТипЗнч(ПлоскаяСтрутураПараметровЗапуска) <> Тип("Структура") Тогда
		СтруктураОбщихНастроек = СтруктураОбщихНастроекСервер();
		УстановитьПлоскуюСтрутуруПараметровЗапуска(СтруктураОбщихНастроек);
	КонецЕсли;	
	
	Если ТипЗнч(ПлоскаяСтрутураПараметровЗапуска) <> Тип("Структура") Тогда
		ВызватьИсключение "Не определена плоская структура запуска.";
	КонецЕсли;	
	
	Возврат СкопироватьСтруктуру(ПлоскаяСтрутураПараметровЗапуска);
	
КонецФункции

&НаКлиенте
Функция КешПараметровЗапуска() Экспорт
	
	Структура = Новый Структура;
	Структура.Вставить("КешПрочитатьПеременныеСреды", КешПрочитатьПеременныеСреды);
	Структура.Вставить("КешПолучитьСтруктуруПараметров", КешПолучитьСтруктуруПараметров);
	Структура.Вставить("КешVAParams", КешVAParams);
	Возврат Структура;
	
КонецФункции	

&НаКлиенте
Функция УстановитьКеш(КешПараметровЗапуска) Экспорт
	
	КешПрочитатьПеременныеСреды = КешПараметровЗапуска.КешПрочитатьПеременныеСреды;
	КешПолучитьСтруктуруПараметров = КешПараметровЗапуска.КешПолучитьСтруктуруПараметров;
	КешVAParams = КешПараметровЗапуска.КешVAParams;
	
КонецФункции

&НаКлиенте
Функция КаталогVanessaEditor(ВерсияРедактора) Экспорт
	
	#Если НЕ ВебКлиент Тогда
	ПеременныеСреды = ПеременныеСреды();
	
	Если ЭтоLinuxКлиент() Тогда
		ЛокальнаяПапка = "/home/"+ПеременныеСреды["USER"]+"/";
	Иначе
		ЛокальнаяПапка = ПеременныеСреды["LOCALAPPDATA"];
	КонецЕсли;

	
	Результат = ПодставитьПараметрыВСтроку("%1%3VAEditorCacheFiles%3%2", ЛокальнаяПапка, ВерсияРедактора, ПолучитьРазделительПути());
	Возврат Результат;
	
	#КонецЕсли
	
КонецФункции

// Возвращает каталог служебных картинок
&НаКлиенте
Функция КаталогСлужебныхКартинок() Экспорт
	
	#Если НЕ ВебКлиент Тогда
	
	Если ЗначениеЗаполнено(КаталогСлужебныхКартинок) Тогда
		Возврат КаталогСлужебныхКартинок;
	КонецЕсли;	
	
	ДвоичныеДанные = ДвоичныеДанныеСлужебныхКартинокСервер();
	КаталогСлужебныхКартинок = ПолучитьИмяВременногоФайла();
	Ванесса.СоздатьКаталогКомандаСистемы(КаталогСлужебныхКартинок);
	ЧтениеZipФайла = Новый ЧтениеZipФайла(ДвоичныеДанные.ОткрытьПотокДляЧтения());
	ЧтениеZipФайла.ИзвлечьВсе(КаталогСлужебныхКартинок, Вычислить("РежимВосстановленияПутейФайловZIP.Восстанавливать"));
	ЧтениеZipФайла.Закрыть();
	
	Возврат КаталогСлужебныхКартинок;
	
	#КонецЕсли
	
КонецФункции	

// Возвращет коллекцию исправленных опечаток синонимов параметров
&НаКлиенте
Функция ЗаменыСинонимовПараметров() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("ЧтоЗаменяем,НаЧтоЗаменяем", "useaddine", "useaddin"));
	Результат.Добавить(Новый Структура("ЧтоЗаменяем,НаЧтоЗаменяем", "buildname", "NameCurrentBuild"));
	Результат.Добавить(Новый Структура("ЧтоЗаменяем,НаЧтоЗаменяем", "ПоказыватьСтрокиПодсценариевVanessaEdittor", "ПоказыватьСтрокиПодсценариевVanessaEditor"));
	Результат.Добавить(Новый Структура("ЧтоЗаменяем,НаЧтоЗаменяем", "ВыполнятьШагиАссинхронно", "ВыполнятьШагиАсинхронно"));
	
	Возврат Результат;
	
КонецФункции	

// Исправляет найденные опечатки в именах параметров, чтобы сохранить совместимость поведения
&НаКлиенте
Процедура ОбработкаИсправленныхОпечатокПараметровЗапуска(Данные) Экспорт
	
	Замены = ЗаменыСинонимовПараметров();
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Для Каждого ТекЗамена Из Замены Цикл
			Попытка
				Если Данные.Свойство(ТекЗамена.ЧтоЗаменяем) И НЕ Данные.Свойство(ТекЗамена.НаЧтоЗаменяем) Тогда
					Данные.Вставить(ТекЗамена.НаЧтоЗаменяем, Данные[ТекЗамена.ЧтоЗаменяем]);
				КонецЕсли;	
			Исключение
				ЗаписатьЛогВЖРОшибка("ОбработкаИсправленныхОпечатокПараметровЗапуска", ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;	
	КонецЕсли;	
	
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого ТекЗамена Из Замены Цикл
			Попытка
				Если Данные[ТекЗамена.ЧтоЗаменяем] <> Неопределено И Данные[ТекЗамена.НаЧтоЗаменяем] = Неопределено Тогда
					Данные.Вставить(ТекЗамена.НаЧтоЗаменяем, Данные[ТекЗамена.ЧтоЗаменяем]);
				КонецЕсли;	
			Исключение
				ЗаписатьЛогВЖРОшибка("ОбработкаИсправленныхОпечатокПараметровЗапуска", ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

