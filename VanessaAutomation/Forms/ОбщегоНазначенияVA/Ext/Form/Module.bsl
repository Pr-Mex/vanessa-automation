// Серверный безконтекстный: сортировка массива координат по X (внутренний, возвращает массив; ByRef->Функция, урок 36).
&НаСервереБезКонтекста
Функция СортироватьМассивКоординат(Знач Массив)
	Тзн = Новый ТаблицаЗначений;
	Тзн.Колонки.Добавить("x");
	Тзн.Колонки.Добавить("y");

	Для Каждого Элем Из Массив Цикл
		СтрТзн = Тзн.Добавить();
		СтрТзн.x = Элем.x;
		СтрТзн.y = Элем.y;
	КонецЦикла;

	Тзн.Сортировать("x");

	Результат = Новый Массив;

	Для Каждого СтрТзн Из Тзн Цикл
		Результат.Добавить(Новый Структура("x,y", СтрТзн.x, СтрТзн.y));
	КонецЦикла;

	Возврат Результат;
КонецФункции

