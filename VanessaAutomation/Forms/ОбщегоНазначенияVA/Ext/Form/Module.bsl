// ОбновитьКонтекст
&НаКлиенте
Процедура ОбновитьКонтекст(ТекущийКонтекст, ЗагруженныйКонтекст) Экспорт
    
    ТипТекущего = ТипЗнч(ТекущийКонтекст);
    ТипЗагруженного = ТипЗнч(ЗагруженныйКонтекст);

    Если НЕ ((ТипТекущего = Тип("Структура") ИЛИ ТипТекущего = Тип("Соответствие")) 
        И (ТипЗагруженного = Тип("Структура") ИЛИ ТипЗагруженного = Тип("Соответствие"))) Тогда
        Возврат;
    КонецЕсли;

    Для каждого Элемент Из ЗагруженныйКонтекст Цикл
        Ключ = Элемент.Ключ;
        ЗагруженноеЗначение = Элемент.Значение;
        
        Если ТипТекущего = Тип("Структура") Тогда
            Если ТекущийКонтекст.Свойство(Ключ) Тогда
                ТекущееЗначение = ТекущийКонтекст[Ключ];
                Если (ТипЗнч(ТекущееЗначение) = Тип("Структура") ИЛИ ТипЗнч(ТекущееЗначение) = Тип("Соответствие")) И 
                     (ТипЗнч(ЗагруженноеЗначение) = Тип("Структура") ИЛИ ТипЗнч(ЗагруженноеЗначение) = Тип("Соответствие")) Тогда
                     ОбновитьКонтекст(ТекущееЗначение, ЗагруженноеЗначение);
                Иначе
                    ТекущийКонтекст[Ключ] = ЗагруженноеЗначение;
                КонецЕсли;
            Иначе
                ТекущийКонтекст.Вставить(Ключ, ЗагруженноеЗначение);
            КонецЕсли;

        ИначеЕсли ТипТекущего = Тип("Соответствие") Тогда
            ТекущееЗначение = ТекущийКонтекст.Получить(Ключ);
            Если ТекущееЗначение <> Неопределено Тогда
                Если (ТипЗнч(ТекущееЗначение) = Тип("Структура") ИЛИ ТипЗнч(ТекущееЗначение) = Тип("Соответствие")) И 
                     (ТипЗнч(ЗагруженноеЗначение) = Тип("Структура") ИЛИ ТипЗнч(ЗагруженноеЗначение) = Тип("Соответствие")) Тогда
                     ОбновитьКонтекст(ТекущееЗначение, ЗагруженноеЗначение);
                Иначе
                    ТекущийКонтекст.Вставить(Ключ, ЗагруженноеЗначение);
                КонецЕсли;
            Иначе
                ТекущийКонтекст.Вставить(Ключ, ЗагруженноеЗначение);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

// ЗаписатьВРеестр
&НаКлиенте
Функция ЗаписатьВРеестр(ДанныеРеестра, ИмяФайла) Экспорт
	
	Если _СтрНайти(ДанныеРеестра, "<component") = 0 Тогда // Файл пустой
		ДанныеРеестра = _СтрШаблон("<?xml version=""1.0"" encoding=""UTF-8""?>
						  |<registry xmlns=""http://v8.1c.ru/8.2/addin/registry"">
						  |	<component path=""%1"" type=""native""/>
						  |</registry>", ИмяФайла);
	ИначеЕсли _СтрНайти(ДанныеРеестра, _СтрШаблон("path=""%1""", ИмяФайла)) <> 0 Тогда // Компонента уже зарегистрирована
		Возврат Ложь;
	Иначе // Добавляем компоненту
		Запись = _СтрШаблон("	<component path=""%1"" type=""native""/>", ИмяФайла);
		ДанныеРеестра = СтрЗаменить(ДанныеРеестра, "</registry>", Запись + Символы.ПС + "</registry>");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

