// НайтиФайлСвязанныйСТестами
&НаКлиенте
Функция НайтиФайлСвязанныйСТестами(ИмяФайла) Экспорт
	Если Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
		Возврат ИмяФайла;
	КонецЕсли;	 
	
	// Поиск рядом с фичей
	СостояниеVanessaAutomation = Ванесса.ПолучитьСостояниеVanessaAutomation();
	СписокКаталогов = Новый СписокЗначений;
	СписокФайлов    = Новый СписокЗначений;
	Ванесса.НайтиФайлыКомандаСистемы(СостояниеVanessaAutomation.ТекущаяФича.Каталог, СписокКаталогов, СписокФайлов, Истина, ИмяФайла);
	
	Если СписокФайлов.Количество() > 0 Тогда
		Возврат СписокФайлов[0].Значение.ПолноеИмя;
	КонецЕсли;	 
	
	// Поиск в каталоге проекта
	СписокКаталогов = Новый СписокЗначений;
	СписокФайлов    = Новый СписокЗначений;
	Ванесса.НайтиФайлыКомандаСистемы(Ванесса.Объект.КаталогПроекта, СписокКаталогов, СписокФайлов, Истина, ИмяФайла);
	
	Если СписокФайлов.Количество() > 0 Тогда
		Возврат СписокФайлов[0].Значение.ПолноеИмя;
	КонецЕсли;	 
	
	Возврат Неопределено;
	
КонецФункции	

