// УбратьПарольПользователяИзСтроки
&НаКлиенте
Функция УбратьПарольПользователяИзСтроки(Знач Стр) Экспорт
	
	НайденоНачалоПароля = Ложь;
	НомерСимволаНачалоПароля = 0;
	НомерСимволаКонецПароля = 0;
	Для Сч = 1 По СтрДлина(Стр) - 1 Цикл
		ТекСимвол = Сред(Стр, Сч, 1);
		СледующийСимвол = Сред(Стр, Сч + 1, 1);
		Если (ТекСимвол = "/" И СледующийСимвол = "P") ИЛИ (ТекСимвол = "/" И СледующийСимвол = "p") Тогда
			НайденоНачалоПароля = Истина;
			НомерСимволаНачалоПароля = Сч + 2; 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ НайденоНачалоПароля Тогда
		Возврат Стр;
	КонецЕсли;
	
	Если НомерСимволаНачалоПароля > СтрДлина(Стр) Тогда
		Возврат Стр;
	КонецЕсли;
	
	ПервыйСимволПароля = Сред(Стр, НомерСимволаНачалоПароля, 1);
	ПромСтр = Сред(Стр, НомерСимволаНачалоПароля + 1);
	Если ПервыйСимволПароля = """" Тогда
		Поз = Найти(ПромСтр, """");
		Если Поз > 0 Тогда
			НомерСимволаКонецПароля = Поз + НомерСимволаНачалоПароля;
		Иначе	
			НомерСимволаКонецПароля = СтрДлина(ПромСтр) + НомерСимволаНачалоПароля;
		КонецЕсли;
	Иначе	
		Поз = Найти(ПромСтр, " ");
		Если Поз > 0 Тогда
			НомерСимволаКонецПароля = Поз + НомерСимволаНачалоПароля - 1;
		Иначе	
			НомерСимволаКонецПароля = СтрДлина(ПромСтр) + НомерСимволаНачалоПароля;
		КонецЕсли;
	КонецЕсли;
	
	Если ПервыйСимволПароля = """" Тогда
		ЛеваяЧасть = Лев(Стр, НомерСимволаНачалоПароля);
		ПраваяЧасть = Сред(Стр, НомерСимволаКонецПароля);
		Возврат ЛеваяЧасть + "*****" + ПраваяЧасть;
	Иначе
		ЛеваяЧасть = Лев(Стр, НомерСимволаНачалоПароля - 1);
		ПраваяЧасть = Сред(Стр, НомерСимволаКонецПароля + 1);
		Возврат ЛеваяЧасть + "*****" + ПраваяЧасть;
	КонецЕсли;
	
КонецФункции	

// УбратьТехническиеДанныеИзСтроки
&НаКлиенте
Функция УбратьТехническиеДанныеИзСтроки(Знач Стр) Экспорт
	
	СтрокаПоиска = Локализовать("Технические данные");
	Поз = Найти(Стр, СтрокаПоиска);
	Если Поз > 0 Тогда
		Стр = СокрП(Лев(Стр, Поз - 1));
	КонецЕсли;
	
	Пока Найти(Стр, "}:") > 0 Цикл
		Поз = Найти(Стр, "}:");
		Сч = Поз;
		Нашли = Ложь;
		Пока Истина Цикл
			Сч = Сч - 1;
			Если Сч = 0 Тогда
				Прервать;
			КонецЕсли;	
			Символ = Сред(Стр, Сч, 1);
			Если Символ = "{" Тогда
				Нашли = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Если Нашли Тогда
			Стр = Лев(Стр, Сч - 1) + СокрЛ(Сред(Стр, Поз + 2));
		КонецЕсли;	
		
	КонецЦикла;	 
	
	Возврат Стр;
	
КонецФункции	

// ДатаИзСтрокиКомандыСистемы
&НаКлиенте
Функция ДатаИзСтрокиКомандыСистемы(Знач Стр) Экспорт
	Поз = Найти(Стр, "/");
	Если Поз > 0 Тогда
		Месяц = Число(Лев(Стр, Поз - 1));
		Стр   = Сред(Стр, Поз + 1);
		
		Поз   = Найти(Стр, "/");
		День  = Число(Лев(Стр, Поз - 1));
		Стр   = Сред(Стр, Поз + 1);
		
		Поз   = Найти(Стр, " ");
		Если Поз = 0 Тогда
			Поз   = Найти(Стр, ":");
		КонецЕсли;	 
		Год   = Число(Лев(Стр, Поз - 1));
		Стр   = СокрЛП(Сред(Стр, Поз + 1));
		
		Секунды = 0;
		
		Стр = СтрЗаменить(Стр,"AM","");
		Стр = СокрЛП(СтрЗаменить(Стр,"PM",""));
		
		МассивЗначений = Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(Стр, ":");
		
		Часы    = Число(МассивЗначений[0]);
		Минуты  = Число(МассивЗначений[1]);
		Если МассивЗначений.Количество() > 2 Тогда
			Секунды = Число(МассивЗначений[2]);
		КонецЕсли;	 
		
		Возврат Дата(Год, Месяц, День, Часы, Минуты, Секунды);
	КонецЕсли;	 
	
	Стр = СтрЗаменить(Стр, " ", ":");
	Стр = СтрЗаменить(Стр, ".", ":");
	МассивЗначений = Ванесса.РазложитьСтрокуВМассивПодстрокКлиент(Стр, ":");
	
	День    = Число(МассивЗначений[0]);
	Месяц   = Число(МассивЗначений[1]);
	Год     = Число(МассивЗначений[2]);
	Часы    = Число(МассивЗначений[3]);
	Минуты  = Число(МассивЗначений[4]);
	Секунды = Число(МассивЗначений[5]);
	
	Возврат Дата(Год, Месяц, День, Часы, Минуты, Секунды);
КонецФункции	 

// КопироватьКаталогКомандаСистемы
&НаКлиенте
Процедура КопироватьКаталогКомандаСистемы(Знач Откуда, Знач Куда) Экспорт
	Куда = СтрЗаменить(Куда, "\", "/");
	Если Прав(Куда, 1) = "/" Тогда
		Куда = Лев(Куда, СтрДлина(Куда) - 1);
	КонецЕсли;	 
	
	СписокКаталогов = Новый СписокЗначений;
	СписокФайлов    = Новый СписокЗначений;
	Ванесса.НайтиФайлыКомандаСистемы(Откуда, СписокКаталогов, СписокФайлов, Истина);

	СписокКаталогов.СортироватьПоПредставлению();
	
	Позиция = СтрДлина(Откуда) + 1 + 1;
	
	Для Каждого Каталог Из СписокКаталогов Цикл
		ВтораяЧастьПути = СтрЗаменить(Сред(Каталог.Значение.ПолноеИмя, Позиция), "\", "/");
		НовыйКаталогИмя = Куда + "/" + ВтораяЧастьПути;
		
		Ванесса.СоздатьКаталогКомандаСистемы(НовыйКаталогИмя);
	КонецЦикла;	
	
	Для Каждого ЭлементФайл Из СписокФайлов Цикл
		Файл            = ЭлементФайл.Значение;
		ВтораяЧастьПути = СтрЗаменить(Сред(Файл.ПолноеИмя, Позиция), "\", "/");
		НовоеИмяФайла   = Куда + "/" + ВтораяЧастьПути;
		
		Ванесса.КопироватьФайлКомандаСистемы(Файл.ПолноеИмя, НовоеИмяФайла);
	КонецЦикла;	

КонецПроцедуры

