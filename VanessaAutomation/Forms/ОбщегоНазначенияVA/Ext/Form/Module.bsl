// ПроверкаЭтоШагПроверкиОкнаИПроблемаССимволомЗвездочка
&НаКлиенте
Процедура ПроверкаЭтоШагПроверкиОкнаИПроблемаССимволомЗвездочка(ТекСтрока, Результат) Экспорт
	
	ТекстШага = СокрЛП(ТекСтрока.Имя);
	//Прав(ТекстШага, 2) = " *"          
	Если Найти(НРег(ТекСтрока.СтрокаРеальнойПроцедуры), "окна") ИЛИ Найти(НРег(ТекСтрока.СтрокаРеальнойПроцедуры), "окно") Тогда
		
		Для Каждого ТекПараметр Из ТекСтрока.ЗначенияПараметров Цикл
			Если Прав(ТекПараметр.Значение.Значение, 2) = " *" Тогда
				
				Структура = Новый Структура;
				Структура.Вставить("НомерСтроки", ТекСтрока.НомерСтрокиВФиче);
				Строки = Новый Массив;
				Строки.Добавить(ПодставитьПараметрыВСтроку(Локализовать("Неправильно указан параметр с заголовком окна: %1"), ТекСтрока.Имя));
				Строки.Добавить(Локализовать("Перед последним символом * не должно быть пробела."));
				
				ПравильноеЗначение = ТекПараметр.Значение.Значение;
				ПравильноеЗначение = Лев(ПравильноеЗначение, СтрДлина(ПравильноеЗначение) - 2) + "*";
				Строки.Добавить(ПодставитьПараметрыВСтроку(Локализовать("Правильное значение параметра: %1"), ПравильноеЗначение));
				Структура.Вставить("Текст", Ванесса._СтрСоединить(Строки, Символы.ПС));
				Результат.Добавить(Структура);
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;	
КонецПроцедуры

