// ПреобразоватьПутьСТочкамиКНормальномуПути
&НаКлиенте
Функция ПреобразоватьПутьСТочкамиКНормальномуПути(Знач ОригСтр = "") Экспорт
	
	Если ПустаяСтрока(ОригСтр) Тогда
		Возврат ОригСтр;
	КонецЕсли; 
	
	Если Найти(ОригСтр, "$workspaceRoot") > 0 Тогда 
		ОригСтр = СтрЗаменить(ОригСтр, "$workspaceRoot", Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта));
	КонецЕсли;
		
	Если Найти(ОригСтр, "$instrumentsRoot") > 0 И НЕ ПустаяСтрока(Ванесса.Объект.КаталогИнструментов) Тогда
		ОригСтр = СтрЗаменить(ОригСтр, "$instrumentsRoot", Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов));
	КонецЕсли;	
	
	ФайлПути = Новый Файл(ОригСтр);
	Если ЗначениеЗаполнено(Ванесса.Объект.КаталогПроекта) Тогда
		Если Лев(ОригСтр, 1) = "." Тогда
			ФайлПути = Новый Файл(Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + ОригСтр);
		КонецЕсли;
	Иначе
		Если Лев(ОригСтр, 1) = "." Тогда
			ФайлПути = Новый Файл(Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогИнструментов) + ОригСтр);
		КонецЕсли;
	КонецЕсли;	 
	
	Возврат ФайлПути.ПолноеИмя;
	
КонецФункции	

// УстановленOneScript
&НаКлиенте
Функция УстановленOneScript() Экспорт
	#Если НЕ ВебКлиент Тогда

	ИнструментУстановлен = Ложь;
	
	ИмяФайлаЛога = ПолучитьИмяВременногоФайла("txt");
	Стр = "oscript > """ + ИмяФайлаЛога + """ 2>&1";
	
	Ванесса.ВыполнитьКомандуОС(Стр);
	
	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ИмяФайлаЛога, "UTF-8");
	
	Стр = Текст.ПрочитатьСтроку();
		
	Если Стр <> Неопределено Тогда
		Образец = "1Script Execution Engine";
		Если Лев(Стр, СтрДлина(Образец)) = Образец Тогда
			ИнструментУстановлен = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Текст.Закрыть();
	УдалитьФайлыКомандаСистемы(ИмяФайлаЛога);
	
	Возврат ИнструментУстановлен;

	#КонецЕсли
КонецФункции

