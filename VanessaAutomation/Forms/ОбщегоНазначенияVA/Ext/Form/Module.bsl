&НаКлиенте
Процедура ВывестиЗначенияПеременныхВМакет(НомерСтроки, ТабДок, КоллекцияПеременных) Экспорт

	Шрифт10 = Новый Шрифт(, 10);


	СписокПеременных = Новый СписокЗначений;
	Для Каждого Элем Из КоллекцияПеременных Цикл
		СписокПеременных.Добавить(Элем, Элем.Ключ);
	КонецЦикла;

	СписокПеременных.СортироватьПоПредставлению();

	Для Каждого ЭлементСписка Из СписокПеременных Цикл

		Элем = ЭлементСписка.Значение;

		Если Найти(Элем.Ключ, "_Цикл_") > 0 Тогда
			Продолжить;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;

		ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = Элем.Ключ;
		ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).Шрифт = Шрифт10;
		ТабДок.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = Элем.Значение;
		ТабДок.Область(НомерСтроки, 2, НомерСтроки, 2).Шрифт = Шрифт10;
		ТабДок.Область(НомерСтроки, 3, НомерСтроки, 3).Текст = ТипЗнч(Элем.Значение);
		ТабДок.Область(НомерСтроки, 2, НомерСтроки, 3).Шрифт = Шрифт10;

		Если ТипЗнч(Элем.Значение) = Тип("Структура") Тогда
			Для Каждого ЭлементСтруктуры Из Элем.Значение Цикл
				НомерСтроки = НомерСтроки + 1;
				ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = ЭлементСтруктуры.Ключ;
				ТабДок.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = ЭлементСтруктуры.Значение;
				ТабДок.Область(НомерСтроки, 3, НомерСтроки, 3).Текст = ТипЗнч(ЭлементСтруктуры.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;


КонецПроцедуры

&НаКлиенте
Функция НайтиМакетВКаталогеПроектаСлужебный(ИмяМакета, ИмяФайла)
	Нашли = Ложь;

	СостояниеVanessaBehavior = Ванесса.ПолучитьСостояниеVanessaAutomation();
	ИдСценария               = СостояниеVanessaBehavior.ТекущийСценарий.ИдСценария;

	КаталогСценария = Ванесса.ДобавитьНулей(ИдСценария + 1, 4);
	ДопКаталог      = "";
	Если Ванесса.ФайлСуществуетКомандаСистемы(Ванесса.Объект.КаталогПроекта + "\Файлы\" + КаталогСценария) Тогда
		ДопКаталог = КаталогСценария;
	КонецЕсли;

	Если Не Нашли Тогда

		ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + Ванесса.ДополнитьСлешВПуть("Файлы") + ?(ДопКаталог = "", "", Ванесса.ДополнитьСлешВПуть(ДопКаталог)) + ИмяМакета;
		Если Прав(НРег(ИмяФайла), 4) <> ".mxl" Тогда
			ИмяФайла = ИмяФайла + ".mxl";
		КонецЕсли;
		Если Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
			Нашли = Истина;
		КонецЕсли;
	КонецЕсли;

	Если Не Нашли Тогда
		ИмяФайла = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + ИмяМакета;
		Если Прав(НРег(ИмяФайла), 4) <> ".mxl" Тогда
			ИмяФайла = ИмяФайла + ".mxl";
		КонецЕсли;
		Если Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
			Нашли = Истина;
		КонецЕсли;
	КонецЕсли;

	Если НЕ Нашли Тогда
		Если Ванесса.ФайлСуществуетКомандаСистемы(Ванесса.Объект.КаталогПроекта) Тогда
			ИмяФайла = ИмяМакета;
			Если Прав(НРег(ИмяФайла), 4) <> ".mxl" Тогда
				ИмяФайла = ИмяФайла + ".mxl";
			КонецЕсли;

			СписокКаталогов = Новый СписокЗначений;
			СписокФайлов    = Новый СписокЗначений;

			КаталогПоиска = Ванесса.ДополнитьСлешВПуть(Ванесса.Объект.КаталогПроекта) + "Файлы";

			ПоискВКаталогеПроекта = Истина;
			Если Ванесса.ФайлСуществуетКомандаСистемы(КаталогПоиска) Тогда
				ПоискВКаталогеПроекта = Ложь;
				Ванесса.НайтиФайлыКомандаСистемы(КаталогПоиска, СписокКаталогов, СписокФайлов, Истина);
			Иначе
				Ванесса.НайтиФайлыКомандаСистемы(Ванесса.Объект.КаталогПроекта, СписокКаталогов, СписокФайлов, Истина);
			КонецЕсли;

			Для Каждого Элем Из СписокФайлов Цикл
				ТекФайл = Элем.Значение;
				Если НРег(ТекФайл.Имя) = НРег(ИмяФайла) Тогда
					ИмяФайла = ТекФайл.ПолноеИмя;
					Нашли = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НЕ Нашли И НЕ ПоискВКаталогеПроекта Тогда
				СписокКаталогов = Новый СписокЗначений;
				СписокФайлов    = Новый СписокЗначений;
				Ванесса.НайтиФайлыКомандаСистемы(Ванесса.Объект.КаталогПроекта, СписокКаталогов, СписокФайлов, Истина);
				Для Каждого Элем Из СписокФайлов Цикл
					ТекФайл = Элем.Значение;
					Если НРег(ТекФайл.Имя) = НРег(ИмяФайла) Тогда
						ИмяФайла = ТекФайл.ПолноеИмя;
						Нашли = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;

	Возврат Нашли;
КонецФункции
// НайтиМакетВКаталогеПроекта
&НаКлиенте
Функция НайтиМакетВКаталогеПроекта(ИмяМакета, ДопПараметры = Неопределено) Экспорт
	Если ЗначениеЗаполнено(ИмяМакета) И Ванесса.ФайлСуществуетКомандаСистемы(ИмяМакета) Тогда
		Возврат Ванесса.ПолучитьМакетИзФайла(ИмяМакета);
	КонецЕсли;	 
	
	Если НЕ ЗначениеЗаполнено(Ванесса.Объект.КаталогПроекта) Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Не найден эталон макета <%1>. Пустой каталог проекта."),
			ИмяМакета
		);
	КонецЕсли;	 
	
	ИмяМакетаДляПоиска = ИмяМакета;
	ИмяФайла  = Неопределено;
	Нашли = НайтиМакетВКаталогеПроектаСлужебный(ИмяМакетаДляПоиска, ИмяФайла);

	Если Не Нашли Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Не найден файл макета <%1> в каталоге проекта <%2>"),
			ИмяМакета,
			Ванесса.Объект.КаталогПроекта
		);
	КонецЕсли;	 
	
	ТабДок = Ванесса.ПолучитьМакетИзФайла(ИмяФайла);
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ДопПараметры.Вставить("ИмяФайла", ИмяФайла);
	КонецЕсли;	

	Возврат Табдок;
КонецФункции	


// Разбирает имя области макета вида "R1C1:R2C2". Возвращает структуру с полями
// НачСтр, НачКол, КолСтр, КолКол (урок 36: ByRef-параметры примитивных типов).
&НаКлиенте
Функция ПолучитьПараметрыОбластиМакета(Знач ИмяОбласти, НачСтр, НачКол, КолСтр, КолКол) Экспорт
	ИмяОбластиОригинал = ИмяОбласти;

	ИмяОбласти = СокрЛП(ВРег(ИмяОбласти));
	Поз = Найти(ИмяОбласти, "R");
	Если Поз = 0 Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Неверный формат области <%1>"),
			ИмяОбластиОригинал
		);
	КонецЕсли;

	ИмяОбласти = Сред(ИмяОбласти, Поз + 1);
	Поз = Найти(ИмяОбласти, "C");
	Если Поз = 0 Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Неверный формат области <%1>"),
			ИмяОбластиОригинал
		);
	КонецЕсли;
	НачСтр = Число(Лев(ИмяОбласти, Поз - 1));

	ИмяОбласти = Сред(ИмяОбласти, Поз + 1);
	Поз = Найти(ИмяОбласти, ":");
	Если Поз = 0 Тогда
		КолСтр = НачСтр;
		Поз = Найти(ИмяОбластиОригинал, "C");
		НачКол = Число(Сред(ИмяОбластиОригинал, Поз + 1));
		КолКол = НачКол;
		Возврат Новый Структура("НачСтр,НачКол,КолСтр,КолКол", НачСтр, НачКол, КолСтр, КолКол);
	КонецЕсли;
	НачКол = Число(Лев(ИмяОбласти, Поз - 1));

	ИмяОбласти = Сред(ИмяОбласти, Поз + 1);

	ИмяОбласти = СокрЛП(ВРег(ИмяОбласти));
	Поз = Найти(ИмяОбласти, "R");
	Если Поз = 0 Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Неверный формат области <%1>"),
			ИмяОбластиОригинал
		);
	КонецЕсли;

	// вторая часть, после символа :

	ИмяОбласти = Сред(ИмяОбласти, Поз + 1);
	Поз = Найти(ИмяОбласти, "C");
	Если Поз = 0 Тогда
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(
			Ванесса.Локализовать("Неверный формат области <%1>"),
			ИмяОбластиОригинал
		);
	КонецЕсли;
	КолСтр = Число(Лев(ИмяОбласти, Поз - 1)) - НачСтр + 1;

	ИмяОбласти = Сред(ИмяОбласти, Поз + 1);
	КолКол = Число(ИмяОбласти) - НачКол + 1;
	Возврат Новый Структура("НачСтр,НачКол,КолСтр,КолКол", НачСтр, НачКол, КолСтр, КолКол);
КонецФункции

// Проверяет, существует ли процесс системы с указанным PID
&НаКлиенте
Функция ПроцессОССуществует(PID) Экспорт
	Результат = Ложь;

	Если Ванесса.Объект.ИспользоватьКомпонентуVanessaExt И Ванесса.ВнешняяКомпонентаДляСкриншотов <> Неопределено И НЕ Ванесса.ЗапрещеныСинхронныеВызовы Тогда
		Попытка
			СвойстваПроцесса = Ванесса.ПрочитатьСтрокуJSON(Ванесса.ВнешняяКомпонентаДляСкриншотов.ПолучитьСвойстваПроцесса(Число(PID)));
		Исключение
			СвойстваПроцесса = Неопределено;
		КонецПопытки;

		Если СвойстваПроцесса = Неопределено Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	#Если НЕ ВебКлиент Тогда

		Если Ванесса.ЭтоLinux Тогда

			Результат = ПроцессОССуществуетLinux(PID);

		Иначе

			Результат = ПроцессОССуществуетWindows(PID);

		КонецЕсли;

	#КонецЕсли

	Возврат Результат;

КонецФункции

// Очищает элементы массива по массиву идентификаторов (в обратном порядке).
&НаКлиенте
Процедура ОчиститьМассивИД(МассивИд, МассивЭлементов) Экспорт
	Если МассивИд.Количество() > 0 Тогда
		Для Ккк = 0 По МассивИд.Количество() - 1 Цикл
			МассивЭлементов.Удалить(МассивИд[МассивИд.Количество() - Ккк - 1]);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Проверяет существование процесса ОС Windows по PID.
&НаКлиенте
Функция ПроцессОССуществуетWindows(PID) Экспорт

	#Если НЕ ВебКлиент Тогда

	ЛогФайл = ПолучитьИмяВременногоФайла("txt");
	Команда = "tasklist /FI ""PID eq " + Формат(PID, "ЧГ=; ЧН=0") +  """ > """ + ЛогФайл + """";
	Ванесса.ВыполнитьКомандуОСБезПоказаЧерногоОкна(Команда);

	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ЛогФайл) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ЛогФайл, "UTF-8");
	ТекстФайла = Текст.Прочитать();
	Текст.Закрыть();
	Ванесса.УдалитьФайлыКомандаСистемы(ЛогФайл);

	Если Найти(ТекстФайла, Формат(PID, "ЧГ=; ЧН=0")) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

	#КонецЕсли

КонецФункции

// Проверяет существование процесса ОС Linux по PID.
&НаКлиенте
Функция ПроцессОССуществуетLinux(PID) Экспорт

	#Если НЕ ВебКлиент Тогда

	ЛогФайл = ПолучитьИмяВременногоФайла("txt");
	Команда = Ванесса.ПодставитьПараметрыВСтроку("ps -p %1 > %2"
											, PID
											, ЛогФайл);

	Ванесса.ВыполнитьКомандуОС(Команда);

	Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ЛогФайл) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = Новый ЧтениеТекста;
	Текст.Открыть(ЛогФайл);
	ТекстФайла = Текст.Прочитать();
	Текст.Закрыть();
	Ванесса.УдалитьФайлыКомандаСистемы(ЛогФайл);

	Если Найти(ТекстФайла, PID) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

	#КонецЕсли

КонецФункции

// ПолучитьТаблицуGherkinИзМакета
&НаКлиенте
Функция ПолучитьТаблицуGherkinИзМакета(Макет) Экспорт
	ТаблицаGherkin = Новый Массив;
	
	Для Ккк = 1 По Макет.ВысотаТаблицы Цикл
		СтрокаТаблицы = Новый Структура;
		Для Ррр = 1 По Макет.ШиринаТаблицы Цикл
			СтрокаТаблицы.Вставить("Кол" + Формат(Ррр, "ЧГ=; ЧН=0"), Макет.Область(Ккк, Ррр, Ккк, Ррр).Текст);
		КонецЦикла;	
		
		ТаблицаGherkin.Добавить(СтрокаТаблицы);
	КонецЦикла;	
	
	Возврат ТаблицаGherkin;
КонецФункции

// ПривестиРазмерСтрокВМакетеВСоответствиеСТребованиямиФорматаXlsx
&НаКлиенте
Процедура ПривестиРазмерСтрокВМакетеВСоответствиеСТребованиямиФорматаXlsx(ТабДок) Экспорт
	
	МаксДлина = 31000;
	Для НомСтр = 1 По ТабДок.ВысотаТаблицы Цикл
		Для НомКол = 1 По ТабДок.ШиринаТаблицы Цикл
			ТекстЯчейки = ТабДок.Область(НомСтр, НомКол, НомСтр, НомКол).Текст;
			Если СтрДлина(ТекстЯчейки) > МаксДлина Тогда
				ТабДок.Область(НомСтр, НомКол, НомСтр, НомКол).Текст = Лев(ТекстЯчейки, МаксДлина);
			КонецЕсли;	
			
		КонецЦикла;		
	КонецЦикла;	
	
КонецПроцедуры 

// ПроверитьЗаписьМакетаПослеАктуализации
&НаКлиенте
Процедура ПроверитьЗаписьМакетаПослеАктуализации(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеДляАктуализации = ДополнительныеПараметры.ДанныеДляАктуализации;
	
	Если Результат = Истина Тогда
		Ванесса.СообщитьПользователю(Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Файл <%1> был перезаписан."), ДанныеДляАктуализации.ИмяФайлаМакета));
	Иначе	
		ВызватьИсключение Ванесса.ПодставитьПараметрыВСтроку(Ванесса.Локализовать("Файл <%1> не был перезаписан."), ДанныеДляАктуализации.ИмяФайлаМакета);
	КонецЕсли;
	
КонецПроцедуры

