&НаСервереБезКонтекста
Функция ПолучитьКартинкуНаСервере(Знач УникальныйИдентификатор, Знач Масштаб, ТипКнопки, Версия851ИлиВыше)
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("zip");

	Если Версия851ИлиВыше Тогда
		
		//Что бывает:
		//_editCalc.zip _editCalendar.zip _editCalendarAndClock.zip _editClear.zip
		//_editClock.zip _editDropDown.zip _editDropDownOpen.zip _editDropUp.zip
		//_editLeft.zip _editLocked.zip _editMinus.zip _editOpen.zip _editPlus.zip
		//_editRegDown.zip _editRegUp.zip _editRight.zip _editSelect.zip _editType.zip _editUnlocked.zip
		
		Если ТипКнопки = "ОчисткаЭлемента" Тогда
			ФайлРесурса = "v8res://core85/_editClear.zip";
		ИначеЕсли ТипКнопки = "ВыпадающийСписок" Тогда
			ФайлРесурса = "v8res://core85/_editDropDown.zip";
		ИначеЕсли ТипКнопки = "ВыборИзСписка" Тогда
			ФайлРесурса = "v8res://core85/_editSelect.zip";
		ИначеЕсли ТипКнопки = "ОткрытиеЭлемента" Тогда
			ФайлРесурса = "v8res://core85/_editOpen.zip";
		Иначе
			Результат = Новый Структура;
			Результат.Вставить("ТекстОшибки", "Неизвестный тип картинки: <%1>");
			Результат.Вставить("Параметр1", ТипКнопки);
			
			Возврат Результат;
		КонецЕсли;	
	Иначе	
		ФайлРесурса = "v8res://core83/edtButtons.zip";
	КонецЕсли;	
	
	КопироватьФайл(ФайлРесурса, ВременныйФайл);
	
	ОтборКартинки = Новый Соответствие;
	ОтборРазмеров = Новый Соответствие;
	ОтборРазмеров.Вставить(100, "ldpi");
	ОтборРазмеров.Вставить(125, "aldpi");
	ОтборРазмеров.Вставить(150, "mdpi");
	ОтборРазмеров.Вставить(175, "amdpi");
	ОтборРазмеров.Вставить(200, "hdpi");
	ОтборРазмеров.Вставить(300, "xdpi");
	ОтборРазмеров.Вставить(400, "udpi");
	ЗначениеОтбора = ОтборРазмеров.Получить(Масштаб);
	ОтборКартинки.Вставить("screenDensity", ЗначениеОтбора);
	
	Картинка = Новый Картинка(ВременныйФайл);
	Если Версия851ИлиВыше Тогда
		ОтборКартинки.Вставить("interfaceVariant", "taxi");
		ДвоичныеДанныеКартинки = Картинка.ПолучитьДвоичныеДанные(Ложь, ОтборКартинки);
	Иначе	
		ДвоичныеДанныеКартинки = Картинка.ПолучитьДвоичныеДанные(Ложь, ОтборКартинки);
	КонецЕсли;	
	УдалитьФайлы(ВременныйФайл);
	АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКартинки, УникальныйИдентификатор);
	ЭкземелярКартинки = Новый Картинка(ДвоичныеДанныеКартинки);
	ВысотаКартинки = ЭкземелярКартинки.Высота();
	Результат = Новый Структура("АдресКартинки,ВысотаКартинки", АдресКартинки, ВысотаКартинки);
	Возврат Результат;
	
КонецФункции

