#Область ОписаниеПеременных

&НаКлиенте
Перем Ванесса;

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ИнициализацияФормы(ВладелецФормы) Экспорт
	Ванесса = ВладелецФормы;
КонецФункции

&НаКлиенте
Функция ОтключениеМодуля() Экспорт
	Ванесса = Неопределено;
КонецФункции

&НаКлиенте
Процедура Сформировать(ДанныеДляФормированияОшибкиСППР) Экспорт
	#Если НЕ ВебКлиент Тогда
	ДанныеОкружения = ДанныеОкруженияСервер();
	СформироватьОшибкуСППР(ДанныеДляФормированияОшибкиСППР, ДанныеОкружения);
	#Иначе
	Ванесса.СообщитьПользователю(Ванесса.Локализовать("Формирование отчёта в веб-клиенте не поддерживается."));
	#КонецЕсли
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОкруженияСервер()
	Данные = Новый Структура;
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Данные.Вставить("ВерсияПлатформы", СистемнаяИнформация.ВерсияПриложения);
	Данные.Вставить("ОперативнаяПамять", СистемнаяИнформация.ОперативнаяПамять);
	Данные.Вставить("ВерсияОС", СистемнаяИнформация.ВерсияОС);
	Данные.Вставить("Процессор", СистемнаяИнформация.Процессор);
	Данные.Вставить("ТипПлатформы", Строка(СистемнаяИнформация.ТипПлатформы));
	Данные.Вставить("ИнформацияПрограммыПросмотра", СистемнаяИнформация.ИнформацияПрограммыПросмотра);
	Данные.Вставить("ТекущаяДата", ТекущаяДатаСеанса());
	Данные.Вставить("ИмяКонфигурации", Метаданные.Имя);
	Данные.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Возврат Данные;
КонецФункции

&НаСервереБезКонтекста
Функция XMLСППРВСтрокуСервер(СтруктураОшибки)
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СтруктураОшибки);
	Возврат ЗаписьXML.Закрыть();
КонецФункции

#КонецОбласти

#Область ПеренесённыеИзМодуляФормыОтчетыОЗапускеТестов

// Возвращает многострочную строку по переданному массиву. Для замены СтрСоединить.
&НаКлиенте
Функция МассивВСтроку(Знач Массив, Знач Символ = Неопределено,
	Знач ЕстьПоддержкаФункцияРазложитьСтрокуВМассивПодстрок = Ложь) Экспорт
	
	Если Символ = Неопределено Тогда
		Символ = Символы.ПС;
	КонецЕсли;
	
	Если ЕстьПоддержкаФункцияРазложитьСтрокуВМассивПодстрок Тогда
		Возврат Вычислить("СтрСоединить(Массив, Символ)"); 
	КонецЕсли;
	
	Стр = "";
	Для Ккк = 0 По Массив.Количество() - 1 Цикл
		Стр = Стр + Массив[Ккк];
		Если Ккк < Массив.Количество() - 1 Тогда
			Стр = Стр + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Стр;
КонецФункции

