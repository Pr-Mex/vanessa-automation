// Проверяет, что табличные документы равны, игнорируя оформление.
//
// Параметры:
//   ТабДок1       - ТабличныйДокумент - Табличный документ.
//   ТабДок2       - ТабличныйДокумент - Табличный документ.
//   УчитыватьТолькоВидимыеКолонкиИлиДопСообщениеОшибки - Булево, Строка - Флаг, указывающий, что нужно проверять только видимые колонки.
//   УчитыватьТолькоВидимыеСтрокиИлиДопСообщениеОшибки  - Булево, Строка - Флаг, указывающий, что нужно проверять только видимые строки.
//   ДопСообщениеОшибки - Строка - Описание ошибки, которое будет использовано в тексте исключения ассерта.
//
&НаСервере
Процедура ПроверитьРавенствоТабличныхДокументовТолькоПоЗначениямСервер(ТабДок1, ТабДок2, 
			УчитыватьТолькоВидимыеКолонкиИлиДопСообщениеОшибки = Ложь, 
			УчитыватьТолькоВидимыеСтрокиИлиДопСообщениеОшибки = Ложь, 
			Знач ДопСообщениеОшибки = "", 
			ДопПараметры = Неопределено)
			
	Объект().ПроверитьРавенствоТабличныхДокументовТолькоПоЗначениям(ТабДок1, ТабДок2, 
		УчитыватьТолькоВидимыеКолонкиИлиДопСообщениеОшибки, 
		УчитыватьТолькоВидимыеСтрокиИлиДопСообщениеОшибки, 
		ДопСообщениеОшибки, 
		ДопПараметры);
КонецПроцедуры

&НаСервере
Процедура ЯВыполняюКодВстроенногоЯзыкаНаСервереСервер(Текст)
	Выполнить(Текст);
КонецПроцедуры 


#Область ПеренесённыеИзДругихКонтейнеров

// Перенесено из главной формы (Шаг 2/порция 1: СБК-макеты).
// Серверный безконтекстный метод (внутренний) — читает таб.документ из XML-строки.
&НаСервереБезКонтекста
Функция МакетИзТекстаXML(Знач Строка)
	
    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.УстановитьСтроку(Строка);
    ЧтениеXML.Прочитать();
	
	Результат = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	Если ТипЗнч(Результат) = Тип("ДвоичныеДанные") Тогда
		Поток = Результат.ОткрытьПотокДляЧтения();
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(Поток);
		Поток.Закрыть();
	Иначе	
		ТабДок = Результат;
	КонецЕсли;	
	
    Возврат ТабДок;
	
КонецФункции	

// Перенесено из главной формы (Шаг 2/порция 1). Клиентская обёртка над СБК МакетИзТекстаXML
// (кросс-форменный вызов серверного метода с клиента невозможен — урок 33).
&НаКлиенте
Функция МакетИзТекстаXMLКлиент(Знач Строка) Экспорт
	Возврат МакетИзТекстаXML(Строка);
КонецФункции

// Перенесено из главной формы (Шаг 3 SRV_NEEDS_CLIENT_WRAPPER).
// Серверный метод: список сохранённых контекстов из регистра (внутренний).
&НаСервере
Функция ПолучитьСписокСохраненныхКонтекстовССервера()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|    ХранилищеКонтекстов.Наименование,
		|    ХранилищеКонтекстов.Период
		|ИЗ
		|    РегистрСведений.ХранилищеКонтекстов КАК ХранилищеКонтекстов
		|УПОРЯДОЧИТЬ ПО
		|    ХранилищеКонтекстов.Период УБЫВ";

	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();

	МассивРезультата = Новый Массив;
	Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
		НоваяСтруктура = Новый Структура("Наименование, Период");
		ЗаполнитьЗначенияСвойств(НоваяСтруктура, СтрокаРезультата);
		МассивРезультата.Добавить(НоваяСтруктура);
	КонецЦикла;

	Возврат МассивРезультата;

КонецФункции

// Клиентская обёртка (урок 33).
&НаКлиенте
Функция ПолучитьСписокСохраненныхКонтекстовССервераКлиент() Экспорт
	Возврат ПолучитьСписокСохраненныхКонтекстовССервера();
КонецФункции

// Серверный метод: загрузка контекстов из регистра отката (внутренний).
&НаСервере
Функция ЗагрузитьКонтекстыИзРегистраОткатаССервера(Знач КлючЗаписи)

	МенеджерЗаписи = РегистрыСведений.ХранилищеКонтекстов.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючЗаписи);

	Попытка
		МенеджерЗаписи.Прочитать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	СтрокаXML = МенеджерЗаписи.ДанныеXML;

	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		ЗагруженныеКонтексты = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
		Возврат ЗагруженныеКонтексты;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Клиентская обёртка (урок 33).
&НаКлиенте
Функция ЗагрузитьКонтекстыИзРегистраОткатаССервераКлиент(Знач КлючЗаписи) Экспорт
	Возврат ЗагрузитьКонтекстыИзРегистраОткатаССервера(КлючЗаписи);
КонецФункции

// Серверный метод: выгрузка контекстов в регистр отката (внутренний).
&НаСервере
Процедура ВыгрузитьКонтекстыВРегистрОткатаНаСервере(Знач Наименование, Знач ЛокальныйКонтекст, Знач ГлобальныйКонтекст)

	КонтекстыДляВыгрузки = Новый Структура;
	КонтекстыДляВыгрузки.Вставить("ЛокальныйКонтекст", ЛокальныйКонтекст);
	КонтекстыДляВыгрузки.Вставить("ГлобальныйКонтекст", ГлобальныйКонтекст);

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, КонтекстыДляВыгрузки);
	СтрокаXML = ЗаписьXML.Закрыть();

	МенеджерЗаписи = РегистрыСведений.ХранилищеКонтекстов.СоздатьМенеджерЗаписи();

	МенеджерЗаписи.Наименование = Наименование;
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.ДанныеXML = СтрокаXML;

	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ВызватьИсключение "Не удалось записать контекст в регистр 'ХранилищеКонтекстов': " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Клиентская обёртка (урок 33).
&НаКлиенте
Процедура ВыгрузитьКонтекстыВРегистрОткатаНаСервереКлиент(Знач Наименование, Знач ЛокальныйКонтекст, Знач ГлобальныйКонтекст) Экспорт
	ВыгрузитьКонтекстыВРегистрОткатаНаСервере(Наименование, ЛокальныйКонтекст, ГлобальныйКонтекст);
КонецПроцедуры

